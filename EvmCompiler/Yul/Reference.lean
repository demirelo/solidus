theorem eval_var_compiler_push_temp_withTemps_hidden {cfg : StateRelConfig}
    {sourceLayout hiddenLayout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : EVMState}
    (fuel : Nat) (name : EvmYul.Identifier)
    (codeOverride : Option AstContract) (ctx : Locals.Ctx)
    {temps : EvmYul.Stack Word} {offset idx : Nat}
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (hCtxLayout : ctx.layout = hiddenLayout ++ sourceLayout)
    (hOffset : offset = temps.length)
    (hNoDup : (hiddenLayout ++ sourceLayout).Nodup)
    (hName : sourceLayout[idx]? = some (identName name))
    (hBound : offset + hiddenLayout.length + idx + 1 ≤ 16)
    (hRel :
      CompilerStateRelWithTempsAndHiddenLocals cfg sourceLayout hiddenLayout
        temps (.Ok shared store) compiler) :
    ∃ value compiler',
      EvmYul.Yul.eval fuel.succ (.Var name) codeOverride
          (.Ok shared store) =
        .ok (.Ok shared store, value) ∧
      store.lookup (identName name) = some value ∧
      Locals.Direct.Expr.runCode ctx offset (.var (identName name)) compiler =
        .ok compiler' ∧
      CompilerStateRelWithTempsAndHiddenLocals cfg sourceLayout hiddenLayout
        (value :: temps) (.Ok shared store) compiler' := by
  cases hRel with
  | ok hShared hVars hHiddenLength hStack =>
      rename_i hiddenValues locals
      have hVarsExact :
          ExactVarStackRel sourceLayout store locals := by
        simpa [hVarRelExact] using hVars
      rcases ExactVarStackRel.get? hVarsExact hName with
        ⟨value, hLocalStack, hStore⟩
      let compiler' :=
        compiler.replaceStackAndIncrPC (value :: compiler.stack)
      refine ⟨value, compiler', ?hEval, hStore, ?hRun, ?hRel⟩
      · rw [Imported.eval_var_succ]
        simp [lookup?_ok (shared := shared) hStore]
      · have hFullName :
            (hiddenLayout ++ sourceLayout)[hiddenLayout.length + idx]? =
              some (identName name) := by
          simpa using
            (getElem?_append_right_add hiddenLayout sourceLayout idx).trans
              hName
        have hDepth :
            Locals.Layout.lookupDepth? (identName name) ctx.layout =
              some (hiddenLayout.length + idx + 1) := by
          have hDepthFull :=
            lookupDepth?_of_get?_nodup
              (layout := hiddenLayout ++ sourceLayout)
              (name := identName name)
              (idx := hiddenLayout.length + idx)
              hFullName hNoDup
          simpa [hCtxLayout, Nat.add_assoc, Nat.add_comm,
            Nat.add_left_comm] using hDepthFull
        have hStackAt :
            compiler.stack[offset + hiddenLayout.length + idx]? =
              some value := by
          subst offset
          rw [hStack]
          rw [List.getElem?_append_right]
          · have hSub :
                (temps.length + hiddenLayout.length + idx) -
                    (temps ++ hiddenValues).length = idx := by
              rw [List.length_append, hHiddenLength]
              omega
            rw [hSub]
            exact hLocalStack
          · simp [List.length_append, hHiddenLength]
        have hOne : 1 ≤ offset + (hiddenLayout.length + idx + 1) := by
          omega
        have hBound' : offset + (hiddenLayout.length + idx + 1) ≤ 16 := by
          omega
        rcases
          stackOp_dup?_step_eq_dup
            (n := offset + (hiddenLayout.length + idx + 1))
            hOne hBound' compiler with
          ⟨op, hDup, hStep⟩
        have hDupValue :
            EvmYul.dup (offset + (hiddenLayout.length + idx + 1))
                compiler =
              .ok compiler' := by
          have hDupValue' :=
            evm_dup_succ_get?
              (state := compiler)
              (idx := offset + hiddenLayout.length + idx) hStackAt
          simpa [compiler', Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
            using hDupValue'
        simp [Locals.Direct.Expr.runCode, hDepth, hDup]
        rw [hStep, hDupValue]
      · exact
          CompilerStateRelWithTempsAndHiddenLocals.ok
            (by
              simpa [compiler', EvmYul.EVM.State.replaceStackAndIncrPC,
                EvmYul.EVM.State.incrPC] using hShared)
            hVars
            hHiddenLength
            (by
              simp [compiler', EvmYul.EVM.State.replaceStackAndIncrPC,
                EvmYul.EVM.State.incrPC, hStack])


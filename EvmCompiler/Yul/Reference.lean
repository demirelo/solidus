  simp [EvmYul.Yul.exec]

theorem eval_lit_succ (fuel : Nat) (value : Word)
    (codeOverride : Option AstContract) (state : State) :
    EvmYul.Yul.eval fuel.succ (.Lit value) codeOverride state =

theorem condition_var_layout_slot_bridge {cfg : StateRelConfig}
    {sourceLayout fullLayout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : RunState}
    (fuel : Nat) (name : EvmYul.Identifier)
    (codeOverride : Option AstContract) (ctx : Locals.Ctx)
    {sourceIdx : Nat}
    (hCtxLayout : ctx.layout = fullLayout)
    (hNoDup : fullLayout.Nodup)
    (hSourceName : sourceLayout[sourceIdx]? = some (identName name))
    (hBound :
      ∀ {fullIdx : Nat},
        fullLayout[fullIdx]? = some (identName name) →
          fullIdx + 1 ≤ 16)
    (hRel :
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Ok shared store) compiler.evm) :
    ∃ value : Word, ∃ compilerAfter : RunState,
      EvmYul.Yul.eval fuel.succ (.Var name) codeOverride
          (.Ok shared store) =
        .ok (.Ok shared store, value) ∧
      store.lookup (identName name) = some value ∧
      Locals.Direct.Expr.runCondition ctx (.var (identName name)) compiler =
        .ok (compilerAfter, value != EvmYul.UInt256.ofNat 0) ∧
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Ok shared store) compilerAfter.evm ∧
      compilerAfter.returns = compiler.returns := by
  cases hRel with
  | ok hShared hVars hCover =>
      rcases hVars hSourceName with
        ⟨fullIdx, value, hFullName, hStack, hStore⟩
      rcases
          condition_var_slot_bridge_of_lookup
            (cfg := cfg) (fullLayout := fullLayout) (shared := shared)
            (store := store) (compiler := compiler) fuel name codeOverride
            ctx (idx := fullIdx) (value := value)
            hCtxLayout hNoDup hFullName (hBound hFullName) hStack hStore
            hShared with
        ⟨compilerAfter, hEval, hCond, hStackAfter, hSharedAfter, hReturns⟩
      refine ⟨value, compilerAfter, hEval, hStore, hCond, ?hRelAfter,
        hReturns⟩
      exact
        CompilerStateRelWithLayoutSlots.ok hSharedAfter
          (by
            intro sourceIdx' sourceName hSourceName'
            rcases hVars hSourceName' with
              ⟨fullIdx', value', hFullName', hStack', hStore'⟩
            exact
              ⟨fullIdx', value', hFullName',
                by simpa [hStackAfter] using hStack', hStore'⟩)
          (by simpa [hStackAfter] using hCover)


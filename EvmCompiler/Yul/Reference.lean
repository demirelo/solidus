abbrev StateRel := State → Objects.Source.State → Prop
abbrev OutcomeRel := Result → Objects.Source.Outcome → Prop
abbrev LoweredStateRel := State → EVMState → Prop
abbrev LoweredOutcomeRel := Result → Outcome → Prop

/--
Explicit bridge from the imported Yul interpreter to the compiler-facing source
semantics.

This is the semantic boundary that must be proved per construct to claim
source-completeness against `EvmYul.Yul.exec`.  It targets the source tower,
not the lower stack/procedure backend.
-/
structure SourceBridge (prim : Objects.Source.PrimitiveSemantics)
    (stateRel : StateRel) (outcomeRel : OutcomeRel)
    (program : Program) (referenceFuel : Nat)
    (referenceInitial : State) (referenceResult : Result) where
  accepted : Accepted program
  sourceFuel : Nat
  sourceInitial : Objects.Source.State
  sourceOutcome : Objects.Source.Outcome
  referenceRun :
    runResult referenceFuel program referenceInitial = .ok referenceResult
  initialRel : stateRel (installContract program referenceInitial)
    sourceInitial
  sourceRun :
    SourceLowered.runState prim sourceFuel program sourceInitial =
      .ok sourceOutcome
  outcomeRel : outcomeRel referenceResult sourceOutcome

namespace SourceBridge

theorem toReferenceRun {prim : Objects.Source.PrimitiveSemantics}
    {stateRel : StateRel} {outcomeRel : OutcomeRel}
    {program : Program} {referenceFuel : Nat}
    {referenceInitial : State} {referenceResult : Result}
    (bridge :
      SourceBridge prim stateRel outcomeRel program referenceFuel
        referenceInitial referenceResult) :
    runResult referenceFuel program referenceInitial = .ok referenceResult :=
  bridge.referenceRun

theorem toSourceRun {prim : Objects.Source.PrimitiveSemantics}
    {stateRel : StateRel} {outcomeRel : OutcomeRel}
    {program : Program} {referenceFuel : Nat}
    {referenceInitial : State} {referenceResult : Result}
    (bridge :
      SourceBridge prim stateRel outcomeRel program referenceFuel
        referenceInitial referenceResult) :
    SourceLowered.runState prim bridge.sourceFuel program bridge.sourceInitial =
      .ok bridge.sourceOutcome :=
  bridge.sourceRun

end SourceBridge

/--
Legacy backend bridge from the imported Yul interpreter directly to the
compiler-facing lowered run.  This remains useful for the checked assembly and
bytecode backend theorem, but it is deliberately not named `SourceBridge`:
the clean source boundary above targets `SourceLowered.runState`.
-/
structure LoweredBridge (stateRel : LoweredStateRel)
    (outcomeRel : LoweredOutcomeRel) (program : Program) (referenceFuel : Nat)
    (referenceInitial : State) (referenceResult : Result) where
  accepted : Accepted program
  sourceFuel : Nat
  compilerInitial : EVMState
  outcome : Outcome
  referenceRun :
    runResult referenceFuel program referenceInitial = .ok referenceResult
  initialRel : stateRel (installContract program referenceInitial)
    compilerInitial
  sourceRun :
    Lowered.run sourceFuel program compilerInitial = .ok outcome
  outcomeRel : outcomeRel referenceResult outcome

namespace LoweredBridge

theorem toReferenceRun {stateRel : LoweredStateRel}
    {outcomeRel : LoweredOutcomeRel} {program : Program}
    {referenceFuel : Nat} {referenceInitial : State}
    {referenceResult : Result}
    (bridge :
      LoweredBridge stateRel outcomeRel program referenceFuel
        referenceInitial referenceResult) :
    runResult referenceFuel program referenceInitial = .ok referenceResult :=
  bridge.referenceRun

theorem toLoweredRun {stateRel : LoweredStateRel}
    {outcomeRel : LoweredOutcomeRel} {program : Program}
    {referenceFuel : Nat} {referenceInitial : State}
    {referenceResult : Result}
    (bridge :
      LoweredBridge stateRel outcomeRel program referenceFuel
        referenceInitial referenceResult) :
    Lowered.run bridge.sourceFuel program bridge.compilerInitial =
      .ok bridge.outcome :=
  bridge.sourceRun

end LoweredBridge

end Reference

namespace Program

theorem sourceLowered_runState_of_regular_root_block_source_bridge
    {cfg : Reference.StateRelConfig} {layoutAfter : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Program} {functionProgram : Functions.Program}
    {sourceFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract} {source : Reference.State}
    {sourceInitial : Objects.Source.State}
    (hToObjects :
      program.toObjects? =
        some { root := Objects.Object.mk "root" functionProgram [] [] })
    (hBridge :
      Reference.SourceBridgeFacts.SourceRegularSeqRunBridge (cfg := cfg)
        [] layoutAfter prim functionProgram Functions.Source.Ctx.initial
        sourceFuel sourceStmts codeOverride source sourceInitial
        functionProgram.body) :
    ∃ sourceAfter : Reference.State,
    ∃ compilerAfter : Objects.Source.State,
    ∃ ctxAfter : Functions.Source.Ctx,

      Functions.Source.Stmt.run, Locals.Source.Expr.ExprSeq.eval,
      hTerminal, Locals.Source.State.withShared,
      Functions.Source.Outcome.halt, Locals.Source.Outcome.halt,
      sourceOutcome]
  refine ⟨⟨?_, ?_⟩⟩
  · exact
      { accepted := hAccepted,
        sourceFuel := 1,
        sourceInitial := sourceInitial,
        sourceOutcome := sourceOutcome,
        referenceRun := by simpa [callState] using hReferenceRun,
        initialRel := hInitialRel,
        sourceRun := hSourceRun,
        outcomeRel := by
          simpa [sourceOutcome, callState, callShared] using hOutcomeRel }
  · exact ⟨rfl, by simp [sourceOutcome]⟩


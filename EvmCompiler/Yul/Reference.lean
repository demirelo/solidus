    (prim : EvmYul.Operation .Yul)
    (target : Locals.Expr 1) (stackSeq : Locals.ExprSeq 3)
    (op : Structured.BasicOp)
    (result : Word → Word → Word → Word)
    (hNoDupFull : fullLayoutAfter.Nodup)
    (hLeftBound :

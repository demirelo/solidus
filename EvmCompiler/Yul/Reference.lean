theorem condition_var_slot_bridge_of_lookup {cfg : StateRelConfig}
    {fullLayout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : RunState}
    (fuel : Nat) (name : EvmYul.Identifier)
    (codeOverride : Option AstContract) (ctx : Locals.Ctx)
    {idx : Nat} {value : Word}
    (hCtxLayout : ctx.layout = fullLayout)
    (hNoDup : fullLayout.Nodup)
    (hName : fullLayout[idx]? = some (identName name))
    (hBound : idx + 1 ≤ 16)
    (hStack : compiler.evm.stack[idx]? = some value)
    (hStore : store.lookup (identName name) = some value)
    (hShared : SharedStateRel cfg shared compiler.evm.toSharedState) :
    ∃ compilerAfter : RunState,
      EvmYul.Yul.eval fuel.succ (.Var name) codeOverride
          (.Ok shared store) =
        .ok (.Ok shared store, value) ∧
      Locals.Direct.Expr.runCondition ctx (.var (identName name)) compiler =
        .ok (compilerAfter, value != EvmYul.UInt256.ofNat 0) ∧
      compilerAfter.evm.stack = compiler.evm.stack ∧
      SharedStateRel cfg shared compilerAfter.evm.toSharedState ∧
      compilerAfter.returns = compiler.returns := by
  let evmAfterCode :=
    compiler.evm.replaceStackAndIncrPC (value :: compiler.evm.stack)
  let evmAfterPop : EVMState := { evmAfterCode with stack := compiler.evm.stack }
  let compilerAfter : RunState := compiler.withEVM evmAfterPop
  have hEval :
      EvmYul.Yul.eval fuel.succ (.Var name) codeOverride
          (.Ok shared store) =
        .ok (.Ok shared store, value) := by
    rw [Imported.eval_var_succ]
    simp [lookup?_ok (shared := shared) hStore]
  have hDepth :
      Locals.Layout.lookupDepth? (identName name) ctx.layout =
        some (idx + 1) := by
    simpa [hCtxLayout] using
      (lookupDepth?_of_get?_nodup hName hNoDup)
  have hOne : 1 ≤ idx + 1 := by
    omega
  rcases
      stackOp_dup?_step_eq_dup
        (n := idx + 1) hOne hBound compiler.evm with
    ⟨op, hDup, hStep⟩
  have hDupValue :
      EvmYul.dup (idx + 1) compiler.evm = .ok evmAfterCode := by
    simpa [evmAfterCode] using
      (evm_dup_succ_get? (state := compiler.evm) (idx := idx) hStack)
  have hRunCode :
      Locals.Direct.Expr.runCode ctx 0 (.var (identName name))
          compiler.evm =
        .ok evmAfterCode := by
    simp [Locals.Direct.Expr.runCode, hDepth, hDup]
    rw [hStep, hDupValue]
  have hPop :
      Structured.Code.popCondition evmAfterCode =
        .ok (evmAfterPop, value != EvmYul.UInt256.ofNat 0) := by
    simp [Structured.Code.popCondition, EvmYul.Stack.pop, evmAfterCode,
      evmAfterPop, EvmYul.EVM.State.replaceStackAndIncrPC,
      EvmYul.EVM.State.incrPC]
  have hRunCondition :
      Locals.Direct.Expr.runCondition ctx (.var (identName name)) compiler =
        .ok (compilerAfter, value != EvmYul.UInt256.ofNat 0) := by
    simp [Locals.Direct.Expr.runCondition, hRunCode, hPop, compilerAfter]
  refine ⟨compilerAfter, hEval, hRunCondition, ?hStackAfter, ?hSharedAfter,
    ?hReturns⟩
  · simp [compilerAfter, evmAfterPop]
  · simpa [compilerAfter, evmAfterPop, evmAfterCode,
      EvmYul.EVM.State.replaceStackAndIncrPC, EvmYul.EVM.State.incrPC]
      using hShared
  · simp [compilerAfter]


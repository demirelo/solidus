/--
Source-owned analogue of the direct/backend `CompilerOkOutcomeRel`.

This relation connects imported Yul ordinary/checkpoint states to the
stack-free source-tower outcome. It deliberately mentions only Yul modes and
the source state relation; stack layouts, cleanup depths, return tokens, and
procedure frames stay in the lower compiler proofs.
-/
inductive SourceOkOutcomeRel (cfg : StateRelConfig) (layout : List Name) :
    State → Objects.Source.Outcome → Prop where
  | regular {source : State} {compiler : Objects.Source.State}
      (hRel : SourceStateRel cfg layout source compiler) :
      SourceOkOutcomeRel cfg layout source
        (Functions.Source.Outcome.regular compiler)
  | brk {shared : EvmYul.SharedState .Yul}
      {store : EvmYul.Yul.VarStore} {compiler : Objects.Source.State}
      (hRel : SourceStateRel cfg layout (.Ok shared store) compiler) :
      SourceOkOutcomeRel cfg layout
        (.Checkpoint (.Break shared store))
        (Functions.Source.Outcome.brk compiler)
  | cont {shared : EvmYul.SharedState .Yul}
      {store : EvmYul.Yul.VarStore} {compiler : Objects.Source.State}
      (hRel : SourceStateRel cfg layout (.Ok shared store) compiler) :
      SourceOkOutcomeRel cfg layout
        (.Checkpoint (.Continue shared store))
        (Functions.Source.Outcome.cont compiler)
  | leave {shared : EvmYul.SharedState .Yul}
      {store : EvmYul.Yul.VarStore} {compiler : Objects.Source.State}
      (hRel : SourceStateRel cfg layout (.Ok shared store) compiler) :
      SourceOkOutcomeRel cfg layout
        (.Checkpoint (.Leave shared store))
        (Functions.Source.Outcome.leave compiler)

/--
Result relation for the imported-Yul-to-source-tower bridge.

Terminal imported Yul results are exceptions (`YulHalt`/`Revert`), while the
source tower represents EVM-level exits as `Outcome.halt`. The terminal and
revert relations are parameters because the exact agreement contract belongs to
the final shared-state/external-call boundary, not to the structural block
bridge itself.
-/
inductive SourceResultOutcomeRel (cfg : StateRelConfig) (layout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop) :
    Except Exception State → Objects.Source.Outcome → Prop where
  | ok {source : State} {outcome : Objects.Source.Outcome}
      (hRel : SourceOkOutcomeRel cfg layout source outcome) :
      SourceResultOutcomeRel cfg layout terminalRel revertRel
        (.ok source) outcome
  | yulHalt {source : State} {value : Word} {kind : Assembly.HaltKind}
      {compiler : Objects.Source.State}
      (hRel : terminalRel kind value source compiler) :
      SourceResultOutcomeRel cfg layout terminalRel revertRel
        (.error (.YulHalt source value))
        (Functions.Source.Outcome.halt kind compiler)
  | revert {source : State} {compiler : Objects.Source.State}
      (hRel : revertRel source compiler) :
      SourceResultOutcomeRel cfg layout terminalRel revertRel
        (.error (.Revert source))
        (Functions.Source.Outcome.halt .revert compiler)

/--
Imported source results that the compiler-facing source tower can relate.

The run-filtered recursive theorem must carry this predicate for its
`allowed` filter: successful top-level imported runs may project from ordinary
body states, Yul terminal halts, or reverts, but not from imported fuel or
front-end errors that the stack-free source tower intentionally does not model
as normal outcomes.
-/
def SourceResultRelatable : Except Exception State → Prop
  | .ok .OutOfFuel => False
  | .ok _source => True
  | .error (.YulHalt _source _value) => True
  | .error (.Revert _source) => True
  | .error _err => False

theorem sourceResultRelatable_stateOutOfFuel_false :
    SourceResultRelatable (.ok .OutOfFuel) → False := by
  intro h
  simpa [SourceResultRelatable] using h

theorem sourceResultRelatable_of_dispatcherRunResultOfBody_ok
    {program : Program} {state : State}
    {sourceResult : Except Exception State}
    {referenceResult : Result}
    (hNoOutOfFuel : sourceResult ≠ .ok .OutOfFuel)
    (hResult :
      Imported.dispatcherRunResultOfBody program state sourceResult =
        .ok referenceResult) :
    SourceResultRelatable sourceResult := by
  cases sourceResult with
  | ok source =>
      cases source <;> simp [SourceResultRelatable]
      exact False.elim (hNoOutOfFuel rfl)
  | error err =>
      cases err <;>
        simp [Imported.dispatcherRunResultOfBody, SourceResultRelatable]
          at hResult ⊢

theorem sourceResultOutcomeRel_halt_error
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {sourceResult : Except Exception State} {kind : Assembly.HaltKind}
    {compiler : Objects.Source.State}
    (hRel :
      SourceResultOutcomeRel cfg layout terminalRel revertRel sourceResult
        (Functions.Source.Outcome.halt kind compiler)) :
    ∃ err, sourceResult = .error err := by
  cases hRel with
  | ok hOk =>
      cases hOk
  | yulHalt hRel =>
      exact ⟨.YulHalt _ _, rfl⟩
  | revert hRel =>
      exact ⟨.Revert _, rfl⟩

theorem sourceStoreRel_nil (store : EvmYul.Yul.VarStore)
    (vars : Locals.Source.Store) :
    SourceStoreRel [] store vars := by
  intro name hMem
  cases hMem

theorem sourceStateRel_nil {cfg : StateRelConfig}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {source : Objects.Source.State}
    (hShared : SharedStateRel cfg shared source.shared) :
    SourceStateRel cfg [] (.Ok shared store) source :=
  SourceStateRel.ok hShared (sourceStoreRel_nil store source.vars)

/--
Regular sequence bridge from imported Yul statements to the stack-free function
source interpreter.  This is the intended recursive target for the Nethermind
Yul bridge; the older `BridgeFacts` namespace below remains backend-shaped and
targets `Functions.Direct`.
-/
def SourceRegularSeqRunBridge (cfg : StateRelConfig)
    (layout layoutAfter : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : Objects.Source.State) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : Objects.Source.State,
  ∃ ctxAfter : Functions.Source.Ctx, ∃ targetFuel : Nat,
    EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
      .ok sourceAfter ∧
    Functions.Source.Block.runOpen prim program ctx targetFuel lowerBlock
        compiler =
      .ok (Functions.Source.Outcome.regular compilerAfter, ctxAfter) ∧
    ctx.scope = layout ∧
    ctxAfter.scope = layoutAfter ∧
    (∀ name, name ∈ layout → name ∈ layoutAfter) ∧
    SourceStateRel cfg layoutAfter sourceAfter compilerAfter

/--
Regular sequence bridge that allows target-only locals in the function-source
context.

This is the right public shape for compiler-generated expression preludes: the
imported Yul side only observes `layout`, while the compiler-facing source
interpreter may carry fresh temporaries in `ctx.scope`.  Those hidden locals are
owned by the lowering proof and are intentionally absent from `SourceStateRel`.
-/
def SourceRegularSeqRunBridgeHidden (cfg : StateRelConfig)
    (layout layoutAfter : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : Objects.Source.State) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : Objects.Source.State,
  ∃ ctxAfter : Functions.Source.Ctx, ∃ targetFuel : Nat,
    EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
      .ok sourceAfter ∧
    Functions.Source.Block.runOpen prim program ctx targetFuel lowerBlock
        compiler =
      .ok (Functions.Source.Outcome.regular compilerAfter, ctxAfter) ∧
    (∀ name, name ∈ layout → name ∈ layoutAfter) ∧
    SourceStateRel cfg layoutAfter sourceAfter compilerAfter

theorem sourceRegularSeqRunBridgeHidden_of_bridge
    {cfg : StateRelConfig} {layout layoutAfter : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract} {source : State}
    {compiler : Objects.Source.State} {lowerBlock : Functions.Block}
    (hBridge :
      SourceRegularSeqRunBridge cfg layout layoutAfter prim program ctx
        sourceFuel sourceStmts codeOverride source compiler lowerBlock) :
    SourceRegularSeqRunBridgeHidden cfg layout layoutAfter prim program ctx
      sourceFuel sourceStmts codeOverride source compiler lowerBlock := by
  rcases hBridge with
    ⟨sourceAfter, compilerAfter, ctxAfter, targetFuel, hSource, hCompiler,
      _hCtxScope, _hCtxAfterScope, hSubset, hRel⟩
  exact
    ⟨sourceAfter, compilerAfter, ctxAfter, targetFuel, hSource, hCompiler,
      hSubset, hRel⟩

/--
Target-fuel-parametric source sequence bridge.

This is the most compositional fuel interface for the Yul source bridge:
statement-list composition in `Functions.Source.Block.runOpen` requires the
head statement and regular tail to share the same target subfuel, while the
imported Yul side may spend fuel at a slightly different syntactic boundary.
-/
def SourceRegularSeqRunAt (cfg : StateRelConfig)
    (layout layoutAfter : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel targetFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : Objects.Source.State) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : Objects.Source.State,
  ∃ ctxAfter : Functions.Source.Ctx,
    EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
      .ok sourceAfter ∧
    Functions.Source.Block.runOpen prim program ctx targetFuel lowerBlock
        compiler =
      .ok (Functions.Source.Outcome.regular compilerAfter, ctxAfter) ∧
    ctx.scope = layout ∧
    ctxAfter.scope = layoutAfter ∧
    (∀ name, name ∈ layout → name ∈ layoutAfter) ∧
    SourceStateRel cfg layoutAfter sourceAfter compilerAfter

/--
Result-shaped source sequence bridge.

This is the source-tower analogue of the older direct/backend result sequence
interface: it relates imported `execSeq` to the stack-free
`Functions.Source.Block.runOpen`, with Yul-like outcomes at the public
boundary.  The `outcomeLayout` can differ from the returned context layout for
abrupt exits, because break/continue/leave are cleaned to their handler scope
while `runOpen` returns the syntactic context where the abrupt head occurred.
-/
def SourceResultSeqRunAt (cfg : StateRelConfig)
    (layout ctxAfterLayout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel targetFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : Objects.Source.State) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceResult : Except Exception State,
  ∃ sourceOutcome : Objects.Source.Outcome,
  ∃ ctxAfter : Functions.Source.Ctx,
    EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
      sourceResult ∧
    Functions.Source.Block.runOpen prim program ctx targetFuel lowerBlock
        compiler =
      .ok (sourceOutcome, ctxAfter) ∧
    ctx.scope = layout ∧
    ctxAfter.scope = ctxAfterLayout ∧
    (∀ name, name ∈ layout → name ∈ ctxAfterLayout) ∧
    SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
      sourceResult sourceOutcome

/--
Run-filtered source-owned open-sequence soundness.

This is the list-level induction target for the imported-Yul bridge.  It keeps
the open-block context layout (`ctxAfterLayout`) separate from the outcome
layout used for abrupt exits, and it is filtered by the imported result shape
so recursive proofs are not asked to relate source-level `OutOfFuel` errors as
ordinary Yul outcomes.
-/
def SourceResultSeqSoundWhenAt (cfg : StateRelConfig)
    (layout ctxAfterLayout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (lowerBlock : Functions.Block)
    (allowed : Except Exception State → Prop) : Prop :=
  ctx.scope = layout ∧
    ∀ {source compiler sourceResult},
      SourceStateRel cfg layout source compiler →
      allowed sourceResult →
      EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
        sourceResult →
      ∃ sourceOutcome : Objects.Source.Outcome,
      ∃ ctxAfter : Functions.Source.Ctx,
      ∃ targetFuel : Nat,
        Functions.Source.Block.runOpen prim program ctx targetFuel lowerBlock
            compiler =
          .ok (sourceOutcome, ctxAfter) ∧
        ctxAfter.scope = ctxAfterLayout ∧
        (∀ name, name ∈ layout → name ∈ ctxAfterLayout) ∧
        SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
          sourceResult sourceOutcome

/--
Run-filtered source-owned open-sequence soundness at a fixed target fuel.

Regular-head composition in `Functions.Source.Block.runOpen` requires the head
and tail to share the same target subfuel.  This fuel-specific variant is the
compositional interface for those proofs; the existential
`SourceResultSeqSoundWhenAt` above remains the public projection.
-/
def SourceResultSeqSoundWhenAtFuel (cfg : StateRelConfig)
    (layout ctxAfterLayout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel targetFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (lowerBlock : Functions.Block)
    (allowed : Except Exception State → Prop) : Prop :=
  ctx.scope = layout ∧
    ∀ {source compiler sourceResult},
      SourceStateRel cfg layout source compiler →
      allowed sourceResult →
      EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
        sourceResult →
      ∃ sourceOutcome : Objects.Source.Outcome,
      ∃ ctxAfter : Functions.Source.Ctx,
        Functions.Source.Block.runOpen prim program ctx targetFuel lowerBlock
            compiler =
          .ok (sourceOutcome, ctxAfter) ∧
        ctxAfter.scope = ctxAfterLayout ∧
        (∀ name, name ∈ layout → name ∈ ctxAfterLayout) ∧
        SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
          sourceResult sourceOutcome

/--
Fixed-target-fuel open-sequence soundness with exact imported varstore domain.

This is the domain-aware sibling needed for statements whose imported Yul
semantics checks declaration or assignment validity.  It keeps the high-level
state relation stack-free, but makes the source varstore domain invariant
explicit at the bridge boundary.
-/
def SourceResultSeqSoundWhenAtFuelExact (cfg : StateRelConfig)
    (layout ctxAfterLayout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)

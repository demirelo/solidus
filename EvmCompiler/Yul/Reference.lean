    {compiler : RunState} {pre : List Functions.Stmt}
    {leftTmp rightTmp : Name}
    (prim : EvmYul.Operation .Yul)
    (target : Locals.Expr 1)
    (stackSeq : Locals.ExprSeq 2)
    (result : Word → Word → Word)
    (hNoDupFull : fullLayoutAfter.Nodup)
    (hLeftBound :
      ∀ {leftIdx : Nat},
        fullLayoutAfter[leftIdx]? = some leftTmp →
          1 + leftIdx + 1 ≤ 16)
    (hRightBound :
      ∀ {rightIdx : Nat},
        fullLayoutAfter[rightIdx]? = some rightTmp →
          rightIdx + 1 ≤ 16)
    (hPrimCall :
      ∀ (fuel : Nat) (shared : EvmYul.SharedState .Yul)
        (store : EvmYul.Yul.VarStore) (leftValue rightValue : Word),
        EvmYul.Yul.primCall fuel.succ (.Ok shared store) prim
          [leftValue, rightValue] =
          .ok (.Ok shared store, [result leftValue rightValue]))
    (hStackSeq :
      Expr.List.toStackSeq? [.var leftTmp, .var rightTmp] 2 =
        some stackSeq)
    (hTargetRun :
      ∀ (ctxAfter : Locals.Ctx) (base : RunState)
        (evmAfterArgReads : EVMState) (leftValue rightValue : Word),
        Locals.Direct.Expr.ExprSeq.runCode ctxAfter 0 stackSeq base.evm =
          .ok evmAfterArgReads →
        evmAfterArgReads.stack =
          leftValue :: rightValue :: base.evm.stack →
        evmAfterArgReads.toSharedState = base.evm.toSharedState →
        ∃ finalEVM : EVMState,
          Locals.Direct.Expr.runCode ctxAfter 0 target base.evm =
            .ok finalEVM ∧
          finalEVM.stack =
            result leftValue rightValue :: base.evm.stack ∧
          finalEVM.toSharedState = base.evm.toSharedState)
    (hArgs :
      BoundArgsBridgeWithLayoutSlotValues (cfg := cfg) sourceLayout
        fullLayout fullLayoutAfter program returns ctx argFuel [left, right]
        codeOverride source compiler pre [.var leftTmp, .var rightTmp]) :

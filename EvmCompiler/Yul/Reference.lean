      hAfterPop, hRelAfter, hReturns⟩
  exact
    ⟨compilerAfterCode, stack, compilerAfterPop, hEvalExpected, hRunState,
      hPop, hAfterPop, hRelAfter, hReturns⟩

def ReturnLayoutBounds (baseOffset : Nat) (layout returns : List Name) :
    Prop :=
  ∀ idx name, returns[idx]? = some name →
    ∃ layoutIdx,
      layout[layoutIdx]? = some name ∧
        baseOffset + idx + layoutIdx + 1 ≤ 16

theorem exprSeq_runCode_congrArg {n m : Nat} (h : n = m)
    (exprs : Locals.ExprSeq n) (ctx : Locals.Ctx) (offset : Nat)
    (compiler : EVMState) :
    Locals.Direct.Expr.ExprSeq.runCode ctx offset
        (Eq.mp (congrArg Locals.ExprSeq h) exprs) compiler =
      Locals.Direct.Expr.ExprSeq.runCode ctx offset exprs compiler := by
  cases h
  rfl

theorem returnStackRel_nil (store : EvmYul.Yul.VarStore) :
    ReturnStackRel [] store [] := by
  exact ExactVarStackRel.nil store

theorem returnStackRel_cons {returns : List Name}
    {store : EvmYul.Yul.VarStore} {temps : EvmYul.Stack Word}
    {name : Name} {value : Word}
    (hLookup : store.lookup name = some value)
    (hRel : ReturnStackRel returns store temps) :
    ReturnStackRel (name :: returns) store (temps ++ [value]) := by
  unfold ReturnStackRel at hRel ⊢
  simpa using ExactVarStackRel.cons hLookup hRel

theorem returnStackRel_length {returns : List Name}
    {store : EvmYul.Yul.VarStore} {temps : EvmYul.Stack Word}
    (hRel : ReturnStackRel returns store temps) :
    temps.length = returns.length := by
  unfold ReturnStackRel ExactVarStackRel at hRel
  have hLen := VarStackRel.exact_length hRel
  simpa [List.length_reverse] using hLen.symm

theorem CompilerStateRelWithTempsAndLayoutSlots.withReturnLayout
    {cfg : StateRelConfig}
    {sourceLayout fullLayout returns : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : EVMState}
    {returnTemps : EvmYul.Stack Word}
    (hReturnRel : ReturnStackRel returns store returnTemps)
    (hRel :
      CompilerStateRelWithTempsAndLayoutSlots cfg sourceLayout fullLayout
        returnTemps (.Ok shared store) compiler) :
    CompilerStateRelWithLayoutSlots cfg (returns ++ sourceLayout)
      (returns.reverse ++ fullLayout) (.Ok shared store) compiler := by
  cases hRel with
  | @ok shared' store' compilerEVM baseStack hShared hVars hCover hStack =>
      have hReturnLen : returnTemps.length = returns.length :=
        returnStackRel_length hReturnRel
      refine CompilerStateRelWithLayoutSlots.ok hShared ?hVars ?hCover
      · intro sourceIdx sourceName hSourceName
        by_cases hIdxReturn : sourceIdx < returns.length
        · have hReturnName : returns[sourceIdx]? = some sourceName := by
            rw [List.getElem?_append_left hIdxReturn] at hSourceName
            exact hSourceName
          rcases ExactVarStackRel.get? hReturnRel hReturnName with
            ⟨value, hReturnStackRev, hLookup⟩
          let revIdx := returns.length - (sourceIdx + 1)
          have hRevIdxLtReturns : revIdx < returns.length := by
            simp [revIdx]
            omega
          have hRevEqReturns :
              revIdx + sourceIdx + 1 = returns.length := by
            simp [revIdx]
            omega
          have hFullName :
              (returns.reverse ++ fullLayout)[revIdx]? = some sourceName := by
            rw [List.getElem?_append_left]
            · rw [List.getElem?_reverse' hRevEqReturns]
              exact hReturnName
            · simpa [List.length_reverse] using hRevIdxLtReturns
          have hRevEqTemps :
              sourceIdx + revIdx + 1 = returnTemps.length := by
            rw [hReturnLen]
            omega
          have hStackPrefix :
              returnTemps[revIdx]? = some value := by
            have hReverse :
                returnTemps.reverse[sourceIdx]? = returnTemps[revIdx]? :=
              List.getElem?_reverse' (l := returnTemps)
                (i := sourceIdx) (j := revIdx) hRevEqTemps
            rw [← hReverse]
            exact hReturnStackRev
          have hStackValue :
              (returnTemps ++ baseStack)[revIdx]? = some value := by
            rw [List.getElem?_append_left]
            · exact hStackPrefix
            · rw [hReturnLen]
              exact hRevIdxLtReturns
          refine ⟨revIdx, value, hFullName, ?hStackValue, hLookup⟩
          rw [hStack]
          exact hStackValue
        · have hIdxAfter : returns.length ≤ sourceIdx :=
            Nat.le_of_not_gt hIdxReturn
          have hSourceAfter :
              sourceLayout[sourceIdx - returns.length]? = some sourceName := by
            rw [List.getElem?_append_right hIdxAfter] at hSourceName
            exact hSourceName
          rcases hVars hSourceAfter with
            ⟨fullIdx, value, hFullNameBase, hStackBase, hLookup⟩
          refine
            ⟨returns.reverse.length + fullIdx, value, ?hFullNameAfter,
              ?hStackValueAfter, hLookup⟩
          · rw [List.getElem?_append_right]
            · have hSub :
                  returns.reverse.length + fullIdx - returns.reverse.length =
                    fullIdx := by
                omega
              rw [hSub]
              exact hFullNameBase
            · omega
          · rw [hStack]
            have hIdxEq :
                returns.reverse.length + fullIdx =
                  returnTemps.length + fullIdx := by
              simp [List.length_reverse, hReturnLen]
            rw [hIdxEq]
            rw [List.getElem?_append_right]
            · have hSub :
                  returnTemps.length + fullIdx - returnTemps.length =
                    fullIdx := by
                omega
              rw [hSub]
              exact hStackBase
            · omega
      · rw [hStack]
        simp [List.length_append, List.length_reverse, hReturnLen]
        omega

theorem returnExprs_runCode_layout_slots
    {cfg : StateRelConfig}
    {sourceLayout fullLayout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : EVMState}
    (returns : List Name) (ctx : Locals.Ctx)
    {temps : EvmYul.Stack Word} {offset : Nat}
    (hCtxLayout : ctx.layout = fullLayout)
    (hOffset : offset = temps.length)
    (hNoDup : fullLayout.Nodup)
    (hReturnSource : SourceLayoutEmbedded returns sourceLayout)
    (hBounds : ReturnLayoutBounds offset fullLayout returns)
    (hRel :
      CompilerStateRelWithTempsAndLayoutSlots cfg sourceLayout fullLayout
        temps (.Ok shared store) compiler) :
    ∃ compilerAfter returnTemps,
      Locals.Direct.Expr.ExprSeq.runCode ctx offset
          (Functions.Lower.returnExprs returns) compiler =
        .ok compilerAfter ∧
      ReturnStackRel returns store returnTemps ∧
      CompilerStateRelWithTempsAndLayoutSlots cfg sourceLayout fullLayout
        (returnTemps ++ temps) (.Ok shared store) compilerAfter := by
  induction returns generalizing compiler temps offset with
  | nil =>
      refine ⟨compiler, [], ?hRun, returnStackRel_nil store, ?hRel⟩
      · simp [Functions.Lower.returnExprs,
          Locals.Direct.Expr.ExprSeq.runCode]
      · simpa using hRel
  | cons name rest ih =>
      rcases hReturnSource (sourceIdx := 0) (sourceName := name)
          (by simp) with
        ⟨sourceIdx, hSourceName⟩
      rcases hBounds 0 name (by simp) with
        ⟨headFullIdx, hHeadFull, hHeadBound⟩
      have hHeadBoundAll :
          ∀ {fullIdx : Nat},
            fullLayout[fullIdx]? = some name →
              offset + fullIdx + 1 ≤ 16 := by
        intro fullIdx hFullIdx
        have hEq :
            fullIdx = headFullIdx :=
          getElem?_eq_index_of_nodup hNoDup hFullIdx hHeadFull
        subst fullIdx
        omega
      rcases
          runCode_var_withTemps_layout_slots
            (cfg := cfg) (sourceLayout := sourceLayout)
            (fullLayout := fullLayout) (shared := shared) (store := store)
            (compiler := compiler) name ctx (temps := temps)
            (offset := offset) (sourceIdx := sourceIdx)
            hCtxLayout hOffset hNoDup hSourceName hHeadBoundAll hRel with
        ⟨value, compilerHead, hLookup, hRunHead, hRelHead⟩
      have hReturnSourceRest : SourceLayoutEmbedded rest sourceLayout := by
        intro restIdx restName hRestName
        exact
          hReturnSource (sourceIdx := restIdx + 1)
            (sourceName := restName) (by simpa using hRestName)
      have hBoundsRest : ReturnLayoutBounds (offset + 1) fullLayout rest := by
        intro restIdx restName hRestName
        rcases hBounds (restIdx + 1) restName
            (by simpa using hRestName) with
          ⟨layoutIdx, hLayoutIdx, hBoundRest⟩
        exact ⟨layoutIdx, hLayoutIdx, by omega⟩
      have hOffsetRest : offset + 1 = (value :: temps).length := by
        simp [hOffset]
      rcases
          ih (compiler := compilerHead) (temps := value :: temps)
            (offset := offset + 1) hOffsetRest hReturnSourceRest hBoundsRest
            hRelHead with
        ⟨compilerAfter, restTemps, hRunRest, hRestRel, hRelAfter⟩
      refine ⟨compilerAfter, restTemps ++ [value], ?_, ?_, ?_⟩
      · have hCons :
            Locals.Direct.Expr.ExprSeq.runCode ctx offset
                (Functions.Lower.returnExprs (name :: rest)) compiler =
              (do
                let compilerHead ←
                  Locals.Direct.Expr.runCode ctx offset (.var name) compiler
                Locals.Direct.Expr.ExprSeq.runCode ctx (offset + 1)
                  (Functions.Lower.returnExprs rest) compilerHead) := by
          conv_lhs =>
            unfold Functions.Lower.returnExprs
            unfold Functions.Lower.returnExprs._proof_1
          simp only [id]
          rw [exprSeq_runCode_congrArg]
          · rfl
          · exact Nat.add_comm 1 rest.length
        rw [hCons, hRunHead]
        exact hRunRest
      · exact returnStackRel_cons hLookup hRestRel
      · simpa [List.append_assoc] using hRelAfter

theorem pushReturns_layout_slots_bridge
    {cfg : StateRelConfig}
    {sourceLayout fullLayout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : RunState}
    (returns : List Name) (ctx : Locals.Ctx)
    (hCtxLayout : ctx.layout = fullLayout)
    (hNoDup : fullLayout.Nodup)
    (hReturnSource : SourceLayoutEmbedded returns sourceLayout)
    (hBounds : ReturnLayoutBounds 0 fullLayout returns)
    (hRel :
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Ok shared store) compiler.evm) :
    ∃ compilerAfter returnTemps,
      Functions.Direct.pushReturns ctx returns compiler = .ok compilerAfter ∧
      ReturnStackRel returns store returnTemps ∧
      CompilerStateRelWithTempsAndLayoutSlots cfg sourceLayout fullLayout
        returnTemps (.Ok shared store) compilerAfter.evm ∧
      compilerAfter.returns = compiler.returns := by
  cases returns with
  | nil =>
      refine
        ⟨compiler, [], ?hRun, returnStackRel_nil store, ?hRelAfter,
          ?hReturns⟩
      · simp [Functions.Direct.pushReturns]
      · simpa using
          (CompilerStateRelWithLayoutSlots.withTemps_nil hRel)
      · simp
  | cons name rest =>
      rcases
          returnExprs_runCode_layout_slots
            (cfg := cfg) (sourceLayout := sourceLayout)
            (fullLayout := fullLayout) (shared := shared) (store := store)
            (compiler := compiler.evm) (returns := name :: rest) (ctx := ctx)
            (temps := []) (offset := 0) hCtxLayout rfl hNoDup
            hReturnSource hBounds
            (CompilerStateRelWithLayoutSlots.withTemps_nil hRel) with
        ⟨evmAfter, returnTemps, hRunCode, hReturnRel, hRelAfter⟩
      let compilerAfter := compiler.withEVM evmAfter
      refine ⟨compilerAfter, returnTemps, ?_, hReturnRel, ?_, ?_⟩
      · simp [Functions.Direct.pushReturns, hRunCode, compilerAfter]
      · simpa [compilerAfter] using hRelAfter
      · simp [compilerAfter]

theorem resultSeqRunBridgeWithLayoutSlots_cons_leave_checked
    {cfg : StateRelConfig}
    {sourceLayout fullLayout outcomeSourceLayout outcomeFullLayout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : RunState}
    {rest : List AstStmt} {lowerTail : Functions.Block}
    (sourceFuel : Nat) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (codeOverride : Option AstContract) {target : Nat}
    {frame : Structured.ReturnDest} {restFrames : List Structured.ReturnDest}
    (hCtxLayout : ctx.layout = fullLayout)
    (hLeave : ctx.leaveDepth? = some target)
    (hLeaveRetc : ctx.leaveRetc = returns.length)
    (hReturnStack : compiler.returns = frame :: restFrames)
    (hSourceSuffix : LayoutSuffix outcomeSourceLayout sourceLayout)
    (hFullSuffix : LayoutSuffix outcomeFullLayout fullLayout)
    (hNoDupFull : fullLayout.Nodup)
    (hTargetDepth : target = outcomeFullLayout.length)
    (hEmbeddedAfter :
      SourceLayoutEmbedded outcomeSourceLayout outcomeFullLayout)
    (hReturnSource : SourceLayoutEmbedded returns sourceLayout)
    (hReturnBounds : ReturnLayoutBounds 0 fullLayout returns)
    (hReturnsLen : returns.length ≤ 16)
    (hRel :
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Ok shared store) compiler.evm) :
    ResultSeqRunBridgeWithLayoutSlots (cfg := cfg) sourceLayout fullLayout
      fullLayout (returns ++ outcomeSourceLayout)
      (returns.reverse ++ outcomeFullLayout) program returns ctx
      sourceFuel.succ.succ (.Leave :: rest) codeOverride (.Ok shared store)
      compiler { stmts := [Functions.Stmt.leave] ++ lowerTail.stmts } := by
  rcases
      pushReturns_layout_slots_bridge
        (cfg := cfg) (sourceLayout := sourceLayout) (fullLayout := fullLayout)
        (shared := shared) (store := store) (compiler := compiler)
        (returns := returns) (ctx := ctx) hCtxLayout hNoDupFull
        hReturnSource hReturnBounds hRel with
    ⟨afterReturns, returnTemps, hPushReturns, hReturnRel, hRelReturns,
      hReturnsAfterPush⟩
  have hReturnTempsBound : returnTemps.length ≤ 16 := by
    rw [returnStackRel_length hReturnRel]
    exact hReturnsLen
  rcases
      runCleanupToPreserving_compilerStateRelWithTempsAndLayoutSlots_suffix
        (cfg := cfg) (sourceLayout := sourceLayout)
        (fullLayout := fullLayout)
        (sourceLayoutAfter := outcomeSourceLayout)
        (fullLayoutAfter := outcomeFullLayout) (shared := shared)
        (store := store) (compiler := afterReturns) (ctx := ctx)
        (target := target) (returnTemps := returnTemps) hCtxLayout
        hSourceSuffix hFullSuffix hNoDupFull hTargetDepth
        hReturnTempsBound hEmbeddedAfter hRelReturns with
    ⟨cleaned, hCleanup, hCleanTempsRel, hCleanReturns⟩
  have hCleanRel :
      CompilerStateRelWithLayoutSlots cfg (returns ++ outcomeSourceLayout)
        (returns.reverse ++ outcomeFullLayout) (.Ok shared store)
        cleaned.evm :=
    CompilerStateRelWithTempsAndLayoutSlots.withReturnLayout
      hReturnRel hCleanTempsRel
  have hSourceHead :
      EvmYul.Yul.exec sourceFuel.succ .Leave codeOverride
          (.Ok shared store) =
        .ok (.Checkpoint (.Leave shared store)) :=
    Imported.exec_leave_succ sourceFuel codeOverride (.Ok shared store)
  have hSource :
      EvmYul.Yul.execSeq sourceFuel.succ.succ (.Leave :: rest)
          codeOverride (.Ok shared store) =
        .ok (.Checkpoint (.Leave shared store)) :=
    Imported.execSeq_cons_checkpoint_succ hSourceHead
  have hTargetRun :
      Functions.Direct.Block.runOpen program returns ctx 1
          { stmts := [Functions.Stmt.leave] ++ lowerTail.stmts } compiler =
        .ok (Structured.Outcome.leave cleaned, ctx) := by
    have hCleanupPreserving :
        Locals.Direct.Ctx.runCleanupToPreserving ctx ctx.leaveRetc target
            afterReturns =
          .ok cleaned := by
      rw [hLeaveRetc]
      have hLen : returns.length = returnTemps.length := by
        exact (returnStackRel_length hReturnRel).symm
      rw [hLen]
      exact hCleanup
    simp [Functions.Direct.Block.runOpen, Functions.Direct.Stmt.run, hLeave,
      hPushReturns, hCleanupPreserving, hCleanReturns, hReturnsAfterPush,
      hReturnStack]
  exact
    ⟨.ok (.Checkpoint (.Leave shared store)), Structured.Outcome.leave cleaned,
      ctx, 1, hSource, hTargetRun, hCtxLayout, hCtxLayout,
      LayoutSuffix.refl fullLayout,
      CompilerResultOutcomeRelWithLayoutSlots.ok
        (CompilerOkOutcomeRelWithLayoutSlots.leave hCleanRel),
      by simpa [hCleanReturns, hReturnsAfterPush, hReturnStack]⟩


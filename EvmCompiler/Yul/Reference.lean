            .ok (.Ok shared store, [sourceResult shared]) := by
        rw [EvmYul.Yul.evalValues]
        simp [Imported.evalArgs_nil_succ, EvmYul.Yul.reverse',
          hPrimCall sourceFuel shared store]
      let evmAfter : EVMState :=
        compiler.evm.replaceStackAndIncrPC
          (targetResult compiler.evm :: compiler.evm.stack)
      let compilerAfterExpr : RunState :=
        compiler.withEVM evmAfter
      have hRunOp :
          Structured.BasicOp.step op compiler.evm = .ok evmAfter := by
        simpa [evmAfter] using
          hStep compiler.evm compiler.evm.stack rfl
      have hRunCode :
          Locals.Direct.Expr.runCode ctx 0 target compiler.evm =
            .ok evmAfter := by
        rw [hTargetRunCode ctx compiler]
        exact hRunOp
      have hRunState :
          Locals.Direct.Expr.runState ctx target compiler =
            .ok compilerAfterExpr := by
        unfold Locals.Direct.Expr.runState
        simp [hRunCode, compilerAfterExpr]
      have hResultEq : sourceResult shared = targetResult compiler.evm :=
        hResultRel hShared
      have hRelAfter :
          CompilerStateRelWithTempsAndLayoutSlots cfg sourceLayout fullLayout
            [sourceResult shared] (.Ok shared store)
            compilerAfterExpr.evm := by
        refine
          CompilerStateRelWithTempsAndLayoutSlots.ok ?_ hVars hCover ?_
        · simpa [compilerAfterExpr, evmAfter,
            EvmYul.EVM.State.replaceStackAndIncrPC,
            EvmYul.EVM.State.incrPC] using hShared
        · simp [compilerAfterExpr, evmAfter,
            EvmYul.EVM.State.replaceStackAndIncrPC,
            EvmYul.EVM.State.incrPC, hResultEq]
      exact
        ⟨.Ok shared store, sourceResult shared, compiler,
          compilerAfterExpr, ctx, 1, hSourceEval,
          by simp [Functions.Direct.Block.runOpen], hCtxLayout, hCtxLayout,
          LayoutSuffix.refl fullLayout, hRunState, hRelAfter, rfl,
          by simp [compilerAfterExpr]⟩


theorem select_switch_case_nil (cond : Word) (defaultBody : List AstStmt) :
    EvmYul.Yul.selectSwitchCase cond defaultBody [] = defaultBody := by
  rfl

theorem select_switch_case_cons (cond value : Word)
    (body : List AstStmt) (rest : List (Word × List AstStmt))
    (defaultBody : List AstStmt) :
    EvmYul.Yul.selectSwitchCase cond defaultBody ((value, body) :: rest) =
      if value = cond then body
      else EvmYul.Yul.selectSwitchCase cond defaultBody rest := by
  rfl

theorem evalArgs_zero (args : List AstExpr)
    (codeOverride : Option AstContract) (state : State) :
    EvmYul.Yul.evalArgs 0 args codeOverride state =
      .error .OutOfFuel := by
  simp [EvmYul.Yul.evalArgs]

theorem evalArgs_nil_succ (fuel : Nat)
    (codeOverride : Option AstContract) (state : State) :
    EvmYul.Yul.evalArgs fuel.succ [] codeOverride state =
      .ok (state, []) := by
  simp [EvmYul.Yul.evalArgs]

theorem evalArgs_cons_succ (fuel : Nat) (head : AstExpr)
    (tail : List AstExpr) (codeOverride : Option AstContract)
    (state : State) :
    EvmYul.Yul.evalArgs fuel.succ (head :: tail) codeOverride state =
      EvmYul.Yul.evalTail fuel tail codeOverride
        (EvmYul.Yul.eval fuel head codeOverride state) := by
  simp [EvmYul.Yul.evalArgs]

theorem evalArgs_length_of_ok
    {fuel : Nat} {args : List AstExpr} {codeOverride : Option AstContract}
    {state state' : State} {values : List Word}
    (hEval :
      EvmYul.Yul.evalArgs fuel args codeOverride state =
        .ok (state', values)) :
    values.length = args.length := by
  induction args generalizing fuel state state' values with
  | nil =>
      cases fuel with
      | zero =>
          simp [EvmYul.Yul.evalArgs] at hEval
      | succ fuel' =>
          simp [EvmYul.Yul.evalArgs] at hEval
          rcases hEval with ⟨_hState, hValues⟩
          subst values
          rfl
  | cons head tail ih =>
      cases fuel with
      | zero =>
          simp [EvmYul.Yul.evalArgs] at hEval
      | succ fuel' =>
          rw [evalArgs_cons_succ] at hEval
          cases hHead :
              EvmYul.Yul.eval fuel' head codeOverride state with
          | error err =>
              simp [EvmYul.Yul.evalTail, hHead] at hEval
          | ok headResult =>
              rcases headResult with ⟨stateAfterHead, value⟩
              cases fuel' with
              | zero =>
                  simp [EvmYul.Yul.evalTail, hHead] at hEval
              | succ fuelTail =>
                  cases hTail :
                      EvmYul.Yul.evalArgs fuelTail tail codeOverride
                        stateAfterHead with
                  | error err =>
                      simp [EvmYul.Yul.evalTail, hHead, hTail,
                        EvmYul.Yul.cons'] at hEval
                  | ok tailResult =>
                      rcases tailResult with ⟨stateAfterTail, tailValues⟩
                      simp [EvmYul.Yul.evalTail, hHead, hTail,
                        EvmYul.Yul.cons'] at hEval
                      rcases hEval with ⟨_hState, hValues⟩
                      subst values
                      have hTailLen :
                          tailValues.length = tail.length :=
                        ih hTail
                      simp [hTailLen]

theorem evalTail_error (fuel : Nat) (tail : List AstExpr)
    (codeOverride : Option AstContract) (err : Exception) :
    EvmYul.Yul.evalTail fuel tail codeOverride (.error err) =
      .error err := by
  simp [EvmYul.Yul.evalTail]

theorem evalTail_ok_zero (value : Word) (tail : List AstExpr)
    (codeOverride : Option AstContract) (state : State) :
    EvmYul.Yul.evalTail 0 tail codeOverride (.ok (state, value)) =
      .error .OutOfFuel := by
  simp [EvmYul.Yul.evalTail]

theorem evalTail_nil_ok_succ (fuel : Nat) (value : Word)
    (codeOverride : Option AstContract) (state : State) :
    EvmYul.Yul.evalTail fuel.succ.succ [] codeOverride (.ok (state, value)) =
      .ok (state, [value]) := by
  simp [EvmYul.Yul.evalTail, EvmYul.Yul.evalArgs, EvmYul.Yul.cons']

theorem eval_prim_call_succ (fuel : Nat)
    (prim : EvmYul.Operation .Yul) (args : List AstExpr)
    (codeOverride : Option AstContract) (state : State) :
    EvmYul.Yul.eval fuel.succ (.Call (.inl prim) args) codeOverride state =
      EvmYul.Yul.evalPrimCall fuel prim
        (EvmYul.Yul.reverse'
          (EvmYul.Yul.evalArgs fuel args.reverse codeOverride state)) := by
  simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues, EvmYul.Yul.head',
    EvmYul.Yul.evalPrimCall]
  cases EvmYul.Yul.reverse'
      (EvmYul.Yul.evalArgs fuel args.reverse codeOverride state) <;> rfl

theorem eval_user_call_succ (fuel : Nat)
    (functionName : Name) (args : List AstExpr)
    (codeOverride : Option AstContract) (state : State) :
    EvmYul.Yul.eval fuel.succ (.Call (.inr functionName) args)
        codeOverride state =
      EvmYul.Yul.evalCall fuel.succ functionName codeOverride
        (EvmYul.Yul.reverse'
          (EvmYul.Yul.evalArgs fuel args.reverse codeOverride state)) := by
  simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues, EvmYul.Yul.head',
    EvmYul.Yul.evalCall]
  cases EvmYul.Yul.reverse'
      (EvmYul.Yul.evalArgs fuel args.reverse codeOverride state) <;> rfl

theorem exec_block_cons_succ (fuel : Nat) (stmt : AstStmt)
    (rest : List AstStmt) (codeOverride : Option AstContract)
    (state : State) :
    EvmYul.Yul.exec fuel.succ (.Block (stmt :: rest)) codeOverride state =
      match EvmYul.Yul.execSeq fuel (stmt :: rest) codeOverride state with
      | .error err => .error err
      | .ok state' => .ok (state'.restrictStoreTo state.store) := by
  simp [EvmYul.Yul.exec]
  rfl

theorem execSeq_nil_succ (fuel : Nat) (codeOverride : Option AstContract)
    (state : State) :
    EvmYul.Yul.execSeq fuel.succ [] codeOverride state = .ok state := by
  simp [EvmYul.Yul.execSeq]

theorem execSeq_cons_ok_succ {fuel : Nat} {stmt : AstStmt}
    {rest : List AstStmt} {codeOverride : Option AstContract}
    {state final : State} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    (hHead :
      EvmYul.Yul.exec fuel stmt codeOverride state =
        .ok (.Ok shared store))
    (hTail :
      EvmYul.Yul.execSeq fuel rest codeOverride (.Ok shared store) =
        .ok final) :
    EvmYul.Yul.execSeq fuel.succ (stmt :: rest) codeOverride state =
      .ok final := by
  simp [EvmYul.Yul.execSeq, hHead, hTail]

theorem execSeq_cons_ok_result_succ {fuel : Nat} {stmt : AstStmt}
    {rest : List AstStmt} {codeOverride : Option AstContract}
    {state : State} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {result : Except Exception State}
    (hHead :
      EvmYul.Yul.exec fuel stmt codeOverride state =
        .ok (.Ok shared store))
    (hTail :
      EvmYul.Yul.execSeq fuel rest codeOverride (.Ok shared store) =
        result) :
    EvmYul.Yul.execSeq fuel.succ (stmt :: rest) codeOverride state =
      result := by
  simp [EvmYul.Yul.execSeq, hHead, hTail]

theorem execSeq_cons_checkpoint_succ {fuel : Nat} {stmt : AstStmt}
    {rest : List AstStmt} {codeOverride : Option AstContract}
    {state : State} {jump : EvmYul.Yul.Jump}
    (hHead :
      EvmYul.Yul.exec fuel stmt codeOverride state =
        .ok (.Checkpoint jump)) :
    EvmYul.Yul.execSeq fuel.succ (stmt :: rest) codeOverride state =
      .ok (.Checkpoint jump) := by
  simp [EvmYul.Yul.execSeq, hHead]

theorem execSeq_cons_outOfFuel_succ {fuel : Nat} {stmt : AstStmt}
    {rest : List AstStmt} {codeOverride : Option AstContract}
    {state : State}
    (hHead :
      EvmYul.Yul.exec fuel stmt codeOverride state =
        .ok .OutOfFuel) :
    EvmYul.Yul.execSeq fuel.succ (stmt :: rest) codeOverride state =
      .ok .OutOfFuel := by
  simp [EvmYul.Yul.execSeq, hHead]

theorem execSeq_cons_error_succ {fuel : Nat} {stmt : AstStmt}
    {rest : List AstStmt} {codeOverride : Option AstContract}
    {state : State} {err : Exception}
    (hHead :
      EvmYul.Yul.exec fuel stmt codeOverride state =
        .error err) :
    EvmYul.Yul.execSeq fuel.succ (stmt :: rest) codeOverride state =
      .error err := by
  simp [EvmYul.Yul.execSeq, hHead]

theorem execSeq_single_succ {fuel : Nat} {stmt : AstStmt}
    {codeOverride : Option AstContract} {state : State}
    {result : Except Exception State}
    (hHead :
      EvmYul.Yul.exec fuel stmt codeOverride state = result) :
    EvmYul.Yul.execSeq fuel.succ [stmt] codeOverride state = result := by
  cases fuel with
  | zero =>
      simp [EvmYul.Yul.execSeq, EvmYul.Yul.exec] at hHead ⊢
      exact hHead
  | succ tailFuel =>
      cases result with
      | error err =>
          exact execSeq_cons_error_succ (rest := []) hHead
      | ok sourceAfter =>
          cases sourceAfter with
          | Ok shared store =>
              exact
                execSeq_cons_ok_result_succ (rest := []) hHead
                  (execSeq_nil_succ tailFuel codeOverride (.Ok shared store))
          | OutOfFuel =>
              exact execSeq_cons_outOfFuel_succ (rest := []) hHead
          | Checkpoint jump =>
              exact execSeq_cons_checkpoint_succ (rest := []) hHead

theorem exec_if_succ (fuel : Nat) (cond : AstExpr)
    (body : List AstStmt) (codeOverride : Option AstContract)
    (state : State) :
    EvmYul.Yul.exec fuel.succ (.If cond body) codeOverride state =
      match EvmYul.Yul.eval fuel cond codeOverride state with
      | .error err => .error err
      | .ok (state', value) =>
          if value ≠ ({ val := 0 } : Word) then
            EvmYul.Yul.exec fuel (.Block body) codeOverride state'
          else
            .ok state' := by
  simp [EvmYul.Yul.exec]
  rfl

theorem exec_switch_succ (fuel : Nat) (cond : AstExpr)
    (cases : List (Word × List AstStmt)) (defaultBody : List AstStmt)
    (codeOverride : Option AstContract) (state : State) :
    EvmYul.Yul.exec fuel.succ (.Switch cond cases defaultBody)
        codeOverride state =
      match EvmYul.Yul.eval fuel cond codeOverride state with
      | .error err => .error err
      | .ok (stateAfterCond, condValue) =>
          EvmYul.Yul.exec fuel
            (.Block (EvmYul.Yul.selectSwitchCase condValue defaultBody cases))
            codeOverride stateAfterCond := by
  simp [EvmYul.Yul.exec]
  rfl

theorem exec_switch_empty_default_succ_succ (fuel : Nat) (cond : AstExpr)
    (cases : List (Word × List AstStmt))
    (codeOverride : Option AstContract) (state : State) :
    EvmYul.Yul.exec fuel.succ.succ (.Switch cond cases [])
        codeOverride state =
      match EvmYul.Yul.eval fuel.succ cond codeOverride state with
      | .error err => .error err
      | .ok (stateAfterCond, condValue) =>
          EvmYul.Yul.exec fuel.succ
            (.Block (EvmYul.Yul.selectSwitchCase condValue [] cases))
            codeOverride stateAfterCond := by
  simp [EvmYul.Yul.exec]
  rfl

theorem exec_expr_prim_call_succ (fuel : Nat)
    (prim : EvmYul.Operation .Yul) (args : List AstExpr)
    (codeOverride : Option AstContract) (state : State) :
    EvmYul.Yul.exec fuel.succ (.ExprStmtCall (.Call (.inl prim) args))
        codeOverride state =
      EvmYul.Yul.execPrimCall fuel prim []
        (EvmYul.Yul.reverse'
          (EvmYul.Yul.evalArgs fuel args.reverse codeOverride state)) := by

theorem eval_var_compiler_push_temp_withTemps_layout_slots
    {cfg : StateRelConfig}
    {sourceLayout fullLayout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : EVMState}
    (fuel : Nat) (name : EvmYul.Identifier)
    (codeOverride : Option AstContract) (ctx : Locals.Ctx)
    {temps : EvmYul.Stack Word} {offset sourceIdx : Nat}
    (hCtxLayout : ctx.layout = fullLayout)
    (hOffset : offset = temps.length)
    (hNoDup : fullLayout.Nodup)
    (hSourceName : sourceLayout[sourceIdx]? = some (identName name))
    (hBound :
      ∀ {fullIdx : Nat},
        fullLayout[fullIdx]? = some (identName name) →
          offset + fullIdx + 1 ≤ 16)
    (hRel :
      CompilerStateRelWithTempsAndLayoutSlots cfg sourceLayout fullLayout
        temps (.Ok shared store) compiler) :
    ∃ value compiler',
      EvmYul.Yul.eval fuel.succ (.Var name) codeOverride
          (.Ok shared store) =
        .ok (.Ok shared store, value) ∧
      store.lookup (identName name) = some value ∧
      Locals.Direct.Expr.runCode ctx offset (.var (identName name)) compiler =
        .ok compiler' ∧
      CompilerStateRelWithTempsAndLayoutSlots cfg sourceLayout fullLayout
        (value :: temps) (.Ok shared store) compiler' := by
  cases hRel with
  | ok hShared hVars hCover hStack =>
      rcases hVars hSourceName with
        ⟨fullIdx, value, hFullName, hStackBase, hStore⟩
      let compiler' :=
        compiler.replaceStackAndIncrPC (value :: compiler.stack)
      refine ⟨value, compiler', ?hEval, hStore, ?hRunCode, ?hRel⟩
      · rw [Imported.eval_var_succ]
        simp [lookup?_ok (shared := shared) hStore]
      · have hDepth :
            Locals.Layout.lookupDepth? (identName name) ctx.layout =
              some (fullIdx + 1) := by
          simpa [hCtxLayout] using
            (lookupDepth?_of_get?_nodup hFullName hNoDup)
        have hStackAt :
            compiler.stack[offset + fullIdx]? = some value := by
          subst offset
          rw [hStack]
          rw [List.getElem?_append_right]
          · simpa using hStackBase
          · omega
        have hOne : 1 ≤ offset + (fullIdx + 1) := by omega
        have hBound' : offset + (fullIdx + 1) ≤ 16 := by
          have hBoundFull := hBound hFullName
          omega
        rcases
            stackOp_dup?_step_eq_dup
              (n := offset + (fullIdx + 1)) hOne hBound' compiler with
          ⟨op, hDup, hStep⟩
        have hDupValue :
            EvmYul.dup (offset + (fullIdx + 1)) compiler =
              .ok compiler' := by
          have hDupValue' :=
            evm_dup_succ_get? (state := compiler)
              (idx := offset + fullIdx) hStackAt
          simpa [compiler', Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
            using hDupValue'
        simp [Locals.Direct.Expr.runCode, hDepth, hDup]
        rw [hStep, hDupValue]
      · exact
          CompilerStateRelWithTempsAndLayoutSlots.ok
            (by
              simpa [compiler', EvmYul.EVM.State.replaceStackAndIncrPC,
                EvmYul.EVM.State.incrPC] using hShared)
            hVars
            hCover
            (by
              simp [compiler', EvmYul.EVM.State.replaceStackAndIncrPC,
                EvmYul.EVM.State.incrPC, hStack])


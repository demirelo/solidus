  exact ⟨layoutAfter, resultBlockRunBridge_of_ok hOk⟩

theorem nonregularBlockRunBridge_of_resultBlockRunBridge_checkpoint
    {cfg : StateRelConfig} {layoutAfter : List Name}
    {program : Functions.Program} {returns : List Name}
    {ctx : Locals.Ctx} {sourceFuel : Nat}
    {sourceStmts : List AstStmt} {codeOverride : Option AstContract}
    {source : State} {compiler : RunState} {lowerBlock : Functions.Block}
    {jump : EvmYul.Yul.Jump}
    (hBridge :
      ResultBlockRunBridge (cfg := cfg) layoutAfter program returns ctx
        sourceFuel sourceStmts codeOverride source compiler lowerBlock)
    (hSourceCheckpoint :
      EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
        .ok (.Checkpoint jump)) :
    NonregularBlockRunBridge (cfg := cfg) layoutAfter program returns ctx
      sourceFuel sourceStmts codeOverride source compiler lowerBlock := by
  rcases hBridge with
    ⟨sourceResult, outcome, ctxAfter, targetFuel,
      hSource, hTarget, hRel, hReturns⟩
  rw [hSourceCheckpoint] at hSource
  cases hSource
  exact
    ⟨.ok (.Checkpoint jump), outcome, ctxAfter, targetFuel,
      hSourceCheckpoint, hTarget, hRel, hReturns,
      CompilerResultOutcomeRel.mode_ne_regular_of_checkpoint hRel⟩

theorem nonregularBlockRunBridge_of_resultBlockRunBridge_error
    {cfg : StateRelConfig} {layoutAfter : List Name}
    {program : Functions.Program} {returns : List Name}
    {ctx : Locals.Ctx} {sourceFuel : Nat}
    {sourceStmts : List AstStmt} {codeOverride : Option AstContract}
    {source : State} {compiler : RunState} {lowerBlock : Functions.Block}
    {err : Exception}
    (hBridge :
      ResultBlockRunBridge (cfg := cfg) layoutAfter program returns ctx
        sourceFuel sourceStmts codeOverride source compiler lowerBlock)
    (hSourceError :
      EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
        .error err) :
    NonregularBlockRunBridge (cfg := cfg) layoutAfter program returns ctx
      sourceFuel sourceStmts codeOverride source compiler lowerBlock := by
  rcases hBridge with
    ⟨sourceResult, outcome, ctxAfter, targetFuel,
      hSource, hTarget, hRel, hReturns⟩
  rw [hSourceError] at hSource
  cases hSource
  exact
    ⟨.error err, outcome, ctxAfter, targetFuel, hSourceError, hTarget, hRel,
      hReturns, CompilerResultOutcomeRel.mode_ne_regular_of_error hRel⟩

theorem nonregularStmtPrefix_block_of_nonregularBlockRunBridge
    {cfg : StateRelConfig} {layoutAfter : List Name}
    {program : Functions.Program} {returns : List Name}
    {ctx : Locals.Ctx} {sourceFuel : Nat}
    {sourceStmts : List AstStmt} {codeOverride : Option AstContract}
    {source : State} {compiler : RunState} {lowerBlock : Functions.Block}
    (hBridge :
      NonregularBlockRunBridge (cfg := cfg) layoutAfter program returns ctx
        sourceFuel sourceStmts codeOverride source compiler lowerBlock) :
    NonregularStmtPrefixBridge (cfg := cfg) layoutAfter program returns ctx
      sourceFuel (.Block sourceStmts) codeOverride source compiler
      [Functions.Stmt.block lowerBlock] := by
  rcases hBridge with
    ⟨sourceResult, outcome, _ctxAfter, targetFuel,
      hSource, hTarget, hRel, hReturns, hNonregular⟩
  refine
    ⟨sourceResult, outcome, ctx, hSource, ?target, hRel, hReturns,
      hNonregular⟩
  intro tail
  refine ⟨targetFuel.succ, ?_⟩
  cases hMode : outcome.mode with
  | regular =>
      exact False.elim (hNonregular hMode)
  | brk =>
      simp [Functions.Direct.Block.runOpen, Functions.Direct.Stmt.run,
        Functions.Direct.Block.runScoped, hTarget, hMode]
  | cont =>
      simp [Functions.Direct.Block.runOpen, Functions.Direct.Stmt.run,
        Functions.Direct.Block.runScoped, hTarget, hMode]
  | leave =>
      simp [Functions.Direct.Block.runOpen, Functions.Direct.Stmt.run,
        Functions.Direct.Block.runScoped, hTarget, hMode]
  | halt kind =>
      simp [Functions.Direct.Block.runOpen, Functions.Direct.Stmt.run,
        Functions.Direct.Block.runScoped, hTarget, hMode]

/--
Run a nonregular block bridge through the actual scoped Functions block
runner.

For `break`, `continue`, `leave`, and terminal halts, `Block.runScoped` must not
perform the regular block cleanup; the outcome has already conformed to the
appropriate continuation/terminal shape.  This lemma packages that branch split
for the eventual whole-block driver.
-/
theorem nonregularBlockRunBridge_runScoped
    {cfg : StateRelConfig} {layoutAfter : List Name}
    {program : Functions.Program} {returns : List Name}
    {ctx : Locals.Ctx} {sourceFuel : Nat}
    {sourceStmts : List AstStmt} {codeOverride : Option AstContract}
    {source : State} {compiler : RunState} {lowerBlock : Functions.Block}
    (hBridge :
      NonregularBlockRunBridge (cfg := cfg) layoutAfter program returns ctx
        sourceFuel sourceStmts codeOverride source compiler lowerBlock) :
    ∃ sourceResult : Except Exception State, ∃ outcome : Functions.Outcome,
    ∃ targetFuel : Nat,
      EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
        sourceResult ∧
      Functions.Direct.Block.runScoped program returns ctx lowerBlock
          targetFuel compiler =
        .ok outcome ∧
      CompilerResultOutcomeRel cfg layoutAfter sourceResult outcome ∧
      outcome.state.returns = compiler.returns ∧
      outcome.mode ≠ .regular := by
  rcases hBridge with
    ⟨sourceResult, outcome, ctxAfter, targetFuel,
      hSource, hTarget, hRel, hReturns, hNonregular⟩
  refine ⟨sourceResult, outcome, targetFuel, hSource, ?target, hRel,
    hReturns, hNonregular⟩
  cases hMode : outcome.mode with
  | regular =>
      exact False.elim (hNonregular hMode)
  | brk =>
      simp [Functions.Direct.Block.runScoped, hTarget, hMode]
  | cont =>
      simp [Functions.Direct.Block.runScoped, hTarget, hMode]
  | leave =>
      simp [Functions.Direct.Block.runScoped, hTarget, hMode]
  | halt kind =>
      simp [Functions.Direct.Block.runScoped, hTarget, hMode]

/--
Full-layout version of `nonregularBlockRunBridge_runScoped`.

The nonregular outcome bypasses the regular scoped cleanup branch, while the
outcome relation retains the declared source-visible/full-layout shapes.
-/
theorem nonregularBlockRunBridgeWithLayoutSlots_runScoped
    {cfg : StateRelConfig} {outcomeSourceLayout outcomeFullLayout : List Name}
    {program : Functions.Program} {returns : List Name}
    {ctx : Locals.Ctx} {sourceFuel : Nat}
    {sourceStmts : List AstStmt} {codeOverride : Option AstContract}
    {source : State} {compiler : RunState} {lowerBlock : Functions.Block}
    (hBridge :
      NonregularBlockRunBridgeWithLayoutSlots (cfg := cfg)
        outcomeSourceLayout outcomeFullLayout program returns ctx sourceFuel
        sourceStmts codeOverride source compiler lowerBlock) :
    ∃ sourceResult : Except Exception State, ∃ outcome : Functions.Outcome,
    ∃ targetFuel : Nat,
      EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
        sourceResult ∧
      Functions.Direct.Block.runScoped program returns ctx lowerBlock
          targetFuel compiler =
        .ok outcome ∧
      CompilerResultOutcomeRelWithLayoutSlots cfg outcomeSourceLayout
        outcomeFullLayout sourceResult outcome ∧
      outcome.state.returns = compiler.returns ∧
      outcome.mode ≠ .regular := by
  rcases hBridge with
    ⟨sourceResult, outcome, ctxAfter, targetFuel,
      hSource, hTarget, hRel, hReturns, hNonregular⟩
  refine ⟨sourceResult, outcome, targetFuel, hSource, ?target, hRel,
    hReturns, hNonregular⟩
  cases hMode : outcome.mode with
  | regular =>
      exact False.elim (hNonregular hMode)
  | brk =>
      simp [Functions.Direct.Block.runScoped, hTarget, hMode]
  | cont =>
      simp [Functions.Direct.Block.runScoped, hTarget, hMode]
  | leave =>
      simp [Functions.Direct.Block.runScoped, hTarget, hMode]
  | halt kind =>
      simp [Functions.Direct.Block.runScoped, hTarget, hMode]

/--
Root-function entry version of `nonregularBlockRunBridge_runScoped`.

This is the nonregular half of the program-entry driver: abrupt control or EVM
terminal outcomes from the bridged block feed `Functions.Program.run` directly
when the lowered block is the function program body.
-/
theorem nonregularBlockRunBridge_functionsProgram_run
    {cfg : StateRelConfig} {layoutAfter : List Name}
    {functionProgram : Functions.Program}
    {sourceFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract} {source : State}
    {initial : EVMState}
    (hBridge :
      NonregularBlockRunBridge (cfg := cfg) layoutAfter functionProgram []
        Locals.Ctx.initial sourceFuel sourceStmts codeOverride source
        (Structured.RunState.initial initial) functionProgram.body) :
    ∃ sourceResult : Except Exception State, ∃ outcome : Functions.Outcome,
    ∃ targetFuel : Nat,
      EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
        sourceResult ∧
      Functions.Program.run targetFuel functionProgram initial =
        .ok outcome ∧
      CompilerResultOutcomeRel cfg layoutAfter sourceResult outcome ∧
      outcome.state.returns = [] ∧
      outcome.mode ≠ .regular := by
  rcases nonregularBlockRunBridge_runScoped hBridge with
    ⟨sourceResult, outcome, targetFuel, hSource, hTarget, hRel, hReturns,
      hNonregular⟩
  refine
    ⟨sourceResult, outcome, targetFuel, hSource, ?target, hRel, ?returns,
      hNonregular⟩
  · simpa [Functions.Program.run, Functions.Direct.Program.run,
      Functions.Direct.Program.runState] using hTarget
  · simpa [Structured.RunState.initial] using hReturns

/--
Lowered-Yul entry version of `nonregularBlockRunBridge_functionsProgram_run`.

This packages the transparent object boundary used by `Yul.Lowered.run`: once
`program.toObjects?` computes the root object containing `functionProgram`, the
nonregular imported block evidence feeds the actual compiler-facing lowered
Yul run.
-/
theorem nonregularBlockRunBridge_lowered_run
    {cfg : StateRelConfig} {layoutAfter : List Name}
    {program : Program} {functionProgram : Functions.Program}
    {sourceFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract} {source : State}
    {initial : EVMState}
    (hToObjects :
      program.toObjects? =
        some { root := Objects.Object.mk "root" functionProgram [] [] })
    (hBridge :
      NonregularBlockRunBridge (cfg := cfg) layoutAfter functionProgram []
        Locals.Ctx.initial sourceFuel sourceStmts codeOverride source
        (Structured.RunState.initial initial) functionProgram.body) :
    ∃ sourceResult : Except Exception State, ∃ outcome : Functions.Outcome,
    ∃ targetFuel : Nat,
      EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
        sourceResult ∧
      Lowered.run targetFuel program initial = .ok outcome ∧
      CompilerResultOutcomeRel cfg layoutAfter sourceResult outcome ∧
      outcome.state.returns = [] ∧
      outcome.mode ≠ .regular := by
  rcases nonregularBlockRunBridge_functionsProgram_run hBridge with
    ⟨sourceResult, outcome, targetFuel, hSource, hTarget, hRel, hReturns,
      hNonregular⟩
  refine
    ⟨sourceResult, outcome, targetFuel, hSource, ?target, hRel, hReturns,
      hNonregular⟩
  simpa [Lowered.run, hToObjects, Objects.Program.run, Objects.Object.run]
    using hTarget

/--
Open Yul statement-sequence bridge.

This is the compositional source-side shape for non-bracketed statement
lists. Unlike `exec (.Block ...)`, `execSeq` does not apply the block-boundary
varstore restriction at the end, so declaration/assignment prefixes can be
composed without assuming a precomputed whole-block run.
-/
def RegularSeqRunBridge {cfg : StateRelConfig}
    (layoutAfter : List Name) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : RunState,
  ∃ ctxAfter : Locals.Ctx, ∃ targetFuel : Nat,
    EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
      .ok sourceAfter ∧
    Functions.Direct.Block.runOpen program returns ctx targetFuel lowerBlock
        compiler =
      .ok (Structured.Outcome.regular compilerAfter, ctxAfter) ∧
    CompilerStateRel cfg layoutAfter sourceAfter compilerAfter.evm ∧
    compilerAfter.returns = compiler.returns

/--
Open sequence bridge with the context-layout evidence needed to close a
bracketed source block.
-/
def RegularSeqRunBridgeWithLayout {cfg : StateRelConfig}
    (layout layoutAfter : List Name) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : RunState,
  ∃ ctxAfter : Locals.Ctx, ∃ targetFuel : Nat,
    EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
      .ok sourceAfter ∧
    Functions.Direct.Block.runOpen program returns ctx targetFuel lowerBlock
        compiler =
      .ok (Structured.Outcome.regular compilerAfter, ctxAfter) ∧
    ctx.layout = layout ∧
    ctxAfter.layout = layoutAfter ∧
    LayoutSuffix layout layoutAfter ∧
    CompilerStateRel cfg layoutAfter sourceAfter compilerAfter.evm ∧
    compilerAfter.returns = compiler.returns

/--
Result-shaped open sequence bridge with the same context-layout evidence as
`RegularSeqRunBridgeWithLayout`.

This is the public proof interface recursive imported-Yul statement-list
bridges should eventually produce: regular paths retain enough stack-layout
information to close scoped blocks, while terminal/checkpoint paths can still
short-circuit the remaining source and target tails.
-/
def ResultSeqRunBridgeWithLayout {cfg : StateRelConfig}
    (layout ctxAfterLayout outcomeLayout : List Name)
    (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceResult : Except Exception State, ∃ outcome : Functions.Outcome,
  ∃ ctxAfter : Locals.Ctx, ∃ targetFuel : Nat,
    EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
      sourceResult ∧
    Functions.Direct.Block.runOpen program returns ctx targetFuel lowerBlock
        compiler =
      .ok (outcome, ctxAfter) ∧
    ctx.layout = layout ∧
    ctxAfter.layout = ctxAfterLayout ∧
    LayoutSuffix layout ctxAfterLayout ∧
    CompilerResultOutcomeRel cfg outcomeLayout sourceResult outcome ∧
    outcome.state.returns = compiler.returns

/--
Result-shaped open sequence bridge for arbitrary full compiler layouts.

The initial `sourceLayout`/`fullLayout` describe the input relation expected by
construct-specific proof drivers. The outcome relation separately names the
source-visible and full layouts at the point where the resulting outcome is
observed, because nonregular exits may target a cleaned continuation layout.
-/
def ResultSeqRunBridgeWithLayoutSlots {cfg : StateRelConfig}
    (sourceLayout fullLayout ctxAfterLayout outcomeSourceLayout
      outcomeFullLayout : List Name)
    (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceResult : Except Exception State, ∃ outcome : Functions.Outcome,
  ∃ ctxAfter : Locals.Ctx, ∃ targetFuel : Nat,
    EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
      sourceResult ∧
    Functions.Direct.Block.runOpen program returns ctx targetFuel lowerBlock
        compiler =
      .ok (outcome, ctxAfter) ∧
    ctx.layout = fullLayout ∧
    ctxAfter.layout = ctxAfterLayout ∧
    LayoutSuffix fullLayout ctxAfterLayout ∧
    CompilerResultOutcomeRelWithLayoutSlots cfg outcomeSourceLayout
      outcomeFullLayout sourceResult outcome ∧
    outcome.state.returns = compiler.returns

/--
Regular open-sequence bridge for arbitrary full compiler layouts.

Unlike `ResultSeqRunBridgeWithLayoutSlots`, this regular-only interface also
records how the source-visible layout grows. That extra suffix evidence is
needed when a surrounding scoped block closes: the source varstore is restricted
back to the outer source layout, while the target stack is cleaned back to the
outer full compiler layout.
-/
def RegularSeqRunBridgeWithLayoutSlots {cfg : StateRelConfig}
    (sourceLayout fullLayout sourceLayoutAfter fullLayoutAfter : List Name)
    (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : RunState,
  ∃ ctxAfter : Locals.Ctx, ∃ targetFuel : Nat,
    EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
      .ok sourceAfter ∧
    Functions.Direct.Block.runOpen program returns ctx targetFuel lowerBlock
        compiler =
      .ok (Structured.Outcome.regular compilerAfter, ctxAfter) ∧
    ctx.layout = fullLayout ∧
    ctxAfter.layout = fullLayoutAfter ∧
    LayoutSuffix sourceLayout sourceLayoutAfter ∧
    LayoutSuffix fullLayout fullLayoutAfter ∧
    CompilerStateRelWithLayoutSlots cfg sourceLayoutAfter fullLayoutAfter
      sourceAfter compilerAfter.evm ∧
    compilerAfter.returns = compiler.returns


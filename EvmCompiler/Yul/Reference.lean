                (sourceStoreRel_restrictVarStore_of_scope_contains
                  hVars hScope))
  | brk hStateRel =>
      cases hStateRel with
      | ok hShared hVars =>
          simp [EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store]
          exact
            SourceOkOutcomeRel.brk
              (SourceStateRel.ok hShared
                (sourceStoreRel_restrictVarStore_of_scope_contains
                  hVars hScope))
  | cont hStateRel =>
      cases hStateRel with
      | ok hShared hVars =>
          simp [EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store]
          exact
            SourceOkOutcomeRel.cont
              (SourceStateRel.ok hShared
                (sourceStoreRel_restrictVarStore_of_scope_contains
                  hVars hScope))
  | leave hStateRel =>
      cases hStateRel with
      | ok hShared hVars =>
          simp [EvmYul.Yul.State.restrictStoreTo, EvmYul.Yul.State.store]
          exact
            SourceOkOutcomeRel.leave
              (SourceStateRel.ok hShared
                (sourceStoreRel_restrictVarStore_of_scope_contains
                  hVars hScope))

theorem SourceResultOutcomeRel.restrictStoreTo_of_scope_contains
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {scope : EvmYul.Yul.VarStore}
    {sourceResult : Except Exception State}
    {outcome : Objects.Source.Outcome}
    (hScope :
      ∀ name, name ∈ layout → (scope.lookup name).isSome = true)
    (hRel :
      SourceResultOutcomeRel cfg layout terminalRel revertRel sourceResult
        outcome) :
    SourceResultOutcomeRel cfg layout terminalRel revertRel
      (match sourceResult with
       | .ok source => .ok (source.restrictStoreTo scope)
       | .error err => .error err)
      outcome := by
  cases hRel with
  | ok hOk =>
      exact
        SourceResultOutcomeRel.ok
          (SourceOkOutcomeRel.restrictStoreTo_of_scope_contains
            hScope hOk)
  | yulHalt hTerminal =>
      exact SourceResultOutcomeRel.yulHalt hTerminal
  | revert hRevert =>
      exact SourceResultOutcomeRel.revert hRevert

theorem SourceResultOutcomeRel.restrictStoreTo_of_domain_exact
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {scope : EvmYul.Yul.VarStore}
    {sourceResult : Except Exception State}
    {outcome : Objects.Source.Outcome}
    (hDomain : StoreDomainExact layout scope)
    (hRel :
      SourceResultOutcomeRel cfg layout terminalRel revertRel sourceResult
        outcome) :
    SourceResultOutcomeRel cfg layout terminalRel revertRel
      (match sourceResult with
       | .ok source => .ok (source.restrictStoreTo scope)
       | .error err => .error err)
      outcome :=
  SourceResultOutcomeRel.restrictStoreTo_of_scope_contains
    (fun name hMem => (hDomain name).mpr hMem) hRel

theorem SourceOkOutcomeRel.mode_ne_regular_of_checkpoint
    {cfg : StateRelConfig} {layout : List Name}
    {jump : EvmYul.Yul.Jump} {outcome : Objects.Source.Outcome}
    (hRel : SourceOkOutcomeRel cfg layout (.Checkpoint jump) outcome) :
    outcome.mode ≠ .regular := by
  cases hRel with
  | regular hStateRel =>
      cases hStateRel
  | brk hStateRel =>
      simp [Functions.Source.Outcome.brk, Locals.Source.Outcome.brk]
  | cont hStateRel =>
      simp [Functions.Source.Outcome.cont, Locals.Source.Outcome.cont]
  | leave hStateRel =>
      simp [Functions.Source.Outcome.leave, Locals.Source.Outcome.leave]

theorem SourceResultOutcomeRel.mode_ne_regular_of_checkpoint
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {jump : EvmYul.Yul.Jump} {outcome : Objects.Source.Outcome}
    (hRel :
      SourceResultOutcomeRel cfg layout terminalRel revertRel
        (.ok (.Checkpoint jump)) outcome) :
    outcome.mode ≠ .regular := by
  cases hRel with
  | ok hOk =>
      exact SourceOkOutcomeRel.mode_ne_regular_of_checkpoint hOk

theorem SourceResultOutcomeRel.mode_ne_regular_of_error
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {err : Exception} {outcome : Objects.Source.Outcome}
    (hRel :
      SourceResultOutcomeRel cfg layout terminalRel revertRel
        (.error err) outcome) :
    outcome.mode ≠ .regular := by
  cases hRel with
  | yulHalt hTerminal =>
      simp [Functions.Source.Outcome.halt, Locals.Source.Outcome.halt]
  | revert hRevert =>
      simp [Functions.Source.Outcome.halt, Locals.Source.Outcome.halt]

/--
Scoped source block bridge.  This is the source-tower analogue of the old
`exec (.Block ...)` bridge: both sides run a scoped block and then restrict
their local stores back to the incoming source scope.
-/
def SourceRegularBlockRunBridge (cfg : StateRelConfig)
    (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : Objects.Source.State) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : Objects.Source.State,
  ∃ targetFuel : Nat,
    EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
      .ok sourceAfter ∧
    Functions.Source.Block.runScoped prim program ctx lowerBlock targetFuel
        compiler =
      .ok (Functions.Source.Outcome.regular compilerAfter) ∧
    SourceStateRel cfg layout sourceAfter compilerAfter

/--
Target-fuel-specific regular scoped-block bridge.

This is the block analogue of `SourceRegularSeqRunAt`: imported Yul runs the
bracketed block and restricts the varstore to the incoming scope, while the
compiler-facing source tower runs `Block.runScoped` at the supplied target
fuel.  Stack cleanup and concrete layout machinery remain below this boundary.
-/

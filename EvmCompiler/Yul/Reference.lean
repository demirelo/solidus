theorem runCondition_iszero_of_single_zero_temp_layout_slots
    {cfg : StateRelConfig}
    {sourceLayout fullLayout : List Name} {sourceAfter : State}
    {compiler : RunState} {ctx : Locals.Ctx}
    {lower : Locals.Expr 1} {evmAfterCode : EVMState}
    (hRunCode :
      Locals.Direct.Expr.runCode ctx 0 lower compiler.evm =
        .ok evmAfterCode)
    (hTemps :
      CompilerStateRelWithTempsAndLayoutSlots cfg sourceLayout fullLayout
        [({ val := 0 } : Word)] sourceAfter evmAfterCode) :
    ∃ compilerAfter : RunState,
      Locals.Direct.Expr.runCondition ctx
          (.prim .iszero (Locals.ExprSeq.cons lower .nil)) compiler =
        .ok (compilerAfter, true) ∧
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout sourceAfter
        compilerAfter.evm ∧
      compilerAfter.returns = compiler.returns := by
  cases hTemps with
  | @ok shared store _ stack hShared hVars hCover hStack =>
      let evmAfterIszero : EVMState :=
        evmAfterCode.replaceStackAndIncrPC
          ((EvmYul.UInt256.ofNat 1) :: stack)
      let evmAfterPop : EVMState := { evmAfterIszero with stack := stack }
      let compilerAfter : RunState := compiler.withEVM evmAfterPop
      have hZeroEq :
          ((({ val := 0 } : Word) == ({ val := 0 } : Word)) = true) := by
        decide
      have hRunIszero :
          Structured.BasicOp.step .iszero evmAfterCode =
            .ok evmAfterIszero := by
        simp [Structured.BasicOp.step, Structured.BasicOp.toPrimOp,
          Assembly.Target.stepInstr, Assembly.PrimOp.step,
          Assembly.PrimOp.continuingStep?, Assembly.PrimStep.run,
          EvmYul.EVM.execUnOp, EvmYul.Stack.pop, hStack,
          evmAfterIszero, EvmYul.Stack.push, EvmYul.UInt256.isZero,
          EvmYul.UInt256.eq0, hZeroEq, Id.run]
      have hOneNeZero :
          ((EvmYul.UInt256.ofNat 1) !=
              (EvmYul.UInt256.ofNat 0)) = true := by
        decide
      have hPop :
          Structured.Code.popCondition evmAfterIszero =
            .ok (evmAfterPop, true) := by
        simp [Structured.Code.popCondition, EvmYul.Stack.pop, evmAfterIszero,
          evmAfterPop, EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC, hOneNeZero]
      have hRunCondition :
          Locals.Direct.Expr.runCondition ctx
              (.prim .iszero (Locals.ExprSeq.cons lower .nil)) compiler =
            .ok (compilerAfter, true) := by
        simp [Locals.Direct.Expr.runCondition, Locals.Direct.Expr.runCode,
          Locals.Direct.Expr.ExprSeq.runCode, hRunCode, hRunIszero, hPop,
          compilerAfter]
      refine ⟨compilerAfter, hRunCondition, ?rel, ?returns⟩
      · exact
          CompilerStateRelWithLayoutSlots.ok
            (by simpa [compilerAfter, evmAfterPop, evmAfterIszero]
              using hShared)
            (by
              intro sourceIdx sourceName hSourceName
              rcases hVars hSourceName with
                ⟨fullIdx, slotValue, hFull, hStackAt, hLookup⟩
              exact ⟨fullIdx, slotValue, hFull, hStackAt, hLookup⟩)
            hCover
      · simp [compilerAfter]


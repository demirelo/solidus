    {sourceFuel targetFuel : Nat} {codeOverride : Option AstContract}
    {allowed : Except Exception State → Prop}
    (hScope : ctx.scope = layout) :
    SourceResultSeqSoundWhenAtFuelExact cfg layout layout layout terminalRel
      revertRel prim program ctx sourceFuel.succ targetFuel.succ []
      codeOverride { stmts := [] } allowed := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial _hAllow hSource
  rw [Imported.execSeq_nil_succ sourceFuel codeOverride source] at hSource
  subst sourceResult
  refine
    ⟨Functions.Source.Outcome.regular compiler, ctx, ?_, hScope,
      (fun _ hMem => hMem), ?_⟩
  · simp [Functions.Source.Block.runOpen]
  · exact
      SourceResultOutcomeRel.ok
        (SourceOkOutcomeRel.regular hInitial.toRel)

/--
Statement-level regular bridge at exact source/target fuels.

Unlike the sequence bridge, this relates only one imported Yul statement to one
compiler-facing source statement.  Recursive constructs can use this boundary
without accidentally threading the surrounding tail through a smaller fuel.
-/
def SourceRegularStmtRunAt (cfg : StateRelConfig)
    (layout layoutAfter : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel targetFuel : Nat) (sourceStmt : AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : Objects.Source.State) (lowerStmt : Functions.Stmt) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : Objects.Source.State,
  ∃ ctxAfter : Functions.Source.Ctx,
    EvmYul.Yul.exec sourceFuel sourceStmt codeOverride source =
      .ok sourceAfter ∧
    Functions.Source.Stmt.run prim program ctx targetFuel lowerStmt compiler =
      .ok (Functions.Source.Outcome.regular compilerAfter, ctxAfter) ∧
    ctx.scope = layout ∧
    ctxAfter.scope = layoutAfter ∧
    (∀ name, name ∈ layout → name ∈ layoutAfter) ∧
    SourceStateRel cfg layoutAfter sourceAfter compilerAfter

/--
Source-owned regular single-statement soundness at fixed source and target
fuels.

This is intentionally stack-free and only mentions the source statement
interpreter plus the compiler-facing function-source statement interpreter.
The surrounding sequence theorem uses it as the regular-head component.
-/
def SourceRegularStmtSoundAt (cfg : StateRelConfig)
    (layout layoutAfter : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel targetFuel : Nat) (sourceStmt : AstStmt)
    (codeOverride : Option AstContract) (lowerStmt : Functions.Stmt) :
    Prop :=
  ctx.scope = layout ∧
    ∀ {source compiler},
      SourceStateRel cfg layout source compiler →
      SourceRegularStmtRunAt cfg layout layoutAfter prim program ctx
        sourceFuel targetFuel sourceStmt codeOverride source compiler
        lowerStmt

/--
Exact-domain statement-level regular bridge.

This mirrors `SourceRegularStmtRunAt`, but the post-state relation keeps the
imported varstore domain exact.  It is the right statement boundary for Yul
features such as assignments and declarations, whose imported semantics checks
the varstore domain.
-/
def SourceRegularStmtRunAtExact (cfg : StateRelConfig)
    (layout layoutAfter : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel targetFuel : Nat) (sourceStmt : AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : Objects.Source.State) (lowerStmt : Functions.Stmt) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : Objects.Source.State,
  ∃ ctxAfter : Functions.Source.Ctx,
    EvmYul.Yul.exec sourceFuel sourceStmt codeOverride source =
      .ok sourceAfter ∧
    Functions.Source.Stmt.run prim program ctx targetFuel lowerStmt compiler =
      .ok (Functions.Source.Outcome.regular compilerAfter, ctxAfter) ∧
    ctx.scope = layout ∧
    ctxAfter.scope = layoutAfter ∧
    (∀ name, name ∈ layout → name ∈ layoutAfter) ∧
    SourceStateExactRel cfg layoutAfter sourceAfter compilerAfter

def SourceRegularStmtSoundAtExact (cfg : StateRelConfig)
    (layout layoutAfter : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel targetFuel : Nat) (sourceStmt : AstStmt)
    (codeOverride : Option AstContract) (lowerStmt : Functions.Stmt) :
    Prop :=
  ctx.scope = layout ∧
    ∀ {source compiler},
      SourceStateExactRel cfg layout source compiler →
      SourceRegularStmtRunAtExact cfg layout layoutAfter prim program ctx
        sourceFuel targetFuel sourceStmt codeOverride source compiler
        lowerStmt

/--
Statement-level nonregular bridge at exact source/target fuels.

This is the source-tower analogue of a control-effecting statement result:
`break`, `continue`, `leave`, and EVM-level halts do not run the surrounding
tail.  It intentionally has no tail in its contract.
-/
def SourceNonregularStmtRunAt (cfg : StateRelConfig)
    (layout outcomeLayout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel targetFuel : Nat) (sourceStmt : AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : Objects.Source.State) (lowerStmt : Functions.Stmt) :
    Prop :=
  ∃ sourceResult : Except Exception State,
  ∃ sourceOutcome : Objects.Source.Outcome,
  ∃ ctxAfter : Functions.Source.Ctx,
    EvmYul.Yul.exec sourceFuel sourceStmt codeOverride source =
      sourceResult ∧
    Functions.Source.Stmt.run prim program ctx targetFuel lowerStmt compiler =
      .ok (sourceOutcome, ctxAfter) ∧
    ctx.scope = layout ∧
    SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
      sourceResult sourceOutcome ∧
    sourceOutcome.mode ≠ Locals.Source.Mode.regular

/--
Exact-fuel variant of `SourceRegularSeqRunBridge`.

The source Yul sequence interpreter and the compiler-facing source interpreter
both use the same fuel. This is useful for ordinary heads whose source and
target statement semantics consume fuel in the same way. Nested block/control
heads may still need a target-fuel-parametric interface or a checked
fuel-monotonicity theorem because imported `exec (.Block ...)` spends one fuel
before `execSeq`, while the compiler-facing source block runs the nested block
at the statement fuel.
-/
def SourceRegularSeqRunExact (cfg : StateRelConfig)
    (layout layoutAfter : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : Objects.Source.State) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : Objects.Source.State,
  ∃ ctxAfter : Functions.Source.Ctx,
    EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
      .ok sourceAfter ∧
    Functions.Source.Block.runOpen prim program ctx sourceFuel lowerBlock
        compiler =
      .ok (Functions.Source.Outcome.regular compilerAfter, ctxAfter) ∧
    ctx.scope = layout ∧
    ctxAfter.scope = layoutAfter ∧
    (∀ name, name ∈ layout → name ∈ layoutAfter) ∧
    SourceStateRel cfg layoutAfter sourceAfter compilerAfter

theorem sourceRegularSeqRunBridge_of_at {cfg : StateRelConfig}
    {layout layoutAfter : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel targetFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract} {source : State}
    {compiler : Objects.Source.State} {lowerBlock : Functions.Block}

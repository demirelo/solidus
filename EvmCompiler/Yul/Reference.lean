theorem dispatcherBody_installContract_ok
    (program : Program) (shared : EvmYul.SharedState .Yul)
    (store : EvmYul.Yul.VarStore) :
    dispatcherBody (Program.installContract program (.Ok shared store)) =
      [program.contract.dispatcher] := by
  simp [dispatcherBody, Program.installContract,
    EvmYul.Yul.State.executionEnv]

theorem dispatcherCallState_installContract_ok
    (program : Program) (shared : EvmYul.SharedState .Yul)
    (store : EvmYul.Yul.VarStore) :
    dispatcherCallState (Program.installContract program (.Ok shared store)) =
      .Ok
        { shared with
          executionEnv :=
            { shared.executionEnv with code := program.contract } }
        default := by
  simp [Program.installContract, dispatcherCallState_ok]

def dispatcherRunResultOfBody (program : Program) (state : State) :
    Except Exception State → Except Exception Result
  | .ok stateAfterBody =>
      .ok
        (.regular
          (EvmYul.Yul.State.setStore
            (EvmYul.Yul.State.overwrite?
              (EvmYul.Yul.State.reviveJump stateAfterBody)
              (Program.installContract program state))
            (Program.installContract program state)))
  | .error (.YulHalt haltState value) =>
      .ok (.yulHalt haltState value)
  | .error (.Revert revertState) =>
      .ok (.revert revertState)
  | .error err =>
      .error err

theorem callDispatcher_zero (codeOverride : Option AstContract)
    (state : State) :
    EvmYul.Yul.callDispatcher 0 codeOverride state =
      .error .OutOfFuel := by
  simp [EvmYul.Yul.callDispatcher]

theorem callDispatcher_succ (fuel : Nat)
    (codeOverride : Option AstContract) (state : State) :
    EvmYul.Yul.callDispatcher fuel.succ codeOverride state =
      let function : AstFunctionDefinition :=
        .Def [] [] [state.executionEnv.code.dispatcher]
      let callState :=
        EvmYul.Yul.State.mkOk
          (EvmYul.Yul.State.initcall function.params function.rets [] state)
      match EvmYul.Yul.exec fuel (.Block function.body) codeOverride callState with
      | .error err => .error err
      | .ok stateAfterBody =>
          let stateAfterReturn :=
            EvmYul.Yul.State.overwrite?
              (EvmYul.Yul.State.reviveJump stateAfterBody) state
          .ok
            (EvmYul.Yul.State.setStore stateAfterReturn state,
              List.map (fun name => EvmYul.Yul.State.lookup! name stateAfterBody)
                function.rets) := by
  simp [EvmYul.Yul.callDispatcher]
  rfl

theorem callDispatcher_succ_regular_of_exec_dispatcher
    (fuel : Nat) (codeOverride : Option AstContract) (state : State)
    {stateAfterBody : State}
    (hExec :
      EvmYul.Yul.exec fuel (.Block (dispatcherBody state)) codeOverride
          (dispatcherCallState state) =
        .ok stateAfterBody) :
    EvmYul.Yul.callDispatcher fuel.succ codeOverride state =
      .ok
        (EvmYul.Yul.State.setStore
          (EvmYul.Yul.State.overwrite?
            (EvmYul.Yul.State.reviveJump stateAfterBody) state)
          state,
        []) := by
  let function : AstFunctionDefinition :=
    .Def [] [] [state.executionEnv.code.dispatcher]
  have hExec' :
      EvmYul.Yul.exec fuel (.Block function.body) codeOverride
          (EvmYul.Yul.State.mkOk
            (EvmYul.Yul.State.initcall function.params function.rets []
              state)) =
        .ok stateAfterBody := by
    simpa [function, dispatcherBody, dispatcherCallState] using hExec
  rw [callDispatcher_succ]
  simp [function, hExec']
  rfl

theorem runResult_succ_regular_of_exec_dispatcher
    (fuel : Nat) (program : Program) (state : State)
    {stateAfterBody : State}
    (hExec :
      EvmYul.Yul.exec fuel
          (.Block (dispatcherBody (Program.installContract program state)))
          (some program.contract)
          (dispatcherCallState (Program.installContract program state)) =
        .ok stateAfterBody) :
    runResult fuel.succ program state =
      .ok
        (.regular
          (EvmYul.Yul.State.setStore
            (EvmYul.Yul.State.overwrite?
              (EvmYul.Yul.State.reviveJump stateAfterBody)
              (Program.installContract program state))
            (Program.installContract program state))) := by
  have hCall :
      EvmYul.Yul.callDispatcher fuel.succ (some program.contract)
          (Program.installContract program state) =
        .ok
          (EvmYul.Yul.State.setStore
            (EvmYul.Yul.State.overwrite?
              (EvmYul.Yul.State.reviveJump stateAfterBody)
              (Program.installContract program state))
            (Program.installContract program state),
          []) :=
    callDispatcher_succ_regular_of_exec_dispatcher
      fuel (some program.contract) (Program.installContract program state)
      hExec
  simp [runResult, Program.run, hCall]

theorem callDispatcher_succ_yulHalt_of_exec_dispatcher
    (fuel : Nat) (codeOverride : Option AstContract) (state : State)
    {haltState : State} {value : Word}
    (hExec :
      EvmYul.Yul.exec fuel (.Block (dispatcherBody state)) codeOverride
          (dispatcherCallState state) =
        .error (.YulHalt haltState value)) :
    EvmYul.Yul.callDispatcher fuel.succ codeOverride state =
      .error (.YulHalt haltState value) := by
  let function : AstFunctionDefinition :=
    .Def [] [] [state.executionEnv.code.dispatcher]
  have hExec' :
      EvmYul.Yul.exec fuel (.Block function.body) codeOverride
          (EvmYul.Yul.State.mkOk
            (EvmYul.Yul.State.initcall function.params function.rets []
              state)) =
        .error (.YulHalt haltState value) := by
    simpa [function, dispatcherBody, dispatcherCallState] using hExec
  rw [callDispatcher_succ]
  simp [function, hExec']

theorem callDispatcher_succ_error_of_exec_dispatcher
    (fuel : Nat) (codeOverride : Option AstContract) (state : State)
    {err : Exception}
    (hExec :
      EvmYul.Yul.exec fuel (.Block (dispatcherBody state)) codeOverride
          (dispatcherCallState state) =
        .error err) :
    EvmYul.Yul.callDispatcher fuel.succ codeOverride state =
      .error err := by
  let function : AstFunctionDefinition :=
    .Def [] [] [state.executionEnv.code.dispatcher]
  have hExec' :
      EvmYul.Yul.exec fuel (.Block function.body) codeOverride
          (EvmYul.Yul.State.mkOk
            (EvmYul.Yul.State.initcall function.params function.rets []
              state)) =
        .error err := by
    simpa [function, dispatcherBody, dispatcherCallState] using hExec
  rw [callDispatcher_succ]
  simp [function, hExec']

theorem runResult_succ_yulHalt_of_exec_dispatcher
    (fuel : Nat) (program : Program) (state : State)
    {haltState : State} {value : Word}
    (hExec :
      EvmYul.Yul.exec fuel
          (.Block (dispatcherBody (Program.installContract program state)))
          (some program.contract)
          (dispatcherCallState (Program.installContract program state)) =
        .error (.YulHalt haltState value)) :
    runResult fuel.succ program state =
      .ok (.yulHalt haltState value) := by
  have hCall :
      EvmYul.Yul.callDispatcher fuel.succ (some program.contract)
          (Program.installContract program state) =
        .error (.YulHalt haltState value) :=
    callDispatcher_succ_yulHalt_of_exec_dispatcher
      fuel (some program.contract) (Program.installContract program state)
      hExec
  simp [runResult, Program.run, hCall]

theorem runResult_succ_error_of_exec_dispatcher
    (fuel : Nat) (program : Program) (state : State) {err : Exception}
    (hExec :
      EvmYul.Yul.exec fuel
          (.Block (dispatcherBody (Program.installContract program state)))
          (some program.contract)
          (dispatcherCallState (Program.installContract program state)) =
        .error err) :
    runResult fuel.succ program state =
      dispatcherRunResultOfBody program state (.error err) := by
  have hCall :
      EvmYul.Yul.callDispatcher fuel.succ (some program.contract)
          (Program.installContract program state) =
        .error err :=
    callDispatcher_succ_error_of_exec_dispatcher
      fuel (some program.contract) (Program.installContract program state)
      hExec
  cases err <;> simp [dispatcherRunResultOfBody, runResult, Program.run, hCall]

theorem callDispatcher_succ_revert_of_exec_dispatcher
    (fuel : Nat) (codeOverride : Option AstContract) (state : State)
    {revertState : State}
    (hExec :
      EvmYul.Yul.exec fuel (.Block (dispatcherBody state)) codeOverride
          (dispatcherCallState state) =
        .error (.Revert revertState)) :
    EvmYul.Yul.callDispatcher fuel.succ codeOverride state =
      .error (.Revert revertState) := by
  let function : AstFunctionDefinition :=
    .Def [] [] [state.executionEnv.code.dispatcher]
  have hExec' :
      EvmYul.Yul.exec fuel (.Block function.body) codeOverride
          (EvmYul.Yul.State.mkOk
            (EvmYul.Yul.State.initcall function.params function.rets []
              state)) =
        .error (.Revert revertState) := by
    simpa [function, dispatcherBody, dispatcherCallState] using hExec
  rw [callDispatcher_succ]
  simp [function, hExec']

theorem runResult_succ_revert_of_exec_dispatcher
    (fuel : Nat) (program : Program) (state : State)
    {revertState : State}
    (hExec :
      EvmYul.Yul.exec fuel
          (.Block (dispatcherBody (Program.installContract program state)))
          (some program.contract)
          (dispatcherCallState (Program.installContract program state)) =
        .error (.Revert revertState)) :
    runResult fuel.succ program state =
      .ok (.revert revertState) := by
  have hCall :
      EvmYul.Yul.callDispatcher fuel.succ (some program.contract)
          (Program.installContract program state) =
        .error (.Revert revertState) :=
    callDispatcher_succ_revert_of_exec_dispatcher
      fuel (some program.contract) (Program.installContract program state)
      hExec
  simp [runResult, Program.run, hCall]

theorem runResult_succ_of_exec_dispatcher
    (fuel : Nat) (program : Program) (state : State)
    {sourceResult : Except Exception State}
    (hExec :
      EvmYul.Yul.exec fuel
          (.Block (dispatcherBody (Program.installContract program state)))
          (some program.contract)
          (dispatcherCallState (Program.installContract program state)) =
        sourceResult) :
    runResult fuel.succ program state =
      dispatcherRunResultOfBody program state sourceResult := by
  cases sourceResult with
  | ok stateAfterBody =>
      exact
        runResult_succ_regular_of_exec_dispatcher
          fuel program state hExec
  | error err =>
      exact
        runResult_succ_error_of_exec_dispatcher
          fuel program state hExec

theorem exists_exec_dispatcher_of_runResult_succ_ok
    (fuel : Nat) (program : Program) (state : State)
    {referenceResult : Result}
    (hRun : runResult fuel.succ program state = .ok referenceResult) :
    ∃ sourceResult : Except Exception State,
      EvmYul.Yul.exec fuel
          (.Block (dispatcherBody (Program.installContract program state)))
          (some program.contract)
          (dispatcherCallState (Program.installContract program state)) =
        sourceResult ∧
      dispatcherRunResultOfBody program state sourceResult =
        .ok referenceResult := by
  cases hExec :
      EvmYul.Yul.exec fuel
          (.Block (dispatcherBody (Program.installContract program state)))
          (some program.contract)
          (dispatcherCallState (Program.installContract program state)) with
  | ok stateAfterBody =>
      refine ⟨.ok stateAfterBody, rfl, ?_⟩
      rw [← runResult_succ_of_exec_dispatcher
        fuel program state hExec]
      exact hRun
  | error err =>
      refine ⟨.error err, rfl, ?_⟩
      rw [← runResult_succ_of_exec_dispatcher
        fuel program state hExec]
      exact hRun

end Imported

abbrev AccountMapRel :=
  EvmYul.AccountMap .Yul → EvmYul.AccountMap .EVM → Prop

def AccountStorage? {τ : EvmYul.OperationType}
    (accounts : EvmYul.AccountMap τ)
    (address : EvmYul.AccountAddress) : Option EvmYul.Storage :=
  (accounts.find? address).map (fun account => account.storage)

def AccountTransientStorage? {τ : EvmYul.OperationType}
    (accounts : EvmYul.AccountMap τ)
    (address : EvmYul.AccountAddress) : Option EvmYul.Storage :=
  (accounts.find? address).map (fun account => account.tstorage)

def AccountBalance {τ : EvmYul.OperationType}
    (accounts : EvmYul.AccountMap τ)
    (address : EvmYul.AccountAddress) : Word :=
  (accounts.find? address).elim (EvmYul.UInt256.ofNat 0)
    (fun account => account.balance)

def AccountCodeImage {τ : EvmYul.OperationType}
    (accounts : EvmYul.AccountMap τ)
    (address : EvmYul.AccountAddress) : ByteArray :=
  match accounts.find? address with
  | none => ByteArray.empty
  | some account => EvmYul.State.accountCodeImage account

def StorageImageRel {τ₁ τ₂ : EvmYul.OperationType}
    (source : EvmYul.AccountMap τ₁) (target : EvmYul.AccountMap τ₂) :
    Prop :=
  ∀ address, AccountStorage? source address = AccountStorage? target address

def TransientStorageImageRel {τ₁ τ₂ : EvmYul.OperationType}
    (source : EvmYul.AccountMap τ₁) (target : EvmYul.AccountMap τ₂) :
    Prop :=
  ∀ address,
    AccountTransientStorage? source address =
      AccountTransientStorage? target address

def ExternalCodeImageRel
    (source : EvmYul.AccountMap .Yul) (target : EvmYul.AccountMap .EVM) :
    Prop :=
  ∀ address, AccountCodeImage source address = AccountCodeImage target address

abbrev CodeImageRel :=
  AstContract → ByteArray → Prop

abbrev VarStackRel :=
  List Name → EvmYul.Yul.VarStore → EvmYul.Stack Word → Prop

namespace VarStackRel

/--
Concrete varstore-to-stack relation for the future Yul bridge.

`layout` is ordered like the lower locals stack layout: the head is the
topmost/nearest live variable. Each stack word must be exactly the value
looked up for the corresponding Yul identifier in the imported varstore.
Missing variables are not silently defaulted here; source well-scopedness must
prove they are present.
-/
def exact (layout : List Name) (store : EvmYul.Yul.VarStore)
    (stack : EvmYul.Stack Word) : Prop :=
  List.Forall₂ (fun name value => store.lookup name = some value) layout stack

theorem exact_nil (store : EvmYul.Yul.VarStore) :
    exact [] store [] := by
  exact List.Forall₂.nil

theorem exact_cons {layout : List Name} {store : EvmYul.Yul.VarStore}
    {stack : EvmYul.Stack Word} {name : Name} {value : Word}
    (hLookup : store.lookup name = some value)
    (hExact : exact layout store stack) :
    exact (name :: layout) store (value :: stack) := by
  exact List.Forall₂.cons hLookup hExact

theorem exact_get? {layout : List Name} {store : EvmYul.Yul.VarStore}
    {stack : EvmYul.Stack Word}
    (hExact : exact layout store stack) {idx : Nat} {name : Name}
    (hName : layout[idx]? = some name) :
    ∃ value, stack[idx]? = some value ∧
      store.lookup name = some value := by
  induction hExact generalizing idx with
  | nil =>
      cases idx <;> simp at hName
  | cons hLookup _hTail ih =>
      cases idx with
      | zero =>
          simp at hName
          subst name
          exact ⟨_, by simp, hLookup⟩
      | succ idx =>
          simp at hName
          rcases ih (idx := idx) hName with
            ⟨value, hStack, hStore⟩
          exact ⟨value, by simpa using hStack, hStore⟩

theorem exact_drop {layout : List Name} {store : EvmYul.Yul.VarStore}
    {stack : EvmYul.Stack Word}
    (n : Nat) (hExact : exact layout store stack) :
    exact (layout.drop n) store (stack.drop n) := by
  induction n generalizing layout stack with
  | zero =>
      simpa using hExact
  | succ _ ih =>
      cases hExact with
      | nil =>
          simp [exact_nil]
      | cons _ hTail =>
          simpa using ih hTail

theorem exact_length {layout : List Name} {store : EvmYul.Yul.VarStore}
    {stack : EvmYul.Stack Word}
    (hExact : exact layout store stack) :
    layout.length = stack.length :=
  List.Forall₂.length_eq hExact

theorem exact_cons_insert {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    {name : Name} {value : Word}
    (hFresh : ∀ existing, existing ∈ layout → existing ≠ name)
    (hExact : exact layout store stack) :
    exact (name :: layout) (store.insert name value) (value :: stack) := by
  refine List.Forall₂.cons ?head ?tail
  · exact Finmap.lookup_insert store
  · induction hExact with
    | nil =>
        exact List.Forall₂.nil
    | cons hLookup hRest ih =>
        refine List.Forall₂.cons ?headLookup ?tailLookup
        · rw [Finmap.lookup_insert_of_ne]
          · exact hLookup
          · exact hFresh _ (by simp)
        · exact ih (fun existing hMem => hFresh existing (by simp [hMem]))

theorem exact_singleton_insert {store : EvmYul.Yul.VarStore}
    {name : Name} {value : Word} :
    exact [name] (store.insert name value) [value] := by
  exact List.Forall₂.cons (Finmap.lookup_insert store) List.Forall₂.nil

theorem exact_append {leftLayout rightLayout : List Name}
    {leftStack rightStack : EvmYul.Stack Word}
    {store : EvmYul.Yul.VarStore}
    (hLeft : exact leftLayout store leftStack)
    (hRight : exact rightLayout store rightStack) :
    exact (leftLayout ++ rightLayout) store (leftStack ++ rightStack) := by
  induction hLeft with
  | nil =>
      simpa using hRight
  | cons hHead hTail ih =>
      exact List.Forall₂.cons hHead ih

theorem exact_insert_preserve {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    {name : Name} {value : Word}
    (hFresh : ∀ existing, existing ∈ layout → existing ≠ name)
    (hExact : exact layout store stack) :
    exact layout (store.insert name value) stack := by
  induction hExact with
  | nil =>
      exact List.Forall₂.nil
  | cons hLookup hRest ih =>
      refine List.Forall₂.cons ?head ?tail
      · rw [Finmap.lookup_insert_of_ne]
        · exact hLookup
        · exact hFresh _ (by simp)
      · exact ih (fun existing hMem => hFresh existing (by simp [hMem]))

theorem exact_snoc_insert {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    {name : Name} {value : Word}
    (hFresh : ∀ existing, existing ∈ layout → existing ≠ name)
    (hExact : exact layout store stack) :
    exact (layout ++ [name]) (store.insert name value)
      (stack ++ [value]) := by
  exact
    exact_append
      (exact_insert_preserve hFresh hExact)
      (exact_singleton_insert (store := store) (name := name) (value := value))

def insertPairs (pairs : List (Name × Word))
    (store : EvmYul.Yul.VarStore) : EvmYul.Yul.VarStore :=
  pairs.foldr (fun pair store => store.insert pair.1 pair.2) store

def zeroWord : Word :=
  EvmYul.UInt256.ofNat 0

def zeroPairs (names : List Name) : List (Name × Word) :=
  names.map fun name => (name, zeroWord)

@[simp] theorem zeroPairs_map_fst (names : List Name) :
    (zeroPairs names).map Prod.fst = names := by
  simp [zeroPairs, Function.comp_def]

@[simp] theorem zeroPairs_map_snd (names : List Name) :
    (zeroPairs names).map Prod.snd =
      List.replicate names.length zeroWord := by
  simp [zeroPairs, Function.comp_def]

theorem exact_insertPairs_reverse
    (pairs : List (Name × Word)) (store : EvmYul.Yul.VarStore)
    (hNoDup : (pairs.map Prod.fst).Nodup) :
    exact (pairs.map Prod.fst).reverse (insertPairs pairs store)
      (pairs.map Prod.snd).reverse := by
  induction pairs generalizing store with
  | nil =>
      exact exact_nil store
  | cons pair rest ih =>
      have hRestNoDup : (rest.map Prod.fst).Nodup := by
        exact hNoDup.tail
      have hHeadNotMemRest : pair.1 ∉ rest.map Prod.fst := by
        exact hNoDup.notMem
      have hFresh :
          ∀ existing, existing ∈ (rest.map Prod.fst).reverse →
            existing ≠ pair.1 := by
        intro existing hMem hEq
        have hMemRest : existing ∈ rest.map Prod.fst := by
          simpa using hMem
        exact hHeadNotMemRest (by simpa [hEq] using hMemRest)
      have hRest := ih store hRestNoDup
      simpa [insertPairs] using
        (exact_snoc_insert
          (store := insertPairs rest store)
          (stack := (rest.map Prod.snd).reverse)
          (name := pair.1) (value := pair.2)
          hFresh hRest)

theorem exact_insertPairs_preserve
    (pairs : List (Name × Word)) {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    (hFresh :
      ∀ name, name ∈ pairs.map Prod.fst →
        ∀ existing, existing ∈ layout → existing ≠ name)
    (hExact : exact layout store stack) :
    exact layout (insertPairs pairs store) stack := by
  induction pairs generalizing store with
  | nil =>
      simpa [insertPairs] using hExact
  | cons pair rest ih =>
      have hTail :
          ∀ name, name ∈ rest.map Prod.fst →
            ∀ existing, existing ∈ layout → existing ≠ name := by
        intro name hMem existing hExisting
        exact hFresh name (by simp [hMem]) existing hExisting
      have hHead :
          ∀ existing, existing ∈ layout → existing ≠ pair.1 := by
        intro existing hExisting
        exact hFresh pair.1 (by simp) existing hExisting
      have hRest := ih hTail hExact
      simpa [insertPairs] using
        (exact_insert_preserve
          (store := insertPairs rest store)
          (name := pair.1) (value := pair.2)
          hHead hRest)

theorem exact_insertPairs_append
    (pairs : List (Name × Word)) {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    (hNoDup : (pairs.map Prod.fst).Nodup)
    (hFresh :
      ∀ name, name ∈ pairs.map Prod.fst →
        ∀ existing, existing ∈ layout → existing ≠ name)
    (hExact : exact layout store stack) :
    exact ((pairs.map Prod.fst).reverse ++ layout)
      (insertPairs pairs store)
      ((pairs.map Prod.snd).reverse ++ stack) := by
  exact
    exact_append
      (exact_insertPairs_reverse pairs store hNoDup)
      (exact_insertPairs_preserve pairs hFresh hExact)

theorem multifill_ok (shared : EvmYul.SharedState .Yul)
    (store : EvmYul.Yul.VarStore) (names : List Name) (values : List Word) :
    EvmYul.Yul.State.multifill names values (.Ok shared store) =
      .Ok shared (insertPairs (List.zip names values) store) := by
  have hPairs :
      ∀ (pairs : List (Name × Word)) (store : EvmYul.Yul.VarStore),
        List.foldr
            (fun pair state => EvmYul.Yul.State.insert pair.1 pair.2 state)
            (.Ok shared store) pairs =
          .Ok shared (insertPairs pairs store) := by
    intro pairs
    induction pairs with
    | nil =>
        intro store
        simp [insertPairs]
    | cons pair rest ih =>
        intro store
        cases pair with
        | mk name value =>
            change
              EvmYul.Yul.State.insert name value
                (List.foldr
                  (fun pair state =>
                    EvmYul.Yul.State.insert pair.1 pair.2 state)
                  (.Ok shared store) rest) =
                .Ok shared (Finmap.insert name value (insertPairs rest store))
            rw [ih store]
            simp [EvmYul.Yul.State.insert, insertPairs]
  simpa [EvmYul.Yul.State.multifill] using
    hPairs (List.zip names values) store

theorem insertZeros_ok (shared : EvmYul.SharedState .Yul)
    (store : EvmYul.Yul.VarStore) (names : List Name) :
    List.foldr
        (fun name state =>
          EvmYul.Yul.State.insert name zeroWord state)
        (.Ok shared store) names =
      .Ok shared (insertPairs (zeroPairs names) store) := by
  induction names with
  | nil =>
      simp [zeroPairs, insertPairs]
  | cons name rest ih =>
      change
        EvmYul.Yul.State.insert name zeroWord
          (List.foldr
            (fun name state =>
              EvmYul.Yul.State.insert name zeroWord state)
            (.Ok shared store) rest) =
          .Ok shared
            (Finmap.insert name zeroWord
              (insertPairs (zeroPairs rest) store))
      rw [ih]
      rfl

theorem insertZeros_identifiers_ok (shared : EvmYul.SharedState .Yul)
    (store : EvmYul.Yul.VarStore) (names : List EvmYul.Identifier) :
    List.foldr
        (fun name state =>
          EvmYul.Yul.State.insert name zeroWord state)
        (.Ok shared store) names =
      .Ok shared (insertPairs (zeroPairs (identNames names)) store) := by
  induction names with
  | nil =>
      simp [identNames, zeroPairs, insertPairs]
  | cons name rest ih =>
      change
        EvmYul.Yul.State.insert name zeroWord
          (List.foldr
            (fun name state =>
              EvmYul.Yul.State.insert name zeroWord state)
            (.Ok shared store) rest) =
          .Ok shared
            (Finmap.insert (identName name) zeroWord
              (insertPairs (zeroPairs (identNames rest)) store))
      rw [ih]
      rfl

theorem exact_insertZeros_append
    (names : List Name) {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    (hNoDup : names.Nodup)
    (hFresh : ∀ name, name ∈ names → name ∉ layout)
    (hExact : exact layout store stack) :
    exact (names.reverse ++ layout)
      (insertPairs (zeroPairs names) store)
      (((zeroPairs names).map Prod.snd).reverse ++ stack) := by
  have hNoDupPairs : ((zeroPairs names).map Prod.fst).Nodup := by
    simpa using hNoDup
  have hFreshPairs :
      ∀ name, name ∈ (zeroPairs names).map Prod.fst →
        ∀ existing, existing ∈ layout → existing ≠ name := by
    intro name hMem existing hExisting hEq
    have hMemNames : name ∈ names := by
      simpa using hMem
    exact hFresh name hMemNames (by simpa [hEq] using hExisting)
  simpa using
    exact_insertPairs_append (zeroPairs names)
      hNoDupPairs hFreshPairs hExact

end VarStackRel

/--
Configuration for the concrete Yul-reference-to-compiler state relation.

The relation is parameterized by the pieces that are intentionally outside the
pure control/stack compiler proof:

* `accountMapRel` relates Yul contracts/accounts to the compiled EVM account
  image, and its storage-image fields make persistent and transient storage
  equality derivable from that relation;
* `externalCodeImageRel` relates source account `codeBytes` images to target
  executable bytecode for external account-code inspection;
* `selfbalanceRel` is the same-query/same-answer contract needed by the
  `SELFBALANCE` primitive;
* `selfdestructAccountMapRel` is the full account-map compatibility needed by
  committed `SELFDESTRUCT` observations; it assumes the previous account-map
  relation and the destructing account's balance agreement;
* `selfdestructStorageImageRel` is the legacy focused persistent-storage image
  compatibility used by older storage-only checkpoints;
* `balanceRel` is the same-query/same-answer contract needed by
  account-addressed `BALANCE` reads;
* `extCodeHashRel` is the same-query/same-answer contract needed by
  account-addressed `EXTCODEHASH` reads, including dead-account behavior;
* `sloadRel` is the account-map/current-contract-storage contract needed by
  `SLOAD` reads;
* `tloadRel` is the account-map/current-contract-transient-storage contract
  needed by `TLOAD` reads;
* `codeRel` relates the current Yul contract to the bytecode in the EVM
  execution environment; `ExecutionEnvRel.codeBytes` separately records the
  concrete byte image used by local Yul `codesize`/`codecopy`;
* `varStackRel` relates a Yul varstore to the compiler's stack layout;
* `terminalRel` and `revertRel` relate imported Yul terminal results
  (`YulHalt`/`Revert`) to compiler halt states; and
* `gasAvailableRel`, `gasValueRel`, and `totalGasRel` make the gas-erasure
  boundary explicit. `gasValueRel` is the extra oracle agreement needed for the
  visible Yul `gas()` primitive; CALL-family open requests abstract gas from
  their external request identity.
-/
structure StateRelConfig where
  accountMapRel : AccountMapRel
  storageImageRel :
    ∀ {yul : EvmYul.AccountMap .Yul} {evm : EvmYul.AccountMap .EVM},
      accountMapRel yul evm → StorageImageRel yul evm
  transientStorageImageRel :
    ∀ {yul : EvmYul.AccountMap .Yul} {evm : EvmYul.AccountMap .EVM},
      accountMapRel yul evm → TransientStorageImageRel yul evm
  externalCodeImageRel :
    ∀ {yul : EvmYul.AccountMap .Yul} {evm : EvmYul.AccountMap .EVM},
      accountMapRel yul evm → ExternalCodeImageRel yul evm
  selfbalanceRel :
    ∀ {yul : EvmYul.State .Yul} {evm : EvmYul.State .EVM},
      yul.executionEnv.codeOwner = evm.executionEnv.codeOwner →
        EvmYul.State.selfbalance yul = EvmYul.State.selfbalance evm
  selfdestructAccountMapRel :
    ∀ {source target : EvmYul.AccountAddress}
        {createdYul createdEvm : Bool}
        {yul : EvmYul.AccountMap .Yul} {evm : EvmYul.AccountMap .EVM},
      accountMapRel yul evm →
      AccountBalance yul source = AccountBalance evm source →
        accountMapRel
          (EvmYul.selfdestructAccountMap yul source target createdYul)
          (EvmYul.selfdestructAccountMap evm source target createdEvm)
  selfdestructStorageImageRel :
    ∀ {source target : EvmYul.AccountAddress}
        {createdYul createdEvm : Bool}
        {yul : EvmYul.AccountMap .Yul} {evm : EvmYul.AccountMap .EVM},
      StorageImageRel yul evm →
      AccountBalance yul source = AccountBalance evm source →
        StorageImageRel
          (EvmYul.selfdestructAccountMap yul source target createdYul)
          (EvmYul.selfdestructAccountMap evm source target createdEvm)
  balanceRel :
    ∀ {yul : EvmYul.State .Yul} {evm : EvmYul.State .EVM}
        {address : Word},
      (EvmYul.State.balance yul address).2 =
        (EvmYul.State.balance evm address).2
  extCodeHashRel :
    ∀ {yul : EvmYul.State .Yul} {evm : EvmYul.State .EVM}
        {address : Word},
      accountMapRel yul.accountMap evm.accountMap →
        (EvmYul.State.extCodeHash yul address).2 =
          (EvmYul.State.extCodeHash evm address).2
  sloadRel :
    ∀ {yul : EvmYul.State .Yul} {evm : EvmYul.State .EVM}
        {slot : Word},
      accountMapRel yul.accountMap evm.accountMap →
      yul.executionEnv.codeOwner = evm.executionEnv.codeOwner →
        (EvmYul.State.sload yul slot).2 =
          (EvmYul.State.sload evm slot).2
  sstoreAccountMapRel :
    ∀ {yul : EvmYul.State .Yul} {evm : EvmYul.State .EVM}
        {slot value : Word},
      accountMapRel yul.accountMap evm.accountMap →
      yul.σ₀ = evm.σ₀ →
      yul.executionEnv.codeOwner = evm.executionEnv.codeOwner →
      yul.substate = evm.substate →
        accountMapRel
          (EvmYul.State.sstore yul slot value).accountMap
          (EvmYul.State.sstore evm slot value).accountMap
  sstoreSubstateRel :
    ∀ {yul : EvmYul.State .Yul} {evm : EvmYul.State .EVM}
        {slot value : Word},
      accountMapRel yul.accountMap evm.accountMap →
      yul.σ₀ = evm.σ₀ →
      yul.executionEnv.codeOwner = evm.executionEnv.codeOwner →
      yul.substate = evm.substate →
        (EvmYul.State.sstore yul slot value).substate =
          (EvmYul.State.sstore evm slot value).substate
  tloadRel :
    ∀ {yul : EvmYul.State .Yul} {evm : EvmYul.State .EVM}
        {slot : Word},
      accountMapRel yul.accountMap evm.accountMap →
      yul.executionEnv.codeOwner = evm.executionEnv.codeOwner →
        (EvmYul.State.tload yul slot).2 =
          (EvmYul.State.tload evm slot).2
  tstoreAccountMapRel :
    ∀ {yul : EvmYul.State .Yul} {evm : EvmYul.State .EVM}
        {slot value : Word},
      accountMapRel yul.accountMap evm.accountMap →
      yul.executionEnv.codeOwner = evm.executionEnv.codeOwner →
        accountMapRel
          (EvmYul.State.tstore yul slot value).accountMap
          (EvmYul.State.tstore evm slot value).accountMap
  codeRel : CodeImageRel
  varStackRel : VarStackRel
  terminalRel : Assembly.HaltKind → Word → State → EVMState → Prop
  revertRel : State → EVMState → Prop
  gasAvailableRel : Word → Word → Prop
  gasValueRel :
    ∀ {yul evm : EvmYul.MachineState},
      gasAvailableRel yul.gasAvailable evm.gasAvailable →
        EvmYul.MachineState.gas yul = EvmYul.MachineState.gas evm
  totalGasRel : Nat → Nat → Prop

structure ExecutionEnvRel (cfg : StateRelConfig)
    (yul : EvmYul.ExecutionEnv .Yul) (evm : EvmYul.ExecutionEnv .EVM) :
    Prop where
  codeOwner : yul.codeOwner = evm.codeOwner
  sender : yul.sender = evm.sender
  source : yul.source = evm.source
  weiValue : yul.weiValue = evm.weiValue
  calldata : yul.calldata = evm.calldata
  code : cfg.codeRel yul.code evm.code
  codeBytes : yul.codeBytes = evm.code
  gasPrice : yul.gasPrice = evm.gasPrice
  header : yul.header = evm.header
  depth : yul.depth = evm.depth
  perm : yul.perm = evm.perm
  blobVersionedHashes :
    yul.blobVersionedHashes = evm.blobVersionedHashes

structure ChainStateRel (cfg : StateRelConfig)
    (yul : EvmYul.State .Yul) (evm : EvmYul.State .EVM) : Prop where
  accountMap : cfg.accountMapRel yul.accountMap evm.accountMap
  σ₀ : yul.σ₀ = evm.σ₀
  totalGasUsedInBlock :
    cfg.totalGasRel yul.totalGasUsedInBlock evm.totalGasUsedInBlock
  transactionReceipts :
    yul.transactionReceipts = evm.transactionReceipts
  substate : yul.substate = evm.substate
  executionEnv : ExecutionEnvRel cfg yul.executionEnv evm.executionEnv
  blocks : yul.blocks = evm.blocks
  genesisBlockHeader : yul.genesisBlockHeader = evm.genesisBlockHeader
  createdAccounts : yul.createdAccounts = evm.createdAccounts

namespace ChainStateRel

theorem storageImageRel {cfg : StateRelConfig}
    {yul : EvmYul.State .Yul} {evm : EvmYul.State .EVM}
    (hRel : ChainStateRel cfg yul evm) :
    StorageImageRel yul.accountMap evm.accountMap :=
  cfg.storageImageRel hRel.accountMap

theorem transientStorageImageRel {cfg : StateRelConfig}
    {yul : EvmYul.State .Yul} {evm : EvmYul.State .EVM}
    (hRel : ChainStateRel cfg yul evm) :
    TransientStorageImageRel yul.accountMap evm.accountMap :=
  cfg.transientStorageImageRel hRel.accountMap

theorem externalCodeImageRel {cfg : StateRelConfig}
    {yul : EvmYul.State .Yul} {evm : EvmYul.State .EVM}
    (hRel : ChainStateRel cfg yul evm) :
    ExternalCodeImageRel yul.accountMap evm.accountMap :=
  cfg.externalCodeImageRel hRel.accountMap

theorem selfbalanceRel {cfg : StateRelConfig}
    {yul : EvmYul.State .Yul} {evm : EvmYul.State .EVM}
    (hRel : ChainStateRel cfg yul evm) :
    EvmYul.State.selfbalance yul = EvmYul.State.selfbalance evm :=
  cfg.selfbalanceRel hRel.executionEnv.codeOwner

theorem extCodeSizeRel {cfg : StateRelConfig}
    {yul : EvmYul.State .Yul} {evm : EvmYul.State .EVM}
    {address : Word}
    (hRel : ChainStateRel cfg yul evm) :
    (EvmYul.State.extCodeSize yul address).2 =
      (EvmYul.State.extCodeSize evm address).2 := by
  have hImage :=
    ChainStateRel.externalCodeImageRel hRel (EvmYul.AccountAddress.ofUInt256 address)
  cases hYul :
      yul.accountMap.find? (EvmYul.AccountAddress.ofUInt256 address) <;>
    cases hEvm :
      evm.accountMap.find? (EvmYul.AccountAddress.ofUInt256 address) <;>
    simp [EvmYul.State.extCodeSize, EvmYul.State.lookupAccount,
      Option.option, AccountCodeImage, hYul, hEvm] at hImage ⊢
  all_goals
    simpa using
      congrArg (fun code : ByteArray => EvmYul.UInt256.ofNat code.size)
        hImage

theorem extCodeHashRel {cfg : StateRelConfig}
    {yul : EvmYul.State .Yul} {evm : EvmYul.State .EVM}
    {address : Word}
    (hRel : ChainStateRel cfg yul evm) :
    (EvmYul.State.extCodeHash yul address).2 =
      (EvmYul.State.extCodeHash evm address).2 :=
  cfg.extCodeHashRel hRel.accountMap

end ChainStateRel

structure MachineStateRel (cfg : StateRelConfig)
    (yul evm : EvmYul.MachineState) : Prop where
  gasAvailable : cfg.gasAvailableRel yul.gasAvailable evm.gasAvailable
  activeWords : yul.activeWords = evm.activeWords
  memory : yul.memory = evm.memory
  returnData : yul.returnData = evm.returnData
  H_return : yul.H_return = evm.H_return

namespace MachineStateRel

theorem mload_value {cfg : StateRelConfig}
    {source target : EvmYul.MachineState} {slot : Word}
    (hMachine : MachineStateRel cfg source target) :
    (EvmYul.MachineState.mload source slot).1 =
      (EvmYul.MachineState.mload target slot).1 := by
  rcases hMachine with ⟨_hGas, hActive, hMemory, _hReturn, _hHReturn⟩
  simp [EvmYul.MachineState.mload, EvmYul.MachineState.lookupMemory,
    hActive, hMemory]

theorem mload {cfg : StateRelConfig}
    {source target : EvmYul.MachineState} {slot : Word}
    (hMachine : MachineStateRel cfg source target) :
    MachineStateRel cfg
      (EvmYul.MachineState.mload source slot).2
      (EvmYul.MachineState.mload target slot).2 := by
  rcases hMachine with ⟨hGas, hActive, hMemory, hReturn, hHReturn⟩
  constructor
  · simpa [EvmYul.MachineState.mload] using hGas
  · simp [EvmYul.MachineState.mload, hActive]
  · simpa [EvmYul.MachineState.mload] using hMemory
  · simpa [EvmYul.MachineState.mload] using hReturn
  · simpa [EvmYul.MachineState.mload] using hHReturn

theorem mstore {cfg : StateRelConfig}
    {source target : EvmYul.MachineState} {slot value : Word}
    (hMachine : MachineStateRel cfg source target) :
    MachineStateRel cfg
      (EvmYul.MachineState.mstore source slot value)
      (EvmYul.MachineState.mstore target slot value) := by
  rcases hMachine with ⟨hGas, hActive, hMemory, hReturn, hHReturn⟩
  constructor
  · simpa [EvmYul.MachineState.mstore, EvmYul.MachineState.writeWord,
      EvmYul.writeBytes] using hGas
  · simp [EvmYul.MachineState.mstore, EvmYul.MachineState.writeWord,
      EvmYul.writeBytes, hActive]
  · simpa [EvmYul.MachineState.mstore, EvmYul.MachineState.writeWord,
      EvmYul.writeBytes, hMemory]
  · simpa [EvmYul.MachineState.mstore, EvmYul.MachineState.writeWord,
      EvmYul.writeBytes] using hReturn
  · simpa [EvmYul.MachineState.mstore, EvmYul.MachineState.writeWord,
      EvmYul.writeBytes] using hHReturn


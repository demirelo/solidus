theorem generatedSingletonArgStackBound
    {tmp : Name} {fullLayout : List Name}
    (hNoDup : (tmp :: fullLayout).Nodup) :
    ∀ {pos : Nat} {name : Name} {idx : Nat},
      ([Locals.Expr.var tmp].reverse)[pos]? = some (.var name) →
        (tmp :: fullLayout)[idx]? = some name →
          pos + idx + 1 ≤ 16 := by
  intro pos name idx hArg hLayout
  cases pos with
  | zero =>
      simp at hArg
      subst name
      have hHead : (tmp :: fullLayout)[0]? = some tmp := by simp
      have hIdx : idx = 0 :=
        getElem?_eq_index_of_nodup hNoDup hLayout hHead
      subst idx
      omega
  | succ pos =>
      simp at hArg

theorem generatedPairArgStackBound
    {leftTmp rightTmp : Name} {fullLayout : List Name}
    (hNoDup : (leftTmp :: rightTmp :: fullLayout).Nodup) :

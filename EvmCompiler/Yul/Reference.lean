    EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
      .ok sourceAfter ∧
    Functions.Direct.Block.runOpen program returns ctx targetFuel lowerBlock
        compiler =
      .ok (outcome, ctxAfter) ∧
    CompilerOkOutcomeRel cfg layoutAfter sourceAfter outcome ∧
    outcome.state.returns = compiler.returns

def SomeOkBlockRunBridge {cfg : StateRelConfig}

      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Ok shared store) compiler.evm) :
    ∃ compiler',
      EvmYul.Yul.exec sourceFuel.succ (.Let names none)
          codeOverride (.Ok shared store) =
        .ok (.Ok shared
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames names)) store)) ∧
      Functions.Direct.Block.runOpen program returns ctx
          ((identNames names).length + 1)
          { stmts := Stmt.initNames (identNames names) } compiler =
        .ok (Structured.Outcome.regular compiler',
          ctx.withLayout ((identNames names).reverse ++ ctx.layout)) ∧
      CompilerStateRelWithLayoutSlots cfg
        ((identNames names).reverse ++ sourceLayout)
        ((identNames names).reverse ++ fullLayout)
        (.Ok shared
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames names)) store))
        compiler'.evm ∧
      (ctx.withLayout ((identNames names).reverse ++ ctx.layout)).layout =
        (identNames names).reverse ++ fullLayout ∧
      compiler'.returns = compiler.returns := by
  cases hRel with
  | ok hShared hVars hCover =>
      rcases
        functions_initNames_runOpen_stack
          (cfg := cfg) (shared := shared) program returns
          (identNames names) ctx compiler hShared with
        ⟨compiler', hTarget, hStack, hReturns, hSharedFinal⟩
      refine
        ⟨compiler',
          exec_let_none_ok sourceFuel names codeOverride shared store hCheck,
          hTarget, ?hRel, ?hLayout, hReturns⟩
      · have hStack' :
            compiler'.evm.stack =
              ((VarStackRel.zeroPairs (identNames names)).map Prod.snd).reverse ++
                compiler.evm.stack := by
          simpa [VarStackRel.zeroPairs, Function.comp_def] using hStack
        simpa [VarStackRel.zeroPairs, Function.comp_def] using
          CompilerStateRelWithLayoutSlots.insertPairs_append
            (cfg := cfg) (sourceLayout := sourceLayout)
            (fullLayout := fullLayout) (shared := shared) (store := store)
            (compiler := compiler.evm) (compiler' := compiler'.evm)
            (pairs := VarStackRel.zeroPairs (identNames names))
            (by simpa [VarStackRel.zeroPairs, Function.comp_def] using hNoDup)
            (by
              intro name hMem
              exact hFresh name (by
                simpa [VarStackRel.zeroPairs, Function.comp_def] using hMem))
            hStack' hSharedFinal
            (CompilerStateRelWithLayoutSlots.ok hShared hVars hCover)
      · simp [Locals.Ctx.withLayout, hCtxLayout]


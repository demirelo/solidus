        (.Ok shared store) compiler) :
    ∃ value compiler',
      EvmYul.Yul.eval fuel.succ (.Var name) codeOverride
          (.Ok shared store) =
        .ok (.Ok shared store, value) ∧
      store.lookup (identName name) = some value ∧
      Locals.Direct.Expr.runCode ctx 0 (.var (identName name)) compiler =
        .ok compiler' ∧
      CompilerStateRelWithTempsAndLayoutSlots cfg sourceLayout fullLayout
        [value] (.Ok shared store) compiler' := by
  cases hRel with
  | ok hShared hVars hCover =>
      rcases hVars hSourceName with
        ⟨fullIdx, value, hFullName, hStack, hStore⟩
      let compiler' :=
        compiler.replaceStackAndIncrPC (value :: compiler.stack)
      refine ⟨value, compiler', ?hEval, hStore, ?hRunCode, ?hRel⟩
      · rw [Imported.eval_var_succ]
        simp [lookup?_ok (shared := shared) hStore]
      · have hDepth :
            Locals.Layout.lookupDepth? (identName name) ctx.layout =
              some (fullIdx + 1) := by
          simpa [hCtxLayout] using
            (lookupDepth?_of_get?_nodup hFullName hNoDup)
        have hOne : 1 ≤ fullIdx + 1 := by
          omega
        rcases
            stackOp_dup?_step_eq_dup
              (n := fullIdx + 1) hOne (hBound hFullName) compiler with
          ⟨op, hDup, hStep⟩
        have hDupValue :
            EvmYul.dup (fullIdx + 1) compiler = .ok compiler' := by
          simpa [compiler'] using
            (evm_dup_succ_get? (state := compiler) (idx := fullIdx)
              hStack)
        simp [Locals.Direct.Expr.runCode, hDepth, hDup]
        rw [hStep, hDupValue]
      · exact
          CompilerStateRelWithTempsAndLayoutSlots.ok
            (by
              simpa [compiler', EvmYul.EVM.State.replaceStackAndIncrPC,
                EvmYul.EVM.State.incrPC] using hShared)
            hVars
            hCover
            (by
              simp [compiler', EvmYul.EVM.State.replaceStackAndIncrPC,
                EvmYul.EVM.State.incrPC])

def ExprValueBridgeWithLayoutSlots {cfg : StateRelConfig}
    (sourceLayout fullLayout fullLayoutAfter : List Name)
    (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (expr : AstExpr)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState)
    (pre : List Functions.Stmt) (lower : Functions.Expr 1) : Prop :=
  ∃ sourceAfter : State, ∃ value : Word,
  ∃ compilerAfterPre : RunState, ∃ compilerAfterExpr : RunState,
  ∃ ctxAfter : Locals.Ctx, ∃ preFuel : Nat,
    EvmYul.Yul.evalValues sourceFuel expr codeOverride source =
      .ok (sourceAfter, [value]) ∧
    Functions.Direct.Block.runOpen program returns ctx preFuel
        { stmts := pre } compiler =
      .ok (Structured.Outcome.regular compilerAfterPre, ctxAfter) ∧
    ctx.layout = fullLayout ∧
    ctxAfter.layout = fullLayoutAfter ∧
    LayoutSuffix fullLayout fullLayoutAfter ∧
    Locals.Direct.Expr.runState ctxAfter lower compilerAfterPre =
      .ok compilerAfterExpr ∧
    CompilerStateRelWithTempsAndLayoutSlots cfg sourceLayout fullLayoutAfter
      [value] sourceAfter compilerAfterExpr.evm ∧
    compilerAfterPre.returns = compiler.returns ∧
    compilerAfterExpr.returns = compilerAfterPre.returns

def ExprValueBridgeWithLayoutSlotsPreservingBase {cfg : StateRelConfig}
    (sourceLayout fullLayout fullLayoutAfter : List Name)
    (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (expr : AstExpr)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState)
    (pre : List Functions.Stmt) (lower : Functions.Expr 1) : Prop :=
  ∃ sourceAfter : State, ∃ value : Word,
  ∃ compilerAfterPre : RunState, ∃ compilerAfterExpr : RunState,
  ∃ ctxAfter : Locals.Ctx, ∃ preFuel : Nat,
  ∃ baseStack : EvmYul.Stack Word,
    EvmYul.Yul.evalValues sourceFuel expr codeOverride source =
      .ok (sourceAfter, [value]) ∧
    Functions.Direct.Block.runOpen program returns ctx preFuel
        { stmts := pre } compiler =
      .ok (Structured.Outcome.regular compilerAfterPre, ctxAfter) ∧
    ctx.layout = fullLayout ∧
    ctxAfter.layout = fullLayoutAfter ∧
    LayoutSuffix fullLayout fullLayoutAfter ∧
    Locals.Direct.Expr.runState ctxAfter lower compilerAfterPre =
      .ok compilerAfterExpr ∧
    CompilerStateRelWithTempsAndLayoutSlots cfg sourceLayout fullLayoutAfter
      [value] sourceAfter compilerAfterExpr.evm ∧
    compilerAfterExpr.evm.stack = value :: baseStack ∧
    (∀ {name : Name} {slotValue : Word},
      LayoutSlotValue fullLayout compiler.evm.stack name slotValue →
        LayoutSlotValue fullLayoutAfter baseStack name slotValue) ∧
    compilerAfterPre.returns = compiler.returns ∧
    compilerAfterExpr.returns = compilerAfterPre.returns

theorem ExprValueBridgeWithLayoutSlotsPreservingBase.toBridge
    {cfg : StateRelConfig}
    {sourceLayout fullLayout fullLayoutAfter : List Name}
    {program : Functions.Program} {returns : List Name}
    {ctx : Locals.Ctx} {sourceFuel : Nat} {expr : AstExpr}
    {codeOverride : Option AstContract} {source : State}
    {compiler : RunState} {pre : List Functions.Stmt}
    {lower : Functions.Expr 1}
    (hExpr :
      ExprValueBridgeWithLayoutSlotsPreservingBase (cfg := cfg)
        sourceLayout fullLayout fullLayoutAfter program returns ctx
        sourceFuel expr codeOverride source compiler pre lower) :
    ExprValueBridgeWithLayoutSlots (cfg := cfg) sourceLayout fullLayout
      fullLayoutAfter program returns ctx sourceFuel expr codeOverride source
      compiler pre lower := by
  rcases hExpr with
    ⟨sourceAfter, value, compilerAfterPre, compilerAfterExpr, ctxAfter,
      preFuel, baseStack, hEval, hPreRun, hCtxLayout, hCtxAfterLayout,
      hSuffix, hRunState, hRel, _hStack, _hSlotPreserve, hPreReturns,
      hExprReturns⟩
  exact
    ⟨sourceAfter, value, compilerAfterPre, compilerAfterExpr, ctxAfter,
      preFuel, hEval, hPreRun, hCtxLayout, hCtxAfterLayout, hSuffix,
      hRunState, hRel, hPreReturns, hExprReturns⟩

inductive ArgSlotValues (fullLayout : List Name)
    (stack : EvmYul.Stack Word) :
    List (Locals.Expr 1) → List Word → Prop where
  | nil : ArgSlotValues fullLayout stack [] []
  | cons_var {name : Name} {rest : List (Locals.Expr 1)}
      {value : Word} {values : List Word}
      (hSlot : LayoutSlotValue fullLayout stack name value)
      (hTail : ArgSlotValues fullLayout stack rest values) :
      ArgSlotValues fullLayout stack (.var name :: rest) (value :: values)

namespace ArgSlotValues

theorem map_slots {layout layout' : List Name}
    {stack stack' : EvmYul.Stack Word}
    {exprs : List (Locals.Expr 1)} {values : List Word}
    (hMap :
      ∀ {name : Name} {value : Word},
        LayoutSlotValue layout stack name value →
          LayoutSlotValue layout' stack' name value)
    (hArgs : ArgSlotValues layout stack exprs values) :
    ArgSlotValues layout' stack' exprs values := by
  induction hArgs with
  | nil =>
      exact ArgSlotValues.nil
  | cons_var hSlot hTail ih =>
      exact ArgSlotValues.cons_var (hMap hSlot) ih

theorem length_eq {layout : List Name}
    {stack : EvmYul.Stack Word}
    {exprs : List (Locals.Expr 1)} {values : List Word}
    (hArgs : ArgSlotValues layout stack exprs values) :
    exprs.length = values.length := by
  induction hArgs with
  | nil =>
      rfl
  | cons_var _hSlot _hTail ih =>
      simp [ih]

theorem all_vars {layout : List Name}
    {stack : EvmYul.Stack Word}
    {exprs : List (Locals.Expr 1)} {values : List Word}
    (hArgs : ArgSlotValues layout stack exprs values) :
    ∀ {expr : Locals.Expr 1},
      expr ∈ exprs → ∃ name : Name, expr = .var name := by
  intro expr hMem
  induction hArgs with
  | nil =>
      simp at hMem
  | @cons_var name rest value values hSlot hTail ih =>
      simp at hMem
      cases hMem with
      | inl hHead =>
          subst expr
          exact ⟨name, rfl⟩
      | inr hTailMem =>
          exact ih hTailMem

theorem singleton {layout : List Name}
    {stack : EvmYul.Stack Word} {name : Name} {value : Word}
    (hSlot : LayoutSlotValue layout stack name value) :
    ArgSlotValues layout stack [.var name] [value] :=
  ArgSlotValues.cons_var hSlot ArgSlotValues.nil

theorem append {layout : List Name}
    {stack : EvmYul.Stack Word}
    {left right : List (Locals.Expr 1)}
    {leftValues rightValues : List Word}
    (hLeft : ArgSlotValues layout stack left leftValues)
    (hRight : ArgSlotValues layout stack right rightValues) :
    ArgSlotValues layout stack (left ++ right)
      (leftValues ++ rightValues) := by
  induction hLeft with
  | nil =>
      simpa using hRight
  | cons_var hSlot _hTail ih =>
      simpa using ArgSlotValues.cons_var hSlot ih

theorem reverse {layout : List Name}
    {stack : EvmYul.Stack Word}
    {exprs : List (Locals.Expr 1)} {values : List Word}
    (hArgs : ArgSlotValues layout stack exprs values) :
    ArgSlotValues layout stack exprs.reverse values.reverse := by
  induction hArgs with
  | nil =>
      exact ArgSlotValues.nil
  | cons_var hSlot _hTail ih =>
      simpa [List.reverse_cons] using
        ArgSlotValues.append ih (ArgSlotValues.singleton hSlot)

theorem toArgSlots {layout : List Name}
    {stack : EvmYul.Stack Word}
    {exprs : List (Locals.Expr 1)} {values : List Word}
    (hArgs : ArgSlotValues layout stack exprs values) :
    Yul.ArgSlots.Values layout stack exprs values := by
  induction hArgs with
  | nil =>
      exact Yul.ArgSlots.Values.nil
  | cons_var hSlot _hTail ih =>
      exact Yul.ArgSlots.Values.cons_var hSlot ih

end ArgSlotValues

def BoundArgsBridgeWithLayoutSlotValues {cfg : StateRelConfig}
    (sourceLayout fullLayout fullLayoutAfter : List Name)
    (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (argFuel : Nat) (args : List AstExpr)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (pre : List Functions.Stmt)
    (lowerArgs : List (Locals.Expr 1)) : Prop :=
  ∃ sourceAfter : State, ∃ values : List Word,
  ∃ compilerAfterArgs : RunState, ∃ ctxAfter : Locals.Ctx,
  ∃ preFuel : Nat,
    EvmYul.Yul.evalArgs argFuel args.reverse codeOverride source =
      .ok (sourceAfter, values.reverse) ∧
    Functions.Direct.Block.runOpen program returns ctx preFuel
        { stmts := pre } compiler =
      .ok (Structured.Outcome.regular compilerAfterArgs, ctxAfter) ∧
    ctx.layout = fullLayout ∧
    ctxAfter.layout = fullLayoutAfter ∧
    LayoutSuffix fullLayout fullLayoutAfter ∧
    CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayoutAfter
      sourceAfter compilerAfterArgs.evm ∧
    ArgSlotValues fullLayoutAfter compilerAfterArgs.evm.stack lowerArgs
      values ∧
    compilerAfterArgs.returns = compiler.returns

theorem boundArgsBridgeWithLayoutSlotValues_nil
    {cfg : StateRelConfig}
    {sourceLayout fullLayout : List Name}
    {program : Functions.Program} {returns : List Name}
    {ctx : Locals.Ctx} {argFuel : Nat}
    {codeOverride : Option AstContract} {source : State}
    {compiler : RunState}
    (hCtxLayout : ctx.layout = fullLayout)
    (hRel :
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout source
        compiler.evm) :
    BoundArgsBridgeWithLayoutSlotValues (cfg := cfg) sourceLayout
      fullLayout fullLayout program returns ctx argFuel.succ []
      codeOverride source compiler [] [] := by
  exact
    ⟨source, [], compiler, ctx, 1,
      by simp [Imported.evalArgs_nil_succ],
      by simp [Functions.Direct.Block.runOpen], hCtxLayout, hCtxLayout,
      LayoutSuffix.refl fullLayout, hRel, ArgSlotValues.nil, rfl⟩

def TwoHiddenArgsBridgeWithLayoutSlots {cfg : StateRelConfig}
    (sourceLayout fullLayout fullLayoutAfter : List Name)
    (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (argFuel : Nat) (left right : AstExpr)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (pre : List Functions.Stmt)
    (leftTmp rightTmp : Name) : Prop :=
  ∃ sourceAfter : State, ∃ leftValue rightValue : Word,
  ∃ compilerAfterArgs : RunState, ∃ ctxAfter : Locals.Ctx,
  ∃ preFuel : Nat,
    EvmYul.Yul.evalArgs argFuel [right, left] codeOverride source =
      .ok (sourceAfter, [rightValue, leftValue]) ∧
    Functions.Direct.Block.runOpen program returns ctx preFuel
        { stmts := pre } compiler =
      .ok (Structured.Outcome.regular compilerAfterArgs, ctxAfter) ∧
    ctx.layout = fullLayout ∧
    ctxAfter.layout = leftTmp :: rightTmp :: fullLayoutAfter ∧
    LayoutSuffix fullLayout fullLayoutAfter ∧
    CompilerStateRelWithLayoutSlots cfg sourceLayout
      (leftTmp :: rightTmp :: fullLayoutAfter) sourceAfter
      compilerAfterArgs.evm ∧
    compilerAfterArgs.evm.stack[0]? = some leftValue ∧
    compilerAfterArgs.evm.stack[1]? = some rightValue ∧
    compilerAfterArgs.returns = compiler.returns

def TwoHiddenArgsBridgeWithLayoutSlotValues {cfg : StateRelConfig}
    (sourceLayout fullLayout fullLayoutAfter : List Name)
    (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (argFuel : Nat) (left right : AstExpr)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (pre : List Functions.Stmt)
    (leftTmp rightTmp : Name) : Prop :=
  ∃ sourceAfter : State, ∃ leftValue rightValue : Word,
  ∃ compilerAfterArgs : RunState, ∃ ctxAfter : Locals.Ctx,
  ∃ preFuel : Nat,
    EvmYul.Yul.evalArgs argFuel [right, left] codeOverride source =
      .ok (sourceAfter, [rightValue, leftValue]) ∧
    Functions.Direct.Block.runOpen program returns ctx preFuel
        { stmts := pre } compiler =
      .ok (Structured.Outcome.regular compilerAfterArgs, ctxAfter) ∧
    ctx.layout = fullLayout ∧
    ctxAfter.layout = fullLayoutAfter ∧
    LayoutSuffix fullLayout fullLayoutAfter ∧
    CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayoutAfter
      sourceAfter compilerAfterArgs.evm ∧
    LayoutSlotValue fullLayoutAfter compilerAfterArgs.evm.stack
      leftTmp leftValue ∧
    LayoutSlotValue fullLayoutAfter compilerAfterArgs.evm.stack
      rightTmp rightValue ∧
    compilerAfterArgs.returns = compiler.returns

def TwoHiddenArgsPreludeBridgeWithLayoutSlotValues {cfg : StateRelConfig}
    (sourceLayout fullLayout rightLayout leftLayout : List Name)
    (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (left right : AstExpr)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState)
    (preRight preLeft : List Functions.Stmt)
    (lowerRight lowerLeft : Functions.Expr 1)
    (leftTmp rightTmp : Name) : Prop :=
  ∃ sourceAfterRight : State, ∃ rightValue : Word,
  ∃ compilerAfterRight : RunState, ∃ ctxAfterRight : Locals.Ctx,
  ∃ rightFuel : Nat,
    EvmYul.Yul.evalValues sourceFuel.succ.succ.succ.succ right codeOverride
        source =
      .ok (sourceAfterRight, [rightValue]) ∧
    Functions.Direct.Block.runOpen program returns ctx rightFuel
        { stmts := preRight ++ [Functions.Stmt.let_ rightTmp lowerRight] }
        compiler =
      .ok (Structured.Outcome.regular compilerAfterRight, ctxAfterRight) ∧
    ctx.layout = fullLayout ∧
    ctxAfterRight.layout = rightTmp :: rightLayout ∧
    LayoutSuffix fullLayout rightLayout ∧
    CompilerStateRelWithLayoutSlots cfg sourceLayout
      (rightTmp :: rightLayout) sourceAfterRight compilerAfterRight.evm ∧
    LayoutSlotValue (rightTmp :: rightLayout) compilerAfterRight.evm.stack
      rightTmp rightValue ∧
    compilerAfterRight.returns = compiler.returns ∧
    ExprValueBridgeWithLayoutSlotsPreservingBase (cfg := cfg) sourceLayout
      (rightTmp :: rightLayout) leftLayout program returns ctxAfterRight
      sourceFuel.succ.succ left codeOverride sourceAfterRight compilerAfterRight
      preLeft lowerLeft

theorem TwoHiddenArgsBridgeWithLayoutSlots.toSlotValues
    {cfg : StateRelConfig}
    {sourceLayout fullLayout fullLayoutAfter : List Name}
    {program : Functions.Program} {returns : List Name}
    {ctx : Locals.Ctx} {argFuel : Nat} {left right : AstExpr}
    {codeOverride : Option AstContract} {source : State}
    {compiler : RunState} {pre : List Functions.Stmt}
    {leftTmp rightTmp : Name}
    (hArgs :
      TwoHiddenArgsBridgeWithLayoutSlots (cfg := cfg) sourceLayout fullLayout
        fullLayoutAfter program returns ctx argFuel left right codeOverride
        source compiler pre leftTmp rightTmp) :
    TwoHiddenArgsBridgeWithLayoutSlotValues (cfg := cfg) sourceLayout
      fullLayout (leftTmp :: rightTmp :: fullLayoutAfter) program returns
      ctx argFuel left right codeOverride source compiler pre leftTmp
      rightTmp := by
  rcases hArgs with
    ⟨sourceAfter, leftValue, rightValue, compilerAfterArgs, ctxAfter,
      preFuel, hEvalArgs, hPreRun, hCtxLayout, hCtxAfterLayout,
      hSuffix, hRelArgs, hLeftTop, hRightSecond, hReturns⟩
  exact
    ⟨sourceAfter, leftValue, rightValue, compilerAfterArgs, ctxAfter,
      preFuel, hEvalArgs, hPreRun, hCtxLayout, hCtxAfterLayout,
      LayoutSuffix.cons_hidden leftTmp
        (LayoutSuffix.cons_hidden rightTmp hSuffix),
      hRelArgs,
      ⟨0, by simp, hLeftTop⟩,
      ⟨1, by simp, hRightSecond⟩,
      hReturns⟩

theorem boundArgsBridgeWithLayoutSlotValues_two_to_legacy
    {cfg : StateRelConfig}
    {sourceLayout fullLayout fullLayoutAfter : List Name}
    {program : Functions.Program} {returns : List Name}
    {ctx : Locals.Ctx} {argFuel : Nat} {left right : AstExpr}
    {codeOverride : Option AstContract} {source : State}
    {compiler : RunState} {pre : List Functions.Stmt}
    {leftTmp rightTmp : Name}
    (hArgs :
      BoundArgsBridgeWithLayoutSlotValues (cfg := cfg) sourceLayout
        fullLayout fullLayoutAfter program returns ctx argFuel [left, right]
        codeOverride source compiler pre [.var leftTmp, .var rightTmp]) :
    TwoHiddenArgsBridgeWithLayoutSlotValues (cfg := cfg) sourceLayout
      fullLayout fullLayoutAfter program returns ctx argFuel left right
      codeOverride source compiler pre leftTmp rightTmp := by
  rcases hArgs with
    ⟨sourceAfter, values, compilerAfterArgs, ctxAfter, preFuel,
      hEvalArgs, hPreRun, hCtxLayout, hCtxAfterLayout, hSuffix, hRelArgs,
      hSlots, hReturns⟩
  cases hSlots with
  | cons_var hLeftSlot hTail =>
      cases hTail with
      | cons_var hRightSlot hTailTail =>
          cases hTailTail
          exact
            ⟨sourceAfter, _, _, compilerAfterArgs, ctxAfter, preFuel,
              by simpa using hEvalArgs, hPreRun, hCtxLayout,
              hCtxAfterLayout, hSuffix, hRelArgs, hLeftSlot, hRightSlot,
              hReturns⟩

theorem eval_of_evalValues_single
    {fuel : Nat} {expr : AstExpr} {codeOverride : Option AstContract}
    {source sourceAfter : State} {value : Word}
    (hEvalValues :
      EvmYul.Yul.evalValues fuel expr codeOverride source =
        .ok (sourceAfter, [value])) :
    EvmYul.Yul.eval fuel expr codeOverride source =
      .ok (sourceAfter, value) := by
  simp [EvmYul.Yul.eval, EvmYul.Yul.head', hEvalValues]

theorem evalArgs_singleton_of_evalValues_single
    {fuel : Nat} {expr : AstExpr} {codeOverride : Option AstContract}
    {source sourceAfter : State} {value : Word}
    (hEvalValues :
      EvmYul.Yul.evalValues fuel.succ.succ expr codeOverride source =
        .ok (sourceAfter, [value])) :
    EvmYul.Yul.evalArgs fuel.succ.succ.succ [expr] codeOverride source =
      .ok (sourceAfter, [value]) := by
  have hEval :
      EvmYul.Yul.eval fuel.succ.succ expr codeOverride source =
        .ok (sourceAfter, value) :=
    eval_of_evalValues_single hEvalValues
  rw [Imported.evalArgs_cons_succ]
  simp [hEval, EvmYul.Yul.evalTail, EvmYul.Yul.cons',
    Imported.evalArgs_nil_succ]

theorem evalArgs_pair_of_evalValues_single
    {fuel : Nat} {left right : AstExpr}
    {codeOverride : Option AstContract}
    {source sourceAfterRight sourceAfterLeft : State}
    {leftValue rightValue : Word}
    (hRightEvalValues :
      EvmYul.Yul.evalValues fuel.succ.succ.succ.succ right codeOverride
          source =
        .ok (sourceAfterRight, [rightValue]))
    (hLeftEvalValues :
      EvmYul.Yul.evalValues fuel.succ.succ left codeOverride
          sourceAfterRight =
        .ok (sourceAfterLeft, [leftValue])) :
    EvmYul.Yul.evalArgs fuel.succ.succ.succ.succ.succ [right, left]
        codeOverride source =
      .ok (sourceAfterLeft, [rightValue, leftValue]) := by
  have hRightEval :
      EvmYul.Yul.eval fuel.succ.succ.succ.succ right codeOverride
          source =
        .ok (sourceAfterRight, rightValue) :=
    eval_of_evalValues_single hRightEvalValues
  have hEvalArgsLeft :
      EvmYul.Yul.evalArgs fuel.succ.succ.succ [left] codeOverride
          sourceAfterRight =
        .ok (sourceAfterLeft, [leftValue]) :=
    evalArgs_singleton_of_evalValues_single hLeftEvalValues
  rw [Imported.evalArgs_cons_succ]
  rw [hRightEval]
  simp [EvmYul.Yul.evalTail, EvmYul.Yul.cons', hEvalArgsLeft]

theorem evalArgs_singleton_lit_reverse_ok_eq
    {fuel : Nat} {value : Word} {codeOverride : Option AstContract}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {sourceAfter : State} {values : List Word}
    (hEvalArgs :
      EvmYul.Yul.evalArgs fuel.succ.succ.succ [.Lit value] codeOverride
          (.Ok shared store) =
        .ok (sourceAfter, values.reverse)) :
    sourceAfter = .Ok shared store ∧ values = [value] := by
  have hExpected :
      EvmYul.Yul.evalArgs fuel.succ.succ.succ [.Lit value] codeOverride
          (.Ok shared store) =
        .ok (.Ok shared store, [value]) := by
    exact
      evalArgs_singleton_of_evalValues_single
        (fuel := fuel) (expr := .Lit value) (codeOverride := codeOverride)
        (source := .Ok shared store) (sourceAfter := .Ok shared store)
        (value := value) (by simp [EvmYul.Yul.evalValues])
  rw [hExpected] at hEvalArgs
  have hPair :
      (.Ok shared store, [value]) = (sourceAfter, values.reverse) := by
    simpa using hEvalArgs
  injection hPair with hSource hValuesRev
  have hValues : values = [value] := by
    have hReverse := congrArg List.reverse hValuesRev
    symm
    simpa using hReverse
  exact ⟨hSource.symm, hValues⟩

theorem evalArgs_lit_lit_reverse_ok_eq
    {fuel : Nat} {offset size : Word}
    {codeOverride : Option AstContract}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {sourceAfter : State} {values : List Word}
    (hEvalArgs :
      EvmYul.Yul.evalArgs fuel.succ.succ.succ.succ.succ
          [.Lit size, .Lit offset] codeOverride (.Ok shared store) =
        .ok (sourceAfter, values.reverse)) :
    sourceAfter = .Ok shared store ∧ values = [offset, size] := by
  have hExpected :
      EvmYul.Yul.evalArgs fuel.succ.succ.succ.succ.succ
          [.Lit size, .Lit offset] codeOverride (.Ok shared store) =
        .ok (.Ok shared store, [size, offset]) := by
    exact
      evalArgs_pair_of_evalValues_single
        (fuel := fuel) (left := .Lit offset) (right := .Lit size)
        (codeOverride := codeOverride) (source := .Ok shared store)
        (sourceAfterRight := .Ok shared store)
        (sourceAfterLeft := .Ok shared store) (leftValue := offset)
        (rightValue := size)
        (by simp [EvmYul.Yul.evalValues])
        (by simp [EvmYul.Yul.evalValues])
  rw [hExpected] at hEvalArgs
  have hPair :
      (.Ok shared store, [size, offset]) =
        (sourceAfter, values.reverse) := by
    simpa using hEvalArgs
  injection hPair with hSource hValuesRev
  have hValues : values = [offset, size] := by
    have hReverse := congrArg List.reverse hValuesRev
    symm
    simpa using hReverse
  exact ⟨hSource.symm, hValues⟩

def evalArgsAppendFuel (base : Nat) : List AstExpr → Nat
  | [] => base.succ.succ.succ
  | _head :: tail => (evalArgsAppendFuel base tail).succ.succ

theorem evalArgs_append_singleton_scheduled
    (base : Nat) (argsPrefix : List AstExpr) (head : AstExpr)
    (codeOverride : Option AstContract)
    {source sourceAfterPrefix sourceAfterHead : State}
    {valuesPrefix : List Word} {headValue : Word}
    (hPrefix :
      EvmYul.Yul.evalArgs (evalArgsAppendFuel base argsPrefix) argsPrefix
          codeOverride source =
        .ok (sourceAfterPrefix, valuesPrefix))
    (hHead :
      EvmYul.Yul.eval base.succ.succ head codeOverride sourceAfterPrefix =
        .ok (sourceAfterHead, headValue)) :
    EvmYul.Yul.evalArgs (evalArgsAppendFuel base argsPrefix)
        (argsPrefix ++ [head]) codeOverride source =
      .ok (sourceAfterHead, valuesPrefix ++ [headValue]) := by
  induction argsPrefix generalizing source sourceAfterPrefix valuesPrefix with
  | nil =>
      have hTuple :
          (source, []) = (sourceAfterPrefix, valuesPrefix) := by
        simpa [evalArgsAppendFuel, EvmYul.Yul.evalArgs] using hPrefix
      cases hTuple
      simp [evalArgsAppendFuel, EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
        EvmYul.Yul.cons', hHead]
  | cons first rest ih =>
      cases hFirst :
          EvmYul.Yul.eval (evalArgsAppendFuel base rest).succ
            first codeOverride source with
      | error err =>
          simp [evalArgsAppendFuel, EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail,
            hFirst] at hPrefix
      | ok firstResult =>
          rcases firstResult with ⟨sourceAfterFirst, firstValue⟩
          simp [evalArgsAppendFuel, EvmYul.Yul.evalArgs, hFirst,
            EvmYul.Yul.evalTail, EvmYul.Yul.cons'] at hPrefix ⊢
          cases hRest :
              EvmYul.Yul.evalArgs (evalArgsAppendFuel base rest) rest
                codeOverride sourceAfterFirst with
          | error err =>
              simp [hRest] at hPrefix
          | ok restResult =>
              rcases restResult with ⟨sourceAfterRest, valuesRest⟩
              simp [hRest] at hPrefix
              have hTuple :
                  (sourceAfterRest, firstValue :: valuesRest) =
                    (sourceAfterPrefix, valuesPrefix) := by
                simpa using hPrefix
              cases hTuple
              have hAppend :
                  EvmYul.Yul.evalArgs (evalArgsAppendFuel base rest)
                      (rest ++ [head]) codeOverride sourceAfterFirst =
                    .ok (sourceAfterHead, valuesRest ++ [headValue]) :=
                ih hRest hHead
              simp [hAppend]

theorem evalArgs_reverse_cons_scheduled_of_evalValues
    (base : Nat) (head : AstExpr) (rest : List AstExpr)
    (codeOverride : Option AstContract)
    {source sourceAfterTail sourceAfterHead : State}
    {valuesTail : List Word} {headValue : Word}
    (hTail :
      EvmYul.Yul.evalArgs (evalArgsAppendFuel base rest.reverse)
          rest.reverse codeOverride source =
        .ok (sourceAfterTail, valuesTail.reverse))
    (hHead :
      EvmYul.Yul.evalValues base.succ.succ head codeOverride
          sourceAfterTail =
        .ok (sourceAfterHead, [headValue])) :
    EvmYul.Yul.evalArgs (evalArgsAppendFuel base rest.reverse)
        (head :: rest).reverse codeOverride source =
      .ok (sourceAfterHead, (headValue :: valuesTail).reverse) := by
  have hHeadEval :
      EvmYul.Yul.eval base.succ.succ head codeOverride sourceAfterTail =
        .ok (sourceAfterHead, headValue) :=
    eval_of_evalValues_single hHead
  simpa using
    (evalArgs_append_singleton_scheduled
      base rest.reverse head codeOverride
      (source := source) (sourceAfterPrefix := sourceAfterTail)
      (sourceAfterHead := sourceAfterHead)
      (valuesPrefix := valuesTail.reverse) (headValue := headValue)
      hTail hHeadEval)


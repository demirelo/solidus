/--
Named result adapter for the imported dispatcher boundary.

The source/body bridge proves a compiler-source outcome related to the raw
imported dispatcher-body result.  This adapter is the remaining public
observation contract: it says how that body result is projected through
`Reference.runResult` and related to the chosen compiler-source observation.
-/
def DispatcherResultSound (cfg : Reference.StateRelConfig)
    (layout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → Reference.State →
        Objects.Source.State → Prop)
    (revertRel : Reference.State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (outcomeRel : Reference.OutcomeRel)
    (program : Program) (referenceInitial : Reference.State)
    (sourceInitial : Objects.Source.State)
    (sourceResult : Except Reference.Exception Reference.State)
    (referenceResult : Reference.Result) : Prop :=
  ∀ sourceOutcome targetFuel,
    SourceLowered.runState prim targetFuel program sourceInitial =
      .ok sourceOutcome →
    Reference.SourceBridgeFacts.SourceResultOutcomeRel cfg layout
      terminalRel revertRel sourceResult sourceOutcome →
    Reference.Imported.dispatcherRunResultOfBody program
        referenceInitial sourceResult =
      .ok referenceResult ∧
    outcomeRel referenceResult sourceOutcome

/--
Run-level dispatcher result adapter.

This is the public-facing version of `DispatcherResultSound`: callers relate
the actual imported `Reference.runResult`, while this predicate supplies the
body-result projection for whichever dispatcher-body result the imported runner
reveals internally.
-/
def DispatcherRunResultSound (cfg : Reference.StateRelConfig)
    (layout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → Reference.State →
        Objects.Source.State → Prop)
    (revertRel : Reference.State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (outcomeRel : Reference.OutcomeRel)
    (program : Program) (referenceInitial : Reference.State)
    (sourceInitial : Objects.Source.State)
    (referenceResult : Reference.Result) : Prop :=
  ∀ sourceResult,
    Reference.Imported.dispatcherRunResultOfBody program referenceInitial
        sourceResult =
      .ok referenceResult →
    DispatcherResultSound cfg layout terminalRel revertRel prim outcomeRel
      program referenceInitial sourceInitial sourceResult referenceResult

/--
Observation contract for projecting imported dispatcher-body results.

This is the semantic part of the run-result adapter. It is intentionally about
observable source outcomes only: ordinary dispatcher completion, EVM-level Yul
halts, and revert. It does not mention checked lowering, stack layouts, or
compiler-generated evidence.
-/
structure DispatcherObservationSound (cfg : Reference.StateRelConfig)
    (layout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → Reference.State →
        Objects.Source.State → Prop)
    (revertRel : Reference.State → Objects.Source.State → Prop)
    (outcomeRel : Reference.OutcomeRel)
    (program : Program) (referenceInitial : Reference.State) : Prop where
  regular :
    ∀ {bodyState : Reference.State}
      {sourceOutcome : Objects.Source.Outcome},
      Reference.SourceBridgeFacts.SourceOkOutcomeRel cfg layout bodyState
        sourceOutcome →
      outcomeRel
        (.regular
          (EvmYul.Yul.State.setStore
            (EvmYul.Yul.State.overwrite?
              (EvmYul.Yul.State.reviveJump bodyState)
              (Program.installContract program referenceInitial))
            (Program.installContract program referenceInitial)))
        sourceOutcome
  yulHalt :
    ∀ {haltState : Reference.State} {value : Word}
      {kind : Assembly.HaltKind} {compiler : Objects.Source.State},
      terminalRel kind value haltState compiler →
        outcomeRel (.yulHalt haltState value)
          (Functions.Source.Outcome.halt kind compiler)
  revert :
    ∀ {revertState : Reference.State}
      {compiler : Objects.Source.State},
      revertRel revertState compiler →
        outcomeRel (.revert revertState)
          (Functions.Source.Outcome.halt .revert compiler)

theorem dispatcherObservationSound_of_handlers
    {cfg : Reference.StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → Reference.State →
        Objects.Source.State → Prop}
    {revertRel : Reference.State → Objects.Source.State → Prop}
    {outcomeRel : Reference.OutcomeRel}
    {program : Program} {referenceInitial : Reference.State}
    (hRegular :
      ∀ {bodyState : Reference.State}
        {sourceOutcome : Objects.Source.Outcome},
        Reference.SourceBridgeFacts.SourceOkOutcomeRel cfg layout bodyState
          sourceOutcome →
        outcomeRel
          (.regular
            (EvmYul.Yul.State.setStore
              (EvmYul.Yul.State.overwrite?
                (EvmYul.Yul.State.reviveJump bodyState)
                (Program.installContract program referenceInitial))
              (Program.installContract program referenceInitial)))
          sourceOutcome)
    (hYulHalt :
      ∀ {haltState : Reference.State} {value : Word}
        {kind : Assembly.HaltKind} {compiler : Objects.Source.State},
        terminalRel kind value haltState compiler →
          outcomeRel (.yulHalt haltState value)
            (Functions.Source.Outcome.halt kind compiler))
    (hRevert :
      ∀ {revertState : Reference.State}
        {compiler : Objects.Source.State},
        revertRel revertState compiler →
          outcomeRel (.revert revertState)
            (Functions.Source.Outcome.halt .revert compiler)) :
    DispatcherObservationSound cfg layout terminalRel revertRel outcomeRel
      program referenceInitial :=
  { regular := fun hOk => hRegular hOk
    yulHalt := fun hTerminal => hYulHalt hTerminal
    revert := fun hRevertRel => hRevert hRevertRel }

theorem dispatcherResultSound_regular
    {cfg : Reference.StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → Reference.State →
        Objects.Source.State → Prop}
    {revertRel : Reference.State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {outcomeRel : Reference.OutcomeRel}
    {program : Program} {referenceInitial : Reference.State}
    {sourceInitial : Objects.Source.State}
    {bodyState : Reference.State}
    (hOutcomeRel :
      ∀ {sourceOutcome : Objects.Source.Outcome},
        Reference.SourceBridgeFacts.SourceOkOutcomeRel cfg layout
          bodyState sourceOutcome →
          outcomeRel
            (.regular
              (EvmYul.Yul.State.setStore
                (EvmYul.Yul.State.overwrite?
                  (EvmYul.Yul.State.reviveJump bodyState)
                  (Program.installContract program referenceInitial))
                (Program.installContract program referenceInitial)))
            sourceOutcome) :
    DispatcherResultSound cfg layout terminalRel revertRel prim outcomeRel
      program referenceInitial sourceInitial (.ok bodyState)
      (.regular
        (EvmYul.Yul.State.setStore
          (EvmYul.Yul.State.overwrite?
            (EvmYul.Yul.State.reviveJump bodyState)
            (Program.installContract program referenceInitial))
          (Program.installContract program referenceInitial))) := by
  intro sourceOutcome _targetFuel _hSourceRun hRel
  cases hRel with
  | ok hOk =>
      exact
        ⟨by simp [Reference.Imported.dispatcherRunResultOfBody],
          hOutcomeRel hOk⟩

theorem dispatcherResultSound_yulHalt
    {cfg : Reference.StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → Reference.State →
        Objects.Source.State → Prop}
    {revertRel : Reference.State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {outcomeRel : Reference.OutcomeRel}
    {program : Program} {referenceInitial : Reference.State}
    {sourceInitial : Objects.Source.State}
    {haltState : Reference.State} {value : Word}
    (hOutcomeRel :
      ∀ {kind : Assembly.HaltKind} {compiler : Objects.Source.State},
        terminalRel kind value haltState compiler →
          outcomeRel (.yulHalt haltState value)
            (Functions.Source.Outcome.halt kind compiler)) :
    DispatcherResultSound cfg layout terminalRel revertRel prim outcomeRel
      program referenceInitial sourceInitial
      (.error (.YulHalt haltState value)) (.yulHalt haltState value) := by
  intro sourceOutcome _targetFuel _hSourceRun hRel
  cases hRel with
  | yulHalt hTerminal =>
      exact
        ⟨by simp [Reference.Imported.dispatcherRunResultOfBody],
          hOutcomeRel hTerminal⟩

theorem dispatcherResultSound_revert
    {cfg : Reference.StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → Reference.State →
        Objects.Source.State → Prop}
    {revertRel : Reference.State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {outcomeRel : Reference.OutcomeRel}
    {program : Program} {referenceInitial : Reference.State}
    {sourceInitial : Objects.Source.State}
    {revertState : Reference.State}
    (hOutcomeRel :
      ∀ {compiler : Objects.Source.State},
        revertRel revertState compiler →
          outcomeRel (.revert revertState)
            (Functions.Source.Outcome.halt .revert compiler)) :
    DispatcherResultSound cfg layout terminalRel revertRel prim outcomeRel
      program referenceInitial sourceInitial
      (.error (.Revert revertState)) (.revert revertState) := by
  intro sourceOutcome _targetFuel _hSourceRun hRel
  cases hRel with
  | revert hRevert =>
      exact
        ⟨by simp [Reference.Imported.dispatcherRunResultOfBody],
          hOutcomeRel hRevert⟩

theorem dispatcherRunResultSound_of_observation
    {cfg : Reference.StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → Reference.State →
        Objects.Source.State → Prop}
    {revertRel : Reference.State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {outcomeRel : Reference.OutcomeRel}
    {program : Program} {referenceInitial : Reference.State}
    {sourceInitial : Objects.Source.State}
    {referenceResult : Reference.Result}
    (hObservation :
      DispatcherObservationSound cfg layout terminalRel revertRel outcomeRel
        program referenceInitial) :
    DispatcherRunResultSound cfg layout terminalRel revertRel prim outcomeRel
      program referenceInitial sourceInitial referenceResult := by
  intro sourceResult hBodyResult
  cases sourceResult with
  | ok bodyState =>
      simp [Reference.Imported.dispatcherRunResultOfBody] at hBodyResult
      cases hBodyResult
      exact
        dispatcherResultSound_regular
          (cfg := cfg) (layout := layout) (terminalRel := terminalRel)
          (revertRel := revertRel) (prim := prim)
          (outcomeRel := outcomeRel) (program := program)
          (referenceInitial := referenceInitial)
          (sourceInitial := sourceInitial) (bodyState := bodyState)
          (hOutcomeRel := fun hOk => hObservation.regular hOk)
  | error err =>
      cases err <;>
        simp [Reference.Imported.dispatcherRunResultOfBody] at hBodyResult
      · cases hBodyResult
        exact
          dispatcherResultSound_revert
            (cfg := cfg) (layout := layout) (terminalRel := terminalRel)
            (revertRel := revertRel) (prim := prim)
            (outcomeRel := outcomeRel) (program := program)
            (referenceInitial := referenceInitial)
            (sourceInitial := sourceInitial)
            (hOutcomeRel := fun hRevert =>
              hObservation.revert hRevert)
      · cases hBodyResult
        exact
          dispatcherResultSound_yulHalt
            (cfg := cfg) (layout := layout) (terminalRel := terminalRel)
            (revertRel := revertRel) (prim := prim)
            (outcomeRel := outcomeRel) (program := program)
            (referenceInitial := referenceInitial)
            (sourceInitial := sourceInitial)
            (hOutcomeRel := fun hTerminal =>
              hObservation.yulHalt hTerminal)


    EvmYul.Yul.State.multifill, EvmYul.Yul.State.insert]

theorem assignTop_compiler_exact {cfg : StateRelConfig}
    {layout : List Name} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compilerEVM : EVMState}
    {returns : List Structured.ReturnDest} {ctx : Locals.Ctx}
    {name : Name} {value : Word} {idx : Nat}
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hName : layout[idx]? = some name)
    (hBound : idx + 1 ≤ 16)
    (hRel :
      CompilerStateRelWithTemps cfg layout [value] (.Ok shared store)
        compilerEVM) :
    ∃ finalEVM,
      Functions.Direct.assignTop ctx name
          { evm := compilerEVM, returns := returns } =
        .ok { evm := finalEVM, returns := returns } ∧
      CompilerStateRel cfg layout (.Ok shared (store.insert name value))
        finalEVM := by
  cases hRel with
  | @ok shared' store' compiler0 locals hShared hVars hStack =>
      have hVarsExact : ExactVarStackRel layout store locals := by
        simpa [hVarRelExact] using hVars
      rcases ExactVarStackRel.get? hVarsExact hName with
        ⟨old, hLocal, _hStore⟩
      have hDepth :
          Locals.Layout.lookupDepth? name ctx.layout = some (idx + 1) := by
        simpa [hCtxLayout] using
          (lookupDepth?_of_get?_nodup hName hNoDup)
      rcases
        stackOp_swap?_step_eq_swap_cleanup
          (n := idx + 1) (by omega) hBound compilerEVM with
        ⟨swapOp, hSwapOp, hSwapStep⟩
      let swappedEVM :=
        compilerEVM.replaceStackAndIncrPC
          (old :: locals.take idx ++ [value] ++ locals.drop (idx + 1))
      let finalStack := locals.take idx ++ value :: locals.drop (idx + 1)
      let finalEVM := swappedEVM.replaceStackAndIncrPC finalStack
      refine ⟨finalEVM, ?hRun, ?hRelFinal⟩
      · have hStack' : compilerEVM.stack = value :: locals := by
          simpa using hStack
        have hSwapRun :
            EvmYul.swap (idx + 1) compilerEVM = .ok swappedEVM := by
          simpa [swappedEVM] using
            (evm_swap_assign_get? (state := compilerEVM)
              (locals := locals) (idx := idx) (old := old)
              (value := value) hStack' hLocal)
        have hSwapRun' : swapOp.step compilerEVM = .ok swappedEVM := by
          rw [hSwapStep, hSwapRun]
        have hPop :
            Structured.BasicOp.pop.step swappedEVM = .ok finalEVM := by
          simp [Structured.BasicOp.step, Structured.BasicOp.toPrimOp,
            Assembly.Target.stepInstr, Assembly.PrimOp.step,
            Assembly.PrimStep.run, Assembly.PrimOp.continuingStep?,
            EvmYul.Stack.pop, swappedEVM, finalEVM, finalStack,
            EvmYul.EVM.State.replaceStackAndIncrPC,
            EvmYul.EVM.State.incrPC, List.append_assoc]
        simp [Functions.Direct.assignTop, hDepth, hSwapOp, hSwapRun',
          hPop, Structured.RunState.withEVM]
      · have hExactFinal :
            ExactVarStackRel layout (store.insert name value) finalStack :=
          ExactVarStackRel.assign hNoDup hName hVarsExact
        have hSharedFinal :
            SharedStateRel cfg shared finalEVM.toSharedState := by
          simpa [finalEVM, swappedEVM,
            EvmYul.EVM.State.replaceStackAndIncrPC,
            EvmYul.EVM.State.incrPC] using hShared
        exact CompilerStateRel.ok hSharedFinal
          (by simpa [hVarRelExact, finalEVM, swappedEVM, finalStack,
              EvmYul.EVM.State.replaceStackAndIncrPC,
              EvmYul.EVM.State.incrPC] using hExactFinal)

theorem assignTop_compiler_layout_slots {cfg : StateRelConfig}
    {sourceLayout fullLayout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compilerEVM : EVMState}
    {returns : List Structured.ReturnDest} {ctx : Locals.Ctx}
    {name : Name} {value : Word} {sourceIdx targetFullIdx : Nat}
    (hCtxLayout : ctx.layout = fullLayout)
    (hNoDupFull : fullLayout.Nodup)
    (hTargetSource : sourceLayout[sourceIdx]? = some name)
    (hTargetFull : fullLayout[targetFullIdx]? = some name)
    (hBound : targetFullIdx + 1 ≤ 16)
    (hRel :
      CompilerStateRelWithTempsAndLayoutSlots cfg sourceLayout fullLayout
        [value] (.Ok shared store) compilerEVM) :
    ∃ finalEVM,
      Functions.Direct.assignTop ctx name
          { evm := compilerEVM, returns := returns } =
        .ok { evm := finalEVM, returns := returns } ∧
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Ok shared (store.insert name value)) finalEVM := by
  cases hRel with
  | @ok shared' store' compiler0 baseStack hShared hVars hCover hStack =>
      rcases hVars hTargetSource with
        ⟨targetWitnessIdx, old, hTargetWitnessFull, hLocal,
          _hStore⟩
      have hTargetWitnessEq : targetWitnessIdx = targetFullIdx :=
        getElem?_eq_index_of_nodup hNoDupFull hTargetWitnessFull hTargetFull
      subst targetWitnessIdx
      have hDepth :
          Locals.Layout.lookupDepth? name ctx.layout =
            some (targetFullIdx + 1) := by
        simpa [hCtxLayout] using
          (lookupDepth?_of_get?_nodup hTargetFull hNoDupFull)
      rcases
        stackOp_swap?_step_eq_swap_cleanup
          (n := targetFullIdx + 1) (by omega) hBound compilerEVM with
        ⟨swapOp, hSwapOp, hSwapStep⟩
      let swappedEVM :=
        compilerEVM.replaceStackAndIncrPC
          (old :: baseStack.take targetFullIdx ++ [value] ++
            baseStack.drop (targetFullIdx + 1))
      let finalStack :=
        baseStack.take targetFullIdx ++ value ::
          baseStack.drop (targetFullIdx + 1)
      let finalEVM := swappedEVM.replaceStackAndIncrPC finalStack
      refine ⟨finalEVM, ?hRun, ?hRelFinal⟩
      · have hStack' : compilerEVM.stack = value :: baseStack := by
          simpa using hStack
        have hSwapRun :
            EvmYul.swap (targetFullIdx + 1) compilerEVM =
              .ok swappedEVM := by
          simpa [swappedEVM] using
            (evm_swap_assign_get? (state := compilerEVM)
              (locals := baseStack) (idx := targetFullIdx) (old := old)
              (value := value) hStack' hLocal)
        have hSwapRun' : swapOp.step compilerEVM = .ok swappedEVM := by
          rw [hSwapStep, hSwapRun]
        have hPop :
            Structured.BasicOp.pop.step swappedEVM = .ok finalEVM := by
          simp [Structured.BasicOp.step, Structured.BasicOp.toPrimOp,
            Assembly.Target.stepInstr, Assembly.PrimOp.step,
            Assembly.PrimStep.run, Assembly.PrimOp.continuingStep?,
            EvmYul.Stack.pop, swappedEVM, finalEVM, finalStack,
            EvmYul.EVM.State.replaceStackAndIncrPC,
            EvmYul.EVM.State.incrPC, List.append_assoc]
        simp [Functions.Direct.assignTop, hDepth, hSwapOp, hSwapRun',
          hPop, Structured.RunState.withEVM]
      · have hSharedFinal :
            SharedStateRel cfg shared finalEVM.toSharedState := by
          simpa [finalEVM, swappedEVM,
            EvmYul.EVM.State.replaceStackAndIncrPC,
            EvmYul.EVM.State.incrPC] using hShared
        exact
          CompilerStateRelWithLayoutSlots.assign
            (cfg := cfg) (sourceLayout := sourceLayout)
            (fullLayout := fullLayout) (shared := shared) (store := store)
            (compiler := { compilerEVM with stack := baseStack })
            (compiler' := finalEVM) (name := name) (value := value)
            (sourceIdx := sourceIdx) (targetFullIdx := targetFullIdx)
            hNoDupFull hTargetSource hTargetFull
            (by simp [finalEVM, swappedEVM, finalStack,
              EvmYul.EVM.State.replaceStackAndIncrPC,
              EvmYul.EVM.State.incrPC])
            hSharedFinal
            (CompilerStateRelWithLayoutSlots.ok
              (by
                simpa [EvmYul.EVM.State.toSharedState] using hShared)
              hVars
              hCover)

theorem functions_stmt_assign_single_layout_slots_bridge_of_eval
    {cfg : StateRelConfig}
    {sourceLayout fullLayout : List Name}
    {shared sharedAfter : EvmYul.SharedState .Yul}
    {store storeAfter : EvmYul.Yul.VarStore}
    {compiler compilerAfterExpr : RunState}
    (sourceFuel targetFuel : Nat) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (name : EvmYul.Identifier) (rhs : AstExpr)
    (lower : Functions.Expr 1) (codeOverride : Option AstContract)
    {value : Word} {sourceIdx targetFullIdx : Nat}
    (hCtxLayout : ctx.layout = fullLayout)
    (hNoDupFull : fullLayout.Nodup)
    (hCheck :
      EvmYul.Yul.checkAssignment (.Ok shared store) [name] = .ok ())
    (hTargetSource : sourceLayout[sourceIdx]? = some (identName name))
    (hTargetFull : fullLayout[targetFullIdx]? = some (identName name))
    (hBound : targetFullIdx + 1 ≤ 16)
    (hSourceEval :
      EvmYul.Yul.evalValues sourceFuel.succ rhs codeOverride
          (.Ok shared store) =
        .ok (.Ok sharedAfter storeAfter, [value]))
    (hRunState :
      Locals.Direct.Expr.runState ctx lower compiler =
        .ok compilerAfterExpr)
    (hExprRel :
      CompilerStateRelWithTempsAndLayoutSlots cfg sourceLayout fullLayout
        [value] (.Ok sharedAfter storeAfter) compilerAfterExpr.evm)
    (hExprReturns : compilerAfterExpr.returns = compiler.returns) :
    ∃ compiler',
      EvmYul.Yul.exec sourceFuel.succ.succ
          (.Assign [name] rhs)
          codeOverride (.Ok shared store) =
        .ok (.Ok sharedAfter
          (storeAfter.insert (identName name) value)) ∧
      Functions.Direct.Stmt.run program returns ctx targetFuel
          (.assign (identName name) lower) compiler =
        .ok (Structured.Outcome.regular compiler', ctx) ∧
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Ok sharedAfter (storeAfter.insert (identName name) value))
        compiler'.evm ∧
      compiler'.returns = compiler.returns := by
  rcases
    assignTop_compiler_layout_slots
      (cfg := cfg) (sourceLayout := sourceLayout)
      (fullLayout := fullLayout) (shared := sharedAfter)
      (store := storeAfter) (compilerEVM := compilerAfterExpr.evm)
      (returns := compilerAfterExpr.returns) (ctx := ctx)
      (name := identName name) (value := value) (sourceIdx := sourceIdx)
      (targetFullIdx := targetFullIdx)
      hCtxLayout hNoDupFull hTargetSource hTargetFull hBound hExprRel with
    ⟨finalEVM, hAssign, hRelFinal⟩
  let compiler' := compilerAfterExpr.withEVM finalEVM
  refine ⟨compiler', ?hSourceExec, ?hTarget, ?hRel, ?hReturns⟩
  · rw [Imported.exec_assign_succ]
    simp [hCheck, hSourceEval, identName, EvmYul.Yul.multifill',
      EvmYul.Yul.State.multifill, EvmYul.Yul.State.insert]
  · have hAssign' :
        Functions.Direct.assignTop ctx (identName name) compilerAfterExpr =
          .ok compiler' := by
      simpa [compiler', Structured.RunState.withEVM] using hAssign
    simp [Functions.Direct.Stmt.run, hRunState, hAssign']
  · simpa [compiler'] using hRelFinal
  · simp [compiler', hExprReturns]

theorem functions_stmt_assign_lit_layout_slots_bridge {cfg : StateRelConfig}
    {sourceLayout fullLayout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : RunState}
    (sourceFuel targetFuel : Nat) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx) (name : EvmYul.Identifier)
    (value : Word) (codeOverride : Option AstContract)
    {sourceIdx targetFullIdx : Nat}
    (hCtxLayout : ctx.layout = fullLayout)
    (hNoDupFull : fullLayout.Nodup)
    (hCheck :
      EvmYul.Yul.checkAssignment (.Ok shared store) [name] = .ok ())
    (hTargetSource : sourceLayout[sourceIdx]? = some (identName name))
    (hTargetFull : fullLayout[targetFullIdx]? = some (identName name))
    (hBound : targetFullIdx + 1 ≤ 16)
    (hRel :
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Ok shared store) compiler.evm) :
    ∃ compiler',
      EvmYul.Yul.exec sourceFuel.succ.succ
          (.Assign [name] (.Lit value))
          codeOverride (.Ok shared store) =
        .ok (.Ok shared (store.insert (identName name) value)) ∧
      Functions.Direct.Stmt.run program returns ctx targetFuel
          (.assign (identName name) (.lit value)) compiler =
        .ok (Structured.Outcome.regular compiler', ctx) ∧
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Ok shared (store.insert (identName name) value))
        compiler'.evm ∧
      compiler'.returns = compiler.returns := by
  rcases
    eval_lit_compiler_push_temp_layout_slots
      (cfg := cfg) (sourceLayout := sourceLayout)
      (fullLayout := fullLayout) (shared := shared) (store := store)
      (compiler := compiler.evm) sourceFuel value codeOverride ctx hRel with
    ⟨hEval, hRunCode, hTemps⟩
  let compilerEVM' :=
    compiler.evm.replaceStackAndIncrPC
      (value :: compiler.evm.stack) (pcΔ := 33)
  let compilerAfterExpr := compiler.withEVM compilerEVM'
  have hSourceEval :
      EvmYul.Yul.evalValues sourceFuel.succ (.Lit value) codeOverride
          (.Ok shared store) =
        .ok (.Ok shared store, [value]) := by
    rw [EvmYul.Yul.evalValues]
  have hRunState :
      Locals.Direct.Expr.runState ctx (.lit value) compiler =
        .ok compilerAfterExpr := by
    unfold Locals.Direct.Expr.runState compilerAfterExpr compilerEVM'
    simp [hRunCode]
  exact
    functions_stmt_assign_single_layout_slots_bridge_of_eval
      (cfg := cfg) (sourceLayout := sourceLayout)
      (fullLayout := fullLayout) (shared := shared) (sharedAfter := shared)
      (store := store) (storeAfter := store) (compiler := compiler)
      (compilerAfterExpr := compilerAfterExpr) sourceFuel targetFuel program
      returns ctx name (.Lit value) (.lit value) codeOverride
      (value := value) (sourceIdx := sourceIdx)
      (targetFullIdx := targetFullIdx)
      hCtxLayout hNoDupFull hCheck hTargetSource hTargetFull hBound
      hSourceEval hRunState (by simpa [compilerAfterExpr, compilerEVM'] using hTemps)
      (by simp [compilerAfterExpr])

theorem functions_stmt_assign_var_layout_slots_bridge {cfg : StateRelConfig}
    {sourceLayout fullLayout : List Name}
    {shared : EvmYul.SharedState .Yul}

      .error .OutOfFuel := by
  simp [EvmYul.Yul.loop]

theorem loop_succ_succ (fuel : Nat) (cond : AstExpr)
    (post body : List AstStmt) (codeOverride : Option AstContract)
    (state : State) :
    EvmYul.Yul.loop (fuel + 2) cond post body codeOverride state =
      match
        EvmYul.Yul.eval fuel cond codeOverride
          (EvmYul.Yul.State.mkOk state) with
      | .error err => .error err
      | .ok (stateAfterCond, condValue) =>
          if condValue = ({ val := 0 } : Word) then
            .ok (EvmYul.Yul.State.overwrite? stateAfterCond state)
          else
            match EvmYul.Yul.exec fuel (.Block body) codeOverride
                stateAfterCond with
            | .error err => .error err
            | .ok stateAfterBody =>
                match stateAfterBody with
                | .OutOfFuel =>
                    .ok (EvmYul.Yul.State.overwrite? stateAfterBody state)
                | .Checkpoint (.Break _ _) =>
                    .ok
                      (EvmYul.Yul.State.overwrite?
                        (EvmYul.Yul.State.reviveJump stateAfterBody) state)
                | .Checkpoint (.Leave _ _) =>
                    .ok (EvmYul.Yul.State.overwrite? stateAfterBody state)
                | .Checkpoint (.Continue _ _) | _ =>
                    match
                      EvmYul.Yul.exec fuel (.Block post) codeOverride
                        (EvmYul.Yul.State.reviveJump stateAfterBody) with
                    | .error err => .error err
                    | .ok stateAfterPost =>
                        let stateAfterPostFrame :=
                          EvmYul.Yul.State.overwrite? stateAfterPost state
                        match stateAfterPost with
                        | .OutOfFuel => .ok stateAfterPostFrame
                        | .Checkpoint (.Leave _ _) => .ok stateAfterPostFrame
                        | _ =>
                            match
                              EvmYul.Yul.exec fuel (.For cond post body)
                                codeOverride stateAfterPostFrame with
                            | .error err => .error err
                            | .ok stateAfterLoop =>
                                .ok
                                  (EvmYul.Yul.State.overwrite? stateAfterLoop
                                    state) := by
  simp [EvmYul.Yul.loop]
  rfl


theorem exprArgStackPreludeSound_pair_lit_lit
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    (sourceFuel : Nat) (left right : Word)
    (rightTmp leftTmp : Name) (codeOverride : Option AstContract)
    (hFreshRight : rightTmp ∉ layout)
    (hFreshLeft : leftTmp ∉ layout)
    (hDistinct : leftTmp ≠ rightTmp) :
    ExprArgStackPreludeSound cfg layout prim program ctx
      sourceFuel.succ.succ.succ.succ.succ [.Lit left, .Lit right]
      codeOverride
      [Functions.Stmt.let_ rightTmp (Locals.Expr.lit right),
       Functions.Stmt.let_ leftTmp (Locals.Expr.lit left)]
      (Locals.ExprSeq.cons (Locals.Expr.var rightTmp)
        (Locals.ExprSeq.cons (Locals.Expr.var leftTmp)
          Locals.ExprSeq.nil)) := by
  intro source compiler sourceAfter values hInitial hEval
  cases hInitial with
  | @ok shared store _ hShared hVars =>
      simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, EvmYul.Yul.eval,
        EvmYul.Yul.head', EvmYul.Yul.evalValues, EvmYul.Yul.cons',
        EvmYul.Yul.reverse'] at hEval
      rcases hEval with ⟨hSourceAfter, hValues⟩
      cases hSourceAfter
      cases hValues
      let compilerAfterRight := compiler.insert rightTmp right
      let compilerAfterPre := compilerAfterRight.insert leftTmp left
      have hVarsAfterRight :
          SourceStoreRel layout store compilerAfterRight.vars := by
        exact sourceStoreRel_insert_hidden hVars hFreshRight
      have hVarsAfter :
          SourceStoreRel layout store compilerAfterPre.vars := by
        exact sourceStoreRel_insert_hidden hVarsAfterRight hFreshLeft
      have hRightLookup : compilerAfterPre.vars rightTmp = some right := by
        simp [compilerAfterPre, compilerAfterRight,
          Locals.Source.State.insert,
          Locals.Source.Store.insert_of_ne (Ne.symm hDistinct)]
      have hLeftLookup : compilerAfterPre.vars leftTmp = some left := by
        simp [compilerAfterPre, Locals.Source.State.insert]
      refine
        ⟨compilerAfterPre, compilerAfterPre,
          { ctx with scope := leftTmp :: rightTmp :: ctx.scope }, 3,
          ?_, ?_, ?_⟩
      · simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
          Functions.Source.Expr.evalOne, Locals.Source.Expr.evalOne,
          Locals.Source.Expr.eval, Functions.Source.Outcome.regular,
          Locals.Source.Outcome.regular, compilerAfterRight,
          compilerAfterPre]
      · simp [Locals.Source.Expr.ExprSeq.eval, Locals.Source.Expr.eval,
          hRightLookup, hLeftLookup]
      · exact SourceStateRel.ok hShared hVarsAfter

/--
Expression-value bridge for the compiler's prelude-shaped primitive lowering.

The imported interpreter evaluates call arguments directly.  The source tower
lowering may first run a source-level prelude that binds generated temporaries,
then evaluate the primitive expression over those temporaries.  This theorem is
the stack-free composition point for that pattern; it does not expose direct
stack layouts, DUP/SWAP bounds, cleanup code, or procedure frame details.
-/
def ExprValuePreludeSound (cfg : StateRelConfig) (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (expr : AstExpr)
    (codeOverride : Option AstContract)
    (pre : List Functions.Stmt) {results : Nat}
    (lower : Locals.Expr results) : Prop :=
  ∀ {source compiler sourceAfter values},
    SourceStateRel cfg layout source compiler →
    EvmYul.Yul.evalValues sourceFuel expr codeOverride source =
      .ok (sourceAfter, values) →
    ∃ compilerAfterPre : Objects.Source.State,
    ∃ compilerAfter : Objects.Source.State,
    ∃ ctxAfter : Functions.Source.Ctx,
    ∃ targetFuel : Nat,
      Functions.Source.Block.runOpen prim program ctx targetFuel
          { stmts := pre } compiler =
        .ok (Functions.Source.Outcome.regular compilerAfterPre, ctxAfter) ∧
      Locals.Source.Expr.eval prim lower compilerAfterPre =
        .ok (compilerAfter, values) ∧
      SourceStateRel cfg layout sourceAfter compilerAfter

theorem exprValuePreludeSound_prim_of_arg_prelude
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {yulPrim : EvmYul.Operation .Yul}
    {op : Structured.BasicOp} {args : List AstExpr}
    {codeOverride : Option AstContract}
    {pre : List Functions.Stmt}
    {lowerArgs : Locals.ExprSeq (Expressions.Structured.BasicOp.inputs op)}
    (hArgs :
      ExprArgPreludeSound cfg layout prim program ctx sourceFuel args
        codeOverride pre lowerArgs)
    (hPrim :
      ∀ {sourceAfterArgs : State}
        {compilerAfterArgs : Objects.Source.State}
        {values : List Word} {sourceAfterPrim : State}
        {values' : List Word},
        SourceStateRel cfg layout sourceAfterArgs compilerAfterArgs →
        EvmYul.Yul.primCall sourceFuel sourceAfterArgs yulPrim values =
          .ok (sourceAfterPrim, values') →
        ∃ sharedAfter : EvmYul.SharedState .EVM,
          prim.eval op compilerAfterArgs.shared values =
            .ok (sharedAfter, values') ∧
          SourceStateRel cfg layout sourceAfterPrim
            (compilerAfterArgs.withShared sharedAfter)) :
    ExprValuePreludeSound cfg layout prim program ctx sourceFuel.succ
      (.Call (.inl yulPrim) args) codeOverride pre
      (Locals.Expr.prim op lowerArgs) := by
  intro source compiler sourceAfter values hInitial hEval
  simp [EvmYul.Yul.evalValues] at hEval
  cases hArgEval :
      EvmYul.Yul.reverse'
        (EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride source) with
  | error err =>
      simp [hArgEval] at hEval
  | ok argResult =>
      rcases argResult with ⟨sourceAfterArgs, argValues⟩
      rcases hArgs hInitial hArgEval with
        ⟨compilerAfterPre, compilerAfterArgs, ctxAfter, targetFuel,
          hPreludeRun, hCompilerArgs, hRelArgs⟩
      have hPrimCall :
          EvmYul.Yul.primCall sourceFuel sourceAfterArgs yulPrim
              argValues =
            .ok (sourceAfter, values) := by
        simpa [hArgEval] using hEval
      rcases hPrim hRelArgs hPrimCall with
        ⟨sharedAfter, hPrimEval, hRelAfter⟩
      exact
        ⟨compilerAfterPre, compilerAfterArgs.withShared sharedAfter,
          ctxAfter, targetFuel, hPreludeRun,
          by
            simp [Locals.Source.Expr.eval, hCompilerArgs, hPrimEval,
              Locals.Source.State.withShared],
          hRelAfter⟩

/--
Source-facing contract for imported Yul primitive calls that lower to stack
primitive evaluation.

Imported Yul evaluates call arguments in source order, while the lower stack
expression sequence feeds primitive arguments in stack order. The explicit
`reverse` here is the whole adapter; callers should prove this named contract
for a primitive family instead of exposing the raw callback shape.
-/
def PrimitiveStackSoundAt
    (cfg : StateRelConfig) (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics) (sourceFuel : Nat)
    (yulPrim : EvmYul.Operation .Yul) (op : Structured.BasicOp) : Prop :=
  ∀ {sourceAfterArgs : State}
    {compilerAfterArgs : Objects.Source.State}
    {sourceValues : List Word} {sourceAfterPrim : State}
    {values' : List Word},
    SourceStateRel cfg layout sourceAfterArgs compilerAfterArgs →
    EvmYul.Yul.primCall sourceFuel sourceAfterArgs yulPrim sourceValues =
      .ok (sourceAfterPrim, values') →
    ∃ sharedAfter : EvmYul.SharedState .EVM,
      prim.eval op compilerAfterArgs.shared sourceValues.reverse =
        .ok (sharedAfter, values') ∧
      SourceStateRel cfg layout sourceAfterPrim
        (compilerAfterArgs.withShared sharedAfter)

def YulPrimitiveBinaryZeroSound
    (sourceFuel : Nat) (yulPrim : EvmYul.Operation .Yul)
    (sourceStep :
      EvmYul.SharedState .Yul → Word → Word →
        EvmYul.SharedState .Yul) : Prop :=
  ∀ {sourceShared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {sourceValues : List Word}
    {sourceAfterPrim : State} {values' : List Word},
    EvmYul.Yul.primCall sourceFuel (.Ok sourceShared store) yulPrim
        sourceValues =
      .ok (sourceAfterPrim, values') →
    ∃ left : Word, ∃ right : Word,
      sourceValues = [left, right] ∧
        sourceAfterPrim = .Ok (sourceStep sourceShared left right) store ∧
          values' = []


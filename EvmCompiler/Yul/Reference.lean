      state.executionEnv := by
  cases hLookup : state.accountMap.find? state.executionEnv.codeOwner <;>
    simp [EvmYul.State.tstore, EvmYul.State.lookupAccount, Option.option,
      hLookup, EvmYul.State.updateAccount]


        (.Call (.inl ((.StopArith .ADD : EvmYul.Operation .Yul)))
          [left, right])
        codeOverride source compiler pre
        (.prim .add
          (Locals.ExprSeq.cons (.var rightTmp)
            (Locals.ExprSeq.cons (.var leftTmp) .nil))) := by
    rcases hArgs with
      ⟨sourceAfter, values, compilerAfterArgs, ctxAfter, preFuel,
        hEvalArgs, hPreRun, hCtxLayout, hCtxAfterLayout, hSuffix,
        hRelArgs, hArgSlots, hReturns⟩

theorem freshAux_not_mem_used {used : List Name} {idx fuel : Nat}
    {name : Name}
    (hFresh : Fresh.freshAux used idx fuel = some name) :
    name ∉ used := by
  induction fuel generalizing idx with
  | zero =>
      simp [Fresh.freshAux] at hFresh
  | succ fuel ih =>
      by_cases hMem : Fresh.tempName idx ∈ used
      · have hNext :
            Fresh.freshAux used (idx + 1) fuel = some name := by
          simpa [Fresh.freshAux, hMem] using hFresh
        exact ih hNext
      · have hName : Fresh.tempName idx = name := by
          simpa [Fresh.freshAux, hMem] using hFresh
        subst name
        exact hMem

theorem fresh?_name_not_mem_used {state state' : Fresh.State}
    {name : Name}
    (hFresh : Fresh.fresh? state = some (name, state')) :
    name ∉ state.used := by
  unfold Fresh.fresh? at hFresh
  cases hAux :
      Fresh.freshAux state.used 0 (state.used.length + 1) with
  | none =>
      simp [hAux] at hFresh
  | some candidate =>
      have hCandidate : candidate ∉ state.used :=
        freshAux_not_mem_used hAux
      simp [hAux] at hFresh
      rcases hFresh with ⟨hName, _hState⟩
      subst name
      exact hCandidate

theorem fresh?_state_used {state state' : Fresh.State}
    {name : Name}
    (hFresh : Fresh.fresh? state = some (name, state')) :
    state'.used = name :: state.used := by
  unfold Fresh.fresh? at hFresh
  cases hAux :
      Fresh.freshAux state.used 0 (state.used.length + 1) with
  | none =>
      simp [hAux] at hFresh
  | some candidate =>
      simp [hAux] at hFresh
      rcases hFresh with ⟨hName, hState⟩
      subst name
      cases hState
      rfl

theorem freshCoversLayout_of_used_subset
    {layout : List Name} {state state' : Fresh.State}
    (hCovers : FreshCoversLayout layout state)
    (hSubset : ∀ name, name ∈ state.used → name ∈ state'.used) :
    FreshCoversLayout layout state' := by
  intro name hMem
  exact hSubset name (hCovers name hMem)

theorem freshCoversLayout_fresh?
    {layout : List Name} {state state' : Fresh.State} {tmp : Name}
    (hCovers : FreshCoversLayout layout state)
    (hFresh : Fresh.fresh? state = some (tmp, state')) :
    FreshCoversLayout layout state' := by
  apply freshCoversLayout_of_used_subset hCovers
  intro name hMem
  simp [fresh?_state_used hFresh, hMem]

mutual
  theorem freshCoversLayout_lower?_of_some
      {layout : List Name} {results : Nat}
      {state state' : Fresh.State} {expr : AstExpr}
      {pre : List Functions.Stmt} {lower : Locals.Expr results}
      (hCovers : FreshCoversLayout layout state)
      (hLower :
        Expr.lower? results state expr = some (pre, lower, state')) :
      FreshCoversLayout layout state' := by
    cases expr with
    | Lit value =>
        by_cases hResults : 1 = results
        · simp [Expr.lower?, Expr.cast, hResults] at hLower
          rcases hLower with ⟨_hPre, _hLower, hState⟩
          cases hState
          exact hCovers
        · simp [Expr.lower?, Expr.cast, hResults] at hLower
    | Var name =>
        by_cases hResults : 1 = results
        · simp [Expr.lower?, Expr.cast, hResults] at hLower
          rcases hLower with ⟨_hPre, _hLower, hState⟩
          cases hState
          exact hCovers
        · simp [Expr.lower?, Expr.cast, hResults] at hLower
    | Call callee args =>
        cases callee with
        | inl prim =>
            cases hOp : Prim.toBasicOp? prim with
            | none =>
                simp [Expr.lower?, hOp] at hLower
            | some op =>
                cases hArgs :
                    Expr.List.lowerBound1? state args with
                | none =>
                    simp [Expr.lower?, hOp, hArgs] at hLower
                | some argResult =>
                    rcases argResult with ⟨preArgs, lowerArgs, stateAfterArgs⟩
                    have hCoversArgs :
                        FreshCoversLayout layout stateAfterArgs :=
                      freshCoversLayout_lowerBound1?_of_some hCovers hArgs
                    cases hSeq :
                        Expr.List.toStackSeq? lowerArgs
                          (Expressions.Structured.BasicOp.inputs op) with
                    | none =>
                        simp [Expr.lower?, hOp, hArgs, hSeq] at hLower
                    | some seq =>
                        by_cases hOutputs :
                            Expressions.Structured.BasicOp.outputs op =
                              results
                        · simp [Expr.lower?, hOp, hArgs, hSeq, hOutputs]
                            at hLower
                          rcases hLower with ⟨_hPre, _hLower, hState⟩
                          cases hState
                          exact hCoversArgs
                        · simp [Expr.lower?, hOp, hArgs, hSeq, hOutputs]
                            at hLower
        | inr functionName =>
            by_cases hUnsupported :
                ObjectBuiltin.unsupported? functionName
            · simp [Expr.lower?, hUnsupported] at hLower
            · by_cases hResults : 1 = results
              · by_cases hDirect :
                    Expr.List.directCallArgsSafe? args
                · cases hDirectArgs : Expr.List.toLocals1? args with
                  | none =>
                      simp [Expr.lower?, hUnsupported, hResults, hDirect,
                        hDirectArgs] at hLower
                  | some lowerArgs =>
                      cases hFresh : Fresh.fresh? state with
                      | none =>
                          simp [Expr.lower?, hUnsupported, hResults, hDirect,
                            hDirectArgs, hFresh] at hLower
                      | some freshResult =>
                          rcases freshResult with ⟨tmp, stateFresh⟩
                          simp [Expr.lower?, hUnsupported, hResults, hDirect,
                            hDirectArgs, hFresh] at hLower
                          rcases hLower with ⟨_hPre, _hLower, hState⟩
                          cases hState
                          exact freshCoversLayout_fresh? hCovers hFresh
                · cases hArgs :
                      Expr.List.lowerBound1? state args with
                  | none =>
                      simp [Expr.lower?, hUnsupported, hResults, hDirect,
                        hArgs] at hLower
                  | some argResult =>
                      rcases argResult with
                        ⟨preArgs, lowerArgs, stateAfterArgs⟩
                      have hCoversArgs :
                          FreshCoversLayout layout stateAfterArgs :=
                        freshCoversLayout_lowerBound1?_of_some hCovers hArgs
                      cases hFresh :
                          Fresh.fresh? stateAfterArgs with
                      | none =>
                          simp [Expr.lower?, hUnsupported, hResults, hDirect,
                            hArgs, hFresh] at hLower
                      | some freshResult =>
                          rcases freshResult with ⟨tmp, stateFresh⟩
                          simp [Expr.lower?, hUnsupported, hResults, hDirect,
                            hArgs, hFresh] at hLower
                          rcases hLower with ⟨_hPre, _hLower, hState⟩
                          cases hState
                          exact
                            freshCoversLayout_fresh? hCoversArgs hFresh
              · simp [Expr.lower?, hUnsupported, hResults] at hLower

  theorem freshCoversLayout_lowerBound1?_of_some
      {layout : List Name} {state state' : Fresh.State}
      {exprs : List AstExpr}
      {pre : List Functions.Stmt} {lowerArgs : List (Locals.Expr 1)}
      (hCovers : FreshCoversLayout layout state)
      (hLower :
        Expr.List.lowerBound1? state exprs =
          some (pre, lowerArgs, state')) :
      FreshCoversLayout layout state' := by
    cases exprs with
    | nil =>
        simp [Expr.List.lowerBound1?] at hLower
        rcases hLower with ⟨_hPre, _hLowerArgs, hState⟩
        cases hState
        exact hCovers
    | cons head rest =>
        cases hRest :
            Expr.List.lowerBound1? state rest with
        | none =>
            simp [Expr.List.lowerBound1?, hRest] at hLower
        | some restResult =>
            rcases restResult with ⟨preRest, lowerRest, stateRest⟩
            have hCoversRest :
                FreshCoversLayout layout stateRest :=
              freshCoversLayout_lowerBound1?_of_some hCovers hRest
            cases hHead :
                Expr.lower? 1 stateRest head with
            | none =>
                simp [Expr.List.lowerBound1?, hRest, hHead] at hLower
            | some headResult =>
                rcases headResult with ⟨preHead, lowerHead, stateHead⟩
                have hCoversHead :
                    FreshCoversLayout layout stateHead :=
                  freshCoversLayout_lower?_of_some hCoversRest hHead
                cases hFresh : Fresh.fresh? stateHead with
                | none =>
                    simp [Expr.List.lowerBound1?, hRest, hHead, hFresh]
                      at hLower
                | some freshResult =>
                    rcases freshResult with ⟨tmp, stateFresh⟩
                    simp [Expr.List.lowerBound1?, hRest, hHead, hFresh]
                      at hLower
                    rcases hLower with ⟨_hPre, _hLowerArgs, hState⟩
                    cases hState
                    exact freshCoversLayout_fresh? hCoversHead hFresh
end


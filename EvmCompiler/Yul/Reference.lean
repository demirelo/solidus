  rfl

theorem exec_assign_succ (fuel : Nat) (names : List EvmYul.Identifier)
    (value : AstExpr) (codeOverride : Option AstContract) (state : State) :
    EvmYul.Yul.exec fuel.succ (.Assign names value) codeOverride state =
      match EvmYul.Yul.checkAssignment state names with
      | .error err => .error err
      | .ok () =>
          EvmYul.Yul.multifill' names
            (EvmYul.Yul.evalValues fuel value codeOverride state) := by

      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxAfterPre : Functions.Source.Ctx}
    {sourceFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract} {source : State}
    {compiler compilerAfterPre compilerAfterArgs : Objects.Source.State}
    {sourceResult : Except Exception State}
    {pre : List Functions.Stmt}
    {kind : Assembly.HaltKind} {args : Locals.ExprSeq kind.argCount}
    {sourceValues : List Word} {sharedAfter : EvmYul.SharedState .EVM}
    {preFuel : Nat}
    (hPreShape : GeneratedPrelude pre)
    (hSource :
      EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
        sourceResult)
    (hPreRun :
      Functions.Source.Block.runOpen prim program ctx preFuel
          { stmts := pre } compiler =
        .ok (Functions.Source.Outcome.regular compilerAfterPre, ctxAfterPre))
    (hEvalArgs :
      Locals.Source.Expr.ExprSeq.eval prim args compilerAfterPre =
        .ok (compilerAfterArgs, sourceValues.reverse))
    (hTerminal :
      prim.terminal kind compilerAfterArgs.shared sourceValues.reverse =
        .ok sharedAfter)
    (hRel :
      SourceResultOutcomeRel cfg layout terminalRel revertRel sourceResult
        (Functions.Source.Outcome.halt kind
          (compilerAfterArgs.withShared sharedAfter))) :
    SourceResultBlockRunBridge cfg layout terminalRel revertRel prim program
      ctx sourceFuel sourceStmts codeOverride source compiler
      { stmts := pre ++ [Functions.Stmt.terminalArgs kind args] } := by
  have hSuffix :
      Functions.Source.Block.runOpen prim program ctxAfterPre 1
          { stmts := [Functions.Stmt.terminalArgs kind args] }
          compilerAfterPre =
        .ok
          (Functions.Source.Outcome.halt kind
            (compilerAfterArgs.withShared sharedAfter),
            ctxAfterPre) := by
    simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
      hEvalArgs, hTerminal, Locals.Source.State.withShared,
      Functions.Source.Outcome.halt, Locals.Source.Outcome.halt]
  rcases
      generatedPrelude_runOpen_append_exists
        (prim := prim) (program := program) (pre := pre)
        (suffix := [Functions.Stmt.terminalArgs kind args])
        (ctx := ctx) (midCtx := ctxAfterPre) (finalCtx := ctxAfterPre)
        (state := compiler) (midState := compilerAfterPre)
        (outcome :=
          Functions.Source.Outcome.halt kind
            (compilerAfterArgs.withShared sharedAfter))
        (preFuel := preFuel) (tailFuel := 1)
        hPreShape hPreRun hSuffix with
    ⟨targetFuel, hOpen⟩
  have hScoped :
      Functions.Source.Block.runScoped prim program ctx
          { stmts := pre ++ [Functions.Stmt.terminalArgs kind args] }
          targetFuel compiler =
        .ok
          (Functions.Source.Outcome.halt kind
            (compilerAfterArgs.withShared sharedAfter)) := by
    simp [Functions.Source.Block.runScoped, hOpen,
      Functions.Source.Outcome.halt, Locals.Source.Outcome.halt]
  exact
    sourceResultBlockRunBridge_of_runs
      (sourceResult := sourceResult)
      (sourceOutcome :=
        Functions.Source.Outcome.halt kind
          (compilerAfterArgs.withShared sharedAfter))
      (targetFuel := targetFuel) hSource hScoped hRel


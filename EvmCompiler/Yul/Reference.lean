  simp [Functions.Direct.Block.runOpen, Functions.Direct.Stmt.run,
    zeroZeroReturnArgs, Locals.Direct.Expr.ExprSeq.runCode,
    Locals.Direct.Expr.runCode, Structured.BasicInstr.step,

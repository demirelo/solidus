namespace BridgeFacts

theorem toObjects?_root_components
    {program : Program} {functionProgram : Functions.Program}
    (hToObjects :
      program.toObjects? =
        some { root := Objects.Object.mk "root" functionProgram [] [] }) :
    ∃ bodyStmts : List Functions.Stmt, ∃ state : Fresh.State,
    ∃ functions : List Functions.FunDef, ∃ state' : Fresh.State,
      Stmt.toFunctionsList?
          (Fresh.initial (Contract.names program.contract))
          program.contract.dispatcher = some (bodyStmts, state) ∧
      FunctionList.toFunDefs? state
          (Contract.functionEntries program.contract) =
        some (functions, state') ∧
      functionProgram =
        { functions := functions, body := { stmts := bodyStmts } } := by
  unfold Program.toObjects? Contract.toObjects? at hToObjects
  cases hBody :
      Stmt.toFunctionsList?
        (Fresh.initial (Contract.names program.contract))
        program.contract.dispatcher with
  | none =>
      simp [hBody] at hToObjects
  | some bodyRes =>
      rcases bodyRes with ⟨bodyStmts, state⟩
      cases hFunctions :
          FunctionList.toFunDefs? state
            (Contract.functionEntries program.contract) with
      | none =>
          simp [hBody, hFunctions] at hToObjects
      | some functionRes =>
          rcases functionRes with ⟨functions, state'⟩
          simp [hBody, hFunctions] at hToObjects
          have hProgram :
              functionProgram =
                { functions := functions, body := { stmts := bodyStmts } } := by
            cases hToObjects
            rfl
          exact
            ⟨bodyStmts, state, functions, state', rfl, hFunctions, hProgram⟩

theorem toObjects?_dispatcher_body
    {program : Program} {functionProgram : Functions.Program}
    (hToObjects :
      program.toObjects? =
        some { root := Objects.Object.mk "root" functionProgram [] [] }) :
    ∃ state : Fresh.State,
      Stmt.toFunctionsList?
          (Fresh.initial (Contract.names program.contract))
          program.contract.dispatcher =
        some (functionProgram.body.stmts, state) := by
  rcases toObjects?_root_components hToObjects with
    ⟨bodyStmts, state, functions, state', hBody, _hFunctions, hProgram⟩
  cases hProgram
  exact ⟨state, hBody⟩

theorem lower1?_lit (state : Fresh.State) (value : Word) :
    Expr.lower1? state (.Lit value) =
      some ([], (.lit value : Locals.Expr 1), state) := by
  exact Expr.lower1?_lit state value

theorem lower1?_var (state : Fresh.State) (name : EvmYul.Identifier) :
    Expr.lower1? state (.Var name) =
      some ([], (.var (identName name) : Locals.Expr 1), state) := by
  exact Expr.lower1?_var state name

theorem lowerBound1?_nil (state : Fresh.State) :
    Expr.List.lowerBound1? state [] = some ([], [], state) := by
  exact Expr.lowerBound1?_nil state

theorem freshAux_not_mem_used {used : List Name} {idx fuel : Nat}
    {name : Name}
    (hFresh : Fresh.freshAux used idx fuel = some name) :
    name ∉ used := by
  induction fuel generalizing idx with
  | zero =>
      simp [Fresh.freshAux] at hFresh
  | succ fuel ih =>
      by_cases hMem : Fresh.tempName idx ∈ used
      · have hNext :
            Fresh.freshAux used (idx + 1) fuel = some name := by
          simpa [Fresh.freshAux, hMem] using hFresh
        exact ih hNext
      · have hName : Fresh.tempName idx = name := by
          simpa [Fresh.freshAux, hMem] using hFresh
        subst name
        exact hMem

theorem fresh?_name_not_mem_used {state state' : Fresh.State}
    {name : Name}
    (hFresh : Fresh.fresh? state = some (name, state')) :
    name ∉ state.used := by
  unfold Fresh.fresh? at hFresh
  cases hAux :
      Fresh.freshAux state.used 0 (state.used.length + 1) with
  | none =>
      simp [hAux] at hFresh
  | some candidate =>
      have hCandidate : candidate ∉ state.used :=
        freshAux_not_mem_used hAux
      simp [hAux] at hFresh
      rcases hFresh with ⟨hName, _hState⟩
      subst name
      exact hCandidate

theorem fresh?_state_used {state state' : Fresh.State}
    {name : Name}
    (hFresh : Fresh.fresh? state = some (name, state')) :
    state'.used = name :: state.used := by
  unfold Fresh.fresh? at hFresh
  cases hAux :
      Fresh.freshAux state.used 0 (state.used.length + 1) with
  | none =>
      simp [hAux] at hFresh
  | some candidate =>
      simp [hAux] at hFresh
      rcases hFresh with ⟨hName, hState⟩
      subst name
      cases hState
      rfl

theorem lowerBound1?_cons_components
    {state stateRest stateHead stateFresh : Fresh.State}
    {expr : AstExpr} {rest : List AstExpr}
    {preRest preHead : List Functions.Stmt}
    {lowerRest : List (Locals.Expr 1)}
    {lowerHead : Locals.Expr 1} {tmp : Name}
    (hRest :
      Expr.List.lowerBound1? state rest =
        some (preRest, lowerRest, stateRest))
    (hHead :
      Expr.lower1? stateRest expr = some (preHead, lowerHead, stateHead))
    (hFresh : Fresh.fresh? stateHead = some (tmp, stateFresh)) :
    Expr.List.lowerBound1? state (expr :: rest) =
      some
        (preRest ++ preHead ++ [Functions.Stmt.let_ tmp lowerHead],
          .var tmp :: lowerRest, stateFresh) := by
  exact Expr.lowerBound1?_cons_components hRest hHead hFresh

theorem lowerBound1?_single_components
    {state stateExpr stateFresh : Fresh.State}
    {expr : AstExpr} {pre : List Functions.Stmt}
    {lower : Locals.Expr 1} {tmp : Name}
    (hExpr :
      Expr.lower1? state expr = some (pre, lower, stateExpr))
    (hFresh : Fresh.fresh? stateExpr = some (tmp, stateFresh)) :
    Expr.List.lowerBound1? state [expr] =
      some (pre ++ [Functions.Stmt.let_ tmp lower],
        [.var tmp], stateFresh) := by
  exact Expr.lowerBound1?_single_components hExpr hFresh

theorem lowerBound1?_two_components
    {state stateRight stateRightFresh stateLeft stateLeftFresh : Fresh.State}
    {left right : AstExpr}
    {preRight preLeft : List Functions.Stmt}
    {lowerRight lowerLeft : Locals.Expr 1}
    {rightTmp leftTmp : Name}
    (hRight :
      Expr.lower1? state right =
        some (preRight, lowerRight, stateRight))
    (hFreshRight :
      Fresh.fresh? stateRight = some (rightTmp, stateRightFresh))
    (hLeft :
      Expr.lower1? stateRightFresh left =

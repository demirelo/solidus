      ∀ {sourceAfterBody : State} {compilerAfterBody : RunState}
        {ctxAfter : Locals.Ctx},
        EvmYul.Yul.exec sourceFuel.succ.succ (.If (.Lit value) body)
            codeOverride (.Ok shared store) =

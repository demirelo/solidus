theorem exec_let_prim_call_succ (fuel : Nat)
    (names : List EvmYul.Identifier) (prim : EvmYul.Operation .Yul)
    (args : List AstExpr) (codeOverride : Option AstContract)
    (state : State) :
    EvmYul.Yul.exec fuel.succ
        (.Let names (some (.Call (.inl prim) args))) codeOverride state =
      match EvmYul.Yul.checkDeclaration state names with
      | .error err => .error err
      | .ok () =>
          EvmYul.Yul.multifill' names
            (EvmYul.Yul.evalValues fuel (.Call (.inl prim) args)
              codeOverride state) := by
  simp [EvmYul.Yul.exec]
  rfl


    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (bound : Nat) : Prop where
  stmt :
    ∀ {layout : List Name} {ctx : Functions.Source.Ctx}
      {sourceFuel : Nat} {sourceStmt : AstStmt}
      {codeOverride : Option AstContract},
      sourceFuel ≤ bound →
      ctx.scope = layout →
      CheckedStmtBlockLoweringSoundFresh cfg layout terminalRel revertRel
        prim program ctx sourceFuel sourceStmt codeOverride
  block :
    ∀ {layout : List Name} {ctx : Functions.Source.Ctx}
      {sourceFuel : Nat} {sourceStmts : List AstStmt}
      {codeOverride : Option AstContract},
      sourceFuel ≤ bound →
      ctx.scope = layout →
      CheckedBlockLoweringSoundFresh cfg layout terminalRel revertRel
        prim program ctx sourceFuel sourceStmts codeOverride


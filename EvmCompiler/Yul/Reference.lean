/--
Parametric source-owned block soundness.

This is the bridge shape the imported-Yul proof should converge on: a related
initial state and a concrete imported source run are premises, and the theorem
produces a related source-tower run.  The existential `SourceResultBlockRunBridge`
above is kept as a checkpoint/projection for existing code, but this relation is
the compositional public target for recursive per-construct proofs.
-/
def SourceResultBlockSound (cfg : StateRelConfig) (layout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat)
    (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (lowerBlock : Functions.Block) :
    Prop :=
  ctx.scope = layout ∧
    ∀ {source compiler sourceResult},
      SourceStateRel cfg layout source compiler →
      EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
        sourceResult →
      ∃ sourceOutcome : Objects.Source.Outcome,
      ∃ targetFuel : Nat,
        Functions.Source.Block.runScoped prim program ctx lowerBlock
            targetFuel compiler =
          .ok sourceOutcome ∧
        SourceResultOutcomeRel cfg layout terminalRel revertRel sourceResult
          sourceOutcome


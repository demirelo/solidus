theorem functions_stmt_let_lit_single_bridge {cfg : StateRelConfig}
    {layout : List Name} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : RunState}
    (sourceFuel targetFuel : Nat) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx) (name : EvmYul.Identifier)
    (value : Word) (codeOverride : Option AstContract)
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (_hCtxLayout : ctx.layout = layout)
    (hCheck :
      EvmYul.Yul.checkDeclaration (.Ok shared store) [name] = .ok ())
    (hFresh : identName name ∉ layout)
    (hRel : CompilerStateRel cfg layout (.Ok shared store) compiler.evm) :
    ∃ compiler',
      EvmYul.Yul.exec sourceFuel.succ.succ
          (.Let [name] (some (.Lit value)))
          codeOverride (.Ok shared store) =
        .ok (.Ok shared (store.insert (identName name) value)) ∧
      Functions.Direct.Stmt.run program returns ctx targetFuel
          (.let_ (identName name) (.lit value)) compiler =
        .ok (Structured.Outcome.regular compiler',
          ctx.withLayout (identName name :: ctx.layout)) ∧
      CompilerStateRel cfg (identName name :: layout)
        (.Ok shared (store.insert (identName name) value))
        compiler'.evm ∧
      compiler'.returns = compiler.returns := by
  rcases
    eval_lit_compiler_push_temp
      (cfg := cfg) (layout := layout) sourceFuel value codeOverride ctx
      hRel with
    ⟨_hEval, hRunCode, hTemps⟩
  let compilerEVM' :=
    compiler.evm.replaceStackAndIncrPC
      (value :: compiler.evm.stack) (pcΔ := 33)
  let compiler' := compiler.withEVM compilerEVM'
  refine ⟨compiler', ?hSource, ?hTarget, ?hRel, ?hReturns⟩
  · exact exec_let_lit_single_ok sourceFuel name value codeOverride shared
      store hCheck
  · have hRunState :
        Locals.Direct.Expr.runState ctx (.lit value) compiler =
          .ok compiler' := by
      unfold Locals.Direct.Expr.runState compiler' compilerEVM'
      simp [hRunCode]
    simp [Functions.Direct.Stmt.run, hRunState]
  · exact
      CompilerStateRelWithTemps.bindSingleExact
        hVarRelExact hFresh hTemps
  · simp [compiler']

/--
Target-only hidden-local prelude step.

Expression lowering may introduce fresh compiler temporaries before the
source-visible statement is bridged. Such temporaries extend the compiler
context and stack, but they do not extend the imported Yul varstore. This
lemma records the one-step literal case in the hidden-local relation so later
prelude bridges can compose it instead of weakening the ordinary variable
relation.
-/
theorem functions_stmt_let_lit_hidden_bridge {cfg : StateRelConfig}
    {sourceLayout hiddenLayout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : RunState}
    (targetFuel : Nat) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx) (name : Name)
    (value : Word)
    (hCtxLayout : ctx.layout = hiddenLayout ++ sourceLayout)
    (hRel :
      CompilerStateRelWithHiddenLocals cfg sourceLayout hiddenLayout
        (.Ok shared store) compiler.evm) :
    ∃ compiler',
      Functions.Direct.Stmt.run program returns ctx targetFuel
          (.let_ name (.lit value)) compiler =
        .ok (Structured.Outcome.regular compiler',
          ctx.withLayout (name :: ctx.layout)) ∧
      CompilerStateRelWithHiddenLocals cfg sourceLayout
        (name :: hiddenLayout) (.Ok shared store) compiler'.evm ∧
      (ctx.withLayout (name :: ctx.layout)).layout =
        (name :: hiddenLayout) ++ sourceLayout ∧
      compiler'.returns = compiler.returns := by
  cases hRel with
  | ok hShared hVars hHiddenLength hStack =>
      rename_i hiddenValues locals
      let compilerEVM' :=
        compiler.evm.replaceStackAndIncrPC
          (value :: compiler.evm.stack) (pcΔ := 33)
      let compiler' := compiler.withEVM compilerEVM'
      refine ⟨compiler', ?hTarget, ?hRel, ?hLayout, ?hReturns⟩
      · have hRunState :
            Locals.Direct.Expr.runState ctx (.lit value) compiler =
              .ok compiler' := by
          unfold Locals.Direct.Expr.runState compiler' compilerEVM'
          simp [Locals.Direct.Expr.runCode, Structured.BasicInstr.step,
            Assembly.Target.stepInstr, EvmYul.Stack.push]
        simp [Functions.Direct.Stmt.run, hRunState]
      · exact
          CompilerStateRelWithHiddenLocals.ok
            (hiddenValues := value :: hiddenValues) (locals := locals)
            (by simpa [compiler', compilerEVM',
              EvmYul.EVM.State.replaceStackAndIncrPC,
              EvmYul.EVM.State.incrPC] using hShared)
            hVars
            (by simp [hHiddenLength])
            (by
              simp [compiler', compilerEVM',
                EvmYul.EVM.State.replaceStackAndIncrPC,
                EvmYul.EVM.State.incrPC, hStack])
      · simp [Locals.Ctx.withLayout, hCtxLayout]
      · simp [compiler']

theorem functions_stmt_let_lit_layout_slots_bridge {cfg : StateRelConfig}
    {sourceLayout fullLayout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : RunState}
    (sourceFuel targetFuel : Nat) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx) (name : EvmYul.Identifier)
    (value : Word) (codeOverride : Option AstContract)
    (hCtxLayout : ctx.layout = fullLayout)
    (hCheck :
      EvmYul.Yul.checkDeclaration (.Ok shared store) [name] = .ok ())
    (hFresh : identName name ∉ sourceLayout)
    (hRel :
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Ok shared store) compiler.evm) :
    ∃ compiler',
      EvmYul.Yul.exec sourceFuel.succ.succ
          (.Let [name] (some (.Lit value)))
          codeOverride (.Ok shared store) =
        .ok (.Ok shared (store.insert (identName name) value)) ∧

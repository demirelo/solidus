theorem exprArgPreludeSound_singleton_var
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    (sourceFuel : Nat) (name : EvmYul.Identifier) (tmp : Name)
    (codeOverride : Option AstContract)
    (hMem : identName name ∈ layout)
    (hFresh : tmp ∉ layout) :
    ExprArgPreludeSound cfg layout prim program ctx
      sourceFuel.succ.succ.succ [.Var name] codeOverride
      [Functions.Stmt.let_ tmp (Locals.Expr.var (identName name))]
      (Locals.ExprSeq.cons (Locals.Expr.var tmp) Locals.ExprSeq.nil) := by
  intro source compiler sourceAfter values hInitial hEval
  cases hInitial with
  | @ok shared store _ hShared hVars =>
      cases hLookup : EvmYul.Yul.State.lookup? name (.Ok shared store) with
      | none =>
          simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, EvmYul.Yul.eval,
            EvmYul.Yul.head', EvmYul.Yul.evalValues, hLookup,
            EvmYul.Yul.reverse'] at hEval
      | some value =>
          have hStore : store.lookup (identName name) = some value := by
            simpa [EvmYul.Yul.State.lookup?, identName] using hLookup
          have hSourceVar : compiler.vars (identName name) = some value := by
            simpa [hStore] using hVars (identName name) hMem
          simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, EvmYul.Yul.eval,
            EvmYul.Yul.head', EvmYul.Yul.evalValues, hLookup,
            EvmYul.Yul.cons', EvmYul.Yul.reverse'] at hEval
          rcases hEval with ⟨hSourceAfter, hValues⟩
          cases hSourceAfter
          cases hValues
          let compilerAfterPre := compiler.insert tmp value
          have hVarsAfter :
              SourceStoreRel layout store compilerAfterPre.vars := by
            exact sourceStoreRel_insert_hidden hVars hFresh
          refine
            ⟨compilerAfterPre, compilerAfterPre,
              { ctx with scope := tmp :: ctx.scope }, 2, ?_, ?_, ?_⟩
          · simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
              Functions.Source.Expr.evalOne, Locals.Source.Expr.evalOne,
              Locals.Source.Expr.eval, Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular, hSourceVar, compilerAfterPre]
          · simp [Locals.Source.Expr.ExprSeq.eval, Locals.Source.Expr.eval,
              compilerAfterPre, Locals.Source.State.insert]
          · exact SourceStateRel.ok hShared hVarsAfter


                              (.Call (.inl prim) [left, middle, right])
                              codeOverride source =
                            .ok (.Ok sharedAfter storeAfter,
                              [result leftValue middleValue rightValue]) := by
                        cases argFuel with
                        | zero =>
                            simp [EvmYul.Yul.evalArgs] at hEvalArgs
                        | succ argFuel =>
                            have hEvalArgs' :
                                EvmYul.Yul.evalArgs (argFuel + 1)
                                    [right, middle, left] codeOverride
                                    source =

theorem sstore {cfg : StateRelConfig}
    {sourceShared : EvmYul.SharedState .Yul} {target : EVMState}
    {slot value : Word}
    (hShared : SharedStateRel cfg sourceShared target.toSharedState) :
    SharedStateRel cfg
      { sourceShared with
        toState := EvmYul.State.sstore sourceShared.toState slot value }
      ({ target with
        toState := EvmYul.State.sstore target.toState slot value }
        : EVMState).toSharedState := by
  rcases hShared with ⟨hChain, hMachine⟩
  constructor
  · rcases hChain with
      ⟨hAccountMap, hSigma, hTotal, hReceipts, hSubstate, hEnv,
        hBlocks, hGenesis, hCreated⟩
    constructor
    · exact
        cfg.sstoreAccountMapRel hAccountMap hSigma hEnv.codeOwner
          hSubstate
    · rw [StateFacts.sstore_σ₀, StateFacts.sstore_σ₀]
      exact hSigma
    · rw [StateFacts.sstore_totalGasUsedInBlock,
        StateFacts.sstore_totalGasUsedInBlock]
      exact hTotal
    · rw [StateFacts.sstore_transactionReceipts,
        StateFacts.sstore_transactionReceipts]
      exact hReceipts
    · exact
        cfg.sstoreSubstateRel hAccountMap hSigma hEnv.codeOwner
          hSubstate
    · rw [StateFacts.sstore_executionEnv, StateFacts.sstore_executionEnv]
      exact hEnv
    · rw [StateFacts.sstore_blocks, StateFacts.sstore_blocks]
      exact hBlocks
    · rw [StateFacts.sstore_genesisBlockHeader,
        StateFacts.sstore_genesisBlockHeader]
      exact hGenesis
    · rw [StateFacts.sstore_createdAccounts,
        StateFacts.sstore_createdAccounts]
      exact hCreated
  · exact hMachine


            compiler =
          .ok (sourceOutcome, ctxAfter) ∧
        ctxAfter.scope = ctxAfterLayout ∧
        (∀ name, name ∈ layout → name ∈ ctxAfterLayout) ∧
        SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
          sourceResult sourceOutcome

theorem sourceResultSeqSoundWhenAt_of_fuel
    {cfg : StateRelConfig}
    {layout ctxAfterLayout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel targetFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract} {lowerBlock : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hSound :
      SourceResultSeqSoundWhenAtFuel cfg layout ctxAfterLayout outcomeLayout
        terminalRel revertRel prim program ctx sourceFuel targetFuel
        sourceStmts codeOverride lowerBlock allowed) :
    SourceResultSeqSoundWhenAt cfg layout ctxAfterLayout outcomeLayout
      terminalRel revertRel prim program ctx sourceFuel sourceStmts
      codeOverride lowerBlock allowed := by
  rcases hSound with ⟨hScope, hRun⟩
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hAllowed hSource
  rcases hRun hInitial hAllowed hSource with
    ⟨sourceOutcome, ctxAfter, hTarget, hCtxAfter, hSubset, hRel⟩
  exact
    ⟨sourceOutcome, ctxAfter, targetFuel, hTarget, hCtxAfter, hSubset, hRel⟩

theorem sourceResultSeqRunAt_exists_of_sound_when_at
    {cfg : StateRelConfig}
    {layout ctxAfterLayout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract} {lowerBlock : Functions.Block}
    {allowed : Except Exception State → Prop}
    {source : State} {compiler : Objects.Source.State}
    {sourceResult : Except Exception State}
    (hSound :
      SourceResultSeqSoundWhenAt cfg layout ctxAfterLayout outcomeLayout
        terminalRel revertRel prim program ctx sourceFuel sourceStmts
        codeOverride lowerBlock allowed)
    (hInitial : SourceStateRel cfg layout source compiler)
    (hAllowed : allowed sourceResult)
    (hSource :
      EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
        sourceResult) :
    ∃ targetFuel,
      SourceResultSeqRunAt cfg layout ctxAfterLayout outcomeLayout terminalRel
        revertRel prim program ctx sourceFuel targetFuel sourceStmts
        codeOverride source compiler lowerBlock := by
  rcases hSound with ⟨hScope, hRun⟩
  rcases hRun hInitial hAllowed hSource with
    ⟨sourceOutcome, ctxAfter, targetFuel, hTarget, hCtxAfter, hSubset,
      hRel⟩
  exact
    ⟨targetFuel, sourceResult, sourceOutcome, ctxAfter, hSource, hTarget,
      hScope, hCtxAfter, hSubset, hRel⟩

theorem sourceResultSeqSoundWhenAt_nil
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {codeOverride : Option AstContract}
    {allowed : Except Exception State → Prop}
    (hAllowed :
      ∀ {sourceResult}, allowed sourceResult →
        SourceResultRelatable sourceResult)
    (hScope : ctx.scope = layout) :
    SourceResultSeqSoundWhenAt cfg layout layout layout terminalRel revertRel
      prim program ctx sourceFuel [] codeOverride { stmts := [] } allowed := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hAllow hSource
  cases sourceFuel with
  | zero =>
      have hZero :
          EvmYul.Yul.execSeq 0 [] codeOverride source =
            .error .OutOfFuel := by
        simp [EvmYul.Yul.execSeq]
      rw [hZero] at hSource
      subst sourceResult
      have hRelatable :
          SourceResultRelatable (.error (.OutOfFuel : Exception)) :=
        hAllowed hAllow
      cases hRelatable
  | succ fuel =>
      rw [Imported.execSeq_nil_succ fuel codeOverride source] at hSource
      subst sourceResult
      refine
        ⟨Functions.Source.Outcome.regular compiler, ctx, 1, ?_, hScope,
          (fun _ hMem => hMem), ?_⟩
      · simp [Functions.Source.Block.runOpen]
      · exact
          SourceResultOutcomeRel.ok
            (SourceOkOutcomeRel.regular hInitial)

/--
Fixed-target-fuel nil case for open sequences.

The fuel-specific interface is only useful once both source and target have
positive fuel, so this constructor exposes that shape directly and avoids the
out-of-fuel branch handled by the public existential nil theorem.
-/
theorem sourceResultSeqSoundWhenAtFuel_nil
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel targetFuel : Nat} {codeOverride : Option AstContract}
    {allowed : Except Exception State → Prop}
    (hScope : ctx.scope = layout) :
    SourceResultSeqSoundWhenAtFuel cfg layout layout layout terminalRel
      revertRel prim program ctx sourceFuel.succ targetFuel.succ []
      codeOverride { stmts := [] } allowed := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial _hAllow hSource
  rw [Imported.execSeq_nil_succ sourceFuel codeOverride source] at hSource
  subst sourceResult
  refine
    ⟨Functions.Source.Outcome.regular compiler, ctx, ?_, hScope,
      (fun _ hMem => hMem), ?_⟩
  · simp [Functions.Source.Block.runOpen]
  · exact
      SourceResultOutcomeRel.ok
        (SourceOkOutcomeRel.regular hInitial)

theorem sourceResultSeqSoundWhenAtFuelExact_nil
    {cfg : StateRelConfig} {layout : List Name}

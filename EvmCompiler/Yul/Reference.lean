theorem lowerBound1?_lit_components_fresh_of_some
    {state state' : Fresh.State} {value : Word}
    {pre : List Functions.Stmt} {lowerArgs : List (Locals.Expr 1)}
    (hLower :
      Expr.List.lowerBound1? state [.Lit value] =
        some (pre, lowerArgs, state')) :
    ∃ tmp : Name,
      pre = [Functions.Stmt.let_ tmp (.lit value)] ∧
      lowerArgs = [.var tmp] ∧
      tmp ∉ state.used := by
  cases hFresh : Fresh.fresh? state with
  | none =>
      simp [Expr.List.lowerBound1?, Expr.lower?, Expr.cast, hFresh] at hLower
  | some freshResult =>
      rcases freshResult with ⟨tmp, stateFresh⟩
      simp [Expr.List.lowerBound1?, Expr.lower?, Expr.cast, hFresh] at hLower
      rcases hLower with ⟨hPre, hLowerArgs, _hState⟩
      exact
        ⟨tmp, hPre.symm, hLowerArgs.symm,
          fresh?_name_not_mem_used hFresh⟩

theorem lowerBound1?_lit_lit_components_distinct_fresh_of_some
    {state state' : Fresh.State} {leftValue rightValue : Word}
    {pre : List Functions.Stmt} {lowerArgs : List (Locals.Expr 1)}
    (hLower :
      Expr.List.lowerBound1? state [.Lit leftValue, .Lit rightValue] =
        some (pre, lowerArgs, state')) :
    ∃ rightTmp leftTmp : Name,
      pre =
        [Functions.Stmt.let_ rightTmp (.lit rightValue),
         Functions.Stmt.let_ leftTmp (.lit leftValue)] ∧
      lowerArgs = [.var leftTmp, .var rightTmp] ∧
      leftTmp ≠ rightTmp ∧
      rightTmp ∉ state.used ∧
      leftTmp ∉ state.used := by
  cases hFreshRight : Fresh.fresh? state with
  | none =>
      simp [Expr.List.lowerBound1?, Expr.lower?, Expr.cast, hFreshRight]
        at hLower
  | some rightFreshResult =>
      rcases rightFreshResult with ⟨rightTmp, stateRightFresh⟩
      cases hFreshLeft : Fresh.fresh? stateRightFresh with
      | none =>
          simp [Expr.List.lowerBound1?, Expr.lower?, Expr.cast,
            hFreshRight, hFreshLeft] at hLower
      | some leftFreshResult =>
          rcases leftFreshResult with ⟨leftTmp, stateLeftFresh⟩
          simp [Expr.List.lowerBound1?, Expr.lower?, Expr.cast,
            hFreshRight, hFreshLeft] at hLower
          rcases hLower with ⟨hPre, hLowerArgs, _hState⟩
          have hRightFresh : rightTmp ∉ state.used :=
            fresh?_name_not_mem_used hFreshRight
          have hLeftFresh : leftTmp ∉ stateRightFresh.used :=
            fresh?_name_not_mem_used hFreshLeft
          have hRightUsed :
              stateRightFresh.used = rightTmp :: state.used :=
            fresh?_state_used hFreshRight
          have hDistinct : leftTmp ≠ rightTmp := by
            intro hEq
            apply hLeftFresh
            simp [hRightUsed, hEq]
          have hLeftNotUsed : leftTmp ∉ state.used := by
            intro hMem
            apply hLeftFresh
            simp [hRightUsed, hMem]
          exact
            ⟨rightTmp, leftTmp, hPre.symm, hLowerArgs.symm, hDistinct,
              hRightFresh, hLeftNotUsed⟩

theorem checkedStmtBlockLoweringSoundFresh_selfdestruct_lit_call
    {cfg : StateRelConfig} {layout : List Name}

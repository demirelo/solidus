        (stateRel := stateRel) (outcomeRel := outcomeRel)
        (program := program) (functionProgram := functionProgram)
        (asm := asm) (shared := shared) (store := store)
        (sourceInitial := sourceInitial) (sourceFuel := sourceFuel)

    (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel targetFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : Objects.Source.State) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : Objects.Source.State,
    EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
      .ok sourceAfter ∧
    Functions.Source.Block.runScoped prim program ctx lowerBlock targetFuel
        compiler =
      .ok (Functions.Source.Outcome.regular compilerAfter) ∧
    SourceStateRel cfg layout sourceAfter compilerAfter

theorem sourceRegularBlockRunBridge_of_at
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel targetFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract} {source : State}
    {compiler : Objects.Source.State} {lowerBlock : Functions.Block}
    (hAt :
      SourceRegularBlockRunAt cfg layout prim program ctx sourceFuel
        targetFuel sourceStmts codeOverride source compiler lowerBlock) :
    SourceRegularBlockRunBridge cfg layout prim program ctx sourceFuel
      sourceStmts codeOverride source compiler lowerBlock := by
  rcases hAt with
    ⟨sourceAfter, compilerAfter, hSource, hCompiler, hRel⟩
  exact ⟨sourceAfter, compilerAfter, targetFuel, hSource, hCompiler, hRel⟩

/--
Result-shaped scoped source block bridge. This is intentionally source-owned:
it records imported Yul block execution and stack-free source block execution,
without mentioning the lower operand stack or direct procedure backend. The
relation between a particular imported result and source outcome is supplied by
the dispatcher theorem that consumes this bridge.
-/

      SourceStateRel cfg layout sourceAfter compilerAfterArgs

theorem exprArgPreludeSound_nil
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    (sourceFuel : Nat) (codeOverride : Option AstContract) :
    ExprArgPreludeSound cfg layout prim program ctx sourceFuel.succ []
      codeOverride [] Locals.ExprSeq.nil := by
  intro source compiler sourceAfter values hInitial hEval
  cases hInitial with
  | @ok shared store _ hShared hVars =>
      simp [EvmYul.Yul.evalArgs, EvmYul.Yul.reverse'] at hEval
      rcases hEval with ⟨hSourceAfter, hValues⟩
      cases hSourceAfter
      cases hValues
      exact
        ⟨compiler, compiler, ctx, 1,
          by simp [Functions.Source.Block.runOpen],
          by simp [Locals.Source.Expr.ExprSeq.eval],
          SourceStateRel.ok hShared hVars⟩


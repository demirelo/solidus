theorem sourceResultBlockSound_terminalStackPrelude_of_arg_sound
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel argFuel : Nat} {sourceStmts : List AstStmt}
    {sourceArgs : List AstExpr} {codeOverride : Option AstContract}
    {pre : List Functions.Stmt}
    {kind : Assembly.HaltKind} {args : Locals.ExprSeq kind.argCount}
    (hScope : ctx.scope = layout)
    (hPreShape : GeneratedPrelude pre)
    (hArgSound :
      ExprArgStackPreludeSound cfg layout prim program ctx argFuel
        sourceArgs codeOverride pre args)
    (hTerminal :
      ∀ {source compiler sourceResult},
        SourceStateRel cfg layout source compiler →
        EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
          sourceResult →
        ∃ sourceAfterArgs : State,
        ∃ sourceValues : List Word,
          EvmYul.Yul.reverse'
              (EvmYul.Yul.evalArgs argFuel sourceArgs.reverse codeOverride
                source) =
            .ok (sourceAfterArgs, sourceValues) ∧
          ∀ {compilerAfterPre compilerAfterArgs : Objects.Source.State}
            {ctxAfterPre : Functions.Source.Ctx} {preFuel : Nat},
          Functions.Source.Block.runOpen prim program ctx preFuel
              { stmts := pre } compiler =
            .ok (Functions.Source.Outcome.regular compilerAfterPre,
              ctxAfterPre) →
          Locals.Source.Expr.ExprSeq.eval prim args compilerAfterPre =
            .ok (compilerAfterArgs, sourceValues.reverse) →
          SourceStateRel cfg layout sourceAfterArgs compilerAfterArgs →
            ∃ sharedAfter : EvmYul.SharedState .EVM,
              prim.terminal kind compilerAfterArgs.shared
                  sourceValues.reverse =
                .ok sharedAfter ∧
              SourceResultOutcomeRel cfg layout terminalRel revertRel
                sourceResult
                (Functions.Source.Outcome.halt kind
                  (compilerAfterArgs.withShared sharedAfter))) :
    SourceResultBlockSound cfg layout terminalRel revertRel prim program ctx
      sourceFuel sourceStmts codeOverride
      { stmts := pre ++ [Functions.Stmt.terminalArgs kind args] } := by
  refine ⟨hScope, ?_⟩
  intro source compiler sourceResult hInitial hSource
  rcases hTerminal hInitial hSource with
    ⟨sourceAfterArgs, sourceValues, hArgEval, hTerminalRel⟩
  have hBridge :
      SourceResultBlockRunBridge cfg layout terminalRel revertRel prim program
        ctx sourceFuel sourceStmts codeOverride source compiler
        { stmts := pre ++ [Functions.Stmt.terminalArgs kind args] } :=
    sourceResultBlockRunBridge_terminalStackPrelude_of_arg_sound
      (cfg := cfg) (layout := layout) (terminalRel := terminalRel)
      (revertRel := revertRel) (prim := prim) (program := program)
      (ctx := ctx) (sourceFuel := sourceFuel) (argFuel := argFuel)
      (sourceStmts := sourceStmts) (sourceArgs := sourceArgs)
      (codeOverride := codeOverride) (source := source)
      (sourceAfterArgs := sourceAfterArgs) (compiler := compiler)
      (sourceResult := sourceResult) (pre := pre) (kind := kind)
      (args := args) (sourceValues := sourceValues)
      hPreShape hArgSound hInitial hArgEval hSource hTerminalRel
  rcases hBridge with
    ⟨sourceResult', sourceOutcome, targetFuel, hSource', hCompiler, hRel⟩
  have hResultEq : sourceResult' = sourceResult := by
    rw [hSource] at hSource'
    exact hSource'.symm
  have hRel' :
      SourceResultOutcomeRel cfg layout terminalRel revertRel sourceResult
        sourceOutcome := by
    simpa [hResultEq] using hRel
  exact ⟨sourceOutcome, targetFuel, hCompiler, hRel'⟩


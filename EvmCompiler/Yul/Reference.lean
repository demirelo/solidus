theorem tstore {cfg : StateRelConfig}
    {sourceShared : EvmYul.SharedState .Yul} {target : EVMState}
    {slot value : Word}
    (hShared : SharedStateRel cfg sourceShared target.toSharedState) :
    SharedStateRel cfg
      { sourceShared with
        toState := EvmYul.State.tstore sourceShared.toState slot value }
      ({ target with
        toState := EvmYul.State.tstore target.toState slot value }
        : EVMState).toSharedState := by
  rcases hShared with ⟨hChain, hMachine⟩
  constructor
  · rcases hChain with
      ⟨hAccountMap, hSigma, hTotal, hReceipts, hSubstate, hEnv,
        hBlocks, hGenesis, hCreated⟩
    constructor
    · exact cfg.tstoreAccountMapRel hAccountMap hEnv.codeOwner
    · rw [StateFacts.tstore_σ₀, StateFacts.tstore_σ₀]
      exact hSigma
    · rw [StateFacts.tstore_totalGasUsedInBlock,
        StateFacts.tstore_totalGasUsedInBlock]
      exact hTotal
    · rw [StateFacts.tstore_transactionReceipts,
        StateFacts.tstore_transactionReceipts]

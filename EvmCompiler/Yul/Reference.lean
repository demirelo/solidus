        | leave _ =>
            exact Imported.execSeq_cons_checkpoint_succ hSource
    | yulHalt _ =>
        exact Imported.execSeq_cons_error_succ hSource
    | revert _ =>
        exact Imported.execSeq_cons_error_succ hSource
  have hTargetStmt :
      Functions.Direct.Block.runOpen program returns ctx targetFuel.succ
          { stmts := [Functions.Stmt.block lowerBlock] ++
              lowerTail.stmts } compiler =
        .ok (outcome, ctx) := by
    cases hMode : outcome.mode with
    | regular =>
        exact False.elim (hNonregular hMode)
    | brk =>
        simp [Functions.Direct.Block.runOpen, Functions.Direct.Stmt.run,
          Functions.Direct.Block.runScoped, hTarget, hMode]
    | cont =>
        simp [Functions.Direct.Block.runOpen, Functions.Direct.Stmt.run,
          Functions.Direct.Block.runScoped, hTarget, hMode]
    | leave =>
        simp [Functions.Direct.Block.runOpen, Functions.Direct.Stmt.run,
          Functions.Direct.Block.runScoped, hTarget, hMode]
    | halt kind =>
        simp [Functions.Direct.Block.runOpen, Functions.Direct.Stmt.run,
          Functions.Direct.Block.runScoped, hTarget, hMode]
  exact
    ⟨sourceResult, outcome, ctx, targetFuel.succ, hSourceSeq, hTargetStmt,
      hCtxLayout, hCtxLayout, LayoutSuffix.refl fullLayout, hRel, hReturns⟩


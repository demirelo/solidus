theorem eval_var_succ (fuel : Nat) (name : EvmYul.Identifier)
    (codeOverride : Option AstContract) (state : State) :
    EvmYul.Yul.eval fuel.succ (.Var name) codeOverride state =
      match state.lookup? name with
      | .some value => .ok (state, value)
      | .none => .error (.UnknownIdentifier name) := by
  simp [EvmYul.Yul.eval, EvmYul.Yul.evalValues, EvmYul.Yul.head']
  cases state.lookup? name <;> rfl


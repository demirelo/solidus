    {codeOverride : Option AstContract}
    {lowerStmt : Functions.Stmt} {lowerRest : List Functions.Stmt}
    {compiler mid : RunState} {outcome : Functions.Outcome}
    (hSourceHead :
      EvmYul.Yul.exec sourceFuel stmt codeOverride source =
        .ok sourceAfter)
    (hTargetHead :
      Functions.Direct.Stmt.run program returns ctx targetFuel lowerStmt
          compiler =
        .ok (Structured.Outcome.regular mid, midCtx))
    (hSourceTail :
      EvmYul.Yul.exec sourceFuel (.Block rest) codeOverride sourceAfter =
        .ok final)
    (hSourceWhole :
      EvmYul.Yul.exec sourceFuel.succ (.Block (stmt :: rest))
          codeOverride source =
        .ok final)
    (hTargetTail :
      Functions.Direct.Block.runOpen program returns midCtx targetFuel
          { stmts := lowerRest } mid =
        .ok (outcome, runCtx)) :
    EvmYul.Yul.exec sourceFuel.succ (.Block (stmt :: rest))
        codeOverride source =
      .ok final ∧
    Functions.Direct.Block.runOpen program returns ctx targetFuel.succ
        { stmts := lowerStmt :: lowerRest } compiler =
      .ok (outcome, runCtx) := by
  exact
    ⟨imported_block_cons_ok hSourceHead hSourceTail hSourceWhole,
      functions_block_cons_regular hTargetHead hTargetTail⟩

def RegularStmtPrefixBridge {cfg : StateRelConfig}
    (layoutAfter : List Name) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (sourceStmt : AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (lowerPrefix : List Functions.Stmt) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : RunState,
  ∃ ctxAfter : Locals.Ctx,
    EvmYul.Yul.exec sourceFuel sourceStmt codeOverride source =
      .ok sourceAfter ∧
    (∀ (tail : Functions.Block) {tailFuel : Nat}
        {outcome : Functions.Outcome} {runCtx : Locals.Ctx},
      Functions.Direct.Block.runOpen program returns ctxAfter tailFuel tail
          compilerAfter =
        .ok (outcome, runCtx) →
      Functions.Direct.Block.runOpen program returns ctx
          (lowerPrefix.length + tailFuel)
          { stmts := lowerPrefix ++ tail.stmts } compiler =
        .ok (outcome, runCtx)) ∧
    CompilerStateRel cfg layoutAfter sourceAfter compilerAfter.evm ∧
    compilerAfter.returns = compiler.returns

/-- `inner` is a stack-layout extension of `outer` by pushing new names in front. -/
def LayoutSuffix (outer inner : List Name) : Prop :=
  ∃ pushed : List Name, inner = pushed ++ outer

namespace LayoutSuffix

theorem refl (layout : List Name) : LayoutSuffix layout layout := by
  exact ⟨[], by simp⟩

theorem trans {outer mid inner : List Name}
    (hLeft : LayoutSuffix outer mid)
    (hRight : LayoutSuffix mid inner) :
    LayoutSuffix outer inner := by
  rcases hLeft with ⟨left, rfl⟩
  rcases hRight with ⟨right, rfl⟩
  exact ⟨right ++ left, by simp [List.append_assoc]⟩

theorem cons_hidden (name : Name) {outer inner : List Name}
    (hSuffix : LayoutSuffix outer inner) :
    LayoutSuffix outer (name :: inner) := by
  rcases hSuffix with ⟨pushed, rfl⟩
  exact ⟨name :: pushed, by simp⟩

theorem length_le {outer inner : List Name}
    (hSuffix : LayoutSuffix outer inner) :
    outer.length ≤ inner.length := by
  rcases hSuffix with ⟨pushed, rfl⟩
  simp

theorem drop {outer inner : List Name}
    (hSuffix : LayoutSuffix outer inner) :
    inner.drop (inner.length - outer.length) = outer := by
  rcases hSuffix with ⟨pushed, rfl⟩
  have hLen :
      (pushed ++ outer).length - outer.length = pushed.length := by
    simp
  simp [hLen]

end LayoutSuffix

/--
Fuel-existential statement-pushed bridge.

This is the append-friendly shape for prefixes whose compiled target may need
more than the tail's fuel budget to replay, such as bracketed scoped blocks.
The older `RegularStmtPrefixBridge` is stronger and remains convenient for
single, fuel-insensitive prefixes.
-/
def RegularStmtPrefixBridgeExists {cfg : StateRelConfig}
    (layoutAfter : List Name) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (sourceStmt : AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (lowerPrefix : List Functions.Stmt) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : RunState,
  ∃ ctxAfter : Locals.Ctx, ∃ targetFuel : Nat,
    EvmYul.Yul.exec sourceFuel sourceStmt codeOverride source =
      .ok sourceAfter ∧
    Functions.Direct.Block.runOpen program returns ctx targetFuel
        { stmts := lowerPrefix } compiler =
      .ok (Structured.Outcome.regular compilerAfter, ctxAfter) ∧
    CompilerStateRel cfg layoutAfter sourceAfter compilerAfter.evm ∧
    compilerAfter.returns = compiler.returns

/--
Fuel-existential statement-pushed bridge with explicit context-layout facts.
This is the shape recursive open-block proofs need in order to close an
enclosing scoped block.
-/
def RegularStmtPrefixBridgeWithLayout {cfg : StateRelConfig}
    (layout layoutAfter : List Name) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (sourceStmt : AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (lowerPrefix : List Functions.Stmt) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : RunState,
  ∃ ctxAfter : Locals.Ctx, ∃ targetFuel : Nat,
    EvmYul.Yul.exec sourceFuel sourceStmt codeOverride source =
      .ok sourceAfter ∧
    Functions.Direct.Block.runOpen program returns ctx targetFuel
        { stmts := lowerPrefix } compiler =
      .ok (Structured.Outcome.regular compilerAfter, ctxAfter) ∧
    ctx.layout = layout ∧
    ctxAfter.layout = layoutAfter ∧
    LayoutSuffix layout layoutAfter ∧
    CompilerStateRel cfg layoutAfter sourceAfter compilerAfter.evm ∧
    compilerAfter.returns = compiler.returns

/--
Fuel-existential statement-pushed bridge for compiler-only hidden locals.

The imported Yul source store is related only to `sourceLayout`; compiler
temporaries introduced by lowering live in `hiddenLayout` above it. This is the
hidden-local counterpart of `RegularStmtPrefixBridgeWithLayout` for prefixes
that complete regularly without forcing hidden compiler locals into the source
varstore relation.
-/
def RegularStmtPrefixBridgeWithHiddenLayout {cfg : StateRelConfig}
    (sourceLayout hiddenLayout hiddenLayoutAfter : List Name)
    (program : Functions.Program) (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (sourceStmt : AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (lowerPrefix : List Functions.Stmt) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : RunState,
  ∃ ctxAfter : Locals.Ctx, ∃ targetFuel : Nat,
    EvmYul.Yul.exec sourceFuel sourceStmt codeOverride source =
      .ok sourceAfter ∧
    Functions.Direct.Block.runOpen program returns ctx targetFuel
        { stmts := lowerPrefix } compiler =
      .ok (Structured.Outcome.regular compilerAfter, ctxAfter) ∧
    ctx.layout = hiddenLayout ++ sourceLayout ∧
    ctxAfter.layout = hiddenLayoutAfter ++ sourceLayout ∧
    LayoutSuffix (hiddenLayout ++ sourceLayout)
      (hiddenLayoutAfter ++ sourceLayout) ∧
    CompilerStateRelWithHiddenLocals cfg sourceLayout hiddenLayoutAfter
      sourceAfter compilerAfter.evm ∧
    compilerAfter.returns = compiler.returns

/--
Fuel-existential statement-pushed bridge for arbitrary full compiler layouts.

`sourceLayout` names only variables present in the imported Yul store; the full
layout can also contain compiler-generated locals. This is the recursive bridge
shape used once expression lowering may interleave generated locals with source
variables.
-/
def RegularStmtPrefixBridgeWithLayoutSlots {cfg : StateRelConfig}
    (sourceLayout fullLayout sourceLayoutAfter fullLayoutAfter : List Name)
    (program : Functions.Program) (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (sourceStmt : AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (lowerPrefix : List Functions.Stmt) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : RunState,
  ∃ ctxAfter : Locals.Ctx, ∃ targetFuel : Nat,
    EvmYul.Yul.exec sourceFuel sourceStmt codeOverride source =
      .ok sourceAfter ∧
    Functions.Direct.Block.runOpen program returns ctx targetFuel
        { stmts := lowerPrefix } compiler =
      .ok (Structured.Outcome.regular compilerAfter, ctxAfter) ∧
    ctx.layout = fullLayout ∧
    ctxAfter.layout = fullLayoutAfter ∧
    LayoutSuffix fullLayout fullLayoutAfter ∧
    CompilerStateRelWithLayoutSlots cfg sourceLayoutAfter fullLayoutAfter
      sourceAfter compilerAfter.evm ∧
    compilerAfter.returns = compiler.returns

theorem regularPrefix_block_nil_bridge {cfg : StateRelConfig}
    {layout : List Name} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : RunState}
    (sourceFuel : Nat) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (codeOverride : Option AstContract)
    (hRel : CompilerStateRel cfg layout (.Ok shared store) compiler.evm) :
    RegularStmtPrefixBridge
      (cfg := cfg) layout program returns ctx sourceFuel.succ.succ
      (.Block []) codeOverride (.Ok shared store) compiler
      [Functions.Stmt.block { stmts := [] }] := by
  refine
    ⟨.Ok shared store, compiler, ctx,
      Imported.exec_block_nil_ok_succ_succ sourceFuel codeOverride shared
        store,
      ?append, hRel, rfl⟩
  intro tail
  intro tailFuel outcome runCtx hTail
  cases tailFuel with
  | zero =>
      cases tail with
      | mk tailStmts =>
          simp [Functions.Direct.Block.runOpen, Structured.invalid] at hTail
  | succ fuel =>
      have hTargetHead :
          Functions.Direct.Stmt.run program returns ctx fuel.succ
              (Functions.Stmt.block { stmts := [] }) compiler =
            .ok (Structured.Outcome.regular compiler, ctx) := by
        exact
          (functions_stmt_block_nil_bridge
            (cfg := cfg) (layout := layout) (shared := shared)
            (store := store) (compiler := compiler) sourceFuel fuel
            program returns ctx codeOverride hRel).2.1
      cases tail with
      | mk tailStmts =>
          simpa [Nat.add_comm] using
            (functions_block_cons_regular
              (rest := tailStmts) hTargetHead hTail)

theorem regularStmtPrefixBridgeExists_of_prefix {cfg : StateRelConfig}
    {layoutAfter : List Name} {program : Functions.Program}
    {returns : List Name} {ctx : Locals.Ctx}
    {sourceFuel : Nat} {sourceStmt : AstStmt}
    {codeOverride : Option AstContract} {source : State}
    {compiler : RunState} {lowerPrefix : List Functions.Stmt}
    (hPrefix :
      RegularStmtPrefixBridge (cfg := cfg) layoutAfter program returns ctx
        sourceFuel sourceStmt codeOverride source compiler lowerPrefix) :
    RegularStmtPrefixBridgeExists (cfg := cfg) layoutAfter program returns ctx
      sourceFuel sourceStmt codeOverride source compiler lowerPrefix := by
  rcases hPrefix with
    ⟨sourceAfter, compilerAfter, ctxAfter, hSource, hAppend,
      hRel, hReturns⟩
  have hTail :
      Functions.Direct.Block.runOpen program returns ctxAfter 1
          { stmts := [] } compilerAfter =
        .ok (Structured.Outcome.regular compilerAfter, ctxAfter) := by
    simp [Functions.Direct.Block.runOpen]
  refine
    ⟨sourceAfter, compilerAfter, ctxAfter, lowerPrefix.length + 1,
      hSource, ?target, hRel, hReturns⟩
  simpa using hAppend { stmts := [] } hTail

theorem regularStmtPrefixBridgeWithLayout_to_exists {cfg : StateRelConfig}
    {layout layoutAfter : List Name} {program : Functions.Program}
    {returns : List Name} {ctx : Locals.Ctx}
    {sourceFuel : Nat} {sourceStmt : AstStmt}
    {codeOverride : Option AstContract} {source : State}
    {compiler : RunState} {lowerPrefix : List Functions.Stmt}
    (hPrefix :
      RegularStmtPrefixBridgeWithLayout (cfg := cfg) layout layoutAfter
        program returns ctx sourceFuel sourceStmt codeOverride source
        compiler lowerPrefix) :
    RegularStmtPrefixBridgeExists (cfg := cfg) layoutAfter program returns ctx
      sourceFuel sourceStmt codeOverride source compiler lowerPrefix := by
  rcases hPrefix with
    ⟨sourceAfter, compilerAfter, ctxAfter, targetFuel, hSource, hTarget,
      _hCtxLayout, _hCtxAfterLayout, _hSuffix, hRel, hReturns⟩
  exact
    ⟨sourceAfter, compilerAfter, ctxAfter, targetFuel, hSource, hTarget,
      hRel, hReturns⟩

def RegularBlockRunBridge {cfg : StateRelConfig}
    (layoutAfter : List Name) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceAfter : State, ∃ compilerAfter : RunState,
  ∃ ctxAfter : Locals.Ctx, ∃ targetFuel : Nat,
    EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
      .ok sourceAfter ∧
    Functions.Direct.Block.runOpen program returns ctx targetFuel lowerBlock
        compiler =
      .ok (Structured.Outcome.regular compilerAfter, ctxAfter) ∧
    CompilerStateRel cfg layoutAfter sourceAfter compilerAfter.evm ∧
    compilerAfter.returns = compiler.returns

inductive CompilerOkOutcomeRel (cfg : StateRelConfig) (layout : List Name) :
    State → Functions.Outcome → Prop where
  | regular {source : State} {compiler : RunState}
      (hRel : CompilerStateRel cfg layout source compiler.evm) :
      CompilerOkOutcomeRel cfg layout source
        (Structured.Outcome.regular compiler)
  | brk {shared : EvmYul.SharedState .Yul}
      {store : EvmYul.Yul.VarStore} {compiler : RunState}
      (hRel : CompilerStateRel cfg layout (.Ok shared store) compiler.evm) :
      CompilerOkOutcomeRel cfg layout
        (.Checkpoint (.Break shared store))
        (Structured.Outcome.brk compiler)
  | cont {shared : EvmYul.SharedState .Yul}
      {store : EvmYul.Yul.VarStore} {compiler : RunState}
      (hRel : CompilerStateRel cfg layout (.Ok shared store) compiler.evm) :
      CompilerOkOutcomeRel cfg layout
        (.Checkpoint (.Continue shared store))
        (Structured.Outcome.cont compiler)
  | leave {shared : EvmYul.SharedState .Yul}
      {store : EvmYul.Yul.VarStore} {compiler : RunState}
      (hRel : CompilerStateRel cfg layout (.Ok shared store) compiler.evm) :
      CompilerOkOutcomeRel cfg layout
        (.Checkpoint (.Leave shared store))
        (Structured.Outcome.leave compiler)

/--
Result-shaped sibling of `CompilerOkOutcomeRel`.

The imported Yul interpreter reports EVM-level terminal effects as exceptions
(`YulHalt`/`Revert`) rather than ordinary `State` results.  Recursive bridge
drivers therefore need this relation once they leave the successful `.ok`
fragment.  Ordinary ok/checkpoint results are delegated to
`CompilerOkOutcomeRel`; terminal imported results relate to lower-layer halt
outcomes with the terminal kind supplied by the statement-specific proof.
-/
inductive CompilerResultOutcomeRel (cfg : StateRelConfig)
    (layout : List Name) :
    Except Exception State → Functions.Outcome → Prop where
  | ok {source : State} {outcome : Functions.Outcome}
      (hRel : CompilerOkOutcomeRel cfg layout source outcome) :
      CompilerResultOutcomeRel cfg layout (.ok source) outcome
  | yulHalt {source : State} {value : Word} {kind : Assembly.HaltKind}
      {compiler : RunState}
      (hRel : cfg.terminalRel kind value source compiler.evm) :
      CompilerResultOutcomeRel cfg layout
        (.error (.YulHalt source value))
        (Structured.Outcome.halt kind compiler)
  | revert {source : State} {compiler : RunState}
      (hRel : cfg.revertRel source compiler.evm) :
      CompilerResultOutcomeRel cfg layout
        (.error (.Revert source))
        (Structured.Outcome.halt .revert compiler)

inductive CompilerOkOutcomeRelWithLayoutSlots (cfg : StateRelConfig)
    (sourceLayout fullLayout : List Name) :
    State → Functions.Outcome → Prop where
  | regular {source : State} {compiler : RunState}
      (hRel :
        CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout source
          compiler.evm) :
      CompilerOkOutcomeRelWithLayoutSlots cfg sourceLayout fullLayout source
        (Structured.Outcome.regular compiler)
  | brk {shared : EvmYul.SharedState .Yul}
      {store : EvmYul.Yul.VarStore} {compiler : RunState}
      (hRel :
        CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
          (.Ok shared store) compiler.evm) :
      CompilerOkOutcomeRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Checkpoint (.Break shared store))
        (Structured.Outcome.brk compiler)
  | cont {shared : EvmYul.SharedState .Yul}
      {store : EvmYul.Yul.VarStore} {compiler : RunState}
      (hRel :
        CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
          (.Ok shared store) compiler.evm) :
      CompilerOkOutcomeRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Checkpoint (.Continue shared store))
        (Structured.Outcome.cont compiler)
  | leave {shared : EvmYul.SharedState .Yul}
      {store : EvmYul.Yul.VarStore} {compiler : RunState}
      (hRel :
        CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
          (.Ok shared store) compiler.evm) :
      CompilerOkOutcomeRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Checkpoint (.Leave shared store))
        (Structured.Outcome.leave compiler)

inductive CompilerResultOutcomeRelWithLayoutSlots (cfg : StateRelConfig)
    (sourceLayout fullLayout : List Name) :
    Except Exception State → Functions.Outcome → Prop where
  | ok {source : State} {outcome : Functions.Outcome}
      (hRel :
        CompilerOkOutcomeRelWithLayoutSlots cfg sourceLayout fullLayout
          source outcome) :
      CompilerResultOutcomeRelWithLayoutSlots cfg sourceLayout fullLayout
        (.ok source) outcome
  | yulHalt {source : State} {value : Word} {kind : Assembly.HaltKind}
      {compiler : RunState}
      (hRel : cfg.terminalRel kind value source compiler.evm) :
      CompilerResultOutcomeRelWithLayoutSlots cfg sourceLayout fullLayout
        (.error (.YulHalt source value))
        (Structured.Outcome.halt kind compiler)
  | revert {source : State} {compiler : RunState}
      (hRel : cfg.revertRel source compiler.evm) :
      CompilerResultOutcomeRelWithLayoutSlots cfg sourceLayout fullLayout
        (.error (.Revert source))
        (Structured.Outcome.halt .revert compiler)

theorem CompilerOkOutcomeRel.restrictStoreTo_of_scope_contains
    {cfg : StateRelConfig} {layout : List Name}
    {scope : EvmYul.Yul.VarStore} {source : State}
    {outcome : Functions.Outcome}
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (hScope :
      ∀ name, name ∈ layout → (scope.lookup name).isSome = true)
    (hRel : CompilerOkOutcomeRel cfg layout source outcome) :
    CompilerOkOutcomeRel cfg layout (source.restrictStoreTo scope) outcome := by
  cases hRel with
  | regular hStateRel =>
      cases hStateRel with
      | ok hShared hVars =>
          have hRestricted :
              CompilerStateRel cfg layout
                (.Ok _ (EvmYul.Yul.State.restrictVarStore _ scope)) _ :=
            CompilerStateRel.restrictVarStore_of_scope_contains
              hVarRelExact hScope (CompilerStateRel.ok hShared hVars)
          exact CompilerOkOutcomeRel.regular hRestricted
  | brk hStateRel =>
      cases hStateRel with
      | ok hShared hVars =>
          have hRestricted :
              CompilerStateRel cfg layout
                (.Ok _ (EvmYul.Yul.State.restrictVarStore _ scope)) _ :=
            CompilerStateRel.restrictVarStore_of_scope_contains
              hVarRelExact hScope (CompilerStateRel.ok hShared hVars)
          exact CompilerOkOutcomeRel.brk hRestricted
  | cont hStateRel =>
      cases hStateRel with
      | ok hShared hVars =>
          have hRestricted :
              CompilerStateRel cfg layout
                (.Ok _ (EvmYul.Yul.State.restrictVarStore _ scope)) _ :=
            CompilerStateRel.restrictVarStore_of_scope_contains
              hVarRelExact hScope (CompilerStateRel.ok hShared hVars)
          exact CompilerOkOutcomeRel.cont hRestricted
  | leave hStateRel =>
      cases hStateRel with
      | ok hShared hVars =>
          have hRestricted :
              CompilerStateRel cfg layout
                (.Ok _ (EvmYul.Yul.State.restrictVarStore _ scope)) _ :=
            CompilerStateRel.restrictVarStore_of_scope_contains
              hVarRelExact hScope (CompilerStateRel.ok hShared hVars)
          exact CompilerOkOutcomeRel.leave hRestricted

theorem CompilerOkOutcomeRel.restrictStoreTo_of_domain_exact
    {cfg : StateRelConfig} {layout : List Name}
    {scope : EvmYul.Yul.VarStore} {source : State}
    {outcome : Functions.Outcome}
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (hDomain : StoreDomainExact layout scope)
    (hRel : CompilerOkOutcomeRel cfg layout source outcome) :
    CompilerOkOutcomeRel cfg layout (source.restrictStoreTo scope) outcome :=
  CompilerOkOutcomeRel.restrictStoreTo_of_scope_contains
    hVarRelExact (fun name hMem => (hDomain name).mpr hMem) hRel

theorem CompilerResultOutcomeRel.restrictStoreTo_of_scope_contains
    {cfg : StateRelConfig} {layout : List Name}
    {scope : EvmYul.Yul.VarStore} {sourceResult : Except Exception State}
    {outcome : Functions.Outcome}
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (hScope :
      ∀ name, name ∈ layout → (scope.lookup name).isSome = true)
    (hRel : CompilerResultOutcomeRel cfg layout sourceResult outcome) :
    CompilerResultOutcomeRel cfg layout
      (match sourceResult with
       | .ok source => .ok (source.restrictStoreTo scope)
       | .error err => .error err)
      outcome := by
  cases hRel with
  | ok hOk =>
      exact
        CompilerResultOutcomeRel.ok
          (CompilerOkOutcomeRel.restrictStoreTo_of_scope_contains
            hVarRelExact hScope hOk)
  | yulHalt hTerminal =>
      exact CompilerResultOutcomeRel.yulHalt hTerminal
  | revert hRevert =>
      exact CompilerResultOutcomeRel.revert hRevert

theorem CompilerResultOutcomeRel.restrictStoreTo_of_domain_exact
    {cfg : StateRelConfig} {layout : List Name}
    {scope : EvmYul.Yul.VarStore} {sourceResult : Except Exception State}
    {outcome : Functions.Outcome}
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (hDomain : StoreDomainExact layout scope)
    (hRel : CompilerResultOutcomeRel cfg layout sourceResult outcome) :
    CompilerResultOutcomeRel cfg layout
      (match sourceResult with
       | .ok source => .ok (source.restrictStoreTo scope)
       | .error err => .error err)
      outcome :=
  CompilerResultOutcomeRel.restrictStoreTo_of_scope_contains
    hVarRelExact (fun name hMem => (hDomain name).mpr hMem) hRel

theorem CompilerOkOutcomeRel.mode_ne_regular_of_checkpoint
    {cfg : StateRelConfig} {layout : List Name}
    {jump : EvmYul.Yul.Jump} {outcome : Functions.Outcome}
    (hRel : CompilerOkOutcomeRel cfg layout (.Checkpoint jump) outcome) :
    outcome.mode ≠ .regular := by
  cases hRel with
  | regular hStateRel =>
      cases hStateRel
  | brk hStateRel =>
      simp [Structured.Outcome.brk]
  | cont hStateRel =>
      simp [Structured.Outcome.cont]
  | leave hStateRel =>
      simp [Structured.Outcome.leave]

theorem CompilerResultOutcomeRel.mode_ne_regular_of_checkpoint
    {cfg : StateRelConfig} {layout : List Name}
    {jump : EvmYul.Yul.Jump} {outcome : Functions.Outcome}
    (hRel :
      CompilerResultOutcomeRel cfg layout (.ok (.Checkpoint jump)) outcome) :
    outcome.mode ≠ .regular := by
  cases hRel with
  | ok hOk =>
      exact CompilerOkOutcomeRel.mode_ne_regular_of_checkpoint hOk

theorem CompilerResultOutcomeRel.mode_ne_regular_of_error
    {cfg : StateRelConfig} {layout : List Name}
    {err : Exception} {outcome : Functions.Outcome}
    (hRel : CompilerResultOutcomeRel cfg layout (.error err) outcome) :
    outcome.mode ≠ .regular := by
  cases hRel with
  | yulHalt hTerminal =>
      simp [Structured.Outcome.halt]
  | revert hRevert =>
      simp [Structured.Outcome.halt]

theorem CompilerOkOutcomeRelWithLayoutSlots.mode_ne_regular_of_checkpoint
    {cfg : StateRelConfig} {sourceLayout fullLayout : List Name}
    {jump : EvmYul.Yul.Jump} {outcome : Functions.Outcome}
    (hRel :
      CompilerOkOutcomeRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Checkpoint jump) outcome) :
    outcome.mode ≠ .regular := by
  cases hRel with
  | regular hStateRel =>
      cases hStateRel
  | brk hStateRel =>
      simp [Structured.Outcome.brk]
  | cont hStateRel =>
      simp [Structured.Outcome.cont]
  | leave hStateRel =>
      simp [Structured.Outcome.leave]

theorem CompilerResultOutcomeRelWithLayoutSlots.mode_ne_regular_of_checkpoint
    {cfg : StateRelConfig} {sourceLayout fullLayout : List Name}
    {jump : EvmYul.Yul.Jump} {outcome : Functions.Outcome}
    (hRel :
      CompilerResultOutcomeRelWithLayoutSlots cfg sourceLayout fullLayout
        (.ok (.Checkpoint jump)) outcome) :
    outcome.mode ≠ .regular := by
  cases hRel with
  | ok hOk =>
      exact
        CompilerOkOutcomeRelWithLayoutSlots.mode_ne_regular_of_checkpoint hOk

theorem CompilerResultOutcomeRelWithLayoutSlots.mode_ne_regular_of_error
    {cfg : StateRelConfig} {sourceLayout fullLayout : List Name}
    {err : Exception} {outcome : Functions.Outcome}
    (hRel :
      CompilerResultOutcomeRelWithLayoutSlots cfg sourceLayout fullLayout
        (.error err) outcome) :
    outcome.mode ≠ .regular := by
  cases hRel with
  | yulHalt hTerminal =>
      simp [Structured.Outcome.halt]
  | revert hRevert =>
      simp [Structured.Outcome.halt]

theorem VisibleVarSlotRel.restrictVarStore_of_scope_contains
    {sourceLayout fullLayout : List Name}
    {store scope : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    (hRel : VisibleVarSlotRel sourceLayout fullLayout store stack)
    (hScope :
      ∀ name, name ∈ sourceLayout → (scope.lookup name).isSome = true) :
    VisibleVarSlotRel sourceLayout fullLayout
      (EvmYul.Yul.State.restrictVarStore store scope) stack := by
  intro sourceIdx sourceName hSourceName
  rcases hRel hSourceName with
    ⟨fullIdx, value, hFullName, hStack, hLookup⟩
  have hSourceMem : sourceName ∈ sourceLayout :=
    List.mem_of_getElem? hSourceName
  have hScopeSome : (scope.lookup sourceName).isSome = true :=
    hScope sourceName hSourceMem
  cases hScopeLookup : scope.lookup sourceName with
  | none =>
      simp [hScopeLookup] at hScopeSome
  | some scopeValue =>
      have hLookupRestricted :
          (EvmYul.Yul.State.restrictVarStore store scope).lookup sourceName =
            some value := by
        rw [FinmapFacts.lookup_restrictVarStore_of_scope_some
          store scope sourceName hScopeLookup]
        exact hLookup
      exact ⟨fullIdx, value, hFullName, hStack, hLookupRestricted⟩

theorem CompilerStateRelWithLayoutSlots.restrictVarStore_of_scope_contains
    {cfg : StateRelConfig} {sourceLayout fullLayout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store scope : EvmYul.Yul.VarStore} {compiler : EVMState}
    (hScope :
      ∀ name, name ∈ sourceLayout → (scope.lookup name).isSome = true)
    (hRel :
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Ok shared store) compiler) :
    CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
      (.Ok shared (EvmYul.Yul.State.restrictVarStore store scope))
      compiler := by
  cases hRel with
  | ok hShared hVars hCover =>
      exact
        CompilerStateRelWithLayoutSlots.ok hShared
          (VisibleVarSlotRel.restrictVarStore_of_scope_contains hVars hScope)
          hCover

theorem CompilerOkOutcomeRelWithLayoutSlots.restrictStoreTo_of_scope_contains
    {cfg : StateRelConfig} {sourceLayout fullLayout : List Name}
    {scope : EvmYul.Yul.VarStore} {source : State}
    {outcome : Functions.Outcome}
    (hScope :
      ∀ name, name ∈ sourceLayout → (scope.lookup name).isSome = true)
    (hRel :
      CompilerOkOutcomeRelWithLayoutSlots cfg sourceLayout fullLayout source
        outcome) :
    CompilerOkOutcomeRelWithLayoutSlots cfg sourceLayout fullLayout
      (source.restrictStoreTo scope) outcome := by
  cases hRel with
  | regular hStateRel =>
      cases hStateRel with
      | ok hShared hVars hCover =>
          exact
            CompilerOkOutcomeRelWithLayoutSlots.regular
              (CompilerStateRelWithLayoutSlots.ok hShared
                (VisibleVarSlotRel.restrictVarStore_of_scope_contains
                  hVars hScope)
                hCover)
  | brk hStateRel =>
      cases hStateRel with
      | ok hShared hVars hCover =>
          exact
            CompilerOkOutcomeRelWithLayoutSlots.brk
              (CompilerStateRelWithLayoutSlots.ok hShared
                (VisibleVarSlotRel.restrictVarStore_of_scope_contains
                  hVars hScope)
                hCover)
  | cont hStateRel =>
      cases hStateRel with
      | ok hShared hVars hCover =>
          exact
            CompilerOkOutcomeRelWithLayoutSlots.cont
              (CompilerStateRelWithLayoutSlots.ok hShared
                (VisibleVarSlotRel.restrictVarStore_of_scope_contains
                  hVars hScope)
                hCover)
  | leave hStateRel =>
      cases hStateRel with
      | ok hShared hVars hCover =>
          exact
            CompilerOkOutcomeRelWithLayoutSlots.leave
              (CompilerStateRelWithLayoutSlots.ok hShared
                (VisibleVarSlotRel.restrictVarStore_of_scope_contains
                  hVars hScope)
                hCover)

theorem CompilerResultOutcomeRelWithLayoutSlots.restrictStoreTo_of_scope_contains
    {cfg : StateRelConfig} {sourceLayout fullLayout : List Name}
    {scope : EvmYul.Yul.VarStore}
    {sourceResult : Except Exception State} {outcome : Functions.Outcome}
    (hScope :
      ∀ name, name ∈ sourceLayout → (scope.lookup name).isSome = true)
    (hRel :
      CompilerResultOutcomeRelWithLayoutSlots cfg sourceLayout fullLayout
        sourceResult outcome) :
    CompilerResultOutcomeRelWithLayoutSlots cfg sourceLayout fullLayout
      (match sourceResult with
       | .ok source => .ok (source.restrictStoreTo scope)
       | .error err => .error err)
      outcome := by
  cases hRel with
  | ok hOk =>
      exact
        CompilerResultOutcomeRelWithLayoutSlots.ok
          (CompilerOkOutcomeRelWithLayoutSlots.restrictStoreTo_of_scope_contains
            hScope hOk)
  | yulHalt hTerminal =>
      exact CompilerResultOutcomeRelWithLayoutSlots.yulHalt hTerminal
  | revert hRevert =>
      exact CompilerResultOutcomeRelWithLayoutSlots.revert hRevert

/--
Statement-pushed bridge for imported statements whose head produces an
exception result, including terminal Yul halts and reverts.

The target-side continuation is quantified over arbitrary tails: once the
compiled pushed reaches a nonregular outcome, `Block.runOpen` must ignore the
tail exactly as imported `execSeq` ignores the remaining statements after an
error-producing head.
-/
def ErrorStmtPrefixBridge {cfg : StateRelConfig}
    (layoutAfter : List Name) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (sourceStmt : AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (lowerPrefix : List Functions.Stmt) :
    Prop :=
  ∃ err : Exception, ∃ outcome : Functions.Outcome,
  ∃ ctxAfter : Locals.Ctx,
    EvmYul.Yul.exec sourceFuel sourceStmt codeOverride source =
      .error err ∧
    (∀ (tail : Functions.Block),
      ∃ targetFuel : Nat,
        Functions.Direct.Block.runOpen program returns ctx targetFuel
            { stmts := lowerPrefix ++ tail.stmts } compiler =
          .ok (outcome, ctxAfter)) ∧
    CompilerResultOutcomeRel cfg layoutAfter (.error err) outcome ∧
    outcome.state.returns = compiler.returns ∧
    outcome.mode ≠ .regular

def NonregularStmtPrefixBridge {cfg : StateRelConfig}
    (layoutAfter : List Name) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (sourceStmt : AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (lowerPrefix : List Functions.Stmt) :
    Prop :=
  ∃ sourceResult : Except Exception State, ∃ outcome : Functions.Outcome,
  ∃ ctxAfter : Locals.Ctx,
    EvmYul.Yul.exec sourceFuel sourceStmt codeOverride source =
      sourceResult ∧
    (∀ (tail : Functions.Block),
      ∃ targetFuel : Nat,
        Functions.Direct.Block.runOpen program returns ctx targetFuel
            { stmts := lowerPrefix ++ tail.stmts } compiler =
          .ok (outcome, ctxAfter)) ∧
    CompilerResultOutcomeRel cfg layoutAfter sourceResult outcome ∧
    outcome.state.returns = compiler.returns ∧
    outcome.mode ≠ .regular

theorem nonregularStmtPrefix_of_errorPrefix {cfg : StateRelConfig}
    {layoutAfter : List Name} {program : Functions.Program}
    {returns : List Name} {ctx : Locals.Ctx}
    {sourceFuel : Nat} {sourceStmt : AstStmt}
    {codeOverride : Option AstContract} {source : State}
    {compiler : RunState} {lowerPrefix : List Functions.Stmt}
    (hPrefix :
      ErrorStmtPrefixBridge (cfg := cfg) layoutAfter program returns ctx
        sourceFuel sourceStmt codeOverride source compiler lowerPrefix) :
    NonregularStmtPrefixBridge (cfg := cfg) layoutAfter program returns ctx
      sourceFuel sourceStmt codeOverride source compiler lowerPrefix := by
  rcases hPrefix with
    ⟨err, outcome, ctxAfter, hSource, hTarget, hRel, hReturns,
      hNonregular⟩
  exact
    ⟨.error err, outcome, ctxAfter, hSource, hTarget, hRel, hReturns,
      hNonregular⟩

def OkBlockRunBridge {cfg : StateRelConfig}
    (layoutAfter : List Name) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)

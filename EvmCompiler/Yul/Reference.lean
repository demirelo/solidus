        names.reverse ++ hiddenLayout ++ sourceLayout ∧
      compiler'.returns = compiler.returns ∧
      ∀ (tail : Functions.Block) {tailFuel : Nat}
        {outcome : Functions.Outcome} {runCtx : Locals.Ctx},
        Functions.Direct.Block.runOpen program returns
            (ctx.withLayout (names.reverse ++ ctx.layout)) tailFuel tail
            compiler' =
          .ok (outcome, runCtx) →
        Functions.Direct.Block.runOpen program returns ctx
            (names.length + tailFuel)
            { stmts := Stmt.initNames names ++ tail.stmts } compiler =
          .ok (outcome, runCtx) := by
  cases hRel with
  | ok hShared hVars hHiddenLength hStack =>
      rename_i hiddenValues locals
      rcases
          functions_initNames_append_runOpen_stack
            (cfg := cfg) (shared := shared) program returns names ctx compiler
            hShared with
        ⟨compiler', hStackFinal, hReturns, hSharedFinal, hAppend⟩
      refine ⟨compiler', ?hRel, ?hLayout, hReturns, hAppend⟩
      · exact
          CompilerStateRelWithHiddenLocals.ok
            (hiddenValues :=
              List.replicate names.length VarStackRel.zeroWord ++
                hiddenValues)
            (locals := locals)
            hSharedFinal
            hVars
            (by simp [hHiddenLength])
            (by
              calc
                compiler'.evm.stack =
                    List.replicate names.length VarStackRel.zeroWord ++
                      compiler.evm.stack := hStackFinal
                _ =
                    List.replicate names.length VarStackRel.zeroWord ++
                      (hiddenValues ++ locals) := by simp [hStack]
                _ =
                    (List.replicate names.length VarStackRel.zeroWord ++
                        hiddenValues) ++ locals := by
                      simp [List.append_assoc])
      · simp [Locals.Ctx.withLayout, hCtxLayout, List.append_assoc]

theorem functions_stmt_let_var_single_bridge {cfg : StateRelConfig}
    {layout : List Name} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : RunState}
    (sourceFuel targetFuel : Nat) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (name source : EvmYul.Identifier)
    (codeOverride : Option AstContract) {idx : Nat}
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hCheck :
      EvmYul.Yul.checkDeclaration (.Ok shared store) [name] = .ok ())
    (hSource : layout[idx]? = some (identName source))
    (hBound : idx + 1 ≤ 16)
    (hFresh : identName name ∉ layout)
    (hRel : CompilerStateRel cfg layout (.Ok shared store) compiler.evm) :
    ∃ value : Word, ∃ compiler',
      EvmYul.Yul.exec sourceFuel.succ.succ
          (.Let [name] (some (.Var source)))
          codeOverride (.Ok shared store) =
        .ok (.Ok shared (store.insert (identName name) value)) ∧
      Functions.Direct.Stmt.run program returns ctx targetFuel
          (.let_ (identName name) (.var (identName source))) compiler =
        .ok (Structured.Outcome.regular compiler',
          ctx.withLayout (identName name :: ctx.layout)) ∧
      CompilerStateRel cfg (identName name :: layout)
        (.Ok shared (store.insert (identName name) value))
        compiler'.evm ∧
      compiler'.returns = compiler.returns := by
  rcases
    eval_var_compiler_push_temp
      (cfg := cfg) (layout := layout) sourceFuel source codeOverride ctx
      hVarRelExact hCtxLayout hNoDup hSource hBound hRel with
    ⟨value, compilerEVM', hEval, hRunCode, hTemps⟩
  let compiler' := compiler.withEVM compilerEVM'
  refine ⟨value, compiler', ?hSourceExec, ?hTarget, ?hRel, ?hReturns⟩
  · rw [Imported.exec_let_var_succ]
    have hEvalValues :
        EvmYul.Yul.evalValues sourceFuel.succ (.Var source) codeOverride
            (.Ok shared store) =
          .ok (.Ok shared store, [value]) := by
      have hEval' := hEval
      rw [Imported.eval_var_succ] at hEval'
      cases hLookup :
          EvmYul.Yul.State.lookup? source (.Ok shared store) with
      | none =>
          simp [hLookup] at hEval'
      | some value0 =>
          simp [hLookup] at hEval'
          cases hEval'
          simp [EvmYul.Yul.evalValues, hLookup]
    simp [hCheck, hEvalValues, identName, EvmYul.Yul.multifill',
      EvmYul.Yul.State.multifill, EvmYul.Yul.State.insert]
  · have hRunState :
        Locals.Direct.Expr.runState ctx (.var (identName source)) compiler =
          .ok compiler' := by
      unfold Locals.Direct.Expr.runState compiler'
      simp [hRunCode]
    simp [Functions.Direct.Stmt.run, hRunState]
  · exact
      CompilerStateRelWithTemps.bindSingleExact
        hVarRelExact hFresh hTemps
  · simp [compiler']

theorem functions_stmt_let_var_layout_slots_bridge {cfg : StateRelConfig}
    {sourceLayout fullLayout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : RunState}
    (sourceFuel targetFuel : Nat) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (name source : EvmYul.Identifier)
    (codeOverride : Option AstContract) {sourceIdx : Nat}
    (hCtxLayout : ctx.layout = fullLayout)
    (hNoDup : fullLayout.Nodup)
    (hCheck :
      EvmYul.Yul.checkDeclaration (.Ok shared store) [name] = .ok ())
    (hSource : sourceLayout[sourceIdx]? = some (identName source))
    (hBound :
      ∀ {fullIdx : Nat},
        fullLayout[fullIdx]? = some (identName source) →
          fullIdx + 1 ≤ 16)
    (hFresh : identName name ∉ sourceLayout)
    (hRel :
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Ok shared store) compiler.evm) :
    ∃ value : Word, ∃ compiler',
      EvmYul.Yul.exec sourceFuel.succ.succ
          (.Let [name] (some (.Var source)))
          codeOverride (.Ok shared store) =
        .ok (.Ok shared (store.insert (identName name) value)) ∧
      Functions.Direct.Stmt.run program returns ctx targetFuel
          (.let_ (identName name) (.var (identName source))) compiler =
        .ok (Structured.Outcome.regular compiler',
          ctx.withLayout (identName name :: ctx.layout)) ∧
      CompilerStateRelWithLayoutSlots cfg
        (identName name :: sourceLayout) (identName name :: fullLayout)
        (.Ok shared (store.insert (identName name) value))
        compiler'.evm ∧
      (ctx.withLayout (identName name :: ctx.layout)).layout =
        identName name :: fullLayout ∧
      compiler'.returns = compiler.returns := by
  cases hRel with
  | ok hShared hVars hCover =>
      rcases hVars hSource with
        ⟨fullIdx, value, hFullName, hStack, hStore⟩
      let compilerEVM' :=
        compiler.evm.replaceStackAndIncrPC
          (value :: compiler.evm.stack) (pcΔ := 1)
      let compiler' := compiler.withEVM compilerEVM'
      refine ⟨value, compiler', ?hSourceExec, ?hTarget, ?hRel,
        ?hLayout, ?hReturns⟩
      · rw [Imported.exec_let_var_succ]
        have hEvalValues :
            EvmYul.Yul.evalValues sourceFuel.succ (.Var source)
                codeOverride (.Ok shared store) =
              .ok (.Ok shared store, [value]) := by
          rw [EvmYul.Yul.evalValues]
          simp [lookup?_ok (shared := shared) hStore]
        simp [hCheck, hEvalValues, identName, EvmYul.Yul.multifill',
          EvmYul.Yul.State.multifill, EvmYul.Yul.State.insert]
      · have hDepth :
            Locals.Layout.lookupDepth? (identName source) ctx.layout =
              some (fullIdx + 1) := by
          simpa [hCtxLayout] using
            (lookupDepth?_of_get?_nodup hFullName hNoDup)
        have hOne : 1 ≤ fullIdx + 1 := by
          omega
        rcases
            stackOp_dup?_step_eq_dup
              (n := fullIdx + 1) hOne (hBound hFullName) compiler.evm with
          ⟨op, hDup, hStep⟩
        have hDupValue :
            EvmYul.dup (fullIdx + 1) compiler.evm =
              .ok compilerEVM' := by
          simpa [compilerEVM'] using
            (evm_dup_succ_get?
              (state := compiler.evm) (idx := fullIdx) hStack)
        have hRunCode :
            Locals.Direct.Expr.runCode ctx 0 (.var (identName source))
                compiler.evm =
              .ok compilerEVM' := by
          simp [Locals.Direct.Expr.runCode, hDepth, hDup]
          rw [hStep, hDupValue]
        have hRunState :
            Locals.Direct.Expr.runState ctx (.var (identName source))
                compiler =
              .ok compiler' := by
          unfold Locals.Direct.Expr.runState compiler'
          simp [hRunCode]
        simp [Functions.Direct.Stmt.run, hRunState]
      · have hStack' :
            compiler'.evm.stack = value :: compiler.evm.stack := by
          simp [compiler', compilerEVM',
            EvmYul.EVM.State.replaceStackAndIncrPC,
            EvmYul.EVM.State.incrPC]
        have hShared' :
            SharedStateRel cfg shared compiler'.evm.toSharedState := by
          simpa [compiler', compilerEVM',
            EvmYul.EVM.State.replaceStackAndIncrPC,
            EvmYul.EVM.State.incrPC] using hShared
        exact
          CompilerStateRelWithLayoutSlots.cons_source_insert
            (cfg := cfg) (sourceLayout := sourceLayout)
            (fullLayout := fullLayout) (shared := shared) (store := store)
            (compiler := compiler.evm) (compiler' := compiler'.evm)
            (name := identName name) (value := value)
            hFresh hStack' hShared'
            (CompilerStateRelWithLayoutSlots.ok hShared hVars hCover)
      · simp [Locals.Ctx.withLayout, hCtxLayout]
      · simp [compiler']

theorem exec_assign_lit_single_ok
    (fuel : Nat) (name : EvmYul.Identifier) (value : Word)
    (codeOverride : Option AstContract)
    (shared : EvmYul.SharedState .Yul) (store : EvmYul.Yul.VarStore)
    (hCheck :
      EvmYul.Yul.checkAssignment (.Ok shared store) [name] = .ok ()) :
    EvmYul.Yul.exec fuel.succ.succ (.Assign [name] (.Lit value))
        codeOverride (.Ok shared store) =
      .ok (.Ok shared (store.insert (identName name) value)) := by
  rw [Imported.exec_assign_succ]
  have hEvalValues :
      EvmYul.Yul.evalValues fuel.succ (.Lit value) codeOverride
          (.Ok shared store) =
        .ok (.Ok shared store, [value]) := by
    simp [EvmYul.Yul.evalValues, Imported.eval_lit_succ]
  simp [hCheck, hEvalValues, identName, EvmYul.Yul.multifill',
    EvmYul.Yul.State.multifill, EvmYul.Yul.State.insert]

theorem exec_assign_var_single_ok {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    (fuel : Nat) (name source : EvmYul.Identifier)
    (codeOverride : Option AstContract)
    (shared : EvmYul.SharedState .Yul)
    (hCheck :
      EvmYul.Yul.checkAssignment (.Ok shared store) [name] = .ok ())
    {idx : Nat}
    (hSource : layout[idx]? = some (identName source))
    (hRel : ExactVarStackRel layout store stack) :
    ∃ value,
      EvmYul.Yul.exec fuel.succ.succ (.Assign [name] (.Var source))
          codeOverride (.Ok shared store) =
        .ok (.Ok shared (store.insert (identName name) value)) ∧
      stack[idx]? = some value := by

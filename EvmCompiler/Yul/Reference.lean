theorem sourceNonregularBlockRunAt_of_resultSeqRunAt_checkpoint
    {cfg : StateRelConfig} {layout ctxAfterLayout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel targetFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract}
    {shared : EvmYul.SharedState .Yul} {scope : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State} {lowerBlock : Functions.Block}
    {jump : EvmYul.Yul.Jump}
    (hScope :
      ∀ name, name ∈ outcomeLayout → (scope.lookup name).isSome = true)
    (hSourceCheckpoint :
      EvmYul.Yul.exec sourceFuel.succ (.Block sourceStmts) codeOverride
          (.Ok shared scope) =
        .ok (.Checkpoint jump))
    (hOpen :
      SourceResultSeqRunAt cfg layout ctxAfterLayout outcomeLayout
        terminalRel revertRel prim program ctx sourceFuel targetFuel
        sourceStmts codeOverride (.Ok shared scope) compiler lowerBlock) :
    SourceNonregularBlockRunAt cfg outcomeLayout terminalRel revertRel prim
      program ctx sourceFuel.succ targetFuel sourceStmts codeOverride
      (.Ok shared scope) compiler lowerBlock := by
  rcases hOpen with
    ⟨sourceResult, sourceOutcome, ctxAfter, hSourceSeq, hTargetOpen,
      _hCtxScope, _hCtxAfterScope, _hSubset, hRel⟩
  cases sourceResult with
  | ok sourceAfter =>
      have hBlockResult :
          (Except.ok (sourceAfter.restrictStoreTo scope) :
              Except Exception State) =
            Except.ok (.Checkpoint jump) := by
        simpa [EvmYul.Yul.exec, EvmYul.Yul.State.store, hSourceSeq] using
          hSourceCheckpoint
      have hRelRestricted :
          SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
            (Except.ok (sourceAfter.restrictStoreTo scope)) sourceOutcome := by
        simpa using
          (SourceResultOutcomeRel.restrictStoreTo_of_scope_contains
            hScope hRel)
      have hRelBlock :
          SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
            (.ok (.Checkpoint jump)) sourceOutcome := by
        simpa [hBlockResult] using hRelRestricted
      have hMode :
          sourceOutcome.mode ≠ Locals.Source.Mode.regular :=
        SourceResultOutcomeRel.mode_ne_regular_of_checkpoint hRelBlock
      have hTargetScoped :
          Functions.Source.Block.runScoped prim program ctx lowerBlock
              targetFuel compiler =
            .ok sourceOutcome := by
        unfold Functions.Source.Block.runScoped
        rw [hTargetOpen]
        cases hModeCase : sourceOutcome.mode with
        | regular =>
            exact False.elim (hMode hModeCase)
        | brk =>
            simp [hModeCase]
        | cont =>
            simp [hModeCase]
        | leave =>
            simp [hModeCase]
        | halt kind =>
            simp [hModeCase]
      exact
        ⟨.ok (.Checkpoint jump), sourceOutcome, hSourceCheckpoint,
          hTargetScoped, hRelBlock, hMode⟩
  | error err =>
      have hImpossible :
          (Except.error err : Except Exception State) =
            Except.ok (.Checkpoint jump) := by
        simpa [EvmYul.Yul.exec, EvmYul.Yul.State.store, hSourceSeq] using
          hSourceCheckpoint
      cases hImpossible


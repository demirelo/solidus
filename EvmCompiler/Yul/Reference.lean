theorem lookup_ok {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {name : Name} {value : Word}
    (hLookup : store.lookup name = some value) :
    EvmYul.Yul.State.lookup! name (.Ok shared store) = value := by
  change (store.lookup name).get! = value
  rw [hLookup]
  rfl

theorem getElem!_ok {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {name : EvmYul.Identifier}
    {value : Word}
    (hLookup : store.lookup (identName name) = some value) :
    (EvmYul.Yul.State.Ok shared store)[name]! = value := by
  have hLookupName : store.lookup name = some value := by
    simpa [identName] using hLookup
  have hNameMemStore : name ∈ store :=
    Finmap.mem_of_lookup_eq_some hLookupName
  have hNameMemState :
      name ∈ (EvmYul.Yul.State.Ok shared store).store := by
    simpa [EvmYul.Yul.State.store] using hNameMemStore
  calc
    (EvmYul.Yul.State.Ok shared store)[name]! =
        (EvmYul.Yul.State.Ok shared store)[name]'hNameMemState := by
          exact getElem!_pos
            (c := EvmYul.Yul.State.Ok shared store)
            (i := name) hNameMemState
    _ = EvmYul.Yul.State.lookup! name
        (EvmYul.Yul.State.Ok shared store) := rfl
    _ = value := lookup_ok hLookupName

theorem lookup?_ok {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {name : EvmYul.Identifier}
    {value : Word}
    (hLookup : store.lookup (identName name) = some value) :
    EvmYul.Yul.State.lookup? name (.Ok shared store) = some value := by
  simpa [EvmYul.Yul.State.lookup?, identName] using hLookup

theorem eval_var_exact {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    (fuel : Nat) (name : EvmYul.Identifier)
    (codeOverride : Option AstContract)
    (shared : EvmYul.SharedState .Yul)
    {idx : Nat}
    (hName : layout[idx]? = some (identName name))
    (hRel : ExactVarStackRel layout store stack) :
    ∃ value,
      EvmYul.Yul.eval fuel.succ (.Var name) codeOverride
          (.Ok shared store) =
        .ok (.Ok shared store, value) ∧
      stack[idx]? = some value := by
  rcases ExactVarStackRel.get? hRel hName with
    ⟨value, hStack, hStore⟩
  refine ⟨value, ?_, hStack⟩
  rw [Imported.eval_var_succ]
  simp [lookup?_ok (shared := shared) hStore]

theorem eval_var_compiler_push_temp {cfg : StateRelConfig}
    {layout : List Name} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : EVMState}
    (fuel : Nat) (name : EvmYul.Identifier)
    (codeOverride : Option AstContract) (ctx : Locals.Ctx)
    {idx : Nat}
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hName : layout[idx]? = some (identName name))
    (hBound : idx + 1 ≤ 16)
    (hRel : CompilerStateRel cfg layout (.Ok shared store) compiler) :
    ∃ value compiler',
      EvmYul.Yul.eval fuel.succ (.Var name) codeOverride
          (.Ok shared store) =
        .ok (.Ok shared store, value) ∧
      Locals.Direct.Expr.runCode ctx 0 (.var (identName name)) compiler =
        .ok compiler' ∧
      CompilerStateRelWithTemps cfg layout [value] (.Ok shared store)
        compiler' := by
  cases hRel with
  | ok hShared hVars =>
      have hVarsExact :
          ExactVarStackRel layout store compiler.stack := by
        simpa [hVarRelExact] using hVars
      rcases ExactVarStackRel.get? hVarsExact hName with
        ⟨value, hStack, hStore⟩
      let compiler' := compiler.replaceStackAndIncrPC
        (value :: compiler.stack)
      refine ⟨value, compiler', ?hEval, ?hRun, ?hRel⟩
      · rw [Imported.eval_var_succ]
        simp [lookup?_ok (shared := shared) hStore]
      · have hDepth :
            Locals.Layout.lookupDepth? (identName name) ctx.layout =
              some (idx + 1) := by
          simpa [hCtxLayout] using
            (lookupDepth?_of_get?_nodup hName hNoDup)
        rcases
          stackOp_dup?_step_eq_dup
            (n := idx + 1) (by omega) hBound compiler with
          ⟨op, hDup, hStep⟩
        simp [Locals.Direct.Expr.runCode, hDepth, hDup]
        rw [hStep, evm_dup_succ_get? hStack]
      · exact CompilerStateRelWithTemps.ok hShared hVars
          (by
            simp [compiler', EvmYul.EVM.State.replaceStackAndIncrPC,
              EvmYul.EVM.State.incrPC])


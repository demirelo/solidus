    ∀ {source compiler sourceResult},
      SourceStateExactRel cfg layout source compiler →
      allowed sourceResult →
      EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
        sourceResult →
      ∃ sourceOutcome : Objects.Source.Outcome,
      ∃ ctxAfter : Functions.Source.Ctx,

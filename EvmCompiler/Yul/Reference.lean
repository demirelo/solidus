    (program : Program) (sourceFuel : Nat)
    (allowed : Except Exception State → Prop) :
    Prop :=
  ∀ {freshState'},
    Stmt.toFunctionsList?
        (Fresh.initial (Contract.names program.contract))
        program.contract.dispatcher =
      some (functionProgram.body.stmts, freshState') →
    SourceResultBlockSoundWhen cfg layout terminalRel revertRel prim
      functionProgram Functions.Source.Ctx.initial sourceFuel
      [program.contract.dispatcher] (some program.contract)
      functionProgram.body allowed


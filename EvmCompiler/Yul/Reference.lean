theorem lookupDepthFrom_of_get?_nodup {layout : List Name} {name : Name}
    {idx depth : Nat}
    (hGet : layout[idx]? = some name)
    (hNoDup : layout.Nodup) :
    Locals.Layout.lookupDepthFrom name depth layout =
      some (depth + idx) := by
  revert idx depth
  induction layout with
  | nil =>
      intro idx depth hGet
      cases idx <;> simp at hGet
  | cons head tail ih =>
      intro idx depth hGet
      cases idx with
      | zero =>
          simp at hGet
          subst name
          simp [Locals.Layout.lookupDepthFrom]
      | succ idx =>
          have hTailGet : tail[idx]? = some name := by
            simpa using hGet
          have hTailNoDup : tail.Nodup :=
            (List.nodup_cons.mp hNoDup).2
          have hHeadNe : head ≠ name := by
            intro hEq
            have hNameMemTail : name ∈ tail :=
              List.mem_of_getElem? hTailGet
            have hHeadNotMemTail : head ∉ tail :=
              (List.nodup_cons.mp hNoDup).1
            exact hHeadNotMemTail (by simpa [hEq] using hNameMemTail)
          have hIH := ih hTailNoDup hTailGet (depth := depth + 1)
          simp [Locals.Layout.lookupDepthFrom, hHeadNe]
          simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hIH

theorem lookupDepth?_of_get?_nodup {layout : List Name} {name : Name}
    {idx : Nat}
    (hGet : layout[idx]? = some name)
    (hNoDup : layout.Nodup) :
    Locals.Layout.lookupDepth? name layout = some (idx + 1) := by
  have hDepth :=
    lookupDepthFrom_of_get?_nodup
      (layout := layout) (name := name) (idx := idx) (depth := 1)
      hGet hNoDup
  simpa [Locals.Layout.lookupDepth?, Nat.add_comm] using hDepth

theorem evm_dup_succ_get? {state : EVMState} {idx : Nat}
    {value : Word}
    (hStack : state.stack[idx]? = some value) :
    EvmYul.dup (idx + 1) state =
      .ok (state.replaceStackAndIncrPC (value :: state.stack)) := by
  have hLt : idx < state.stack.length := by
    rcases (List.getElem?_eq_some_iff.mp hStack) with ⟨hLt, _hValue⟩
    exact hLt
  have hLe : idx + 1 ≤ state.stack.length := by
    omega
  have hLen : (state.stack.take (idx + 1)).length = idx + 1 := by
    simp [List.length_take, Nat.min_eq_left hLe]
  have hLast? : (state.stack.take (idx + 1)).getLast? = some value := by
    rw [List.getLast?_take]
    simp [hStack]
  simp [EvmYul.dup, hLen, hLast?]

theorem list_eq_take_getElem?_drop {α : Type} {xs : List α}
    {idx : Nat} {value : α}
    (hGet : xs[idx]? = some value) :
    xs = xs.take idx ++ value :: xs.drop (idx + 1) := by
  rcases List.getElem?_eq_some_iff.mp hGet with ⟨hLt, hValue⟩
  have hDrop :
      xs.drop idx = value :: xs.drop (idx + 1) := by
    rw [List.drop_eq_getElem_cons hLt, hValue]
  calc
    xs = xs.take idx ++ xs.drop idx := by
      exact (List.take_append_drop idx xs).symm
    _ = xs.take idx ++ value :: xs.drop (idx + 1) := by
      rw [hDrop]

theorem getElem?_append_right_add {α : Type} (left right : List α)
    (idx : Nat) :
    (left ++ right)[left.length + idx]? = right[idx]? := by
  rw [List.getElem?_append_right (by omega)]
  simp

theorem getElem?_replace_same {α : Type} {xs : List α}
    {idx : Nat} {old value : α}
    (hGet : xs[idx]? = some old) :
    (xs.take idx ++ value :: xs.drop (idx + 1))[idx]? =
      some value := by
  rcases List.getElem?_eq_some_iff.mp hGet with ⟨hLt, _hValue⟩
  have hSet := List.set_eq_take_cons_drop value hLt
  rw [← hSet]
  rw [List.getElem?_set]
  simp [hLt]

theorem getElem?_replace_ne {α : Type} {xs : List α}
    {idx j : Nat} {old value atValue : α}
    (hGetIdx : xs[idx]? = some old)
    (hGetJ : xs[j]? = some atValue)
    (hNe : j ≠ idx) :
    (xs.take idx ++ value :: xs.drop (idx + 1))[j]? =
      some atValue := by
  rcases List.getElem?_eq_some_iff.mp hGetIdx with ⟨hLt, _hValue⟩
  have hSet := List.set_eq_take_cons_drop value hLt
  have hNe' : idx ≠ j := by
    intro hEq
    exact hNe hEq.symm
  rw [← hSet]
  rw [List.getElem?_set]
  simp [hNe', hGetJ]

theorem getElem?_eq_index_of_nodup {α : Type} {xs : List α}
    {i j : Nat} {value : α}
    (hNoDup : xs.Nodup)
    (hi : xs[i]? = some value)
    (hj : xs[j]? = some value) :
    i = j := by
  rcases List.getElem?_eq_some_iff.mp hi with ⟨hiLt, hiValue⟩
  rcases List.getElem?_eq_some_iff.mp hj with ⟨hjLt, hjValue⟩
  exact
    (List.Nodup.getElem_inj_iff hNoDup).mp
      (by rw [hiValue, hjValue])

theorem lookup_insertPairs_preserve {pairs : List (Name × Word)}
    {store : EvmYul.Yul.VarStore} {name : Name}
    (hFresh :
      ∀ pairName, pairName ∈ pairs.map Prod.fst → name ≠ pairName) :
    (VarStackRel.insertPairs pairs store).lookup name =
      store.lookup name := by
  induction pairs generalizing store with
  | nil =>
      simp [VarStackRel.insertPairs]
  | cons pair rest ih =>
      cases pair with
      | mk pairName pairValue =>
          have hRest :
              ∀ restName, restName ∈ rest.map Prod.fst →
                name ≠ restName := by
            intro restName hMem
            exact hFresh restName (by simp [hMem])
          have hHead : name ≠ pairName := hFresh pairName (by simp)
          simp [VarStackRel.insertPairs]
          rw [Finmap.lookup_insert_of_ne]
          · exact ih hRest
          · exact hHead

theorem VisibleVarSlotRel.of_exact {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    (hExact : ExactVarStackRel layout store stack) :
    VisibleVarSlotRel layout layout store stack := by
  intro idx name hName
  rcases ExactVarStackRel.get? hExact hName with
    ⟨value, hStack, hStore⟩
  exact ⟨idx, value, hName, hStack, hStore⟩

theorem VisibleVarSlotRel.to_exact_of_same {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    (hNoDup : layout.Nodup)
    (hLen : stack.length = layout.length)
    (hRel : VisibleVarSlotRel layout layout store stack) :
    ExactVarStackRel layout store stack := by
  induction layout generalizing stack with
  | nil =>
      cases stack with
      | nil =>
          exact ExactVarStackRel.nil store
      | cons head tail =>
          simp at hLen
  | cons head tail ih =>
      cases stack with
      | nil =>
          simp at hLen
      | cons stackHead stackTail =>
          cases hNoDup with
          | cons hHeadFresh hTailNoDup =>
              have hHeadNotMem : head ∉ tail := by
                intro hMem
                exact hHeadFresh head hMem rfl
              have hNoDupAll : (head :: tail).Nodup :=
                List.Nodup.cons hHeadNotMem hTailNoDup
              have hHeadName : (head :: tail)[0]? = some head := by simp
              rcases hRel hHeadName with
                ⟨fullIdx, value, hFullName, hStack, hStore⟩
              have hFullIdx : fullIdx = 0 :=
                getElem?_eq_index_of_nodup hNoDupAll hFullName hHeadName
              subst fullIdx
              simp at hStack
              cases hStack
              refine ExactVarStackRel.cons hStore ?tailExact
              have hLenTail : stackTail.length = tail.length := by
                simpa using hLen
              have hTailRel :
                  VisibleVarSlotRel tail tail store stackTail := by
                intro idx name hName
                have hSourceName :
                    (head :: tail)[idx.succ]? = some name := by
                  simpa using hName
                rcases hRel hSourceName with
                  ⟨fullIdx, value, hFullName, hStackAt, hStoreAt⟩
                have hFullIdx : fullIdx = idx.succ :=
                  getElem?_eq_index_of_nodup hNoDupAll hFullName hSourceName
                subst fullIdx
                exact
                  ⟨idx, value, hName, by simpa using hStackAt, hStoreAt⟩
              exact ih hTailNoDup hLenTail hTailRel

theorem CompilerStateRelWithLayoutSlots.toCompilerStateRel_of_same
    {cfg : StateRelConfig} {layout : List Name}
    {source : State} {compiler : EVMState}
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (hNoDup : layout.Nodup)
    (hStackLength : compiler.stack.length = layout.length)
    (hRel :
      CompilerStateRelWithLayoutSlots cfg layout layout source compiler) :
    CompilerStateRel cfg layout source compiler := by
  cases hRel with
  | ok hShared hVars _hCover =>
      exact
        CompilerStateRel.ok hShared
          (by
            simpa [hVarRelExact] using
              (VisibleVarSlotRel.to_exact_of_same hNoDup hStackLength hVars))

theorem VisibleVarSlotRel.of_exact_hidden_prefix
    {sourceLayout hiddenLayout : List Name}
    {store : EvmYul.Yul.VarStore}
    {stack hiddenValues locals : EvmYul.Stack Word}
    (hExact : ExactVarStackRel sourceLayout store locals)
    (hHiddenLength : hiddenValues.length = hiddenLayout.length)
    (hStack : stack = hiddenValues ++ locals) :
    VisibleVarSlotRel sourceLayout (hiddenLayout ++ sourceLayout) store
      stack := by
  intro sourceIdx name hName
  rcases ExactVarStackRel.get? hExact hName with
    ⟨value, hLocalStack, hStore⟩
  refine ⟨hiddenLayout.length + sourceIdx, value, ?hFull, ?hStackAt,
    hStore⟩
  · simpa using
      (getElem?_append_right_add hiddenLayout sourceLayout sourceIdx).trans
        hName
  · rw [hStack]
    rw [List.getElem?_append_right]
    · have hSub :
          hiddenLayout.length + sourceIdx - hiddenValues.length =
            sourceIdx := by
          omega
      rw [hSub]
      exact hLocalStack
    · simp [hHiddenLength]

theorem VisibleVarSlotRel.cons_source_insert
    {sourceLayout fullLayout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    {name : Name} {value : Word}
    (hFresh : name ∉ sourceLayout)
    (hRel : VisibleVarSlotRel sourceLayout fullLayout store stack) :
    VisibleVarSlotRel (name :: sourceLayout) (name :: fullLayout)
      (store.insert name value) (value :: stack) := by
  exact
    Locals.StackLowering.VisibleLookupSlotRel.cons_source_insert
      (lookup := store.lookup)
      (lookup' := (store.insert name value).lookup)
      (stack := stack)
      (name := name) (value := value)
      (by exact Finmap.lookup_insert store)
      (by
        intro sourceName hMem
        change (store.insert name value).lookup sourceName =
          store.lookup sourceName
        rw [Finmap.lookup_insert_of_ne]
        intro hEq
        exact hFresh (by simpa [hEq] using hMem))
      hRel

theorem VisibleVarSlotRel.cons_hidden
    {sourceLayout fullLayout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}

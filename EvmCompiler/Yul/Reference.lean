end SourceStateRel

theorem SourceStateExactRel.toRel
    {cfg : StateRelConfig} {layout : List Name}
    {source : State} {compiler : Objects.Source.State}
    (hRel : SourceStateExactRel cfg layout source compiler) :
    SourceStateRel cfg layout source compiler := by
  cases hRel with
  | ok hShared hVars _hDomain =>
      exact SourceStateRel.ok hShared hVars

theorem sourceStateRel_restrictCompiler
    {cfg : StateRelConfig} {layoutSmall layoutBig : List Name}
    {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
    {source : Objects.Source.State}
    (hRel : SourceStateRel cfg layoutBig (.Ok shared store) source)
    (hSubset : ∀ name, name ∈ layoutSmall → name ∈ layoutBig) :
    SourceStateRel cfg layoutSmall (.Ok shared store)
      (source.restrictTo layoutSmall) := by
  cases hRel with
  | ok hShared hVars =>
      refine SourceStateRel.ok ?_ ?_
      · simpa using hShared
      · intro name hMem
        simpa [Locals.Source.State.restrictTo,
          Locals.Source.Store.restrictTo_mem hMem]
          using hVars name (hSubset name hMem)

/--
Stack-free expression-value bridge from imported Yul expressions to the
compiler-facing source expression interpreter.

This is intentionally about source variables and shared state only.  It does
not mention slots, stack layouts, generated temporaries, or direct expression
code; those belong to the locals/function lowering proofs below this boundary.
-/
def ExprValueSound (cfg : StateRelConfig) (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics) (sourceFuel : Nat)
    (expr : AstExpr) (codeOverride : Option AstContract)
    {results : Nat} (lower : Locals.Expr results) : Prop :=
  ∀ {source compiler sourceAfter values},
    SourceStateRel cfg layout source compiler →
    EvmYul.Yul.evalValues sourceFuel expr codeOverride source =
      .ok (sourceAfter, values) →
    ∃ compilerAfter : Objects.Source.State,
      Locals.Source.Expr.eval prim lower compiler =
        .ok (compilerAfter, values) ∧
      SourceStateRel cfg layout sourceAfter compilerAfter

theorem exprValueSound_lit
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    (sourceFuel : Nat) (value : Word)
    (codeOverride : Option AstContract) :
    ExprValueSound cfg layout prim sourceFuel.succ (.Lit value) codeOverride
      (Locals.Expr.lit value) := by
  intro source compiler sourceAfter values hInitial hEval
  cases hInitial with
  | @ok shared store _ hShared hVars =>
      simp [EvmYul.Yul.evalValues] at hEval
      rcases hEval with ⟨hSourceAfter, hValues⟩
      cases hSourceAfter
      cases hValues
      exact
        ⟨compiler, by simp [Locals.Source.Expr.eval],
          SourceStateRel.ok hShared hVars⟩

theorem exprValueSound_var
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    (sourceFuel : Nat) (name : EvmYul.Identifier)
    (codeOverride : Option AstContract)
    (hMem : identName name ∈ layout) :
    ExprValueSound cfg layout prim sourceFuel.succ (.Var name) codeOverride
      (Locals.Expr.var (identName name)) := by
  intro source compiler sourceAfter values hInitial hEval
  cases hInitial with
  | @ok shared store _ hShared hVars =>
      cases hLookup : EvmYul.Yul.State.lookup? name (.Ok shared store) with
      | none =>
          simp [EvmYul.Yul.evalValues, hLookup] at hEval
      | some value =>
          have hStore : store.lookup (identName name) = some value := by
            simpa [EvmYul.Yul.State.lookup?, identName] using hLookup
          have hSourceVar : compiler.vars (identName name) = some value := by
            simpa [hStore] using hVars (identName name) hMem
          simp [EvmYul.Yul.evalValues, hLookup] at hEval
          rcases hEval with ⟨hSourceAfter, hValues⟩
          cases hSourceAfter
          cases hValues
          exact
            ⟨compiler,
              by simp [Locals.Source.Expr.eval, hSourceVar],
              SourceStateRel.ok hShared hVars⟩

/--
Stack-free bridge for Yul call-argument evaluation order.

Imported Yul evaluates call arguments from right to left by running
`evalArgs` over `args.reverse`, then reverses the resulting values back into
source order.  This predicate records exactly that boundary and relates it to
the source expression-sequence interpreter used above the locals layer.
-/
def ExprArgListSound (cfg : StateRelConfig) (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics) (sourceFuel : Nat)
    (args : List AstExpr) (codeOverride : Option AstContract)
    {results : Nat} (lower : Locals.ExprSeq results) : Prop :=
  ∀ {source compiler sourceAfter values},
    SourceStateRel cfg layout source compiler →
    EvmYul.Yul.reverse'
        (EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride source) =
      .ok (sourceAfter, values) →
    ∃ compilerAfter : Objects.Source.State,
      Locals.Source.Expr.ExprSeq.eval prim lower compiler =
        .ok (compilerAfter, values) ∧
      SourceStateRel cfg layout sourceAfter compilerAfter

theorem exprArgListSound_nil
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    (sourceFuel : Nat) (codeOverride : Option AstContract) :
    ExprArgListSound cfg layout prim sourceFuel.succ [] codeOverride
      Locals.ExprSeq.nil := by
  intro source compiler sourceAfter values hInitial hEval
  cases hInitial with
  | @ok shared store _ hShared hVars =>
      simp [EvmYul.Yul.evalArgs, EvmYul.Yul.reverse'] at hEval
      rcases hEval with ⟨hSourceAfter, hValues⟩
      cases hSourceAfter
      cases hValues
      exact
        ⟨compiler, by simp [Locals.Source.Expr.ExprSeq.eval],
          SourceStateRel.ok hShared hVars⟩

theorem exprArgListSound_singleton_lit
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    (sourceFuel : Nat) (value : Word)
    (codeOverride : Option AstContract) :
    ExprArgListSound cfg layout prim sourceFuel.succ.succ.succ
      [.Lit value] codeOverride
      (Locals.ExprSeq.cons (Locals.Expr.lit value) Locals.ExprSeq.nil) := by
  intro source compiler sourceAfter values hInitial hEval
  cases hInitial with
  | @ok shared store _ hShared hVars =>
      simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, EvmYul.Yul.eval,
        EvmYul.Yul.head', EvmYul.Yul.evalValues, EvmYul.Yul.cons',
        EvmYul.Yul.reverse'] at hEval
      rcases hEval with ⟨hSourceAfter, hValues⟩
      cases hSourceAfter
      cases hValues
      exact
        ⟨compiler, by simp [Locals.Source.Expr.ExprSeq.eval,
            Locals.Source.Expr.eval],
          SourceStateRel.ok hShared hVars⟩

theorem exprArgListSound_singleton_var
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    (sourceFuel : Nat) (name : EvmYul.Identifier)
    (codeOverride : Option AstContract)
    (hMem : identName name ∈ layout) :
    ExprArgListSound cfg layout prim sourceFuel.succ.succ.succ
      [.Var name] codeOverride
      (Locals.ExprSeq.cons (Locals.Expr.var (identName name))
        Locals.ExprSeq.nil) := by
  intro source compiler sourceAfter values hInitial hEval
  cases hInitial with
  | @ok shared store _ hShared hVars =>
      cases hLookup : EvmYul.Yul.State.lookup? name (.Ok shared store) with
      | none =>
          simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, EvmYul.Yul.eval,
            EvmYul.Yul.head', EvmYul.Yul.evalValues, hLookup,
            EvmYul.Yul.reverse'] at hEval
      | some value =>
          have hStore : store.lookup (identName name) = some value := by
            simpa [EvmYul.Yul.State.lookup?, identName] using hLookup
          have hSourceVar : compiler.vars (identName name) = some value := by
            simpa [hStore] using hVars (identName name) hMem
          simp [EvmYul.Yul.evalArgs, EvmYul.Yul.evalTail, EvmYul.Yul.eval,
            EvmYul.Yul.head', EvmYul.Yul.evalValues, hLookup,
            EvmYul.Yul.cons', EvmYul.Yul.reverse'] at hEval
          rcases hEval with ⟨hSourceAfter, hValues⟩
          cases hSourceAfter
          cases hValues
          exact
            ⟨compiler, by simp [Locals.Source.Expr.ExprSeq.eval,
                Locals.Source.Expr.eval, hSourceVar],
              SourceStateRel.ok hShared hVars⟩

theorem exprValueSound_prim_of_arg_list
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    {sourceFuel : Nat} {yulPrim : EvmYul.Operation .Yul}
    {op : Structured.BasicOp} {args : List AstExpr}
    {codeOverride : Option AstContract}
    {lowerArgs : Locals.ExprSeq (Expressions.Structured.BasicOp.inputs op)}
    (hArgs :
      ExprArgListSound cfg layout prim sourceFuel args codeOverride lowerArgs)
    (hPrim :
      ∀ {sourceAfterArgs : State}
        {compilerAfterArgs : Objects.Source.State}
        {values : List Word} {sourceAfterPrim : State}
        {values' : List Word},
        SourceStateRel cfg layout sourceAfterArgs compilerAfterArgs →
        EvmYul.Yul.primCall sourceFuel sourceAfterArgs yulPrim values =
          .ok (sourceAfterPrim, values') →
        ∃ sharedAfter : EvmYul.SharedState .EVM,
          prim.eval op compilerAfterArgs.shared values =
            .ok (sharedAfter, values') ∧
          SourceStateRel cfg layout sourceAfterPrim
            (compilerAfterArgs.withShared sharedAfter)) :
    ExprValueSound cfg layout prim sourceFuel.succ
      (.Call (.inl yulPrim) args) codeOverride
      (Locals.Expr.prim op lowerArgs) := by
  intro source compiler sourceAfter values hInitial hEval
  simp [EvmYul.Yul.evalValues] at hEval
  cases hArgEval :
      EvmYul.Yul.reverse'
        (EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride source) with
  | error err =>
      simp [hArgEval] at hEval
  | ok argResult =>
      rcases argResult with ⟨sourceAfterArgs, argValues⟩
      rcases hArgs hInitial hArgEval with
        ⟨compilerAfterArgs, hCompilerArgs, hRelArgs⟩
      have hPrimCall :
          EvmYul.Yul.primCall sourceFuel sourceAfterArgs yulPrim
              argValues =
            .ok (sourceAfter, values) := by
        simpa [hArgEval] using hEval
      rcases hPrim hRelArgs hPrimCall with
        ⟨sharedAfter, hPrimEval, hRelAfter⟩
      exact
        ⟨compilerAfterArgs.withShared sharedAfter,
          by
            simp [Locals.Source.Expr.eval, hCompilerArgs, hPrimEval,
              Locals.Source.State.withShared],
          hRelAfter⟩

theorem exprValueSound_address
    {cfg : StateRelConfig} {layout : List Name}
    {prim : Objects.Source.PrimitiveSemantics}
    (sourceFuel : Nat) (codeOverride : Option AstContract)
    (hAddress :
      ∀ {shared : EvmYul.SharedState .Yul}
        {store : EvmYul.Yul.VarStore}
        {compiler : Objects.Source.State},
        SourceStateRel cfg layout (.Ok shared store) compiler →
          prim.eval .address compiler.shared [] =
            .ok (compiler.shared,
              [((.ofNat ∘ Fin.val ∘ EvmYul.ExecutionEnv.codeOwner)
                shared.executionEnv)])) :
    ExprValueSound cfg layout prim sourceFuel.succ.succ
      (.Call (.inl ((.Env .ADDRESS : EvmYul.Operation .Yul))) [])
      codeOverride (.prim .address .nil) := by
  intro source compiler sourceAfter values hInitial hEval
  cases hInitial with
  | @ok shared store _ hShared hVars =>
      simp [EvmYul.Yul.evalValues, EvmYul.Yul.evalArgs,
        EvmYul.Yul.reverse'] at hEval
      have hCallExpected :=
        PrimSemantics.primCall_address_ok sourceFuel shared store
      rw [hCallExpected] at hEval
      cases hEval
      exact
        ⟨compiler,
          by
            have hSourceAddress :=
              hAddress (SourceStateRel.ok hShared hVars)
            simp [Locals.Source.Expr.eval, Locals.Source.Expr.ExprSeq.eval,
              hSourceAddress, Locals.Source.State.withShared],
          SourceStateRel.ok hShared hVars⟩

/--
Prelude-shaped argument bridge for compiler-generated temporary bindings.

This is the boundary used by the real Yul lowering: imported Yul evaluates
arguments in last-to-first order; the compiler emits a source-level prelude
that binds generated temporaries in that order; the final expression sequence
then reads those temporaries in source order.  The predicate still hides all
direct stack/layout machinery.
-/
def ExprArgPreludeSound (cfg : StateRelConfig) (layout : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat) (args : List AstExpr)
    (codeOverride : Option AstContract)
    (pre : List Functions.Stmt) {results : Nat}
    (lower : Locals.ExprSeq results) : Prop :=
  ∀ {source compiler sourceAfter values},
    SourceStateRel cfg layout source compiler →
    EvmYul.Yul.reverse'
        (EvmYul.Yul.evalArgs sourceFuel args.reverse codeOverride source) =
      .ok (sourceAfter, values) →
    ∃ compilerAfterPre : Objects.Source.State,
    ∃ compilerAfterArgs : Objects.Source.State,
    ∃ ctxAfter : Functions.Source.Ctx,
    ∃ targetFuel : Nat,
      Functions.Source.Block.runOpen prim program ctx targetFuel
          { stmts := pre } compiler =
        .ok (Functions.Source.Outcome.regular compilerAfterPre, ctxAfter) ∧
      Locals.Source.Expr.ExprSeq.eval prim lower compilerAfterPre =
        .ok (compilerAfterArgs, values) ∧
      SourceStateRel cfg layout sourceAfter compilerAfterArgs

/--

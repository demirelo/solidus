theorem listToFunctionsFuel?_cons_components
    {fuel : Nat} {state state'' : Fresh.State}
    {stmt : AstStmt} {rest : List AstStmt}
    {lower : List Functions.Stmt}
    (hLower :
      Stmt.List.toFunctionsFuel? fuel.succ state (stmt :: rest) =
        some (lower, state'')) :
    ∃ lowerHead : List Functions.Stmt, ∃ state' : Fresh.State,
    ∃ lowerRest : List Functions.Stmt,
      Stmt.toFunctionsListFuel? fuel state stmt = some (lowerHead, state') ∧
      Stmt.List.toFunctionsFuel? fuel state' rest =
        some (lowerRest, state'') ∧
      lower = lowerHead ++ lowerRest := by
  cases hHead : Stmt.toFunctionsListFuel? fuel state stmt with
  | none =>
      simp [Stmt.List.toFunctionsFuel?, hHead] at hLower
  | some headResult =>
      rcases headResult with ⟨lowerHead, state'⟩
      cases hTail : Stmt.List.toFunctionsFuel? fuel state' rest with
      | none =>
          simp [Stmt.List.toFunctionsFuel?, hHead, hTail] at hLower
      | some tailResult =>
          rcases tailResult with ⟨lowerRest, state'''⟩
          simp [Stmt.List.toFunctionsFuel?, hHead, hTail] at hLower
          have hPair :
              (lowerHead ++ lowerRest, state''') = (lower, state'') := by
            simpa using hLower
          have hState : state''' = state'' := congrArg Prod.snd hPair
          have hLowerEq : lower = lowerHead ++ lowerRest :=
            (congrArg Prod.fst hPair).symm
          exact
            ⟨lowerHead, state', lowerRest, by simpa [hHead],
              by simpa [hState] using hTail, hLowerEq⟩

theorem listToBlockFuel?_components
    {fuel : Nat} {state state' : Fresh.State}
    {stmts : List AstStmt} {lowerBlock : Functions.Block}
    (hLower :
      Stmt.List.toBlockFuel? fuel.succ state stmts =
        some (lowerBlock, state')) :
    ∃ lower : List Functions.Stmt,
      Stmt.List.toFunctionsFuel? fuel state stmts = some (lower, state') ∧
      lowerBlock = { stmts := lower } := by
  cases hList : Stmt.List.toFunctionsFuel? fuel state stmts with
  | none =>
      simp [Stmt.List.toBlockFuel?, hList] at hLower
  | some result =>
      rcases result with ⟨lower, state''⟩
      simp [Stmt.List.toBlockFuel?, hList] at hLower
      have hPair : ({ stmts := lower }, state'') = (lowerBlock, state') := by
        simpa using hLower
      have hState : state'' = state' := congrArg Prod.snd hPair
      have hBlock : lowerBlock = { stmts := lower } :=
        (congrArg Prod.fst hPair).symm
      exact ⟨lower, by simpa [hState] using hList, hBlock⟩


      EvmYul.Yul.execSeq sourceFuel sourceStmts codeOverride source =
        .ok sourceAfter ∧
      SourceLowered.runState prim targetFuel program sourceInitial =
        .ok (Functions.Source.Outcome.regular
          (compilerAfter.restrictTo [])) ∧
      ctxAfter.scope = layoutAfter ∧
      Reference.SourceBridgeFacts.SourceStateRel cfg layoutAfter sourceAfter
        compilerAfter := by
  rcases hBridge with
    ⟨sourceAfter, compilerAfter, ctxAfter, targetFuel, hSource,
      hCompiler, _hCtxScope, hCtxAfterScope, _hSubset, hRel⟩
  refine
    ⟨sourceAfter, compilerAfter, ctxAfter, targetFuel, hSource, ?_,
      hCtxAfterScope, hRel⟩
  have hRunScoped :
      Functions.Source.Block.runScoped prim functionProgram
          Functions.Source.Ctx.initial functionProgram.body targetFuel
          sourceInitial =
        .ok (Functions.Source.Outcome.regular

/--
Nonregular block bridge for arbitrary full compiler layouts.

The result relation names both the source-visible layout and the full compiler
layout at the continuation/terminal point. This is the block-level companion of
`ResultSeqRunBridgeWithLayoutSlots` for heads such as true `if` bodies that
exit by `break`, `continue`, `leave`, or terminal halt.
-/
def NonregularBlockRunBridgeWithLayoutSlots {cfg : StateRelConfig}
    (outcomeSourceLayout outcomeFullLayout : List Name)
    (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceResult : Except Exception State, ∃ outcome : Functions.Outcome,
  ∃ ctxAfter : Locals.Ctx, ∃ targetFuel : Nat,
    EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
      sourceResult ∧
    Functions.Direct.Block.runOpen program returns ctx targetFuel lowerBlock
        compiler =
      .ok (outcome, ctxAfter) ∧
    CompilerResultOutcomeRelWithLayoutSlots cfg outcomeSourceLayout
      outcomeFullLayout sourceResult outcome ∧
    outcome.state.returns = compiler.returns ∧
    outcome.mode ≠ .regular

/--
Result-shaped block bridge for arbitrary full compiler layouts.

This is the block-scoped analogue of `ResultSeqRunBridgeWithLayoutSlots`: the
source side executes a bracketed block, while the target side is still the open
block runner.  `Block.runScoped` wrappers decide later whether regular cleanup
is needed.
-/
def ResultBlockRunBridgeWithLayoutSlots {cfg : StateRelConfig}
    (outcomeSourceLayout outcomeFullLayout : List Name)
    (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (sourceFuel : Nat) (sourceStmts : List AstStmt)
    (codeOverride : Option AstContract) (source : State)
    (compiler : RunState) (lowerBlock : Functions.Block) :
    Prop :=
  ∃ sourceResult : Except Exception State, ∃ outcome : Functions.Outcome,
  ∃ ctxAfter : Locals.Ctx, ∃ targetFuel : Nat,
    EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
      sourceResult ∧
    Functions.Direct.Block.runOpen program returns ctx targetFuel lowerBlock
        compiler =
      .ok (outcome, ctxAfter) ∧
    CompilerResultOutcomeRelWithLayoutSlots cfg outcomeSourceLayout
      outcomeFullLayout sourceResult outcome ∧
    outcome.state.returns = compiler.returns

theorem resultBlockRunBridge_of_ok {cfg : StateRelConfig}
    {layoutAfter : List Name} {program : Functions.Program}
    {returns : List Name} {ctx : Locals.Ctx}
    {sourceFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract} {source : State}
    {compiler : RunState} {lowerBlock : Functions.Block}
    (hBridge :
      OkBlockRunBridge (cfg := cfg) layoutAfter program returns ctx
        sourceFuel sourceStmts codeOverride source compiler lowerBlock) :
    ResultBlockRunBridge (cfg := cfg) layoutAfter program returns ctx
      sourceFuel sourceStmts codeOverride source compiler lowerBlock := by
  rcases hBridge with
    ⟨sourceAfter, outcome, ctxAfter, targetFuel,
      hSource, hTarget, hRel, hReturns⟩
  exact
    ⟨.ok sourceAfter, outcome, ctxAfter, targetFuel,
      hSource, hTarget, CompilerResultOutcomeRel.ok hRel, hReturns⟩

theorem someResultBlockRunBridge_of_ok {cfg : StateRelConfig}
    {layoutAfter : List Name} {program : Functions.Program}
    {returns : List Name} {ctx : Locals.Ctx}
    {sourceFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract} {source : State}
    {compiler : RunState} {lowerBlock : Functions.Block}
    (hBridge :
      OkBlockRunBridge (cfg := cfg) layoutAfter program returns ctx
        sourceFuel sourceStmts codeOverride source compiler lowerBlock) :
    SomeResultBlockRunBridge (cfg := cfg) program returns ctx sourceFuel
      sourceStmts codeOverride source compiler lowerBlock := by

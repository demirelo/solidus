    EvmYul.Yul.exec fuel.succ (.Let names none) codeOverride state =
      match EvmYul.Yul.checkDeclaration state names with
      | .error err => .error err
      | .ok () => .ok (state.zeroFill names) := by
  simp [EvmYul.Yul.exec]
  rfl

theorem exec_let_lit_succ (fuel : Nat) (names : List EvmYul.Identifier) (value : Word)
    (codeOverride : Option AstContract) (state : State) :
    EvmYul.Yul.exec fuel.succ (.Let names (some (.Lit value)))
        codeOverride state =
      match EvmYul.Yul.checkDeclaration state names with
      | .error err => .error err
      | .ok () =>
          EvmYul.Yul.multifill' names
            (EvmYul.Yul.evalValues fuel (.Lit value) codeOverride state) := by
  simp [EvmYul.Yul.exec]
  rfl

theorem exec_let_var_succ (fuel : Nat) (names : List EvmYul.Identifier)
    (source : EvmYul.Identifier)
    (codeOverride : Option AstContract) (state : State) :
    EvmYul.Yul.exec fuel.succ (.Let names (some (.Var source)))

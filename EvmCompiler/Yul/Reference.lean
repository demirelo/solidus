                        | zero =>
                            simp at hExpr
                            subst name
                            simpa [Nat.add_assoc] using
                              hRightBound hLayout
                        | succ pos =>
                            cases pos with
                            | zero =>
                                simp at hExpr
                                subst name
                                simpa [Nat.add_assoc] using
                                  hMiddleBound hLayout
                            | succ pos =>
                                cases pos with
                                | zero =>
                                    simp at hExpr
                                    subst name
                                    simpa [Nat.add_assoc] using
                                      hLeftBound hLayout
                                | succ pos =>
                                    simp at hExpr

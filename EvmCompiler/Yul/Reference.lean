theorem sourceResultBlockRunBridge_of_sound_when
    {cfg : StateRelConfig} {layout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel : Nat} {sourceStmts : List AstStmt}
    {codeOverride : Option AstContract} {source : State}
    {compiler : Objects.Source.State} {lowerBlock : Functions.Block}
    {sourceResult : Except Exception State}
    {allowed : Except Exception State → Prop}
    (hSound :
      SourceResultBlockSoundWhen cfg layout terminalRel revertRel prim program
        ctx sourceFuel sourceStmts codeOverride lowerBlock allowed)
    (hInitial :
      SourceStateRel cfg layout source compiler)
    (hAllowed : allowed sourceResult)
    (hSource :
      EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
        sourceResult) :
    SourceResultBlockRunBridge cfg layout terminalRel revertRel prim program
      ctx sourceFuel sourceStmts codeOverride source compiler lowerBlock := by
  rcases hSound with ⟨_hScope, hRun⟩
  rcases hRun hInitial hAllowed hSource with
    ⟨sourceOutcome, targetFuel, hCompiler, hRel⟩
  exact ⟨sourceResult, sourceOutcome, targetFuel, hSource, hCompiler, hRel⟩

/--
Checked-lowering target for the full recursive imported-Yul bridge.

The recursive proof should construct this predicate by induction over imported
Yul/source fuel and the checked lowering derivation.  It is intentionally
source-facing: the premise is only that the Yul block lowerer produced a
compiler-source block, and the conclusion is `SourceResultBlockSound`.  Stack
layouts, generated labels, procedure tokens, and direct assembly evidence stay
below the function/source compiler boundary.
-/
def CheckedBlockLoweringSound (cfg : StateRelConfig) (layout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat)
    (sourceStmts : List AstStmt) (codeOverride : Option AstContract) :
    Prop :=
  ∀ {freshState freshState' lowerBlock},
    Stmt.List.toBlock? freshState sourceStmts =
      some (lowerBlock, freshState') →
    SourceResultBlockSound cfg layout terminalRel revertRel prim program ctx
      sourceFuel sourceStmts codeOverride lowerBlock

/--
Fresh-name invariant for checked Yul lowering.

The lowerer generates temporaries fresh relative to `Fresh.State.used`; the
source bridge needs those temporaries to be absent from the currently visible
source layout.  Recursive bridge proofs should therefore thread this small
invariant instead of asking each generated-prelude theorem for ad hoc
freshness evidence.
-/
def FreshCoversLayout (layout : List Name) (state : Fresh.State) : Prop :=
  ∀ name, name ∈ layout → name ∈ state.used

theorem freshCoversLayout_nil (state : Fresh.State) :
    FreshCoversLayout [] state := by
  intro name hMem
  cases hMem

theorem freshCoversLayout_cons {layout : List Name}
    {state : Fresh.State} {head : Name}
    (hHead : head ∈ state.used)
    (hTail : FreshCoversLayout layout state) :
    FreshCoversLayout (head :: layout) state := by
  intro name hMem
  simp at hMem
  cases hMem with
  | inl hEq =>
      simpa [hEq] using hHead
  | inr hTailMem =>
      exact hTail name hTailMem

theorem freshCoversLayout_append_left {front layout : List Name}
    {state : Fresh.State}
    (hFront : ∀ name, name ∈ front → name ∈ state.used)
    (hLayout : FreshCoversLayout layout state) :
    FreshCoversLayout (front ++ layout) state := by
  intro name hMem
  rw [List.mem_append] at hMem
  cases hMem with
  | inl hFrontMem =>
      exact hFront name hFrontMem
  | inr hLayoutMem =>
      exact hLayout name hLayoutMem

/--
Fresh-aware checked block target for the recursive imported-Yul bridge.

This is the version the full recursive theorem should use internally: every
generated temporary is known fresh for the current source layout because the
fresh state covers that layout before lowering.
-/
def CheckedBlockLoweringSoundFresh (cfg : StateRelConfig) (layout : List Name)
    (terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop)
    (revertRel : State → Objects.Source.State → Prop)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel : Nat)
    (sourceStmts : List AstStmt) (codeOverride : Option AstContract) :
    Prop :=
  ∀ {freshState freshState' lowerBlock},
    FreshCoversLayout layout freshState →
    Stmt.List.toBlock? freshState sourceStmts =
      some (lowerBlock, freshState') →
    SourceResultBlockSound cfg layout terminalRel revertRel prim program ctx
      sourceFuel sourceStmts codeOverride lowerBlock

/--
Checked single-statement lowering target for the recursive imported-Yul bridge.

`Stmt.toFunctionsList?` is the actual lowering function used for the contract
dispatcher and for list heads.  The recursive statement theorem should
construct this predicate; dispatcher/block theorems can then be small
projections rather than bespoke proof surfaces.
-/

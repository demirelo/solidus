theorem resultSeqRunBridgeWithLayout_cons_block_nonregular
    {cfg : StateRelConfig} {layout outcomeLayout : List Name}
    {program : Functions.Program} {returns : List Name}
    {ctx : Locals.Ctx} {sourceFuel : Nat}
    {body rest : List AstStmt} {codeOverride : Option AstContract}
    {source : State} {compiler : RunState}
    {lowerBlock lowerTail : Functions.Block}
    (hCtxLayout : ctx.layout = layout)
    (hBlock :
      NonregularBlockRunBridge (cfg := cfg) outcomeLayout program returns ctx
        sourceFuel body codeOverride source compiler lowerBlock) :
    ResultSeqRunBridgeWithLayout (cfg := cfg) layout layout outcomeLayout
      program returns ctx sourceFuel.succ (.Block body :: rest) codeOverride
      source compiler
      { stmts := [Functions.Stmt.block lowerBlock] ++ lowerTail.stmts } := by
  rcases hBlock with
    ⟨sourceResult, outcome, _ctxAfter, targetFuel, hSource, hTarget,
      hRel, hReturns, hNonregular⟩
  have hSourceSeq :
      EvmYul.Yul.execSeq sourceFuel.succ (.Block body :: rest) codeOverride
          source =
        sourceResult := by
    cases hRel with
    | ok hOk =>
        cases hOk with
        | regular _ =>
            exact False.elim (hNonregular rfl)
        | brk _ =>
            exact Imported.execSeq_cons_checkpoint_succ hSource
        | cont _ =>
            exact Imported.execSeq_cons_checkpoint_succ hSource
        | leave _ =>
            exact Imported.execSeq_cons_checkpoint_succ hSource
    | yulHalt _ =>
        exact Imported.execSeq_cons_error_succ hSource
    | revert _ =>
        exact Imported.execSeq_cons_error_succ hSource
  have hTargetStmt :
      Functions.Direct.Block.runOpen program returns ctx targetFuel.succ
          { stmts := [Functions.Stmt.block lowerBlock] ++
              lowerTail.stmts } compiler =
        .ok (outcome, ctx) := by
    cases hMode : outcome.mode with
    | regular =>
        exact False.elim (hNonregular hMode)
    | brk =>
        simp [Functions.Direct.Block.runOpen, Functions.Direct.Stmt.run,
          Functions.Direct.Block.runScoped, hTarget, hMode]
    | cont =>
        simp [Functions.Direct.Block.runOpen, Functions.Direct.Stmt.run,
          Functions.Direct.Block.runScoped, hTarget, hMode]
    | leave =>
        simp [Functions.Direct.Block.runOpen, Functions.Direct.Stmt.run,
          Functions.Direct.Block.runScoped, hTarget, hMode]
    | halt kind =>
        simp [Functions.Direct.Block.runOpen, Functions.Direct.Stmt.run,
          Functions.Direct.Block.runScoped, hTarget, hMode]
  exact
    ⟨sourceResult, outcome, ctx, targetFuel.succ, hSourceSeq, hTargetStmt,
      hCtxLayout, hCtxLayout, LayoutSuffix.refl layout, hRel, hReturns⟩


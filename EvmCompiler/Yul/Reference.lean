      ([Locals.Expr.var leftTmp, Locals.Expr.var rightTmp].reverse)[pos]? =
          some (.var name) →
        (leftTmp :: rightTmp :: fullLayout)[idx]? = some name →
          pos + idx + 1 ≤ 16 := by
  intro pos name idx hArg hLayout
  cases pos with
  | zero =>
      simp at hArg
      subst name
      have hRight :
          (leftTmp :: rightTmp :: fullLayout)[1]? = some rightTmp := by
        simp
      have hIdx : idx = 1 :=
        getElem?_eq_index_of_nodup hNoDup hLayout hRight
      subst idx
      omega
  | succ pos =>
      cases pos with
      | zero =>
          simp at hArg
          subst name
          have hLeft :
              (leftTmp :: rightTmp :: fullLayout)[0]? = some leftTmp := by
            simp
          have hIdx : idx = 0 :=
            getElem?_eq_index_of_nodup hNoDup hLayout hLeft
          subst idx
          omega
      | succ pos =>
          simp at hArg


theorem functions_block_let_none_bridge {cfg : StateRelConfig}
    {layout : List Name} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : RunState}
    (sourceFuel : Nat) (program : Functions.Program)
    (returns : List Name) (ctx : Locals.Ctx)
    (names : List EvmYul.Identifier) (codeOverride : Option AstContract)
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (_hCtxLayout : ctx.layout = layout)
    (hCheck :
      EvmYul.Yul.checkDeclaration (.Ok shared store) names = .ok ())
    (hNoDup : (identNames names).Nodup)
    (hFresh : ∀ name, name ∈ identNames names → name ∉ layout)
    (hRel : CompilerStateRel cfg layout (.Ok shared store) compiler.evm) :
    ∃ compiler',
      EvmYul.Yul.exec sourceFuel.succ (.Let names none)
          codeOverride (.Ok shared store) =
        .ok (.Ok shared
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames names)) store)) ∧
      Functions.Direct.Block.runOpen program returns ctx
          ((identNames names).length + 1)
          { stmts := Stmt.initNames (identNames names) } compiler =
        .ok (Structured.Outcome.regular compiler',
          ctx.withLayout ((identNames names).reverse ++ ctx.layout)) ∧
      CompilerStateRel cfg ((identNames names).reverse ++ layout)
        (.Ok shared
          (VarStackRel.insertPairs
            (VarStackRel.zeroPairs (identNames names)) store))
        compiler'.evm ∧
      compiler'.returns = compiler.returns := by
  cases hRel with
  | ok hShared hVars =>
      rcases
        functions_initNames_runOpen_stack
          (cfg := cfg) (shared := shared) program returns
          (identNames names) ctx compiler hShared with
        ⟨compiler', hTarget, hStack, hReturns, hSharedFinal⟩
      refine
        ⟨compiler',
          exec_let_none_ok sourceFuel names codeOverride shared store hCheck,
          hTarget, ?hRel, hReturns⟩
      have hExactSource :
          ExactVarStackRel ((identNames names).reverse ++ layout)
            (VarStackRel.insertPairs
              (VarStackRel.zeroPairs (identNames names)) store)
            (((VarStackRel.zeroPairs (identNames names)).map Prod.snd).reverse ++
              compiler.evm.stack) := by
        exact
          ExactVarStackRel.insertZeros (identNames names) hNoDup hFresh
            (by simpa [hVarRelExact] using hVars)
      refine CompilerStateRel.ok hSharedFinal ?_
      have hExactSource' :
          ExactVarStackRel ((identNames names).reverse ++ layout)
            (VarStackRel.insertPairs
              (VarStackRel.zeroPairs (identNames names)) store)
            (List.replicate (identNames names).length VarStackRel.zeroWord ++
              compiler.evm.stack) := by
        simpa [VarStackRel.zeroPairs, Function.comp_def] using hExactSource
      simpa [hVarRelExact, hStack] using hExactSource'

theorem functions_block_let_none_layout_slots_bridge {cfg : StateRelConfig}
    {sourceLayout fullLayout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : RunState}
    (sourceFuel : Nat) (program : Functions.Program)

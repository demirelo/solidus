/--
Checked regular single-statement soundness for singleton lowerings.

Many source-level ordinary statements lower to exactly one function-source
statement.  This packages the lowerer decomposition with the fresh-state fact
needed by the tail of an open sequence. Multi-statement generated preludes use
their own prefix theorem instead of this singleton boundary.
-/
def CheckedRegularStmtSingletonSoundAt (cfg : StateRelConfig)
    (layout layoutAfter : List Name)
    (prim : Objects.Source.PrimitiveSemantics)
    (program : Functions.Program) (ctx : Functions.Source.Ctx)
    (sourceFuel targetFuel : Nat) (sourceStmt : AstStmt)
    (codeOverride : Option AstContract) :
    Prop :=
  ∀ {lowerFuel freshState freshState' lowerHeadStmts},
    FreshCoversLayout layout freshState →
    Stmt.toFunctionsListFuel? lowerFuel freshState sourceStmt =
      some (lowerHeadStmts, freshState') →
    ∃ lowerHead : Functions.Stmt,
      lowerHeadStmts = [lowerHead] ∧
        FreshCoversLayout layoutAfter freshState' ∧

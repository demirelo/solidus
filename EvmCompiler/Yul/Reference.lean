  ∃ targetFuel : Nat,
    EvmYul.Yul.exec sourceFuel (.Block sourceStmts) codeOverride source =
      sourceResult ∧
    Functions.Source.Block.runScoped prim program ctx lowerBlock targetFuel
        compiler =
      .ok sourceOutcome


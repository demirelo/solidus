      SourceRegularSeqRunAt cfg layout layoutAfter prim program ctx
        sourceFuel targetFuel sourceStmts codeOverride source compiler
        lowerBlock) :
    SourceRegularSeqRunBridge cfg layout layoutAfter prim program ctx
      sourceFuel sourceStmts codeOverride source compiler lowerBlock := by
  rcases hAt with
    ⟨sourceAfter, compilerAfter, ctxAfter, hSource, hCompiler, hScope,
      hCtxAfterScope, hSubset, hRel⟩
  exact
    ⟨sourceAfter, compilerAfter, ctxAfter, targetFuel, hSource, hCompiler,
      hScope, hCtxAfterScope, hSubset, hRel⟩


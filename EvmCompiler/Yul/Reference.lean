    (hRel : VisibleVarSlotRel sourceLayout fullLayout store stack) :
    VisibleVarSlotRel sourceLayout (hiddenName :: fullLayout) store
      (hiddenValue :: stack) := by
  exact Locals.StackLowering.VisibleLookupSlotRel.cons_hidden hRel

theorem VisibleVarSlotRel.prefix_hidden
    {sourceLayout fullLayout hiddenLayout : List Name}
    {store : EvmYul.Yul.VarStore}
    {stack hiddenValues : EvmYul.Stack Word}
    (hHiddenLength : hiddenValues.length = hiddenLayout.length)
    (hRel : VisibleVarSlotRel sourceLayout fullLayout store stack) :
    VisibleVarSlotRel sourceLayout (hiddenLayout ++ fullLayout) store
      (hiddenValues ++ stack) := by
  exact Locals.StackLowering.VisibleLookupSlotRel.prefix_hidden hHiddenLength hRel

theorem VisibleVarSlotRel.assign
    {sourceLayout fullLayout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    {name : Name} {value : Word} {sourceIdx targetFullIdx : Nat}
    (hNoDupFull : fullLayout.Nodup)
    (hTargetSource : sourceLayout[sourceIdx]? = some name)
    (hTargetFull : fullLayout[targetFullIdx]? = some name)
    (hRel : VisibleVarSlotRel sourceLayout fullLayout store stack) :
    VisibleVarSlotRel sourceLayout fullLayout (store.insert name value)
      (stack.take targetFullIdx ++ value :: stack.drop (targetFullIdx + 1)) := by
  exact
    Locals.StackLowering.VisibleLookupSlotRel.assign
      (lookup := store.lookup)
      (lookup' := (store.insert name value).lookup)
      (stack := stack)
      (name := name) (value := value)
      hNoDupFull hTargetSource hTargetFull
      (by exact Finmap.lookup_insert store)
      (by
        intro sourceName _hMem hNe
        change (store.insert name value).lookup sourceName =
          store.lookup sourceName
        rw [Finmap.lookup_insert_of_ne]
        exact hNe)
      hRel

theorem VisibleVarSlotRel.insertPairs_append
    {sourceLayout fullLayout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    (pairs : List (Name × Word))
    (hNoDup : (pairs.map Prod.fst).Nodup)
    (hFresh :
      ∀ name, name ∈ pairs.map Prod.fst → name ∉ sourceLayout)
    (hRel : VisibleVarSlotRel sourceLayout fullLayout store stack) :
    VisibleVarSlotRel ((pairs.map Prod.fst).reverse ++ sourceLayout)
      ((pairs.map Prod.fst).reverse ++ fullLayout)
      (VarStackRel.insertPairs pairs store)
      ((pairs.map Prod.snd).reverse ++ stack) := by
  let prefixLayout := (pairs.map Prod.fst).reverse
  let prefixStack := (pairs.map Prod.snd).reverse
  have hExactPrefix :
      ExactVarStackRel prefixLayout (VarStackRel.insertPairs pairs store)
        prefixStack := by
    simpa [prefixLayout, prefixStack] using
      (VarStackRel.exact_insertPairs_reverse pairs store hNoDup)
  have hPushedLen : prefixStack.length = prefixLayout.length := by
    simp [prefixStack, prefixLayout]
  intro sourceIdx sourceName hSourceName
  by_cases hLt : sourceIdx < prefixLayout.length
  · have hPrefixName : prefixLayout[sourceIdx]? = some sourceName := by
      have hAppend :
          (prefixLayout ++ sourceLayout)[sourceIdx]? =
            prefixLayout[sourceIdx]? :=
        List.getElem?_append_left (l₂ := sourceLayout) hLt
      simpa [prefixLayout] using hAppend.symm.trans hSourceName
    rcases ExactVarStackRel.get? hExactPrefix hPrefixName with
      ⟨value, hPrefixStackAt, hLookup⟩
    refine ⟨sourceIdx, value, ?hFull, ?hStack, hLookup⟩
    · have hAppend :
          (prefixLayout ++ fullLayout)[sourceIdx]? =
            prefixLayout[sourceIdx]? :=
        List.getElem?_append_left (l₂ := fullLayout) hLt
      simpa [prefixLayout] using hAppend.trans hPrefixName
    · have hStackLt : sourceIdx < prefixStack.length := by
        omega
      have hAppend :
          (prefixStack ++ stack)[sourceIdx]? =
            prefixStack[sourceIdx]? :=
        List.getElem?_append_left (l₂ := stack) hStackLt
      simpa [prefixStack] using hAppend.trans hPrefixStackAt
  · have hSourceTail :
        sourceLayout[sourceIdx - prefixLayout.length]? = some sourceName := by
      have hAppend :
          (prefixLayout ++ sourceLayout)[sourceIdx]? =
            sourceLayout[sourceIdx - prefixLayout.length]? :=
        List.getElem?_append_right (l₁ := prefixLayout)
          (l₂ := sourceLayout) (i := sourceIdx) (by omega)
      simpa [prefixLayout] using hAppend.symm.trans hSourceName
    rcases hRel hSourceTail with
      ⟨fullIdx, value, hFullName, hStackAt, hLookup⟩
    refine
      ⟨prefixLayout.length + fullIdx, value, ?hFullOld, ?hStackOld,
        ?hLookupOld⟩
    · simpa [prefixLayout] using
        (getElem?_append_right_add prefixLayout fullLayout fullIdx).trans
          hFullName
    · rw [List.getElem?_append_right]
      · have hSub :
            prefixLayout.length + fullIdx - prefixStack.length = fullIdx := by
          rw [hPushedLen]
          omega
        rw [hSub]
        exact hStackAt
      · rw [hPushedLen]
        omega
    · change
        (VarStackRel.insertPairs pairs store).lookup sourceName = some value
      rw [lookup_insertPairs_preserve]
      · exact hLookup
      · intro pairName hMem hEq
        have hSourceMem : sourceName ∈ sourceLayout :=
          List.mem_of_getElem? hSourceTail
        exact hFresh pairName hMem (by simpa [hEq] using hSourceMem)

namespace LayoutSlotValue

theorem top {layout : List Name} {stack : EvmYul.Stack Word}
    {name : Name} {value : Word} :
    LayoutSlotValue (name :: layout) (value :: stack) name value := by
  exact ⟨0, by simp, by simp⟩

theorem cons {layout : List Name} {stack : EvmYul.Stack Word}
    {name hiddenName : Name} {value hiddenValue : Word}
    (hSlot : LayoutSlotValue layout stack name value) :
    LayoutSlotValue (hiddenName :: layout) (hiddenValue :: stack) name
      value := by
  rcases hSlot with ⟨idx, hName, hStack⟩
  exact ⟨idx + 1, by simpa using hName, by simpa using hStack⟩

theorem prefix_hidden {layout hiddenLayout : List Name}
    {stack hiddenValues : EvmYul.Stack Word}
    {name : Name} {value : Word}
    (hLength : hiddenValues.length = hiddenLayout.length)
    (hSlot : LayoutSlotValue layout stack name value) :
    LayoutSlotValue (hiddenLayout ++ layout) (hiddenValues ++ stack)
      name value := by
  rcases hSlot with ⟨idx, hName, hStack⟩
  refine ⟨hiddenLayout.length + idx, ?hName, ?hStack⟩
  · simpa using
      (getElem?_append_right_add hiddenLayout layout idx).trans hName
  · rw [List.getElem?_append_right]
    · have hSub : hiddenLayout.length + idx - hiddenValues.length = idx := by
        omega
      rw [hSub]
      exact hStack
    · simp [hLength]

end LayoutSlotValue

theorem CompilerStateRel.toLayoutSlots {cfg : StateRelConfig}
    {layout : List Name} {state : State} {compiler : EVMState}
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
  (hRel : CompilerStateRel cfg layout state compiler) :
    CompilerStateRelWithLayoutSlots cfg layout layout state compiler := by
  cases hRel with
  | @ok shared store compiler hShared hVars =>
      have hExact : ExactVarStackRel layout store compiler.stack := by
        simpa [hVarRelExact] using hVars
      exact
        CompilerStateRelWithLayoutSlots.ok hShared
          (VisibleVarSlotRel.of_exact hExact)
          (by
            rw [VarStackRel.exact_length hExact])

theorem CompilerStateRelWithHiddenLocals.toLayoutSlots
    {cfg : StateRelConfig} {sourceLayout hiddenLayout : List Name}
    {state : State} {compiler : EVMState}
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (hRel :
      CompilerStateRelWithHiddenLocals cfg sourceLayout hiddenLayout state
        compiler) :
    CompilerStateRelWithLayoutSlots cfg sourceLayout
      (hiddenLayout ++ sourceLayout) state compiler := by
  cases hRel with
  | @ok shared store compiler hiddenValues locals hShared hVars
      hHiddenLength hStack =>
      have hExact : ExactVarStackRel sourceLayout store locals := by
        simpa [hVarRelExact] using hVars
      exact
        CompilerStateRelWithLayoutSlots.ok hShared
          (VisibleVarSlotRel.of_exact_hidden_prefix hExact hHiddenLength
            hStack)
          (by
            have hHiddenLen :
                hiddenLayout.length = hiddenValues.length := by
              simpa using hHiddenLength.symm
            have hExactLen : sourceLayout.length = locals.length :=
              VarStackRel.exact_length hExact
            simpa [hStack, List.length_append, hHiddenLen, hExactLen])


/--
Compiler-generated expression preludes are source-level `let` bindings for fresh
temporaries.  Keeping this shape explicit lets the imported-Yul bridge compose
prelude code with the real tail without pretending those temporaries are visible
source variables.
-/
inductive GeneratedPrelude : List Functions.Stmt → Prop where
  | nil : GeneratedPrelude []
  | let_ {name : Name} {expr : Locals.Expr 1} {rest : List Functions.Stmt}
      (hRest : GeneratedPrelude rest) :
      GeneratedPrelude (Functions.Stmt.let_ name expr :: rest)

theorem generatedPrelude_runOpen_append_regular_exists
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} :
    ∀ {pre suffix : List Functions.Stmt}
      {ctx midCtx finalCtx : Functions.Source.Ctx}
      {state midState finalState : Objects.Source.State}
      {preFuel tailFuel : Nat},
      GeneratedPrelude pre →
      Functions.Source.Block.runOpen prim program ctx preFuel
          { stmts := pre } state =
        .ok (Functions.Source.Outcome.regular midState, midCtx) →
      Functions.Source.Block.runOpen prim program midCtx tailFuel
          { stmts := suffix } midState =
        .ok (Functions.Source.Outcome.regular finalState, finalCtx) →
      ∃ fuel,
        Functions.Source.Block.runOpen prim program ctx fuel
            { stmts := pre ++ suffix } state =
          .ok (Functions.Source.Outcome.regular finalState, finalCtx) := by
  intro pre suffix ctx midCtx finalCtx state midState finalState preFuel
    tailFuel hPreShape
  induction hPreShape generalizing suffix ctx midCtx finalCtx state midState
      finalState preFuel tailFuel with
  | nil =>
      intro hPre hTail
      cases preFuel with
      | zero =>
          simp [Functions.Source.Block.runOpen, Functions.Source.invalid,
            Structured.invalid] at hPre
      | succ preFuel =>
          have hPair :
              (Functions.Source.Outcome.regular state, ctx) =
                (Functions.Source.Outcome.regular midState, midCtx) := by
            simpa [Functions.Source.Block.runOpen] using hPre
          injection hPair with hState hCtx
          cases hState
          cases hCtx
          exact ⟨tailFuel, by simpa using hTail⟩
  | let_ hRest ih =>
      rename_i name expr rest
      intro hPre hTail
      cases preFuel with
      | zero =>
          simp [Functions.Source.Block.runOpen, Functions.Source.invalid,
            Structured.invalid] at hPre
      | succ preFuel =>
          cases hEval :
              Functions.Source.Expr.evalOne prim expr state with
          | error err =>
              simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
                hEval] at hPre
          | ok evalResult =>
              rcases evalResult with ⟨stateAfterValue, value⟩
              let stateAfterLet := stateAfterValue.insert name value
              let ctxAfterLet := { ctx with scope := name :: ctx.scope }
              have hRestRun :
                  Functions.Source.Block.runOpen prim program ctxAfterLet
                      preFuel { stmts := rest } stateAfterLet =
                    .ok (Functions.Source.Outcome.regular midState, midCtx) :=
                by
                  simpa [Functions.Source.Block.runOpen,
                    Functions.Source.Stmt.run, Functions.Source.Expr.evalOne,
                    hEval, stateAfterLet, ctxAfterLet,
                    Functions.Source.Outcome.regular,
                    Locals.Source.Outcome.regular] using hPre
              rcases
                  ih (suffix := suffix) (ctx := ctxAfterLet) (midCtx := midCtx)
                    (finalCtx := finalCtx) (state := stateAfterLet)
                    (midState := midState) (finalState := finalState)
                    (preFuel := preFuel) (tailFuel := tailFuel)
                    hRestRun hTail with
                ⟨combinedFuel, hCombined⟩
              exact
                ⟨combinedFuel.succ,
                  by
                    simpa [Functions.Source.Block.runOpen,
                      Functions.Source.Stmt.run, Functions.Source.Expr.evalOne,
                      hEval, stateAfterLet, ctxAfterLet,
                      Functions.Source.Outcome.regular,
                      Locals.Source.Outcome.regular] using hCombined⟩

theorem generatedPrelude_runOpen_append_exists
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} :
    ∀ {pre suffix : List Functions.Stmt}
      {ctx midCtx finalCtx : Functions.Source.Ctx}
      {state midState : Objects.Source.State}
      {outcome : Objects.Source.Outcome}
      {preFuel tailFuel : Nat},
      GeneratedPrelude pre →
      Functions.Source.Block.runOpen prim program ctx preFuel
          { stmts := pre } state =
        .ok (Functions.Source.Outcome.regular midState, midCtx) →
      Functions.Source.Block.runOpen prim program midCtx tailFuel
          { stmts := suffix } midState =
        .ok (outcome, finalCtx) →
      ∃ fuel,
        Functions.Source.Block.runOpen prim program ctx fuel
            { stmts := pre ++ suffix } state =
          .ok (outcome, finalCtx) := by
  intro pre suffix ctx midCtx finalCtx state midState outcome preFuel tailFuel
    hPreShape
  induction hPreShape generalizing suffix ctx midCtx finalCtx state midState
      outcome preFuel tailFuel with
  | nil =>
      intro hPre hTail
      cases preFuel with
      | zero =>
          simp [Functions.Source.Block.runOpen, Functions.Source.invalid,
            Structured.invalid] at hPre
      | succ preFuel =>
          have hPair :
              (Functions.Source.Outcome.regular state, ctx) =
                (Functions.Source.Outcome.regular midState, midCtx) := by
            simpa [Functions.Source.Block.runOpen] using hPre
          injection hPair with hState hCtx
          cases hState
          cases hCtx
          exact ⟨tailFuel, by simpa using hTail⟩
  | let_ hRest ih =>
      rename_i name expr rest
      intro hPre hTail
      cases preFuel with
      | zero =>
          simp [Functions.Source.Block.runOpen, Functions.Source.invalid,
            Structured.invalid] at hPre
      | succ preFuel =>
          cases hEval :
              Functions.Source.Expr.evalOne prim expr state with
          | error err =>
              simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
                hEval] at hPre
          | ok evalResult =>
              rcases evalResult with ⟨stateAfterValue, value⟩
              let stateAfterLet := stateAfterValue.insert name value
              let ctxAfterLet := { ctx with scope := name :: ctx.scope }
              have hRestRun :
                  Functions.Source.Block.runOpen prim program ctxAfterLet
                      preFuel { stmts := rest } stateAfterLet =
                    .ok (Functions.Source.Outcome.regular midState, midCtx) :=
                by
                  simpa [Functions.Source.Block.runOpen,
                    Functions.Source.Stmt.run, Functions.Source.Expr.evalOne,
                    hEval, stateAfterLet, ctxAfterLet,
                    Functions.Source.Outcome.regular,
                    Locals.Source.Outcome.regular] using hPre
              rcases
                  ih (suffix := suffix) (ctx := ctxAfterLet) (midCtx := midCtx)
                    (finalCtx := finalCtx) (state := stateAfterLet)
                    (midState := midState) (outcome := outcome)
                    (preFuel := preFuel) (tailFuel := tailFuel)
                    hRestRun hTail with
                ⟨combinedFuel, hCombined⟩
              exact
                ⟨combinedFuel.succ,
                  by
                    simpa [Functions.Source.Block.runOpen,
                      Functions.Source.Stmt.run, Functions.Source.Expr.evalOne,
                      hEval, stateAfterLet, ctxAfterLet,
                      Functions.Source.Outcome.regular,
                      Locals.Source.Outcome.regular] using hCombined⟩

theorem generatedPrelude_runOpen_regular_preserves_contains
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} :
    ∀ {pre : List Functions.Stmt}
      {ctx ctxAfter : Functions.Source.Ctx}
      {state stateAfter : Objects.Source.State}
      {fuel : Nat} {name : Name},
      GeneratedPrelude pre →
      Functions.Source.Block.runOpen prim program ctx fuel
          { stmts := pre } state =
        .ok (Functions.Source.Outcome.regular stateAfter, ctxAfter) →
      state.vars.contains name = true →
      stateAfter.vars.contains name = true := by
  intro pre ctx ctxAfter state stateAfter fuel target hPreShape
  induction hPreShape generalizing ctx ctxAfter state stateAfter fuel target with
  | nil =>
      intro hRun hContains
      cases fuel with
      | zero =>
          simp [Functions.Source.Block.runOpen, Functions.Source.invalid,
            Structured.invalid] at hRun
      | succ fuel =>
          have hPair :
              (Functions.Source.Outcome.regular state, ctx) =
                (Functions.Source.Outcome.regular stateAfter, ctxAfter) := by
            simpa [Functions.Source.Block.runOpen] using hRun
          injection hPair with hState _hCtx
          cases hState
          exact hContains
  | let_ hRest ih =>
      rename_i tmp expr rest
      intro hRun hContains
      cases fuel with
      | zero =>
          simp [Functions.Source.Block.runOpen, Functions.Source.invalid,
            Structured.invalid] at hRun
      | succ fuel =>
          cases hEval :
              Functions.Source.Expr.evalOne prim expr state with
          | error err =>
              simp [Functions.Source.Block.runOpen, Functions.Source.Stmt.run,
                hEval] at hRun
          | ok evalResult =>
              rcases evalResult with ⟨stateAfterValue, value⟩
              let stateAfterLet := stateAfterValue.insert tmp value
              let ctxAfterLet := { ctx with scope := tmp :: ctx.scope }
              have hRestRun :
                  Functions.Source.Block.runOpen prim program ctxAfterLet fuel
                      { stmts := rest } stateAfterLet =
                    .ok (Functions.Source.Outcome.regular stateAfter,
                      ctxAfter) := by
                simpa [Functions.Source.Block.runOpen,
                  Functions.Source.Stmt.run, Functions.Source.Expr.evalOne,
                  hEval, stateAfterLet, ctxAfterLet,
                  Functions.Source.Outcome.regular,
                  Locals.Source.Outcome.regular] using hRun
              have hEvalVars :
                  stateAfterValue.vars = state.vars :=
                Locals.Source.Expr.evalOne_vars_eq
                  (prim := prim) (expr := expr) (state := state)
                  (state' := stateAfterValue) (value := value) hEval
              have hContainsAfterValue :
                  stateAfterValue.vars.contains target = true := by
                simpa [Locals.Source.Store.contains, hEvalVars] using
                  hContains
              have hContainsAfterLet :
                  stateAfterLet.vars.contains target = true := by
                by_cases hEq : target = tmp
                · subst target
                  simp [stateAfterLet, Locals.Source.State.insert,
                    Locals.Source.Store.contains]
                · have hContainsInsert :
                      Locals.Source.Store.contains
                        (Locals.Source.Store.insert stateAfterValue.vars tmp
                          value) target = true := by
                    unfold Locals.Source.Store.contains
                    rw [Locals.Source.Store.insert_of_ne
                      (store := stateAfterValue.vars) (name := tmp)
                      (other := target) (value := value) hEq]
                    exact hContainsAfterValue
                  simpa [stateAfterLet, Locals.Source.State.insert] using
                    hContainsInsert
              exact ih hRestRun hContainsAfterLet


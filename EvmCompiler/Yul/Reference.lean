/--
Concrete source/target state relation used by future per-construct bridge
lemmas.  It relates only ordinary `Ok` Yul states to compiler EVM states; Yul
control checkpoints are handled by the statement/result bridge rather than by
pretending they are ordinary EVM states.
-/
inductive CompilerStateRel (cfg : StateRelConfig) (layout : List Name) :
    State → EVMState → Prop where
  | ok {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
      {compiler : EVMState}
      (hShared : SharedStateRel cfg shared compiler.toSharedState)
      (hVars : cfg.varStackRel layout store compiler.stack) :
      CompilerStateRel cfg layout (.Ok shared store) compiler

/--
Variant of `CompilerStateRel` for expression bridge lemmas.

`temps` are compiler-owned temporary values above the local-variable stack.
The Yul varstore still relates only to the `locals` suffix. This keeps the
future expression proof from weakening the strict local-variable relation.
-/
inductive CompilerStateRelWithTemps (cfg : StateRelConfig)
    (layout : List Name) (temps : EvmYul.Stack Word) :
    State → EVMState → Prop where
  | ok {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
      {compiler : EVMState} {locals : EvmYul.Stack Word}
      (hShared : SharedStateRel cfg shared compiler.toSharedState)
      (hVars : cfg.varStackRel layout store locals)
      (hStack : compiler.stack = temps ++ locals) :
      CompilerStateRelWithTemps cfg layout temps (.Ok shared store) compiler

/--
Variant of `CompilerStateRel` for compiler-owned local variables.

Expression lowering can emit a target-only prelude such as a fresh temporary for
a user-call result. Those names extend the compiler `Ctx.layout`, but they do
not exist in the imported Yul varstore. `hiddenLayout` names the compiler-only
pushed, and the source varstore relates only to the `sourceLayout` suffix.
-/
inductive CompilerStateRelWithHiddenLocals (cfg : StateRelConfig)
    (sourceLayout hiddenLayout : List Name) : State → EVMState → Prop where
  | ok {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
      {compiler : EVMState} {hiddenValues locals : EvmYul.Stack Word}
      (hShared : SharedStateRel cfg shared compiler.toSharedState)
      (hVars : cfg.varStackRel sourceLayout store locals)
      (hHiddenLength : hiddenValues.length = hiddenLayout.length)
      (hStack : compiler.stack = hiddenValues ++ locals) :
      CompilerStateRelWithHiddenLocals cfg sourceLayout hiddenLayout
        (.Ok shared store) compiler

/--
Expression-result temporaries above compiler-owned hidden locals.

The stack shape is `temps ++ hiddenValues ++ sourceLocals`. Source variables
are still related only to `sourceLocals`; hidden compiler locals and transient
expression results are intentionally absent from the imported Yul varstore.
-/
inductive CompilerStateRelWithTempsAndHiddenLocals (cfg : StateRelConfig)
    (sourceLayout hiddenLayout : List Name) (temps : EvmYul.Stack Word) :
    State → EVMState → Prop where
  | ok {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
      {compiler : EVMState} {hiddenValues locals : EvmYul.Stack Word}
      (hShared : SharedStateRel cfg shared compiler.toSharedState)
      (hVars : cfg.varStackRel sourceLayout store locals)
      (hHiddenLength : hiddenValues.length = hiddenLayout.length)
      (hStack : compiler.stack = temps ++ hiddenValues ++ locals) :
      CompilerStateRelWithTempsAndHiddenLocals cfg sourceLayout hiddenLayout
        temps (.Ok shared store) compiler

/--
Source-variable relation for a full compiler locals layout.

The source layout names only variables visible in the imported Yul varstore.
The full compiler layout may additionally contain generated temporaries, and
those temporaries may be interleaved with source locals. For every source
variable, this relation records a concrete stack slot in the full layout whose
value agrees with the imported varstore.
-/
def VisibleVarSlotRel (sourceLayout fullLayout : List Name)
    (store : EvmYul.Yul.VarStore) (stack : EvmYul.Stack Word) : Prop :=
  Locals.StackLowering.VisibleLookupSlotRel sourceLayout fullLayout
    store.lookup stack

/--
A named value at a concrete compiler-layout slot.

Unlike `VisibleVarSlotRel`, this is not restricted to source-visible Yul
variables. It is the small invariant needed for compiler-generated temporaries:
once an expression result has been bound into a hidden local, later expression
lowering may push more hidden locals above it, but the value is still available
through its declared layout slot.

The predicate itself is target-side and owned by `Yul.ArgSlots`; the reference
bridge keeps this alias so older theorem statements remain stable while the
lower module is the canonical definition.
-/
abbrev LayoutSlotValue :=
  Yul.ArgSlots.LayoutSlotValue

/--
General source/target state relation for compiler layouts containing
source-visible locals plus compiler-generated locals.

This is the intended replacement for proof paths that assumed generated locals
form a clean pushed above all source locals. It keeps the imported Yul store
strict, but lets source locals live at proven slots in the full compiler layout.
-/
inductive CompilerStateRelWithLayoutSlots (cfg : StateRelConfig)
    (sourceLayout fullLayout : List Name) : State → EVMState → Prop where
  | ok {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
      {compiler : EVMState}
      (hShared : SharedStateRel cfg shared compiler.toSharedState)
      (hVars : VisibleVarSlotRel sourceLayout fullLayout store compiler.stack)
      (hCover : fullLayout.length ≤ compiler.stack.length) :
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Ok shared store) compiler

/--
Expression temporaries above a full compiler layout.

The target stack is `temps ++ stack`, where `stack` contains the full compiler
layout. Source-visible variables are related only through their named slots in
that underlying full-layout stack.
-/
inductive CompilerStateRelWithTempsAndLayoutSlots (cfg : StateRelConfig)
    (sourceLayout fullLayout : List Name) (temps : EvmYul.Stack Word) :
    State → EVMState → Prop where
  | ok {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
      {compiler : EVMState} {stack : EvmYul.Stack Word}
      (hShared : SharedStateRel cfg shared compiler.toSharedState)
      (hVars : VisibleVarSlotRel sourceLayout fullLayout store stack)
      (hCover : fullLayout.length ≤ stack.length)
      (hStack : compiler.stack = temps ++ stack) :
      CompilerStateRelWithTempsAndLayoutSlots cfg sourceLayout fullLayout
        temps (.Ok shared store) compiler

namespace CompilerStateRel

theorem openExternalCallContextRel
    {cfg : StateRelConfig} {layout : List Name}
    {source : State} {compiler : EVMState}
    (hRel : CompilerStateRel cfg layout source compiler) :
    OpenExternal.CallContextRel
      (OpenExternal.CallContext.ofYulState source)
      (OpenExternal.CallContext.ofEVMState compiler) := by
  cases hRel with
  | ok hShared _hVars =>
      simpa [OpenExternal.CallContext.ofYulState,
        OpenExternal.CallContext.ofEVMState]
        using hShared.openExternalCallContextRel

theorem withTemps_nil {cfg : StateRelConfig} {layout : List Name}
    {state : State} {compiler : EVMState}
    (hRel : CompilerStateRel cfg layout state compiler) :
    CompilerStateRelWithTemps cfg layout [] state compiler := by
  cases hRel with
  | ok hShared hVars =>
      exact CompilerStateRelWithTemps.ok hShared hVars (by simp)

theorem withHidden_nil {cfg : StateRelConfig} {layout : List Name}
    {state : State} {compiler : EVMState}
    (hRel : CompilerStateRel cfg layout state compiler) :
    CompilerStateRelWithHiddenLocals cfg layout [] state compiler := by
  cases hRel with
  | ok hShared hVars =>
      exact
        CompilerStateRelWithHiddenLocals.ok
          (hiddenValues := []) (locals := compiler.stack)
          hShared hVars rfl (by simp)

end CompilerStateRel

namespace CompilerStateRelWithTemps

theorem openExternalCallContextRel
    {cfg : StateRelConfig} {layout : List Name} {temps : EvmYul.Stack Word}
    {source : State} {compiler : EVMState}
    (hRel : CompilerStateRelWithTemps cfg layout temps source compiler) :
    OpenExternal.CallContextRel
      (OpenExternal.CallContext.ofYulState source)
      (OpenExternal.CallContext.ofEVMState compiler) := by
  cases hRel with
  | ok hShared _hVars _hStack =>
      simpa [OpenExternal.CallContext.ofYulState,
        OpenExternal.CallContext.ofEVMState]
        using hShared.openExternalCallContextRel

end CompilerStateRelWithTemps

namespace CompilerStateRelWithHiddenLocals

theorem withTemps_nil {cfg : StateRelConfig}
    {sourceLayout hiddenLayout : List Name} {state : State}
    {compiler : EVMState}
    (hRel :
      CompilerStateRelWithHiddenLocals cfg sourceLayout hiddenLayout state
        compiler) :
    CompilerStateRelWithTempsAndHiddenLocals cfg sourceLayout hiddenLayout []
      state compiler := by
  cases hRel with
  | ok hShared hVars hHiddenLength hStack =>
      exact
        CompilerStateRelWithTempsAndHiddenLocals.ok hShared hVars
          hHiddenLength (by simpa using hStack)

end CompilerStateRelWithHiddenLocals

namespace CompilerStateRelWithTemps

theorem pushIncr {cfg : StateRelConfig} {layout : List Name}
    {temps : EvmYul.Stack Word} {state : State} {compiler : EVMState}
    (value : Word) (pcΔ : Nat)
    (hRel : CompilerStateRelWithTemps cfg layout temps state compiler) :
    CompilerStateRelWithTemps cfg layout (value :: temps) state
      (compiler.replaceStackAndIncrPC (value :: compiler.stack) (pcΔ := pcΔ)) := by
  cases hRel with
  | ok hShared hVars hStack =>
      refine CompilerStateRelWithTemps.ok ?shared hVars ?stack
      · simpa [EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC] using hShared
      · simp [EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC, hStack]

end CompilerStateRelWithTemps

namespace CompilerStateRelWithTempsAndHiddenLocals

theorem pushIncr {cfg : StateRelConfig}
    {sourceLayout hiddenLayout : List Name} {temps : EvmYul.Stack Word}
    {state : State} {compiler : EVMState}
    (value : Word) (pcΔ : Nat)
    (hRel :
      CompilerStateRelWithTempsAndHiddenLocals cfg sourceLayout hiddenLayout
        temps state compiler) :
    CompilerStateRelWithTempsAndHiddenLocals cfg sourceLayout hiddenLayout
      (value :: temps) state
      (compiler.replaceStackAndIncrPC (value :: compiler.stack) (pcΔ := pcΔ)) := by
  cases hRel with
  | ok hShared hVars hHiddenLength hStack =>
      refine CompilerStateRelWithTempsAndHiddenLocals.ok ?shared hVars
        hHiddenLength ?stack
      · simpa [EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC] using hShared
      · simp [EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC, hStack]

end CompilerStateRelWithTempsAndHiddenLocals

/--
Concrete stack interpretation for Yul locals.

`layout` is ordered like the compiler locals layout: the first name is the
top stack slot. It is deliberately strict: every live source variable must be
present in the imported Yul varstore, so the bridge cannot silently rely on the
upstream `lookup!` default for missing variables.
-/
def ExactVarStackRel (layout : List Name)
    (store : EvmYul.Yul.VarStore) (stack : EvmYul.Stack Word) : Prop :=
  VarStackRel.exact layout store stack

/--
Return values pushed for a Yul `leave`/regular function return.

The compiler stack has the last return value on top, while the source return
list is ordered syntactically.  Reversing the stack pushed lets us reuse the
same strict varstore relation as ordinary locals.
-/
def ReturnStackRel (returns : List Name)
    (store : EvmYul.Yul.VarStore) (temps : EvmYul.Stack Word) : Prop :=
  ExactVarStackRel returns store temps.reverse

theorem ExactVarStackRel.nil (store : EvmYul.Yul.VarStore) :
    ExactVarStackRel [] store [] := by
  exact VarStackRel.exact_nil store

theorem ExactVarStackRel.cons {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    {name : Name} {value : Word}
    (hLookup : store.lookup name = some value)
    (hRel : ExactVarStackRel layout store stack) :
    ExactVarStackRel (name :: layout) store (value :: stack) := by
  exact VarStackRel.exact_cons hLookup hRel

theorem ExactVarStackRel.get? {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    (hRel : ExactVarStackRel layout store stack) {idx : Nat} {name : Name}
    (hName : layout[idx]? = some name) :
    ∃ value, stack[idx]? = some value ∧
      store.lookup name = some value := by
  exact VarStackRel.exact_get? hRel hName

theorem ExactVarStackRel.drop {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    (n : Nat) (hRel : ExactVarStackRel layout store stack) :
    ExactVarStackRel (layout.drop n) store (stack.drop n) := by
  exact VarStackRel.exact_drop n hRel

theorem ExactVarStackRel.cons_insert {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    {name : Name} {value : Word}
    (hFresh : name ∉ layout)
    (hRel : ExactVarStackRel layout store stack) :
            ExactVarStackRel (name :: layout) (store.insert name value)
      (value :: stack) := by
  exact
    VarStackRel.exact_cons_insert
      (fun existing hMem hEq => hFresh (by simpa [hEq] using hMem))
      hRel

theorem ExactVarStackRel.insertPairs {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    (pairs : List (Name × Word))
    (hNoDup : (pairs.map Prod.fst).Nodup)
    (hFresh :
      ∀ name, name ∈ pairs.map Prod.fst → name ∉ layout)
    (hRel : ExactVarStackRel layout store stack) :
    ExactVarStackRel ((pairs.map Prod.fst).reverse ++ layout)
      (VarStackRel.insertPairs pairs store)
      ((pairs.map Prod.snd).reverse ++ stack) := by
  exact
    VarStackRel.exact_insertPairs_append pairs hNoDup
      (fun name hMem existing hExisting hEq =>
        hFresh name hMem (by simpa [hEq] using hExisting))
      hRel

theorem ExactVarStackRel.insertZeros {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    (names : List Name)
    (hNoDup : names.Nodup)
    (hFresh : ∀ name, name ∈ names → name ∉ layout)
    (hRel : ExactVarStackRel layout store stack) :
    ExactVarStackRel (names.reverse ++ layout)
      (VarStackRel.insertPairs (VarStackRel.zeroPairs names) store)
      (((VarStackRel.zeroPairs names).map Prod.snd).reverse ++ stack) := by
  exact VarStackRel.exact_insertZeros_append names hNoDup hFresh hRel

theorem ExactVarStackRel.assign {layout : List Name}
    {store : EvmYul.Yul.VarStore} {stack : EvmYul.Stack Word}
    {name : Name} {value : Word} {idx : Nat}
    (hNoDup : layout.Nodup)
    (hName : layout[idx]? = some name)
    (hRel : ExactVarStackRel layout store stack) :
    ExactVarStackRel layout (store.insert name value)
      (stack.take idx ++ value :: stack.drop (idx + 1)) := by
  induction hRel generalizing idx with
  | nil =>
      cases idx <;> simp at hName
  | cons hLookup hTail ih =>
      rename_i head oldValue tailLayout tailStack
      cases idx with
      | zero =>
          simp at hName
          subst name
          have hTailFresh :
              ∀ existing, existing ∈ tailLayout → existing ≠ head := by
            intro existing hMem hEq
            have hNotMem := (List.nodup_cons.mp hNoDup).1
            exact hNotMem (by simpa [hEq] using hMem)
          have hTailPreserved :
              ExactVarStackRel tailLayout (store.insert head value)
                tailStack :=
            VarStackRel.exact_insert_preserve hTailFresh hTail
          exact
            ExactVarStackRel.cons (Finmap.lookup_insert store)
              hTailPreserved
      | succ idx =>
          have hTailName : tailLayout[idx]? = some name := by
            simpa using hName
          have hTailNoDup : tailLayout.Nodup :=
            (List.nodup_cons.mp hNoDup).2
          have hHeadNe : head ≠ name := by
            intro hEq
            have hNameMemTail : name ∈ tailLayout :=
              List.mem_of_getElem? hTailName
            have hHeadNotMemTail := (List.nodup_cons.mp hNoDup).1
            exact hHeadNotMemTail (by simpa [hEq] using hNameMemTail)
          have hHeadLookup :
              (store.insert name value).lookup head = some oldValue := by
            rw [Finmap.lookup_insert_of_ne]
            · exact hLookup
            · exact hHeadNe
          exact
            ExactVarStackRel.cons hHeadLookup
              (ih hTailNoDup hTailName)

theorem ExactVarStackRel.restrictVarStore_of_scope_contains
    {layout : List Name} {store scope : EvmYul.Yul.VarStore}
    {stack : EvmYul.Stack Word}
    (hRel : ExactVarStackRel layout store stack)
    (hScope :
      ∀ name, name ∈ layout → (scope.lookup name).isSome = true) :
    ExactVarStackRel layout
      (EvmYul.Yul.State.restrictVarStore store scope) stack := by
  induction hRel with
  | nil =>
      exact ExactVarStackRel.nil _
  | cons hLookup hTail ih =>
      rename_i name value tailLayout tailStack
      have hScopeSome : (scope.lookup name).isSome = true :=
        hScope name (by simp)
      cases hScopeLookup : scope.lookup name with
      | none =>
          simp [hScopeLookup] at hScopeSome
      | some scopeValue =>
          have hHead :
              (EvmYul.Yul.State.restrictVarStore store scope).lookup name =
                some value := by
            rw [FinmapFacts.lookup_restrictVarStore_of_scope_some
              store scope name hScopeLookup]
            exact hLookup
          exact
            ExactVarStackRel.cons hHead
              (ih (fun tailName hMem =>
                hScope tailName (by simp [hMem])))

/--
Exact domain invariant for the imported Yul varstore.

`ExactVarStackRel` proves that every live compiler slot reads the same value as
the corresponding source variable.  Declaration checking also needs the
converse: variables outside the visible source environment are not already
declared in the imported varstore.
-/
def StoreDomainExact (layout : List Name)
    (store : EvmYul.Yul.VarStore) : Prop :=
  ∀ name : Name, (store.lookup name).isSome = true ↔ name ∈ layout

namespace StoreDomainExact

theorem empty :
    StoreDomainExact [] (default : EvmYul.Yul.VarStore) := by
  intro name
  change
    (Finmap.lookup name (∅ : EvmYul.Yul.VarStore)).isSome = true ↔
      name ∈ ([] : List Name)
  simp

theorem insert {layout : List Name} {store : EvmYul.Yul.VarStore}
    {name : Name} {value : Word}
    (hDomain : StoreDomainExact layout store) :
    StoreDomainExact (name :: layout) (store.insert name value) := by
  intro query
  by_cases hEq : query = name
  · subst query
    simp [Finmap.lookup_insert]
  · rw [Finmap.lookup_insert_of_ne]
    · constructor
      · intro hSome
        have hLayout : query ∈ layout := (hDomain query).mp hSome
        simpa [hEq] using hLayout
      · intro hMem
        have hLayout : query ∈ layout := by
          simpa [hEq] using hMem
        exact (hDomain query).mpr hLayout
    · exact hEq

theorem insertPairs (pairs : List (Name × Word)) {layout : List Name}
    {store : EvmYul.Yul.VarStore}
    (hDomain : StoreDomainExact layout store) :
    StoreDomainExact (pairs.map Prod.fst ++ layout)
      (VarStackRel.insertPairs pairs store) := by
  induction pairs generalizing store with
  | nil =>
      simpa [VarStackRel.insertPairs] using hDomain
  | cons pair rest ih =>
      cases pair with
      | mk name value =>
          have hRest :
              StoreDomainExact (rest.map Prod.fst ++ layout)
                (VarStackRel.insertPairs rest store) :=
            ih hDomain
          simpa [VarStackRel.insertPairs] using
            (insert (layout := rest.map Prod.fst ++ layout)
              (store := VarStackRel.insertPairs rest store)
              (name := name) (value := value) hRest)

theorem insertZeros (names : List Name) {layout : List Name}
    {store : EvmYul.Yul.VarStore}
    (hDomain : StoreDomainExact layout store) :
    StoreDomainExact (names.reverse ++ layout)
      (VarStackRel.insertPairs (VarStackRel.zeroPairs names) store) := by
  have hPairs :=
    insertPairs (pairs := VarStackRel.zeroPairs names)
      (layout := layout) hDomain
  intro name
  constructor
  · intro hSome
    have hMem : name ∈ names ++ layout := by
      simpa [VarStackRel.zeroPairs] using (hPairs name).mp hSome
    simpa [List.mem_reverse, or_comm, or_left_comm, or_assoc] using hMem
  · intro hMem
    have hMem' : name ∈ names ++ layout := by
      simpa [List.mem_reverse, or_comm, or_left_comm, or_assoc] using hMem
    exact (hPairs name).mpr (by simpa [VarStackRel.zeroPairs] using hMem')

theorem firstDuplicate?_none_of_nodup
    (names : List EvmYul.Identifier) (hNoDup : names.Nodup) :
    EvmYul.Yul.firstDuplicate? names = none := by
  induction names with
  | nil =>
      rfl
  | cons name rest ih =>
      have hNotMem : name ∉ rest := (List.nodup_cons.mp hNoDup).1
      have hRestNoDup : rest.Nodup := (List.nodup_cons.mp hNoDup).2
      simp [EvmYul.Yul.firstDuplicate?, hNotMem, ih hRestNoDup]

theorem firstDeclared?_none {layout : List Name}
    {store : EvmYul.Yul.VarStore} {shared : EvmYul.SharedState .Yul}
    {names : List EvmYul.Identifier}
    (hDomain : StoreDomainExact layout store)
    (hFresh : ∀ name, name ∈ identNames names → name ∉ layout) :
    EvmYul.Yul.firstDeclared? (.Ok shared store) names = none := by
  unfold EvmYul.Yul.firstDeclared?
  apply List.find?_eq_none.mpr
  intro name hMem
  have hFreshName : identName name ∉ layout :=
    hFresh (identName name) (by simpa [identNames, identName] using hMem)
  have hNotSome : (store.lookup (identName name)).isSome = false := by
    cases hSome : (store.lookup (identName name)).isSome
    · rfl
    · have hIn : identName name ∈ layout :=
        (hDomain (identName name)).mp hSome
      exact False.elim (hFreshName hIn)
  simpa [EvmYul.Yul.State.lookup?, identName] using hNotSome

theorem checkDeclaration_ok {layout : List Name}
    {store : EvmYul.Yul.VarStore} {shared : EvmYul.SharedState .Yul}
    {names : List EvmYul.Identifier}
    (hDomain : StoreDomainExact layout store)
    (hNoDup : (identNames names).Nodup)
    (hFresh : ∀ name, name ∈ identNames names → name ∉ layout) :
    EvmYul.Yul.checkDeclaration (.Ok shared store) names = .ok () := by
  have hNoDupNames : names.Nodup := by
    exact List.Nodup.of_map (f := identName) (by simpa [identNames] using hNoDup)
  simp [EvmYul.Yul.checkDeclaration,
    firstDuplicate?_none_of_nodup names hNoDupNames,
    firstDeclared?_none (layout := layout) (store := store)
      (shared := shared) (names := names) hDomain hFresh]

theorem firstUndeclared?_none {layout : List Name}
    {store : EvmYul.Yul.VarStore} {shared : EvmYul.SharedState .Yul}
    {names : List EvmYul.Identifier}
    (hDomain : StoreDomainExact layout store)
    (hDeclared : ∀ name, name ∈ identNames names → name ∈ layout) :
    EvmYul.Yul.firstUndeclared? (.Ok shared store) names = none := by
  unfold EvmYul.Yul.firstUndeclared?
  apply List.find?_eq_none.mpr
  intro name hMem
  have hDeclaredName : identName name ∈ layout :=
    hDeclared (identName name) (by simpa [identNames, identName] using hMem)
  have hSome : (store.lookup (identName name)).isSome = true :=
    (hDomain (identName name)).mpr hDeclaredName
  cases hLookup : store.lookup (identName name) with
  | none =>
      simp [hLookup] at hSome
  | some value =>
      have hLookupName : store.lookup name = some value := by
        simpa [identName] using hLookup
      simpa [EvmYul.Yul.State.lookup?, hLookupName]

theorem checkAssignment_ok {layout : List Name}
    {store : EvmYul.Yul.VarStore} {shared : EvmYul.SharedState .Yul}
    {names : List EvmYul.Identifier}
    (hDomain : StoreDomainExact layout store)
    (hNoDup : (identNames names).Nodup)
    (hDeclared : ∀ name, name ∈ identNames names → name ∈ layout) :
    EvmYul.Yul.checkAssignment (.Ok shared store) names = .ok () := by
  have hNoDupNames : names.Nodup := by
    exact List.Nodup.of_map (f := identName) (by simpa [identNames] using hNoDup)
  simp [EvmYul.Yul.checkAssignment,
    firstDuplicate?_none_of_nodup names hNoDupNames,
    firstUndeclared?_none (layout := layout) (store := store)
      (shared := shared) (names := names) hDomain hDeclared]

theorem contains_of_mem {layout : List Name}
    {store : EvmYul.Yul.VarStore}
    (hDomain : StoreDomainExact layout store)
    {name : Name} (hMem : name ∈ layout) :
    (store.lookup name).isSome = true :=
  (hDomain name).mpr hMem

theorem contains_of_subset {layout sublayout : List Name}
    {store : EvmYul.Yul.VarStore}
    (hDomain : StoreDomainExact layout store)
    (hSubset : ∀ name, name ∈ sublayout → name ∈ layout) :
    ∀ name, name ∈ sublayout → (store.lookup name).isSome = true :=
  fun name hMem => contains_of_mem hDomain (hSubset name hMem)

theorem insert_mem {layout : List Name} {store : EvmYul.Yul.VarStore}
    {name : Name} {value : Word}
    (hDomain : StoreDomainExact layout store)
    (hMem : name ∈ layout) :
    StoreDomainExact layout (store.insert name value) := by
  intro query
  by_cases hEq : query = name
  · subst query
    simp [Finmap.lookup_insert, hMem]
  · rw [Finmap.lookup_insert_of_ne]
    · exact hDomain query
    · exact hEq

end StoreDomainExact

theorem ExactVarStackRel.restrictVarStore_of_domain
    {layout : List Name} {store scope : EvmYul.Yul.VarStore}
    {stack : EvmYul.Stack Word}
    (hDomain : StoreDomainExact layout scope)
    (hRel : ExactVarStackRel layout store stack) :
    ExactVarStackRel layout
      (EvmYul.Yul.State.restrictVarStore store scope) stack :=
  ExactVarStackRel.restrictVarStore_of_scope_contains hRel
    (fun name hMem => (hDomain name).mpr hMem)

theorem CompilerStateRel.restrictVarStore_of_scope_contains
    {cfg : StateRelConfig} {layout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store scope : EvmYul.Yul.VarStore} {compiler : EVMState}
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (hScope :
      ∀ name, name ∈ layout → (scope.lookup name).isSome = true)
    (hRel : CompilerStateRel cfg layout (.Ok shared store) compiler) :
    CompilerStateRel cfg layout
      (.Ok shared (EvmYul.Yul.State.restrictVarStore store scope))
      compiler := by
  cases hRel with
  | ok hShared hVars =>
      have hExact :
          ExactVarStackRel layout store compiler.stack := by
        simpa [hVarRelExact] using hVars
      have hRestricted :
          ExactVarStackRel layout
            (EvmYul.Yul.State.restrictVarStore store scope)
            compiler.stack :=
        ExactVarStackRel.restrictVarStore_of_scope_contains hExact hScope
      exact CompilerStateRel.ok hShared (by
        simpa [hVarRelExact] using hRestricted)

theorem CompilerStateRel.restrictVarStore_of_domain_exact
    {cfg : StateRelConfig} {layout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store scope : EvmYul.Yul.VarStore} {compiler : EVMState}
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (hDomain : StoreDomainExact layout scope)
    (hRel : CompilerStateRel cfg layout (.Ok shared store) compiler) :
    CompilerStateRel cfg layout
      (.Ok shared (EvmYul.Yul.State.restrictVarStore store scope))
      compiler :=
  CompilerStateRel.restrictVarStore_of_scope_contains
    hVarRelExact (fun name hMem => (hDomain name).mpr hMem) hRel

theorem CompilerStateRelWithTemps.bindSingleExact {cfg : StateRelConfig}
    {layout : List Name} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : EVMState}
    {name : Name} {value : Word}
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (hFresh : name ∉ layout)
    (hRel :
      CompilerStateRelWithTemps cfg layout [value] (.Ok shared store)
        compiler) :
    CompilerStateRel cfg (name :: layout) (.Ok shared (store.insert name value))
      compiler := by
  cases hRel with
  | ok hShared hVars hStack =>
      have hExtended :
          cfg.varStackRel (name :: layout) (store.insert name value)
            compiler.stack := by
        have hExactExtended :=
          ExactVarStackRel.cons_insert
            (layout := layout) (store := store) (name := name)
            (value := value) hFresh
            (by simpa [hVarRelExact] using hVars)
        simpa [hVarRelExact, hStack] using hExactExtended
      refine CompilerStateRel.ok hShared ?_
      exact hExtended

theorem CompilerStateRelWithTemps.bindZerosExact {cfg : StateRelConfig}
    {layout : List Name} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : EVMState}
    (names : List Name)
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (hNoDup : names.Nodup)
    (hFresh : ∀ name, name ∈ names → name ∉ layout)
    (hRel :
      CompilerStateRelWithTemps cfg layout
        (((VarStackRel.zeroPairs names).map Prod.snd).reverse)
        (.Ok shared store) compiler) :
    CompilerStateRel cfg (names.reverse ++ layout)
      (.Ok shared
        (VarStackRel.insertPairs (VarStackRel.zeroPairs names) store))
      compiler := by
  cases hRel with
  | ok hShared hVars hStack =>
      have hExtended :
          cfg.varStackRel (names.reverse ++ layout)
            (VarStackRel.insertPairs (VarStackRel.zeroPairs names) store)
            compiler.stack := by
        have hExactExtended :=
          ExactVarStackRel.insertZeros names hNoDup hFresh
            (by simpa [hVarRelExact] using hVars)
        simpa [hVarRelExact, hStack] using hExactExtended
      exact CompilerStateRel.ok hShared hExtended

namespace SourceBridgeFacts

/--
Source-side relation between an imported Yul varstore and the stack-free local
store used above the locals layer.  The relation is intentionally scoped: names
outside the source layout are not observable at this layer.
-/
def SourceStoreRel (layout : List Name)
    (store : EvmYul.Yul.VarStore) (vars : Locals.Source.Store) : Prop :=
  ∀ name, name ∈ layout → vars name = store.lookup name

theorem sourceStoreRel_insert_hidden
    {layout : List Name} {store : EvmYul.Yul.VarStore}
    {vars : Locals.Source.Store} {name : Name} {value : Word}
    (hRel : SourceStoreRel layout store vars)
    (hFresh : name ∉ layout) :
    SourceStoreRel layout store (Locals.Source.Store.insert vars name value) := by
  intro other hOther
  have hNe : other ≠ name := by
    intro hEq
    exact hFresh (by simpa [hEq] using hOther)
  rw [Locals.Source.Store.insert_of_ne hNe]
  exact hRel other hOther

theorem sourceStoreRel_cons_insert
    {layout : List Name} {store : EvmYul.Yul.VarStore}
    {vars : Locals.Source.Store} {name : Name} {value : Word}
    (hRel : SourceStoreRel layout store vars)
    (hFresh : name ∉ layout) :
    SourceStoreRel (name :: layout) (store.insert name value)
      (Locals.Source.Store.insert vars name value) := by
  intro key hKey
  simp only [List.mem_cons] at hKey
  rcases hKey with hEq | hMem
  · subst key
    simp [Locals.Source.Store.insert_self]
  · have hNe : key ≠ name := by
      intro hEq
      exact hFresh (by simpa [hEq] using hMem)
    rw [Locals.Source.Store.insert_of_ne hNe]
    rw [Finmap.lookup_insert_of_ne]
    · exact hRel key hMem
    · exact hNe

theorem sourceStoreRel_insert_visible
    {layout : List Name} {store : EvmYul.Yul.VarStore}
    {vars : Locals.Source.Store} {name : Name} {value : Word}
    (hRel : SourceStoreRel layout store vars) :
    SourceStoreRel layout (store.insert name value)
      (Locals.Source.Store.insert vars name value) := by
  intro key hKey
  by_cases hEq : key = name
  · subst key
    simp [Locals.Source.Store.insert_self]
  · rw [Locals.Source.Store.insert_of_ne hEq]
    rw [Finmap.lookup_insert_of_ne]
    · exact hRel key hKey
    · exact hEq

theorem word_bne_zero_true_of_ne {value : Word}
    (hNe : value ≠ EvmYul.UInt256.ofNat 0) :
    (value != EvmYul.UInt256.ofNat 0) = true := by
  cases value with
  | mk val =>
      change (val != (EvmYul.UInt256.ofNat 0).val) = true
      apply bne_iff_ne.mpr
      intro hVal
      apply hNe
      cases hVal
      rfl

theorem word_bne_zero_false_of_eq {value : Word}
    (hEq : value = EvmYul.UInt256.ofNat 0) :
    (value != EvmYul.UInt256.ofNat 0) = false := by
  cases value with
  | mk val =>
      change (val != (EvmYul.UInt256.ofNat 0).val) = false
      apply Bool.eq_false_iff.mpr
      intro hTrue
      have hNe : val ≠ (EvmYul.UInt256.ofNat 0).val :=
        (bne_iff_ne).mp hTrue
      apply hNe
      cases hEq
      rfl

theorem source_switch_select_eq_direct (value : Word) :
    ∀ (cases : List (Word × Functions.Block))
      (defaultBody : Option Functions.Block),
      Functions.Source.Switch.select value cases defaultBody =
        Functions.Switch.select value cases defaultBody
  | [], _defaultBody => rfl
  | (caseValue, body) :: rest, defaultBody => by
      by_cases hEq : caseValue = value
      · simp [Functions.Source.Switch.select, Functions.Switch.select, hEq]
      · simp [Functions.Source.Switch.select, Functions.Switch.select, hEq,
          source_switch_select_eq_direct value rest defaultBody]

theorem source_switch_select_some_of_direct {value : Word}
    {cases : List (Word × Functions.Block)}
    {defaultBody : Option Functions.Block} {selected : Functions.Block}
    (hSelect :
      Functions.Switch.select value cases defaultBody = some selected) :
    Functions.Source.Switch.select value cases defaultBody = some selected := by
  rw [source_switch_select_eq_direct]
  exact hSelect

theorem source_switch_select_none_of_direct {value : Word}
    {cases : List (Word × Functions.Block)}
    {defaultBody : Option Functions.Block}
    (hSelect :
      Functions.Switch.select value cases defaultBody = none) :
    Functions.Source.Switch.select value cases defaultBody = none := by
  rw [source_switch_select_eq_direct]
  exact hSelect

/--
Imported Yul state related to the stack-free source tower state.  Unlike the
legacy compiler relation, this has no operand stack, slot, layout-depth, DUP,
SWAP, POP, or cleanup component.
-/
inductive SourceStateRel (cfg : StateRelConfig) (layout : List Name) :
    State → Objects.Source.State → Prop where
  | ok {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
      {source : Objects.Source.State}
      (hShared : SharedStateRel cfg shared source.shared)
      (hVars : SourceStoreRel layout store source.vars) :
      SourceStateRel cfg layout (.Ok shared store) source

/--
Exact-domain version of `SourceStateRel`.

The stack-free source relation intentionally hides variables outside `layout`,
but imported Yul declaration and assignment checks observe whether a name is
already present in the varstore.  Recursive imported-Yul proofs that pass
through declarations or assignments therefore need this stronger source-state
invariant at the bridge boundary.
-/
inductive SourceStateExactRel (cfg : StateRelConfig) (layout : List Name) :
    State → Objects.Source.State → Prop where
  | ok {shared : EvmYul.SharedState .Yul} {store : EvmYul.Yul.VarStore}
      {source : Objects.Source.State}
      (hShared : SharedStateRel cfg shared source.shared)
      (hVars : SourceStoreRel layout store source.vars)
      (hDomain : StoreDomainExact layout store) :
      SourceStateExactRel cfg layout (.Ok shared store) source

namespace SourceStateRel

theorem storageImageRel
    {cfg : StateRelConfig} {layout : List Name}
    {source : State} {compiler : Objects.Source.State}
    (hRel : SourceStateRel cfg layout source compiler) :
    ∃ shared store,
      source = .Ok shared store ∧
        StorageImageRel shared.toState.accountMap
          compiler.shared.toState.accountMap := by
  cases hRel with
  | ok hShared _hVars =>
      exact ⟨_, _, rfl, SharedStateRel.storageImageRel hShared⟩

theorem transientStorageImageRel
    {cfg : StateRelConfig} {layout : List Name}
    {source : State} {compiler : Objects.Source.State}
    (hRel : SourceStateRel cfg layout source compiler) :
    ∃ shared store,
      source = .Ok shared store ∧
        TransientStorageImageRel shared.toState.accountMap
          compiler.shared.toState.accountMap := by
  cases hRel with
  | ok hShared _hVars =>
      exact ⟨_, _, rfl, SharedStateRel.transientStorageImageRel hShared⟩

theorem openExternalCallContextRel
    {cfg : StateRelConfig} {layout : List Name}
    {source : State} {compiler : Objects.Source.State}
    (hRel : SourceStateRel cfg layout source compiler) :
    OpenExternal.CallContextRel
      (OpenExternal.CallContext.ofYulState source)
      (OpenExternal.CallContext.ofEVMSharedState compiler.shared) := by
  cases hRel with
  | ok hShared _hVars =>
      simpa [OpenExternal.CallContext.ofYulState]
        using hShared.openExternalCallContextRel

theorem openExternalPrimitiveCallSite_eq_of_args
    {cfg : StateRelConfig} {layout : List Name}
    {source : State} {compiler : Objects.Source.State}
    (hRel : SourceStateRel cfg layout source compiler)
    (kind : OpenExternal.CallKind)
    (operands : OpenExternal.CallOperands) :
    kind.yulCallSite? source (kind.args operands) =
      OpenExternal.CallKind.primitiveCallSite? compiler.shared kind
        (kind.args operands).reverse := by
  have hContext := hRel.openExternalCallContextRel
  rw [OpenExternal.CallKind.primitiveCallSite?_args_reverse]
  cases kind <;>
    simp [OpenExternal.CallKind.yulCallSite?,
      OpenExternal.CallContextRel.callSite_eq hContext]

theorem openExternalPrimitiveCreateSite_eq_of_args
    {cfg : StateRelConfig} {layout : List Name}
    {source : State} {compiler : Objects.Source.State}
    (hRel : SourceStateRel cfg layout source compiler)
    (kind : OpenExternal.CreateKind)
    (operands : OpenExternal.CreateOperands) :
    kind.yulCreateSite? source (kind.args operands) =
      OpenExternal.CreateKind.primitiveCreateSite? compiler.shared kind
        (kind.args operands).reverse := by
  have hContext := hRel.openExternalCallContextRel
  rw [OpenExternal.CreateKind.primitiveCreateSite?_args_reverse]
  cases kind <;>
    simp [OpenExternal.CreateKind.yulCreateSite?,
      OpenExternal.CallContextRel.createSite_eq hContext]

def compilerPrimitiveOpenCall?
    (compiler : Objects.Source.State)
    (kind : OpenExternal.CallKind) (values : List Word) :
    Option
      (OpenExternal.OpenCall (Objects.Source.State × List Word)) :=
  match OpenExternal.CallKind.primitiveSharedOpenCall?
      compiler.shared kind values with
  | some call =>
      some
        { site := call.site
          resume := fun response =>
            (compiler.withShared (call.resume response).1,
              (call.resume response).2) }
  | none => none

def compilerPrimitiveOpenCreate?
    (compiler : Objects.Source.State)
    (kind : OpenExternal.CreateKind) (values : List Word) :
    Option
      (OpenExternal.OpenCreate (Objects.Source.State × List Word)) :=
  match OpenExternal.CreateKind.primitiveSharedOpenCreate?
      compiler.shared kind values with
  | some create =>
      some
        { site := create.site
          resume := fun response =>
            (compiler.withShared (create.resume response).1,
              (create.resume response).2) }
  | none => none

def OpenPrimitiveResultRel
    (cfg : StateRelConfig) (layout : List Name) :
    State × List Word → Objects.Source.State × List Word → Prop :=
  fun sourceResult compilerResult =>
    SourceStateRel cfg layout sourceResult.1 compilerResult.1 ∧
      sourceResult.2 = compilerResult.2

def CompilerPrimitiveEVMResultRel (baseStack : OpenExternal.Stack) :
    Objects.Source.State × List Word → EvmYul.EVM.State → Prop :=
  fun compilerResult evmResult =>
    evmResult.toSharedState = compilerResult.1.shared ∧
      evmResult.stack = compilerResult.2.reverse ++ baseStack

def OpenPrimitiveEVMResultRel
    (cfg : StateRelConfig) (layout : List Name)
    (baseStack : OpenExternal.Stack) :
    State × List Word → EvmYul.EVM.State → Prop :=
  fun sourceResult evmResult =>
    ∃ compilerResult,
      OpenPrimitiveResultRel cfg layout sourceResult compilerResult ∧
        CompilerPrimitiveEVMResultRel baseStack compilerResult evmResult

theorem compilerPrimitiveOpenCallRel_evmOpenCall_of_args
    {compiler : Objects.Source.State}
    {state : EvmYul.EVM.State}
    (hShared : state.toSharedState = compiler.shared)
    (kind : OpenExternal.CallKind)
    (operands : OpenExternal.CallOperands)
    (baseStack : OpenExternal.Stack) :
    ∃ compilerCall :
        OpenExternal.OpenCall (Objects.Source.State × List Word),
    ∃ evmCall : OpenExternal.OpenCall EvmYul.EVM.State,
      compilerPrimitiveOpenCall? compiler kind
          (kind.args operands).reverse =
        some compilerCall ∧
      OpenExternal.CallKind.evmOpenCall?
          ({ state with stack := kind.args operands ++ baseStack }
            : EvmYul.EVM.State) kind =
        some evmCall ∧
      OpenExternal.OpenCallRel
        (fun _ => True)
        (CompilerPrimitiveEVMResultRel baseStack) compilerCall evmCall := by
  rcases
      OpenExternal.CallKind.primitiveSharedOpenCallRel_evmOpenCall_of_args
        state hShared kind operands baseStack with
    ⟨primitiveCall, evmCall, hPrimitiveCall, hEVMCall, hPrimitiveEVM⟩
  let compilerCall :
      OpenExternal.OpenCall (Objects.Source.State × List Word) :=
    { site := primitiveCall.site
      resume := fun response =>
        (compiler.withShared (primitiveCall.resume response).1,
          (primitiveCall.resume response).2) }
  refine ⟨compilerCall, evmCall, ?_, hEVMCall, ?_⟩
  · simp [compilerPrimitiveOpenCall?, hPrimitiveCall, compilerCall]
  · constructor
    · simpa [compilerCall] using hPrimitiveEVM.sameSite
    · intro response _hResponse
      have hPreserved :=
        OpenExternal.OpenCallRel.preserves_response hPrimitiveEVM response
          trivial
      constructor
      · simpa [compilerCall, CompilerPrimitiveEVMResultRel] using
          hPreserved.1
      · simpa [compilerCall, CompilerPrimitiveEVMResultRel] using
          hPreserved.2

theorem compilerPrimitiveOpenCreateRel_evmOpenCreate_of_args
    {compiler : Objects.Source.State}
    {state : EvmYul.EVM.State}
    (hShared : state.toSharedState = compiler.shared)
    (kind : OpenExternal.CreateKind)
    (operands : OpenExternal.CreateOperands)
    (baseStack : OpenExternal.Stack) :
    ∃ compilerCreate :
        OpenExternal.OpenCreate (Objects.Source.State × List Word),
    ∃ evmCreate : OpenExternal.OpenCreate EvmYul.EVM.State,
      compilerPrimitiveOpenCreate? compiler kind
          (kind.args operands).reverse =
        some compilerCreate ∧
      OpenExternal.CreateKind.evmOpenCreate?
          ({ state with stack := kind.args operands ++ baseStack }
            : EvmYul.EVM.State) kind =
        some evmCreate ∧
      OpenExternal.OpenCreateRel
        (fun _ => True)
        (CompilerPrimitiveEVMResultRel baseStack) compilerCreate evmCreate := by
  rcases
      OpenExternal.CreateKind.primitiveOpenCreateRel_evmOpenCreate
        state compiler.shared hShared kind operands baseStack with
    ⟨primitiveCreate, evmCreate, hPrimitiveCreate, hEVMCreate,
      hPrimitiveEVM⟩
  let compilerCreate :
      OpenExternal.OpenCreate (Objects.Source.State × List Word) :=
    { site := primitiveCreate.site
      resume := fun response =>
        (compiler.withShared (primitiveCreate.resume response).1,
          (primitiveCreate.resume response).2) }
  refine ⟨compilerCreate, evmCreate, ?_, hEVMCreate, ?_⟩
  · simp [compilerPrimitiveOpenCreate?, hPrimitiveCreate, compilerCreate]
  · constructor
    · simpa [compilerCreate] using hPrimitiveEVM.sameSite
    · intro response _hResponse
      have hPreserved :=
        OpenExternal.OpenCreateRel.preserves_response hPrimitiveEVM response
          trivial
      constructor
      · simpa [compilerCreate, CompilerPrimitiveEVMResultRel] using
          hPreserved.1
      · simpa [compilerCreate, CompilerPrimitiveEVMResultRel] using
          hPreserved.2

theorem finishOpenExternalCall
    {cfg : StateRelConfig} {layout : List Name}
    {sourceShared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    {site : OpenExternal.CallSite}
    {response : OpenExternal.CallResponse}
    (hRel :
      SourceStateRel cfg layout (.Ok sourceShared store) compiler)
    (hResponse :
      SharedStateRel.OpenExternalResponseRel cfg sourceShared
        compiler.shared response) :
    SourceStateRel cfg layout
      (.Ok (site.finishShared sourceShared response) store)
      (compiler.withShared (site.finishShared compiler.shared response)) := by
  cases hRel with
  | ok hShared hVars =>
      exact SourceStateRel.ok
        (SharedStateRel.finishExternalCall hShared hResponse) hVars

theorem finishOpenExternalCreate
    {cfg : StateRelConfig} {layout : List Name}
    {sourceShared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    {site : OpenExternal.CreateSite}
    {response : OpenExternal.CreateResponse}
    (hRel :
      SourceStateRel cfg layout (.Ok sourceShared store) compiler)
    (hResponse :
      SharedStateRel.OpenExternalCreateResponseRel cfg sourceShared
        compiler.shared response) :
    SourceStateRel cfg layout
      (.Ok (site.finishShared sourceShared response) store)
      (compiler.withShared (site.finishShared compiler.shared response)) := by
  cases hRel with
  | ok hShared hVars =>
      exact SourceStateRel.ok
        (SharedStateRel.finishExternalCreate hShared hResponse) hVars

theorem openExternalPrimitiveOpenCallRel_of_args
    {cfg : StateRelConfig} {layout : List Name}
    {sourceShared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    (hRel :
      SourceStateRel cfg layout (.Ok sourceShared store) compiler)
    (kind : OpenExternal.CallKind)
    (operands : OpenExternal.CallOperands) :
    ∃ sourceCall :
        OpenExternal.OpenCall (State × List Word),
    ∃ compilerCall :
        OpenExternal.OpenCall (Objects.Source.State × List Word),
      OpenExternal.CallKind.yulOpenCall?
          (.Ok sourceShared store) kind (kind.args operands) =
        some sourceCall ∧
      compilerPrimitiveOpenCall? compiler kind
          (kind.args operands).reverse =
        some compilerCall ∧
      SharedStateRel.OpenCallRelAt cfg sourceShared compiler.shared
        (OpenPrimitiveResultRel cfg layout) sourceCall compilerCall := by
  let site :=
    (OpenExternal.CallContext.ofEVMSharedState compiler.shared).callSite
      kind (kind.canonicalOperands operands)
  let sourceCall :
      OpenExternal.OpenCall (State × List Word) :=
    { site := site
      resume := fun response =>
        (site.finishYulState (.Ok sourceShared store) response,
          [response.statusWord]) }
  let compilerCall :
      OpenExternal.OpenCall
        (Objects.Source.State × List Word) :=
    { site := site
      resume := fun response =>
        (compiler.withShared (site.finishShared compiler.shared response),
          [response.statusWord]) }
  refine ⟨sourceCall, compilerCall, ?_, ?_, ?_⟩
  · have hSite :=
      hRel.openExternalPrimitiveCallSite_eq_of_args kind operands
    rw [OpenExternal.CallKind.primitiveCallSite?_args_reverse] at hSite
    simp [OpenExternal.CallKind.yulOpenCall?, sourceCall, site, hSite]
  · simp [compilerPrimitiveOpenCall?, compilerCall, site]
  · constructor
    · rfl
    · intro response hResponse
      constructor
      · simpa [sourceCall, compilerCall, OpenExternal.CallSite.finishYulState,
          OpenPrimitiveResultRel, site]
          using
            (finishOpenExternalCall
              (cfg := cfg) (layout := layout)
              (compiler := compiler) (site := site)
              (response := response) hRel hResponse)
      · rfl

theorem openExternalPrimitiveOpenCreateRel_of_args
    {cfg : StateRelConfig} {layout : List Name}
    {sourceShared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    (hRel :
      SourceStateRel cfg layout (.Ok sourceShared store) compiler)
    (kind : OpenExternal.CreateKind)
    (operands : OpenExternal.CreateOperands) :
    ∃ sourceCreate :
        OpenExternal.OpenCreate (State × List Word),
    ∃ compilerCreate :
        OpenExternal.OpenCreate (Objects.Source.State × List Word),
      OpenExternal.CreateKind.yulOpenCreate?
          (.Ok sourceShared store) kind (kind.args operands) =
        some sourceCreate ∧
      compilerPrimitiveOpenCreate? compiler kind
          (kind.args operands).reverse =
        some compilerCreate ∧
      SharedStateRel.OpenCreateRelAt cfg sourceShared compiler.shared
        (OpenPrimitiveResultRel cfg layout) sourceCreate compilerCreate := by
  let site :=
    (OpenExternal.CallContext.ofEVMSharedState compiler.shared).createSite
      kind (kind.canonicalOperands operands)
  let sourceCreate :
      OpenExternal.OpenCreate (State × List Word) :=
    { site := site
      resume := fun response =>
        (site.finishYulState (.Ok sourceShared store) response,
          [response.address]) }
  let compilerCreate :
      OpenExternal.OpenCreate
        (Objects.Source.State × List Word) :=
    { site := site
      resume := fun response =>
        (compiler.withShared (site.finishShared compiler.shared response),
          [response.address]) }
  refine ⟨sourceCreate, compilerCreate, ?_, ?_, ?_⟩
  · have hSite :=
      hRel.openExternalPrimitiveCreateSite_eq_of_args kind operands
    rw [OpenExternal.CreateKind.primitiveCreateSite?_args_reverse] at hSite
    simp [OpenExternal.CreateKind.yulOpenCreate?, sourceCreate, site, hSite]
  · have hPrimitive :
        OpenExternal.CreateKind.primitiveSharedOpenCreate?
            compiler.shared kind (kind.args operands).reverse =
          some
            ({ site := site
               resume := fun response =>
                 (site.finishShared compiler.shared response,
                   [response.address]) } :
              OpenExternal.OpenCreate
                (EvmYul.SharedState .EVM × List Word)) := by
      cases kind <;> rfl
    simp [compilerPrimitiveOpenCreate?, compilerCreate, hPrimitive]
  · constructor
    · rfl
    · intro response hResponse
      constructor
      · simpa [sourceCreate, compilerCreate,
          OpenExternal.CreateSite.finishYulState,
          OpenPrimitiveResultRel, site]
          using
            (finishOpenExternalCreate
              (cfg := cfg) (layout := layout)
              (compiler := compiler) (site := site)
              (response := response) hRel hResponse)
      · rfl

theorem openExternalPrimitiveEVMOpenCallRel_of_args
    {cfg : StateRelConfig} {layout : List Name}
    {sourceShared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    {evmState : EvmYul.EVM.State}
    (hRel :
      SourceStateRel cfg layout (.Ok sourceShared store) compiler)
    (hEVMShared : evmState.toSharedState = compiler.shared)
    (kind : OpenExternal.CallKind)
    (operands : OpenExternal.CallOperands)
    (baseStack : OpenExternal.Stack) :
    ∃ sourceCall :
        OpenExternal.OpenCall (State × List Word),
    ∃ evmCall : OpenExternal.OpenCall EvmYul.EVM.State,
      OpenExternal.CallKind.yulOpenCall?
          (.Ok sourceShared store) kind (kind.args operands) =
        some sourceCall ∧
      OpenExternal.CallKind.evmOpenCall?
          ({ evmState with stack := kind.args operands ++ baseStack }
            : EvmYul.EVM.State) kind =
        some evmCall ∧
      SharedStateRel.OpenCallRelAt cfg sourceShared compiler.shared
        (OpenPrimitiveEVMResultRel cfg layout baseStack)
        sourceCall evmCall := by
  rcases
      openExternalPrimitiveOpenCallRel_of_args
        hRel kind operands with
    ⟨sourceCall, compilerCall, hSourceCall, hCompilerCall,
      hSourceCompiler⟩
  rcases
      compilerPrimitiveOpenCallRel_evmOpenCall_of_args
        (compiler := compiler)
        (state := evmState) hEVMShared kind operands baseStack with
    ⟨compilerCall', evmCall, hCompilerCall', hEVMCall, hCompilerEVM⟩
  rw [hCompilerCall] at hCompilerCall'
  cases hCompilerCall'
  exact
    ⟨sourceCall, evmCall, hSourceCall, hEVMCall, by
      constructor
      · exact hSourceCompiler.sameSite.trans hCompilerEVM.sameSite
      · intro response hResponse
        exact
          ⟨compilerCall.resume response,
            OpenExternal.OpenCallRel.preserves_response hSourceCompiler
              response hResponse,
            OpenExternal.OpenCallRel.preserves_response hCompilerEVM
              response trivial⟩⟩

theorem openExternalPrimitiveEVMOpenCreateRel_of_args
    {cfg : StateRelConfig} {layout : List Name}
    {sourceShared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}

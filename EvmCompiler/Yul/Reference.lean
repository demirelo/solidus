theorem functions_initNames_runOpen_stack {cfg : StateRelConfig}
    {shared : EvmYul.SharedState .Yul}
    (program : Functions.Program) (returns : List Name) :
    ∀ (names : List Name) (ctx : Locals.Ctx) (compiler : RunState),
      SharedStateRel cfg shared compiler.evm.toSharedState →
      ∃ compiler',
        Functions.Direct.Block.runOpen program returns ctx
            (names.length + 1) { stmts := Stmt.initNames names } compiler =
          .ok (Structured.Outcome.regular compiler',
            ctx.withLayout (names.reverse ++ ctx.layout)) ∧
        compiler'.evm.stack =
          List.replicate names.length VarStackRel.zeroWord ++
            compiler.evm.stack ∧
        compiler'.returns = compiler.returns ∧
        SharedStateRel cfg shared compiler'.evm.toSharedState := by
  intro names
  induction names with
  | nil =>
      intro ctx compiler hShared
      refine ⟨compiler, ?_, ?_, ?_, hShared⟩
      · cases ctx
        simp [Stmt.initNames, Functions.Direct.Block.runOpen,
          Locals.Ctx.withLayout]
      · simp
      · rfl
  | cons name rest ih =>
      intro ctx compiler hShared
      let evmHead :=
        compiler.evm.replaceStackAndIncrPC
          (VarStackRel.zeroWord :: compiler.evm.stack) (pcΔ := 33)
      let compilerHead := compiler.withEVM evmHead
      have hHeadRun :
          Functions.Direct.Stmt.run program returns ctx (rest.length + 1)
              (.let_ name (.lit VarStackRel.zeroWord)) compiler =
            .ok (Structured.Outcome.regular compilerHead,
              ctx.withLayout (name :: ctx.layout)) := by
        simp [Functions.Direct.Stmt.run, Locals.Direct.Expr.runState,
          Locals.Direct.Expr.runCode, Structured.BasicInstr.step,
          Assembly.Target.stepInstr, compilerHead, evmHead,
          VarStackRel.zeroWord, EvmYul.Stack.push]
      have hSharedHead :
          SharedStateRel cfg shared compilerHead.evm.toSharedState := by
        simpa [compilerHead, evmHead, EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC] using hShared
      rcases ih (ctx.withLayout (name :: ctx.layout)) compilerHead
          hSharedHead with
        ⟨compiler', hRestRun, hStack, hReturns, hSharedFinal⟩
      have hHeadRun' :
          Functions.Direct.Stmt.run program returns ctx (rest.length + 1)
              (.let_ name (.lit Stmt.zero)) compiler =
            .ok (Structured.Outcome.regular compilerHead,
              ctx.withLayout (name :: ctx.layout)) := by
        simpa [Stmt.zero, VarStackRel.zeroWord] using hHeadRun
      have hRestRun' :
          Functions.Direct.Block.runOpen program returns
              (ctx.withLayout (name :: ctx.layout)) (rest.length + 1)
              { stmts := Stmt.initNames rest } compilerHead =
            .ok (Structured.Outcome.regular compiler',
              ctx.withLayout (rest.reverse ++ name :: ctx.layout)) := by
        simpa [Locals.Ctx.withLayout, List.append_assoc] using hRestRun
      refine ⟨compiler', ?_, ?_, ?_, hSharedFinal⟩
      · simpa [Stmt.initNames, Functions.Direct.Block.runOpen, hHeadRun']
          using hRestRun'
      · calc
          compiler'.evm.stack =
              List.replicate rest.length VarStackRel.zeroWord ++
                compilerHead.evm.stack := hStack
          _ =
              List.replicate rest.length VarStackRel.zeroWord ++
                VarStackRel.zeroWord :: compiler.evm.stack := by
                simp [compilerHead, evmHead,
                  EvmYul.EVM.State.replaceStackAndIncrPC,
                  EvmYul.EVM.State.incrPC]
          _ =
              List.replicate (rest.length + 1) VarStackRel.zeroWord ++
                compiler.evm.stack := by
                rw [List.replicate_succ']
                simp [List.append_assoc]
      · simpa [compilerHead] using hReturns

/--
Target-only hidden-local zero-initializer prelude.

`Stmt.initNames` is used by Yul lowering to allocate compiler-only temporaries
before a later call/bind sequence. This theorem is the hidden-local analogue of
`functions_initNames_runOpen_stack`: the generated zero locals extend only the
hidden compiler pushed, not the imported Yul varstore.
-/
theorem functions_initNames_hidden_bridge {cfg : StateRelConfig}
    {sourceLayout hiddenLayout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : RunState}
    (program : Functions.Program) (returns : List Name)
    (names : List Name) (ctx : Locals.Ctx)
    (hCtxLayout : ctx.layout = hiddenLayout ++ sourceLayout)
    (hRel :
      CompilerStateRelWithHiddenLocals cfg sourceLayout hiddenLayout
        (.Ok shared store) compiler.evm) :
    ∃ compiler',
      Functions.Direct.Block.runOpen program returns ctx (names.length + 1)
          { stmts := Stmt.initNames names } compiler =
        .ok (Structured.Outcome.regular compiler',
          ctx.withLayout (names.reverse ++ ctx.layout)) ∧
      CompilerStateRelWithHiddenLocals cfg sourceLayout
        (names.reverse ++ hiddenLayout) (.Ok shared store) compiler'.evm ∧
      (ctx.withLayout (names.reverse ++ ctx.layout)).layout =
        names.reverse ++ hiddenLayout ++ sourceLayout ∧
      compiler'.returns = compiler.returns := by
  cases hRel with
  | ok hShared hVars hHiddenLength hStack =>
      rename_i hiddenValues locals
      rcases
          functions_initNames_runOpen_stack
            (cfg := cfg) (shared := shared) program returns names ctx compiler
            hShared with
        ⟨compiler', hRun, hStackFinal, hReturns, hSharedFinal⟩
      refine ⟨compiler', hRun, ?hRel, ?hLayout, hReturns⟩
      · exact
          CompilerStateRelWithHiddenLocals.ok
            (hiddenValues :=
              List.replicate names.length VarStackRel.zeroWord ++
                hiddenValues)
            (locals := locals)
            hSharedFinal
            hVars
            (by simp [hHiddenLength])
            (by
              calc
                compiler'.evm.stack =
                    List.replicate names.length VarStackRel.zeroWord ++
                      compiler.evm.stack := hStackFinal
                _ =
                    List.replicate names.length VarStackRel.zeroWord ++
                      (hiddenValues ++ locals) := by simp [hStack]
                _ =
                    (List.replicate names.length VarStackRel.zeroWord ++
                        hiddenValues) ++ locals := by
                      simp [List.append_assoc])
      · simp [Locals.Ctx.withLayout, hCtxLayout, List.append_assoc]


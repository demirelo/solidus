theorem toFunctionsListFuel?_block_nil
    (fuel : Nat) (state : Fresh.State) :
    Stmt.toFunctionsListFuel? fuel.succ.succ.succ state (.Block []) =
      some ([Functions.Stmt.block { stmts := [] }], state) := by
  simp [Stmt.toFunctionsListFuel?, Stmt.List.toBlockFuel?,
    Stmt.List.toFunctionsFuel?]

theorem toFunctionsListFuel?_block_components
    {fuel : Nat} {state state' : Fresh.State}
    {body : List AstStmt} {lowerPrefix : List Functions.Stmt}
    (hLower :
      Stmt.toFunctionsListFuel? fuel.succ state (.Block body) =
        some (lowerPrefix, state')) :
    ∃ lowerBody : Functions.Block,
      Stmt.List.toBlockFuel? fuel state body = some (lowerBody, state') ∧
        lowerPrefix = [Functions.Stmt.block lowerBody] := by
  cases hBlock : Stmt.List.toBlockFuel? fuel state body with
  | none =>
      simp [Stmt.toFunctionsListFuel?, hBlock] at hLower
  | some result =>
      rcases result with ⟨lowerBody, state''⟩
      simp [Stmt.toFunctionsListFuel?, hBlock] at hLower
      have hPair :
          ([Functions.Stmt.block lowerBody], state'') =
            (lowerPrefix, state') := by
        simpa using hLower
      have hState : state'' = state' := congrArg Prod.snd hPair
      have hPrefix : lowerPrefix = [Functions.Stmt.block lowerBody] :=
        (congrArg Prod.fst hPair).symm
      exact ⟨lowerBody, by simpa [hState] using hBlock, hPrefix⟩

theorem toFunctionsListFuel?_if_components
    {fuel : Nat} {state state'' : Fresh.State}
    {cond : AstExpr} {body : List AstStmt}
    {lowerPrefix : List Functions.Stmt}
    (hLower :
      Stmt.toFunctionsListFuel? fuel.succ state (.If cond body) =
        some (lowerPrefix, state'')) :
    ∃ preCond : List Functions.Stmt, ∃ lowerCond : Functions.Expr 1,
    ∃ state' : Fresh.State, ∃ lowerBody : Functions.Block,
      Expr.lower1? state cond = some (preCond, lowerCond, state') ∧
      Stmt.List.toBlockFuel? fuel state' body = some (lowerBody, state'') ∧
      lowerPrefix = preCond ++ [Functions.Stmt.if_ lowerCond lowerBody] := by
  cases hCond : Expr.lower1? state cond with
  | none =>
      simp [Stmt.toFunctionsListFuel?, hCond] at hLower
  | some condResult =>
      rcases condResult with ⟨preCond, lowerCond, state'⟩
      cases hBody : Stmt.List.toBlockFuel? fuel state' body with
      | none =>
          simp [Stmt.toFunctionsListFuel?, hCond, hBody] at hLower
      | some bodyResult =>
          rcases bodyResult with ⟨lowerBody, state'''⟩
          simp [Stmt.toFunctionsListFuel?, hCond, hBody] at hLower
          have hPair :
              (preCond ++ [Functions.Stmt.if_ lowerCond lowerBody],
                  state''') =
                (lowerPrefix, state'') := by
            simpa using hLower
          have hState : state''' = state'' := congrArg Prod.snd hPair
          have hPrefix :
              lowerPrefix =
                preCond ++ [Functions.Stmt.if_ lowerCond lowerBody] :=
            (congrArg Prod.fst hPair).symm
          exact
            ⟨preCond, lowerCond, state', lowerBody, by simpa [hCond],
              by simpa [hState] using hBody, hPrefix⟩

theorem toFunctionsListFuel?_for_components
    {fuel : Nat} {state state''' : Fresh.State}
    {cond : AstExpr} {post body : List AstStmt}
    {lowerPrefix : List Functions.Stmt}
    (hLower :
      Stmt.toFunctionsListFuel? fuel.succ state (.For cond post body) =
        some (lowerPrefix, state''')) :
    ∃ preCond : List Functions.Stmt, ∃ lowerCond : Functions.Expr 1,
    ∃ state' : Fresh.State, ∃ lowerPost : Functions.Block,
    ∃ state'' : Fresh.State, ∃ lowerBody : Functions.Block,
      Expr.lower1? state cond = some (preCond, lowerCond, state') ∧
      Stmt.List.toBlockFuel? fuel state' post = some (lowerPost, state'') ∧
      Stmt.List.toBlockFuel? fuel state'' body =
        some (lowerBody, state''') ∧
      lowerPrefix =
        [Functions.Stmt.for_ { stmts := [] }
          (.lit (EvmYul.UInt256.ofNat 1)) lowerPost
          { stmts :=
              preCond ++
                [Functions.Stmt.if_
                  (.prim .iszero (Locals.ExprSeq.cons lowerCond .nil))
                  { stmts := [Functions.Stmt.brk] }] ++
                lowerBody.stmts }] := by
  cases hCond : Expr.lower1? state cond with
  | none =>
      simp [Stmt.toFunctionsListFuel?, hCond] at hLower
  | some condResult =>
      rcases condResult with ⟨preCond, lowerCond, state'⟩
      cases hPost : Stmt.List.toBlockFuel? fuel state' post with
      | none =>
          simp [Stmt.toFunctionsListFuel?, hCond, hPost] at hLower
      | some postResult =>
          rcases postResult with ⟨lowerPost, state''⟩
          cases hBody : Stmt.List.toBlockFuel? fuel state'' body with
          | none =>
              simp [Stmt.toFunctionsListFuel?, hCond, hPost, hBody] at hLower
          | some bodyResult =>
              rcases bodyResult with ⟨lowerBody, state''''⟩
              simp [Stmt.toFunctionsListFuel?, hCond, hPost, hBody] at hLower
              have hPair :
                  ([Functions.Stmt.for_ { stmts := [] }
                      (.lit (EvmYul.UInt256.ofNat 1)) lowerPost
                      { stmts :=
                          preCond ++
                            [Functions.Stmt.if_
                              (.prim .iszero
                                (Locals.ExprSeq.cons lowerCond .nil))
                              { stmts := [Functions.Stmt.brk] }] ++
                            lowerBody.stmts }],
                    state'''') =
                    (lowerPrefix, state''') := by
                simpa using hLower
              have hState : state'''' = state''' := congrArg Prod.snd hPair
              have hPrefix :
                  lowerPrefix =
                    [Functions.Stmt.for_ { stmts := [] }
                      (.lit (EvmYul.UInt256.ofNat 1)) lowerPost
                      { stmts :=
                          preCond ++
                            [Functions.Stmt.if_
                              (.prim .iszero
                                (Locals.ExprSeq.cons lowerCond .nil))
                              { stmts := [Functions.Stmt.brk] }] ++
                            lowerBody.stmts }] :=
                (congrArg Prod.fst hPair).symm
              exact
                ⟨preCond, lowerCond, state', lowerPost, state'', lowerBody,
                  by simpa [hCond], by simpa [hPost],
                  by simpa [hState] using hBody, hPrefix⟩

theorem toFunctionsListFuel?_terminal_components
    {fuel : Nat} {state state' : Fresh.State}
    {prim : EvmYul.Operation .Yul} {args : List AstExpr}
    {kind : Assembly.HaltKind}
    {lowerPrefix : List Functions.Stmt}
    (hTerminal : Prim.terminal? prim = some kind)
    (hLower :
      Stmt.toFunctionsListFuel? fuel.succ state
          (.ExprStmtCall (.Call (.inl prim) args)) =
        some (lowerPrefix, state')) :
    ∃ preArgs : List Functions.Stmt,
    ∃ lowerArgs : List (Locals.Expr 1),
    ∃ stateAfterArgs : Fresh.State,
    ∃ seq : Locals.ExprSeq kind.argCount,
      Expr.List.lowerBound1? state args =
        some (preArgs, lowerArgs, stateAfterArgs) ∧
      Expr.List.toStackSeq? lowerArgs kind.argCount = some seq ∧
      lowerPrefix = preArgs ++ [Functions.Stmt.terminalArgs kind seq] ∧
      stateAfterArgs = state' := by
  cases hArgs :
      Expr.List.lowerBound1? state args with
  | none =>
      simp [Stmt.toFunctionsListFuel?, hTerminal, hArgs] at hLower
  | some argsResult =>
      rcases argsResult with ⟨preArgs, lowerArgs, stateAfterArgs⟩
      cases hSeq :
          Expr.List.toStackSeq? lowerArgs kind.argCount with
      | none =>
          simp [Stmt.toFunctionsListFuel?, hTerminal, hArgs, hSeq] at hLower
      | some seq =>
          have hPair :
              (preArgs ++ [Functions.Stmt.terminalArgs kind seq],
                  stateAfterArgs) =
                (lowerPrefix, state') := by
            simpa [Stmt.toFunctionsListFuel?, hTerminal, hArgs, hSeq]
              using hLower
          exact
            ⟨preArgs, lowerArgs, stateAfterArgs, seq,
              by simpa [hArgs], by simpa [hSeq],
              (congrArg Prod.fst hPair).symm,
              congrArg Prod.snd hPair⟩

theorem listToFunctionsFuel?_nil

    · rw [StateFacts.tstore_executionEnv, StateFacts.tstore_executionEnv]
      exact hEnv
    · rw [StateFacts.tstore_blocks, StateFacts.tstore_blocks]
      exact hBlocks
    · rw [StateFacts.tstore_genesisBlockHeader,
        StateFacts.tstore_genesisBlockHeader]
      exact hGenesis
    · rw [StateFacts.tstore_createdAccounts,
        StateFacts.tstore_createdAccounts]
      exact hCreated
  · exact hMachine

theorem logOp {cfg : StateRelConfig}
    {sourceShared : EvmYul.SharedState .Yul}
    {targetShared : EvmYul.SharedState .EVM}
    {offset size : Word} {topics : Array Word}
    (hShared : SharedStateRel cfg sourceShared targetShared) :
    SharedStateRel cfg
      (EvmYul.SharedState.logOp offset size topics sourceShared)
      (EvmYul.SharedState.logOp offset size topics targetShared) := by
  rcases hShared with ⟨hChain, hMachine⟩
  constructor
  · rcases hChain with
      ⟨hAccountMap, hSigma, hTotal, hReceipts, hSubstate, hEnv,
        hBlocks, hGenesis, hCreated⟩
    rcases hMachine with
      ⟨hGas, hActive, hMemory, hReturn, hHReturn⟩
    constructor
    · simpa [EvmYul.SharedState.logOp] using hAccountMap
    · simpa [EvmYul.SharedState.logOp] using hSigma
    · simpa [EvmYul.SharedState.logOp] using hTotal
    · simpa [EvmYul.SharedState.logOp] using hReceipts
    · simp [EvmYul.SharedState.logOp, hSubstate, hEnv.codeOwner, hMemory]
    · simpa [EvmYul.SharedState.logOp] using hEnv
    · simpa [EvmYul.SharedState.logOp] using hBlocks
    · simpa [EvmYul.SharedState.logOp] using hGenesis
    · simpa [EvmYul.SharedState.logOp] using hCreated
  · rcases hMachine with
      ⟨hGas, hActive, hMemory, hReturn, hHReturn⟩
    constructor
    · simpa [EvmYul.SharedState.logOp] using hGas
    · simp [EvmYul.SharedState.logOp, hActive]
    · simpa [EvmYul.SharedState.logOp] using hMemory
    · simpa [EvmYul.SharedState.logOp] using hReturn
    · simpa [EvmYul.SharedState.logOp] using hHReturn


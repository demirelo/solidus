theorem boundArgsBridgeWithLayoutSlotValues_runStackSeq
    {cfg : StateRelConfig}
    {sourceLayout fullLayout fullLayoutAfter : List Name}
    {program : Functions.Program} {returns : List Name}
    {ctx : Locals.Ctx} {argFuel : Nat} {args : List AstExpr}
    {codeOverride : Option AstContract} {source : State}
    {compiler : RunState} {pre : List Functions.Stmt}
    {lowerArgs : List (Locals.Expr 1)} {results : Nat}
    {seq : Locals.ExprSeq results}
    (hArgs :
      BoundArgsBridgeWithLayoutSlotValues (cfg := cfg) sourceLayout
        fullLayout fullLayoutAfter program returns ctx argFuel args
        codeOverride source compiler pre lowerArgs)
    (hSeq : Expr.List.toStackSeq? lowerArgs results = some seq)
    (hNoDup : fullLayoutAfter.Nodup)
    (hBound :
      ∀ {pos : Nat} {name : Name} {idx : Nat},
        lowerArgs.reverse[pos]? = some (.var name) →
          fullLayoutAfter[idx]? = some name →
            pos + idx + 1 ≤ 16) :
    ∃ sourceAfter : State, ∃ values : List Word,
    ∃ compilerAfterArgs : RunState, ∃ ctxAfter : Locals.Ctx,
    ∃ preFuel : Nat, ∃ evmAfterArgs : EVMState,
      EvmYul.Yul.evalArgs argFuel args.reverse codeOverride source =
        .ok (sourceAfter, values.reverse) ∧
      Functions.Direct.Block.runOpen program returns ctx preFuel
          { stmts := pre } compiler =
        .ok (Structured.Outcome.regular compilerAfterArgs, ctxAfter) ∧
      ctx.layout = fullLayout ∧
      ctxAfter.layout = fullLayoutAfter ∧
      LayoutSuffix fullLayout fullLayoutAfter ∧
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayoutAfter
        sourceAfter compilerAfterArgs.evm ∧
      ArgSlotValues fullLayoutAfter compilerAfterArgs.evm.stack lowerArgs
        values ∧
      Locals.Direct.Expr.ExprSeq.runCode ctxAfter 0 seq
          compilerAfterArgs.evm =
        .ok evmAfterArgs ∧
      evmAfterArgs.stack = values ++ compilerAfterArgs.evm.stack ∧
      evmAfterArgs.toSharedState = compilerAfterArgs.evm.toSharedState ∧
      compilerAfterArgs.returns = compiler.returns := by
  rcases hArgs with
    ⟨sourceAfter, values, compilerAfterArgs, ctxAfter, preFuel,
      hEvalArgs, hPreRun, hCtxLayout, hCtxAfterLayout, hSuffix, hRel,
      hSlots, hReturns⟩
  rcases
      exprSeq_runCode_toStackSeq_of_argSlots ctxAfter compilerAfterArgs.evm
        compilerAfterArgs.evm fullLayoutAfter 0 [] hCtxAfterLayout hNoDup
        (by simp) (by simp) hSlots hSeq
        (by
          intro pos name idx hExpr hLayout
          simpa using hBound hExpr hLayout)
    with
    ⟨evmAfterArgs, hRunSeq, hStack, hShared⟩
  exact
    ⟨sourceAfter, values, compilerAfterArgs, ctxAfter, preFuel, evmAfterArgs,
      hEvalArgs, hPreRun, hCtxLayout, hCtxAfterLayout, hSuffix, hRel, hSlots,
      hRunSeq, by simpa using hStack, hShared, hReturns⟩

theorem resultSeqRunBridgeWithLayoutSlots_cons_boundTerminalArgs_of_source_error
    {cfg : StateRelConfig}
    {sourceLayout fullLayout fullLayoutAfter
      outcomeSourceLayout outcomeFullLayout : List Name}
    {program : Functions.Program}
    {returns : List Name} {ctx : Locals.Ctx}
    {sourceFuel : Nat} {sourceStmt : AstStmt} {rest : List AstStmt}
    {codeOverride : Option AstContract} {source : State}
    {compiler : RunState} {kind : Assembly.HaltKind}
    {sourceArgs : List AstExpr}
    {lowerArgs : List (Locals.Expr 1)}
    {seq : Locals.ExprSeq kind.argCount}
    {err : Exception} {pre : List Functions.Stmt}
    {lowerTail : Functions.Block}
    (hBoundArgs :
      BoundArgsBridgeWithLayoutSlotValues (cfg := cfg) sourceLayout
        fullLayout fullLayoutAfter program returns ctx sourceFuel
        sourceArgs codeOverride source compiler pre lowerArgs)
    (hSeq : Expr.List.toStackSeq? lowerArgs kind.argCount = some seq)
    (hNoDup : fullLayoutAfter.Nodup)
    (hBound :
      ∀ {pos : Nat} {name : Name} {idx : Nat},
        lowerArgs.reverse[pos]? = some (.var name) →
          fullLayoutAfter[idx]? = some name →
            pos + idx + 1 ≤ 16)
    (hSource :
      EvmYul.Yul.exec sourceFuel sourceStmt codeOverride source =
        .error err)
    (hTerminalRel :
      ∀ {sourceAfter : State} {values : List Word}
        {compilerAfterArgs : RunState} {ctxAfter : Locals.Ctx}
        {evmAfterArgs : EVMState},
        EvmYul.Yul.evalArgs sourceFuel sourceArgs.reverse codeOverride
            source =
          .ok (sourceAfter, values.reverse) →
        CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayoutAfter
          sourceAfter compilerAfterArgs.evm →
        Locals.Direct.Expr.ExprSeq.runCode ctxAfter 0 seq
            compilerAfterArgs.evm =
          .ok evmAfterArgs →
        evmAfterArgs.stack = values ++ compilerAfterArgs.evm.stack →
        evmAfterArgs.toSharedState =
          compilerAfterArgs.evm.toSharedState →
        compilerAfterArgs.returns = compiler.returns →
        ∃ evmAfterTerminal : EVMState,
          Structured.Terminal.step kind evmAfterArgs =
            .ok evmAfterTerminal ∧
          CompilerResultOutcomeRelWithLayoutSlots cfg outcomeSourceLayout
            outcomeFullLayout (.error err)
            (Structured.Outcome.halt kind
              (compilerAfterArgs.withEVM evmAfterTerminal))) :
    ResultSeqRunBridgeWithLayoutSlots (cfg := cfg) sourceLayout fullLayout
      fullLayoutAfter outcomeSourceLayout outcomeFullLayout program returns
      ctx sourceFuel.succ (sourceStmt :: rest) codeOverride source compiler
      { stmts :=
          (pre ++ [Functions.Stmt.terminalArgs kind seq]) ++
            lowerTail.stmts } := by
  rcases
      boundArgsBridgeWithLayoutSlotValues_runStackSeq
        (cfg := cfg) (sourceLayout := sourceLayout)
        (fullLayout := fullLayout) (fullLayoutAfter := fullLayoutAfter)
        (program := program) (returns := returns) (ctx := ctx)
        (argFuel := sourceFuel) (args := sourceArgs)
        (codeOverride := codeOverride) (source := source)
        (compiler := compiler) (pre := pre) (lowerArgs := lowerArgs)
        (seq := seq) hBoundArgs hSeq hNoDup hBound
    with
    ⟨_sourceAfter, values, compilerAfterArgs, ctxAfter, preFuel,
      evmAfterArgs, hEvalArgs, hPreRun, hCtxLayout, hCtxAfterLayout,
      hSuffix, hRelAfterArgs, _hSlots, hRunSeq, hStack, hShared,
      hReturns⟩
  rcases
      hTerminalRel hEvalArgs hRelAfterArgs hRunSeq hStack hShared hReturns
    with
    ⟨evmAfterTerminal, hTerminal, hRel⟩
  have hTerminalRun :
      ∃ targetFuel : Nat,
        Functions.Direct.Block.runOpen program returns ctxAfter targetFuel
            { stmts :=
                [Functions.Stmt.terminalArgs kind seq] ++
                  lowerTail.stmts } compilerAfterArgs =
          .ok (Structured.Outcome.halt kind
            (compilerAfterArgs.withEVM evmAfterTerminal), ctxAfter) := by
    exact
      ⟨1,
        functions_runOpen_terminalArgs_of_runCode
          program returns ctxAfter compilerAfterArgs lowerTail kind seq
          hRunSeq hTerminal⟩
  rcases
      Functions.Direct.Block.runOpen_append_regular_exists
        program (returns := returns)
        pre ([Functions.Stmt.terminalArgs kind seq] ++ lowerTail.stmts)
        ctx ctxAfter compiler compilerAfterArgs
        (Structured.Outcome.halt kind
          (compilerAfterArgs.withEVM evmAfterTerminal)) ctxAfter
        ⟨preFuel, hPreRun⟩ hTerminalRun
    with
    ⟨targetFuel, hTarget⟩
  exact
    ⟨.error err,
      Structured.Outcome.halt kind
        (compilerAfterArgs.withEVM evmAfterTerminal),
      ctxAfter, targetFuel, Imported.execSeq_cons_error_succ hSource,
      by simpa [List.append_assoc] using hTarget,
      hCtxLayout, hCtxAfterLayout, hSuffix, hRel, by simpa using hReturns⟩


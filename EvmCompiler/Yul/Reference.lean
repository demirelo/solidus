theorem runCode_top_var
    (ctx : Locals.Ctx) (state : EVMState) (name : Name)
    (layout : List Name) (value : Word) (stack : EvmYul.Stack Word)
    (hCtxLayout : ctx.layout = name :: layout)
    (hStack : state.stack = value :: stack) :
    Locals.Direct.Expr.runCode ctx 0 (.var name) state =
      .ok (state.replaceStackAndIncrPC (value :: value :: stack)) := by
  cases state with
  | mk shared pc stack0 execLength =>
      simp at hStack
      subst stack0
      simp [Locals.Direct.Expr.runCode, hCtxLayout,
        Locals.Layout.lookupDepth?, Locals.Layout.lookupDepthFrom,
        Locals.StackOp.dup?, Structured.BasicOp.step,
        Structured.BasicOp.toPrimOp, Assembly.Target.stepInstr,
        Assembly.PrimOp.step, Assembly.PrimOp.continuingStep?,
        Assembly.PrimStep.run, EvmYul.dup]

theorem runCode_var_layout_slot_value
    (ctx : Locals.Ctx) (state : EVMState) (name : Name)
    (layout : List Name) {idx offset : Nat} {value : Word}
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hName : layout[idx]? = some name)
    (hStack : state.stack[offset + idx]? = some value)
    (hBound : offset + idx + 1 ≤ 16) :
    Locals.Direct.Expr.runCode ctx offset (.var name) state =
      .ok (state.replaceStackAndIncrPC (value :: state.stack)) := by
  let state' := state.replaceStackAndIncrPC (value :: state.stack)
  have hDepth :
      Locals.Layout.lookupDepth? name ctx.layout = some (idx + 1) := by
    simpa [hCtxLayout] using
      (lookupDepth?_of_get?_nodup hName hNoDup)
  have hOne : 1 ≤ offset + (idx + 1) := by
    omega
  have hBound' : offset + (idx + 1) ≤ 16 := by
    omega
  rcases
      stackOp_dup?_step_eq_dup
        (n := offset + (idx + 1)) hOne hBound' state with
    ⟨op, hDup, hStep⟩
  have hDupValue :
      EvmYul.dup (offset + (idx + 1)) state =
        .ok state' := by
    have hDupValue' :=
      evm_dup_succ_get? (state := state) (idx := offset + idx)
        hStack
    simpa [state', Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
      using hDupValue'
  simp [Locals.Direct.Expr.runCode, hDepth, hDup]
  rw [hStep, hDupValue]

theorem exprSeq_runCode_two_layout_slots
    (ctx : Locals.Ctx) (state : EVMState)
    (leftName rightName : Name) (layout : List Name)
    {leftIdx rightIdx : Nat}
    (leftValue rightValue : Word)
    (hCtxLayout : ctx.layout = layout)
    (hNoDup : layout.Nodup)
    (hLeftName : layout[leftIdx]? = some leftName)
    (hRightName : layout[rightIdx]? = some rightName)
    (hLeftStack : state.stack[leftIdx]? = some leftValue)
    (hRightStack : state.stack[rightIdx]? = some rightValue)
    (hLeftBound : 1 + leftIdx + 1 ≤ 16)
    (hRightBound : rightIdx + 1 ≤ 16) :
    Locals.Direct.Expr.ExprSeq.runCode ctx 0
        (Locals.ExprSeq.cons (.var rightName)
          (Locals.ExprSeq.cons (.var leftName) .nil)) state =
      .ok
        ((state.replaceStackAndIncrPC (rightValue :: state.stack))
          |>.replaceStackAndIncrPC
            (leftValue :: rightValue :: state.stack)) := by
  let stateAfterRight :=
    state.replaceStackAndIncrPC (rightValue :: state.stack)
  have hRunRight :
      Locals.Direct.Expr.runCode ctx 0 (.var rightName) state =
        .ok stateAfterRight := by
    simpa [stateAfterRight] using
      runCode_var_layout_slot_value ctx state rightName layout
        (idx := rightIdx) (offset := 0) hCtxLayout hNoDup hRightName
        (by simpa using hRightStack)
        (by simpa using hRightBound)
  have hLeftStackAfterRight :
      stateAfterRight.stack[1 + leftIdx]? = some leftValue := by
    have hShift :
        (rightValue :: state.stack)[Nat.succ leftIdx]? =
          some leftValue := by
      simpa using hLeftStack
    simpa [stateAfterRight, EvmYul.EVM.State.replaceStackAndIncrPC,
      EvmYul.EVM.State.incrPC, Nat.succ_eq_add_one, Nat.add_comm]
      using hShift
  have hRunLeft :
      Locals.Direct.Expr.runCode ctx 1 (.var leftName) stateAfterRight =
        .ok
          (stateAfterRight.replaceStackAndIncrPC
            (leftValue :: stateAfterRight.stack)) := by
    simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
      runCode_var_layout_slot_value ctx stateAfterRight leftName layout
        (idx := leftIdx) (offset := 1) hCtxLayout hNoDup hLeftName
        hLeftStackAfterRight hLeftBound
  change
    Locals.Direct.Expr.ExprSeq.runCode ctx 0
        (Locals.ExprSeq.cons (.var rightName)
          (Locals.ExprSeq.cons (.var leftName) .nil)) state =
      .ok
        (stateAfterRight.replaceStackAndIncrPC
          (leftValue :: stateAfterRight.stack))
  simp [Locals.Direct.Expr.ExprSeq.runCode, hRunRight, hRunLeft]

theorem varSlotValuesAt_seqCast
    {layout : List Name} {stack : EvmYul.Stack Word}
    {m n offset : Nat} {seq : Locals.ExprSeq m} {values : List Word}
    (h : m = n)
    (hValues :
      Locals.ExprSeq.VarSlotValuesAt layout stack offset seq values) :
    Locals.ExprSeq.VarSlotValuesAt layout stack offset
      (Expr.seqCast h seq) values := by
  cases h
  simpa [Expr.seqCast] using hValues

theorem ArgSlotValues.toVarSlotValuesAt_of_toSeq?
    {layout : List Name} {stack : EvmYul.Stack Word}
    {exprs : List (Locals.Expr 1)} {values : List Word}
    {offset results : Nat} {seq : Locals.ExprSeq results}
    (hSlots : ArgSlotValues layout stack exprs values)
    (hSeq : Expr.List.toSeq? exprs results = some seq)
    (hBound :
      ∀ {pos : Nat} {name : Name} {idx : Nat},
        exprs[pos]? = some (.var name) →
          layout[idx]? = some name →
            offset + pos + idx + 1 ≤ 16) :
    Locals.ExprSeq.VarSlotValuesAt layout stack offset seq values := by
  induction hSlots generalizing offset results seq with
  | nil =>
      cases results with
      | zero =>
          simp [Expr.List.toSeq?] at hSeq
          cases hSeq
          exact Locals.ExprSeq.VarSlotValuesAt.nil
      | succ results =>
          simp [Expr.List.toSeq?] at hSeq
  | @cons_var name rest value values hSlot hTail ih =>
      cases results with
      | zero =>
          simp [Expr.List.toSeq?] at hSeq
      | succ results =>
          cases hTailSeq : Expr.List.toSeq? rest results with
          | none =>
              simp [Expr.List.toSeq?, hTailSeq] at hSeq
          | some tailSeq =>
              simp [Expr.List.toSeq?, hTailSeq, Expr.seqCast] at hSeq
              cases hSeq
              rcases hSlot with ⟨idx, hName, hStack⟩
              have hHeadBound : offset + idx + 1 ≤ 16 := by
                simpa [Nat.add_assoc] using
                  (hBound (pos := 0) (idx := idx) (by simp) hName)
              have hTailBound :
                  ∀ {pos : Nat} {tailName : Name} {tailIdx : Nat},
                    rest[pos]? = some (.var tailName) →
                      layout[tailIdx]? = some tailName →
                        offset + 1 + pos + tailIdx + 1 ≤ 16 := by
                intro pos tailName tailIdx hExpr hLayout
                have hBound' :=
                  hBound (pos := pos + 1) (idx := tailIdx)
                    (by simpa using hExpr) hLayout
                omega
              exact
                varSlotValuesAt_seqCast (by simp [Nat.add_comm])
                  (Locals.ExprSeq.VarSlotValuesAt.cons_var hName hStack
                    hHeadBound
                    (ih (offset := offset + 1) (results := results)
                      (seq := tailSeq) hTailSeq hTailBound))


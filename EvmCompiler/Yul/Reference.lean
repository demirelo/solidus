    (sourceFuel : Nat)
    (sourceStmt : AstStmt) (codeOverride : Option AstContract) :
    Prop :=
  ∀ {freshState freshState' lowerStmts},
    Stmt.toFunctionsList? freshState sourceStmt =
      some (lowerStmts, freshState') →
    SourceResultBlockSound cfg layout terminalRel revertRel prim program ctx
      sourceFuel [sourceStmt] codeOverride { stmts := lowerStmts }

/--
Fresh-aware checked single-statement target.

This is the compositional statement target for generated temporaries.  The

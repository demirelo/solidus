theorem runState_var_layout_slot_bridge_of_lookup {cfg : StateRelConfig}
    {sourceLayout fullLayout : List Name}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : RunState}
    (fuel : Nat) (name : EvmYul.Identifier)
    (codeOverride : Option AstContract) (ctx : Locals.Ctx)
    {sourceIdx : Nat} {value : Word}
    (hCtxLayout : ctx.layout = fullLayout)
    (hNoDup : fullLayout.Nodup)
    (hSourceName : sourceLayout[sourceIdx]? = some (identName name))
    (hBound :
      ∀ {fullIdx : Nat},
        fullLayout[fullIdx]? = some (identName name) →
          fullIdx + 1 ≤ 16)
    (hStore : store.lookup (identName name) = some value)
    (hRel :
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Ok shared store) compiler.evm) :
    ∃ compilerAfterCode : RunState, ∃ stack : EvmYul.Stack Word,
    ∃ compilerAfterPop : RunState,
      EvmYul.Yul.eval fuel.succ (.Var name) codeOverride
          (.Ok shared store) =
        .ok (.Ok shared store, value) ∧
      Locals.Direct.Expr.runState ctx (.var (identName name)) compiler =
        .ok compilerAfterCode ∧
      compilerAfterCode.evm.stack.pop = some (stack, value) ∧
      compilerAfterPop =
        compilerAfterCode.withEVM { compilerAfterCode.evm with stack := stack } ∧
      CompilerStateRelWithLayoutSlots cfg sourceLayout fullLayout
        (.Ok shared store) compilerAfterPop.evm ∧
      compilerAfterPop.returns = compiler.returns := by
  rcases
      eval_var_compiler_push_temp_layout_slots
        (cfg := cfg) (sourceLayout := sourceLayout)
        (fullLayout := fullLayout) (shared := shared) (store := store)
        (compiler := compiler.evm) fuel name codeOverride ctx
        (sourceIdx := sourceIdx) hCtxLayout hNoDup hSourceName hBound hRel
    with
    ⟨value', evmAfterCode, hEval, hStore', hRunCode, hTemps⟩
  have hEvalExpected :
      EvmYul.Yul.eval fuel.succ (.Var name) codeOverride
          (.Ok shared store) =
        .ok (.Ok shared store, value) := by
    rw [Imported.eval_var_succ]
    simp [lookup?_ok (shared := shared) hStore]
  rw [hEvalExpected] at hEval
  cases hEval
  rcases
      runState_pop_of_single_temp_layout_slots
        (cfg := cfg) (sourceLayout := sourceLayout)
        (fullLayout := fullLayout) (sourceAfter := .Ok shared store)
        (compiler := compiler) (ctx := ctx)
        (lower := .var (identName name)) (evmAfterCode := evmAfterCode)

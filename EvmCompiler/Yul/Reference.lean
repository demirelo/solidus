theorem toFunctionsListFuel?_switch_empty_default_components
    {fuel : Nat} {state : Fresh.State} {scrutinee : AstExpr}
    {cases : List (Word × List AstStmt)}
    {lowerStmts : List Functions.Stmt} {state' : Fresh.State}
    (hLower :
      Stmt.toFunctionsListFuel? fuel.succ state
          (.Switch scrutinee cases []) =
        some (lowerStmts, state')) :
    ∃ preScrutinee : List Functions.Stmt,
    ∃ lowerScrutinee : Functions.Expr 1,
    ∃ stateAfterScrutinee : Fresh.State,
    ∃ lowerCases : List (Word × Functions.Block),
      Expr.lower1? state scrutinee =
        some (preScrutinee, lowerScrutinee, stateAfterScrutinee) ∧
      Stmt.CaseList.toFunctionsFuel? fuel stateAfterScrutinee cases =
        some (lowerCases, state') ∧
      lowerStmts =
        preScrutinee ++
          [Functions.Stmt.switch lowerScrutinee lowerCases none] := by
  simp [Stmt.toFunctionsListFuel?] at hLower
  cases hScrutinee : Expr.lower1? state scrutinee with
  | none =>
      simp [hScrutinee] at hLower
  | some scrutineeResult =>
      rcases scrutineeResult with
        ⟨preScrutinee, lowerScrutinee, stateAfterScrutinee⟩
      cases hCases :
          Stmt.CaseList.toFunctionsFuel? fuel stateAfterScrutinee cases with
      | none =>
          simp [hScrutinee, hCases] at hLower
      | some caseResult =>
          rcases caseResult with ⟨lowerCases, stateAfterCases⟩
          simp [hScrutinee, hCases] at hLower
          rcases hLower with ⟨hLowerStmts, hState⟩
          subst lowerStmts
          subst state'
          exact
            ⟨preScrutinee, lowerScrutinee, stateAfterScrutinee, lowerCases,
              rfl, hCases, rfl⟩

theorem toFunctionsListFuel?_switch_nonempty_default_components
    {fuel : Nat} {state : Fresh.State} {scrutinee : AstExpr}
    {cases : List (Word × List AstStmt)}
    {defaultHead : AstStmt} {defaultTail : List AstStmt}
    {lowerStmts : List Functions.Stmt} {state' : Fresh.State}
    (hLower :
      Stmt.toFunctionsListFuel? fuel.succ state
          (.Switch scrutinee cases (defaultHead :: defaultTail)) =
        some (lowerStmts, state')) :
    ∃ preScrutinee : List Functions.Stmt,
    ∃ lowerScrutinee : Functions.Expr 1,
    ∃ stateAfterScrutinee : Fresh.State,
    ∃ lowerCases : List (Word × Functions.Block),
    ∃ stateAfterCases : Fresh.State,
    ∃ lowerDefault : Functions.Block,
      Expr.lower1? state scrutinee =
        some (preScrutinee, lowerScrutinee, stateAfterScrutinee) ∧
      Stmt.CaseList.toFunctionsFuel? fuel stateAfterScrutinee cases =
        some (lowerCases, stateAfterCases) ∧
      Stmt.List.toBlockFuel? fuel stateAfterCases
          (defaultHead :: defaultTail) =
        some (lowerDefault, state') ∧
      lowerStmts =
        preScrutinee ++
          [Functions.Stmt.switch lowerScrutinee lowerCases
            (some lowerDefault)] := by
  simp [Stmt.toFunctionsListFuel?] at hLower
  cases hScrutinee : Expr.lower1? state scrutinee with
  | none =>
      simp [hScrutinee] at hLower
  | some scrutineeResult =>
      rcases scrutineeResult with
        ⟨preScrutinee, lowerScrutinee, stateAfterScrutinee⟩
      cases hCases :
          Stmt.CaseList.toFunctionsFuel? fuel stateAfterScrutinee cases with
      | none =>
          simp [hScrutinee, hCases] at hLower
      | some caseResult =>
          rcases caseResult with ⟨lowerCases, stateAfterCases⟩
          cases hDefault :
              Stmt.List.toBlockFuel? fuel stateAfterCases
                (defaultHead :: defaultTail) with
          | none =>
              simp [hScrutinee, hCases, hDefault] at hLower
          | some defaultResult =>
              rcases defaultResult with ⟨lowerDefault, stateAfterDefault⟩
              simp [hScrutinee, hCases, hDefault] at hLower
              rcases hLower with ⟨hLowerStmts, hState⟩
              subst lowerStmts
              subst state'
              exact
                ⟨preScrutinee, lowerScrutinee, stateAfterScrutinee,
                  lowerCases, stateAfterCases, lowerDefault, rfl, hCases,
                  hDefault, rfl⟩


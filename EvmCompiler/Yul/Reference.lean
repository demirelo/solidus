theorem eval_var_compiler_push_temp_withTemps {cfg : StateRelConfig}
    {layout : List Name} {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore} {compiler : EVMState}
    (fuel : Nat) (name : EvmYul.Identifier)
    (codeOverride : Option AstContract) (ctx : Locals.Ctx)
    {temps : EvmYul.Stack Word} {offset idx : Nat}
    (hVarRelExact : cfg.varStackRel = ExactVarStackRel)
    (hCtxLayout : ctx.layout = layout)
    (hOffset : offset = temps.length)
    (hNoDup : layout.Nodup)
    (hName : layout[idx]? = some (identName name))
    (hBound : offset + idx + 1 ≤ 16)
    (hRel :
      CompilerStateRelWithTemps cfg layout temps (.Ok shared store)
        compiler) :
    ∃ value compiler',
      EvmYul.Yul.eval fuel.succ (.Var name) codeOverride
          (.Ok shared store) =
        .ok (.Ok shared store, value) ∧
      Locals.Direct.Expr.runCode ctx offset (.var (identName name)) compiler =
        .ok compiler' ∧
      CompilerStateRelWithTemps cfg layout (value :: temps)
        (.Ok shared store) compiler' := by
  cases hRel with
  | @ok shared' store' compiler' locals hShared hVars hStack =>
      have hVarsExact :
          ExactVarStackRel layout store locals := by
        simpa [hVarRelExact] using hVars
      rcases ExactVarStackRel.get? hVarsExact hName with
        ⟨value, hLocalStack, hStore⟩
      let compiler' :=
        compiler.replaceStackAndIncrPC (value :: compiler.stack)
      refine ⟨value, compiler', ?hEval, ?hRun, ?hRel⟩
      · rw [Imported.eval_var_succ]
        simp [lookup?_ok (shared := shared) hStore]
      · have hDepth :
            Locals.Layout.lookupDepth? (identName name) ctx.layout =
              some (idx + 1) := by
          simpa [hCtxLayout] using
            (lookupDepth?_of_get?_nodup hName hNoDup)
        have hStackAt :
            compiler.stack[offset + idx]? = some value := by
          subst offset
          rw [hStack]
          rw [List.getElem?_append_right]
          · simpa using hLocalStack
          · omega
        have hOne : 1 ≤ offset + (idx + 1) := by omega
        have hBound' : offset + (idx + 1) ≤ 16 := by omega
        rcases
          stackOp_dup?_step_eq_dup
            (n := offset + (idx + 1)) hOne hBound' compiler with
          ⟨op, hDup, hStep⟩
        have hDupValue :
            EvmYul.dup (offset + (idx + 1)) compiler =
              .ok compiler' := by
          have hDupValue' :=
            evm_dup_succ_get?
              (state := compiler) (idx := offset + idx) hStackAt
          simpa [compiler', Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
            using hDupValue'
        simp [Locals.Direct.Expr.runCode, hDepth, hDup]
        rw [hStep, hDupValue]
      · exact CompilerStateRelWithTemps.ok
          (by
            simpa [compiler', EvmYul.EVM.State.replaceStackAndIncrPC,
              EvmYul.EVM.State.incrPC] using hShared)
          hVars
          (by
            simp [compiler', EvmYul.EVM.State.replaceStackAndIncrPC,
              EvmYul.EVM.State.incrPC, hStack])


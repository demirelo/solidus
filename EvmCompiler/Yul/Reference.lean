                              ⟨leftIdx, hLeftName, hLeftStack⟩
                              (ArgSlotValues.cons_var
                                ⟨middleIdx, hMiddleName, hMiddleStack⟩
                                (ArgSlotValues.cons_var
                                  ⟨rightIdx, hRightName, hRightStack⟩
                                  ArgSlotValues.nil)))
                            hStackSeq hArgBound with
                        ⟨evmAfterArgReads, hRunArgs, hStackAfterArgs,
                          hSharedAfterArgs⟩
                      have hStackAfterReads :
                          evmAfterArgReads.stack =
                            leftValue :: middleValue :: rightValue ::
                              compilerAfterArgs.evm.stack := by
                        simpa using hStackAfterArgs
                      let finalEVM : EVMState :=
                        evmAfterArgReads.replaceStackAndIncrPC
                          (result leftValue middleValue rightValue ::
                            compilerAfterArgs.evm.stack)
                      have hRunOp :
                          Structured.BasicOp.step op evmAfterArgReads =
                            .ok finalEVM := by
                        simpa [finalEVM] using
                          hStep evmAfterArgReads leftValue middleValue
                            rightValue compilerAfterArgs.evm.stack
                            hStackAfterReads
                      have hRunCode :
                          Locals.Direct.Expr.runCode ctxAfter 0 target
                              compilerAfterArgs.evm =
                            .ok finalEVM := by
                        rw [hTargetRunCode ctxAfter compilerAfterArgs]
                        simp [hRunArgs, hRunOp]
                      let compilerAfterExpr : RunState :=
                        compilerAfterArgs.withEVM finalEVM
                      have hRunState :
                          Locals.Direct.Expr.runState ctxAfter target
                              compilerAfterArgs =
                            .ok compilerAfterExpr := by
                        unfold Locals.Direct.Expr.runState
                        simp [hRunCode, compilerAfterExpr]
                      have hRelAfter :
                          CompilerStateRelWithTempsAndLayoutSlots cfg
                            sourceLayout fullLayoutAfter
                            [result leftValue middleValue rightValue]
                            (.Ok sharedAfter storeAfter)
                            compilerAfterExpr.evm := by
                        refine
                          CompilerStateRelWithTempsAndLayoutSlots.ok
                            ?_ hVarsAfter hCoverAfter ?_
                        · simpa [compilerAfterExpr, finalEVM,
                            EvmYul.EVM.State.replaceStackAndIncrPC,
                            EvmYul.EVM.State.incrPC, hSharedAfterArgs]
                            using hSharedAfter
                        · simp [compilerAfterExpr, finalEVM,
                            EvmYul.EVM.State.replaceStackAndIncrPC,
                            EvmYul.EVM.State.incrPC]
                      exact
                        ⟨.Ok sharedAfter storeAfter,
                          result leftValue middleValue rightValue,
                          compilerAfterArgs, compilerAfterExpr, ctxAfter,
                          preFuel, hSourceEval, hPreRun, hCtxLayout,
                          hCtxAfterLayout, hSuffix, hRunState, hRelAfter,
                          hReturns, by simp [compilerAfterExpr]⟩


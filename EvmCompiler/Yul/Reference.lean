theorem sourceBlock_runOpen_of_runScoped_nonregular
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {fuel : Nat} {block : Functions.Block}
    {state : Objects.Source.State} {outcome : Functions.Source.Outcome}
    (hScoped :
      Functions.Source.Block.runScoped prim program ctx block fuel state =
        .ok outcome)
    (hNonregular : outcome.mode ≠ Locals.Source.Mode.regular) :
    ∃ ctxAfter : Functions.Source.Ctx,
      Functions.Source.Block.runOpen prim program ctx fuel block state =
        .ok (outcome, ctxAfter) := by
  unfold Functions.Source.Block.runScoped at hScoped
  cases hOpen :
      Functions.Source.Block.runOpen prim program ctx fuel block state with
  | error err =>
      simp [hOpen] at hScoped
  | ok result =>
      rcases result with ⟨openOutcome, ctxAfter⟩
      cases openOutcome with
      | mk openState openMode =>
          cases openMode <;>
            simp [hOpen, Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular] at hScoped
          · cases hScoped
            exact (hNonregular rfl).elim
          · cases hScoped
            exact ⟨ctxAfter, by simp [hOpen]⟩
          · cases hScoped
            exact ⟨ctxAfter, by simp [hOpen]⟩
          · cases hScoped
            exact ⟨ctxAfter, by simp [hOpen]⟩
          · cases hScoped
            exact ⟨ctxAfter, by simp [hOpen]⟩


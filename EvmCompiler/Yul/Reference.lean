theorem sourceResultSeqRunAt_cons_regular_head
    {cfg : StateRelConfig}
    {layout layoutMid ctxAfterLayout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxMid : Functions.Source.Ctx}
    {sourceFuel targetFuel : Nat} {head : AstStmt}
    {rest : List AstStmt} {codeOverride : Option AstContract}
    {source sourceMid : State}
    {compiler compilerMid : Objects.Source.State}
    {lowerHead : Functions.Stmt} {lowerTail : Functions.Block}
    (hScope : ctx.scope = layout)
    (hSourceHead :
      EvmYul.Yul.exec sourceFuel head codeOverride source =
        .ok sourceMid)
    (hCompilerHead :
      Functions.Source.Stmt.run prim program ctx targetFuel lowerHead
          compiler =
        .ok (Functions.Source.Outcome.regular compilerMid, ctxMid))
    (hRelMid : SourceStateRel cfg layoutMid sourceMid compilerMid)
    (hLayoutSubset : ∀ name, name ∈ layout → name ∈ layoutMid)
    (hTail :
      SourceResultSeqRunAt cfg layoutMid ctxAfterLayout outcomeLayout
        terminalRel revertRel prim program ctxMid sourceFuel targetFuel rest
        codeOverride sourceMid compilerMid lowerTail) :
    SourceResultSeqRunAt cfg layout ctxAfterLayout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel.succ targetFuel.succ
      (head :: rest) codeOverride source compiler
      { stmts := lowerHead :: lowerTail.stmts } := by
  cases hRelMid with
  | @ok sharedMid storeMid _ hSharedMid hVarsMid =>
      rcases hTail with
        ⟨sourceResult, sourceOutcome, ctxAfter, hSourceTail, hCompilerTail,
          _hTailScope, hCtxAfterScope, hSubsetTail, hOutcomeRel⟩
      refine
        ⟨sourceResult, sourceOutcome, ctxAfter, ?_, ?_, hScope,
          hCtxAfterScope, ?_, hOutcomeRel⟩
      · exact Imported.execSeq_cons_ok_result_succ hSourceHead hSourceTail
      · cases lowerTail with
        | mk tailStmts =>
            simpa [Functions.Source.Block.runOpen, hCompilerHead,
              Functions.Source.Outcome.regular,
              Locals.Source.Outcome.regular] using hCompilerTail
      · intro name hMem
        exact hSubsetTail name (hLayoutSubset name hMem)

theorem sourceResultSeqRunAt_cons_nonregular_head
    {cfg : StateRelConfig}
    {layout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx ctxHead : Functions.Source.Ctx}
    {sourceFuel targetFuel : Nat} {head : AstStmt}
    {rest : List AstStmt} {codeOverride : Option AstContract}
    {source : State} {compiler : Objects.Source.State}
    {lowerHead : Functions.Stmt} {lowerTail : Functions.Block}
    {sourceResult : Except Exception State}
    {sourceOutcome : Objects.Source.Outcome}
    (hScope : ctx.scope = layout)
    (hSourceHead :
      EvmYul.Yul.exec sourceFuel head codeOverride source = sourceResult)
    (hCompilerHead :
      Functions.Source.Stmt.run prim program ctx targetFuel lowerHead
          compiler =
        .ok (sourceOutcome, ctxHead))
    (hOutcomeRel :
      SourceResultOutcomeRel cfg outcomeLayout terminalRel revertRel
        sourceResult sourceOutcome)
    (hNonregular : sourceOutcome.mode ≠ Locals.Source.Mode.regular) :
    SourceResultSeqRunAt cfg layout layout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel.succ targetFuel.succ
      (head :: rest) codeOverride source compiler
      { stmts := lowerHead :: lowerTail.stmts } := by
  have hCompilerSeq :
      Functions.Source.Block.runOpen prim program ctx targetFuel.succ
          { stmts := lowerHead :: lowerTail.stmts } compiler =
        .ok (sourceOutcome, ctx) := by
    cases lowerTail with
    | mk tailStmts =>
        cases sourceOutcome with
        | mk outcomeState outcomeMode =>
            cases outcomeMode <;>
              simp [Functions.Source.Block.runOpen, hCompilerHead,
                Functions.Source.Outcome.regular,
                Locals.Source.Outcome.regular] at hNonregular ⊢
  refine
    ⟨sourceResult, sourceOutcome, ctx, ?_, hCompilerSeq, hScope, hScope,
      (fun _ hMem => hMem), hOutcomeRel⟩
  cases hOutcomeRel with
  | ok hOk =>
      cases hOk with
      | regular hRel =>
          exfalso
          exact hNonregular rfl
      | brk hRel =>
          exact Imported.execSeq_cons_checkpoint_succ hSourceHead
      | cont hRel =>
          exact Imported.execSeq_cons_checkpoint_succ hSourceHead
      | leave hRel =>
          exact Imported.execSeq_cons_checkpoint_succ hSourceHead
  | yulHalt hRel =>
      exact Imported.execSeq_cons_error_succ hSourceHead
  | revert hRel =>
      exact Imported.execSeq_cons_error_succ hSourceHead

theorem sourceResultSeqRunAt_cons_regular_stmt
    {cfg : StateRelConfig}
    {layout layoutMid ctxAfterLayout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel targetFuel : Nat} {head : AstStmt}
    {rest : List AstStmt} {codeOverride : Option AstContract}
    {source : State} {compiler : Objects.Source.State}
    {lowerHead : Functions.Stmt} {lowerTail : Functions.Block}
    (hHead :
      SourceRegularStmtRunAt cfg layout layoutMid prim program ctx sourceFuel
        targetFuel head codeOverride source compiler lowerHead)
    (hTail :
      ∀ {sourceMid : State} {compilerMid : Objects.Source.State}
        {ctxMid : Functions.Source.Ctx},
        ctxMid.scope = layoutMid →
        SourceStateRel cfg layoutMid sourceMid compilerMid →
        SourceResultSeqRunAt cfg layoutMid ctxAfterLayout outcomeLayout
          terminalRel revertRel prim program ctxMid sourceFuel targetFuel rest
          codeOverride sourceMid compilerMid lowerTail) :
    SourceResultSeqRunAt cfg layout ctxAfterLayout outcomeLayout terminalRel
      revertRel prim program ctx sourceFuel.succ targetFuel.succ
      (head :: rest) codeOverride source compiler
      { stmts := lowerHead :: lowerTail.stmts } := by
  rcases hHead with
    ⟨sourceMid, compilerMid, ctxMid, hSourceHead, hCompilerHead, hScope,
      hCtxMidScope, hSubset, hRelMid⟩
  exact
    sourceResultSeqRunAt_cons_regular_head
      (cfg := cfg) (layout := layout) (layoutMid := layoutMid)
      (ctxAfterLayout := ctxAfterLayout) (outcomeLayout := outcomeLayout)
      (terminalRel := terminalRel) (revertRel := revertRel)
      (prim := prim) (program := program) (ctx := ctx) (ctxMid := ctxMid)
      (sourceFuel := sourceFuel) (targetFuel := targetFuel) (head := head)
      (rest := rest) (codeOverride := codeOverride) (source := source)
      (sourceMid := sourceMid) (compiler := compiler)
      (compilerMid := compilerMid) (lowerHead := lowerHead)
      (lowerTail := lowerTail) hScope hSourceHead hCompilerHead hRelMid
      hSubset (hTail hCtxMidScope hRelMid)

/--
Fuel-specific open-sequence composition for a regular statement head.

The head and tail both run at the same smaller source/target fuels used by the
two interpreters under a cons.  Keeping the target fuel fixed here is the
important compositional boundary: callers can prove the tail once at the exact
subfuel required by `Block.runOpen`, and only project back to the existential
public theorem after the cons has been assembled.
-/
theorem sourceResultSeqSoundWhenAtFuel_cons_regular_stmt
    {cfg : StateRelConfig}
    {layout layoutMid ctxAfterLayout outcomeLayout : List Name}
    {terminalRel :
      Assembly.HaltKind → Word → State → Objects.Source.State → Prop}
    {revertRel : State → Objects.Source.State → Prop}
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {ctx : Functions.Source.Ctx}
    {sourceFuel targetFuel : Nat} {head : AstStmt}
    {rest : List AstStmt} {codeOverride : Option AstContract}
    {lowerHead : Functions.Stmt} {lowerTail : Functions.Block}
    {allowed : Except Exception State → Prop}
    (hHead :
      SourceRegularStmtSoundAt cfg layout layoutMid prim program ctx
        sourceFuel targetFuel head codeOverride lowerHead)
    (hTail :
      ∀ {sourceMid : State} {compilerMid : Objects.Source.State}
        {ctxMid : Functions.Source.Ctx},
        ctxMid.scope = layoutMid →
        SourceStateRel cfg layoutMid sourceMid compilerMid →
        SourceResultSeqSoundWhenAtFuel cfg layoutMid ctxAfterLayout
          outcomeLayout terminalRel revertRel prim program ctxMid
          sourceFuel targetFuel rest codeOverride lowerTail allowed) :
    SourceResultSeqSoundWhenAtFuel cfg layout ctxAfterLayout outcomeLayout
      terminalRel revertRel prim program ctx sourceFuel.succ
      targetFuel.succ (head :: rest) codeOverride
      { stmts := lowerHead :: lowerTail.stmts } allowed := by

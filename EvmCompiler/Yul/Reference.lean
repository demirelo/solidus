theorem root_body_of_dispatcher_stop
    {program : Program} {functionProgram : Functions.Program}
    (hToObjects :
      program.toObjects? =
        some { root := Objects.Object.mk "root" functionProgram [] [] })
    (hDispatcher :
      program.contract.dispatcher =
        .ExprStmtCall
          (.Call (.inl ((.StopArith .STOP : EvmYul.Operation .Yul))) [])) :
    functionProgram.body =
      { stmts := [Functions.Stmt.terminalArgs .stop Locals.ExprSeq.nil] } := by
  rcases
      Reference.BridgeFacts.toObjects?_root_components
        (program := program) (functionProgram := functionProgram)
        hToObjects with
    ⟨bodyStmts, state, functions, _state', hDispatcherLower,
      _hFunctions, hFunctionProgram⟩
  have hBodyStmts :
      bodyStmts =
        [Functions.Stmt.terminalArgs .stop Locals.ExprSeq.nil] := by
    rw [hDispatcher] at hDispatcherLower
    simp [Stmt.toFunctionsList?, Stmt.fuel, Stmt.toFunctionsListFuel?,
      Prim.terminal?, Expr.List.lowerBound1?, Expr.List.toStackSeq?,
      Expr.List.toSeq?, Assembly.HaltKind.argCount] at hDispatcherLower
    exact hDispatcherLower.1.symm
  rw [hFunctionProgram]
  simp [hBodyStmts]

theorem root_body_terminal_components_of_dispatcher
    {program : Program} {functionProgram : Functions.Program}
    {prim : EvmYul.Operation .Yul} {args : List AstExpr}
    {kind : Assembly.HaltKind}
    (hToObjects :
      program.toObjects? =
        some { root := Objects.Object.mk "root" functionProgram [] [] })
    (hTerminal : Prim.terminal? prim = some kind)
    (hDispatcher :
      program.contract.dispatcher =
        .ExprStmtCall (.Call (.inl prim) args)) :
    ∃ preArgs : List Functions.Stmt,
    ∃ lowerArgs : List (Locals.Expr 1),
    ∃ stateAfterArgs : Fresh.State,
    ∃ stateAfterDispatcher : Fresh.State,
    ∃ seq : Locals.ExprSeq kind.argCount,
      Expr.List.lowerBound1?
          (Fresh.initial (Contract.names program.contract)) args =
        some (preArgs, lowerArgs, stateAfterArgs) ∧
      Expr.List.toStackSeq? lowerArgs kind.argCount = some seq ∧
      functionProgram.body.stmts =
        preArgs ++ [Functions.Stmt.terminalArgs kind seq] ∧
      stateAfterArgs = stateAfterDispatcher := by
  rcases
      Reference.BridgeFacts.toObjects?_dispatcher_body
        (program := program) (functionProgram := functionProgram)
        hToObjects with
    ⟨stateAfterDispatcher, hLower⟩
  rw [hDispatcher] at hLower
  have hLowerFuel :
      Stmt.toFunctionsListFuel?
          (sizeOf ((.ExprStmtCall (.Call (.inl prim) args)) : AstStmt) + 1)
          (Fresh.initial (Contract.names program.contract))
          (.ExprStmtCall (.Call (.inl prim) args)) =
        some (functionProgram.body.stmts, stateAfterDispatcher) := by
    simpa [Stmt.toFunctionsList?] using hLower
  rcases
      Reference.BridgeFacts.toFunctionsListFuel?_terminal_components
        (fuel := sizeOf ((.ExprStmtCall (.Call (.inl prim) args)) : AstStmt))
        (state := Fresh.initial (Contract.names program.contract))
        (state' := stateAfterDispatcher) (prim := prim) (args := args)
        (kind := kind) (lowerPrefix := functionProgram.body.stmts)
        hTerminal (by simpa [Nat.succ_eq_add_one] using hLowerFuel) with
    ⟨preArgs, lowerArgs, stateAfterArgs, seq, hArgs, hSeq, hBody, hState⟩
  exact
    ⟨preArgs, lowerArgs, stateAfterArgs, stateAfterDispatcher, seq,
      hArgs, hSeq, hBody, hState⟩

theorem root_body_return_lit_lit_prelude_of_dispatcher
    {program : Program} {functionProgram : Functions.Program}
    {offset size : Word} {sizeTmp offsetTmp : Name}
    {stateAfterArgs : Fresh.State}
    (hToObjects :
      program.toObjects? =
        some { root := Objects.Object.mk "root" functionProgram [] [] })
    (hDispatcher :
      program.contract.dispatcher =
        .ExprStmtCall
          (.Call (.inl ((.System .RETURN : EvmYul.Operation .Yul)))
            [.Lit offset, .Lit size]))
    (hLowerArgs :
      Expr.List.lowerBound1?
          (Fresh.initial (Contract.names program.contract))
          [.Lit offset, .Lit size] =
        some
          ([Functions.Stmt.let_ sizeTmp (Locals.Expr.lit size),
            Functions.Stmt.let_ offsetTmp (Locals.Expr.lit offset)],
           [Locals.Expr.var offsetTmp, Locals.Expr.var sizeTmp],
           stateAfterArgs)) :
    functionProgram.body =
      { stmts :=
        [Functions.Stmt.let_ sizeTmp (Locals.Expr.lit size),
         Functions.Stmt.let_ offsetTmp (Locals.Expr.lit offset),
         Functions.Stmt.terminalArgs .return
          (Locals.ExprSeq.cons (Locals.Expr.var sizeTmp)
            (Locals.ExprSeq.cons (Locals.Expr.var offsetTmp)
              Locals.ExprSeq.nil))] } := by
  rcases
      root_body_terminal_components_of_dispatcher
        (program := program) (functionProgram := functionProgram)
        (prim := (.System .RETURN : EvmYul.Operation .Yul))
        (args := [.Lit offset, .Lit size]) (kind := .return)
        hToObjects (by rfl) hDispatcher with
    ⟨preArgs, lowerArgs, _stateAfterArgs, _stateAfterDispatcher, seq,
      hArgs, hSeq, hBody, _hState⟩
  rw [hLowerArgs] at hArgs
  cases hArgs
  have hSeqEq :
      seq =
        (Locals.ExprSeq.cons (Locals.Expr.var sizeTmp)
          (Locals.ExprSeq.cons (Locals.Expr.var offsetTmp)
            Locals.ExprSeq.nil)) := by
    change
      Expr.List.toSeq?
          [Locals.Expr.var sizeTmp, Locals.Expr.var offsetTmp] 2 =
        some seq at hSeq
    simpa [Expr.List.toSeq?, Expr.seqCast] using hSeq.symm
  have hBodyStmts :
      functionProgram.body.stmts =
        [Functions.Stmt.let_ sizeTmp (Locals.Expr.lit size),
         Functions.Stmt.let_ offsetTmp (Locals.Expr.lit offset),
         Functions.Stmt.terminalArgs .return
          (Locals.ExprSeq.cons (Locals.Expr.var sizeTmp)
            (Locals.ExprSeq.cons (Locals.Expr.var offsetTmp)
              Locals.ExprSeq.nil))] := by
    simpa [hSeqEq] using hBody
  rw [← hBodyStmts]
  cases functionProgram.body
  rfl


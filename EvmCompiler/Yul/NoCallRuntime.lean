      compileCheckedAssemblyTargetBytecodeResourcesFeaturesSourceStaticNoReturnDataCopy?
          program =
        some (asm, target)) :
    Assembly.GasAware.XStepTrace.XBlockReplayNoReturnDataCopy asm target :=

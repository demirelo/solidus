private def OpenXCurrentRunningInstrCallGasBudgetNonGasTraceReadyCase
    (targetProgram : Assembly.TargetProgram)
    (state : EVMState) (instr : Assembly.Instr)
    (trace : OpenExternal.OpenTrace) : Prop :=
  ∃ op : Assembly.PrimOp,
    ∃ kind : OpenExternal.CallKind,
      ∃ call : OpenExternal.OpenCall EVMState,
        instr = .prim op ∧
          OpenExternal.CallKind.ofEVMOperation? op.toEVM = some kind ∧
            OpenExternal.CallKind.evmOpenCall? state kind = some call ∧
              (∀ {full : EVMState},
                Assembly.GasAware.GasExecRel full state →
                  Assembly.GasAware.XNonGasChecksPass
                    (Assembly.GasAware.validJumps targetProgram)
                    full op.toEVM) ∧
              (∀ {response : OpenExternal.CallResponse}
                  {tailGasBound : Nat},
                OpenExternal.OpenEvent.call call.site response ∈ trace →
                  ∃ gasBound : Nat,
                    (∀ {full : EVMState},
                      gasBound ≤ full.gasAvailable.toNat →
                        Assembly.GasAware.GasExecRel full state →
                          Assembly.GasAware.XStepChecksPass
                            (Assembly.GasAware.validJumps targetProgram)
                            full op.toEVM) ∧
                    (∀ {full : EVMState}
                        {gasCall : OpenExternal.OpenCall EVMState},
                      gasBound ≤ full.gasAvailable.toNat →
                        Assembly.GasAware.GasExecRel full state →
                          OpenExternal.CallKind.evmOpenCall?
                              (OpenGasAware.gasChargedState full op.toEVM)
                              kind = some gasCall →
                            tailGasBound ≤
                              (EvmYul.EVM.State.incrPC
                              (OpenGasAware.finishGasAwareCall gasCall
                                  response)).gasAvailable.toNat))

theorem xNonGasChecksPass_of_witnessed_stepChecks
    {targetProgram : Assembly.TargetProgram}
    {state : EVMState} {op : Assembly.EVMOp} {gasBound : Nat}
    (hInitialCode :
      state.executionEnv.code =
        Assembly.Bytecode.encodeTarget targetProgram)
    (hGasFits : gasBound < EvmYul.UInt256.size)
    (hStepChecks :
      ∀ {full : EVMState},
        gasBound ≤ full.gasAvailable.toNat →
          Assembly.GasAware.GasExecRel full state →
            Assembly.GasAware.XStepChecksPass
              (Assembly.GasAware.validJumps targetProgram) full op) :
    ∀ {full : EVMState},
      Assembly.GasAware.GasExecRel full state →
        Assembly.GasAware.XNonGasChecksPass
          (Assembly.GasAware.validJumps targetProgram) full op := by
  intro full hRel
  let witness :=
    Assembly.GasAware.installCodeAndGas targetProgram gasBound state
  have hWitnessRel :
      Assembly.GasAware.GasExecRel witness state :=
    Assembly.GasAware.GasExecRel.installCodeAndGas_of_code_eq
      (target := targetProgram) (gas := gasBound) (initial := state)
      hInitialCode
  have hWitnessGas :
      gasBound ≤ witness.gasAvailable.toNat := by
    dsimp [witness]
    rw [Assembly.GasAware.installCodeAndGas_gasAvailable_toNat hGasFits]
  have hWitnessStep :
      Assembly.GasAware.XStepChecksPass
        (Assembly.GasAware.validJumps targetProgram) witness op :=
    hStepChecks hWitnessGas hWitnessRel
  have hStateNonGas :
      Assembly.GasAware.XNonGasChecksPass
        (Assembly.GasAware.validJumps targetProgram) state op :=
    (Assembly.GasAware.XNonGasChecksPass_iff_of_gasExecRel
      hWitnessRel).mp hWitnessStep.1
  exact
    (Assembly.GasAware.XNonGasChecksPass_iff_of_gasExecRel hRel).mpr
      hStateNonGas


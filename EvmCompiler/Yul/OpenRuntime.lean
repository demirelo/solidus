private inductive OpenXCompiledOpenCurrentEmittedEvidenceFor
    {cfg : Reference.StateRelConfig}
    {program : Assembly.Program} {targetProgram : Assembly.TargetProgram} :
    {targetFuel : Nat} → {state : EVMState} →
      {trace : OpenExternal.OpenTrace} →
        {targetResult : Assembly.StepResult} →
          OpenAssembly.OpenBlockTraceResult program targetProgram targetFuel
            state trace targetResult → Prop where
  | done (state : EVMState) :
      OpenXCompiledOpenCurrentEmittedEvidenceFor
        (OpenAssembly.OpenBlockTraceResult.done
          (program := program) (target := targetProgram) state)
  | stepRunning
      {fuel : Nat} {state mid : EVMState}
      {trace tailTrace : OpenExternal.OpenTrace}
      {result : Assembly.StepResult}
      {pc : Nat} {instr : Assembly.Instr}
      {emitted before after : List Assembly.LocatedTarget}
      (hAt :
        Assembly.Program.instrAtPc program state.pc.toNat =
          some (pc, instr))
      (hEmit : Assembly.emitInstr? program pc instr = some emitted)
      (hTargetBlock : targetProgram.code = before ++ emitted ++ after)
      (hRun :
        OpenExternal.OpenResultResolves
          (OpenAssembly.Target.openRunListResult
            (emitted.map Assembly.LocatedTarget.instr) state)
          trace (.ok (.running mid)))
      {hRest :
        OpenAssembly.OpenBlockTraceResult program targetProgram fuel mid
          tailTrace result}
      (hCurrentEvidence :
        OpenXCurrentRunningInstrCompiledOpenEvidenceCase cfg targetProgram
          program state instr)
      (hRestEvidence :
        OpenXCompiledOpenCurrentEmittedEvidenceFor (cfg := cfg) hRest) :
      OpenXCompiledOpenCurrentEmittedEvidenceFor
        (OpenAssembly.OpenBlockTraceResult.stepRunning
          hAt hEmit hTargetBlock hRun hRest)
  | stepHalted
      {fuel : Nat} {state : EVMState}
      {trace : OpenExternal.OpenTrace} {halt : Assembly.Halt}
      {pc : Nat} {instr : Assembly.Instr}
      {emitted before after : List Assembly.LocatedTarget}
      (hAt :
        Assembly.Program.instrAtPc program state.pc.toNat =
          some (pc, instr))
      (hEmit : Assembly.emitInstr? program pc instr = some emitted)
      (hTargetBlock : targetProgram.code = before ++ emitted ++ after)
      (hRun :
        OpenExternal.OpenResultResolves
          (OpenAssembly.Target.openRunListResult
            (emitted.map Assembly.LocatedTarget.instr) state)
          trace (.ok (.halted halt)))
      (hNoCall : Assembly.Instr.usesCallCreate instr = false) :
      OpenXCompiledOpenCurrentEmittedEvidenceFor
        (OpenAssembly.OpenBlockTraceResult.stepHalted
          hAt hEmit hTargetBlock hRun)

namespace OpenXCompiledOpenCurrentEmittedEvidenceFor

  private theorem cast_trace
    {cfg : Reference.StateRelConfig}
    {program : Assembly.Program} {targetProgram : Assembly.TargetProgram}
    {targetFuel : Nat} {state : EVMState}
    {trace : OpenExternal.OpenTrace} {targetResult : Assembly.StepResult}
    {hTrace hTrace' :
      OpenAssembly.OpenBlockTraceResult program targetProgram targetFuel
        state trace targetResult}
    (hReady :
      OpenXCompiledOpenCurrentEmittedEvidenceFor (cfg := cfg) hTrace) :
    OpenXCompiledOpenCurrentEmittedEvidenceFor (cfg := cfg) hTrace' := by
  have hEq : hTrace = hTrace' := proof_irrel hTrace hTrace'
  subst hTrace'
  exact hReady

  private theorem of_source_trace_current_shared_bridge_ready_gas_cases
    {cfg : Reference.StateRelConfig}
    {program : Assembly.Program} {targetProgram : Assembly.TargetProgram}
    {targetFuel : Nat} {state : EVMState}
    {trace : OpenExternal.OpenTrace} {targetResult : Assembly.StepResult}
    (hAssemble : Assembly.assemble? program = some targetProgram)
    (hRunningGasReady :
      ∀ {state mid : EVMState}
        {currentTrace : OpenExternal.OpenTrace}
        {pc : Nat} {instr : Assembly.Instr}
        {emitted before after : List Assembly.LocatedTarget},
        Assembly.Program.instrAtPc program state.pc.toNat =
          some (pc, instr) →
        Assembly.emitInstr? program pc instr = some emitted →
        targetProgram.code = before ++ emitted ++ after →
        OpenExternal.OpenResultResolves
          (OpenAssembly.Target.openRunListResult
            (emitted.map Assembly.LocatedTarget.instr) state)
          currentTrace (.ok (.running mid)) →
        OpenXCurrentRunningInstrGasReadyCase targetProgram state instr)
    (hHaltedNoCall :
      ∀ {state : EVMState}
        {currentTrace : OpenExternal.OpenTrace} {halt : Assembly.Halt}
        {pc : Nat} {instr : Assembly.Instr}
        {emitted before after : List Assembly.LocatedTarget},
        Assembly.Program.instrAtPc program state.pc.toNat =
          some (pc, instr) →
        Assembly.emitInstr? program pc instr = some emitted →
        targetProgram.code = before ++ emitted ++ after →
        OpenExternal.OpenResultResolves
          (OpenAssembly.Target.openRunListResult
            (emitted.map Assembly.LocatedTarget.instr) state)
          currentTrace (.ok (.halted halt)) →
        Assembly.Instr.usesCallCreate instr = false)
    {hTrace :
      OpenAssembly.Source.OpenTraceResult program targetFuel state trace
        targetResult}
    (hReady :
      OpenLowering.SourceOpenTraceCurrentSharedBridgeReadyFor (cfg := cfg)
        hTrace) :
    OpenXCompiledOpenCurrentEmittedEvidenceFor (cfg := cfg)
      (OpenAssembly.Source.OpenTraceResult.to_openBlockTrace
        hAssemble hTrace) := by
  induction hReady with
  | done state =>
      exact cast_trace
        (OpenXCompiledOpenCurrentEmittedEvidenceFor.done
          (cfg := cfg) (targetProgram := targetProgram) state)
  | stepRunning hStep hCallBridgeRel _hRestReady ih =>
      rename_i fuel0 currentState midState headTrace0 tailTrace0
        result0 hRest
      rcases
          OpenAssembly.Source.openStepResult_resolves_target_current
            hAssemble hStep with
        ⟨pc, instr, emitted, before, after, hAt, hEmit, hTargetBlock,
          hRun⟩
      have hStepEvidence :
          OpenXCurrentRunningInstrCompiledOpenEvidenceCase cfg
            targetProgram program currentState instr :=
        OpenXCurrentRunningInstrCompiledOpenEvidenceCase.of_gas_ready_case_call_bridge_rel
          (hRunningGasReady hAt hEmit hTargetBlock hRun)
          (fun {op} {kind} {call} hInstr hKind hCall => by
            cases hInstr
            exact hCallBridgeRel hAt hKind hCall)
      have hStepReady :
          OpenXCompiledOpenCurrentEmittedEvidenceFor (cfg := cfg)
            (OpenAssembly.OpenBlockTraceResult.stepRunning
              hAt hEmit hTargetBlock hRun
              (OpenAssembly.Source.OpenTraceResult.to_openBlockTrace
                hAssemble hRest)) :=
        OpenXCompiledOpenCurrentEmittedEvidenceFor.stepRunning
          hAt hEmit hTargetBlock hRun hStepEvidence ih
      exact cast_trace hStepReady
  | stepHalted hStep =>
      rename_i fuel0 currentState headTrace0 halt
      rcases
          OpenAssembly.Source.openStepResult_resolves_target_current
            hAssemble hStep with
        ⟨pc, instr, emitted, before, after, hAt, hEmit, hTargetBlock,
          hRun⟩
      have hStepReady :
          OpenXCompiledOpenCurrentEmittedEvidenceFor (cfg := cfg)
            (OpenAssembly.OpenBlockTraceResult.stepHalted
              (fuel := fuel0) hAt hEmit hTargetBlock hRun) :=
        OpenXCompiledOpenCurrentEmittedEvidenceFor.stepHalted
          (fuel := fuel0)
          hAt hEmit hTargetBlock hRun
          (hHaltedNoCall hAt hEmit hTargetBlock hRun)
      exact cast_trace hStepReady

end OpenXCompiledOpenCurrentEmittedEvidenceFor

private theorem currentEmittedTraceReadyFor_of_compiled_open_current_emitted_evidence
    {cfg : Reference.StateRelConfig}
    {program : Assembly.Program} {targetProgram : Assembly.TargetProgram}
    {targetFuel : Nat} {state : EVMState}
    {trace : OpenExternal.OpenTrace} {targetResult : Assembly.StepResult}
    {hTrace :
      OpenAssembly.OpenBlockTraceResult program targetProgram targetFuel state
        trace targetResult}
    (hInitialCode :
      state.executionEnv.code =
        Assembly.Bytecode.encodeTarget targetProgram)
    (hResponses :
      Reference.SourceBridgeFacts.SourceOpenTraceResponsesAdmissible cfg
        trace)
    (hEncoding :
      Assembly.Bytecode.EncodingCorrect targetProgram
        (Assembly.Bytecode.encodeTarget targetProgram))
    (hSafety : Assembly.Bytecode.DecodeSafety targetProgram)
    (hChecks :
      OpenGasAware.OpenXBlockTraceRelReady.CurrentNoCallPathChecksReady
        program targetProgram)
    (hEvidence :
      OpenXCompiledOpenCurrentEmittedEvidenceFor (cfg := cfg) hTrace) :
    OpenGasAware.OpenXBlockTraceRelReady.CurrentEmittedTraceReadyFor
      hTrace := by
  revert hInitialCode hResponses
  induction hEvidence with
  | done state =>
      intro _hCode _hResponses
      exact
        OpenGasAware.OpenXBlockTraceRelReady.CurrentEmittedTraceReadyFor.done
          state
  | stepRunning hAt hEmit hTargetBlock hRun hCurrentEvidence _hRestEvidence ih =>
      rename_i fuel state mid currentTrace tailTrace result pc instr emitted
        before after hRest
      intro hCode hResponses
      have hCurrentResponses :
          Reference.SourceBridgeFacts.SourceOpenTraceResponsesAdmissible cfg
            currentTrace :=
        OpenExternal.OpenTrace.left_of_append hResponses
      have hTailResponses :
          Reference.SourceBridgeFacts.SourceOpenTraceResponsesAdmissible cfg
            tailTrace :=
        OpenExternal.OpenTrace.right_of_append hResponses
      have hTraceReady :
          OpenGasAware.OpenXBlockTraceRelReady.CurrentRunningInstrTraceReadyCase
            targetProgram state instr currentTrace :=
        OpenXCurrentRunningInstrCompiledOpenEvidenceCase.to_trace_ready_case
          hCurrentResponses hCurrentEvidence
      obtain ⟨hRunReady, hCodeStable⟩ :=
        OpenGasAware.OpenXBlockTraceRelReady.runListRunningReadyFor_current_emitted_of_trace_ready_case_current_path_checks
          (program := program) (targetProgram := targetProgram)
          (initial := state) (mid := mid) (trace := currentTrace)
          (pc := pc) (instr := instr) (emitted := emitted)
          (before := before) (after := after)
          hEncoding hSafety hCode hAt hEmit hTargetBlock hRun
          (fun hNoInstr {full} hRel => by
            obtain ⟨_hTrace, hClosedRun⟩ :=
              OpenGasAware.OpenXBlockTraceRelReady.openRunListResult_emitInstr_no_call_inv
                hNoInstr hEmit hRun
            exact hChecks hAt hEmit hTargetBlock hNoInstr hClosedRun hRel)
          hTraceReady
      have hMidCode :
          mid.executionEnv.code =
            Assembly.Bytecode.encodeTarget targetProgram := by
        rw [hCodeStable]
        exact hCode
      exact
        OpenGasAware.OpenXBlockTraceRelReady.CurrentEmittedTraceReadyFor.stepRunning
          hAt hEmit hTargetBlock hRun hRunReady hCodeStable
          (ih hMidCode hTailResponses)
  | stepHalted hAt hEmit hTargetBlock hRun hNoCall =>
      rename_i fuel state currentTrace halt pc instr emitted before after
      intro hCode _hResponses
      exact
        OpenGasAware.OpenXBlockTraceRelReady.CurrentEmittedTraceReadyFor.stepHalted
          (fuel := fuel) hAt hEmit hTargetBlock hRun
          (OpenGasAware.OpenXBlockTraceRelReady.runListHaltedReadyFor_current_emitted_of_no_call_case
            (program := program) (targetProgram := targetProgram)
            (initial := state) (trace := currentTrace) (halt := halt)
            (pc := pc) (instr := instr) (emitted := emitted)
            (before := before) (after := after)
            hEncoding hSafety hCode hNoCall hAt hEmit hTargetBlock hRun
            hChecks)


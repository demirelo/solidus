def OpenCreateResponseCommittedEffectsEquivalent
    (left right : OpenExternal.CreateResponse) : Prop :=
  left.returnData = right.returnData ∧
    OpenCallReentrantMutationEquivalent left.internalMutation
      right.internalMutation

/--
Committed-observation safety for two possible external CREATE responses to the
same request.

Returned gas is intentionally absent for the same reason as CALL: it affects
resource feasibility, not the committed result by itself.  CREATE has no success
flag; the caller-visible status is the created address word, and creation also
updates the return-data buffer and may apply an opaque reentrant mutation.
-/
def OpenCreateResponsesCommittedSafeEquivalent
    (left right : OpenExternal.CreateResponse) : Prop :=
  left.address = right.address ∧
    OpenCreateResponseCommittedEffectsEquivalent left right

namespace OpenCreateResponsesCommittedSafeEquivalent

theorem refl (response : OpenExternal.CreateResponse) :
    OpenCreateResponsesCommittedSafeEquivalent response response := by
  exact ⟨rfl, rfl, fun _state => rfl⟩

theorem address_eq
    {left right : OpenExternal.CreateResponse}
    (hSafe : OpenCreateResponsesCommittedSafeEquivalent left right) :
    left.address = right.address :=
  hSafe.1

theorem symm
    {left right : OpenExternal.CreateResponse}
    (hSafe : OpenCreateResponsesCommittedSafeEquivalent left right) :
    OpenCreateResponsesCommittedSafeEquivalent right left := by
  exact
    ⟨hSafe.1.symm, hSafe.2.1.symm,
      fun state => (hSafe.2.2 state).symm⟩

theorem committedEffects
    {left right : OpenExternal.CreateResponse}
    (hSafe : OpenCreateResponsesCommittedSafeEquivalent left right) :
    OpenCreateResponseCommittedEffectsEquivalent left right :=
  hSafe.2


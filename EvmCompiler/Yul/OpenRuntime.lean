namespace OpenXCurrentRunningInstrCallReturnedGasBudgetReadyCase

theorem of_response_gas_admissible
    {targetProgram : Assembly.TargetProgram}
    {state : EVMState} {instr : Assembly.Instr}
    (hReady :
      OpenXCurrentRunningInstrCallResponseGasAdmissibleReadyCase
        targetProgram state instr) :
    OpenXCurrentRunningInstrCallReturnedGasBudgetReadyCase
      targetProgram state instr := by
  rcases hReady with
    ⟨op, kind, call, hInstr, hKind, hCall, hBudget⟩
  refine ⟨op, kind, call, hInstr, hKind, hCall, ?_⟩
  intro response tailGasBound
  obtain ⟨gasBound, hStepChecks, hFacts⟩ :=
    hBudget (response := response) (tailGasBound := tailGasBound)
  refine ⟨gasBound, hStepChecks, ?_⟩
  intro full gasCall hGasBound hRel hGasCall
  exact
    OpenCallResponseGasBudgetFacts.actual_post
      (hFacts hGasBound hRel hGasCall)


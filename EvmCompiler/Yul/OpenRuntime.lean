/--
Public contract-level gas conclusion for the open CALL-family route.

The first field is the high-gas liveness replay.  The second records that this
bound gives an actual feasible replay whenever it fits in UInt256 gas.  The
third is the low-gas safety theorem: every UInt256 gas budget either reaches the
same committed observation as the high-gas run or fails/reverts in the final
observation model.
-/
structure OpenXContractLivenessAndSafetyFinalObservation
    (target : Assembly.TargetProgram) (initial : EVMState)
    (trace : OpenExternal.OpenTrace) (targetResult : Assembly.StepResult)
    (evmFuel gasBound : Nat) : Prop where
  replayAbove :
    OpenGasAware.OpenXReplayAbove target initial trace targetResult evmFuel
      gasBound
  replaySomeGas :
    gasBound < EvmYul.UInt256.size →
      OpenGasAware.OpenXReplaySomeGas target initial trace targetResult
        evmFuel
  committedSafeForAllGas :
    OpenGasAware.OpenXCommittedSafeForAllGas target initial targetResult
      evmFuel


namespace OpenXContractLivenessAndSafetyFinalObservation

theorem replayAt_of_bound_le
    {target : Assembly.TargetProgram} {initial : EVMState}
    {trace : OpenExternal.OpenTrace} {targetResult : Assembly.StepResult}
    {evmFuel gasBound gas : Nat}
    (hContract :
      OpenXContractLivenessAndSafetyFinalObservation target initial trace
        targetResult evmFuel gasBound)
    (hGasAtLeast : gasBound ≤ gas)
    (hGasFits : gas < EvmYul.UInt256.size) :
    OpenGasAware.OpenXReplayAt target initial trace targetResult evmFuel
      gas :=
  hContract.replayAbove.to_replayAt hGasAtLeast hGasFits

theorem committedSafeAt_of_gas_lt
    {target : Assembly.TargetProgram} {initial : EVMState}
    {trace : OpenExternal.OpenTrace} {targetResult : Assembly.StepResult}
    {evmFuel gasBound gas : Nat}
    (hContract :
      OpenXContractLivenessAndSafetyFinalObservation target initial trace
        targetResult evmFuel gasBound)
    (hGasFits : gas < EvmYul.UInt256.size) :
    OpenGasAware.OpenXCommittedSafeAt target initial targetResult evmFuel
      gas :=
  hContract.committedSafeForAllGas gas hGasFits

theorem resultOrFailureAt_of_gas_lt
    {target : Assembly.TargetProgram} {initial : EVMState}
    {trace : OpenExternal.OpenTrace} {targetResult : Assembly.StepResult}
    {evmFuel gasBound gas : Nat}
    (hContract :
      OpenXContractLivenessAndSafetyFinalObservation target initial trace
        targetResult evmFuel gasBound)
    (hGasFits : gas < EvmYul.UInt256.size) :
    (∃ result : OpenGasAware.EVMResult,
      OpenGasAware.OpenXOutcomeResult
        (Assembly.GasAware.validJumps target) evmFuel
        (Assembly.GasAware.installCodeAndGas target gas initial)
        (.ok result) ∧
        Assembly.GasAware.XResultCommittedObservation result =
          Assembly.GasAware.XTargetCommittedObservation targetResult) ∨
      (∃ outcome : Except OpenGasAware.EVMException OpenGasAware.EVMResult,
        OpenGasAware.OpenXOutcomeResult
          (Assembly.GasAware.validJumps target) evmFuel
          (Assembly.GasAware.installCodeAndGas target gas initial)
          outcome ∧
          Assembly.GasAware.XRunOutcomeFails outcome) :=
  OpenGasAware.OpenXCommittedSafeAt.to_result_or_failure
    (committedSafeAt_of_gas_lt hContract hGasFits)

theorem outcomeSafetyAt_of_gas_lt
    {target : Assembly.TargetProgram} {initial : EVMState}
    {trace : OpenExternal.OpenTrace} {targetResult : Assembly.StepResult}
    {evmFuel gasBound gas : Nat}
    (hContract :
      OpenXContractLivenessAndSafetyFinalObservation target initial trace
        targetResult evmFuel gasBound)
    (hGasFits : gas < EvmYul.UInt256.size) :
    ∃ outcome : Except OpenGasAware.EVMException OpenGasAware.EVMResult,
      OpenGasAware.OpenXOutcomeResult
        (Assembly.GasAware.validJumps target) evmFuel
        (Assembly.GasAware.installCodeAndGas target gas initial)
        outcome ∧
      Assembly.GasAware.XRunOutcomeSafelyMatches targetResult outcome := by
  rcases committedSafeAt_of_gas_lt hContract hGasFits with
    ⟨_hGasFits, outcome, hOutcome, hMatches⟩
  exact ⟨outcome, hOutcome, hMatches⟩


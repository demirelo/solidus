inductive OpenCallChildGasStatus where
  | outOfGas
  | completed
  deriving DecidableEq, Repr

namespace OpenCallChildGasStatus

theorem eq_outOfGas_or_eq_completed (status : OpenCallChildGasStatus) :
    status = OpenCallChildGasStatus.outOfGas ∨
      status = OpenCallChildGasStatus.completed := by
  cases status <;> simp

end OpenCallChildGasStatus

structure OpenCallSameGasBudgetOutcome
    (sourceForwardedGas targetForwardedGas : Nat)
    (sourceStatus targetStatus : OpenCallChildGasStatus) : Prop where
  sameForwardedGas : sourceForwardedGas = targetForwardedGas
  sameStatus : sourceStatus = targetStatus

namespace OpenCallSameGasBudgetOutcome

theorem target_outOfGas_iff_source_outOfGas
    {sourceForwardedGas targetForwardedGas : Nat}
    {sourceStatus targetStatus : OpenCallChildGasStatus}
    (hSame :
      OpenCallSameGasBudgetOutcome sourceForwardedGas targetForwardedGas
        sourceStatus targetStatus) :
    targetStatus = OpenCallChildGasStatus.outOfGas ↔
      sourceStatus = OpenCallChildGasStatus.outOfGas := by
  constructor
  · intro hTarget
    rw [hSame.sameStatus]
    exact hTarget
  · intro hSource
    rw [← hSame.sameStatus]
    exact hSource

theorem target_completed_iff_source_completed
    {sourceForwardedGas targetForwardedGas : Nat}
    {sourceStatus targetStatus : OpenCallChildGasStatus}
    (hSame :
      OpenCallSameGasBudgetOutcome sourceForwardedGas targetForwardedGas
        sourceStatus targetStatus) :
    targetStatus = OpenCallChildGasStatus.completed ↔
      sourceStatus = OpenCallChildGasStatus.completed := by
  constructor
  · intro hTarget
    rw [hSame.sameStatus]
    exact hTarget
  · intro hSource
    rw [← hSame.sameStatus]
    exact hSource

end OpenCallSameGasBudgetOutcome

structure OpenCallResponseGasAdmissible
    (targetForwardedGas : Nat)
    (targetStatus : OpenCallChildGasStatus)
    (response : OpenExternal.CallResponse) : Prop where
  outOfGasSuccessFalse :
    targetStatus = OpenCallChildGasStatus.outOfGas →
      response.success = false
  outOfGasReturnsNoGas :
    targetStatus = OpenCallChildGasStatus.outOfGas →
      response.returnedGas = EvmYul.UInt256.ofNat 0
  completedReturnedGasBound :
    targetStatus = OpenCallChildGasStatus.completed →
      response.returnedGas.toNat ≤ targetForwardedGas

namespace OpenCallResponseGasAdmissible

theorem returnedGas_toNat_le_forwarded
    {targetForwardedGas : Nat}
    {targetStatus : OpenCallChildGasStatus}
    {response : OpenExternal.CallResponse}
    (hResponse :
      OpenCallResponseGasAdmissible targetForwardedGas targetStatus
        response) :
    response.returnedGas.toNat ≤ targetForwardedGas := by
  cases hStatus : targetStatus with
  | outOfGas =>
      have hZero :
          response.returnedGas = EvmYul.UInt256.ofNat 0 :=
        hResponse.outOfGasReturnsNoGas hStatus
      have hZeroNat : (EvmYul.UInt256.ofNat 0).toNat = 0 :=
        Assembly.Bytecode.uint256_ofNat_toNat_of_lt_size
          (value := 0) (by decide)
      rw [hZero]
      rw [hZeroNat]
      exact Nat.zero_le targetForwardedGas
  | completed =>
      exact hResponse.completedReturnedGasBound hStatus

end OpenCallResponseGasAdmissible

def OpenCallResponseGasAgreementFacts
    (call gasCall : OpenExternal.OpenCall EVMState)
    (response : OpenExternal.CallResponse) : Prop :=
  ∃ sourceForwardedGas : Nat,
  ∃ targetForwardedGas : Nat,
  ∃ sourceStatus : OpenCallChildGasStatus,
  ∃ targetStatus : OpenCallChildGasStatus,
    gasCall.site = call.site ∧
      sourceForwardedGas = call.site.request.requestedGas.toNat ∧
      targetForwardedGas = gasCall.site.request.requestedGas.toNat ∧
      OpenCallSameGasBudgetOutcome sourceForwardedGas
        targetForwardedGas sourceStatus targetStatus ∧
      OpenCallResponseGasAdmissible targetForwardedGas targetStatus response

namespace OpenCallResponseGasAgreementFacts

theorem exists_same_forwardedGas_status
    {call gasCall : OpenExternal.OpenCall EVMState}
    {response : OpenExternal.CallResponse}
    (hFacts :
      OpenCallResponseGasAgreementFacts call gasCall response) :
    ∃ sourceForwardedGas : Nat,
    ∃ targetForwardedGas : Nat,
    ∃ sourceStatus : OpenCallChildGasStatus,
    ∃ targetStatus : OpenCallChildGasStatus,
      sourceForwardedGas = targetForwardedGas ∧
        sourceStatus = targetStatus := by
  rcases hFacts with
    ⟨sourceForwardedGas, targetForwardedGas, sourceStatus, targetStatus,
      _hSite, _hSourceBudget, _hTargetBudget, hSame, _hResponse⟩
  exact
    ⟨sourceForwardedGas, targetForwardedGas, sourceStatus, targetStatus,
      hSame.sameForwardedGas, hSame.sameStatus⟩

theorem target_requestedGas_returnedGas_bound
    {call gasCall : OpenExternal.OpenCall EVMState}
    {response : OpenExternal.CallResponse}
    (hFacts :
      OpenCallResponseGasAgreementFacts call gasCall response) :
    response.returnedGas.toNat ≤
      gasCall.site.request.requestedGas.toNat := by
  rcases hFacts with
    ⟨_sourceForwardedGas, targetForwardedGas, _sourceStatus, targetStatus,
      _hSite, _hSourceBudget, hTargetBudget, _hSame, hResponse⟩
  have hBound :
      response.returnedGas.toNat ≤ targetForwardedGas :=
    OpenCallResponseGasAdmissible.returnedGas_toNat_le_forwarded
      (targetForwardedGas := targetForwardedGas)
      (targetStatus := targetStatus) hResponse
  simpa [hTargetBudget] using hBound

theorem source_requestedGas_returnedGas_bound
    {call gasCall : OpenExternal.OpenCall EVMState}
    {response : OpenExternal.CallResponse}
    (hFacts :
      OpenCallResponseGasAgreementFacts call gasCall response) :
    response.returnedGas.toNat ≤ call.site.request.requestedGas.toNat := by
  rcases hFacts with
    ⟨_sourceForwardedGas, targetForwardedGas, _sourceStatus, targetStatus,
      hSite, _hSourceBudget, hTargetBudget, _hSame, hResponse⟩
  have hBound :
      response.returnedGas.toNat ≤ targetForwardedGas :=
    OpenCallResponseGasAdmissible.returnedGas_toNat_le_forwarded
      (targetForwardedGas := targetForwardedGas)
      (targetStatus := targetStatus) hResponse
  simpa [hSite, hTargetBudget] using hBound

theorem exists_target_forwardedGas_returnedGas_bound
    {call gasCall : OpenExternal.OpenCall EVMState}
    {response : OpenExternal.CallResponse}
    (hFacts :
      OpenCallResponseGasAgreementFacts call gasCall response) :
    ∃ targetForwardedGas : Nat,
      response.returnedGas.toNat ≤ targetForwardedGas := by
  rcases hFacts with
    ⟨_sourceForwardedGas, targetForwardedGas, _sourceStatus, targetStatus,
      _hSite, _hSourceBudget, _hTargetBudget, _hSame, hResponse⟩
  exact
    ⟨targetForwardedGas,
      OpenCallResponseGasAdmissible.returnedGas_toNat_le_forwarded
        hResponse⟩

theorem exists_source_forwardedGas_returnedGas_bound
    {call gasCall : OpenExternal.OpenCall EVMState}
    {response : OpenExternal.CallResponse}
    (hFacts :
      OpenCallResponseGasAgreementFacts call gasCall response) :
    ∃ sourceForwardedGas : Nat,
      response.returnedGas.toNat ≤ sourceForwardedGas := by
  rcases hFacts with
    ⟨sourceForwardedGas, targetForwardedGas, _sourceStatus, targetStatus,
      _hSite, _hSourceBudget, _hTargetBudget, hSame, hResponse⟩
  refine ⟨sourceForwardedGas, ?_⟩
  rw [hSame.sameForwardedGas]
  exact
    OpenCallResponseGasAdmissible.returnedGas_toNat_le_forwarded
      (targetForwardedGas := targetForwardedGas)
      (targetStatus := targetStatus) hResponse

end OpenCallResponseGasAgreementFacts

def OpenCallReentrantMutationEquivalent
    (left right : OpenExternal.ReentrantStateMutation) : Prop :=
  ∀ {τ : EvmYul.OperationType} (state : EvmYul.State τ),
    left.apply state = right.apply state

def OpenCallResponseCommittedEffectsEquivalent
    (left right : OpenExternal.CallResponse) : Prop :=
  left.returnData = right.returnData ∧
    OpenCallReentrantMutationEquivalent left.internalMutation
      right.internalMutation

/--
Committed-observation safety for two possible external CALL responses to the
same request.

Returned gas is intentionally absent: it can affect whether the caller has
enough gas to continue, but it is not itself a committed observation.  A CALL
response that returns to the caller is caller-visible even when
`response.success = false`: the status word and copied return data can affect
the continuation.  Thus ordinary continuing responses must agree on success,
return data, and the opaque reentrant state mutation.  Asymmetric child-OOG is
handled only by the low-gas whole-run tracker: a non-equivalent CALL response
may be tolerated only when the enclosing candidate run safely tracks the fixed
reference observation.
-/
def OpenCallResponsesCommittedSafeEquivalent
    (left right : OpenExternal.CallResponse) : Prop :=
  left.success = right.success ∧
    OpenCallResponseCommittedEffectsEquivalent left right

namespace OpenCallResponsesCommittedSafeEquivalent

theorem refl (response : OpenExternal.CallResponse) :
    OpenCallResponsesCommittedSafeEquivalent response response := by
  exact ⟨rfl, rfl, fun _state => rfl⟩

theorem success_eq
    {left right : OpenExternal.CallResponse}
    (hSafe : OpenCallResponsesCommittedSafeEquivalent left right) :
    left.success = right.success :=
  hSafe.1

theorem symm
    {left right : OpenExternal.CallResponse}
    (hSafe : OpenCallResponsesCommittedSafeEquivalent left right) :
    OpenCallResponsesCommittedSafeEquivalent right left := by
  exact
    ⟨hSafe.1.symm, hSafe.2.1.symm,
      fun state => (hSafe.2.2 state).symm⟩

theorem committedEffects
    {left right : OpenExternal.CallResponse}
    (hSafe : OpenCallResponsesCommittedSafeEquivalent left right) :
    OpenCallResponseCommittedEffectsEquivalent left right :=
  hSafe.2

theorem committedEffects_of_success
    {left right : OpenExternal.CallResponse}
    (hSafe : OpenCallResponsesCommittedSafeEquivalent left right)
    (_hLeft : left.success = true)
    (_hRight : right.success = true) :
    OpenCallResponseCommittedEffectsEquivalent left right := by
  exact hSafe.committedEffects

theorem returnData_eq
    {left right : OpenExternal.CallResponse}
    (hSafe : OpenCallResponsesCommittedSafeEquivalent left right) :
    left.returnData = right.returnData :=
  hSafe.2.1

theorem internalMutation_apply_eq
    {left right : OpenExternal.CallResponse}
    (hSafe : OpenCallResponsesCommittedSafeEquivalent left right)
    {τ : EvmYul.OperationType} (state : EvmYul.State τ) :
    left.internalMutation.apply state = right.internalMutation.apply state :=
  hSafe.2.2 state

theorem statusWord_eq
    {left right : OpenExternal.CallResponse}
    (hSafe : OpenCallResponsesCommittedSafeEquivalent left right) :
    left.statusWord = right.statusWord := by
  unfold OpenExternal.CallResponse.statusWord
  rw [hSafe.success_eq]

theorem finishShared_eq
    (site : OpenExternal.CallSite)
    {τ : EvmYul.OperationType}
    (shared : EvmYul.SharedState τ)
    {left right : OpenExternal.CallResponse}
    (hSafe : OpenCallResponsesCommittedSafeEquivalent left right) :
    site.finishShared shared left = site.finishShared shared right := by
  unfold OpenExternal.CallSite.finishShared
  rw [hSafe.returnData_eq]
  rw [hSafe.internalMutation_apply_eq shared.toState]

theorem evmOpenCall_resume_eq
    {state : EvmYul.EVM.State}
    {kind : OpenExternal.CallKind}
    {call : OpenExternal.OpenCall EvmYul.EVM.State}

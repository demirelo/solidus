theorem compileCheckedCALLRegularOpen_sourceOpenDispatcherBlockResult_compiledOpen
    {cfg : Reference.StateRelConfig}
    {outcomeRel : Reference.OutcomeRel}
    {program : Program} {functionProgram : Functions.Program}
    {asm : Assembly.Program} {target : Assembly.TargetProgram}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {sourceFuel : Nat} {initial : EVMState}
    {referenceResult : Reference.Result}
    {trace : OpenExternal.OpenTrace}
    {sourceResult : Except Reference.Exception Reference.State}
    (hTop :
      RecursiveBridgeCALLTopAssumptions cfg
        (RecursiveBridgeTerminalObservationContracts.canonicalTerminalRel cfg)
        (RecursiveBridgeTerminalObservationContracts.canonicalRevertRel cfg)
        Locals.Source.PrimitiveSemantics.structured outcomeRel program asm
        target shared store sourceFuel initial referenceResult)
    (hChecked :
      compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpen?
          program =
        some (functionProgram, asm, target))
    (hBodyFuelAdequate :
      EvmCompiler.Yul.Reference.SourceBridgeFacts.SourceOpenInternalUserCallBodyFuelAdequateUpTo
        cfg program.contract sourceFuel)
    (hResolveDispatcher :
      OpenExternal.OpenResultResolves
        (OpenExternal.YulOpenResult.toOpenResult
          (OpenExternal.YulOpen.exec sourceFuel.succ
            (.Block [program.contract.dispatcher]) (some program.contract)
            (.Ok
              { shared with
                executionEnv :=
                  { shared.executionEnv with code := program.contract } }
              (default : EvmYul.Yul.VarStore))))
        trace sourceResult)
    (hRelatable :
      EvmCompiler.Yul.Reference.SourceBridgeFacts.SourceResultRelatable
        sourceResult)
    (hSupported :
      EvmCompiler.Yul.Reference.SourceBridgeFacts.SourceResultOutcomeLayoutSupported
        Functions.Source.Ctx.initial [] [] sourceResult)
    (hResponses :
      EvmCompiler.Yul.Reference.SourceBridgeFacts.SourceOpenTraceResponsesAdmissible
        cfg trace)
    (minimumCompilerFuel : Nat) :
    ∃ compilerFuel : Nat,
    ∃ sourceOutcome : Objects.Source.Outcome,
    ∃ ctxAfter : Functions.Source.Ctx,
    ∃ programOutcome : Functions.Source.Outcome,
    ∃ targetFuel : Nat,
    ∃ targetResult : Assembly.StepResult,
      program.toObjects? =
        some { root := Objects.Object.mk "root" functionProgram [] [] } ∧
      minimumCompilerFuel ≤ compilerFuel ∧
      OpenExternal.OpenResultResolves
        (EvmCompiler.Yul.Reference.SourceBridgeFacts.CompilerOpen.FunctionsOpen.Block.runOpen
          Locals.Source.PrimitiveSemantics.structured functionProgram
          Functions.Source.Ctx.initial compilerFuel functionProgram.body
          (Functions.Source.Program.initialState initial.toSharedState))
        trace (.ok (sourceOutcome, ctxAfter)) ∧
      EvmCompiler.Yul.Reference.SourceBridgeFacts.SourceResultOutcomeRel cfg []
        (RecursiveBridgeTerminalObservationContracts.canonicalTerminalRel cfg)
        (RecursiveBridgeTerminalObservationContracts.canonicalRevertRel cfg)
        sourceResult sourceOutcome ∧
      OpenExternal.OpenResultResolves
        (EvmCompiler.Yul.Reference.SourceBridgeFacts.CompilerOpen.FunctionsOpen.Program.runState
          Locals.Source.PrimitiveSemantics.structured compilerFuel
          functionProgram
          (Functions.Source.Program.initialState initial.toSharedState))
        trace (.ok programOutcome) ∧
      OpenExternal.OpenResultResolves
        (OpenAssembly.Compiled.openRunNResult asm targetFuel
          initial)
        trace (.ok targetResult) ∧
      Functions.Source.WholeProgramOutcomeRel programOutcome targetResult := by
  rcases
      hTop.sourceOpenDispatcherBlockResult_canonical
        hBodyFuelAdequate hResolveDispatcher hRelatable hSupported
        hResponses minimumCompilerFuel with
    ⟨functionProgram', compilerFuel, sourceOutcome, ctxAfter, hToObjects,
      hMin, hBlock, hSourceOutcome⟩
  rcases
      compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpen?_eq_some
        hChecked with
    ⟨lowerObj, hLower, hFunctionProgram, _hSupportedCheck, _hCALLChecked⟩
  have hLowerObjEq :
      lowerObj =
        { root := Objects.Object.mk "root" functionProgram' [] [] } := by
    rw [hLower] at hToObjects
    cases hToObjects
    rfl

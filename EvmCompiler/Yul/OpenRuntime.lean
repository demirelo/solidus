      OpenAssembly.OpenBlockTraceResult asm target targetFuel initial trace
        (.running finalState) →
      finalState.pc.toNat =
          Assembly.Bytecode.codeByteLength target.code ∧
        finalState.stack.length ≤ 1024 ∧
          Assembly.GasAware.XStepTrace.ReturnBuffersClean finalState)
    (hRunningReady :

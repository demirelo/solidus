  rcases hCase with hNoCall | hCall
  · exact OpenXCurrentRunningInstrResponseAdmissibleCase.no_call hNoCall
  · rcases hCall with
      ⟨op, kind, call, hInstr, hKind, hCall, hStepChecks, hBridgeRel,
        hPostBudget⟩
    rcases hBridgeRel with ⟨sourceShared, hSharedRel⟩
    cases hInstr
    exact
      OpenXCurrentRunningInstrResponseAdmissibleCase.call_of_shared_state_rel
        hKind hCall hStepChecks hSharedRel hPostBudget

  private theorem to_trace_ready_case

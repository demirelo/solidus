          (pc := pc) (instr := instr) (emitted := emitted)
          (before := before) (after := after)
          hEncoding hSafety hCode hAt hEmit hTargetBlock hRun hChecks
          hBudgetReady
      have hCodeStable :
          midState.executionEnv.code = currentState.executionEnv.code := by
        rcases hBudgetReady with hNoCall | hCall
        · exact
            OpenGasAware.OpenXBlockTraceRelReady.openRunListResult_current_emitted_running_preserves_code_of_trace_ready_case
              (program := program) (targetProgram := targetProgram)
              (initial := currentState) (mid := midState)
              (trace := headTrace) (pc := pc) (instr := instr)
              (emitted := emitted) (before := before) (after := after)
              hEmit hTargetBlock hRun (Or.inl hNoCall)

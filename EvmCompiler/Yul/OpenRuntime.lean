/--
Positive branch-split form of the result-tracking CALL response carrier.

For every paired reference/candidate response at an emitted CALL site, either
the caller-visible response is strictly equivalent, or the candidate is the
single exceptional case: all available gas was forwarded, the child ran out of
gas, and the candidate whole-run outcome safely tracks the fixed reference
result. This is equivalent to
`OpenXCurrentRunningInstrCallResponseResultTrackingTraceReadyCase`, but avoids a
negative premise in downstream low-gas inductions.
-/
def OpenXCurrentRunningInstrCallResponseStrictOrAllGasOOGResultTrackingTraceReadyCase
    (_targetProgram : Assembly.TargetProgram)
    (state : EVMState) (instr : Assembly.Instr)
    (referenceTrace candidateTrace : OpenExternal.OpenTrace)
    (candidateOutcome :
      Except EVMException (EvmYul.EVM.ExecutionResult EVMState))
    (referenceResult : EvmYul.EVM.ExecutionResult EVMState) : Prop :=
  ∃ op : Assembly.PrimOp,
    ∃ kind : OpenExternal.CallKind,
      ∃ call : OpenExternal.OpenCall EVMState,
        instr = .prim op ∧
          OpenExternal.CallKind.ofEVMOperation? op.toEVM = some kind ∧
            OpenExternal.CallKind.evmOpenCall? state kind = some call ∧
              (∀ {referenceResponse candidateResponse :
                    OpenExternal.CallResponse}
                  {candidateForwardedGas candidateAvailableGas
                    candidatePostCallGas : Nat}
                  {candidateStatus : OpenCallChildGasStatus},
                OpenExternal.OpenEvent.call call.site referenceResponse ∈
                    referenceTrace →
                  OpenExternal.OpenEvent.call call.site candidateResponse ∈
                      candidateTrace →
                    OpenCallResponsesCommittedSafeEquivalent
                        referenceResponse candidateResponse ∨
                      OpenCallAllForwardedGasOutOfGas
                          candidateForwardedGas candidateAvailableGas
                          candidatePostCallGas candidateStatus
                          candidateResponse ∧
                        Assembly.GasAware.XRunOutcomeSafelyTracks
                          candidateOutcome (.ok referenceResult))


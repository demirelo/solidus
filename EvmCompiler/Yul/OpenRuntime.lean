  have hInv :=
    Reference.SourceBridgeFacts.openResultDoneInvariant_sourceResultCheckpointAllowed_stateStoreContains_of_checkpointStoreContains
      (Reference.SourceBridgeFacts.yulOpenExec_ok_toOpenResult_doneInvariant_checkpointStoreContains_of_callSafe_scoped

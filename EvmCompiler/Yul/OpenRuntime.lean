/-!
Checked imported-Yul entry points for the open external-call compiler route.

This file intentionally sits above both the recursive bridge/no-call runtime
stack and `Yul.OpenLowering`: it is the first place where an imported Yul
checked compile can also ask the lowered Functions program for the regular
open-CALL support check consumed by the Functions-level open theorem.
-/

namespace EvmCompiler
namespace Yul
namespace Program

theorem RecursiveBridgeInitialCodeImageRel.targetPerm_of_sourcePerm
    {cfg : Reference.StateRelConfig}
    {program : Program}
    {target : Assembly.TargetProgram}
    {shared : EvmYul.SharedState .Yul}
    {initial : EVMState}
    (hInitialCodeImageRel :
      RecursiveBridgeInitialCodeImageRel cfg program target shared initial)
    (hSourcePerm : shared.executionEnv.perm = true) :
    initial.executionEnv.perm = true := by
  have hPerm := hInitialCodeImageRel.world.chain.executionEnv.perm
  symm
  simpa [RecursiveBridgeInitialWorldRel, hSourcePerm] using hPerm

theorem RecursiveBridgeInitialCodeImageRel.to_canonicalEntryState
    {cfg : Reference.StateRelConfig}
    {program : Program}
    {target : Assembly.TargetProgram}
    {shared : EvmYul.SharedState .Yul}
    {initial : EVMState}
    (hInitialCodeImageRel :
      RecursiveBridgeInitialCodeImageRel cfg program target shared initial) :
    RecursiveBridgeInitialCodeImageRel cfg program target shared
      (canonicalEntryState initial) where
  world :=
    RecursiveBridgeInitialWorldRel.to_canonicalEntryState
      hInitialCodeImageRel.world
  targetCode := by
    simpa [canonicalEntryState] using hInitialCodeImageRel.targetCode
  returnBuffersClean :=
    hInitialCodeImageRel.canonicalReturnBuffersClean

theorem RecursiveBridgeTargetRuntime.of_canonicalEntryState_runtime
    {asm : Assembly.Program}
    {target : Assembly.TargetProgram}
    {initial : EVMState}
    (hRuntime :
      Assembly.RuntimeAssumptions asm target (canonicalEntryState initial)) :
    RecursiveBridgeTargetRuntime asm target (canonicalEntryState initial) where
  runtime := hRuntime
  initialPc := canonicalEntryState_pc initial
  initialStack := canonicalEntryState_stack initial

/--
Semantic/runtime boundaries that are not generated bytecode facts.

The checked compiler route below derives `decodeWindow` and `jumpdestCorrect`
from its bytecode checker.  This package keeps only the remaining gas and
projection boundaries; CALL/CREATE request/response agreement is supplied by
the open-boundary readiness premises on the endpoint theorems.
-/
structure RecursiveBridgeTargetRuntimeSemanticBoundaries
    (asm : Assembly.Program) (target : Assembly.TargetProgram)
    (initial : EVMState) : Prop where
    outOfGasPolicy : Assembly.OutOfGasPolicyAssumption asm initial
    currentContractProjection :
      Assembly.CurrentContractProjectionAssumption asm initial

namespace RecursiveBridgeTargetRuntimeSemanticBoundaries

def trivial
    {asm : Assembly.Program} {target : Assembly.TargetProgram}
    {initial : EVMState} :
      RecursiveBridgeTargetRuntimeSemanticBoundaries asm target initial where
  outOfGasPolicy := Assembly.OutOfGasPolicyAssumption.trivial
  currentContractProjection :=
    Assembly.CurrentContractProjectionAssumption.trivial

def to_runtimeAssumptions
    {asm : Assembly.Program} {target : Assembly.TargetProgram}
    {initial : EVMState}
    (hBoundaries :
      RecursiveBridgeTargetRuntimeSemanticBoundaries asm target initial)
    (hDecodeWindow : Assembly.Bytecode.TargetFitsDecodeWindow target)
    (hJumpdestCorrect : Assembly.Bytecode.JumpdestCorrect target) :
      Assembly.RuntimeAssumptions asm target initial :=
  Assembly.RuntimeAssumptions.withExplicitBoundaries hDecodeWindow
    hJumpdestCorrect hBoundaries.outOfGasPolicy
    hBoundaries.currentContractProjection

end RecursiveBridgeTargetRuntimeSemanticBoundaries

noncomputable def compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpen?
    (program : Program) :
    Option (Functions.Program × Assembly.Program × Assembly.TargetProgram) := do
  let lowerObj ← program.toObjects?
  if OpenLowering.FunctionsProgramRegularOpenSupported?
      lowerObj.toFunctions then
    let (asm, target) ←
      compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStatic?
        program
    some (lowerObj.toFunctions, asm, target)
  else
    none

noncomputable def compileCheckedAssemblyTargetBytecodeResourcesCALLFamilyFeaturesSourceStaticRegularOpen?
    (program : Program) :
    Option (Functions.Program × Assembly.Program × Assembly.TargetProgram) := do
  let lowerObj ← program.toObjects?
  if OpenLowering.FunctionsProgramRegularOpenSupported?
      lowerObj.toFunctions then
    let (asm, target) ←
      compileCheckedAssemblyTargetBytecodeResourcesCALLFamilyFeaturesSourceStatic?
        program
    some (lowerObj.toFunctions, asm, target)
  else
    none

theorem compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpen?_eq_some
    {program : Program} {functionProgram : Functions.Program}
    {asm : Assembly.Program} {target : Assembly.TargetProgram}
    (hChecked :
      compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpen?
          program =
        some (functionProgram, asm, target)) :
    ∃ lowerObj : Objects.Program,
      program.toObjects? = some lowerObj ∧
        functionProgram = lowerObj.toFunctions ∧
          OpenLowering.FunctionsProgramRegularOpenSupported?
              functionProgram =
            true ∧
            compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStatic?
                program =
              some (asm, target) := by
  unfold
    compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpen?
      at hChecked
  cases hLower : program.toObjects? with
  | none =>
      simp [hLower] at hChecked
  | some lowerObj =>
      simp [hLower] at hChecked
      cases hSupported :
          OpenLowering.FunctionsProgramRegularOpenSupported?
            lowerObj.toFunctions with
      | false =>
          simp [hSupported] at hChecked
      | true =>
          simp [hSupported] at hChecked
          cases hCompile :
              compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStatic?
                  program with
          | none =>
              simp [hCompile] at hChecked
          | some pair =>
              rcases pair with ⟨asm', target'⟩
              simp [hCompile] at hChecked
              rcases hChecked with ⟨rfl, rfl, rfl⟩
              exact
                ⟨lowerObj, rfl, rfl, by simpa using hSupported, rfl⟩


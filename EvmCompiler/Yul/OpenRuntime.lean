/--
Source-facing acceptance package for one open dispatcher trace.

The `resultRelatable` field is deliberately part of trace acceptance: it rules
out selected source-open traces that finish in imported out-of-fuel or
front-end/resource errors, which the compiler source tower does not model as
ordinary outcomes. This is a fuel/result-fragment condition on the source trace,
not compiler-generated evidence.
-/
structure SourceOpenDispatcherTraceAccepted
    (cfg : Reference.StateRelConfig)
    (program : Program)
    (shared : EvmYul.SharedState .Yul)
    (sourceFuel : Nat)
    (trace : OpenExternal.OpenTrace)
    (sourceResult : Except Reference.Exception Reference.State) : Prop where
  resolves :
    OpenExternal.OpenResultResolves
      (OpenExternal.YulOpenResult.toOpenResult
        (OpenExternal.YulOpen.exec sourceFuel.succ
          (.Block [program.contract.dispatcher]) (some program.contract)
          (.Ok
            { shared with
              executionEnv :=
                { shared.executionEnv with code := program.contract } }
            (default : EvmYul.Yul.VarStore))))
      trace sourceResult
  bodyFuelAdequate :
    EvmCompiler.Yul.Reference.SourceBridgeFacts.SourceOpenInternalUserCallBodyFuelAdequateUpTo
      cfg program.contract sourceFuel
  resultRelatable :
    Reference.SourceBridgeFacts.SourceResultRelatable sourceResult
  sourcePerm :
    shared.executionEnv.perm = true
  externalResponses :
    Reference.SourceBridgeFacts.SourceOpenTraceExternalResponsesAdmissible
      cfg trace

namespace SourceOpenDispatcherTraceAccepted

theorem responses
    {cfg : Reference.StateRelConfig}
    {program : Program}
    {shared : EvmYul.SharedState .Yul}
    {sourceFuel : Nat}
    {trace : OpenExternal.OpenTrace}

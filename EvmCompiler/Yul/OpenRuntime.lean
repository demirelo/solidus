  exprNoSuccessfulOutOfFuel :
    RecursiveBridgeExprNoOutOfFuelContracts cfg program
  initialCodeImageRel :
    RecursiveBridgeInitialCodeImageRel cfg program target shared initial
  sourceFuelRun :
    ∃ sourceFuel,
      RecursiveBridgeSourceRun program shared store sourceFuel referenceResult
  checked :
    compileCheckedCALLRegularOpenStackSafeOrCallAwareSpillPlannedPrealloc?
        maxWords program =
      some (branch, range, asm, target)
  initialMemory :
    Locals.SourceLowering.StateRel.SpillScratch.ScratchInitialMemoryEmpty
      (canonicalEntryState initial).toMachineState
  initialPerm : initial.executionEnv.perm = true
  trueSemantics :
    branch = true →
      RecursiveBridgeCALLSemanticContracts cfg
        (RecursiveBridgeTerminalObservationContracts.canonicalTerminalRel cfg)
        (RecursiveBridgeTerminalObservationContracts.canonicalRevertRel cfg)
        Locals.Source.PrimitiveSemantics.structured outcomeRel program shared
        store
  trueTargetRuntime :
    branch = true → RecursiveBridgeTargetRuntime asm target initial
  trueSourceOpen :
    branch = true →
      ∃ sourceFuel,
        RecursiveBridgeSourceRun program shared store sourceFuel
          referenceResult ∧
        SourceOpenDispatcherTraceAccepted cfg program shared sourceFuel trace
          sourceResult

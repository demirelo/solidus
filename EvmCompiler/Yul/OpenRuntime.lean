theorem to_trace_ready_case
    {cfg : Reference.StateRelConfig}
    {targetProgram : Assembly.TargetProgram}
    {state : EVMState} {instr : Assembly.Instr}
    {trace : OpenExternal.OpenTrace}
    (hResponses :
      Reference.SourceBridgeFacts.SourceOpenTraceResponsesAdmissible cfg
        trace)
    (hReady :
      OpenXCurrentRunningInstrResponseAdmissibleCase cfg targetProgram
        state instr) :
    OpenGasAware.OpenXBlockTraceRelReady.CurrentRunningInstrTraceReadyCase
      targetProgram state instr trace := by
  rcases hReady with hNoCall | hCall
  · exact Or.inl hNoCall
  · rcases hCall with
      ⟨op, kind, call, sourceShared, hInstr, hKind, hCall, hStepChecks,
        hShared, hPostBudget⟩
    exact
      Or.inr
        ⟨op, kind, call, hInstr, hKind, hCall, hStepChecks,
          (fun {response} hMem =>
            Reference.SourceBridgeFacts.RelationallyAdmissibleOpenResponse.evmOpenCall_resume_code_stable
              (hResponses (OpenExternal.OpenEvent.call call.site response) hMem)
              hShared hCall),
          hPostBudget⟩

end OpenXCurrentRunningInstrResponseAdmissibleCase

def OpenXCurrentRunningInstrGasReadyCase
    (targetProgram : Assembly.TargetProgram)
    (state : EVMState) (instr : Assembly.Instr) : Prop :=
  Assembly.Instr.usesCallCreate instr = false ∨
    ∃ op : Assembly.PrimOp,
      ∃ kind : OpenExternal.CallKind,
        ∃ call : OpenExternal.OpenCall EVMState,
          instr = .prim op ∧
            OpenExternal.CallKind.ofEVMOperation? op.toEVM = some kind ∧
              OpenExternal.CallKind.evmOpenCall? state kind = some call ∧
                (∀ {gasBound : Nat} {full : EVMState},
                  gasBound ≤ full.gasAvailable.toNat →
                    Assembly.GasAware.GasExecRel full state →
                      Assembly.GasAware.XStepChecksPass
                        (Assembly.GasAware.validJumps targetProgram)
                        full op.toEVM) ∧
                  (∀ {response : OpenExternal.CallResponse}
                      {tailGasBound : Nat},
                    ∃ gasBound : Nat,
                      ∀ {full gasPost : EVMState},
                        gasBound ≤ full.gasAvailable.toNat →
                          Assembly.GasAware.GasExecRel full state →
                            Assembly.GasAware.GasExecRel gasPost
                              (EvmYul.EVM.State.incrPC
                                (call.resume response)) →
                              tailGasBound ≤
                                gasPost.gasAvailable.toNat)

namespace OpenXCurrentRunningInstrGasReadyCase

theorem of_ready_case
    {targetProgram : Assembly.TargetProgram}
    {state : EVMState} {instr : Assembly.Instr}
    (hReady :
      OpenGasAware.OpenXBlockTraceRelReady.CurrentRunningInstrReadyCase
        targetProgram state instr) :
    OpenXCurrentRunningInstrGasReadyCase targetProgram state instr := by
  rcases hReady with hNoCall | hCall
  · exact Or.inl hNoCall
  · rcases hCall with
      ⟨op, kind, call, hInstr, hKind, hCall, hStepChecks,
        _hCodeStable, hPostBudget⟩
    exact
      Or.inr
        ⟨op, kind, call, hInstr, hKind, hCall, hStepChecks, hPostBudget⟩

end OpenXCurrentRunningInstrGasReadyCase

def OpenXCurrentRunningInstrCallGasBudgetReadyCase
    (targetProgram : Assembly.TargetProgram)
    (state : EVMState) (instr : Assembly.Instr) : Prop :=
  ∃ op : Assembly.PrimOp,
    ∃ kind : OpenExternal.CallKind,
      ∃ call : OpenExternal.OpenCall EVMState,
        instr = .prim op ∧
          OpenExternal.CallKind.ofEVMOperation? op.toEVM = some kind ∧
            OpenExternal.CallKind.evmOpenCall? state kind = some call ∧
              (∀ {response : OpenExternal.CallResponse}
                  {tailGasBound : Nat},
                ∃ gasBound : Nat,
                  (∀ {full : EVMState},
                    gasBound ≤ full.gasAvailable.toNat →
                      Assembly.GasAware.GasExecRel full state →
                        Assembly.GasAware.XStepChecksPass
                          (Assembly.GasAware.validJumps targetProgram)
                          full op.toEVM) ∧
                  (∀ {full : EVMState}
                      {gasCall : OpenExternal.OpenCall EVMState},
                    gasBound ≤ full.gasAvailable.toNat →
                      Assembly.GasAware.GasExecRel full state →
                        OpenExternal.CallKind.evmOpenCall?
                            (OpenGasAware.gasChargedState full op.toEVM)
                            kind = some gasCall →
                      tailGasBound ≤
                        (EvmYul.EVM.State.incrPC
                          (OpenGasAware.finishGasAwareCall gasCall
                            response)).gasAvailable.toNat))

structure OpenCallActualPostGasBudgetFacts
    (gasCall : OpenExternal.OpenCall EVMState)
    (response : OpenExternal.CallResponse)
    (tailGasBound : Nat) : Prop where
  noOverflow :
    (gasCall.resume response).gasAvailable.toNat +
        response.returnedGas.toNat < EvmYul.UInt256.size
  tailBudget :
    tailGasBound ≤
      (gasCall.resume response).gasAvailable.toNat +
        response.returnedGas.toNat

namespace OpenCallActualPostGasBudgetFacts

theorem tail_actual_post
    {gasCall : OpenExternal.OpenCall EVMState}
    {response : OpenExternal.CallResponse}
    {tailGasBound : Nat}

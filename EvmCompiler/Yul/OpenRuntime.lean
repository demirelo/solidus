          cases targetKind <;>
            simp [SourceOpenTargetCommittedEffectsRel,
              SourceOpenCommittedState?, TargetCommittedState?,
              Assembly.GasAware.XTargetCommittedObservation] at hTargetKind ⊢
          exact hInitialEffects


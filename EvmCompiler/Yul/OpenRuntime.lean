    (hSafe.evmOpenCall_finishGasAwareCall_gasExecRel hCall)

theorem openX_current_gasless_call_continue_outcome_safelyTracks_of_step_checks_actual_post_gasrel_reference_tail
    {fuel : Nat} {validJumps : Array EvmYul.UInt256}
    {full target : EvmYul.EVM.State}
    {op : EvmYul.Operation .EVM} {arg : Option (EvmYul.UInt256 × Nat)}
    {kind : OpenExternal.CallKind}
    {call : OpenExternal.OpenCall EvmYul.EVM.State}
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {tailTrace : OpenExternal.OpenTrace}
    {outcome :
      Except OpenGasAware.EVMException OpenGasAware.EVMResult}
    {reference : OpenGasAware.EVMResult}
    (hRel : Assembly.GasAware.GasExecRel full target)
    (hDecode :
      EvmYul.EVM.decode full.executionEnv.code full.pc = some (op, arg))
    (hStepChecks :
      Assembly.GasAware.XStepChecksPass validJumps full op)
    (hKind : OpenExternal.CallKind.ofEVMOperation? op = some kind)
    (hCall :
      OpenExternal.CallKind.evmOpenCall? target kind = some call)
    (hSafe :
      OpenCallResponsesCommittedSafeEquivalent referenceResponse
        candidateResponse)
    (hTail :
      OpenGasAware.OpenXGasRelStateAllOutcomeTracesSafelyTrackResult
        validJumps fuel
        (EvmYul.EVM.State.incrPC (call.resume referenceResponse))
        reference)
    (hTrace :
      OpenGasAware.OpenXOutcomeTraceResult validJumps (fuel + 1) full
        (OpenExternal.OpenEvent.call call.site candidateResponse :: tailTrace)
        outcome) :
    Assembly.GasAware.XRunOutcomeSafelyTracks outcome (.ok reference) := by
  have hResume :
      call.resume referenceResponse = call.resume candidateResponse :=
    hSafe.evmOpenCall_resume_eq hCall
  have hTailCandidate :
      OpenGasAware.OpenXGasRelStateAllOutcomeTracesSafelyTrackResult
        validJumps fuel
        (EvmYul.EVM.State.incrPC (call.resume candidateResponse))
        reference := by
    simpa [hResume] using hTail
  exact
    OpenGasAware.openX_current_gasless_call_continue_outcome_safelyTracks_of_step_checks_actual_post_gasrel_tail
      (fuel := fuel) (validJumps := validJumps) (full := full)
      (target := target) (op := op) (arg := arg) (kind := kind)
      (call := call) (response := candidateResponse)
      (tailTrace := tailTrace) (outcome := outcome)
      (reference := reference)
      hRel hDecode hStepChecks hKind hCall hTailCandidate hTrace

end OpenCallResponsesCommittedSafeEquivalent

/--
The one response-level escape hatch needed by the low-gas tracking proof.

The open CALL request records the requested/forwarded gas budget abstractly, so
the gas-aware induction must supply the candidate child forwarded budget and
the candidate post-CALL parent budget.  This certificate is intentionally not a
committed-response equivalence: the failed status word is still caller-visible.
It is only the exceptional child-gas case that a later whole-run safety proof may
turn into candidate failure/revert or the same final committed observation.
-/
structure OpenCallAllForwardedGasOutOfGas
    (candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat)
    (candidateStatus : OpenCallChildGasStatus)
    (candidateResponse : OpenExternal.CallResponse) : Prop where
  allGasForwarded : candidateForwardedGas = candidateAvailableGas
  postCallGasZero : candidatePostCallGas = 0
  childOutOfGas : candidateStatus = OpenCallChildGasStatus.outOfGas
  responseGasAdmissible :
    OpenCallResponseGasAdmissible candidateForwardedGas candidateStatus
      candidateResponse

namespace OpenCallAllForwardedGasOutOfGas

theorem success_false
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    {candidateResponse : OpenExternal.CallResponse}
    (hOOG :
      OpenCallAllForwardedGasOutOfGas candidateForwardedGas
        candidateAvailableGas candidatePostCallGas candidateStatus
        candidateResponse) :
    candidateResponse.success = false :=
  hOOG.responseGasAdmissible.outOfGasSuccessFalse hOOG.childOutOfGas

theorem returnedGas_zero
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    {candidateResponse : OpenExternal.CallResponse}
    (hOOG :
      OpenCallAllForwardedGasOutOfGas candidateForwardedGas
        candidateAvailableGas candidatePostCallGas candidateStatus
        candidateResponse) :
    candidateResponse.returnedGas = EvmYul.UInt256.ofNat 0 :=
  hOOG.responseGasAdmissible.outOfGasReturnsNoGas hOOG.childOutOfGas

theorem postCallGas_zero
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    {candidateResponse : OpenExternal.CallResponse}
    (hOOG :
      OpenCallAllForwardedGasOutOfGas candidateForwardedGas
        candidateAvailableGas candidatePostCallGas candidateStatus
        candidateResponse) :
    candidatePostCallGas = 0 :=
  hOOG.postCallGasZero

end OpenCallAllForwardedGasOutOfGas

namespace OpenCallResponsesCommittedSafeEquivalent


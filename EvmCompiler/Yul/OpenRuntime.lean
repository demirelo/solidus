/--
Public contract-level gas conclusion for the open CALL-family route.

The first field is the high-gas liveness replay.  The second records that this
bound gives an actual feasible replay whenever it fits in UInt256 gas.  The
third is the low-gas safety theorem: every UInt256 gas budget either reaches the
same committed observation as the high-gas run or fails/reverts in the final
observation model.
-/
structure OpenXContractLivenessAndSafetyFinalObservation
    (target : Assembly.TargetProgram) (initial : EVMState)
    (trace : OpenExternal.OpenTrace) (targetResult : Assembly.StepResult)
    (evmFuel gasBound : Nat) : Prop where
  replayAbove :
    OpenGasAware.OpenXReplayAbove target initial trace targetResult evmFuel
      gasBound
  replaySomeGas :
    gasBound < EvmYul.UInt256.size →
      OpenGasAware.OpenXReplaySomeGas target initial trace targetResult
        evmFuel
  committedSafeForAllGas :
    OpenGasAware.OpenXCommittedSafeForAllGas target initial targetResult
      evmFuel

theorem openXLivenessAndSafetyFinalObservation
    {cfg : Reference.StateRelConfig}
    {outcomeRel : Reference.OutcomeRel}
    {program : Program} {functionProgram : Functions.Program}
    {asm : Assembly.Program} {target : Assembly.TargetProgram}
    {shared : EvmYul.SharedState .Yul}
    {store : EvmYul.Yul.VarStore}
    {sourceFuel : Nat} {initial : EVMState}
    {referenceResult : Reference.Result}
    {trace : OpenExternal.OpenTrace}
    {sourceResult : Except Reference.Exception Reference.State}
    (assumptions :
      RecursiveBridgeCALLFamilyRegularOpenAssemblyInferredBoundStackSafeNoReturnDataCopyGlobalResponseGasReadyRoute2Assumptions
        cfg outcomeRel program functionProgram asm target shared store
        sourceFuel initial referenceResult trace sourceResult)
    (minimumCompilerFuel : Nat) :
    ∃ compilerFuel : Nat,
    ∃ sourceOutcome : Objects.Source.Outcome,
    ∃ ctxAfter : Functions.Source.Ctx,
    ∃ programOutcome : Functions.Source.Outcome,
    ∃ targetFuel : Nat,
    ∃ targetResult : Assembly.StepResult,
    ∃ evmFuel : Nat,
    ∃ gasBound : Nat,
      program.toObjects? =
        some { root := Objects.Object.mk "root" functionProgram [] [] } ∧
      minimumCompilerFuel ≤ compilerFuel ∧
      OpenExternal.OpenResultResolves
        (EvmCompiler.Yul.Reference.SourceBridgeFacts.CompilerOpen.FunctionsOpen.Block.runOpen
          Locals.Source.PrimitiveSemantics.structured functionProgram
          Functions.Source.Ctx.initial compilerFuel functionProgram.body
          (Functions.Source.Program.initialState initial.toSharedState))
        trace (.ok (sourceOutcome, ctxAfter)) ∧
      EvmCompiler.Yul.Reference.SourceBridgeFacts.SourceResultOutcomeRel cfg []
        (RecursiveBridgeTerminalObservationContracts.canonicalTerminalRel cfg)
        (RecursiveBridgeTerminalObservationContracts.canonicalRevertRel cfg)
        sourceResult sourceOutcome ∧
      OpenExternal.OpenResultResolves
        (EvmCompiler.Yul.Reference.SourceBridgeFacts.CompilerOpen.FunctionsOpen.Program.runState
          Locals.Source.PrimitiveSemantics.structured compilerFuel
          functionProgram
          (Functions.Source.Program.initialState initial.toSharedState))
        trace (.ok programOutcome) ∧
      OpenAssembly.OpenBlockTraceResult asm target targetFuel initial trace
        targetResult ∧
      OpenGasAware.OpenXReplayAbove target initial trace targetResult evmFuel
        gasBound ∧
      (gasBound < EvmYul.UInt256.size →
        OpenGasAware.OpenXReplaySomeGas target initial trace targetResult
          evmFuel) ∧
      OpenGasAware.OpenXCommittedSafeForAllGas target initial targetResult
        evmFuel ∧
      Functions.Source.WholeProgramOutcomeRel programOutcome targetResult ∧
      SourceOpenTargetCommittedStorageImageRel shared initial sourceResult
        targetResult := by
  exact
    openXLivenessAndSafetyOfGasBudgetWithCommittedStorageImageRel
      assumptions minimumCompilerFuel


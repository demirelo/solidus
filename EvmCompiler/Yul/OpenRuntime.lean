The gas field covers every emitted external-boundary instruction, including
CREATE.  The response field is the strict trace boundary: CALLs may still route
the all-forwarded-gas out-of-gas alternative, while CREATEs require committed
response agreement on the shared result.
-/
private structure OpenXBoundaryFamilyExternalWorldReadyFor
    (asm : Assembly.Program) (target : Assembly.TargetProgram) : Prop where
  responseGasAdmissibleReady :
    OpenXBoundaryFamilyResponseGasAdmissibleReadyFor asm target
  responseStrictOrAllGasOOGResultTrackingReady :
    OpenXBoundaryFamilyResponseStrictOrAllGasOOGResultTrackingTraceReadyFor
      asm target

namespace OpenXBoundaryFamilyExternalWorldReadyFor

private theorem of_strict
    {asm : Assembly.Program} {target : Assembly.TargetProgram}
    (hResponseGasAdmissibleReady :
      OpenXBoundaryFamilyResponseGasAdmissibleReadyFor asm target)
    (hResponseStrictOrAllGasOOGResultTrackingReady :
      OpenXBoundaryFamilyResponseStrictOrAllGasOOGResultTrackingTraceReadyFor
        asm target) :
    OpenXBoundaryFamilyExternalWorldReadyFor asm target where
  responseGasAdmissibleReady := hResponseGasAdmissibleReady
  responseStrictOrAllGasOOGResultTrackingReady :=
    hResponseStrictOrAllGasOOGResultTrackingReady


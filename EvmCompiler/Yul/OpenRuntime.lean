    (hTrace :
      SourceOpenDispatcherTraceAccepted cfg program shared sourceFuel trace
        sourceResult) :
    Reference.SourceBridgeFacts.SourceOpenTraceResponsesAdmissible cfg trace :=
  Reference.SourceBridgeFacts.SourceOpenTraceExternalResponsesAdmissible.to_call

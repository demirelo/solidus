                    currentState.executionEnv.code := by
            intro response hMem
            exact
              Reference.SourceBridgeFacts.RelationallyAdmissibleOpenResponse.evmOpenCall_resume_code_stable
                (hCurrentResponses (OpenExternal.OpenEvent.call call.site response)
                  hMem)
                hShared hCall
          exact
            OpenGasAware.OpenXBlockTraceRelReady.openRunListResult_emitInstr_prim_call_running_preserves_code_of_trace_response_stable
              (program := program) (initial := currentState)
              (mid := midState) (trace := headTrace) (pc := pc) (op := op)
              (emitted := emitted) (kind := kind) (call := call)
              hEmit hRun hKind hCall hStable
      have hMidCode :
          midState.executionEnv.code =
            Assembly.Bytecode.encodeTarget targetProgram :=
        hCodeStable.trans hCode
      exact
        OpenGasAware.OpenXBlockTraceRelReady.CurrentEmittedTraceReadyFor.stepRunning
          hAt hEmit hTargetBlock hRun hRunReady hCodeStable
          (ih hMidCode hTailResponses)
  | stepHalted hStep =>

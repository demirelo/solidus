/--
CALL-route mirror of the no-CALL assembly-bound gate.

This does not claim adaptive spill support for CALL programs.  It keeps the
existing regular-open CALL compiler path, requires the no-return-data-copy
boundary, and additionally accepts only when the emitted assembly passes the
same executable inferred stack-bound checker used by the stack-guarded
no-CALL route.
-/
noncomputable def
    compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpenAssemblyInferredBoundStackSafeNoReturnDataCopy?
    (program : Program) :
    Option (Functions.Program × Assembly.Program × Assembly.TargetProgram) :=
  match
      compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpenNoReturnDataCopy?
        program with
  | none => none
  | some (functionProgram, asm, target) =>
      match
          _root_.EvmCompiler.Yul.OpenAssemblyStackBounds.inferProgramBoundCheckResult?
            asm 17 1024 with
      | none => none
      | some _check => some (functionProgram, asm, target)

theorem
    compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpenAssemblyInferredBoundStackSafeNoReturnDataCopy?_eq_some
    {program : Program} {functionProgram : Functions.Program}
    {asm : Assembly.Program} {target : Assembly.TargetProgram}
    (hChecked :
      compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpenAssemblyInferredBoundStackSafeNoReturnDataCopy?
          program =
        some (functionProgram, asm, target)) :
    compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpenNoReturnDataCopy?
        program =
      some (functionProgram, asm, target) ∧
        ∃ check :
          _root_.EvmCompiler.Yul.OpenAssemblyStackBounds.ProgramBoundCheckResult
            asm 17 1024,
          _root_.EvmCompiler.Yul.OpenAssemblyStackBounds.inferProgramBoundCheckResult?
              asm 17 1024 =
            some check := by
  unfold
    compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpenAssemblyInferredBoundStackSafeNoReturnDataCopy?
      at hChecked
  cases hBase :
      compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpenNoReturnDataCopy?
        program with
  | none =>
      simp [hBase] at hChecked
  | some triple =>
      rcases triple with ⟨functionProgram', asm', target'⟩
      cases hBound :
          _root_.EvmCompiler.Yul.OpenAssemblyStackBounds.inferProgramBoundCheckResult?
            asm' 17 1024 with
      | none =>
          simp [hBase, hBound] at hChecked
      | some check =>
          simp [hBase, hBound] at hChecked
          rcases hChecked with ⟨rfl, rfl, rfl⟩
          exact ⟨rfl, check, hBound⟩


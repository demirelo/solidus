      rcases
          OpenAssembly.Source.openStepResult_resolves_target_current
            hAssemble hStep with
        ⟨pc, instr, emitted, before, after, hAt, hEmit, hTargetBlock,
          hRun⟩
      have hStepReady :
          OpenXCompiledOpenCurrentCallBridgeReadyFor (cfg := cfg)
            (OpenAssembly.OpenBlockTraceResult.stepHalted
              (fuel := fuel0) hAt hEmit hTargetBlock hRun) :=
        OpenXCompiledOpenCurrentCallBridgeReadyFor.stepHalted
          (fuel := fuel0)
          hAt hEmit hTargetBlock hRun
          (hHaltedNoCall hAt hEmit hTargetBlock hRun)
      exact cast_trace hStepReady


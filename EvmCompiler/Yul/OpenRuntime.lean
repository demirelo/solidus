theorem compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpen?_eq_some
    {program : Program} {functionProgram : Functions.Program}
    {asm : Assembly.Program} {target : Assembly.TargetProgram}
    (hChecked :
      compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpen?
          program =
        some (functionProgram, asm, target)) :
    ∃ lowerObj : Objects.Program,
      program.toObjects? = some lowerObj ∧
        functionProgram = lowerObj.toFunctions ∧
          OpenLowering.FunctionsProgramRegularOpenSupported?
              functionProgram =
            true ∧
            compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStatic?
                program =
              some (asm, target) := by
  unfold
    compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpen?
      at hChecked
  cases hLower : program.toObjects? with
  | none =>
      simp [hLower] at hChecked
  | some lowerObj =>
      simp [hLower] at hChecked
      cases hSupported :
          OpenLowering.FunctionsProgramRegularOpenSupported?
            lowerObj.toFunctions with
      | false =>
          simp [hSupported] at hChecked
      | true =>
          simp [hSupported] at hChecked
          cases hCompile :
              compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStatic?
                  program with
          | none =>
              simp [hCompile] at hChecked
          | some pair =>
              rcases pair with ⟨asm', target'⟩
              simp [hCompile] at hChecked
              rcases hChecked with ⟨rfl, rfl, rfl⟩
              exact
                ⟨lowerObj, rfl, rfl, by simpa using hSupported, rfl⟩


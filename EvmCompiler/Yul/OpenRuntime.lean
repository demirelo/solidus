/--
Directional response condition for comparing a low-gas candidate CALL with a
reference CALL response.

Either the candidate response is an ordinary continuing response and must agree
with the reference in all caller-visible committed pieces, or the candidate
child received all available forwarded gas and ran out of gas.  The second case
is intended to feed the whole-run outcome tracker; it does not by itself make
two caller continuations equivalent.
-/
def OpenCallResponseTracksReferenceOrAllGasOOG
    (referenceResponse candidateResponse : OpenExternal.CallResponse)
    (candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat)
    (candidateStatus : OpenCallChildGasStatus) : Prop :=
  OpenCallResponsesCommittedSafeEquivalent referenceResponse
      candidateResponse ∨
    OpenCallAllForwardedGasOutOfGas candidateForwardedGas
      candidateAvailableGas candidatePostCallGas candidateStatus
      candidateResponse

namespace OpenCallResponseTracksReferenceOrAllGasOOG

theorem of_committedSafe
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    (hSafe :
      OpenCallResponsesCommittedSafeEquivalent referenceResponse
        candidateResponse) :
    OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
      candidateResponse candidateForwardedGas candidateAvailableGas
      candidatePostCallGas candidateStatus :=
  Or.inl hSafe

theorem of_allForwardedGasOutOfGas
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    (hOOG :
      OpenCallAllForwardedGasOutOfGas candidateForwardedGas
        candidateAvailableGas candidatePostCallGas candidateStatus
        candidateResponse) :
    OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
      candidateResponse candidateForwardedGas candidateAvailableGas
      candidatePostCallGas candidateStatus :=
  Or.inr hOOG

theorem committedSafe_of_not_allForwardedGasOutOfGas
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hNotOOG :
      ¬ OpenCallAllForwardedGasOutOfGas candidateForwardedGas
        candidateAvailableGas candidatePostCallGas candidateStatus
        candidateResponse) :
    OpenCallResponsesCommittedSafeEquivalent referenceResponse
      candidateResponse := by
  rcases hTrack with hSafe | hOOG
  · exact hSafe
  · exact False.elim (hNotOOG hOOG)

theorem allForwardedGasOutOfGas_of_not_committedSafe
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hNotSafe :
      ¬ OpenCallResponsesCommittedSafeEquivalent referenceResponse
        candidateResponse) :
    OpenCallAllForwardedGasOutOfGas candidateForwardedGas
      candidateAvailableGas candidatePostCallGas candidateStatus
      candidateResponse := by
  rcases hTrack with hSafe | hOOG
  · exact False.elim (hNotSafe hSafe)
  · exact hOOG

theorem success_eq_or_allForwardedGasOutOfGas
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus) :
    referenceResponse.success = candidateResponse.success ∨
      OpenCallAllForwardedGasOutOfGas candidateForwardedGas
        candidateAvailableGas candidatePostCallGas candidateStatus
        candidateResponse := by
  rcases hTrack with hSafe | hOOG
  · exact Or.inl hSafe.success_eq
  · exact Or.inr hOOG

theorem allForwardedGasOutOfGas_of_success_ne
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hNe : referenceResponse.success ≠ candidateResponse.success) :
    OpenCallAllForwardedGasOutOfGas candidateForwardedGas
      candidateAvailableGas candidatePostCallGas candidateStatus
      candidateResponse := by
  exact
    allForwardedGasOutOfGas_of_not_committedSafe hTrack (by
      intro hSafe
      exact hNe hSafe.success_eq)

theorem allForwardedGasOutOfGas_of_reference_success_true_candidate_success_false
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hReference : referenceResponse.success = true)
    (hCandidate : candidateResponse.success = false) :
    OpenCallAllForwardedGasOutOfGas candidateForwardedGas
      candidateAvailableGas candidatePostCallGas candidateStatus
      candidateResponse := by
  exact
    allForwardedGasOutOfGas_of_success_ne hTrack (by
      intro hEq
      simp [hReference, hCandidate] at hEq)

theorem outcome_tracks_of_not_committedSafe_candidate_fails
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    {candidateOutcome :
      Except EVMException (EvmYul.EVM.ExecutionResult EVMState)}
    {referenceResult : EvmYul.EVM.ExecutionResult EVMState}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hNotSafe :
      ¬ OpenCallResponsesCommittedSafeEquivalent referenceResponse
        candidateResponse)
    (hFails : Assembly.GasAware.XRunOutcomeFails candidateOutcome) :
    OpenCallAllForwardedGasOutOfGas candidateForwardedGas
        candidateAvailableGas candidatePostCallGas candidateStatus
        candidateResponse ∧
      Assembly.GasAware.XRunOutcomeSafelyTracks candidateOutcome
        (.ok referenceResult) := by
  exact
    ⟨allForwardedGasOutOfGas_of_not_committedSafe hTrack hNotSafe,
      Assembly.GasAware.XRunOutcomeSafelyTracks.of_candidate_fails hFails⟩

theorem outcome_tracks_of_success_ne_candidate_fails
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    {candidateOutcome :
      Except EVMException (EvmYul.EVM.ExecutionResult EVMState)}
    {referenceResult : EvmYul.EVM.ExecutionResult EVMState}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hNe : referenceResponse.success ≠ candidateResponse.success)
    (hFails : Assembly.GasAware.XRunOutcomeFails candidateOutcome) :
    OpenCallAllForwardedGasOutOfGas candidateForwardedGas
        candidateAvailableGas candidatePostCallGas candidateStatus
        candidateResponse ∧
      Assembly.GasAware.XRunOutcomeSafelyTracks candidateOutcome
        (.ok referenceResult) := by
  exact
    outcome_tracks_of_not_committedSafe_candidate_fails hTrack
      (by
        intro hSafe
        exact hNe hSafe.success_eq)
      hFails

theorem outcome_tracks_of_reference_success_true_candidate_success_false
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    {candidateOutcome :
      Except EVMException (EvmYul.EVM.ExecutionResult EVMState)}
    {referenceResult : EvmYul.EVM.ExecutionResult EVMState}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hReference : referenceResponse.success = true)
    (hCandidate : candidateResponse.success = false)
    (hFails : Assembly.GasAware.XRunOutcomeFails candidateOutcome) :
    OpenCallAllForwardedGasOutOfGas candidateForwardedGas
        candidateAvailableGas candidatePostCallGas candidateStatus
        candidateResponse ∧
      Assembly.GasAware.XRunOutcomeSafelyTracks candidateOutcome
        (.ok referenceResult) := by
  exact
    ⟨allForwardedGasOutOfGas_of_reference_success_true_candidate_success_false
        hTrack hReference hCandidate,
      Assembly.GasAware.XRunOutcomeSafelyTracks.of_candidate_fails hFails⟩

theorem committedSafe_or_allForwardedGasOutOfGas_tracks
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    {candidateOutcome :
      Except EVMException (EvmYul.EVM.ExecutionResult EVMState)}
    {referenceResult : EvmYul.EVM.ExecutionResult EVMState}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hOutcomeTracks :
      ¬ OpenCallResponsesCommittedSafeEquivalent referenceResponse
          candidateResponse →
        Assembly.GasAware.XRunOutcomeSafelyTracks candidateOutcome
          (.ok referenceResult)) :
    OpenCallResponsesCommittedSafeEquivalent referenceResponse
        candidateResponse ∨
      OpenCallAllForwardedGasOutOfGas candidateForwardedGas
          candidateAvailableGas candidatePostCallGas candidateStatus
          candidateResponse ∧
        Assembly.GasAware.XRunOutcomeSafelyTracks candidateOutcome
          (.ok referenceResult) := by
  by_cases hSafe :
      OpenCallResponsesCommittedSafeEquivalent referenceResponse
        candidateResponse
  · exact Or.inl hSafe
  · exact
      Or.inr
        ⟨allForwardedGasOutOfGas_of_not_committedSafe hTrack hSafe,
          hOutcomeTracks hSafe⟩

theorem committedSafe_or_allForwardedGasOutOfGas_candidateFails
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    {candidateOutcome :
      Except EVMException (EvmYul.EVM.ExecutionResult EVMState)}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hFails :
      ¬ OpenCallResponsesCommittedSafeEquivalent referenceResponse
          candidateResponse →
        Assembly.GasAware.XRunOutcomeFails candidateOutcome) :
    OpenCallResponsesCommittedSafeEquivalent referenceResponse
        candidateResponse ∨
      OpenCallAllForwardedGasOutOfGas candidateForwardedGas
          candidateAvailableGas candidatePostCallGas candidateStatus
          candidateResponse ∧
        Assembly.GasAware.XRunOutcomeFails candidateOutcome := by
  by_cases hSafe :
      OpenCallResponsesCommittedSafeEquivalent referenceResponse
        candidateResponse
  · exact Or.inl hSafe
  · exact
      Or.inr
        ⟨allForwardedGasOutOfGas_of_not_committedSafe hTrack hSafe,
          hFails hSafe⟩

end OpenCallResponseTracksReferenceOrAllGasOOG

/--
Persistent-storage image relation lifted through optional account maps.

`none` is reserved for source states that are not valid full-program
commit observations. Public CALL-route storage theorems only produce this
relation from accepted traces, where the invalid cases are unreachable.
-/
def OptionalStorageImageRel {τ₁ τ₂ : EvmYul.OperationType}
    (source : Option (EvmYul.AccountMap τ₁))
    (target : Option (EvmYul.AccountMap τ₂)) : Prop :=
  ∀ address,
    source.bind (fun accounts => Reference.AccountStorage? accounts address) =
      target.bind (fun accounts => Reference.AccountStorage? accounts address)

def SourceOpenCommittedAccountMap?
    (initialShared : EvmYul.SharedState .Yul)
    (sourceResult : Except Reference.Exception Reference.State) :
    Option (EvmYul.AccountMap .Yul) :=
  match sourceResult with
  | .ok (.Ok shared _store) =>
      some shared.toState.accountMap
  | .error (.YulHalt (.Ok shared _store) _value) =>
      some shared.toState.accountMap
  | .error (.Revert _stateBeforeRevert) =>
      some initialShared.toState.accountMap
  | _ =>
      none

def TargetCommittedAccountMap?
    (initial : EVMState) (targetResult : Assembly.StepResult) :
    Option (EvmYul.AccountMap .EVM) :=
  match Assembly.GasAware.XTargetCommittedObservation targetResult with
  | .committed state _output =>
      some state.accountMap
  | .reverted =>
      some initial.toState.accountMap

def SourceOpenTargetCommittedStorageImageRel
    (initialShared : EvmYul.SharedState .Yul)
    (initial : EVMState)
    (sourceResult : Except Reference.Exception Reference.State)
    (targetResult : Assembly.StepResult) : Prop :=
  OptionalStorageImageRel
    (SourceOpenCommittedAccountMap? initialShared sourceResult)
    (TargetCommittedAccountMap? initial targetResult)

theorem storageImageRel_trans
    {τ₁ τ₂ τ₃ : EvmYul.OperationType}
    {first : EvmYul.AccountMap τ₁}
    {middle : EvmYul.AccountMap τ₂}
    {last : EvmYul.AccountMap τ₃}
    (hFirst : Reference.StorageImageRel first middle)
    (hLast : Reference.StorageImageRel middle last) :
    Reference.StorageImageRel first last := by
  intro address
  exact (hFirst address).trans (hLast address)

theorem storageImageRel_of_accountMap_eq
    {τ : EvmYul.OperationType}
    {source target : EvmYul.AccountMap τ}
    (hEq : source = target) :
    Reference.StorageImageRel source target := by
  cases hEq
  intro _address
  rfl

theorem storageImageRel_of_eraseControl_eq
    {source target : EVMState}
    (hEq :
      Structured.Preservation.eraseControl source =
        Structured.Preservation.eraseControl target) :
    Reference.StorageImageRel source.toState.accountMap
      target.toState.accountMap := by
  intro address
  have hMap : source.toState.accountMap = target.toState.accountMap := by
    simpa [Structured.Preservation.eraseControl, Assembly.eraseGas] using
      congrArg (fun state : EVMState => state.toState.accountMap) hEq
  simp [Reference.AccountStorage?, hMap]

theorem openResultResolves_result_eq
    {ε α : Type} {source : OpenExternal.OpenResult ε α}
    {trace : OpenExternal.OpenTrace} {left right : Except ε α}
    (hLeft : OpenExternal.OpenResultResolves source trace left)
    (hRight : OpenExternal.OpenResultResolves source trace right) :
    left = right := by
  induction hLeft generalizing right with
  | done =>
      cases hRight
      rfl
  | @call call response trace result hTail ih =>
      cases hRight with
      | call hTailRight =>
          exact ih hTailRight
  | @create create response trace result hTail ih =>
      cases hRight with
      | create hTailRight =>
          exact ih hTailRight

theorem storageImageRel_of_sourceDirectStateRel_eraseControl_eq
    {layout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {compiler : Objects.Source.State}
    {direct : Locals.RunState}
    {target : EVMState}
    (hDirectRel :
      Functions.SourceDirect.StateRel layout hiddenReturns compiler direct)
    (hErase :
      Structured.Preservation.eraseControl direct.evm =
        Structured.Preservation.eraseControl target) :
    Reference.StorageImageRel compiler.shared.toState.accountMap
      target.toState.accountMap := by
  have hCompilerDirect :
      compiler.shared.toState.accountMap = direct.evm.toState.accountMap := by
    have hShared : direct.evm.toSharedState = compiler.shared :=
      hDirectRel.1.1
    simpa using
      congrArg (fun shared : EvmYul.SharedState .EVM =>
        shared.toState.accountMap) hShared.symm
  exact
    storageImageRel_trans
      (storageImageRel_of_accountMap_eq hCompilerDirect)
      (storageImageRel_of_eraseControl_eq hErase)

theorem storageImageRel_of_sourceDirectShared_frame
    {compiler : Objects.Source.State}
    {direct : Locals.RunState}
    {target : EVMState}
    {tokens : List Word}
    (hShared : compiler.shared = direct.evm.toSharedState)
    (hFrame : Structured.Preservation.Frame.StateRel direct target tokens) :
    Reference.StorageImageRel compiler.shared.toState.accountMap
      target.toState.accountMap := by
  rcases hFrame with ⟨_hStack, hData⟩
  have hCompilerDirect :
      compiler.shared.toState.accountMap = direct.evm.toState.accountMap := by
    simpa using
      congrArg (fun shared : EvmYul.SharedState .EVM =>
        shared.toState.accountMap) hShared
  have hDirectTarget :
      Reference.StorageImageRel direct.evm.toState.accountMap
        target.toState.accountMap := by
    simpa using
      storageImageRel_of_eraseControl_eq
        (source := { direct.evm with stack := target.stack })
        (target := target) hData.symm
  exact
    storageImageRel_trans
      (storageImageRel_of_accountMap_eq hCompilerDirect) hDirectTarget

theorem storageImageRel_of_functionsWholeProgram_regular
    {compiler : Objects.Source.State}
    {targetResult : Assembly.StepResult}
    (hWhole :
      Functions.Source.WholeProgramOutcomeRel
        (Functions.Source.Outcome.regular compiler) targetResult) :
    ∃ target : EVMState,
      targetResult = .running target ∧
        Reference.StorageImageRel compiler.shared.toState.accountMap
          target.toState.accountMap := by
  rcases hWhole with ⟨directOutcome, hDirect, hStructured⟩
  cases directOutcome with
  | mk directState directMode =>
      cases directMode <;> cases targetResult <;>
        simp [Functions.Source.WholeProgramOutcomeRel,
          Functions.SourceDirect.BlockScopedOutcomeRel,
          Functions.SourceDirect.StmtOutcomeRel,
          Functions.Source.Outcome.regular,
          Locals.Source.Outcome.regular,
          Structured.Outcome.regular,
          Structured.Preservation.WholeProgramOutcomeRel] at hDirect hStructured ⊢
      all_goals try contradiction
      exact
        storageImageRel_of_sourceDirectStateRel_eraseControl_eq
          hDirect hStructured

theorem storageImageRel_of_functionsWholeProgram_halt
    {kind : Assembly.HaltKind}
    {compiler : Objects.Source.State}
    {targetResult : Assembly.StepResult}
    (hWhole :
      Functions.Source.WholeProgramOutcomeRel
        (Functions.Source.Outcome.halt kind compiler) targetResult) :
    ∃ target : Assembly.Halt,
      targetResult = .halted target ∧
        target.kind = kind ∧
        Reference.StorageImageRel compiler.shared.toState.accountMap
          target.state.toState.accountMap := by
  rcases hWhole with ⟨directOutcome, hDirect, hStructured⟩
  cases directOutcome with
  | mk directState directMode =>
      cases directMode <;> cases targetResult <;>
        simp [Functions.Source.WholeProgramOutcomeRel,
          Functions.SourceDirect.BlockScopedOutcomeRel,
          Functions.SourceDirect.StmtOutcomeRel,
          Functions.Source.Outcome.halt,
          Locals.Source.Outcome.halt,
          Structured.Outcome.halt,
          Structured.Outcome.regular,
          Structured.Preservation.WholeProgramOutcomeRel] at hDirect hStructured ⊢
      all_goals try contradiction
      rcases hDirect with ⟨hKind, hShared⟩
      cases hKind
      rcases hStructured with ⟨hKindTarget, tokens, hFrame⟩
      cases hKindTarget
      exact ⟨rfl, storageImageRel_of_sourceDirectShared_frame hShared hFrame⟩

set_option maxHeartbeats 1200000 in
theorem canonicalTerminalRel_storageImageRel
    {cfg : Reference.StateRelConfig}
    {kind : Assembly.HaltKind} {value : Word}
    {yulChild : EvmYul.SharedState .Yul}
    {childStore : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    (hRel :
      RecursiveBridgeTerminalObservationContracts.canonicalTerminalRel cfg
        kind value (.Ok yulChild childStore) compiler) :
    Reference.StorageImageRel yulChild.toState.accountMap
      compiler.shared.toState.accountMap := by
  have hNonRevert : kind ≠ .revert :=
    RecursiveBridgeTerminalObservationContracts.canonicalTerminalRel_nonrevert
      hRel
  rcases hRel with
    ⟨yulPrim, argFuel, source, sourceAfterArgs, sourceValues, args, rest,
      codeOverride, compilerAfterArgs, sharedAfter, layout, hTerminal,
      hExecSeq, hEvalArgs, hArgsRel, hStruct, hCompiler⟩
  cases hArgsRel with
  | @ok sourceShared sourceStore compilerAfterArgs hShared _hVars =>
      let sourceAfterArgs : Reference.State := .Ok sourceShared sourceStore
      cases yulPrim <;> simp [Prim.terminal?] at hTerminal
      case StopArith op =>
        cases op <;> simp at hTerminal
        cases hTerminal
        cases argFuel with
        | zero =>
            simp [EvmYul.Yul.evalArgs] at hEvalArgs
        | succ fuel =>
            let stopState : Reference.State :=
              sourceAfterArgs.setMachineState
                (sourceAfterArgs.toMachineState.setHReturn ByteArray.empty)
            have hPrim :
                EvmYul.Yul.primCall fuel.succ sourceAfterArgs
                    ((.StopArith .STOP : EvmYul.Operation .Yul)) sourceValues =
                  .error (.YulHalt stopState (EvmYul.UInt256.ofNat 0)) := by
              simpa [stopState, sourceAfterArgs] using
                PrimSemantics.primCall_stop_eq fuel sourceAfterArgs
                  sourceValues
            have hResult :=
              Reference.SourceBridgeFacts.execSeq_expr_prim_call_error_of_evalArgs_ok_primCall_error
                (sourceFuel := fuel.succ) (source := source)
                (sourceAfterArgs := sourceAfterArgs)
                (yulPrim := (.StopArith .STOP : EvmYul.Operation .Yul))
                (args := args) (rest := rest) (codeOverride := codeOverride)
                (argValues := sourceValues)
                (err := .YulHalt stopState (EvmYul.UInt256.ofNat 0))
                (sourceResult :=
                  .error (.YulHalt (.Ok yulChild childStore) value))
                hEvalArgs hPrim hExecSeq
            injection hResult with hErr
            injection hErr with hState _hValue
            have hStateOk :
                (.Ok yulChild childStore : Reference.State) =
                  .Ok
                    { sourceShared with
                      toMachineState :=
                        sourceShared.toMachineState.setHReturn
                          ByteArray.empty }
                    sourceStore := by
              simpa [stopState, sourceAfterArgs,
                EvmYul.Yul.State.setMachineState] using hState
            injection hStateOk with hSharedEq _hStoreEq
            cases hSharedEq
            have hSharedAfterMap :
                compilerAfterArgs.shared.toState.accountMap =
                  sharedAfter.toState.accountMap := by
              let iso : EVMState :=
                { toSharedState := compilerAfterArgs.shared
                  pc := EvmYul.UInt256.ofNat 0
                  stack := sourceValues
                  execLength := 0 }
              have hStep :
                  Structured.Terminal.step .stop iso =
                    .ok
                      { iso with
                        toMachineState :=
                          (iso.toMachineState.setReturnData
                            ByteArray.empty).setHReturn ByteArray.empty } := by
                simp [iso, Structured.Terminal.step,
                  Assembly.Target.stepInstr, Assembly.HaltKind.toPrimOp,
                  Assembly.PrimOp.step, Assembly.PrimOp.continuingStep?,
                  Assembly.PrimOp.toEVM]
                rfl
              have hOk :
                  sharedAfter =
                    { compilerAfterArgs.shared with
                      toMachineState :=
                        (compilerAfterArgs.shared.toMachineState.setReturnData
                          ByteArray.empty).setHReturn ByteArray.empty } := by
                simpa [Locals.Source.PrimitiveSemantics.structured,
                  iso, hStep, EvmYul.EVM.State.toSharedState] using
                  hStruct.symm
              cases hOk
              rfl
            cases hCompiler
            exact
              storageImageRel_trans
                (by
                  simpa using
                    Reference.SharedStateRel.storageImageRel hShared)
                (storageImageRel_of_accountMap_eq hSharedAfterMap)
      case System op =>
        cases op <;> simp at hTerminal
        · -- RETURN
          cases hTerminal
          cases argFuel with
          | zero =>
              simp [EvmYul.Yul.evalArgs] at hEvalArgs
          | succ fuel =>
              cases sourceValues with
              | nil =>
                  have hPrim :=
                    PrimSemantics.primCall_return_nil_eq fuel
                      sourceAfterArgs
                  have hResult :=
                    Reference.SourceBridgeFacts.execSeq_expr_prim_call_error_of_evalArgs_ok_primCall_error
                      (sourceFuel := fuel.succ) (source := source)
                      (sourceAfterArgs := sourceAfterArgs)
                      (yulPrim := (.System .RETURN :
                        EvmYul.Operation .Yul))
                      (args := args) (rest := rest)
                      (codeOverride := codeOverride) (argValues := [])
                      (err := .InvalidArguments)
                      (sourceResult :=
                        .error (.YulHalt (.Ok yulChild childStore) value))
                      hEvalArgs hPrim hExecSeq
                  cases hResult
              | cons offset restValues =>
                  cases restValues with
                  | nil =>
                      have hPrim :=
                        PrimSemantics.primCall_return_singleton_eq fuel
                          sourceAfterArgs offset
                      have hResult :=
                        Reference.SourceBridgeFacts.execSeq_expr_prim_call_error_of_evalArgs_ok_primCall_error
                          (sourceFuel := fuel.succ) (source := source)
                          (sourceAfterArgs := sourceAfterArgs)
                          (yulPrim := (.System .RETURN :
                            EvmYul.Operation .Yul))
                          (args := args) (rest := rest)
                          (codeOverride := codeOverride)
                          (argValues := [offset])
                          (err := .InvalidArguments)
                          (sourceResult :=
                            .error (.YulHalt (.Ok yulChild childStore) value))
                          hEvalArgs hPrim hExecSeq
                      cases hResult
                  | cons size more =>
                      cases more with
                      | nil =>
                          have hPrimEq :
                              EvmYul.Yul.primCall fuel.succ sourceAfterArgs
                                  ((.System .RETURN :
                                    EvmYul.Operation .Yul)) [offset, size] =
                                .error
                                  (.YulHalt
                                    (sourceAfterArgs.setMachineState
                                      (sourceAfterArgs.toMachineState.evmReturn
                                        offset size))
                                    ((Option.none : Option Word).getD ⟨1⟩)) := by
                            simp [EvmYul.Yul.primCall]
                            have hStep :
                                EvmYul.step
                                    ((.System .RETURN :
                                      EvmYul.Operation .Yul)) none =
                                  (fun yulState lits =>
                                    match
                                      EvmYul.Yul.binaryMachineStateOp
                                        EvmYul.MachineState.evmReturn
                                        yulState lits with
                                    | .error e => .error e
                                    | .ok (s, v) =>
                                        .error
                                          (EvmYul.Yul.Exception.YulHalt s
                                            (v.getD ⟨1⟩))) := by
                              rfl
                            rw [hStep]
                            rfl
                          have hResult :=
                            Reference.SourceBridgeFacts.execSeq_expr_prim_call_error_of_evalArgs_ok_primCall_error
                              (sourceFuel := fuel.succ) (source := source)
                              (sourceAfterArgs := sourceAfterArgs)
                              (yulPrim := (.System .RETURN :
                                EvmYul.Operation .Yul))
                              (args := args) (rest := rest)
                              (codeOverride := codeOverride)
                              (argValues := [offset, size])
                              (err :=
                                .YulHalt
                                  (sourceAfterArgs.setMachineState
                                    (sourceAfterArgs.toMachineState.evmReturn
                                      offset size))
                                  ((Option.none : Option Word).getD ⟨1⟩))
                              (sourceResult :=
                                .error
                                  (.YulHalt (.Ok yulChild childStore) value))
                              hEvalArgs hPrimEq hExecSeq
                          injection hResult with hErr
                          injection hErr with hState _hValue
                          have hStateOk :
                              (.Ok yulChild childStore : Reference.State) =
                                .Ok
                                  { sourceShared with
                                    toMachineState :=
                                      sourceShared.toMachineState.evmReturn
                                        offset size }
                                  sourceStore := by
                            simpa [sourceAfterArgs,
                              EvmYul.Yul.State.setMachineState] using hState
                          injection hStateOk with hSharedEq _hStoreEq
                          cases hSharedEq
                          have hSharedAfterOk :
                              (Except.ok sharedAfter :
                                Except EVMException
                                  (EvmYul.SharedState .EVM)) =
                                .ok
                                  { compilerAfterArgs.shared with
                                    toMachineState :=
                                      compilerAfterArgs.shared.toMachineState.evmReturn
                                        offset size } := by
                            simpa [Locals.Source.PrimitiveSemantics.structured,
                              OpenExternal.YulOpenResult.ok,
                              Structured.Terminal.step,
                              Assembly.Target.stepInstr,
                              Assembly.PrimOp.step,
                              Assembly.PrimOp.continuingStep?,
                              Assembly.HaltKind.toPrimOp,
                              Assembly.PrimOp.toEVM,
                              Locals.SourceLowering.PrimitiveSemantics.evm_step_return_eq_binaryMachineStateOp,
                              EvmYul.EVM.binaryMachineStateOp,
                              EvmYul.Stack.pop2,
                              EvmYul.EVM.State.replaceStackAndIncrPC,
                              EvmYul.EVM.State.incrPC,
                              EvmYul.EVM.State.toSharedState,
                              Id.run] using hStruct.symm
                          injection hSharedAfterOk with hSharedAfterEq
                          cases hSharedAfterEq
                          cases hCompiler
                          simpa using
                            Reference.SharedStateRel.storageImageRel hShared
                      | cons extra extras =>
                          have hPrim :=
                            PrimSemantics.primCall_return_cons_cons_cons_eq
                              fuel sourceAfterArgs offset size extra extras
                          have hResult :=
                            Reference.SourceBridgeFacts.execSeq_expr_prim_call_error_of_evalArgs_ok_primCall_error
                              (sourceFuel := fuel.succ) (source := source)
                              (sourceAfterArgs := sourceAfterArgs)
                              (yulPrim := (.System .RETURN :
                                EvmYul.Operation .Yul))
                              (args := args) (rest := rest)
                              (codeOverride := codeOverride)
                              (argValues := offset :: size :: extra :: extras)
                              (err := .InvalidArguments)
                              (sourceResult :=
                                .error
                                  (.YulHalt (.Ok yulChild childStore) value))
                              hEvalArgs hPrim hExecSeq
                          cases hResult
        · -- REVERT
          cases hTerminal
          exact False.elim (hNonRevert rfl)
        · -- SELFDESTRUCT
          cases hTerminal
          cases argFuel with
          | zero =>
              simp [EvmYul.Yul.evalArgs] at hEvalArgs
          | succ fuel =>
              by_cases hStatic : sourceAfterArgs.executionEnv.perm = false
              · have hPrim :=
                  PrimSemantics.primCall_selfdestruct_static_eq fuel
                    sourceAfterArgs sourceValues hStatic
                have hResult :=
                  Reference.SourceBridgeFacts.execSeq_expr_prim_call_error_of_evalArgs_ok_primCall_error
                    (sourceFuel := fuel.succ) (source := source)
                    (sourceAfterArgs := sourceAfterArgs)
                    (yulPrim := (.System .SELFDESTRUCT :
                      EvmYul.Operation .Yul))
                    (args := args) (rest := rest)
                    (codeOverride := codeOverride) (argValues := sourceValues)
                    (err := .StaticModeViolation)
                    (sourceResult :=
                      .error (.YulHalt (.Ok yulChild childStore) value))
                    hEvalArgs hPrim hExecSeq
                cases hResult
              · cases sourceValues with
                | nil =>
                    have hPrim :=
                      PrimSemantics.primCall_selfdestruct_nil_eq fuel
                        sourceAfterArgs hStatic
                    have hResult :=
                      Reference.SourceBridgeFacts.execSeq_expr_prim_call_error_of_evalArgs_ok_primCall_error
                        (sourceFuel := fuel.succ) (source := source)
                        (sourceAfterArgs := sourceAfterArgs)
                        (yulPrim := (.System .SELFDESTRUCT :
                          EvmYul.Operation .Yul))
                        (args := args) (rest := rest)
                        (codeOverride := codeOverride) (argValues := [])
                        (err := .InvalidArguments)
                        (sourceResult :=
                          .error (.YulHalt (.Ok yulChild childStore) value))
                        hEvalArgs hPrim hExecSeq
                    cases hResult
                | cons recipient more =>
                    cases more with
                    | nil =>
                        have hPrim :
                            EvmYul.Yul.primCall fuel.succ sourceAfterArgs
                                ((.System .SELFDESTRUCT :
                                  EvmYul.Operation .Yul))
                                [recipient] =
                              .error
                                (.YulHalt
                                  (PrimSemantics.selfdestructState
                                    sourceAfterArgs recipient)
                                  (EvmYul.UInt256.ofNat 0)) := by
                          simp [EvmYul.Yul.primCall, hStatic,
                            PrimSemantics.step_selfdestruct_lit_eq]
                        have hResult :=
                          Reference.SourceBridgeFacts.execSeq_expr_prim_call_error_of_evalArgs_ok_primCall_error
                            (sourceFuel := fuel.succ) (source := source)
                            (sourceAfterArgs := sourceAfterArgs)
                            (yulPrim := (.System .SELFDESTRUCT :
                              EvmYul.Operation .Yul))
                            (args := args) (rest := rest)
                            (codeOverride := codeOverride)
                            (argValues := [recipient])
                            (err :=
                              .YulHalt
                                (PrimSemantics.selfdestructState
                                  sourceAfterArgs recipient)
                                (EvmYul.UInt256.ofNat 0))
                            (sourceResult :=
                              .error
                                (.YulHalt (.Ok yulChild childStore) value))
                            hEvalArgs hPrim hExecSeq
                        injection hResult with hErr
                        injection hErr with hState _hValue
                        have hStateOk :
                            (.Ok yulChild childStore : Reference.State) =
                              PrimSemantics.selfdestructState
                                sourceAfterArgs recipient := by
                          exact hState
                        have hSharedAfter :
                            sharedAfter =
                              (Locals.SourceLowering.PrimitiveSemantics.selfdestructTerminalState
                                  { toSharedState := compilerAfterArgs.shared
                                    pc := EvmYul.UInt256.ofNat 0
                                    stack := [recipient]
                                    execLength := 0 }
                                  recipient []).toSharedState := by
                          let iso : EVMState :=
                            { toSharedState := compilerAfterArgs.shared
                              pc := EvmYul.UInt256.ofNat 0
                              stack := [recipient]
                              execLength := 0 }
                          have hStep :
                              Structured.Terminal.step .selfdestruct iso =
                                .ok
                                  (Locals.SourceLowering.PrimitiveSemantics.selfdestructTerminalState
                                      iso recipient []) := by
                            apply
                              Locals.SourceLowering.PrimitiveSemantics.structured_terminal_step_selfdestruct_of_stack
                            simp [iso]
                          simpa [Locals.Source.PrimitiveSemantics.structured,
                            iso, hStep] using hStruct.symm
                        have hPreBalance :
                            Reference.AccountBalance
                                sourceShared.toState.accountMap
                                sourceShared.toState.executionEnv.codeOwner =
                              Reference.AccountBalance
                                compilerAfterArgs.shared.toState.accountMap
                                sourceShared.toState.executionEnv.codeOwner := by
                          have hSelf :=
                            Reference.SharedStateRel.selfbalanceRel hShared
                          simpa [Reference.AccountBalance,
                            EvmYul.State.selfbalance,
                            hShared.chain.executionEnv.codeOwner] using hSelf
                        have hStorage :=
                          cfg.selfdestructStorageImageRel
                            (source :=
                              sourceShared.toState.executionEnv.codeOwner)
                            (target :=
                              EvmYul.AccountAddress.ofUInt256 recipient)
                            (createdYul :=
                              sourceShared.toState.createdAccounts.contains
                                sourceShared.toState.executionEnv.codeOwner)
                            (createdEvm :=
                              compilerAfterArgs.shared.toState.createdAccounts.contains
                                compilerAfterArgs.shared.toState.executionEnv.codeOwner)
                            (Reference.SharedStateRel.storageImageRel hShared)
                            hPreBalance
                        cases hCompiler
                        cases hSharedAfter
                        have hStateStorage :
                            Reference.StorageImageRel
                              yulChild.toState.accountMap
                              (EvmYul.selfdestructAccountMap
                                sourceShared.toState.accountMap
                                sourceShared.toState.executionEnv.codeOwner
                                (EvmYul.AccountAddress.ofUInt256 recipient)
                                (sourceShared.toState.createdAccounts.contains
                                  sourceShared.toState.executionEnv.codeOwner)) := by
                          cases hStateOk
                          intro address
                          rfl
                        simpa [PrimSemantics.selfdestructState,
                          EvmYul.Yul.selfdestructState,
                          EvmYul.Yul.State.setState,
                          EvmYul.Yul.State.setMachineState,
                          Locals.SourceLowering.PrimitiveSemantics.selfdestructTerminalState,
                          EvmYul.EVM.selfdestructState,
                          EvmYul.EVM.State.replaceStackAndIncrPC,
                          EvmYul.EVM.State.incrPC,
                          hShared.chain.executionEnv.codeOwner] using
                          storageImageRel_trans hStateStorage hStorage
                    | cons extra extras =>
                        have hPrim :=
                          PrimSemantics.primCall_selfdestruct_cons_cons_eq
                            fuel sourceAfterArgs recipient extra extras hStatic
                        have hResult :=
                          Reference.SourceBridgeFacts.execSeq_expr_prim_call_error_of_evalArgs_ok_primCall_error
                            (sourceFuel := fuel.succ) (source := source)
                            (sourceAfterArgs := sourceAfterArgs)
                            (yulPrim := (.System .SELFDESTRUCT :
                              EvmYul.Operation .Yul))
                            (args := args) (rest := rest)
                            (codeOverride := codeOverride)
                            (argValues := recipient :: extra :: extras)
                            (err := .InvalidArguments)
                            (sourceResult :=
                              .error
                                (.YulHalt (.Ok yulChild childStore) value))
                            hEvalArgs hPrim hExecSeq
                        cases hResult

theorem sourceOpenTargetCommittedStorageImageRel_of_sourceResultOutcomeRel
    {cfg : Reference.StateRelConfig}
    {program : Program}
    {shared : EvmYul.SharedState .Yul}
    {initial : EVMState}
    {sourceResult : Except Reference.Exception Reference.State}
    {sourceOutcome : Objects.Source.Outcome}
    {targetResult : Assembly.StepResult}
    (hInitial :
      RecursiveBridgeInitialWorldRel cfg program shared initial)
    (hSourceRel :
      Reference.SourceBridgeFacts.SourceResultOutcomeRel cfg []
        (RecursiveBridgeTerminalObservationContracts.canonicalTerminalRel cfg)
        (RecursiveBridgeTerminalObservationContracts.canonicalRevertRel cfg)
        sourceResult sourceOutcome)
    (hWhole :
      Functions.Source.WholeProgramOutcomeRel
        (functionsProgramOutcomeOfBlockOutcome Functions.Source.Ctx.initial
          sourceOutcome) targetResult) :
    SourceOpenTargetCommittedStorageImageRel shared initial sourceResult
      targetResult := by
  cases hSourceRel with
  | ok hOk =>
      cases hOk with
      | regular hStateRel =>
          cases hStateRel with
          | ok hShared _hVars =>
              rcases
                  storageImageRel_of_functionsWholeProgram_regular hWhole with
                ⟨target, hTarget, hTargetStorage⟩
              subst targetResult
              exact
                storageImageRel_trans
                  (Reference.SharedStateRel.storageImageRel hShared)
                  (by
                    simpa [functionsProgramOutcomeOfBlockOutcome] using
                      hTargetStorage)
      | brk hStateRel =>
          rcases hWhole with ⟨directOutcome, hDirect, hStructured⟩
          cases directOutcome with
          | mk directState directMode =>
              cases directMode <;> cases targetResult <;>
                simp [Functions.Source.WholeProgramOutcomeRel,
                  Functions.SourceDirect.BlockScopedOutcomeRel,
                  Functions.SourceDirect.StmtOutcomeRel,
                  functionsProgramOutcomeOfBlockOutcome,
                  Functions.Source.Outcome.brk, Locals.Source.Outcome.brk,
                  Structured.Preservation.WholeProgramOutcomeRel]
                  at hDirect hStructured
      | cont hStateRel =>
          rcases hWhole with ⟨directOutcome, hDirect, hStructured⟩
          cases directOutcome with
          | mk directState directMode =>
              cases directMode <;> cases targetResult <;>
                simp [Functions.Source.WholeProgramOutcomeRel,
                  Functions.SourceDirect.BlockScopedOutcomeRel,
                  Functions.SourceDirect.StmtOutcomeRel,
                  functionsProgramOutcomeOfBlockOutcome,
                  Functions.Source.Outcome.cont, Locals.Source.Outcome.cont,
                  Structured.Preservation.WholeProgramOutcomeRel]
                  at hDirect hStructured
      | leave hStateRel =>
          rcases hWhole with ⟨directOutcome, hDirect, hStructured⟩
          cases directOutcome with
          | mk directState directMode =>
              cases directMode <;> cases targetResult <;>
                simp [Functions.Source.WholeProgramOutcomeRel,
                  Functions.SourceDirect.BlockScopedOutcomeRel,
                  Functions.SourceDirect.StmtOutcomeRel,
                  functionsProgramOutcomeOfBlockOutcome,
                  Functions.Source.Outcome.leave,
                  Locals.Source.Outcome.leave,
                  Structured.Preservation.WholeProgramOutcomeRel]
                  at hDirect hStructured
  | @yulHalt source value kind compiler hTerminal =>
      rcases
          RecursiveBridgeTerminalObservationContracts.canonicalTerminalRel_ok_shape
            hTerminal with
        ⟨yulChild, childStore, hSourceShape⟩
      have hTerminalOk :
          RecursiveBridgeTerminalObservationContracts.canonicalTerminalRel cfg
            kind value (.Ok yulChild childStore) compiler := by
        simpa [hSourceShape] using hTerminal
      rcases
          storageImageRel_of_functionsWholeProgram_halt
            (by simpa [functionsProgramOutcomeOfBlockOutcome] using hWhole) with
        ⟨target, hTargetResult, hTargetKind, hTargetStorage⟩
      subst targetResult
      cases target with
      | mk targetKind targetState targetOutput =>
          cases targetKind <;>
            simp [SourceOpenTargetCommittedStorageImageRel,
              OptionalStorageImageRel, SourceOpenCommittedAccountMap?,
              TargetCommittedAccountMap?,
              Assembly.GasAware.XTargetCommittedObservation, hSourceShape]
              at hTargetKind ⊢
          · exact
              storageImageRel_trans
                (canonicalTerminalRel_storageImageRel hTerminalOk)
                hTargetStorage
          · exact
              storageImageRel_trans
                (canonicalTerminalRel_storageImageRel hTerminalOk)
                hTargetStorage
          · exact False.elim
              ((RecursiveBridgeTerminalObservationContracts.canonicalTerminalRel_nonrevert
                hTerminalOk) hTargetKind.symm)
          · exact
              storageImageRel_trans
                (canonicalTerminalRel_storageImageRel hTerminalOk)
                hTargetStorage
  | revert hRevert =>
      rcases
          storageImageRel_of_functionsWholeProgram_halt
            (by simpa [functionsProgramOutcomeOfBlockOutcome] using hWhole) with
        ⟨target, hTargetResult, hTargetKind, _hTargetStorage⟩
      subst targetResult
      have hInitialStorage :
          Reference.StorageImageRel shared.toState.accountMap
            initial.toState.accountMap := by
        simpa [RecursiveBridgeInitialWorldRel] using
          Reference.SharedStateRel.storageImageRel hInitial
      cases target with
      | mk targetKind targetState targetOutput =>
          cases targetKind <;>
            simp [SourceOpenTargetCommittedStorageImageRel,
              OptionalStorageImageRel, SourceOpenCommittedAccountMap?,
              TargetCommittedAccountMap?,
              Assembly.GasAware.XTargetCommittedObservation] at hTargetKind ⊢
          exact hInitialStorage

def OpenCallResponseGasBudgetFacts
    (call gasCall : OpenExternal.OpenCall EVMState)
    (response : OpenExternal.CallResponse)
    (tailGasBound : Nat) : Prop :=
  OpenCallResponseGasAgreementFacts call gasCall response ∧
    OpenCallActualPostGasBudgetFacts gasCall response tailGasBound

namespace OpenCallResponseGasBudgetFacts

theorem agreement
    {call gasCall : OpenExternal.OpenCall EVMState}
    {response : OpenExternal.CallResponse}
    {tailGasBound : Nat}
    (hFacts :
      OpenCallResponseGasBudgetFacts call gasCall response tailGasBound) :
    OpenCallResponseGasAgreementFacts call gasCall response :=
  hFacts.1

theorem actual_post
    {call gasCall : OpenExternal.OpenCall EVMState}
    {response : OpenExternal.CallResponse}
    {tailGasBound : Nat}
    (hFacts :
      OpenCallResponseGasBudgetFacts call gasCall response tailGasBound) :
    OpenCallActualPostGasBudgetFacts gasCall response tailGasBound :=
  hFacts.2

theorem exists_target_forwardedGas_returnedGas_bound
    {call gasCall : OpenExternal.OpenCall EVMState}
    {response : OpenExternal.CallResponse}
    {tailGasBound : Nat}
    (hFacts :
      OpenCallResponseGasBudgetFacts call gasCall response tailGasBound) :
    ∃ targetForwardedGas : Nat,
      response.returnedGas.toNat ≤ targetForwardedGas :=
  OpenCallResponseGasAgreementFacts.exists_target_forwardedGas_returnedGas_bound
    hFacts.agreement

end OpenCallResponseGasBudgetFacts

def OpenXCurrentRunningInstrCallResponseGasAdmissibleReadyCase
    (targetProgram : Assembly.TargetProgram)
    (state : EVMState) (instr : Assembly.Instr) : Prop :=
  ∃ op : Assembly.PrimOp,
    ∃ kind : OpenExternal.CallKind,
      ∃ call : OpenExternal.OpenCall EVMState,
        instr = .prim op ∧
          OpenExternal.CallKind.ofEVMOperation? op.toEVM = some kind ∧
            OpenExternal.CallKind.evmOpenCall? state kind = some call ∧
              (∀ {response : OpenExternal.CallResponse}
                  {tailGasBound : Nat},
                ∃ gasBound : Nat,
                  (∀ {full : EVMState},
                    gasBound ≤ full.gasAvailable.toNat →
                      Assembly.GasAware.GasExecRel full state →
                        Assembly.GasAware.XStepChecksPass
                          (Assembly.GasAware.validJumps targetProgram)
                          full op.toEVM) ∧
                  (∀ {full : EVMState}
                      {gasCall : OpenExternal.OpenCall EVMState},
                    gasBound ≤ full.gasAvailable.toNat →
                      Assembly.GasAware.GasExecRel full state →
                        OpenExternal.CallKind.evmOpenCall?
                            (OpenGasAware.gasChargedState full op.toEVM)
                            kind = some gasCall →
                      OpenCallResponseGasBudgetFacts call gasCall response
                        tailGasBound))


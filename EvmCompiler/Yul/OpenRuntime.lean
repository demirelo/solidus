theorem no_call
    {cfg : Reference.StateRelConfig}
    {targetProgram : Assembly.TargetProgram}
    {asm : Assembly.Program}
    {state : EVMState} {instr : Assembly.Instr}
    (hNoCall : Assembly.Instr.usesCallCreate instr = false) :
    OpenXCurrentRunningInstrCompiledOpenEvidenceCase cfg targetProgram asm
      state instr :=
  Or.inl hNoCall

  private theorem call
    {cfg : Reference.StateRelConfig}
    {targetProgram : Assembly.TargetProgram}
    {asm : Assembly.Program}
    {state : EVMState} {op : Assembly.PrimOp}
    {kind : OpenExternal.CallKind}
    {call : OpenExternal.OpenCall EVMState}
    (hKind :
      OpenExternal.CallKind.ofEVMOperation? op.toEVM = some kind)
    (hCall :
      OpenExternal.CallKind.evmOpenCall? state kind = some call)
    (hStepChecks :
      ∀ {gasBound : Nat} {full : EVMState},
        gasBound ≤ full.gasAvailable.toNat →
          Assembly.GasAware.GasExecRel full state →
            Assembly.GasAware.XStepChecksPass
              (Assembly.GasAware.validJumps targetProgram)
              full op.toEVM)
    (hBridgeRel :
      OpenLowering.FunctionsOpenCurrentSharedStateBridgeRel cfg state)
    (hPostBudget :
      ∀ {response : OpenExternal.CallResponse}
          {tailGasBound : Nat},
        ∃ gasBound : Nat,
          ∀ {full gasPost : EVMState},
            gasBound ≤ full.gasAvailable.toNat →
              Assembly.GasAware.GasExecRel full state →
                Assembly.GasAware.GasExecRel gasPost
                  (EvmYul.EVM.State.incrPC
                    (call.resume response)) →
                  tailGasBound ≤ gasPost.gasAvailable.toNat) :
    OpenXCurrentRunningInstrCompiledOpenEvidenceCase cfg targetProgram asm
      state (.prim op) :=
  Or.inr
    ⟨op, kind, call, rfl, hKind, hCall, hStepChecks, hBridgeRel,
      hPostBudget⟩

  private theorem of_ready_case_call_bridge_rel
    {cfg : Reference.StateRelConfig}
    {targetProgram : Assembly.TargetProgram}
    {asm : Assembly.Program}
    {state : EVMState} {instr : Assembly.Instr}
    (hReady :
      OpenGasAware.OpenXBlockTraceRelReady.CurrentRunningInstrReadyCase
        targetProgram state instr)
    (hCallBridgeRel :
      ∀ {op : Assembly.PrimOp} {kind : OpenExternal.CallKind}
          {call : OpenExternal.OpenCall EVMState},
        instr = .prim op →
        OpenExternal.CallKind.ofEVMOperation? op.toEVM = some kind →
        OpenExternal.CallKind.evmOpenCall? state kind = some call →
        OpenLowering.FunctionsOpenCurrentSharedStateBridgeRel cfg state) :
    OpenXCurrentRunningInstrCompiledOpenEvidenceCase cfg targetProgram asm
      state instr := by
  rcases hReady with hNoCall | hCall
  · exact no_call hNoCall
  · rcases hCall with
      ⟨op, kind, call, hInstr, hKind, hCall, hStepChecks,
        _hCodeStable, hPostBudget⟩
    have hBridgeRel : OpenLowering.FunctionsOpenCurrentSharedStateBridgeRel
        cfg state :=
      hCallBridgeRel hInstr hKind hCall
    cases hInstr
    exact
      OpenXCurrentRunningInstrCompiledOpenEvidenceCase.call
        hKind hCall hStepChecks hBridgeRel hPostBudget

  private theorem to_response_admissible
    {cfg : Reference.StateRelConfig}
    {targetProgram : Assembly.TargetProgram}
    {asm : Assembly.Program}
    {state : EVMState} {instr : Assembly.Instr}
    (hCase :
      OpenXCurrentRunningInstrCompiledOpenEvidenceCase cfg targetProgram asm

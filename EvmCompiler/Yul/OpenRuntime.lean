private structure OpenXReplayTraceReadinessForCheckedTrace
    (asm : Assembly.Program) (target : Assembly.TargetProgram)
    (initial : EVMState) (trace : OpenExternal.OpenTrace) : Prop where
  finalCleanReady :
    ∀ {targetFuel : Nat} {finalState : EVMState},
      OpenAssembly.OpenBlockTraceResult asm target targetFuel initial trace
        (.running finalState) →
      Assembly.GasAware.XStepTrace.XFallthroughStopCleanReady finalState
  traceReady :
    ∀ {targetFuel : Nat} {targetResult : Assembly.StepResult}
      (hTrace :
        OpenAssembly.OpenBlockTraceResult asm target targetFuel initial trace
          targetResult),
      OpenGasAware.OpenXBlockTraceRelReady.TraceReadyFor hTrace

private theorem OpenXReplayTraceReadinessForCheckedTrace.of_current_emitted_cases
    {asm : Assembly.Program} {target : Assembly.TargetProgram}

              (OpenAssembly.Source.OpenTraceResult.to_openBlockTrace
                hAssemble hRest)) :=
        OpenXCompiledOpenCurrentCallBridgeReadyFor.stepRunning
          hAt hEmit hTargetBlock hRun
          (hRunningReady hAt hEmit hTargetBlock hRun)
          (fun {op} {kind} {call} hInstr hKind hCall => by
            cases hInstr

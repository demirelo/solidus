        (store := (default : EvmYul.Yul.VarStore))
        hSafeBlock hScopedBlock hContains)
  have hAllowed :
      Reference.SourceBridgeFacts.SourceResultCheckpointAllowed false false
        false sourceResult :=
    (Reference.SourceBridgeFacts.OpenResultDoneInvariant.of_resolves hInv
      (by simpa [installedShared] using hResolveDispatcher)).1

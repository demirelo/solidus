        reference)
    (hTrace :
      OpenGasAware.OpenXOutcomeTraceResult validJumps (fuel + 1) full
        candidateTrace candidateOutcome) :
    Assembly.GasAware.XRunOutcomeSafelyTracks candidateOutcome
      (.ok reference) := by
  rcases
      OpenGasAware.openX_current_gasless_call_any_outcome_inv_of_exception_actual_post
        (fuel := fuel) (validJumps := validJumps) (full := full)
        (target := target) (op := op) (arg := arg) (kind := kind)
        (call := call) (candidateTrace := candidateTrace)
        (outcome := candidateOutcome)
        hRel hDecode hException hKind hCall hTrace with
    ⟨candidateResponse, tailTrace, gasCall, hTraceEq, hGasCall,
      _hSite, hTailTrace⟩
  have hMem :
      OpenExternal.OpenEvent.call call.site candidateResponse ∈
        candidateTrace := by
    simpa [hTraceEq]
  have hResponse :
      OpenCallResponsesCommittedSafeEquivalent referenceResponse
          candidateResponse ∨
        OpenCallAllForwardedGasOutOfGas 0 0 0
            OpenCallChildGasStatus.outOfGas candidateResponse ∧
          Assembly.GasAware.XRunOutcomeSafelyTracks candidateOutcome
            (.ok reference) :=
    hResponses
      (candidateResponse := candidateResponse)
      (candidateForwardedGas := 0)
      (candidateAvailableGas := 0)
      (candidatePostCallGas := 0)
      (candidateStatus := OpenCallChildGasStatus.outOfGas)
      hMem
  rcases hResponse with hSafe | hOOG
  · have hCandidatePostRel :
        Assembly.GasAware.GasExecRel
          (EvmYul.EVM.State.incrPC
            (OpenGasAware.finishGasAwareCall gasCall candidateResponse))
          (EvmYul.EVM.State.incrPC (call.resume candidateResponse)) :=
      OpenGasAware.evmOpenCall?_gasChargedState_resume_gasExecRel_of_gasExecRel
        (full := full) (target := target) (op := op)
        hRel hCall hGasCall candidateResponse
    have hResume :
        call.resume referenceResponse = call.resume candidateResponse :=
      hSafe.evmOpenCall_resume_eq hCall
    have hReferencePostRel :
        Assembly.GasAware.GasExecRel
          (EvmYul.EVM.State.incrPC
            (OpenGasAware.finishGasAwareCall gasCall candidateResponse))
          (EvmYul.EVM.State.incrPC (call.resume referenceResponse)) := by
      simpa [hResume] using hCandidatePostRel
    exact hTail _ hReferencePostRel tailTrace candidateOutcome hTailTrace
  · exact hOOG.2

end OpenCallResponsesCommittedSafeEquivalent

/--
Directional response condition for comparing a low-gas candidate CALL with a
reference CALL response.

Either the candidate response is an ordinary continuing response and must agree
with the reference in all caller-visible committed pieces, or the candidate
child received all available forwarded gas and ran out of gas.  The second case
is intended to feed the whole-run outcome tracker; it does not by itself make
two caller continuations equivalent.
-/
def OpenCallResponseTracksReferenceOrAllGasOOG
    (referenceResponse candidateResponse : OpenExternal.CallResponse)
    (candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat)
    (candidateStatus : OpenCallChildGasStatus) : Prop :=
  OpenCallResponsesCommittedSafeEquivalent referenceResponse
      candidateResponse ∨
    OpenCallAllForwardedGasOutOfGas candidateForwardedGas
      candidateAvailableGas candidatePostCallGas candidateStatus
      candidateResponse

namespace OpenCallResponseTracksReferenceOrAllGasOOG

theorem of_committedSafe
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    (hSafe :
      OpenCallResponsesCommittedSafeEquivalent referenceResponse
        candidateResponse) :
    OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
      candidateResponse candidateForwardedGas candidateAvailableGas
      candidatePostCallGas candidateStatus :=
  Or.inl hSafe

theorem of_allForwardedGasOutOfGas
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    (hOOG :
      OpenCallAllForwardedGasOutOfGas candidateForwardedGas
        candidateAvailableGas candidatePostCallGas candidateStatus
        candidateResponse) :
    OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
      candidateResponse candidateForwardedGas candidateAvailableGas
      candidatePostCallGas candidateStatus :=
  Or.inr hOOG

theorem committedSafe_of_not_allForwardedGasOutOfGas
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hNotOOG :
      ¬ OpenCallAllForwardedGasOutOfGas candidateForwardedGas
        candidateAvailableGas candidatePostCallGas candidateStatus
        candidateResponse) :
    OpenCallResponsesCommittedSafeEquivalent referenceResponse
      candidateResponse := by
  rcases hTrack with hSafe | hOOG
  · exact hSafe
  · exact False.elim (hNotOOG hOOG)

theorem allForwardedGasOutOfGas_of_not_committedSafe
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hNotSafe :
      ¬ OpenCallResponsesCommittedSafeEquivalent referenceResponse
        candidateResponse) :
    OpenCallAllForwardedGasOutOfGas candidateForwardedGas
      candidateAvailableGas candidatePostCallGas candidateStatus
      candidateResponse := by
  rcases hTrack with hSafe | hOOG
  · exact False.elim (hNotSafe hSafe)
  · exact hOOG

theorem success_eq_or_allForwardedGasOutOfGas
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus) :
    referenceResponse.success = candidateResponse.success ∨
      OpenCallAllForwardedGasOutOfGas candidateForwardedGas
        candidateAvailableGas candidatePostCallGas candidateStatus
        candidateResponse := by
  rcases hTrack with hSafe | hOOG
  · exact Or.inl hSafe.success_eq
  · exact Or.inr hOOG

theorem allForwardedGasOutOfGas_of_success_ne
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hNe : referenceResponse.success ≠ candidateResponse.success) :
    OpenCallAllForwardedGasOutOfGas candidateForwardedGas
      candidateAvailableGas candidatePostCallGas candidateStatus
      candidateResponse := by
  exact
    allForwardedGasOutOfGas_of_not_committedSafe hTrack (by
      intro hSafe
      exact hNe hSafe.success_eq)

theorem allForwardedGasOutOfGas_of_reference_success_true_candidate_success_false
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hReference : referenceResponse.success = true)
    (hCandidate : candidateResponse.success = false) :
    OpenCallAllForwardedGasOutOfGas candidateForwardedGas
      candidateAvailableGas candidatePostCallGas candidateStatus
      candidateResponse := by
  exact
    allForwardedGasOutOfGas_of_success_ne hTrack (by
      intro hEq
      simp [hReference, hCandidate] at hEq)

theorem outcome_tracks_of_not_committedSafe_candidate_fails
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    {candidateOutcome :
      Except EVMException (EvmYul.EVM.ExecutionResult EVMState)}
    {referenceResult : EvmYul.EVM.ExecutionResult EVMState}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hNotSafe :
      ¬ OpenCallResponsesCommittedSafeEquivalent referenceResponse
        candidateResponse)
    (hFails : Assembly.GasAware.XRunOutcomeFails candidateOutcome) :
    OpenCallAllForwardedGasOutOfGas candidateForwardedGas
        candidateAvailableGas candidatePostCallGas candidateStatus
        candidateResponse ∧
      Assembly.GasAware.XRunOutcomeSafelyTracks candidateOutcome
        (.ok referenceResult) := by
  exact
    ⟨allForwardedGasOutOfGas_of_not_committedSafe hTrack hNotSafe,
      Assembly.GasAware.XRunOutcomeSafelyTracks.of_candidate_fails hFails⟩

theorem outcome_tracks_of_success_ne_candidate_fails
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    {candidateOutcome :
      Except EVMException (EvmYul.EVM.ExecutionResult EVMState)}
    {referenceResult : EvmYul.EVM.ExecutionResult EVMState}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hNe : referenceResponse.success ≠ candidateResponse.success)
    (hFails : Assembly.GasAware.XRunOutcomeFails candidateOutcome) :
    OpenCallAllForwardedGasOutOfGas candidateForwardedGas
        candidateAvailableGas candidatePostCallGas candidateStatus
        candidateResponse ∧
      Assembly.GasAware.XRunOutcomeSafelyTracks candidateOutcome
        (.ok referenceResult) := by
  exact
    outcome_tracks_of_not_committedSafe_candidate_fails hTrack
      (by
        intro hSafe
        exact hNe hSafe.success_eq)
      hFails

theorem outcome_tracks_of_reference_success_true_candidate_success_false
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    {candidateOutcome :
      Except EVMException (EvmYul.EVM.ExecutionResult EVMState)}
    {referenceResult : EvmYul.EVM.ExecutionResult EVMState}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hReference : referenceResponse.success = true)
    (hCandidate : candidateResponse.success = false)
    (hFails : Assembly.GasAware.XRunOutcomeFails candidateOutcome) :
    OpenCallAllForwardedGasOutOfGas candidateForwardedGas
        candidateAvailableGas candidatePostCallGas candidateStatus
        candidateResponse ∧
      Assembly.GasAware.XRunOutcomeSafelyTracks candidateOutcome
        (.ok referenceResult) := by
  exact
    ⟨allForwardedGasOutOfGas_of_reference_success_true_candidate_success_false
        hTrack hReference hCandidate,
      Assembly.GasAware.XRunOutcomeSafelyTracks.of_candidate_fails hFails⟩

theorem committedSafe_or_allForwardedGasOutOfGas_tracks
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    {candidateOutcome :
      Except EVMException (EvmYul.EVM.ExecutionResult EVMState)}
    {referenceResult : EvmYul.EVM.ExecutionResult EVMState}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hOutcomeTracks :
      ¬ OpenCallResponsesCommittedSafeEquivalent referenceResponse
          candidateResponse →
        Assembly.GasAware.XRunOutcomeSafelyTracks candidateOutcome
          (.ok referenceResult)) :
    OpenCallResponsesCommittedSafeEquivalent referenceResponse
        candidateResponse ∨
      OpenCallAllForwardedGasOutOfGas candidateForwardedGas
          candidateAvailableGas candidatePostCallGas candidateStatus
          candidateResponse ∧
        Assembly.GasAware.XRunOutcomeSafelyTracks candidateOutcome
          (.ok referenceResult) := by
  by_cases hSafe :
      OpenCallResponsesCommittedSafeEquivalent referenceResponse
        candidateResponse
  · exact Or.inl hSafe
  · exact
      Or.inr
        ⟨allForwardedGasOutOfGas_of_not_committedSafe hTrack hSafe,
          hOutcomeTracks hSafe⟩

theorem committedSafe_or_allForwardedGasOutOfGas_candidateFails
    {referenceResponse candidateResponse : OpenExternal.CallResponse}
    {candidateForwardedGas candidateAvailableGas candidatePostCallGas : Nat}
    {candidateStatus : OpenCallChildGasStatus}
    {candidateOutcome :
      Except EVMException (EvmYul.EVM.ExecutionResult EVMState)}
    (hTrack :
      OpenCallResponseTracksReferenceOrAllGasOOG referenceResponse
        candidateResponse candidateForwardedGas candidateAvailableGas
        candidatePostCallGas candidateStatus)
    (hFails :
      ¬ OpenCallResponsesCommittedSafeEquivalent referenceResponse
          candidateResponse →
        Assembly.GasAware.XRunOutcomeFails candidateOutcome) :
    OpenCallResponsesCommittedSafeEquivalent referenceResponse
        candidateResponse ∨
      OpenCallAllForwardedGasOutOfGas candidateForwardedGas
          candidateAvailableGas candidatePostCallGas candidateStatus
          candidateResponse ∧
        Assembly.GasAware.XRunOutcomeFails candidateOutcome := by
  by_cases hSafe :
      OpenCallResponsesCommittedSafeEquivalent referenceResponse
        candidateResponse
  · exact Or.inl hSafe
  · exact
      Or.inr
        ⟨allForwardedGasOutOfGas_of_not_committedSafe hTrack hSafe,
          hFails hSafe⟩

end OpenCallResponseTracksReferenceOrAllGasOOG

/--
Persistent-storage image relation lifted through optional account maps.

`none` is reserved for source states that are not valid full-program
commit observations. Public CALL-route storage theorems only produce this
relation from accepted traces, where the invalid cases are unreachable.
-/
def OptionalStorageImageRel {τ₁ τ₂ : EvmYul.OperationType}
    (source : Option (EvmYul.AccountMap τ₁))
    (target : Option (EvmYul.AccountMap τ₂)) : Prop :=
  ∀ address,
    source.bind (fun accounts => Reference.AccountStorage? accounts address) =
      target.bind (fun accounts => Reference.AccountStorage? accounts address)

def SourceOpenCommittedAccountMap?
    (initialShared : EvmYul.SharedState .Yul)
    (sourceResult : Except Reference.Exception Reference.State) :
    Option (EvmYul.AccountMap .Yul) :=
  match sourceResult with
  | .ok (.Ok shared _store) =>
      some shared.toState.accountMap
  | .error (.YulHalt (.Ok shared _store) _value) =>
      some shared.toState.accountMap
  | .error (.Revert _stateBeforeRevert) =>
      some initialShared.toState.accountMap
  | _ =>
      none

def TargetCommittedAccountMap?
    (initial : EVMState) (targetResult : Assembly.StepResult) :
    Option (EvmYul.AccountMap .EVM) :=
  match Assembly.GasAware.XTargetCommittedObservation targetResult with
  | .committed state _output =>
      some state.accountMap
  | .reverted _output =>
      some initial.toState.accountMap

def SourceOpenCommittedState?
    (initialShared : EvmYul.SharedState .Yul)
    (sourceResult : Except Reference.Exception Reference.State) :
    Option (EvmYul.State .Yul) :=
  match sourceResult with
  | .ok (.Ok shared _store) =>
      some shared.toState
  | .error (.YulHalt (.Ok shared _store) _value) =>
      some shared.toState
  | .error (.Revert _stateBeforeRevert) =>
      some initialShared.toState
  | _ =>
      none

def TargetCommittedState?
    (initial : EVMState) (targetResult : Assembly.StepResult) :
    Option (EvmYul.State .EVM) :=
  match Assembly.GasAware.XTargetCommittedObservation targetResult with
  | .committed state _output =>
      some state
  | .reverted _output =>
      some initial.toState

/--
Committed effects that are public for every terminal kind, including
`SELFDESTRUCT`.

Persistent storage is kept here because it is the existing all-outcome
guarantee.  Receipts and substate carry logs and non-gas transaction side
effects.  Gas counters, memory, stack, program counter, and return-buffer
internals are intentionally outside this relation.
-/
structure CommittedStateEffectsRel
    (source : EvmYul.State .Yul) (target : EvmYul.State .EVM) : Prop where
  storage :
    Reference.StorageImageRel source.accountMap target.accountMap
  transactionReceipts :
    source.transactionReceipts = target.transactionReceipts
  substate : source.substate = target.substate

/--
Committed non-gas state observation for non-`SELFDESTRUCT` public outcomes.

The account-map relation is kept as the primary semantic hook, and its public
images are exposed explicitly: persistent storage, transient storage, and
external code image.  Balance is stated as equality of the observable EVM
`BALANCE` query.
-/
structure CommittedStateObservationRel
    (cfg : Reference.StateRelConfig)
    (source : EvmYul.State .Yul) (target : EvmYul.State .EVM) : Prop where
  accountMap : cfg.accountMapRel source.accountMap target.accountMap
  storage :
    Reference.StorageImageRel source.accountMap target.accountMap
  transientStorage :
    Reference.TransientStorageImageRel source.accountMap target.accountMap
  externalCode :
    Reference.ExternalCodeImageRel source.accountMap target.accountMap
  balance :
    ∀ address : Word,
      (EvmYul.State.balance source address).2 =
        (EvmYul.State.balance target address).2
  transactionReceipts :
    source.transactionReceipts = target.transactionReceipts
  substate : source.substate = target.substate

namespace CommittedStateEffectsRel

theorem of_sharedStateRel
    {cfg : Reference.StateRelConfig}
    {sourceShared : EvmYul.SharedState .Yul}
    {targetShared : EvmYul.SharedState .EVM}
    (hShared : Reference.SharedStateRel cfg sourceShared targetShared) :
    CommittedStateEffectsRel sourceShared.toState targetShared.toState where
  storage := Reference.SharedStateRel.storageImageRel hShared
  transactionReceipts := hShared.chain.transactionReceipts
  substate := hShared.chain.substate

theorem of_target_state_eq
    {source : EvmYul.State .Yul}
    {target target' : EvmYul.State .EVM}
    (hRel : CommittedStateEffectsRel source target)
    (hEq : target = target') :
    CommittedStateEffectsRel source target' := by
  cases hEq
  exact hRel

end CommittedStateEffectsRel

namespace CommittedStateObservationRel

theorem of_sharedStateRel
    {cfg : Reference.StateRelConfig}
    {sourceShared : EvmYul.SharedState .Yul}
    {targetShared : EvmYul.SharedState .EVM}
    (hShared : Reference.SharedStateRel cfg sourceShared targetShared) :
    CommittedStateObservationRel cfg sourceShared.toState
      targetShared.toState where
  accountMap := hShared.chain.accountMap
  storage := Reference.SharedStateRel.storageImageRel hShared
  transientStorage :=
    Reference.SharedStateRel.transientStorageImageRel hShared
  externalCode := Reference.SharedStateRel.externalCodeImageRel hShared
  balance := fun _address => Reference.StateRelConfig.balanceRel cfg
  transactionReceipts := hShared.chain.transactionReceipts
  substate := hShared.chain.substate

theorem effects
    {cfg : Reference.StateRelConfig}
    {source : EvmYul.State .Yul} {target : EvmYul.State .EVM}
    (hRel : CommittedStateObservationRel cfg source target) :
    CommittedStateEffectsRel source target where
  storage := hRel.storage
  transactionReceipts := hRel.transactionReceipts
  substate := hRel.substate

theorem of_target_state_eq
    {cfg : Reference.StateRelConfig}
    {source : EvmYul.State .Yul}
    {target target' : EvmYul.State .EVM}
    (hRel : CommittedStateObservationRel cfg source target)
    (hEq : target = target') :
    CommittedStateObservationRel cfg source target' := by
  cases hEq
  exact hRel

end CommittedStateObservationRel

/--
Committed full non-gas state observation for every committed/reverted public
outcome, including `SELFDESTRUCT`.
-/
def SourceOpenTargetCommittedFullObservationRel
    (cfg : Reference.StateRelConfig)
    (initialShared : EvmYul.SharedState .Yul)
    (initial : EVMState)
    (sourceResult : Except Reference.Exception Reference.State)
    (targetResult : Assembly.StepResult) : Prop :=
  match SourceOpenCommittedState? initialShared sourceResult with
  | none => False
  | some sourceState =>
      match TargetCommittedState? initial targetResult with
      | none => False
      | some targetState =>
          CommittedStateObservationRel cfg sourceState targetState

abbrev TargetCommittedNonSelfdestructState? :=
  TargetCommittedState?

abbrev SourceOpenTargetCommittedNonSelfdestructObservationRel :=
  SourceOpenTargetCommittedFullObservationRel

def SourceOpenTargetCommittedEffectsRel
    (initialShared : EvmYul.SharedState .Yul)
    (initial : EVMState)
    (sourceResult : Except Reference.Exception Reference.State)
    (targetResult : Assembly.StepResult) : Prop :=
  match SourceOpenCommittedState? initialShared sourceResult,
      TargetCommittedState? initial targetResult with
  | some sourceState, some targetState =>
      CommittedStateEffectsRel sourceState targetState
  | _, _ => False

def SourceOpenTargetCommittedStorageImageRel
    (initialShared : EvmYul.SharedState .Yul)
    (initial : EVMState)
    (sourceResult : Except Reference.Exception Reference.State)
    (targetResult : Assembly.StepResult) : Prop :=
  OptionalStorageImageRel
    (SourceOpenCommittedAccountMap? initialShared sourceResult)
    (TargetCommittedAccountMap? initial targetResult)

def SourceOpenTargetCommittedObservationRel
    (cfg : Reference.StateRelConfig)
    (initialShared : EvmYul.SharedState .Yul)
    (initial : EVMState)
    (sourceResult : Except Reference.Exception Reference.State)
    (targetResult : Assembly.StepResult) : Prop :=
  SourceOpenTargetCommittedStorageImageRel initialShared initial sourceResult
      targetResult ∧
    SourceOpenTargetCommittedEffectsRel initialShared initial sourceResult
      targetResult ∧
    SourceOpenTargetCommittedFullObservationRel cfg initialShared
      initial sourceResult targetResult

namespace SourceOpenTargetCommittedFullObservationRel

theorem committedStateObservation
    {cfg : Reference.StateRelConfig}
    {initialShared : EvmYul.SharedState .Yul}
    {initial : EVMState}
    {sourceResult : Except Reference.Exception Reference.State}
    {targetResult : Assembly.StepResult}
    {sourceState : EvmYul.State .Yul}
    {targetState : EvmYul.State .EVM}
    (hRel :
      SourceOpenTargetCommittedFullObservationRel cfg initialShared initial
        sourceResult targetResult)
    (hSource :
      SourceOpenCommittedState? initialShared sourceResult = some sourceState)
    (hTarget :
      TargetCommittedState? initial targetResult = some targetState) :
    CommittedStateObservationRel cfg sourceState targetState := by
  unfold SourceOpenTargetCommittedFullObservationRel at hRel
  simp [hSource, hTarget] at hRel
  exact hRel

end SourceOpenTargetCommittedFullObservationRel

namespace SourceOpenTargetCommittedObservationRel

theorem storageImage
    {cfg : Reference.StateRelConfig}
    {initialShared : EvmYul.SharedState .Yul}
    {initial : EVMState}
    {sourceResult : Except Reference.Exception Reference.State}
    {targetResult : Assembly.StepResult}
    (hRel :
      SourceOpenTargetCommittedObservationRel cfg initialShared initial
        sourceResult targetResult) :
    SourceOpenTargetCommittedStorageImageRel initialShared initial sourceResult
      targetResult :=
  hRel.1

theorem effects
    {cfg : Reference.StateRelConfig}
    {initialShared : EvmYul.SharedState .Yul}
    {initial : EVMState}
    {sourceResult : Except Reference.Exception Reference.State}
    {targetResult : Assembly.StepResult}
    (hRel :
      SourceOpenTargetCommittedObservationRel cfg initialShared initial
        sourceResult targetResult) :
    SourceOpenTargetCommittedEffectsRel initialShared initial sourceResult
      targetResult :=
  hRel.2.1

theorem fullObservation
    {cfg : Reference.StateRelConfig}
    {initialShared : EvmYul.SharedState .Yul}
    {initial : EVMState}
    {sourceResult : Except Reference.Exception Reference.State}
    {targetResult : Assembly.StepResult}
    (hRel :
      SourceOpenTargetCommittedObservationRel cfg initialShared initial
        sourceResult targetResult) :
    SourceOpenTargetCommittedFullObservationRel cfg initialShared initial
      sourceResult targetResult :=
  hRel.2.2

theorem storage_eq
    {cfg : Reference.StateRelConfig}
    {initialShared : EvmYul.SharedState .Yul}
    {initial : EVMState}
    {sourceResult : Except Reference.Exception Reference.State}
    {targetResult : Assembly.StepResult}
    (hRel :
      SourceOpenTargetCommittedObservationRel cfg initialShared initial
        sourceResult targetResult)
    (address : EvmYul.AccountAddress) :
    (SourceOpenCommittedAccountMap? initialShared sourceResult).bind
        (fun accounts => Reference.AccountStorage? accounts address) =
      (TargetCommittedAccountMap? initial targetResult).bind
        (fun accounts => Reference.AccountStorage? accounts address) :=
  storageImage hRel address

theorem committedStateObservation
    {cfg : Reference.StateRelConfig}
    {initialShared : EvmYul.SharedState .Yul}
    {initial : EVMState}
    {sourceResult : Except Reference.Exception Reference.State}
    {targetResult : Assembly.StepResult}
    {sourceState : EvmYul.State .Yul}
    {targetState : EvmYul.State .EVM}
    (hRel :
      SourceOpenTargetCommittedObservationRel cfg initialShared initial
        sourceResult targetResult)
    (hSource :
      SourceOpenCommittedState? initialShared sourceResult = some sourceState)
    (hTarget :
      TargetCommittedState? initial targetResult = some targetState) :
    CommittedStateObservationRel cfg sourceState targetState :=
  SourceOpenTargetCommittedFullObservationRel.committedStateObservation
    (fullObservation hRel) hSource hTarget

theorem transientStorage_eq
    {cfg : Reference.StateRelConfig}
    {initialShared : EvmYul.SharedState .Yul}
    {initial : EVMState}
    {sourceResult : Except Reference.Exception Reference.State}
    {targetResult : Assembly.StepResult}
    {sourceState : EvmYul.State .Yul}
    {targetState : EvmYul.State .EVM}
    (hRel :
      SourceOpenTargetCommittedObservationRel cfg initialShared initial
        sourceResult targetResult)
    (hSource :
      SourceOpenCommittedState? initialShared sourceResult = some sourceState)
    (hTarget :
      TargetCommittedState? initial targetResult = some targetState)
    (address : EvmYul.AccountAddress) :
    Reference.AccountTransientStorage? sourceState.accountMap address =
      Reference.AccountTransientStorage? targetState.accountMap address :=
  (committedStateObservation hRel hSource hTarget).transientStorage address

theorem externalCode_eq
    {cfg : Reference.StateRelConfig}
    {initialShared : EvmYul.SharedState .Yul}
    {initial : EVMState}
    {sourceResult : Except Reference.Exception Reference.State}
    {targetResult : Assembly.StepResult}
    {sourceState : EvmYul.State .Yul}
    {targetState : EvmYul.State .EVM}
    (hRel :
      SourceOpenTargetCommittedObservationRel cfg initialShared initial
        sourceResult targetResult)
    (hSource :
      SourceOpenCommittedState? initialShared sourceResult = some sourceState)
    (hTarget :
      TargetCommittedState? initial targetResult = some targetState)
    (address : EvmYul.AccountAddress) :
    Reference.AccountCodeImage sourceState.accountMap address =
      Reference.AccountCodeImage targetState.accountMap address :=
  (committedStateObservation hRel hSource hTarget).externalCode address


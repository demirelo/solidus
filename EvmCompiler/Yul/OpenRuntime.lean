    exact hReadyFor (tailFuel := tailFuel)
  · rcases hCall with
      ⟨op, kind, call, hInstr, hKind, hCall, hNonGas, _hBudget⟩
    cases hInstr
    have hUses : Assembly.Instr.usesCallCreate (.prim op) = true := by
      cases op <;> cases kind <;>
        simp [Assembly.Instr.usesCallCreate, Assembly.PrimOp.isCallCreate,
          Assembly.PrimOp.toEVM, OpenExternal.CallKind.ofEVMOperation?]
          at hKind ⊢
    exact
      openXRunListRunningAllOutcomeTracksReady_current_emitted_prim_call_of_nonGas_strict_actual_post
        (program := program) (targetProgram := targetProgram)
        (tailFuel := tailFuel)
        (initial := state) (mid := mid)
        (referenceTrace := referenceTrace)
        (pc := pc) (op := op) (emitted := emitted)
        (before := before) (after := after)
        (kind := kind) (call := call) (reference := reference)
        hEncoding hSafety (hStateCode hAt) hAt hEmit hTargetBlock
        hRun hNonGas hKind hCall
        (fun {candidateTrace candidateOutcome} =>
          hStrict.running
            (candidateTrace := candidateTrace)
            (candidateOutcome := candidateOutcome)
            (referenceResult := reference)
            hAt hEmit hTargetBlock hRun hUses)

theorem haltedPathAllOutcomeTracksReady_of_current_emitted_no_call_cases
    {program : Assembly.Program} {targetProgram : Assembly.TargetProgram}

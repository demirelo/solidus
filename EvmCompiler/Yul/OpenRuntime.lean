                          candidateForwardedGas candidateAvailableGas
                          candidatePostCallGas candidateStatus
                          candidateResponse ∧
                        Assembly.GasAware.XRunOutcomeSafelyTracks
                          candidateOutcome (.ok referenceResult)) :=
  OpenXCallFamilyResponseStrictOrAllGasOOGResultTrackingTraceReadyFor.committedSafe_or_allForwardedGasOutOfGas_tracks
    hReady.responseStrictOrAllGasOOGResultTrackingReady hAt hEmit
    hTargetBlock hRun hUses


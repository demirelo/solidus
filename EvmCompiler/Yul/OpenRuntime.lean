        sourceResult) :
    OpenLowering.SourceOpenTraceResponsesSharedBridgeRel cfg trace := by
  intro event hMem sourceShared targetShared hShared
  cases hCreate : event.create? with
  | none =>
      have hAccepted := hTrace.responses event hMem
      have hRel :
          Reference.SourceBridgeFacts.RelationallyAdmissibleOpenResponse cfg
            event.response := by
        simpa [Reference.SourceBridgeFacts.SourceOpenTraceResponsesAdmissible,
          OpenExternal.OpenTrace.ResponsesSatisfy, hCreate] using hAccepted
      exact hRel.rel hShared
  | some createInfo =>
      have hResponseEq :
          event.response = OpenExternal.CallResponse.failureZero :=
        openResultResolves_create_event_response_failureZero hTrace.resolves
          hMem hCreate
      simpa [hResponseEq] using
        openExternalResponseRel_failureZero_of_sharedStateRel hShared


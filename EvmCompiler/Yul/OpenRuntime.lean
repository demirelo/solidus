theorem runningPathAllOutcomeTracksReady_of_current_emitted_response_strict_cases
    {program : Assembly.Program} {targetProgram : Assembly.TargetProgram}
    {reference : OpenGasAware.EVMResult}
    (hEncoding :
      Assembly.Bytecode.EncodingCorrect targetProgram
        (Assembly.Bytecode.encodeTarget targetProgram))
    (hSafety : Assembly.Bytecode.DecodeSafety targetProgram)
    (hStateCode :
      ∀ {state : EVMState} {pc : Nat} {instr : Assembly.Instr},
        Assembly.Program.instrAtPc program state.pc.toNat =
          some (pc, instr) →
        state.executionEnv.code =
          Assembly.Bytecode.encodeTarget targetProgram)
    (hChecks :
      OpenGasAware.OpenXBlockTraceRelReady.CurrentNoCallPathChecksReady
        program targetProgram)
    (hRunning :
      ∀ {state mid : EVMState}
        {currentTrace : OpenExternal.OpenTrace}
        {pc : Nat} {instr : Assembly.Instr}
        {emitted before after : List Assembly.LocatedTarget},
        Assembly.Program.instrAtPc program state.pc.toNat =
          some (pc, instr) →
        Assembly.emitInstr? program pc instr = some emitted →
        targetProgram.code = before ++ emitted ++ after →
        OpenExternal.OpenResultResolves
          (OpenAssembly.Target.openRunListResult
            (emitted.map Assembly.LocatedTarget.instr) state)
          currentTrace (.ok (.running mid)) →
        OpenXCurrentRunningInstrGasBudgetNonGasTraceReadyCase
          targetProgram state instr currentTrace)
    (hStrict :
      OpenXCallFamilyResponseStrictOrAllGasOOGResultTrackingTraceReadyFor
        program targetProgram) :
    OpenGasAware.OpenXBlockTraceRelReady.RunningPathAllOutcomeTracksReady
      program targetProgram reference := by
  intro state mid referenceTrace pc instr emitted before after tailFuel
    hAt hEmit hTargetBlock hRun
  rcases hRunning hAt hEmit hTargetBlock hRun with hNoCall | hCall
  · have hReadyFor :
        OpenGasAware.OpenXBlockTraceRelReady.RunListRunningAllOutcomeTracksReadyFor
          targetProgram state mid reference :=
      OpenGasAware.OpenXBlockTraceRelReady.runListRunningAllOutcomeTracksReadyFor_current_emitted_no_call_of_current_path_checks
        (program := program) (targetProgram := targetProgram)
        (initial := state) (mid := mid) (trace := referenceTrace)
        (pc := pc) (instr := instr) (emitted := emitted)
        (before := before) (after := after)
        (reference := reference)
        hEncoding hSafety (hStateCode hAt) hNoCall hAt hEmit
        hTargetBlock hRun
        (fun {full} hRel => by
          obtain ⟨_hTrace, hClosedRun⟩ :=
            OpenGasAware.OpenXBlockTraceRelReady.openRunListResult_emitInstr_no_call_inv
              hNoCall hEmit hRun
          exact hChecks hAt hEmit hTargetBlock hNoCall hClosedRun hRel)
    exact hReadyFor (tailFuel := tailFuel)
  · rcases hCall with
      ⟨op, kind, call, hInstr, hKind, hCall, hNonGas, _hBudget⟩
    cases hInstr
    have hUses : Assembly.Instr.usesCallCreate (.prim op) = true := by
      cases op <;> cases kind <;>
        simp [Assembly.Instr.usesCallCreate, Assembly.PrimOp.isCallCreate,
          Assembly.PrimOp.toEVM, OpenExternal.CallKind.ofEVMOperation?]
          at hKind ⊢
    exact
      openXRunListRunningAllOutcomeTracksReady_current_emitted_prim_call_of_nonGas_strict_actual_post
        (program := program) (targetProgram := targetProgram)
        (tailFuel := tailFuel)
        (initial := state) (mid := mid)
        (referenceTrace := referenceTrace)
        (pc := pc) (op := op) (emitted := emitted)
        (before := before) (after := after)
        (kind := kind) (call := call) (reference := reference)
        hEncoding hSafety (hStateCode hAt) hAt hEmit hTargetBlock
        hRun hNonGas hKind hCall
        (fun {candidateTrace candidateOutcome} =>
          hStrict.running
            (candidateTrace := candidateTrace)
            (candidateOutcome := candidateOutcome)
            (referenceResult := reference)
            hAt hEmit hTargetBlock hRun hUses)


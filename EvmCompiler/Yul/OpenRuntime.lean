    change
      Reference.SourceBridgeFacts.ControlFlow.ScopedStmts false false false
        [program.contract.dispatcher]
    exact And.intro hScopedDispatcher trivial
  have hContains :
      Reference.SourceBridgeFacts.StoreDomainContains []

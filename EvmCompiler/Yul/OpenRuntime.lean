    OpenExternal.ReentrantStateMutation.identity] using hShared.chain

private theorem openResultResolves_create_event_response_failureZero
    {ε α : Type} {source : OpenExternal.OpenResult ε α}
    {trace : OpenExternal.OpenTrace} {result : Except ε α}
    (hResolve : OpenExternal.OpenResultResolves source trace result) :
    ∀ {event : OpenExternal.OpenEvent}
      {createInfo : OpenExternal.CreateSite × OpenExternal.CreateResponse},
      event ∈ trace →
      event.create? = some createInfo →
      event.response = OpenExternal.CallResponse.failureZero := by
  induction hResolve with
  | done =>
      intro event createInfo hMem _hCreate
      cases hMem
  | @call call response trace result hTail ih =>
      intro event createInfo hMem hCreate
      rcases List.mem_cons.mp hMem with hHead | hTailMem
      · cases hHead
        simp [OpenExternal.OpenEvent.call] at hCreate
      · exact ih hTailMem hCreate
  | @create create response trace result hTail ih =>
      intro event createInfo hMem hCreate
      rcases List.mem_cons.mp hMem with hHead | hTailMem
      · cases hHead
        rfl
      · exact ih hTailMem hCreate


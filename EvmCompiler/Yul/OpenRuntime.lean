      target.code = before ++ emitted ++ after →
      OpenExternal.OpenResultResolves
        (OpenAssembly.Target.openRunListResult
          (emitted.map Assembly.LocatedTarget.instr) state)
        currentTrace (.ok (.running mid)) →
      OpenGasAware.OpenXBlockTraceRelReady.CurrentRunningInstrReadyCase
        target state instr))
    (hHaltedNoCall :
    (∀ {state : EVMState}
      {currentTrace : OpenExternal.OpenTrace} {halt : Assembly.Halt}

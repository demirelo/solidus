private theorem openExternalResponseRel_failureZero_of_sharedStateRel
    {cfg : Reference.StateRelConfig}
    {sourceShared : EvmYul.SharedState .Yul}
    {targetShared : EvmYul.SharedState .EVM}
    (hShared : Reference.SharedStateRel cfg sourceShared targetShared) :
    Reference.SharedStateRel.OpenExternalResponseRel cfg sourceShared
      targetShared OpenExternal.CallResponse.failureZero := by
  simpa [Reference.SharedStateRel.OpenExternalResponseRel,
    Reference.SharedStateRel.OpenExternalResponseRel,
    OpenExternal.CallResponse.failureZero,
    OpenExternal.ReentrantStateMutation.identity] using hShared.chain

private theorem openResultResolves_create_event_response_failureZero
    {ε α : Type} {source : OpenExternal.OpenResult ε α}
    {trace : OpenExternal.OpenTrace} {result : Except ε α}
    (hResolve : OpenExternal.OpenResultResolves source trace result) :
    ∀ {event : OpenExternal.OpenEvent}
      {createInfo : OpenExternal.CreateSite × OpenExternal.CreateResponse},
      event ∈ trace →
      event.create? = some createInfo →
      event.response = OpenExternal.CallResponse.failureZero := by
  induction hResolve with
  | done =>
      intro event createInfo hMem _hCreate
      cases hMem
  | @call call response trace result hTail ih =>
      intro event createInfo hMem hCreate
      rcases List.mem_cons.mp hMem with hHead | hTailMem
      · cases hHead
        simp [OpenExternal.OpenEvent.call] at hCreate
      · exact ih hTailMem hCreate
  | @create create response trace result hTail ih =>
      intro event createInfo hMem hCreate
      rcases List.mem_cons.mp hMem with hHead | hTailMem
      · cases hHead
        rfl
      · exact ih hTailMem hCreate

private theorem responsesSharedBridgeRel
    {cfg : Reference.StateRelConfig}
    {program : Program}
    {shared : EvmYul.SharedState .Yul}
    {sourceFuel : Nat}
    {trace : OpenExternal.OpenTrace}
    {sourceResult : Except Reference.Exception Reference.State}
    (hTrace :
      SourceOpenDispatcherTraceAccepted cfg program shared sourceFuel trace
        sourceResult) :
    OpenLowering.SourceOpenTraceResponsesSharedBridgeRel cfg trace := by
  intro event hMem sourceShared targetShared hShared
  cases hCreate : event.create? with
  | none =>
      have hAccepted := hTrace.responses event hMem
      have hRel :
          Reference.SourceBridgeFacts.RelationallyAdmissibleOpenResponse cfg
            event.response := by
        simpa [Reference.SourceBridgeFacts.SourceOpenTraceResponsesAdmissible,
          OpenExternal.OpenTrace.ResponsesSatisfy, hCreate] using hAccepted
      exact hRel.rel hShared
  | some createInfo =>
      have hResponseEq :
          event.response = OpenExternal.CallResponse.failureZero :=
        openResultResolves_create_event_response_failureZero hTrace.resolves
          hMem hCreate
      simpa [hResponseEq] using
        openExternalResponseRel_failureZero_of_sharedStateRel hShared

private theorem createResponsesSharedBridgeRel
    {cfg : Reference.StateRelConfig}
    {program : Program}
    {shared : EvmYul.SharedState .Yul}

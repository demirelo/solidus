theorem cast_trace
    {cfg : Reference.StateRelConfig}
    {program : Assembly.Program} {targetProgram : Assembly.TargetProgram}
    {targetFuel : Nat} {state : EVMState}
    {trace : OpenExternal.OpenTrace} {targetResult : Assembly.StepResult}
    {hTrace hTrace' :
      OpenAssembly.OpenBlockTraceResult program targetProgram targetFuel
        state trace targetResult}
    (hReady :
      OpenXCompiledOpenCurrentEmittedEvidenceFor (cfg := cfg) hTrace) :
    OpenXCompiledOpenCurrentEmittedEvidenceFor (cfg := cfg) hTrace' := by
  have hEq : hTrace = hTrace' := proof_irrel hTrace hTrace'
  subst hTrace'
  exact hReady

theorem of_source_trace_current_shared_bridge_ready_gas_cases
    {cfg : Reference.StateRelConfig}
    {program : Assembly.Program} {targetProgram : Assembly.TargetProgram}
    {targetFuel : Nat} {state : EVMState}
    {trace : OpenExternal.OpenTrace} {targetResult : Assembly.StepResult}
    (hAssemble : Assembly.assemble? program = some targetProgram)
    (hRunningGasReady :
      ∀ {state mid : EVMState}
        {currentTrace : OpenExternal.OpenTrace}
        {pc : Nat} {instr : Assembly.Instr}
        {emitted before after : List Assembly.LocatedTarget},
        Assembly.Program.instrAtPc program state.pc.toNat =
          some (pc, instr) →
        Assembly.emitInstr? program pc instr = some emitted →
        targetProgram.code = before ++ emitted ++ after →
        OpenExternal.OpenResultResolves
          (OpenAssembly.Target.openRunListResult
            (emitted.map Assembly.LocatedTarget.instr) state)
          currentTrace (.ok (.running mid)) →
        OpenXCurrentRunningInstrGasReadyCase targetProgram state instr)
    (hHaltedNoCall :
      ∀ {state : EVMState}
        {currentTrace : OpenExternal.OpenTrace} {halt : Assembly.Halt}
        {pc : Nat} {instr : Assembly.Instr}
        {emitted before after : List Assembly.LocatedTarget},
        Assembly.Program.instrAtPc program state.pc.toNat =
          some (pc, instr) →
        Assembly.emitInstr? program pc instr = some emitted →
        targetProgram.code = before ++ emitted ++ after →
        OpenExternal.OpenResultResolves
          (OpenAssembly.Target.openRunListResult
            (emitted.map Assembly.LocatedTarget.instr) state)
          currentTrace (.ok (.halted halt)) →
        Assembly.Instr.usesCallCreate instr = false)
    {hTrace :
      OpenAssembly.Source.OpenTraceResult program targetFuel state trace
        targetResult}
    (hReady :
      OpenLowering.SourceOpenTraceCurrentSharedBridgeReadyFor (cfg := cfg)
        hTrace) :
    OpenXCompiledOpenCurrentEmittedEvidenceFor (cfg := cfg)
      (OpenAssembly.Source.OpenTraceResult.to_openBlockTrace
        hAssemble hTrace) := by
  induction hReady with
  | done state =>
      exact cast_trace
        (OpenXCompiledOpenCurrentEmittedEvidenceFor.done
          (cfg := cfg) (targetProgram := targetProgram) state)
  | stepRunning hStep hCallBridgeRel _hRestReady ih =>
      rename_i fuel0 currentState midState headTrace0 tailTrace0
        result0 hRest
      rcases
          OpenAssembly.Source.openStepResult_resolves_target_current
            hAssemble hStep with

theorem of_response_gas_admissible_ready_for
    {program : Assembly.Program} {targetProgram : Assembly.TargetProgram}
    (hReady :
      OpenXCallFamilyResponseGasAdmissibleReadyFor program targetProgram) :
    OpenXCallFamilyResponseGasTraceAdmissibleReadyFor program
      targetProgram where
  running := by
    intro state mid currentTrace pc instr emitted before after
      hAt hEmit hTargetBlock hRun hUses
    rcases hReady.running hAt hEmit hTargetBlock hRun hUses with
      ⟨op, kind, call, hInstr, hKind, hCall, hBudget⟩
    refine ⟨op, kind, call, hInstr, hKind, hCall, ?_⟩
    intro response tailGasBound _hMem
    exact hBudget (response := response) (tailGasBound := tailGasBound)


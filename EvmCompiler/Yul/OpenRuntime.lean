theorem shared_state_rel_of_source_direct_frame
    {cfg : Reference.StateRelConfig}
    {layout directLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {tokens : List Word}
    {sourceShared : EvmYul.SharedState .Yul}
    {sourceStore : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    {direct : Locals.RunState}
    {state : EVMState}
    (hSourceRel :
      Reference.SourceBridgeFacts.SourceStateRel cfg layout
        (.Ok sourceShared sourceStore) compiler)
    (hDirectRel :
      Functions.SourceDirect.StateRel directLayout hiddenReturns compiler
        direct)
    (hFrameRel :
      Structured.Preservation.Frame.StateRel direct state tokens)
    (hGasRel :
      cfg.gasAvailableRel sourceShared.gasAvailable state.gasAvailable) :
    Reference.SharedStateRel cfg sourceShared state.toSharedState := by
  cases hSourceRel with
  | ok hShared _hVars =>
      have hDirectShared :
          direct.evm.toSharedState = compiler.shared :=
        hDirectRel.1.1
      rw [← hDirectShared] at hShared
      rcases hShared with ⟨hChain, hMachine⟩
      rcases hFrameRel with ⟨_hStack, hData⟩
      cases state
      cases direct
      simp [Structured.Preservation.eraseControl, Assembly.eraseGas]
        at hData hChain hMachine hGasRel ⊢
      rcases hData with
        ⟨hToState, hActiveWords, hMemory, hReturnData, hHReturn⟩
      constructor
      · rw [hToState]
        exact hChain
      · constructor
        · exact hGasRel
        · rw [hActiveWords]
          exact hMachine.activeWords
        · rw [hMemory]
          exact hMachine.memory
        · rw [hReturnData]
          exact hMachine.returnData
        · rw [hHReturn]
          exact hMachine.H_return


    tailGasBound ≤
      (EvmYul.EVM.State.incrPC
        (OpenGasAware.finishGasAwareCall gasCall response)).gasAvailable.toNat :=
  OpenGasAware.finishGasAwareCall_incrPC_tail_budget_of_no_overflow
    gasCall response hFacts.noOverflow hFacts.tailBudget

end OpenCallActualPostGasBudgetFacts


    {program : Assembly.Program} {targetProgram : Assembly.TargetProgram}
    {targetFuel : Nat} {state : EVMState}
    {trace : OpenExternal.OpenTrace} {targetResult : Assembly.StepResult}
    (hTrace :
      OpenAssembly.OpenBlockTraceResult program targetProgram targetFuel state
        trace targetResult)
    (hInitialCode :
      state.executionEnv.code =
        Assembly.Bytecode.encodeTarget targetProgram)
    (hResponses :
      Reference.SourceBridgeFacts.SourceOpenTraceResponsesAdmissible cfg
        trace)
    (hEncoding :
      Assembly.Bytecode.EncodingCorrect targetProgram
        (Assembly.Bytecode.encodeTarget targetProgram))
    (hSafety : Assembly.Bytecode.DecodeSafety targetProgram)
    (hChecks :
      OpenGasAware.OpenXBlockTraceRelReady.CurrentNoCallPathChecksReady
        program targetProgram)
    (hReady :
      ∀ {state mid : EVMState}
        {trace : OpenExternal.OpenTrace}
        {pc : Nat} {instr : Assembly.Instr}
        {emitted before after : List Assembly.LocatedTarget},
        Assembly.Program.instrAtPc program state.pc.toNat =
          some (pc, instr) →
        Assembly.emitInstr? program pc instr = some emitted →
        targetProgram.code = before ++ emitted ++ after →
        OpenExternal.OpenResultResolves
          (OpenAssembly.Target.openRunListResult
            (emitted.map Assembly.LocatedTarget.instr) state)
          trace (.ok (.running mid)) →
        OpenXCurrentRunningInstrResponseAdmissibleCase cfg targetProgram
          state instr)
    (hNoCall :
      ∀ {state : EVMState}
        {trace : OpenExternal.OpenTrace} {halt : Assembly.Halt}
        {pc : Nat} {instr : Assembly.Instr}
        {emitted before after : List Assembly.LocatedTarget},
        Assembly.Program.instrAtPc program state.pc.toNat =
          some (pc, instr) →
        Assembly.emitInstr? program pc instr = some emitted →
        targetProgram.code = before ++ emitted ++ after →
        OpenExternal.OpenResultResolves
          (OpenAssembly.Target.openRunListResult
            (emitted.map Assembly.LocatedTarget.instr) state)
          trace (.ok (.halted halt)) →
        Assembly.Instr.usesCallCreate instr = false) :
    OpenGasAware.OpenXBlockTraceRelReady.CurrentEmittedTraceReadyFor
      hTrace := by
  revert hInitialCode hResponses
  induction hTrace with
  | done state =>
      intro _hCode _hResponses
      exact
        OpenGasAware.OpenXBlockTraceRelReady.CurrentEmittedTraceReadyFor.done
          state
  | stepRunning hAt hEmit hTargetBlock hRun hRest ih =>
      rename_i fuel state mid currentTrace tailTrace result pc instr emitted
        before after
      intro hCode hResponses
      have hCurrentResponses :
          Reference.SourceBridgeFacts.SourceOpenTraceResponsesAdmissible cfg
            currentTrace :=
        OpenExternal.OpenTrace.left_of_append hResponses
      have hTailResponses :
          Reference.SourceBridgeFacts.SourceOpenTraceResponsesAdmissible cfg
            tailTrace :=
        OpenExternal.OpenTrace.right_of_append hResponses
      have hTraceReady :
          OpenGasAware.OpenXBlockTraceRelReady.CurrentRunningInstrTraceReadyCase
            targetProgram state instr currentTrace :=
        OpenXCurrentRunningInstrResponseAdmissibleCase.to_trace_ready_case
          hCurrentResponses (hReady hAt hEmit hTargetBlock hRun)
      obtain ⟨hRunReady, hCodeStable⟩ :=
        OpenGasAware.OpenXBlockTraceRelReady.runListRunningReadyFor_current_emitted_of_trace_ready_case_current_path_checks
          (program := program) (targetProgram := targetProgram)
          (initial := state) (mid := mid) (trace := currentTrace)
          (pc := pc) (instr := instr) (emitted := emitted)
          (before := before) (after := after)
          hEncoding hSafety hCode hAt hEmit hTargetBlock hRun
          (fun hNoInstr {full} hRel => by
            obtain ⟨_hTrace, hClosedRun⟩ :=
              OpenGasAware.OpenXBlockTraceRelReady.openRunListResult_emitInstr_no_call_inv
                hNoInstr hEmit hRun
            exact hChecks hAt hEmit hTargetBlock hNoInstr hClosedRun hRel)
          hTraceReady
      have hMidCode :
          mid.executionEnv.code =
            Assembly.Bytecode.encodeTarget targetProgram := by
        rw [hCodeStable]
        exact hCode
      exact
        OpenGasAware.OpenXBlockTraceRelReady.CurrentEmittedTraceReadyFor.stepRunning
          hAt hEmit hTargetBlock hRun hRunReady hCodeStable
          (ih hMidCode hTailResponses)
  | stepHalted hAt hEmit hTargetBlock hRun =>
      rename_i fuel state currentTrace halt pc instr emitted before after
      intro hCode _hResponses
      exact
        OpenGasAware.OpenXBlockTraceRelReady.CurrentEmittedTraceReadyFor.stepHalted
          (fuel := fuel) hAt hEmit hTargetBlock hRun
          (OpenGasAware.OpenXBlockTraceRelReady.runListHaltedReadyFor_current_emitted_of_no_call_case
            (program := program) (targetProgram := targetProgram)
            (initial := state) (trace := currentTrace) (halt := halt)
            (pc := pc) (instr := instr) (emitted := emitted)
            (before := before) (after := after)
            hEncoding hSafety hCode
            (hNoCall hAt hEmit hTargetBlock hRun)
            hAt hEmit hTargetBlock hRun hChecks)

private theorem currentEmittedTraceReadyFor_of_openBlockTrace_current_emitted_response_admissible_trace_residual_cases_of_initial_code
    {cfg : Reference.StateRelConfig}
    {program : Assembly.Program} {targetProgram : Assembly.TargetProgram}
    {targetFuel : Nat} {state : EVMState}
    {trace : OpenExternal.OpenTrace} {targetResult : Assembly.StepResult}
    (hTrace :
      OpenAssembly.OpenBlockTraceResult program targetProgram targetFuel state
        trace targetResult)
    (hAssemble : Assembly.assemble? program = some targetProgram)
    (hJumpdest : Assembly.Bytecode.JumpdestCorrect targetProgram)
    (hInitialCode :
      state.executionEnv.code =
        Assembly.Bytecode.encodeTarget targetProgram)
    (hResponses :
      Reference.SourceBridgeFacts.SourceOpenTraceResponsesAdmissible cfg
        trace)
    (hEncoding :
      Assembly.Bytecode.EncodingCorrect targetProgram
        (Assembly.Bytecode.encodeTarget targetProgram))
    (hSafety : Assembly.Bytecode.DecodeSafety targetProgram)
    (hCurrentNoCallPathChecks :
      CurrentNoCallPathChecksOfResidualReady program targetProgram)
    (hResidualReady :
      OpenGasAware.OpenXBlockTraceRelReady.CurrentNoCallInstrCoreResidualTraceReadyFor
        targetProgram hTrace)
    (hReady :
      ∀ {state mid : EVMState}
        {trace : OpenExternal.OpenTrace}
        {pc : Nat} {instr : Assembly.Instr}
        {emitted before after : List Assembly.LocatedTarget},
        Assembly.Program.instrAtPc program state.pc.toNat =
          some (pc, instr) →
        Assembly.emitInstr? program pc instr = some emitted →
        targetProgram.code = before ++ emitted ++ after →
        OpenExternal.OpenResultResolves
          (OpenAssembly.Target.openRunListResult
            (emitted.map Assembly.LocatedTarget.instr) state)
          trace (.ok (.running mid)) →
        OpenXCurrentRunningInstrResponseAdmissibleCase cfg targetProgram
          state instr) :
    OpenGasAware.OpenXBlockTraceRelReady.CurrentEmittedTraceReadyFor
      hTrace := by
  revert hInitialCode hResponses
  induction hResidualReady with
  | done state =>
      intro _hCode _hResponses
      exact
        OpenGasAware.OpenXBlockTraceRelReady.CurrentEmittedTraceReadyFor.done
          state
  | stepRunning hAt hEmit hTargetBlock hRun hResidual _hRestReady ih =>
      rename_i fuel0 state0 mid0 currentTrace tailTrace result0 pc instr
        emitted before after hRest
      intro hCode hResponses
      have hCurrentResponses :=
        OpenExternal.OpenTrace.left_of_append hResponses
      have hTailResponses :=
        OpenExternal.OpenTrace.right_of_append hResponses
      have hTraceReady :=
        OpenXCurrentRunningInstrResponseAdmissibleCase.to_trace_ready_case
          hCurrentResponses (hReady hAt hEmit hTargetBlock hRun)
      have hCurrentChecks :
          Assembly.Instr.usesCallCreate instr = false →
            ∀ {full : EVMState},
              Assembly.GasAware.GasExecRel full state0 →
                Assembly.GasAware.XStepTrace.XRunListPathChecksReady
                  (Assembly.GasAware.validJumps targetProgram)
                  (emitted.map Assembly.LocatedTarget.instr) state0 full
                  (.running mid0) := by
        intro hNoInstr full hRel
        obtain ⟨_hTrace, hClosedRun⟩ :=
          OpenGasAware.OpenXBlockTraceRelReady.openRunListResult_emitInstr_no_call_inv
            hNoInstr hEmit hRun
        exact
          hCurrentNoCallPathChecks hAt hEmit hTargetBlock hNoInstr
            hClosedRun hRel (hResidual hNoInstr)
      obtain ⟨hRunReady, hCodeStable⟩ :=
        OpenGasAware.OpenXBlockTraceRelReady.runListRunningReadyFor_current_emitted_of_trace_ready_case_current_path_checks
          (program := program) (targetProgram := targetProgram)
          hEncoding hSafety hCode hAt hEmit hTargetBlock hRun
          hCurrentChecks hTraceReady
      have hMidCode :
          mid0.executionEnv.code =
            Assembly.Bytecode.encodeTarget targetProgram := by
        rw [hCodeStable]
        exact hCode
      exact
        OpenGasAware.OpenXBlockTraceRelReady.CurrentEmittedTraceReadyFor.stepRunning
          hAt hEmit hTargetBlock hRun hRunReady hCodeStable
          (ih hMidCode hTailResponses)
  | stepHalted hAt hEmit hTargetBlock hRun hResidual =>
      rename_i targetFuel0 fuel0 state0 currentTrace halt pc instr emitted
        before after
      intro hCode _hResponses
      have hNoCall :
          _ :=
        EvmCompiler.Yul.OpenAssembly.Target.openRunListResult_emitInstr_halted_no_callCreate
          hEmit hRun
      have hCurrentChecks :
          ∀ {full : EVMState},
            Assembly.GasAware.GasExecRel full state0 →
              Assembly.GasAware.XStepTrace.XRunListPathChecksReady
                (Assembly.GasAware.validJumps targetProgram)
                (emitted.map Assembly.LocatedTarget.instr) state0 full
                (.halted halt) := by
        intro full hRel
        obtain ⟨_hTrace, hClosedRun⟩ :=
          OpenGasAware.OpenXBlockTraceRelReady.openRunListResult_emitInstr_no_call_inv
            hNoCall hEmit hRun
        exact
          hCurrentNoCallPathChecks hAt hEmit hTargetBlock hNoCall
            hClosedRun hRel (hResidual hNoCall)
      exact
        OpenGasAware.OpenXBlockTraceRelReady.CurrentEmittedTraceReadyFor.stepHalted
          (fuel := fuel0) hAt hEmit hTargetBlock hRun
          (OpenGasAware.OpenXBlockTraceRelReady.runListHaltedReadyFor_current_emitted_no_call_of_current_path_checks_and_budget
            (program := program) (targetProgram := targetProgram)
            hEncoding hSafety hCode hNoCall hAt hEmit hTargetBlock hRun
            hCurrentChecks)


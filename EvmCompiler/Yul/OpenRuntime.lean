theorem callKind_inputArity_le_stack_length_of_evmOpenCall?
    {state : EVMState} {kind : OpenExternal.CallKind}
    {call : OpenExternal.OpenCall EVMState}
    (hCall :
      OpenExternal.CallKind.evmOpenCall? state kind = some call) :
    kind.inputArity ≤ state.stack.length := by
  unfold OpenExternal.CallKind.evmOpenCall?
    OpenExternal.CallKind.evmCallSite? at hCall
  cases kind with
  | call =>
      simp [OpenExternal.CallKind.evmOperands?,
        OpenExternal.CallKind.inputArity] at hCall ⊢
      cases hPop : state.stack.pop7 with
      | none =>
          simp [hPop] at hCall
      | some popped =>
          rcases popped with
            ⟨rest, gas, address, value, inOffset, inSize, outOffset,
              outSize⟩
          have hLen :=
            OpenAssemblyStackBounds.length_of_pop7_some hPop
          omega
  | callcode =>
      simp [OpenExternal.CallKind.evmOperands?,
        OpenExternal.CallKind.inputArity] at hCall ⊢
      cases hPop : state.stack.pop7 with
      | none =>
          simp [hPop] at hCall
      | some popped =>
          rcases popped with
            ⟨rest, gas, address, value, inOffset, inSize, outOffset,
              outSize⟩
          have hLen :=
            OpenAssemblyStackBounds.length_of_pop7_some hPop
          omega
  | delegatecall =>
      simp [OpenExternal.CallKind.evmOperands?,
        OpenExternal.CallKind.inputArity] at hCall ⊢
      cases hPop : state.stack.pop6 with
      | none =>
          simp [hPop] at hCall
      | some popped =>
          rcases popped with
            ⟨rest, gas, address, inOffset, inSize, outOffset, outSize⟩
          have hLen :=
            Assembly.PrimStep.Stack.length_of_pop6_some hPop
          omega
  | staticcall =>
      simp [OpenExternal.CallKind.evmOperands?,
        OpenExternal.CallKind.inputArity] at hCall ⊢
      cases hPop : state.stack.pop6 with
      | none =>
          simp [hPop] at hCall
      | some popped =>
          rcases popped with
            ⟨rest, gas, address, inOffset, inSize, outOffset, outSize⟩
          have hLen :=
            Assembly.PrimStep.Stack.length_of_pop6_some hPop
          omega

theorem xNonGasChecksPass_of_call_kind_residual
    {targetProgram : Assembly.TargetProgram}
    {state full : EVMState} {op : Assembly.PrimOp}
    {kind : OpenExternal.CallKind}
    {call : OpenExternal.OpenCall EVMState}
    (hRel : Assembly.GasAware.GasExecRel full state)
    (hKind :
      OpenExternal.CallKind.ofEVMOperation? op.toEVM = some kind)
    (hCall :
      OpenExternal.CallKind.evmOpenCall? state kind = some call)
    (hResidual :
      Assembly.GasAware.XStepTrace.InstrCoreResidualInputsReady targetProgram
        (.prim op) state) :
    Assembly.GasAware.XNonGasChecksPass
      (Assembly.GasAware.validJumps targetProgram) full op.toEVM := by
  have hResidualFull :
      Assembly.GasAware.XStepTrace.InstrCoreResidualInputsReady targetProgram
        (.prim op) full := by
    rw [hRel]
    exact hResidual
  have hOverflow :
      full.stack.length - (EvmYul.EVM.δ op.toEVM).getD 0 +
          (EvmYul.EVM.α op.toEVM).getD 0 ≤ 1024 := by
    simpa [Assembly.GasAware.XStepTrace.InstrCoreResidualInputsReady,
      Assembly.GasAware.XStepTrace.InstrPrimitiveOverflowInputsReady,
      Assembly.TargetInstr.op] using hResidualFull.1
  have hStatic :
      full.executionEnv.perm = false →
        ¬ Assembly.GasAware.staticWriteSensitive op.toEVM full.stack := by
    simpa [Assembly.GasAware.XStepTrace.InstrCoreResidualInputsReady,
      Assembly.GasAware.XStepTrace.InstrPrimitiveStaticInputsReady,
      Assembly.TargetInstr.op] using hResidualFull.2
  have hInputArity :
      kind.inputArity ≤ state.stack.length :=
    callKind_inputArity_le_stack_length_of_evmOpenCall? hCall
  have hOpEVM : op.toEVM = kind.toEVMOperation := by
    cases kind <;> cases op <;>
      simp [OpenExternal.CallKind.ofEVMOperation?,
        OpenExternal.CallKind.toEVMOperation, Assembly.PrimOp.toEVM]
        at hKind ⊢
  have hStack :
      full.stack.length ≥ (EvmYul.EVM.δ op.toEVM).getD 0 := by
    have hDeltaInput :
        (EvmYul.EVM.δ op.toEVM).getD 0 = kind.inputArity := by
      rw [hOpEVM]
      cases kind <;>
        simp [OpenExternal.CallKind.toEVMOperation,
          OpenExternal.CallKind.inputArity, EvmYul.EVM.δ]
    rw [hRel.stack_eq, hDeltaInput]
    exact hInputArity
  refine
    Assembly.GasAware.XNonGasChecksPass.intro'
      (validJumps := Assembly.GasAware.validJumps targetProgram)
      (state := full) (op := op.toEVM)
      ?_ hStack ?_ ?_ ?_ hOverflow hStatic ?_
  · rw [hOpEVM]
    cases kind <;>
      simp [OpenExternal.CallKind.toEVMOperation, EvmYul.EVM.δ]
  · intro hJump
    rw [hOpEVM] at hJump
    cases kind <;>
      simp [OpenExternal.CallKind.toEVMOperation] at hJump
  · intro hJumpi _hCond
    rw [hOpEVM] at hJumpi
    cases kind <;>
      simp [OpenExternal.CallKind.toEVMOperation] at hJumpi
  · intro hReturnDataCopy
    rw [hOpEVM] at hReturnDataCopy
    cases kind <;>
      simp [OpenExternal.CallKind.toEVMOperation] at hReturnDataCopy
  · intro hCreate
    rw [hOpEVM] at hCreate
    cases kind <;>
      simp [OpenExternal.CallKind.toEVMOperation,
        EvmYul.Operation.isCreate] at hCreate

theorem openXRunListRunningAllOutcomeTracksReady_current_emitted_call_of_residual_strict
    {program : Assembly.Program} {targetProgram : Assembly.TargetProgram}
    {tailFuel : Nat}
    {initial mid : EVMState}
    {referenceTrace : OpenExternal.OpenTrace}
    {pc : Nat} {instr : Assembly.Instr}
    {emitted before after : List Assembly.LocatedTarget}

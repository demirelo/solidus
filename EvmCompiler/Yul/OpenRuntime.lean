/--
CALL-route inferred stack-bound gate without the old no-`RETURNDATACOPY`
filter.

Successful compilation includes the regular-open CALL checker and the same
executable inferred assembly stack-bound checker.  Soundness theorems below
take explicit return-data-copy bounds replay evidence instead of rejecting
`RETURNDATACOPY` syntactically.
-/
noncomputable def
    compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpenAssemblyInferredBoundStackSafe?
    (program : Program) :
    Option (Functions.Program × Assembly.Program × Assembly.TargetProgram) :=
  match
      compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpen?
        program with
  | none => none
  | some (functionProgram, asm, target) =>
      match
          _root_.EvmCompiler.Yul.OpenAssemblyStackBounds.inferProgramBoundCheckResult?
            asm 17 1024 with
      | none => none
      | some _check => some (functionProgram, asm, target)

theorem
    compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpenAssemblyInferredBoundStackSafe?_eq_some
    {program : Program} {functionProgram : Functions.Program}
    {asm : Assembly.Program} {target : Assembly.TargetProgram}
    (hChecked :
      compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpenAssemblyInferredBoundStackSafe?
          program =
        some (functionProgram, asm, target)) :
    compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpen?
        program =
      some (functionProgram, asm, target) ∧
        ∃ check :
          _root_.EvmCompiler.Yul.OpenAssemblyStackBounds.ProgramBoundCheckResult
            asm 17 1024,
          _root_.EvmCompiler.Yul.OpenAssemblyStackBounds.inferProgramBoundCheckResult?
              asm 17 1024 =
            some check := by
  unfold
    compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpenAssemblyInferredBoundStackSafe?
      at hChecked
  cases hBase :
      compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpen?
        program with
  | none =>
      simp [hBase] at hChecked
  | some triple =>
      rcases triple with ⟨functionProgram', asm', target'⟩
      cases hBound :
          _root_.EvmCompiler.Yul.OpenAssemblyStackBounds.inferProgramBoundCheckResult?
            asm' 17 1024 with
      | none =>
          simp [hBase, hBound] at hChecked
      | some check =>
          simp [hBase, hBound] at hChecked
          rcases hChecked with ⟨rfl, rfl, rfl⟩
          exact ⟨rfl, check, hBound⟩


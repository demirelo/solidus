      lowerObj.toFunctions then
    let (asm, target) ←
      compileCheckedAssemblyTargetBytecodeResourcesCALLFamilyFeaturesSourceStatic?
        program
    some (lowerObj.toFunctions, asm, target)
  else
    none

noncomputable def compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpenNoReturnDataCopy?
    (program : Program) :
    Option (Functions.Program × Assembly.Program × Assembly.TargetProgram) :=
  match
      compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpen?
        program with
  | none => none
  | some (functionProgram, asm, target) =>
      if Reference.Safe.FeatureCoverage.returnDataCopyBoundaryProgram? program
      then
        if Assembly.GasAware.targetProgramNoReturnDataCopy? target
        then some (functionProgram, asm, target)
        else none
      else none


      OpenXCallFamilyResponseStrictOrAllGasOOGResultTrackingTraceReadyFor
        program targetProgram) :
    ∃ evmFuel,
      OpenGasAware.OpenXBlockTraceRelReady.OpenXRunListRunningAllOutcomeTracksReady
        targetProgram initial mid evmFuel tailFuel reference := by
  refine ⟨tailFuel + 1, ?_⟩
  intro full candidateTrace candidateOutcome hRel hTail hOutcome
  have hReady :
      OpenXCurrentRunningInstrCallResponseStrictOrAllGasOOGResultTrackingTraceReadyCase
        targetProgram initial instr referenceTrace candidateTrace
        candidateOutcome reference :=
    hStrictReady.running
      (candidateTrace := candidateTrace)
      (candidateOutcome := candidateOutcome)
      (referenceResult := reference)
      hAt hEmit hTargetBlock hRun hUses
  rcases hReady with
    ⟨op, kind, call, hInstr, hKind, hCall, hResponses⟩
  cases hInstr
  obtain ⟨referenceResponse, hReferenceTrace, hMid⟩ :=
    OpenGasAware.OpenXBlockTraceRelReady.openRunListResult_emitInstr_prim_call_running_inv
      hEmit hKind hCall hRun
  have hReferenceMem :
      OpenExternal.OpenEvent.call call.site referenceResponse ∈
        referenceTrace := by
    simpa [hReferenceTrace]
  have hCode :
      full.executionEnv.code =
        Assembly.Bytecode.encodeTarget targetProgram := by
    rw [Assembly.GasAware.GasExecRel.executionEnv_eq hRel]
    exact hInitialCode
  have hEmit' := hEmit
  simp [Assembly.emitInstr?] at hEmit'
  subst emitted
  have hDecode :
      EvmYul.EVM.decode full.executionEnv.code full.pc =
        some (op.toEVM, none) := by
    have hDecodeLocated :=
      Assembly.GasAware.decode_of_gasExecRel_instrAt_mem_emitted_of_safety
        (program := program) (target := targetProgram)
        (targetState := initial) (fullState := full)
        (pc := pc) (instr := Assembly.Instr.prim op)
        (located := { pc := pc, instr := Assembly.TargetInstr.prim op })
        (before := before)
        (emitted := [{ pc := pc, instr := Assembly.TargetInstr.prim op }])
        (after := after)
        hEncoding hSafety hAt hTargetBlock (by simp) (by rfl)
        hRel hCode
    simpa [Assembly.TargetInstr.op, Assembly.TargetInstr.arg] using
      hDecodeLocated
  have hTailReference :
      OpenGasAware.OpenXGasRelStateAllOutcomeTracesSafelyTrackResult
        (Assembly.GasAware.validJumps targetProgram) tailFuel
        (EvmYul.EVM.State.incrPC (call.resume referenceResponse))
        reference := by
    intro gasPost hRelPost
    exact hTail (by simpa [hMid] using hRelPost)
  exact
    OpenXCurrentRunningInstrCallResponseStrictOrAllGasOOGResultTrackingTraceReadyCase.openX_current_gasless_call_all_outcomes_safelyTracks_of_nonGas_actual_post
      (targetProgram := targetProgram)
      (fuel := tailFuel)
      (validJumps := Assembly.GasAware.validJumps targetProgram)
      (full := full) (target := initial) (op := op) (arg := none)
      (kind := kind) (call := call)
      (referenceTrace := referenceTrace)
      (candidateTrace := candidateTrace)
      (referenceResponse := referenceResponse)
      (candidateOutcome := candidateOutcome) (reference := reference)
      ⟨op, kind, call, rfl, hKind, hCall, hResponses⟩
      hReferenceMem hRel hDecode
      (xNonGasChecksPass_of_call_kind_residual hRel hKind hCall hResidual)

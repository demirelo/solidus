      target.code = before ++ emitted ++ after →
      OpenExternal.OpenResultResolves
        (OpenAssembly.Target.openRunListResult
          (emitted.map Assembly.LocatedTarget.instr) state)
        currentTrace (.ok (.halted halt)) →
      Assembly.Instr.usesCallCreate instr = false)) :
    OpenXReplayTraceReadinessForCheckedTrace asm target initial trace :=
  { finalCleanReady := by
      intro targetFuel finalState hTrace
      obtain ⟨hPc, hStack, hClean⟩ := hFinalFallthroughReady hTrace
      exact
        OpenGasAware.OpenXBlockTraceRelReady.finalCleanReady_of_openBlockTrace_running_fallthrough
          hTrace hInitialCode hRunningReady hPc hStack hClean
    traceReady := by
      intro targetFuel targetResult hTrace
      exact
        OpenGasAware.OpenXBlockTraceRelReady.traceReadyFor_of_openBlockTrace_current_emitted_ready_cases_of_initial_code
          hTrace hInitialCode hEncoding hSafety hNoCallPathChecks
          hRunningReady hHaltedNoCall }


/--
Trace-local, proof-facing form of the external CALL gas premise.

This does not impose a global cap on CALL operands. For each observed response
in the open trace and each continuation budget, it asks for a parent gas budget
under which the target CALL step is gas-checkable, the source/target response
gas facts agree, and the parent has enough post-CALL gas to continue without
UInt256 wrap. Semantically, this is where a budget-stable external environment
assumption belongs: child gas use may determine the response gas component for
the chosen trace, but the compiler does not synthesize a fixed cap.
-/
structure OpenXCallFamilyResponseGasTraceAdmissibleReadyFor
    (program : Assembly.Program) (targetProgram : Assembly.TargetProgram) :
    Prop where
  running :
    ∀ {state mid : EVMState}
      {currentTrace : OpenExternal.OpenTrace}
      {pc : Nat} {instr : Assembly.Instr}
      {emitted before after : List Assembly.LocatedTarget},
      Assembly.Program.instrAtPc program state.pc.toNat = some (pc, instr) →
      Assembly.emitInstr? program pc instr = some emitted →
      targetProgram.code = before ++ emitted ++ after →
      OpenExternal.OpenResultResolves
        (OpenAssembly.Target.openRunListResult
          (emitted.map Assembly.LocatedTarget.instr) state)
        currentTrace (.ok (.running mid)) →
      Assembly.Instr.usesCallCreate instr = true →
      OpenXCurrentRunningInstrCallResponseGasTraceAdmissibleReadyCase
        targetProgram state instr currentTrace


    (hTrace :
      SourceOpenDispatcherTraceAccepted cfg program shared sourceFuel trace
        sourceResult) :
    OpenLowering.SourceOpenTraceCreateResponsesSharedBridgeRel cfg trace :=
  by
    intro event hMem
    cases hCreate : event.create? with
    | none =>
        simp [hCreate]
    | some createInfo =>
        rcases createInfo with ⟨site, response⟩
        intro sourceShared targetShared hShared
        have hAccepted := hTrace.createResponses (event := event) hMem
        simp [OpenExternal.OpenTrace.CreateResponsesSatisfy, hCreate] at hAccepted
        exact hAccepted.rel hShared


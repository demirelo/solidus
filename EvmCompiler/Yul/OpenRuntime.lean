theorem functionsOpenProgram_runState_resolves_of_blockRunOpen
    {prim : Objects.Source.PrimitiveSemantics}
    {program : Functions.Program} {sourceFuel : Nat}
    {initial : Objects.Source.State}
    {trace : OpenExternal.OpenTrace}
    {sourceOutcome : Functions.Source.Outcome}
    {ctxAfter : Functions.Source.Ctx}
    (hBlock :
      OpenExternal.OpenResultResolves
        (Reference.SourceBridgeFacts.CompilerOpen.FunctionsOpen.Block.runOpen
          prim program Functions.Source.Ctx.initial sourceFuel

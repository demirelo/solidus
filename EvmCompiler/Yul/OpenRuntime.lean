theorem compileChecked_of_toObjects_compileChecked
    {program : Program} {lowerObj : Objects.Program}
    {asm : Assembly.Program}
    (hLower : program.toObjects? = some lowerObj)
    (hCompile : compileChecked? program = some asm) :
    Functions.Source.Program.compileChecked? lowerObj.toFunctions =
      some asm := by
  unfold compileChecked? Program.toExpressions? at hCompile
  simp [hLower, Objects.Program.toExpressions?,
    Functions.Inline.Program.toExpressions?,
    Functions.Source.Program.compileChecked?] at hCompile ⊢
  exact hCompile

theorem functionsCompileCheckedAssemblyTarget_of_compileCheckedAssemblyTarget_toObjects
    {program : Program} {lowerObj : Objects.Program}
    {asm : Assembly.Program} {target : Assembly.TargetProgram}
    (hLower : program.toObjects? = some lowerObj)
    (hCompileTarget :
      compileCheckedAssemblyTarget? program = some (asm, target)) :
    OpenLowering.FunctionsProgramCompileCheckedAssemblyTarget?
        lowerObj.toFunctions =
      some (asm, target) := by
  rcases compileCheckedAssemblyTarget?_eq_some hCompileTarget with
    ⟨hCompile, hAssemble⟩
  unfold OpenLowering.FunctionsProgramCompileCheckedAssemblyTarget?
  have hFunctionCompile :
      Functions.Source.Program.compileChecked? lowerObj.toFunctions =
        some asm :=
    compileChecked_of_toObjects_compileChecked hLower hCompile
  simp [hFunctionCompile, hAssemble]


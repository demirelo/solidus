    compileCheckedAssemblyTargetBytecodeResourcesCALLFamilyFeaturesSourceStaticRegularOpenAssemblyInferredBoundStackSafe?_regularOpen
      hChecked
  have hSourceStatic :
      compileCheckedAssemblyTargetBytecodeResourcesCALLFamilyFeaturesSourceStatic?

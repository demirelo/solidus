          hRun⟩
      have hBudgetReady :
          OpenXCurrentRunningInstrGasBudgetTraceReadyCase targetProgram
            currentState instr headTrace :=
        if hNoCall :
          Assembly.Instr.usesCallCreate instr = false then
          Or.inl hNoCall
        else
          have hUses :
              Assembly.Instr.usesCallCreate instr = true := by
            cases hUse : Assembly.Instr.usesCallCreate instr <;>
              simp [hUse] at hNoCall ⊢
          Or.inr
            (hCallGasBudgetReady.running hAt hEmit hTargetBlock hRun hUses)

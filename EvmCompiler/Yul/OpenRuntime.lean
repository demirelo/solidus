def OpenXCurrentRunningInstrCreateCommittedResponseSafetyTraceReadyCase
    (_targetProgram : Assembly.TargetProgram)
    (state : EVMState) (instr : Assembly.Instr)
    (trace : OpenExternal.OpenTrace) : Prop :=
  ∃ op : Assembly.PrimOp,
    ∃ kind : OpenExternal.CreateKind,
      ∃ create : OpenExternal.OpenCreate EVMState,
        instr = .prim op ∧
          OpenExternal.CallKind.ofEVMOperation? op.toEVM = none ∧
            OpenExternal.CreateKind.ofEVMOperation? op.toEVM = some kind ∧
              OpenExternal.CreateKind.evmOpenCreate? state kind =
                some create ∧
                (∀ {traceResponse altResponse :
                      OpenExternal.CreateResponse},
                  OpenExternal.OpenEvent.create create.site traceResponse ∈
                      trace →
                    OpenCreateResponsesCommittedSafeEquivalent traceResponse
                      altResponse)


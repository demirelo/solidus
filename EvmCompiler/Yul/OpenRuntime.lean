/-!
Checked imported-Yul entry points for the open external-call compiler route.

This file intentionally sits above both the recursive bridge/no-call runtime
stack and `Yul.OpenLowering`: it is the first place where an imported Yul
checked compile can also ask the lowered Functions program for the regular
open-CALL support check consumed by the Functions-level open theorem.
-/

namespace EvmCompiler
namespace Yul
namespace Program

noncomputable def compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStaticRegularOpen?
    (program : Program) :
    Option (Functions.Program × Assembly.Program × Assembly.TargetProgram) := do
  let lowerObj ← program.toObjects?
  if OpenLowering.FunctionsProgramRegularOpenSupported?
      lowerObj.toFunctions then
    let (asm, target) ←
      compileCheckedAssemblyTargetBytecodeResourcesCALLFeaturesSourceStatic?
        program
    some (lowerObj.toFunctions, asm, target)
  else
    none

noncomputable def compileCheckedAssemblyTargetBytecodeResourcesCALLFamilyFeaturesSourceStaticRegularOpen?
    (program : Program) :
    Option (Functions.Program × Assembly.Program × Assembly.TargetProgram) := do
  let lowerObj ← program.toObjects?

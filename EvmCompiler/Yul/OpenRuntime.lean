    (hKind :
      OpenExternal.CallKind.ofEVMOperation? op.toEVM = some kind)
    (hCall :
      OpenExternal.CallKind.evmOpenCall? state kind = some call)
    (hStepChecks :
      ∀ {gasBound : Nat} {full : EVMState},
        gasBound ≤ full.gasAvailable.toNat →
          Assembly.GasAware.GasExecRel full state →
            Assembly.GasAware.XStepChecksPass
              (Assembly.GasAware.validJumps targetProgram)
              full op.toEVM)
    (hSourceRel :
      Reference.SourceBridgeFacts.SourceStateRel cfg layout
        (.Ok sourceShared sourceStore) compiler)
    (hSharedEq : state.toSharedState = compiler.shared)
    (hPostBudget :
      ∀ {response : OpenExternal.CallResponse}
          {tailGasBound : Nat},
        ∃ gasBound : Nat,
          ∀ {full gasPost : EVMState},
            gasBound ≤ full.gasAvailable.toNat →
              Assembly.GasAware.GasExecRel full state →
                Assembly.GasAware.GasExecRel gasPost
                  (EvmYul.EVM.State.incrPC
                    (call.resume response)) →
                  tailGasBound ≤ gasPost.gasAvailable.toNat) :
    OpenXCurrentRunningInstrResponseAdmissibleCase cfg targetProgram
      state (.prim op) := by
  cases hSourceRel with
  | ok hShared _hVars =>
      exact
        call_of_shared_state_rel hKind hCall hStepChecks
          (by
            rw [hSharedEq]
            exact hShared)
          hPostBudget

theorem shared_state_rel_of_source_direct_frame
    {cfg : Reference.StateRelConfig}
    {layout directLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {tokens : List Word}
    {sourceShared : EvmYul.SharedState .Yul}
    {sourceStore : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    {direct : Locals.RunState}
    {state : EVMState}
    (hSourceRel :
      Reference.SourceBridgeFacts.SourceStateRel cfg layout
        (.Ok sourceShared sourceStore) compiler)
    (hDirectRel :
      Functions.SourceDirect.StateRel directLayout hiddenReturns compiler
        direct)
    (hFrameRel :
      Structured.Preservation.Frame.StateRel direct state tokens)
    (hGasRel :
      cfg.gasAvailableRel sourceShared.gasAvailable state.gasAvailable) :
    Reference.SharedStateRel cfg sourceShared state.toSharedState := by
  cases hSourceRel with
  | ok hShared _hVars =>
      have hDirectShared :
          direct.evm.toSharedState = compiler.shared :=
        hDirectRel.1.1
      rw [← hDirectShared] at hShared
      rcases hShared with ⟨hChain, hMachine⟩
      rcases hFrameRel with ⟨_hStack, hData⟩
      cases state
      cases direct
      simp [Structured.Preservation.eraseControl, Assembly.eraseGas]
        at hData hChain hMachine hGasRel ⊢
      rcases hData with
        ⟨hToState, hActiveWords, hMemory, hReturnData, hHReturn⟩
      constructor
      · rw [hToState]
        exact hChain
      · constructor
        · exact hGasRel
        · rw [hActiveWords]
          exact hMachine.activeWords
        · rw [hMemory]
          exact hMachine.memory
        · rw [hReturnData]
          exact hMachine.returnData
        · rw [hHReturn]
          exact hMachine.H_return

theorem call_of_source_state_rel_frame
    {cfg : Reference.StateRelConfig}
    {targetProgram : Assembly.TargetProgram}
    {layout directLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {tokens : List Word}
    {sourceShared : EvmYul.SharedState .Yul}
    {sourceStore : EvmYul.Yul.VarStore}
    {compiler : Objects.Source.State}
    {direct : Locals.RunState}
    {state : EVMState} {op : Assembly.PrimOp}
    {kind : OpenExternal.CallKind}
    {call : OpenExternal.OpenCall EVMState}
    (hKind :
      OpenExternal.CallKind.ofEVMOperation? op.toEVM = some kind)
    (hCall :
      OpenExternal.CallKind.evmOpenCall? state kind = some call)
    (hStepChecks :
      ∀ {gasBound : Nat} {full : EVMState},
        gasBound ≤ full.gasAvailable.toNat →
          Assembly.GasAware.GasExecRel full state →
            Assembly.GasAware.XStepChecksPass
              (Assembly.GasAware.validJumps targetProgram)
              full op.toEVM)
    (hSourceRel :
      Reference.SourceBridgeFacts.SourceStateRel cfg layout
        (.Ok sourceShared sourceStore) compiler)
    (hDirectRel :
      Functions.SourceDirect.StateRel directLayout hiddenReturns compiler
        direct)
    (hFrameRel :
      Structured.Preservation.Frame.StateRel direct state tokens)
    (hGasRel :
      cfg.gasAvailableRel sourceShared.gasAvailable state.gasAvailable)
    (hPostBudget :
      ∀ {response : OpenExternal.CallResponse}
          {tailGasBound : Nat},
        ∃ gasBound : Nat,
          ∀ {full gasPost : EVMState},
            gasBound ≤ full.gasAvailable.toNat →
              Assembly.GasAware.GasExecRel full state →
                Assembly.GasAware.GasExecRel gasPost
                  (EvmYul.EVM.State.incrPC
                    (call.resume response)) →
                  tailGasBound ≤ gasPost.gasAvailable.toNat) :
    OpenXCurrentRunningInstrResponseAdmissibleCase cfg targetProgram
      state (.prim op) := by
  have hShared :
      Reference.SharedStateRel cfg sourceShared state.toSharedState :=
    shared_state_rel_of_source_direct_frame hSourceRel hDirectRel hFrameRel
      hGasRel
  exact
    call_of_shared_state_rel hKind hCall hStepChecks hShared hPostBudget

theorem call_of_functions_block_compiled_open_result_rel
    {cfg : Reference.StateRelConfig}
    {targetProgram : Assembly.TargetProgram}
    {asm : Assembly.Program} {structuredCtx : Structured.CompileContext}
    {fallthroughPc : Word} {retc : Nat} {returns sourceLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}

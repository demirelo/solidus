        SourceDirectBridge.LiveLoopBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns loopLayout retc fuel sourceCtx
          targetCtx hiddenReturns body lowerBody source target) :
    SourceDirectBridge.LiveLoopStmtRunBridgeWithLayout prim sourceProgram
      targetProgram returns loopLayout retc fuel sourceCtx targetCtx
      hiddenReturns (.block body) { stmts := lowerStmt } source target := by
  cases hScoped :
      Source.Block.runScoped prim sourceProgram sourceCtx body fuel source with
  | error err =>
      simp [Source.Stmt.run, hScoped] at hSourceRun
  | ok scopedOutcome =>
      rcases SourceDirect.SourceRun.block_runScoped_open_exists hScoped with
        ⟨sourceOpen, sourceCtxOut, hSourceOpen⟩
      exact
        block_liveLoopStmtRunBridge_of_lower
          (prim := prim) (sourceProgram := sourceProgram)
          (targetProgram := targetProgram) (returns := returns)
          (loopLayout := loopLayout)
          (liveCtx := liveCtx) (after := after)
          (nextLayout := nextLayout) (retc := retc) (fuel := fuel)
          (sourceCtx := sourceCtx) (targetCtx := targetCtx)
          (hiddenReturns := hiddenReturns) (source := source)
          (target := target) (body := body) (lowerStmt := lowerStmt)
          hLower hCtx
          (fun {lowerBody bodyLayout} hLowerBody =>
            hBody
              (sourceOpenResult := (sourceOpen, sourceCtxOut))
              hLowerBody hSourceOpen)

def LiveAtomicStmt : Stmt → Prop
  | .expr _expr => True
  | .let_ _name _value => True
  | .assign _name _value => True
  | .brk => True
  | .cont => True
  | .leave => True
  | .terminal _kind => True
  | .terminalArgs _kind _args => True
  | .block _body => False
  | .if_ _cond _body => False
  | .switch _scrutinee _cases _defaultBody => False
  | .for_ _init _cond _post _body => False
  | .call _targets _functionName _args => False

namespace SourceScopeFacts

theorem block_scoped_stmts {env : List Name} {stmts : List Stmt}
    (hScoped : Scope.Block.Scoped env { stmts := stmts }) :
    Scope.StmtList.Scoped env stmts := by
  simpa [Scope.Block.Scoped] using hScoped

theorem stmtList_scoped_cons {env : List Name} {stmt : Stmt}
    {rest : List Stmt}
    (hScoped : Scope.StmtList.Scoped env (stmt :: rest)) :
    Scope.Stmt.Scoped env stmt ∧
      Scope.StmtList.Scoped (Scope.Stmt.outEnv env stmt) rest := by
  simpa [Scope.StmtList.Scoped] using hScoped

theorem block_scoped_cons {env : List Name} {stmt : Stmt}
    {rest : List Stmt}
    (hScoped : Scope.Block.Scoped env { stmts := stmt :: rest }) :
    Scope.Stmt.Scoped env stmt ∧
      Scope.Block.Scoped (Scope.Stmt.outEnv env stmt) { stmts := rest } := by
  rcases stmtList_scoped_cons (block_scoped_stmts hScoped) with
    ⟨hHead, hTail⟩
  exact ⟨hHead, by simpa [Scope.Block.Scoped] using hTail⟩

theorem stmt_scoped_block {env : List Name} {body : Block}
    (hScoped : Scope.Stmt.Scoped env (.block body)) :
    Scope.Block.Scoped env body := by
  simpa [Scope.Stmt.Scoped] using hScoped

theorem stmt_scoped_if_body {env : List Name} {cond : Expr 1} {body : Block}
    (hScoped : Scope.Stmt.Scoped env (.if_ cond body)) :
    Scope.Block.Scoped env body := by
  exact (by
    simpa [Scope.Stmt.Scoped] using hScoped :
      Scope.ExprScoped env cond ∧ Scope.Block.Scoped env body).2

theorem stmt_outEnv_nodup {env : List Name} {stmt : Stmt}
    (hScoped : Scope.Stmt.Scoped env stmt)
    (hNoDup : env.Nodup) :
    (Scope.Stmt.outEnv env stmt).Nodup := by
  cases stmt <;> simp [Scope.Stmt.outEnv, Scope.Stmt.Scoped] at hScoped ⊢
  · exact hNoDup
  · exact ⟨hScoped.1, hNoDup⟩
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup
  · exact hNoDup

theorem stmt_scoped_switch_parts {env : List Name} {scrutinee : Expr 1}
    {cases : List (Word × Block)} {defaultBody : Option Block}
    (hScoped : Scope.Stmt.Scoped env (.switch scrutinee cases defaultBody)) :
    Scope.ExprScoped env scrutinee ∧
      Scope.CaseList.Scoped env cases ∧
        Scope.Default.Scoped env defaultBody := by
  simpa [Scope.Stmt.Scoped] using hScoped

theorem stmt_scoped_switch_select_body {env : List Name} {scrutinee : Expr 1}
    {cases : List (Word × Block)} {defaultBody : Option Block}
    {value : Word} {body : Block}
    (hScoped : Scope.Stmt.Scoped env (.switch scrutinee cases defaultBody))
    (hSelect : Source.Switch.select value cases defaultBody = some body) :
    Scope.Block.Scoped env body := by
  rcases stmt_scoped_switch_parts hScoped with
    ⟨_hScrutinee, hCases, hDefault⟩
  exact SourceDirect.SourceScope.switch_select_block_scoped hCases hDefault
    hSelect

theorem stmt_scoped_for_parts {env : List Name}
    {init : Block} {cond : Expr 1} {post body : Block}
    (hScoped : Scope.Stmt.Scoped env (.for_ init cond post body)) :
    Scope.Block.Scoped env init ∧
      Scope.ExprScoped (Scope.Block.outEnv env init) cond ∧
        Scope.Block.Scoped (Scope.Block.outEnv env init) post ∧
          Scope.Block.Scoped (Scope.Block.outEnv env init) body := by
  simpa [Scope.Stmt.Scoped] using hScoped

theorem stmt_scoped_for_init {env : List Name}
    {init : Block} {cond : Expr 1} {post body : Block}
    (hScoped : Scope.Stmt.Scoped env (.for_ init cond post body)) :
    Scope.Block.Scoped env init :=
  (stmt_scoped_for_parts hScoped).1

theorem stmt_scoped_for_post {env : List Name}
    {init : Block} {cond : Expr 1} {post body : Block}
    (hScoped : Scope.Stmt.Scoped env (.for_ init cond post body)) :
    Scope.Block.Scoped (Scope.Block.outEnv env init) post :=
  (stmt_scoped_for_parts hScoped).2.2.1

theorem stmt_scoped_for_body {env : List Name}
    {init : Block} {cond : Expr 1} {post body : Block}
    (hScoped : Scope.Stmt.Scoped env (.for_ init cond post body)) :
    Scope.Block.Scoped (Scope.Block.outEnv env init) body :=
  (stmt_scoped_for_parts hScoped).2.2.2

end SourceScopeFacts

namespace RegularRunLiveBefore

mutual
theorem block_after_mem_of_regular_run
    {prim : Source.PrimitiveSemantics} {program : Program}
    {live : Ctx} {sourceCtx sourceCtxOut : Source.Ctx}
    {fuel : Nat} {block : Block} {source sourceOut : Source.State}
    {after : List Name} {name : Name}
    (hScoped : Scope.Block.Scoped sourceCtx.scope block)
    (hRun :
      Source.Block.runOpen prim program sourceCtx fuel block source =
        .ok (Source.Outcome.regular sourceOut, sourceCtxOut))
    (hScope : name ∈ sourceCtx.scope)
    (hAfter : name ∈ after) :
    name ∈ Block.liveBefore live after block := by
  cases block with
  | mk stmts =>
      exact
        stmtList_after_mem_of_regular_run
          (live := live) (stmts := stmts) hScoped hRun hScope hAfter

theorem stmt_after_mem_of_regular_run
    {prim : Source.PrimitiveSemantics} {program : Program}
    {live : Ctx} {sourceCtx sourceCtxOut : Source.Ctx}
    {fuel : Nat} {stmt : Stmt} {source sourceOut : Source.State}
    {after : List Name} {name : Name}
    (hScoped : Scope.Stmt.Scoped sourceCtx.scope stmt)
    (hRun :
      Source.Stmt.run prim program sourceCtx fuel stmt source =
        .ok (Source.Outcome.regular sourceOut, sourceCtxOut))
    (hScope : name ∈ sourceCtx.scope)
    (hAfter : name ∈ after) :
    name ∈ Stmt.liveBefore live after stmt := by
  cases stmt with
  | expr expr =>
      simp [Stmt.liveBefore, hAfter]
  | let_ declared value =>
      exact LiveBefore.let_after_of_scoped_scope hScoped hScope hAfter
  | assign assigned value =>
      simp [Stmt.liveBefore, hAfter]
  | block body =>
      cases hScopedRun :
          Source.Block.runScoped prim program sourceCtx body fuel source with
      | error err =>
          simp [Source.Stmt.run, hScopedRun] at hRun
      | ok scopedOutcome =>
          cases scopedOutcome with
          | mk scopedState scopedMode =>
              cases scopedMode
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.regular]
                  at hRun
                rcases Source.Block.runScoped_regular_eq_restrict hScopedRun with
                  ⟨inner, finalCtx, hOpen, _hRestrict⟩
                exact
                  block_after_mem_of_regular_run
                    (live := live) (block := body)
                    (sourceCtx := sourceCtx) hScoped hOpen hScope hAfter
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.regular,
                  Source.Outcome.brk] at hRun
                cases hRun.1
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.regular,
                  Source.Outcome.cont] at hRun
                cases hRun.1
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.regular,
                  Source.Outcome.leave] at hRun
                cases hRun.1
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.regular,
                  Source.Outcome.halt] at hRun
                cases hRun.1
  | if_ cond body =>
      simp [Stmt.liveBefore, hAfter]
  | switch scrutinee cases defaultBody =>
      simp [Stmt.liveBefore, hAfter]
  | for_ init cond post body =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hInit :
              Source.Block.runOpen prim program sourceCtx.withoutLoopControl
                fuel init source with
          | error err =>
              simp [Source.Stmt.run, hInit] at hRun
          | ok initResult =>
              rcases initResult with ⟨initOutcome, initCtx⟩
              cases initOutcome with
              | mk initState initMode =>
                  cases initMode
                  · simp [Source.Stmt.run, hInit, Source.Outcome.regular]
                      at hRun
                    cases hLoop :
                        Source.Stmt.runForLoop prim program initCtx cond
                          initCtx.withoutLoopControl post
                          (initCtx.withLoopControl initCtx.scope initCtx.scope)
                          body fuel initState with
                    | error err =>
                        simp [hLoop] at hRun
                    | ok loopOutcome =>
                        cases loopOutcome with
                        | mk loopState loopMode =>
                            cases loopMode
                            · simp [hLoop, Source.Outcome.regular] at hRun
                              have hInitRegular :
                                  Source.Block.runOpen prim program
                                      sourceCtx.withoutLoopControl fuel init
                                      source =
                                    .ok (Source.Outcome.regular initState,
                                      initCtx) := by
                                simpa [Source.Outcome.regular] using hInit
                              rcases SourceScopeFacts.stmt_scoped_for_parts
                                  hScoped with
                                ⟨hInitScoped, _hCondScoped, _hPostScoped,
                                  _hBodyScoped⟩
                              let loopMentioned :=
                                NameSet.unions
                                  [Reads.expr cond, Reads.block post,
                                    Reads.block body, after]
                              let postLive :=
                                Block.liveBefore live loopMentioned post
                              let bodyCtx := live.withLoop after postLive
                              let bodyLive :=
                                Block.liveBefore bodyCtx postLive body
                              let loopLive :=
                                NameSet.unions
                                  [Reads.expr cond, after, postLive, bodyLive]
                              have hLoopLive : name ∈ loopLive := by
                                simp [loopLive, hAfter]
                              have hScopeInit :
                                  name ∈ sourceCtx.withoutLoopControl.scope := by
                                simpa [Source.Ctx.withoutLoopControl]
                                  using hScope
                              simpa [Stmt.liveBefore, loopMentioned, postLive,
                                bodyCtx, bodyLive, loopLive] using
                                block_after_mem_of_regular_run
                                  (live := live) (block := init)
                                  (sourceCtx := sourceCtx.withoutLoopControl)
                                  hInitScoped hInitRegular hScopeInit hLoopLive
                            · simp [hLoop, Source.invalid,
                                Structured.invalid] at hRun
                            · simp [hLoop, Source.invalid,
                                Structured.invalid] at hRun
                            · simp [hLoop, Source.Outcome.regular,
                                Source.Outcome.leave] at hRun
                              cases hRun.1
                            · simp [hLoop, Source.Outcome.regular,
                                Source.Outcome.halt] at hRun
                              cases hRun.1
                  · simp [Source.Stmt.run, hInit, Source.invalid,
                      Structured.invalid] at hRun
                  · simp [Source.Stmt.run, hInit, Source.invalid,
                      Structured.invalid] at hRun
                  · simp [Source.Stmt.run, hInit, Source.Outcome.regular,
                      Source.Outcome.leave] at hRun
                    cases hRun.1
                  · simp [Source.Stmt.run, hInit, Source.Outcome.regular,
                      Source.Outcome.halt] at hRun
                    cases hRun.1
  | brk =>
      cases hBreak : sourceCtx.breakScope? with
      | none =>
          simp [Source.Stmt.run, hBreak, Source.invalid,
            Structured.invalid] at hRun
      | some breakScope =>
          simp [Source.Stmt.run, hBreak, Source.Outcome.regular,
            Source.Outcome.brk] at hRun
          cases hRun.1
  | cont =>
      cases hContinue : sourceCtx.continueScope? with
      | none =>
          simp [Source.Stmt.run, hContinue, Source.invalid,
            Structured.invalid] at hRun
      | some continueScope =>
          simp [Source.Stmt.run, hContinue, Source.Outcome.regular,
            Source.Outcome.cont] at hRun
          cases hRun.1
  | leave =>
      cases hLeave : sourceCtx.leaveScope? with
      | none =>
          simp [Source.Stmt.run, hLeave, Source.invalid,
            Structured.invalid] at hRun
      | some leaveScope =>
          simp [Source.Stmt.run, hLeave, Source.Outcome.regular,
            Source.Outcome.leave] at hRun
          cases hRun.1
  | call targets functionName args =>
      simp [Stmt.liveBefore, hAfter]
  | terminal kind =>
      cases hTerminal : prim.terminal kind source.shared [] with
      | error err =>
          simp [Source.Stmt.run, hTerminal] at hRun
      | ok shared =>
          simp [Source.Stmt.run, hTerminal, Source.Outcome.regular,
            Source.Outcome.halt] at hRun
          cases hRun.1
  | terminalArgs kind args =>
      cases hArgs : Locals.Source.Expr.ExprSeq.eval prim args source with
      | error err =>
          simp [Source.Stmt.run, hArgs] at hRun
      | ok argResult =>
          rcases argResult with ⟨sourceAfterArgs, values⟩
          cases hTerminal :
              prim.terminal kind sourceAfterArgs.shared values with
          | error err =>
              simp [Source.Stmt.run, hArgs, hTerminal] at hRun
          | ok shared =>
              simp [Source.Stmt.run, hArgs, hTerminal,
                Source.Outcome.regular, Source.Outcome.halt] at hRun
              cases hRun.1

theorem stmtList_after_mem_of_regular_run
    {prim : Source.PrimitiveSemantics} {program : Program}
    {live : Ctx} {sourceCtx sourceCtxOut : Source.Ctx}
    {fuel : Nat} {stmts : List Stmt} {source sourceOut : Source.State}
    {after : List Name} {name : Name}
    (hScoped : Scope.StmtList.Scoped sourceCtx.scope stmts)
    (hRun :
      Source.Block.runOpen prim program sourceCtx fuel { stmts := stmts }
          source =
        .ok (Source.Outcome.regular sourceOut, sourceCtxOut))
    (hScope : name ∈ sourceCtx.scope)
    (hAfter : name ∈ after) :
    name ∈ StmtList.liveBefore live after stmts := by
  cases stmts with
  | nil =>
      simpa [StmtList.liveBefore] using hAfter
  | cons stmt rest =>
      cases fuel with
      | zero =>
          simp [Source.Block.runOpen, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          rcases SourceDirect.Block.source_runOpen_cons_head
              (fuel := fuel) hRun with
            ⟨sourceHead, sourceCtxAfter, hHead, hTailIf, hNonregular⟩
          have hHeadMode : sourceHead.mode = .regular := by
            by_contra hNotRegular
            have hEq := hNonregular hNotRegular
            cases sourceHead with
            | mk sourceHeadState sourceHeadMode =>
                cases sourceHeadMode <;> simp at hNotRegular hEq
                all_goals cases hEq.1
          have hHeadRegular :
              Source.Stmt.run prim program sourceCtx fuel stmt source =
                .ok (Source.Outcome.regular sourceHead.state,
                  sourceCtxAfter) := by
            cases sourceHead with
            | mk sourceHeadState sourceHeadMode =>
                cases sourceHeadMode <;> simp at hHeadMode
                simpa [Source.Outcome.regular] using hHead
          have hTailRun :
              Source.Block.runOpen prim program sourceCtxAfter fuel
                  { stmts := rest } sourceHead.state =
                .ok (Source.Outcome.regular sourceOut, sourceCtxOut) := by
            simpa using hTailIf hHeadMode
          rcases SourceScopeFacts.stmtList_scoped_cons hScoped with
            ⟨hStmtScoped, hRestScopedBase⟩
          have hCtxAfterScope :
              sourceCtxAfter.scope =
                Scope.Stmt.outEnv sourceCtx.scope stmt :=
            SourceDirect.SourceRun.stmt_regular_scope hHeadRegular
          have hScopeAfter : name ∈ sourceCtxAfter.scope := by
            rw [hCtxAfterScope]
            exact SourceDirect.SourceScope.stmt_outEnv_contains_of_contains
              (stmt := stmt) hScope
          have hRestScoped :
              Scope.StmtList.Scoped sourceCtxAfter.scope rest := by
            simpa [hCtxAfterScope] using hRestScopedBase
          have hRestLive :
              name ∈ StmtList.liveBefore live after rest :=
            stmtList_after_mem_of_regular_run
              (live := live) (stmts := rest) hRestScoped hTailRun
              hScopeAfter hAfter
          exact
            stmt_after_mem_of_regular_run
              (live := live) (stmt := stmt) hStmtScoped hHeadRegular
              hScope hRestLive
end

end RegularRunLiveBefore

namespace HandlerRunLiveBefore

theorem block_runOpen_cons_brk_mode
    {prim : Source.PrimitiveSemantics} {program : Program}
    {sourceCtx : Source.Ctx} {fuel : Nat} {rest : List Stmt}
    {source : Source.State} {sourceResult : Source.Outcome × Source.Ctx}
    (hRun :
      Source.Block.runOpen prim program sourceCtx (fuel + 1)
          { stmts := .brk :: rest } source =
        .ok sourceResult) :
    sourceResult.1.mode = .brk := by
  cases hBreak : sourceCtx.breakScope? with
  | none =>
      simp [Source.Block.runOpen, Source.Stmt.run, hBreak, Source.invalid,
        Structured.invalid] at hRun
  | some breakScope =>
      simp [Source.Block.runOpen, Source.Stmt.run, hBreak,
        Source.Outcome.brk] at hRun
      cases hRun
      rfl

theorem block_runOpen_cons_cont_mode
    {prim : Source.PrimitiveSemantics} {program : Program}
    {sourceCtx : Source.Ctx} {fuel : Nat} {rest : List Stmt}
    {source : Source.State} {sourceResult : Source.Outcome × Source.Ctx}
    (hRun :
      Source.Block.runOpen prim program sourceCtx (fuel + 1)
          { stmts := .cont :: rest } source =
        .ok sourceResult) :
    sourceResult.1.mode = .cont := by
  cases hContinue : sourceCtx.continueScope? with
  | none =>
      simp [Source.Block.runOpen, Source.Stmt.run, hContinue,
        Source.invalid, Structured.invalid] at hRun
  | some continueScope =>
      simp [Source.Block.runOpen, Source.Stmt.run, hContinue,
        Source.Outcome.cont] at hRun
      cases hRun
      rfl

theorem block_runScoped_of_open_brk_mode
    {prim : Source.PrimitiveSemantics} {program : Program}
    {sourceCtx : Source.Ctx} {fuel : Nat} {body : Block}
    {source : Source.State}
    {sourceOpenResult : Source.Outcome × Source.Ctx}
    (hSourceOpen :
      Source.Block.runOpen prim program sourceCtx fuel body source =
        .ok sourceOpenResult)
    (hMode : sourceOpenResult.1.mode = .brk) :
    Source.Block.runScoped prim program sourceCtx body fuel source =
      .ok sourceOpenResult.1 := by
  unfold Source.Block.runScoped
  rcases sourceOpenResult with ⟨sourceOutcome, sourceCtxOut⟩
  cases sourceOutcome with
  | mk sourceState sourceMode =>
      cases sourceMode <;> simp at hMode
      simpa [hSourceOpen, Source.Outcome.brk,
        Locals.Source.Outcome.brk]

theorem block_runScoped_of_open_cont_mode
    {prim : Source.PrimitiveSemantics} {program : Program}
    {sourceCtx : Source.Ctx} {fuel : Nat} {body : Block}
    {source : Source.State}
    {sourceOpenResult : Source.Outcome × Source.Ctx}
    (hSourceOpen :
      Source.Block.runOpen prim program sourceCtx fuel body source =
        .ok sourceOpenResult)
    (hMode : sourceOpenResult.1.mode = .cont) :
    Source.Block.runScoped prim program sourceCtx body fuel source =
      .ok sourceOpenResult.1 := by
  unfold Source.Block.runScoped
  rcases sourceOpenResult with ⟨sourceOutcome, sourceCtxOut⟩
  cases sourceOutcome with
  | mk sourceState sourceMode =>
      cases sourceMode <;> simp at hMode
      simpa [hSourceOpen, Source.Outcome.cont]

theorem block_runOpen_cons_block_body_brk_mode
    {prim : Source.PrimitiveSemantics} {program : Program}
    {sourceCtx : Source.Ctx} {fuel : Nat} {body : Block} {rest : List Stmt}
    {source : Source.State}
    {sourceOpenResult sourceResult : Source.Outcome × Source.Ctx}
    (hSourceOpen :
      Source.Block.runOpen prim program sourceCtx fuel body source =
        .ok sourceOpenResult)
    (hBodyMode : sourceOpenResult.1.mode = .brk)
    (hRun :
      Source.Block.runOpen prim program sourceCtx (fuel + 1)
          { stmts := .block body :: rest } source =
        .ok sourceResult) :
    sourceResult.1.mode = .brk := by
  rcases SourceDirect.Block.source_runOpen_cons_head hRun with
    ⟨sourceHead, sourceCtxAfter, hHead, _hTail, hNonregular⟩
  have hScoped :
      Source.Block.runScoped prim program sourceCtx body fuel source =
        .ok sourceOpenResult.1 :=
    block_runScoped_of_open_brk_mode hSourceOpen hBodyMode
  have hHeadEq :
      sourceHead = sourceOpenResult.1 := by
    have hHeadPair :
        sourceOpenResult.1 = sourceHead ∧ sourceCtx = sourceCtxAfter := by
      simpa [Source.Stmt.run, hScoped] using hHead
    exact hHeadPair.1.symm
  have hSourceResult :
      sourceResult = (sourceHead, sourceCtx) := by
    exact hNonregular (by
      rw [hHeadEq]
      intro hRegular
      rw [hRegular] at hBodyMode
      simp at hBodyMode)
  rw [hSourceResult, hHeadEq]
  exact hBodyMode

theorem block_runOpen_cons_block_body_cont_mode
    {prim : Source.PrimitiveSemantics} {program : Program}
    {sourceCtx : Source.Ctx} {fuel : Nat} {body : Block} {rest : List Stmt}
    {source : Source.State}
    {sourceOpenResult sourceResult : Source.Outcome × Source.Ctx}
    (hSourceOpen :
      Source.Block.runOpen prim program sourceCtx fuel body source =
        .ok sourceOpenResult)
    (hBodyMode : sourceOpenResult.1.mode = .cont)
    (hRun :
      Source.Block.runOpen prim program sourceCtx (fuel + 1)
          { stmts := .block body :: rest } source =
        .ok sourceResult) :
    sourceResult.1.mode = .cont := by
  rcases SourceDirect.Block.source_runOpen_cons_head hRun with
    ⟨sourceHead, sourceCtxAfter, hHead, _hTail, hNonregular⟩
  have hScoped :
      Source.Block.runScoped prim program sourceCtx body fuel source =
        .ok sourceOpenResult.1 :=
    block_runScoped_of_open_cont_mode hSourceOpen hBodyMode
  have hHeadEq :
      sourceHead = sourceOpenResult.1 := by
    have hHeadPair :
        sourceOpenResult.1 = sourceHead ∧ sourceCtx = sourceCtxAfter := by
      simpa [Source.Stmt.run, hScoped] using hHead
    exact hHeadPair.1.symm
  have hSourceResult :
      sourceResult = (sourceHead, sourceCtx) := by
    exact hNonregular (by
      rw [hHeadEq]
      intro hRegular
      rw [hRegular] at hBodyMode
      simp at hBodyMode)
  rw [hSourceResult, hHeadEq]
  exact hBodyMode

theorem block_runOpen_cons_if_body_brk_mode
    {prim : Source.PrimitiveSemantics} {program : Program}
    {sourceCtx : Source.Ctx} {fuel : Nat} {cond : Expr 1} {body : Block}
    {rest : List Stmt} {source sourceAfterCond : Source.State}
    {sourceOpenResult sourceResult : Source.Outcome × Source.Ctx}
    (hSourceCond :
      Source.Expr.evalCondition prim cond source =
        .ok (sourceAfterCond, true))
    (hSourceOpen :
      Source.Block.runOpen prim program sourceCtx fuel.pred body
          sourceAfterCond =
        .ok sourceOpenResult)
    (hBodyMode : sourceOpenResult.1.mode = .brk)
    (hRun :
      Source.Block.runOpen prim program sourceCtx (fuel + 1)
          { stmts := .if_ cond body :: rest } source =
        .ok sourceResult) :
    sourceResult.1.mode = .brk := by
  rcases SourceDirect.Block.source_runOpen_cons_head hRun with
    ⟨sourceHead, sourceCtxAfter, hHead, _hTail, hNonregular⟩
  cases fuel with
  | zero =>
      simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hHead
  | succ innerFuel =>
  have hScoped :
      Source.Block.runScoped prim program sourceCtx body innerFuel sourceAfterCond =
        .ok sourceOpenResult.1 :=
    block_runScoped_of_open_brk_mode
      (by simpa using hSourceOpen) hBodyMode
  have hHeadEq :
      sourceHead = sourceOpenResult.1 := by
    have hHeadPair :
        sourceOpenResult.1 = sourceHead ∧ sourceCtx = sourceCtxAfter := by
      simpa [Source.Stmt.run, hSourceCond, hScoped] using hHead
    exact hHeadPair.1.symm
  have hSourceResult :
      sourceResult = (sourceHead, sourceCtx) := by
    exact hNonregular (by
      rw [hHeadEq]
      intro hRegular
      rw [hRegular] at hBodyMode
      simp at hBodyMode)
  rw [hSourceResult, hHeadEq]
  exact hBodyMode


  | succ fuel ih =>
      exact
        runForLoop_with_block_callback_families
          (prim := prim) hPrim (sourceProgram := sourceProgram)
          (targetProgram := targetProgram) hOpenCallbacks hLoopOpenBlock
          (returns := returns)
          (postLiveCtx := postLiveCtx) (bodyLiveCtx := bodyLiveCtx)
          (postAfter := postAfter) (postOut := postOut)
          (bodyAfter := bodyAfter) (bodyOut := bodyOut)
          (retc := retc) (fuel := fuel + 1) (loopCtx := loopCtx)
          (postBase := postBase) (bodyBase := bodyBase)
          (targetLoopCtx := targetLoopCtx)
          (targetPostBase := targetPostBase)
          (targetBodyBase := targetBodyBase)
          (source := source) (target := target)
          (hiddenReturns := hiddenReturns) (cond := cond) (post := post)
          (body := body) (lowerPost := lowerPost)
          (lowerBody := lowerBody) (sourceLoop := sourceLoop)
          hFuelLe hPostProtected hBodyProtected hLowerPost hLowerBody hCtx
          hPostCtx hBodyCtx hTargetPostLayout hTargetBodyLayout
          hPostBreakNone hPostContinueNone hLoopNoDup hPostNoDup hBodyNoDup
          hPostSourceNoDup hBodySourceNoDup hReturnsLen hPostLeaveFrame
          hBodyLeaveFrame hPostControlRel hBodyTargetControlRel
          hBodyReturnScopeRel hPostHandlerScope hBodyTargetHandlerScopeRel
          hPostReturnsEq hBodyReturnsEq hPostCleanup hBodyCleanup
          hBodyBreakLoopDrop hBodyContinueLoopDrop hBodyRegularBase hOwned
          hAccess hRel hSourceRun hPostNoCall hBodyNoCall hPostScoped
          hBodyScoped
          (by
            intro sourcePost targetPost sourceLoop' hSourceLoop hLoopRel
            exact
              ih (source := sourcePost) (target := targetPost)
                (sourceLoop := sourceLoop') (by omega) hLoopRel hSourceLoop)

theorem forLoop_callback_of_open_block_callbacks
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {maxFuel : Nat}
    (hOpenCallbacks :
      ScopedNoInternalCallShapeRecursiveOpenBlockOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel)
    (hLoopOpenBlock :
      ScopedNoInternalCallShapeRecursiveLoopOpenBlockLayoutToOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel)
    {returns : List Name} {liveCtx : Ctx} {after outLayout : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State}
    (hFuelPredLe : fuel.pred ≤ maxFuel)
    (hCtxRel : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hSourceNoDup : sourceCtx.scope.Nodup)
    (hNoDup : targetCtx.layout.Nodup)
    (hReturnsLen : returns.length = retc)
    (hLeaveFrame : SourceDirect.LeaveFrameAvailable sourceCtx hiddenReturns)
    (hReturnScopeRel :
      SourceDirectBridge.LiveReturnScopeRel liveCtx sourceCtx)
    (hReturnsEq : liveCtx.returns = returns)
    {init post body : Block} {cond : Expr 1} {rest : List Stmt}
    {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
    {prep lowerStmt lowerRest : List Locals.Stmt}
    (_hRestLive : restLive = StmtList.liveBefore liveCtx after rest)
    (_hStmtLive :
      stmtLive = Stmt.liveBefore liveCtx restLive
        (.for_ init cond post body))
    (hLiveLayout : liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive)
    (hPrepare :
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive (.for_ init cond post body) =
        some (prep, preparedLayout))
    (_hEntry :
      Layout.entryWindowOk? preparedLayout stmtLive = true)
    (_hAccess :
      StmtAccess.accessible? returns preparedLayout
        (.for_ init cond post body) = true)
    (_hLowerStmt :
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive
        (.for_ init cond post body) =
        some (lowerStmt, nextLayout))
    (_hLowerRest :
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout))
    (_hInitNoCall : NoInternalCall.Block.Holds init)
    (hPostNoCall : NoInternalCall.Block.Holds post)
    (hBodyNoCall : NoInternalCall.Block.Holds body)
    (hInitScoped : Scope.Block.Scoped sourceCtx.scope init)
    (hPostScoped :
      Scope.Block.Scoped (Scope.Block.outEnv sourceCtx.scope init) post)
    (hBodyScoped :
      Scope.Block.Scoped (Scope.Block.outEnv sourceCtx.scope init) body)
    {cleaned : Locals.RunState}
    (_hCleanRel :
      SourceDirect.StateRel preparedLayout hiddenReturns source cleaned)
    {lowerInit : Locals.Block} {loopLayout : List Name}
    {lowerPost : Locals.Block} {postLayout : List Name}
    {lowerBody : Locals.Block} {bodyLayout : List Name}
    {sourceInitCtx : Source.Ctx} {targetInitCtx : Locals.Ctx}
    {sourceAfterInit : Source.State}
    {targetAfterInit : Locals.RunState}
    {sourceLoop : Source.Outcome} {initTargetFuel : Nat}
    (hLowerInit :
      let cleanedLayout := preparedLayout
      let loopMentioned :=
        NameSet.unions [Reads.expr cond, Reads.block post, Reads.block body,
          restLive]
      let postLive := Block.liveBefore liveCtx loopMentioned post
      let bodyCtx := liveCtx.withLoop restLive postLive
      let bodyLive := Block.liveBefore bodyCtx postLive body
      let loopLive :=
        NameSet.unions [Reads.expr cond, restLive, postLive, bodyLive]
      let initAfter := NameSet.union loopLive cleanedLayout
      Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout cleanedLayout) cleanedLayout
          initAfter init =
        some (lowerInit, loopLayout))
    (hCond : ExprAccess.expr? 0 loopLayout cond = true)
    (hLowerPost :
      let loopMentioned :=
        NameSet.unions [Reads.expr cond, Reads.block post, Reads.block body,
          restLive]
      let postAfter := Checked.scopedAfter loopLayout loopMentioned
      Lower.Block.toLocals? returns
        (liveCtx.withProtectedLayout loopLayout) loopLayout postAfter post =
        some (lowerPost, postLayout))
    (hLowerBody :
      let loopMentioned :=
        NameSet.unions [Reads.expr cond, Reads.block post, Reads.block body,
          restLive]
      let postLive := Block.liveBefore liveCtx loopMentioned post
      let bodyAfter := Checked.scopedAfter loopLayout postLive
      let bodyLoopCtx :=
        liveCtx.withLoop (Checked.scopedAfter loopLayout restLive) bodyAfter
      let bodyCheckCtx := bodyLoopCtx.withProtectedLayout loopLayout
      Lower.Block.toLocals? returns bodyCheckCtx loopLayout bodyAfter body =
        some (lowerBody, bodyLayout))
    (hSourceInit :
      Source.Block.runOpen prim sourceProgram sourceCtx.withoutLoopControl
          fuel.pred init source =
        .ok (Source.Outcome.regular sourceAfterInit, sourceInitCtx))
    (hTargetInit :
      Locals.Direct.Block.runOpen targetProgram
          (targetCtx.withLayout preparedLayout).withoutLoopControl
          initTargetFuel lowerInit cleaned =
        .ok (Structured.Outcome.regular targetAfterInit, targetInitCtx))
    (hSourceLoop :
      Source.Stmt.runForLoop prim sourceProgram sourceInitCtx cond
          sourceInitCtx.withoutLoopControl post
          (sourceInitCtx.withLoopControl sourceInitCtx.scope
            sourceInitCtx.scope)
          body fuel.pred sourceAfterInit =
        .ok sourceLoop)
    (hInitRel :
      SourceDirect.StateRel targetInitCtx.layout hiddenReturns
        sourceAfterInit targetAfterInit)
    (hInitCtx :
      SourceDirectBridge.LiveCtxRel retc sourceInitCtx targetInitCtx) :
    ∃ loopTargetFuel targetLoop,
      Locals.Direct.Stmt.runForLoop targetProgram targetInitCtx cond
          targetInitCtx.withoutLoopControl lowerPost
          (targetInitCtx.withLoopControl targetInitCtx.layout.length)
          lowerBody loopTargetFuel targetAfterInit =
        .ok targetLoop ∧
      SourceDirect.StmtOutcomeRel returns targetInitCtx.layout hiddenReturns
        sourceLoop targetLoop := by
  let loopMentioned :=
    NameSet.unions [Reads.expr cond, Reads.block post, Reads.block body,
      restLive]
  let postLive := Block.liveBefore liveCtx loopMentioned post
  let bodyAfter := Checked.scopedAfter loopLayout postLive
  let bodyLiveCtx :=
    (liveCtx.withLoop (Checked.scopedAfter loopLayout restLive) bodyAfter)
      |>.withProtectedLayout loopLayout
  rcases source_runForLoop_ok_as_succ hSourceLoop with
    ⟨predFuel, hFuelPredEq⟩
  have hPredFuelLe : predFuel ≤ maxFuel := by
    have hFuelPredSuccLe : predFuel + 1 ≤ maxFuel := by
      rw [hFuelPredEq] at hFuelPredLe
      exact hFuelPredLe
    omega
  have hSourceLoopSucc :
      Source.Stmt.runForLoop prim sourceProgram sourceInitCtx cond
          sourceInitCtx.withoutLoopControl post
          (sourceInitCtx.withLoopControl sourceInitCtx.scope
            sourceInitCtx.scope)
          body (predFuel + 1) sourceAfterInit =
        .ok sourceLoop := by
    rw [hFuelPredEq] at hSourceLoop
    exact hSourceLoop
  have hTargetInitLayout : targetInitCtx.layout = loopLayout :=
    forLoop_init_target_layout_of_lower (targetCtx := targetCtx)
      hLowerInit hTargetInit
  have hLiveNoDup : liveLayout.Nodup := by
    rw [hLiveLayout]
    exact Layout.trimDeadPrefix_nodup hNoDup
  have hPreparedNoDup : preparedLayout.Nodup :=
    Prepare.forStmtAboveSuffix?_nodup hPrepare hLiveNoDup
  have hPreparedSubset :
      ∀ {name : Name}, name ∈ preparedLayout → name ∈ sourceCtx.scope := by
    intro name hName
    have hLiveMem := Prepare.forStmtAboveSuffix?_mem hPrepare hName
    rw [hLiveLayout] at hLiveMem
    exact hCtxRel.1 (Layout.mem_trimDeadPrefix hLiveMem)
  have hLoopNoDup : targetInitCtx.layout.Nodup :=
    forLoop_init_target_nodup_of_lower
      (sourceEnv := sourceCtx.scope) (targetCtx := targetCtx)
      hLowerInit hTargetInit hPreparedSubset hPreparedNoDup hInitScoped
  have hInitSourceNoDup : sourceInitCtx.scope.Nodup :=
    forLoop_init_source_scope_nodup_of_run hSourceNoDup hInitScoped
      hSourceInit
  have hPostScoped' :
      Scope.Block.Scoped sourceInitCtx.withoutLoopControl.scope post := by
    simpa [Source.Ctx.withoutLoopControl,
      forLoop_init_source_scope_of_run hSourceInit] using hPostScoped
  have hBodyScoped' :
      Scope.Block.Scoped
        (sourceInitCtx.withLoopControl sourceInitCtx.scope
          sourceInitCtx.scope).scope body := by
    simpa [Source.Ctx.withLoopControl,
      forLoop_init_source_scope_of_run hSourceInit] using hBodyScoped
  have hInitLeaveFrame :
      SourceDirect.LeaveFrameAvailable sourceInitCtx hiddenReturns :=
    forLoop_init_leaveFrame_of_run hLeaveFrame hSourceInit
  exact
    runForLoop_with_block_callback_families_induction
      (prim := prim) hPrim (sourceProgram := sourceProgram)
      (targetProgram := targetProgram) hOpenCallbacks hLoopOpenBlock
      (returns := returns)
      (postLiveCtx := liveCtx.withProtectedLayout loopLayout)
      (bodyLiveCtx := bodyLiveCtx)
      (postAfter := loopMentioned) (postOut := postLayout)
      (bodyAfter := bodyAfter) (bodyOut := bodyLayout)
      (retc := retc) (fuel := predFuel) (loopCtx := sourceInitCtx)
      (postBase := sourceInitCtx.withoutLoopControl)
      (bodyBase :=
        sourceInitCtx.withLoopControl sourceInitCtx.scope sourceInitCtx.scope)
      (targetLoopCtx := targetInitCtx)
      (targetPostBase := targetInitCtx.withoutLoopControl)
      (targetBodyBase :=
        targetInitCtx.withLoopControl targetInitCtx.layout.length)
      (source := sourceAfterInit) (target := targetAfterInit)
      (hiddenReturns := hiddenReturns) (cond := cond) (post := post)
      (body := body) (lowerPost := lowerPost) (lowerBody := lowerBody)
      (sourceLoop := sourceLoop)
      hPredFuelLe
      (by
        simp [Locals.Ctx.withoutLoopControl, hTargetInitLayout,
          Ctx.withProtectedLayout, Ctx.withProtectedSuffixDepth,
          Ctx.protectedDepth])
      (by
        simp [Locals.Ctx.withLoopControl, hTargetInitLayout, bodyLiveCtx,
          Ctx.withProtectedLayout, Ctx.withProtectedSuffixDepth,
          Ctx.protectedDepth])
      (by
        simpa [Locals.Ctx.withoutLoopControl, hTargetInitLayout,
          loopMentioned] using hLowerPost)
      (by
        simpa [Locals.Ctx.withLoopControl, hTargetInitLayout, bodyAfter,
          bodyLiveCtx, loopMentioned, postLive] using hLowerBody)
      hInitCtx
      (SourceDirectBridge.LiveCtxRel.withoutLoopControl hInitCtx)
      (SourceDirectBridge.LiveCtxRel.withLoopControl_self hInitCtx)
      (by simp [Locals.Ctx.withoutLoopControl])
      (by simp [Locals.Ctx.withLoopControl])
      (by simp [Source.Ctx.withoutLoopControl])
      (by simp [Source.Ctx.withoutLoopControl])
      hLoopNoDup
      (by simpa [Locals.Ctx.withoutLoopControl] using hLoopNoDup)
      (by simpa [Locals.Ctx.withLoopControl] using hLoopNoDup)
      (by simpa [Source.Ctx.withoutLoopControl] using hInitSourceNoDup)
      (by simpa [Source.Ctx.withLoopControl] using hInitSourceNoDup)
      hReturnsLen
      (SourceDirect.LeaveFrameAvailable.withoutLoopControl hInitLeaveFrame)
      (SourceDirect.LeaveFrameAvailable.withLoopControl hInitLeaveFrame)
      (forLoop_post_controlRel_of_init_returnScope (loopLayout := loopLayout)
        hReturnScopeRel hSourceInit)
      (by
        have hTargetControl :=
          forLoop_body_target_control_scopedAfter
            (liveCtx := liveCtx) (targetCtx := targetInitCtx)
            (breakAfter := restLive) (continueAfter := postLive) hLoopNoDup
        simpa [hTargetInitLayout, bodyAfter, bodyLiveCtx, postLive] using
          hTargetControl)
      (by
        simpa [bodyAfter, bodyLiveCtx, postLive] using
          forLoop_body_returnScopeRel_of_init_returnScope
            (breakLive := Checked.scopedAfter loopLayout restLive)
            (continueLive := bodyAfter) (loopLayout := loopLayout)
            hReturnScopeRel hSourceInit)
      (forLoop_post_handlerScopeRel (liveCtx := liveCtx)
        (sourceInitCtx := sourceInitCtx) (loopLayout := loopLayout))
      (SourceDirectBridge.LiveTargetHandlerScopeRel.withLoopControl_self
        hInitCtx)
      (by simpa [Ctx.withProtectedLayout, Ctx.withProtectedSuffixDepth] using
        hReturnsEq)
      (by simpa [bodyLiveCtx, Ctx.withProtectedLayout,
        Ctx.withProtectedSuffixDepth] using hReturnsEq)
      (forLoop_post_ctx_cleanup_of_liveCtxRel hInitCtx)
      (forLoop_body_cleanup_of_liveCtxRel hInitCtx)
      (by
        intro targetDepth hDepth
        have hDepthEq : targetDepth = targetInitCtx.layout.length := by
          simpa [Locals.Ctx.withLoopControl] using hDepth.symm
        subst targetDepth
        simp [Locals.Ctx.withLoopControl])
      (by
        intro targetDepth hDepth
        have hDepthEq : targetDepth = targetInitCtx.layout.length := by
          simpa [Locals.Ctx.withLoopControl] using hDepth.symm
        subst targetDepth
        simp [Locals.Ctx.withLoopControl])
      (by
        refine ⟨?_, ?_, ?_⟩
        · simp [Locals.Ctx.withLoopControl, hTargetInitLayout, bodyLiveCtx,
            Ctx.withProtectedLayout, Ctx.withProtectedSuffixDepth,
            Ctx.protectedDepth]
        · intro name hName
          simpa [Locals.Ctx.withLoopControl, hTargetInitLayout, bodyAfter]
            using
              (Checked.mem_scopedAfter_of_mem_layout
                (layout := loopLayout) (after := postLive)
                (by
                  simpa [Locals.Ctx.withLoopControl, hTargetInitLayout]
                    using hName))
        · exact SourceDirect.CleanupLayoutRel.refl _)
      (ExprAccess.expr?_sourceOwned hCond)
      (by simpa [hTargetInitLayout] using ExprAccess.expr?_sound hCond)
      hInitRel hSourceLoopSucc hPostNoCall hBodyNoCall hPostScoped'
      hBodyScoped'

theorem block_trimDeadPrefix_of_mode_live_subset
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {maxFuel : Nat}
    (hCallbacks :
      ScopedNoInternalCallShapeRecursiveOpenBlockOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel)
    {returns : List Name} {liveCtx : Ctx} {after outLayout keepLive : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {block : Block} {lowerBlock : Locals.Block}
    {source : Source.State} {target : Locals.RunState}
    {sourceResult : Source.Outcome × Source.Ctx}
    (hFuelLe : fuel ≤ maxFuel)
    (hLower :
      Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout
            (Layout.trimDeadPrefix targetCtx.layout keepLive))
          (Layout.trimDeadPrefix targetCtx.layout keepLive)
          (Checked.scopedAfter
            (Layout.trimDeadPrefix targetCtx.layout keepLive) after) block =
        some (lowerBlock, outLayout))
    (hSourceRun :
      Source.Block.runOpen prim sourceProgram sourceCtx fuel block source =
        .ok sourceResult)
    (hStateRel :
      SourceDirect.StateRel
        (Layout.trimDeadPrefix targetCtx.layout keepLive) hiddenReturns source
        target)
    (hNoCall : NoInternalCall.Block.Holds block)
    (hScopedBlock : Scope.Block.Scoped sourceCtx.scope block)
    (hCtxCleanup :
      SourceDirectBridge.LiveCtxCleanupRel retc sourceCtx targetCtx)
    (hNoDup : targetCtx.layout.Nodup)
    (hSourceNoDup : sourceCtx.scope.Nodup)
    (hReturnsLen : returns.length = retc)
    (hLeaveFrame : SourceDirect.LeaveFrameAvailable sourceCtx hiddenReturns)
    (hControlRel :
      SourceDirectBridge.LiveControlRel liveCtx sourceCtx)
    (hHandlerScope :
      SourceDirectBridge.LiveHandlerScopeRel liveCtx sourceCtx)
    (hReturnsEq : liveCtx.returns = returns)
    (hBreakLiveSubset :
      sourceResult.1.mode = .brk →
        ∀ {name : Name}, name ∈ liveCtx.breakLive → name ∈ keepLive)
    (hContinueLiveSubset :
      sourceResult.1.mode = .cont →
        ∀ {name : Name}, name ∈ liveCtx.continueLive → name ∈ keepLive) :
    SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
      targetProgram returns retc fuel sourceCtx
      (targetCtx.withLayout (Layout.trimDeadPrefix targetCtx.layout keepLive))
      hiddenReturns block lowerBlock source target := by
  let cleanedLayout := Layout.trimDeadPrefix targetCtx.layout keepLive
  have hCleanOutcomeCleanup :
      SourceDirectBridge.LiveCtxOutcomeCleanupRel retc sourceCtx
        (targetCtx.withLayout cleanedLayout) sourceResult.1 := by
    simpa [cleanedLayout] using
      SourceDirectBridge.LiveCtxOutcomeCleanupRel.trimDeadPrefix_of_mode_live_subset
        hCtxCleanup hControlRel hBreakLiveSubset hContinueLiveSubset
  have hCleanNoDup : cleanedLayout.Nodup := by
    exact Layout.trimDeadPrefix_nodup hNoDup
  exact
    hCallbacks.block (returns := returns)
      (liveCtx := liveCtx.withProtectedLayout cleanedLayout)
      (after := after) (outLayout := outLayout) (retc := retc)
      (fuel := fuel) (sourceCtx := sourceCtx)
      (targetCtx := targetCtx.withLayout cleanedLayout)
      (hiddenReturns := hiddenReturns) (block := block)
      (lowerBlock := lowerBlock) (source := source) (target := target)
      (sourceResult := sourceResult) hFuelLe
      (by
        simp [cleanedLayout, Locals.Ctx.withLayout, Ctx.withProtectedLayout,
          Ctx.withProtectedSuffixDepth, Ctx.protectedDepth])
      (by simpa [cleanedLayout, Locals.Ctx.withLayout] using hLower)
      hSourceRun (by simpa [cleanedLayout, Locals.Ctx.withLayout] using hStateRel)
      hNoCall hScopedBlock hSourceNoDup hCleanOutcomeCleanup
      (by simpa [Locals.Ctx.withLayout] using hCleanNoDup)
      hReturnsLen hLeaveFrame
      (by
        simpa [Ctx.withProtectedLayout, Ctx.withProtectedSuffixDepth,
          SourceDirectBridge.LiveControlRel] using hControlRel)
      (by
        simpa [Ctx.withProtectedLayout, Ctx.withProtectedSuffixDepth,
          SourceDirectBridge.LiveHandlerScopeRel] using hHandlerScope)
      (by
        simpa [Ctx.withProtectedLayout, Ctx.withProtectedSuffixDepth]
          using hReturnsEq)

theorem blockBody_of_open_block_of_mode_live_subset
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {maxFuel : Nat}
    (hCallbacks :
      ScopedNoInternalCallShapeRecursiveOpenBlockOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel)
    {returns : List Name} {liveCtx : Ctx} {after outLayout : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State}
    (hFuelLe : fuel ≤ maxFuel)
    (hCtxCleanup :
      SourceDirectBridge.LiveCtxCleanupRel retc sourceCtx targetCtx)
    (hNoDup : targetCtx.layout.Nodup)
    (hSourceNoDup : sourceCtx.scope.Nodup)
    (hReturnsLen : returns.length = retc)
    (hLeaveFrame : SourceDirect.LeaveFrameAvailable sourceCtx hiddenReturns)
    (hControlRel :
      SourceDirectBridge.LiveControlRel liveCtx sourceCtx)
    (hHandlerScope :
      SourceDirectBridge.LiveHandlerScopeRel liveCtx sourceCtx)
    (hReturnsEq : liveCtx.returns = returns)
    {stmt : Stmt} {rest : List Stmt}
    {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
    {prep lowerStmt lowerRest : List Locals.Stmt}
    (_hRestLive : restLive = StmtList.liveBefore liveCtx after rest)
    (_hStmtLive : stmtLive = Stmt.liveBefore liveCtx restLive stmt)
    (hLiveLayout : liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive)
    (hPrepare :
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout))
    (_hEntry : Layout.entryWindowOk? preparedLayout stmtLive = true)
    (_hAccess : StmtAccess.accessible? returns preparedLayout stmt = true)
    (_hLowerStmt :
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout))
    (_hLowerRest :
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout))
    {cleaned : Locals.RunState}
    (hCleanRel :
      SourceDirect.StateRel preparedLayout hiddenReturns source cleaned)
    {body : Block} {lowerBody : Locals.Block} {bodyLayout : List Name}
    {sourceOpenResult : Source.Outcome × Source.Ctx}
    (hBodyNoCall : NoInternalCall.Block.Holds body)
    (hBodyScoped : Scope.Block.Scoped sourceCtx.scope body)
    (hLowerBody :
      Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout preparedLayout) preparedLayout
        (Checked.scopedAfter preparedLayout restLive) body =
        some (lowerBody, bodyLayout))
    (hSourceOpen :
      Source.Block.runOpen prim sourceProgram sourceCtx fuel body source =
        .ok sourceOpenResult)
    (hBreakLiveSubset :
      sourceOpenResult.1.mode = .brk →
        ∀ {name : Name}, name ∈ liveCtx.breakLive → name ∈ stmtLive)
    (hContinueLiveSubset :
      sourceOpenResult.1.mode = .cont →
        ∀ {name : Name}, name ∈ liveCtx.continueLive → name ∈ stmtLive) :
    SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
      targetProgram returns retc fuel sourceCtx
      (targetCtx.withLayout preparedLayout)
      hiddenReturns body lowerBody source cleaned := by
  have hTrimOutcomeCleanup :
      SourceDirectBridge.LiveCtxOutcomeCleanupRel retc sourceCtx
        (targetCtx.withLayout liveLayout) sourceOpenResult.1 := by
    have hTrim :
        SourceDirectBridge.LiveCtxOutcomeCleanupRel retc sourceCtx
          (targetCtx.withLayout
            (Layout.trimDeadPrefix targetCtx.layout stmtLive))
          sourceOpenResult.1 :=
      SourceDirectBridge.LiveCtxOutcomeCleanupRel.trimDeadPrefix_of_mode_live_subset
        hCtxCleanup hControlRel hBreakLiveSubset hContinueLiveSubset
    simpa [hLiveLayout] using hTrim
  have hBreakDepth :
      ∀ {depth : Nat}, (targetCtx.withLayout liveLayout).breakDepth? =
          some depth →
        depth ≤ liveCtx.protectedDepth := by
    intro depth hDepth
    exact
      SourceDirectBridge.LiveCtxCleanupRel.breakDepth_le_protectedDepth
        hCtxCleanup hControlRel hNoDup
        (by simpa [Locals.Ctx.withLayout] using hDepth)
  have hContinueDepth :
      ∀ {depth : Nat}, (targetCtx.withLayout liveLayout).continueDepth? =
          some depth →
        depth ≤ liveCtx.protectedDepth := by
    intro depth hDepth
    exact
      SourceDirectBridge.LiveCtxCleanupRel.continueDepth_le_protectedDepth
        hCtxCleanup hControlRel hNoDup
        (by simpa [Locals.Ctx.withLayout] using hDepth)
  have hPreparedOutcomeCleanup :
      SourceDirectBridge.LiveCtxOutcomeCleanupRel retc sourceCtx
        (targetCtx.withLayout preparedLayout) sourceOpenResult.1 := by
    have hPreparedBase :
        SourceDirectBridge.LiveCtxOutcomeCleanupRel retc sourceCtx
          ((targetCtx.withLayout liveLayout).withLayout preparedLayout)
          sourceOpenResult.1 :=
      SourceDirectBridge.LiveCtxOutcomeCleanupRel.forStmtAboveSuffix_of_depth_bounds
        (target := targetCtx.withLayout liveLayout)
        (hPrepare := by
          simpa [Locals.Ctx.withLayout] using hPrepare)
        hTrimOutcomeCleanup hBreakDepth hContinueDepth
    simpa [Locals.Ctx.withLayout] using hPreparedBase
  have hLiveNoDup : liveLayout.Nodup := by
    rw [hLiveLayout]
    exact Layout.trimDeadPrefix_nodup hNoDup
  have hPreparedNoDup : preparedLayout.Nodup :=
    Prepare.forStmtAboveSuffix?_nodup hPrepare hLiveNoDup
  exact
    hCallbacks.block (returns := returns)
      (liveCtx := liveCtx.withProtectedLayout preparedLayout)
      (after := restLive) (outLayout := bodyLayout) (retc := retc)
      (fuel := fuel) (sourceCtx := sourceCtx)
      (targetCtx := targetCtx.withLayout preparedLayout)
      (hiddenReturns := hiddenReturns) (block := body)
      (lowerBlock := lowerBody) (source := source) (target := cleaned)
      (sourceResult := sourceOpenResult) hFuelLe
      (by
        simp [Locals.Ctx.withLayout, Ctx.withProtectedLayout,
          Ctx.withProtectedSuffixDepth, Ctx.protectedDepth])
      (by simpa [Locals.Ctx.withLayout] using hLowerBody)
      hSourceOpen hCleanRel hBodyNoCall hBodyScoped hSourceNoDup
      hPreparedOutcomeCleanup
      (by simpa [Locals.Ctx.withLayout] using hPreparedNoDup)
      hReturnsLen hLeaveFrame
      (by
        simpa [Ctx.withProtectedLayout, Ctx.withProtectedSuffixDepth,
          SourceDirectBridge.LiveControlRel] using hControlRel)
      (by
        simpa [Ctx.withProtectedLayout, Ctx.withProtectedSuffixDepth,
          SourceDirectBridge.LiveHandlerScopeRel] using hHandlerScope)
      (by
        simpa [Ctx.withProtectedLayout, Ctx.withProtectedSuffixDepth]
          using hReturnsEq)

theorem loopBlockBody_of_open_block_of_mode_live_subset
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {maxFuel : Nat}
    (hCallbacks :

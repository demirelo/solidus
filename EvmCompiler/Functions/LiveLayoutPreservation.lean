def LiveNonLoopNonCallStmt : Stmt → Prop
  | .for_ _init _cond _post _body => False
  | .call _targets _functionName _args => False
  | _ => True

def LiveNonCallStmt : Stmt → Prop
  | .call _targets _functionName _args => False
  | _ => True

theorem noInternalCall_switch_select_block_holds {scrutinee : Word}
    {cases : List (Word × Block)} {defaultBody : Option Block}
    {body : Block}
    (hCases : NoInternalCall.CaseList.Holds cases)
    (hDefault : NoInternalCall.Default.Holds defaultBody)
    (hSelect : Source.Switch.select scrutinee cases defaultBody = some body) :
    NoInternalCall.Block.Holds body := by
  induction cases generalizing defaultBody body with
  | nil =>
      cases defaultBody with
      | none =>
          simp [Source.Switch.select] at hSelect
      | some defaultBlock =>
          simp [Source.Switch.select] at hSelect
          cases hSelect
          simpa [NoInternalCall.Default.Holds] using hDefault
  | cons head rest ih =>
      rcases head with ⟨value, caseBody⟩
      rcases hCases with ⟨hCaseBody, hRest⟩
      by_cases hEq : value = scrutinee
      · simp [Source.Switch.select, hEq] at hSelect
        cases hSelect
        exact hCaseBody
      · exact ih hRest hDefault
          (by simpa [Source.Switch.select, hEq] using hSelect)


          SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo baseLayout
            sourceTailResult targetTailResult) :
    ∃ targetFuel targetResult,
      Locals.Direct.Block.runOpen targetProgram targetCtx targetFuel
          { stmts :=
              Lower.cleanupToLive targetCtx.layout stmtLive ::
                (prep ++ (lowerStmt ++ lowerRest)) } target =
        .ok targetResult ∧
      SourceDirectBridge.LiveBlockOpenResultRel retc returns hiddenReturns
        sourceResult targetResult ∧
      SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo baseLayout
        sourceResult targetResult := by
  rcases Target.cleanupToLive_runOpen_exists
      (program := targetProgram) (ctx := targetCtx) (live := stmtLive)

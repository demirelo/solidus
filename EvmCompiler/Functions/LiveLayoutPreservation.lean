            have hTrimBase :=
              SourceDirectBridge.LiveCtxOutcomeCleanupRel.trimDeadPrefix_of_outer_mode_target_suffix
                hOutcomeCleanup hBreakOuterMode hContinueOuterMode
                (fun hMode' {depth} hDepth' {name} hName' =>
                  hBreakKeepLive hMode' hDepth' hName')
                (fun hMode' {depth} hDepth' {name} hName' =>
                  hContinueKeepLive hMode' hDepth' hName')
            simpa [hLiveLayout] using hTrimBase
          rcases
              SourceDirectBridge.LiveCtxRel.continueScope_some_of_target
                (SourceDirectBridge.LiveCtxOutcomeCleanupRel.ctxRel hTrim)
                (by simpa [Locals.Ctx.withLayout] using hDepth) with
            ⟨continueScope, hContinueScope⟩
          exact
            (SourceDirectBridge.LiveCtxOutcomeCleanupRel.continueCleanup
              hTrim hMode hContinueScope
              (by simpa [Locals.Ctx.withLayout] using hDepth)).1
        calc
          preparedLayout.drop (preparedLayout.length - targetDepth)
              =
                targetCtx.layout.drop
                  (targetCtx.layout.length - targetDepth) :=
              SourceDirectBridge.LiveCleanupScopeRel.forStmtAboveSuffix_trimDeadPrefix_suffix_drop
                (hLiveLayout := hLiveLayout) (hPrepare := hPrepare)
                hDepthProtected hDepthLive
          _ = loopLayout := hContinueLoopDrop hMode hDepthBase)
      (by
        intro _hRegular
        exact
          ⟨by
              simp [Ctx.withProtectedLayout, Ctx.withProtectedSuffixDepth,
                Ctx.protectedDepth],
            (by
              intro name hName
              exact Checked.mem_scopedAfter_of_mem_layout hName),
            SourceDirect.CleanupLayoutRel.refl preparedLayout⟩)
  exact hLoopBridge


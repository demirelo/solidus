theorem liveStmtRunBridgeWithLayout_of_runBridge_of_lower
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name} {liveCtx : Ctx} {after nextLayout : List Name}
    {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {stmt : Stmt} {lowerStmt : List Locals.Stmt}
    (hLower :
      Lower.Stmt.toLocals? returns liveCtx targetCtx.layout after stmt =
        some (lowerStmt, nextLayout))
    (hBridge :
      SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
        returns retc fuel sourceCtx targetCtx hiddenReturns stmt
        { stmts := lowerStmt } source target) :
    SourceDirectBridge.LiveStmtRunBridgeWithLayout prim sourceProgram
      targetProgram returns retc fuel sourceCtx targetCtx hiddenReturns stmt
      { stmts := lowerStmt } source target := by
  rcases hBridge with
    ⟨sourceResult, targetFuel, targetResult, hSource, hTarget, hRel⟩
  refine ⟨sourceResult, targetFuel, targetResult, hSource, hTarget, hRel, ?_⟩
  rcases sourceResult with ⟨sourceOutcome, sourceCtxOut⟩
  rcases targetResult with ⟨targetOutcome, targetCtxOut⟩
  rcases sourceOutcome with ⟨sourceAfter, sourceMode⟩
  rcases targetOutcome with ⟨targetAfter, targetMode⟩
  cases sourceMode <;> cases targetMode <;>
    simp [SourceDirectBridge.LiveStmtRegularLayoutRelTo]
  have hTargetLayout :
      targetCtxOut.layout = nextLayout :=
    TargetLayout.Lower.stmt_runOpen_regular_layout_of_lower
      hLower (by rfl) hTarget
  have hCleanup :
      SourceDirect.CleanupLayoutRel nextLayout targetCtx.layout :=
    TargetLayout.Lower.stmt_toLocals?_cleanupLayoutRel hLower
  simpa [hTargetLayout] using hCleanup


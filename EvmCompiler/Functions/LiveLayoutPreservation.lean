theorem leave_liveStmtRunBridge_of_leaveFrame {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {leaveScope : List Name}
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hLeave : sourceCtx.leaveScope? = some leaveScope)
    (hReturnScope : ∀ name, name ∈ returns → name ∈ leaveScope)
    (hNoDup : targetCtx.layout.Nodup)
    (hReturnsLen : returns.length = retc)
    (hLeaveFrame : SourceDirect.LeaveFrameAvailable sourceCtx hiddenReturns)
    (hAccess : NamesAccess.Accessible targetCtx.layout 0 returns)
    (hRel : SourceDirect.StateRel targetCtx.layout hiddenReturns source target) :
    SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
      returns retc fuel sourceCtx targetCtx hiddenReturns .leave
      { stmts := Functions.Lower.pushReturns returns ++ [Locals.Stmt.leave] }
      source target := by
  rcases hCtx with
    ⟨hSubset, hBreakDepth, hContinueDepth, hLeaveDepth, hLeaveRetc⟩
  have hCtxRel :
      SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx :=
    ⟨hSubset, hBreakDepth, hContinueDepth, hLeaveDepth, hLeaveRetc⟩
  have hTargetDepth : targetCtx.leaveDepth? = some 0 := by
    rw [hLeaveDepth, hLeave]
    rfl
  have hReturnValuesAccess :
      SourceDirect.ReturnValuesRel.Accessible targetCtx.layout 0 returns :=
    _root_.EvmCompiler.Functions.LiveLayout.NamesAccess.to_returnValuesAccessible
      hAccess
  rcases SourceDirect.ReturnValuesRel.exists_of_stateRel_accessible
      hReturnValuesAccess hRel with
    ⟨values, hValues⟩
  have hValuesLen : values.length = returns.length :=
    SourceDirect.ReturnValuesRel.values_length hValues
  have hRetcBound : retc ≤ 16 := by
    have hReturnsBound :
      returns.length ≤ 16 :=
      _root_.EvmCompiler.Functions.LiveLayout.NamesAccess.length_le_16_of_accessible_zero
        hAccess
    omega
  rcases hRel with ⟨⟨hSharedRel, hStackRel⟩, hReturns⟩
  have hRel' :
      SourceDirect.StateRel targetCtx.layout hiddenReturns source target :=
    ⟨⟨hSharedRel, hStackRel⟩, hReturns⟩
  rcases SourceDirect.ReturnValuesRel.pushReturns
      (layout := targetCtx.layout) (hiddenReturns := hiddenReturns)
      (source := source) (target := target) (ctx := targetCtx)
      (returns := returns) (values := values)
      rfl hNoDup hRel' hValues with
    ⟨stateAfterReturns, _hLookup, hPush, hPushStack, hPushShared,
      hPushReturns⟩
  rcases Target.pushReturns_runOpen_exists
      (program := targetProgram) targetCtx hPush with
    ⟨pushFuel, hPushBlock⟩
  have hPreserveLen : values.reverse.length = targetCtx.leaveRetc := by
    simp [hValuesLen, hReturnsLen, hLeaveRetc]
  have hTargetRetcBound : targetCtx.leaveRetc ≤ 16 := by
    rw [hLeaveRetc]
    exact hRetcBound
  rcases SourceDirect.Cleanup.runCleanupToPreserving_exists
      (ctx := targetCtx) (preserve := targetCtx.leaveRetc)
      (targetDepth := 0) (state := stateAfterReturns)
      (preserved := values.reverse) (locals := target.evm.stack)
      (by omega) hPreserveLen hTargetRetcBound hPushStack hStackRel.1 with
    ⟨targetAfter, hCleanup, hCleanupStack, hCleanupShared,
      hCleanupReturns⟩
  have hFinalReturns : targetAfter.returns = hiddenReturns :=
    hCleanupReturns.trans hPushReturns
  have hTargetReturnsNonempty : targetAfter.returns ≠ [] := by
    intro hNil
    have hHiddenNil : hiddenReturns = [] := by
      simpa [hFinalReturns] using hNil
    exact hLeaveFrame leaveScope hLeave hHiddenNil
  have hFinalStack : targetAfter.evm.stack = values.reverse := by
    simpa [Nat.sub_zero, ← hStackRel.1] using hCleanupStack
  have hFinalShared :
      targetAfter.evm.toSharedState =
        (Locals.Source.State.restrictTo leaveScope source).shared := by
    calc
      targetAfter.evm.toSharedState =
          stateAfterReturns.evm.toSharedState := hCleanupShared
      _ = target.evm.toSharedState := hPushShared
      _ = source.shared := hSharedRel
      _ = (Locals.Source.State.restrictTo leaveScope source).shared := rfl
  have hTargetLeaveStmt :
      Locals.Direct.Stmt.run targetProgram targetCtx 0 .leave
          stateAfterReturns =

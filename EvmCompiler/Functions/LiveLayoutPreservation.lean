        sourceResult.1.mode = .cont →
        SourceDirect.StateRel loopLayout hiddenReturns
          sourceResult.1.state targetResult.1.state) :
    SourceDirectBridge.LiveLoopBlockOpenRunBridgeWithLayout prim sourceProgram
      targetProgram returns loopLayout retc fuel sourceCtx
      (targetCtx.withLayout preparedLayout)
      hiddenReturns body lowerBody source cleaned := by
  exact
    SourceDirectBridge.LiveLoopBlockOpenRunBridgeWithLayout.of_open_with_layout_of_loop_stateRel
      (blockBody_of_open_block_of_mode_live_subset
        (prim := prim) hCallbacks (returns := returns) (liveCtx := liveCtx)
        (after := after) (outLayout := outLayout) (retc := retc)

                      hBreakKeepLive hMode' hDepth' hName')
                    (fun hMode' {depth} hDepth' {name} hName' =>
                      hContinueKeepLive hMode' hDepth' hName')
                simpa [hLiveLayout] using hTrimBase
              rcases
                  SourceDirectBridge.LiveCtxRel.breakScope_some_of_target
                    (SourceDirectBridge.LiveCtxOutcomeCleanupRel.ctxRel hTrim)
                    (by simpa [Locals.Ctx.withLayout] using hDepth) with
                ⟨trimBreakScope, hTrimBreakScope⟩
              exact
                (SourceDirectBridge.LiveCtxOutcomeCleanupRel.breakCleanup
                  hTrim hMode hTrimBreakScope
                  (by simpa [Locals.Ctx.withLayout] using hDepth)).1)

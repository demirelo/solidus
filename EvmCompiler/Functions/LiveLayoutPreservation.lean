        ∀ {targetDepth},
          targetCtx.continueDepth? = some targetDepth →
            targetCtx.layout.drop (targetCtx.layout.length - targetDepth) =
              loopLayout)
    (_hRestLive : restLive = StmtList.liveBefore liveCtx after rest)
    (_hStmtLive : stmtLive = Stmt.liveBefore liveCtx restLive stmt)
    (hLiveLayout : liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive)
    (hPrepare :
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout))
    (_hEntry : Layout.entryWindowOk? preparedLayout stmtLive = true)
    (_hAccess : StmtAccess.accessible? returns preparedLayout stmt = true)
    (_hLowerStmt :
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout))
    (_hLowerRest :
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout))
    {body : Block} {lowerBody : Locals.Block} {bodyLayout : List Name}
    (hStateRel :
      SourceDirect.StateRel preparedLayout hiddenReturns source target)
    (hBodyNoCall : NoInternalCall.Block.Holds body)
    (hBodyScoped : Scope.Block.Scoped sourceCtx.scope body)
    (hLowerBody :
      Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout preparedLayout) preparedLayout
        (Checked.scopedAfter preparedLayout restLive) body =
        some (lowerBody, bodyLayout))
    (hSourceOpen :
      Source.Block.runOpen prim sourceProgram sourceCtx fuel body source =
        .ok sourceOpenResult) :
    SourceDirectBridge.LiveLoopBlockOpenRunBridgeWithLayout prim sourceProgram
      targetProgram returns loopLayout retc fuel sourceCtx
      (targetCtx.withLayout preparedLayout)
      hiddenReturns body lowerBody source target := by
  have hPreparedOutcomeCleanup :
      SourceDirectBridge.LiveCtxOutcomeCleanupRel retc sourceCtx
        (targetCtx.withLayout preparedLayout) sourceOpenResult.1 :=
    SourceDirectBridge.LiveCtxOutcomeCleanupRel.forStmtAboveSuffix_of_outer_mode_target_suffix
      (target := targetCtx) (liveLayout := liveLayout)
      (hLiveLayout := hLiveLayout) (hPrepare := hPrepare)
      hOutcomeCleanup hBreakOuterMode hContinueOuterMode
      hBreakDepthProtected hContinueDepthProtected
      (fun hMode {depth} hDepth {name} hName =>
        hBreakKeepLive hMode hDepth hName)
      (fun hMode {depth} hDepth {name} hName =>
        hContinueKeepLive hMode hDepth hName)
  have hLiveNoDup : liveLayout.Nodup := by
    rw [hLiveLayout]
    exact Layout.trimDeadPrefix_nodup hNoDup
  have hPreparedNoDup : preparedLayout.Nodup :=
    Prepare.forStmtAboveSuffix?_nodup hPrepare hLiveNoDup
  have hPreparedReturnScope :
      SourceDirectBridge.LiveReturnScopeRel
        (liveCtx.withProtectedLayout preparedLayout) sourceCtx := by
    exact
      SourceDirectBridge.LiveReturnScopeRel.withProtectedLayout
        preparedLayout hReturnScopeRel
  have hPreparedHandlerScope :
      SourceDirectBridge.LiveTargetHandlerScopeRel sourceCtx
        (targetCtx.withLayout preparedLayout) :=
    SourceDirectBridge.LiveTargetHandlerScopeRel.of_liveCtxRel
      (SourceDirectBridge.LiveCtxOutcomeCleanupRel.ctxRel
        hPreparedOutcomeCleanup)
  have hLoopBridge :
      SourceDirectBridge.LiveLoopBlockOpenRunBridgeWithLayout prim
        sourceProgram targetProgram returns loopLayout retc fuel sourceCtx
        (targetCtx.withLayout preparedLayout) hiddenReturns body lowerBody
        source target :=
    hCallbacks.block (returns := returns) (loopLayout := loopLayout)
      (liveCtx := liveCtx.withProtectedLayout preparedLayout)
      (after := Checked.scopedAfter preparedLayout restLive)
      (outLayout := bodyLayout) (baseLayout := preparedLayout)
      (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
      (targetCtx := targetCtx.withLayout preparedLayout)
      (hiddenReturns := hiddenReturns) (block := body)
      (lowerBlock := lowerBody) (source := source) (target := target)
      (sourceResult := sourceOpenResult) hFuelLe
      (by simpa [Locals.Ctx.withLayout] using hLowerBody)
      hSourceOpen
      (by simpa [Locals.Ctx.withLayout] using hStateRel)
      hBodyNoCall hBodyScoped hSourceNoDup hPreparedOutcomeCleanup
      (by simpa [Locals.Ctx.withLayout] using hPreparedNoDup)
      hReturnsLen hLeaveFrame
      (by
        intro hMode targetDepth hDepth
        have hDepthBase : targetCtx.breakDepth? = some targetDepth := by
          simpa [Locals.Ctx.withLayout] using hDepth
        have hLe := hBreakDepthProtected hMode hDepthBase
        have hProtectedMono :
            liveCtx.protectedDepth ≤
              (liveCtx.withProtectedLayout preparedLayout).protectedDepth := by
          simp [Ctx.withProtectedLayout, Ctx.withProtectedSuffixDepth,
            Ctx.protectedDepth]
          omega
        exact Nat.le_trans hLe hProtectedMono)
      (by
        intro hMode targetDepth hDepth
        have hDepthBase : targetCtx.continueDepth? = some targetDepth := by
          simpa [Locals.Ctx.withLayout] using hDepth
        have hLe := hContinueDepthProtected hMode hDepthBase
        have hProtectedMono :
            liveCtx.protectedDepth ≤
              (liveCtx.withProtectedLayout preparedLayout).protectedDepth := by
          simp [Ctx.withProtectedLayout, Ctx.withProtectedSuffixDepth,
            Ctx.protectedDepth]
          omega
        exact Nat.le_trans hLe hProtectedMono)

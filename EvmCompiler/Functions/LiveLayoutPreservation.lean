          refine
            ⟨(Source.Outcome.regular
                (Locals.Source.State.restrictTo sourceCtx.scope sourceState),
                sourceCtx),
              stmtTargetFuel,
              (Structured.Outcome.regular targetScoped, targetCtx),
              hSourceStmt, hTargetBlock, hResultRel, ?_⟩
          exact SourceDirect.CleanupLayoutRel.refl targetCtx.layout
      | brk =>
          have hNonregular :
              ({ state := sourceState, mode := Locals.Source.Mode.brk } :
                Source.Outcome).mode ≠ .regular := by
            simp
          have hTargetNonregular :
              targetOutcome.mode ≠ .regular :=
            SourceDirectBridge.LiveBlockOpenResultRel.target_nonregular_of_source_nonregular
              hOpenRel hNonregular
          rcases blockScoped_nonregular_from_open
              (prim := prim) (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (retc := retc) (sourceFuel := sourceFuel)
              (targetFuel := bodyTargetFuel) (sourceCtx := sourceCtx)
              (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
              (targetCtxOut := targetCtxOut)
              (hiddenReturns := hiddenReturns) (source := source)
              (target := target)
              (sourceOutcome :=
                { state := sourceState, mode := Locals.Source.Mode.brk })
              (targetOutcome := targetOutcome) (block := body)
              (targetBlock := lowerBody)
              hSourceOpen hTargetOpen hOpenRel hNonregular with
            ⟨hSourceScoped, hTargetScoped, _hOutcomeRel⟩
          have hSourceStmt :
              Source.Stmt.run prim sourceProgram sourceCtx sourceFuel
                  (.block body) source =
                .ok
                  (({ state := sourceState,
                      mode := Locals.Source.Mode.brk } : Source.Outcome),
                    sourceCtx) := by
            simp [Source.Stmt.run, hSourceScoped]
          have hTargetStmt :
              Locals.Direct.Stmt.run targetProgram targetCtx bodyTargetFuel
                  (.block lowerBody) target =
                .ok (targetOutcome, targetCtx) := by
            simp [Locals.Direct.Stmt.run, hTargetScoped]
          rcases Target.runOpen_singleton_nonregular_exists
              (program := targetProgram) hTargetStmt hTargetNonregular with
            ⟨stmtTargetFuel, hTargetBlock⟩
          have hResultRel :
              SourceDirectBridge.LiveLoopStmtRunResultRel retc returns
                loopLayout hiddenReturns
                (({ state := sourceState,
                    mode := Locals.Source.Mode.brk } : Source.Outcome),
                  sourceCtx)
                (targetOutcome, targetCtx) := by
            rcases targetOutcome with ⟨targetState, targetMode⟩
            cases targetMode <;>
              simp [SourceDirectBridge.LiveLoopBlockOpenResultRel,
                SourceDirectBridge.LiveLoopStmtRunResultRel,
                SourceDirect.StmtOutcomeRel] at hLoopRel ⊢
            exact ⟨hLoopRel.1, hCtx⟩
          refine
            ⟨(({ state := sourceState,
                  mode := Locals.Source.Mode.brk } : Source.Outcome),
                sourceCtx),
              stmtTargetFuel, (targetOutcome, targetCtx), hSourceStmt,
              hTargetBlock, hResultRel, ?_⟩
          simp [SourceDirectBridge.LiveStmtRegularLayoutRelTo]
      | cont =>
          have hNonregular :
              ({ state := sourceState, mode := Locals.Source.Mode.cont } :
                Source.Outcome).mode ≠ .regular := by
            simp
          have hTargetNonregular :
              targetOutcome.mode ≠ .regular :=
            SourceDirectBridge.LiveBlockOpenResultRel.target_nonregular_of_source_nonregular
              hOpenRel hNonregular
          rcases blockScoped_nonregular_from_open
              (prim := prim) (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (retc := retc) (sourceFuel := sourceFuel)
              (targetFuel := bodyTargetFuel) (sourceCtx := sourceCtx)
              (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
              (targetCtxOut := targetCtxOut)
              (hiddenReturns := hiddenReturns) (source := source)
              (target := target)
              (sourceOutcome :=
                { state := sourceState, mode := Locals.Source.Mode.cont })
              (targetOutcome := targetOutcome) (block := body)
              (targetBlock := lowerBody)
              hSourceOpen hTargetOpen hOpenRel hNonregular with
            ⟨hSourceScoped, hTargetScoped, _hOutcomeRel⟩
          have hSourceStmt :
              Source.Stmt.run prim sourceProgram sourceCtx sourceFuel
                  (.block body) source =
                .ok
                  (({ state := sourceState,
                      mode := Locals.Source.Mode.cont } : Source.Outcome),
                    sourceCtx) := by
            simp [Source.Stmt.run, hSourceScoped]
          have hTargetStmt :
              Locals.Direct.Stmt.run targetProgram targetCtx bodyTargetFuel
                  (.block lowerBody) target =
                .ok (targetOutcome, targetCtx) := by
            simp [Locals.Direct.Stmt.run, hTargetScoped]
          rcases Target.runOpen_singleton_nonregular_exists
              (program := targetProgram) hTargetStmt hTargetNonregular with
            ⟨stmtTargetFuel, hTargetBlock⟩
          have hResultRel :
              SourceDirectBridge.LiveLoopStmtRunResultRel retc returns
                loopLayout hiddenReturns
                (({ state := sourceState,
                    mode := Locals.Source.Mode.cont } : Source.Outcome),
                  sourceCtx)
                (targetOutcome, targetCtx) := by
            rcases targetOutcome with ⟨targetState, targetMode⟩
            cases targetMode <;>
              simp [SourceDirectBridge.LiveLoopBlockOpenResultRel,
                SourceDirectBridge.LiveLoopStmtRunResultRel,
                SourceDirect.StmtOutcomeRel] at hLoopRel ⊢
            exact ⟨hLoopRel.1, hCtx⟩
          refine
            ⟨(({ state := sourceState,
                  mode := Locals.Source.Mode.cont } : Source.Outcome),
                sourceCtx),
              stmtTargetFuel, (targetOutcome, targetCtx), hSourceStmt,
              hTargetBlock, hResultRel, ?_⟩
          simp [SourceDirectBridge.LiveStmtRegularLayoutRelTo]
      | leave =>
          have hNonregular :
              ({ state := sourceState, mode := Locals.Source.Mode.leave } :
                Source.Outcome).mode ≠ .regular := by
            simp
          have hTargetNonregular :
              targetOutcome.mode ≠ .regular :=
            SourceDirectBridge.LiveBlockOpenResultRel.target_nonregular_of_source_nonregular
              hOpenRel hNonregular
          rcases blockScoped_nonregular_from_open
              (prim := prim) (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (retc := retc) (sourceFuel := sourceFuel)
              (targetFuel := bodyTargetFuel) (sourceCtx := sourceCtx)
              (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
              (targetCtxOut := targetCtxOut)
              (hiddenReturns := hiddenReturns) (source := source)
              (target := target)
              (sourceOutcome :=
                { state := sourceState, mode := Locals.Source.Mode.leave })
              (targetOutcome := targetOutcome) (block := body)
              (targetBlock := lowerBody)
              hSourceOpen hTargetOpen hOpenRel hNonregular with
            ⟨hSourceScoped, hTargetScoped, _hOutcomeRel⟩
          have hSourceStmt :
              Source.Stmt.run prim sourceProgram sourceCtx sourceFuel
                  (.block body) source =
                .ok
                  (({ state := sourceState,
                      mode := Locals.Source.Mode.leave } : Source.Outcome),
                    sourceCtx) := by
            simp [Source.Stmt.run, hSourceScoped]
          have hTargetStmt :
              Locals.Direct.Stmt.run targetProgram targetCtx bodyTargetFuel
                  (.block lowerBody) target =
                .ok (targetOutcome, targetCtx) := by
            simp [Locals.Direct.Stmt.run, hTargetScoped]
          rcases Target.runOpen_singleton_nonregular_exists
              (program := targetProgram) hTargetStmt hTargetNonregular with
            ⟨stmtTargetFuel, hTargetBlock⟩
          have hResultRel :
              SourceDirectBridge.LiveLoopStmtRunResultRel retc returns
                loopLayout hiddenReturns
                (({ state := sourceState,
                    mode := Locals.Source.Mode.leave } : Source.Outcome),
                  sourceCtx)
                (targetOutcome, targetCtx) := by
            rcases targetOutcome with ⟨targetState, targetMode⟩
            cases targetMode <;>
              simp [SourceDirectBridge.LiveLoopBlockOpenResultRel,
                SourceDirectBridge.LiveLoopStmtRunResultRel,
                SourceDirect.StmtOutcomeRel] at hLoopRel ⊢
            exact ⟨hLoopRel.1, hCtx⟩
          refine
            ⟨(({ state := sourceState,
                  mode := Locals.Source.Mode.leave } : Source.Outcome),
                sourceCtx),
              stmtTargetFuel, (targetOutcome, targetCtx), hSourceStmt,
              hTargetBlock, hResultRel, ?_⟩
          simp [SourceDirectBridge.LiveStmtRegularLayoutRelTo]
      | halt kind =>
          have hNonregular :
              (Source.Outcome.halt kind sourceState).mode ≠ .regular := by
            simp [Source.Outcome.halt, Locals.Source.Outcome.halt]
          have hTargetNonregular :
              targetOutcome.mode ≠ .regular :=
            SourceDirectBridge.LiveBlockOpenResultRel.target_nonregular_of_source_nonregular
              hOpenRel hNonregular
          rcases blockScoped_nonregular_from_open
              (prim := prim) (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (retc := retc) (sourceFuel := sourceFuel)
              (targetFuel := bodyTargetFuel) (sourceCtx := sourceCtx)
              (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
              (targetCtxOut := targetCtxOut)
              (hiddenReturns := hiddenReturns) (source := source)
              (target := target)
              (sourceOutcome := Source.Outcome.halt kind sourceState)
              (targetOutcome := targetOutcome) (block := body)
              (targetBlock := lowerBody)
              hSourceOpen hTargetOpen hOpenRel hNonregular with
            ⟨hSourceScoped, hTargetScoped, _hOutcomeRel⟩
          have hSourceStmt :
              Source.Stmt.run prim sourceProgram sourceCtx sourceFuel
                  (.block body) source =
                .ok (Source.Outcome.halt kind sourceState, sourceCtx) := by
            simp [Source.Stmt.run, hSourceScoped]
          have hTargetStmt :
              Locals.Direct.Stmt.run targetProgram targetCtx bodyTargetFuel
                  (.block lowerBody) target =
                .ok (targetOutcome, targetCtx) := by
            simp [Locals.Direct.Stmt.run, hTargetScoped]
          rcases Target.runOpen_singleton_nonregular_exists
              (program := targetProgram) hTargetStmt hTargetNonregular with
            ⟨stmtTargetFuel, hTargetBlock⟩
          have hResultRel :
              SourceDirectBridge.LiveLoopStmtRunResultRel retc returns
                loopLayout hiddenReturns
                (Source.Outcome.halt kind sourceState, sourceCtx)
                (targetOutcome, targetCtx) := by
            rcases targetOutcome with ⟨targetState, targetMode⟩
            cases targetMode <;>
              simp [SourceDirectBridge.LiveLoopBlockOpenResultRel,
                SourceDirectBridge.LiveLoopStmtRunResultRel,
                SourceDirect.StmtOutcomeRel, Source.Outcome.halt,
                Locals.Source.Outcome.halt] at hLoopRel ⊢
            exact ⟨hLoopRel.1, hCtx⟩
          refine
            ⟨(Source.Outcome.halt kind sourceState, sourceCtx),
              stmtTargetFuel, (targetOutcome, targetCtx), hSourceStmt,
              hTargetBlock, hResultRel, ?_⟩
          simp [SourceDirectBridge.LiveStmtRegularLayoutRelTo,
            Source.Outcome.halt, Locals.Source.Outcome.halt]

theorem block_liveStmtRunBridge_of_lower
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name} {liveCtx : Ctx} {after nextLayout : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {body : Block} {lowerStmt : List Locals.Stmt}
    (hLower :
      Lower.Stmt.toLocals? returns liveCtx targetCtx.layout after
        (.block body) = some (lowerStmt, nextLayout))
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hBody :
      ∀ {lowerBody bodyLayout},
        Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout targetCtx.layout) targetCtx.layout
          (Checked.scopedAfter targetCtx.layout after) body =
          some (lowerBody, bodyLayout) →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
          targetProgram returns retc fuel sourceCtx targetCtx hiddenReturns
          body lowerBody source target) :
    SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
      returns retc fuel sourceCtx targetCtx hiddenReturns (.block body)
      { stmts := lowerStmt } source target := by
  simp only [Lower.Stmt.toLocals?] at hLower
  let bodyCtx := liveCtx.withProtectedLayout targetCtx.layout
  cases hLowerBody :
      Lower.Block.toLocals? returns bodyCtx targetCtx.layout
        (Checked.scopedAfter targetCtx.layout after) body with
  | none =>
      simp [bodyCtx, hLowerBody] at hLower
  | some lowered =>
      rcases lowered with ⟨lowerBody, bodyLayout⟩
      simp [bodyCtx, hLowerBody] at hLower
      rcases hLower with ⟨rfl, _hNextLayout⟩
      exact
        block_liveStmtRunBridge_of_open_bridge_with_layout
          (prim := prim) (sourceProgram := sourceProgram)
          (targetProgram := targetProgram) (returns := returns)
          (retc := retc) (sourceFuel := fuel) (sourceCtx := sourceCtx)
          (targetCtx := targetCtx) (hiddenReturns := hiddenReturns)
          (source := source) (target := target) (body := body)
          (lowerBody := lowerBody) hCtx (hBody hLowerBody)

theorem block_liveLoopStmtRunBridge_of_lower
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns loopLayout : List Name}
    {liveCtx : Ctx} {after nextLayout : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {body : Block} {lowerStmt : List Locals.Stmt}
    (hLower :
      Lower.Stmt.toLocals? returns liveCtx targetCtx.layout after
        (.block body) = some (lowerStmt, nextLayout))
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hBody :
      ∀ {lowerBody bodyLayout},
        Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout targetCtx.layout) targetCtx.layout
          (Checked.scopedAfter targetCtx.layout after) body =
          some (lowerBody, bodyLayout) →
        SourceDirectBridge.LiveLoopBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns loopLayout retc fuel sourceCtx
          targetCtx hiddenReturns body lowerBody source target) :
    SourceDirectBridge.LiveLoopStmtRunBridgeWithLayout prim sourceProgram
      targetProgram returns loopLayout retc fuel sourceCtx targetCtx
      hiddenReturns (.block body) { stmts := lowerStmt } source target := by
  simp only [Lower.Stmt.toLocals?] at hLower
  let bodyCtx := liveCtx.withProtectedLayout targetCtx.layout
  cases hLowerBody :
      Lower.Block.toLocals? returns bodyCtx targetCtx.layout
        (Checked.scopedAfter targetCtx.layout after) body with
  | none =>
      simp [bodyCtx, hLowerBody] at hLower
  | some lowered =>
      rcases lowered with ⟨lowerBody, bodyLayout⟩
      simp [bodyCtx, hLowerBody] at hLower
      rcases hLower with ⟨rfl, _hNextLayout⟩
      exact
        block_liveLoopStmtRunBridge_of_open_bridge_with_layout
          (prim := prim) (sourceProgram := sourceProgram)
          (targetProgram := targetProgram) (returns := returns)
          (loopLayout := loopLayout)
          (retc := retc) (sourceFuel := fuel) (sourceCtx := sourceCtx)
          (targetCtx := targetCtx) (hiddenReturns := hiddenReturns)
          (source := source) (target := target) (body := body)
          (lowerBody := lowerBody) hCtx (hBody hLowerBody)

theorem if_liveStmtRunBridge_of_lower
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name} {liveCtx : Ctx} {after nextLayout : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source sourceAfterCond : Source.State}
    {target : Locals.RunState}
    {cond : Expr 1} {body : Block}
    {lowerStmt : List Locals.Stmt} {value : Word}
    (hLower :
      Lower.Stmt.toLocals? returns liveCtx targetCtx.layout after
        (.if_ cond body) = some (lowerStmt, nextLayout))
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hNoDup : targetCtx.layout.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned cond)
    (hAccess :
      Locals.SourceLowering.Expr.Accessible targetCtx.layout 0 cond)
    (hRel :
      SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hEvalOne :
      Source.Expr.evalOne prim cond source = .ok (sourceAfterCond, value))
    (hBody :
      ∀ {lowerBody bodyLayout targetAfterCond},
        Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout targetCtx.layout) targetCtx.layout
          (Checked.scopedAfter targetCtx.layout after) body =
          some (lowerBody, bodyLayout) →
        SourceDirect.StateRel targetCtx.layout hiddenReturns sourceAfterCond
          targetAfterCond →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
          targetProgram returns retc fuel sourceCtx targetCtx hiddenReturns
          body lowerBody sourceAfterCond targetAfterCond) :
    SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
      returns retc (fuel + 1) sourceCtx targetCtx hiddenReturns
      (.if_ cond body) { stmts := lowerStmt } source target := by
  simp only [Lower.Stmt.toLocals?] at hLower
  let bodyCtx := liveCtx.withProtectedLayout targetCtx.layout
  cases hLowerBody :
      Lower.Block.toLocals? returns bodyCtx targetCtx.layout
        (Checked.scopedAfter targetCtx.layout after) body with
  | none =>
      simp [bodyCtx, hLowerBody] at hLower
  | some lowered =>
      rcases lowered with ⟨lowerBody, bodyLayout⟩
      simp [bodyCtx, hLowerBody] at hLower
      rcases hLower with ⟨rfl, _hNextLayout⟩
      rcases SourceDirect.Expr.evalCondition_bridge_sourceOwned hPrim rfl
          hNoDup hOwned hAccess hRel hEvalOne with
        ⟨targetAfterCond, hSourceCond, hTargetCond, hCondRel⟩
      cases hTruth : (value != EvmYul.UInt256.ofNat 0) with
      | false =>
          have hSourceStmt :
              Source.Stmt.run prim sourceProgram sourceCtx (fuel + 1)
                  (.if_ cond body) source =
                .ok (Source.Outcome.regular sourceAfterCond, sourceCtx) := by
            simp [Source.Stmt.run, hSourceCond, hTruth]
          have hTargetStmt :
              Locals.Direct.Stmt.run targetProgram targetCtx (fuel + 1)
                  (.if_ cond lowerBody) target =
                .ok (Structured.Outcome.regular targetAfterCond, targetCtx) := by
            simp [Locals.Direct.Stmt.run, hTargetCond, hTruth]
          rcases Target.runOpen_singleton_regular_exists
              (program := targetProgram) hTargetStmt with
            ⟨targetFuel, hTargetBlock⟩
          exact
            ⟨(Source.Outcome.regular sourceAfterCond, sourceCtx), targetFuel,
              (Structured.Outcome.regular targetAfterCond, targetCtx),
              hSourceStmt, hTargetBlock,
              SourceDirectBridge.LiveStmtRunResultRel.regular hCondRel hCtx⟩
      | true =>
          have hSourceCondTrue :
              Source.Expr.evalCondition prim cond source =
                .ok (sourceAfterCond, true) := by
            simpa [hTruth] using hSourceCond
          have hTargetCondTrue :
              Locals.Direct.Expr.runCondition targetCtx cond target =
                .ok (targetAfterCond, true) := by
            simpa [hTruth] using hTargetCond
          rcases hBody hLowerBody hCondRel with
            ⟨sourceOpenResult, bodyTargetFuel, targetOpenResult, hSourceOpen,
              hTargetOpen, hOpenRel, hOpenLayout⟩
          rcases sourceOpenResult with ⟨sourceOutcome, sourceCtxOut⟩
          rcases targetOpenResult with ⟨targetOutcome, targetCtxOut⟩
          cases sourceOutcome with
          | mk sourceState sourceMode =>
              cases sourceMode with
              | regular =>
                  rcases
                      SourceDirectBridge.LiveBlockOpenResultRel.source_regular_target_regular
                        hOpenRel with
                    ⟨targetInner, hTargetOutcomeEq, _hOpenStateRel,
                      _hOpenCtxRel⟩
                  subst targetOutcome
                  have hLayout :
                      SourceDirect.CleanupLayoutRel targetCtxOut.layout
                        targetCtx.layout := by
                    simpa [SourceDirectBridge.LiveBlockOpenRegularLayoutRel,
                      SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo]
                      using hOpenLayout
                  rcases blockScoped_regular_from_open
                      (prim := prim) (sourceProgram := sourceProgram)
                      (targetProgram := targetProgram) (returns := returns)
                      (retc := retc) (sourceFuel := fuel)
                      (targetFuel := bodyTargetFuel)
                      (sourceCtx := sourceCtx) (sourceCtxOut := sourceCtxOut)
                      (targetCtx := targetCtx) (targetCtxOut := targetCtxOut)
                      (hiddenReturns := hiddenReturns)
                      (source := sourceAfterCond) (sourceInner := sourceState)
                      (target := targetAfterCond) (targetInner := targetInner)
                      (block := body) (targetBlock := lowerBody)
                      hCtx hSourceOpen hTargetOpen hOpenRel hLayout with
                    ⟨targetScoped, hSourceScoped, hTargetScoped, hScopedRel⟩
                  have hSourceStmt :
                      Source.Stmt.run prim sourceProgram sourceCtx (fuel + 1)
                          (.if_ cond body) source =
                        .ok
                          (Source.Outcome.regular
                            (Locals.Source.State.restrictTo sourceCtx.scope
                              sourceState),
                            sourceCtx) := by
                    simp [Source.Stmt.run, hSourceCondTrue, hSourceScoped]
                  have hTargetStmt :
                      Locals.Direct.Stmt.run targetProgram targetCtx
                          (bodyTargetFuel + 1) (.if_ cond lowerBody) target =
                        .ok
                          (Structured.Outcome.regular targetScoped,
                            targetCtx) := by
                    simp [Locals.Direct.Stmt.run, hTargetCondTrue,
                      hTargetScoped]
                  rcases Target.runOpen_singleton_regular_exists
                      (program := targetProgram) hTargetStmt with
                    ⟨targetFuel, hTargetBlock⟩
                  have hScopedStateRel :
                      SourceDirect.StateRel targetCtx.layout hiddenReturns
                        (Locals.Source.State.restrictTo sourceCtx.scope
                          sourceState)
                        targetScoped :=
                    SourceDirectBridge.LiveBlockScopedOutcomeRel.regular_stateRel
                      hScopedRel
                  exact
                    ⟨(Source.Outcome.regular
                        (Locals.Source.State.restrictTo sourceCtx.scope
                          sourceState),
                        sourceCtx),
                      targetFuel,
                      (Structured.Outcome.regular targetScoped, targetCtx),
                      hSourceStmt, hTargetBlock,
                      SourceDirectBridge.LiveStmtRunResultRel.regular
                        hScopedStateRel hCtx⟩
              | brk =>
                  have hNonregular :
                      ({ state := sourceState,
                          mode := Locals.Source.Mode.brk } :
                        Source.Outcome).mode ≠ .regular := by
                    simp
                  have hTargetNonregular :
                      targetOutcome.mode ≠ .regular :=
                    SourceDirectBridge.LiveBlockOpenResultRel.target_nonregular_of_source_nonregular
                      hOpenRel hNonregular
                  rcases blockScoped_nonregular_from_open
                      (prim := prim) (sourceProgram := sourceProgram)
                      (targetProgram := targetProgram) (returns := returns)
                      (retc := retc) (sourceFuel := fuel)
                      (targetFuel := bodyTargetFuel)
                      (sourceCtx := sourceCtx) (sourceCtxOut := sourceCtxOut)

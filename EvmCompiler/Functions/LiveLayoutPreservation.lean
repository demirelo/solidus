    {sourceProgram : Program} {targetProgram : Locals.Program} :
    ∀ maxFuel,
      ScopedNoInternalCallShapeRecursiveOpenBlockLayoutToOutcomeAnyEntryCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel := by
  intro maxFuel
  exact
    (allFuel_callback_families
      (prim := prim) hPrim (sourceProgram := sourceProgram)
      (targetProgram := targetProgram) maxFuel).1

theorem loopOpenBlock_allFuel
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {sourceProgram : Program} {targetProgram : Locals.Program} :
    ∀ maxFuel,
      ScopedNoInternalCallShapeRecursiveLoopOpenBlockLayoutToOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel := by
  intro maxFuel
  exact
    (allFuel_callback_families
      (prim := prim) hPrim (sourceProgram := sourceProgram)
      (targetProgram := targetProgram) maxFuel).2

theorem openBlock_allFuel
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {sourceProgram : Program} {targetProgram : Locals.Program} :
    ∀ maxFuel,

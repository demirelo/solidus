theorem stmtList_cons_runBridge_of_lower_components_with_layout
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {rest : List Stmt}
    {stmtLive : List Name} {lowerStmt lowerRest : List Locals.Stmt}
    {source : Source.State} {target : Locals.RunState}
    (hStateRel :
      SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hEntryLayout :
      SourceDirect.CleanupLayoutRel
        (Layout.trimDeadPrefix targetCtx.layout stmtLive) targetCtx.layout)
    (hHead :
      ∀ {cleaned},
        SourceDirect.StateRel
          (Layout.trimDeadPrefix targetCtx.layout stmtLive) hiddenReturns
          source cleaned →
        SourceDirectBridge.LiveStmtRunBridgeWithLayout prim sourceProgram
          targetProgram returns retc fuel sourceCtx
          (targetCtx.withLayout
            (Layout.trimDeadPrefix targetCtx.layout stmtLive))
          hiddenReturns stmt { stmts := lowerStmt } source cleaned)
    (hTail :
      ∀ {sourceAfter : Source.State} {targetAfter : Locals.RunState}
        {sourceCtxAfter : Source.Ctx} {targetCtxAfter : Locals.Ctx},
        SourceDirect.StateRel targetCtxAfter.layout hiddenReturns sourceAfter
          targetAfter →
        SourceDirectBridge.LiveCtxRel retc sourceCtxAfter targetCtxAfter →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
          targetProgram returns retc fuel sourceCtxAfter targetCtxAfter
          hiddenReturns { stmts := rest } { stmts := lowerRest } sourceAfter
          targetAfter) :
    SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
      targetProgram returns retc (fuel + 1) sourceCtx targetCtx hiddenReturns
      { stmts := stmt :: rest }
      { stmts :=
          Lower.cleanupToLive targetCtx.layout stmtLive ::
            lowerStmt ++ lowerRest } source target := by
  rcases Target.cleanupToLive_runOpen_exists
      (program := targetProgram) (ctx := targetCtx) (live := stmtLive)
      hStateRel with
    ⟨cleaned, cleanupFuel, hCleanup, hCleanRel⟩
  rcases hHead hCleanRel with
    ⟨sourceHeadResult, stmtTargetFuel, targetHeadResult, hSourceHead,
      hTargetHead, hHeadRel, hHeadLayoutRel⟩
  rcases sourceHeadResult with ⟨sourceHead, stmtSourceCtx⟩
  rcases targetHeadResult with ⟨targetHead, targetRunCtx⟩
  rcases
      Locals.Direct.Block.runOpen_append_regular_exists targetProgram
        [Lower.cleanupToLive targetCtx.layout stmtLive] lowerStmt targetCtx
        (targetCtx.withLayout
          (Layout.trimDeadPrefix targetCtx.layout stmtLive))
        target cleaned targetHead targetRunCtx
        ⟨cleanupFuel, by simpa [Lower.cleanupToLive] using hCleanup⟩
        ⟨stmtTargetFuel, hTargetHead⟩ with
    ⟨targetHeadFuel, hTargetHeadBlock⟩
  cases sourceHead with
  | mk sourceAfter sourceMode =>
      cases sourceMode with
      | regular =>
          rcases
              SourceDirectBridge.LiveStmtRunResultRel.source_regular_target_regular
                hHeadRel with
            ⟨targetAfter, hTargetHeadEq, hHeadStateRel, hHeadCtxRel⟩
          subst targetHead
          have hHeadLayout :
              SourceDirect.CleanupLayoutRel targetRunCtx.layout
                (Layout.trimDeadPrefix targetCtx.layout stmtLive) := by
            simpa [SourceDirectBridge.LiveStmtRegularLayoutRel,
              SourceDirectBridge.LiveStmtRegularLayoutRelTo,
              Locals.Ctx.withLayout] using hHeadLayoutRel
          rcases hTail hHeadStateRel hHeadCtxRel with
            ⟨sourceTailResult, tailTargetFuel, targetTailResult, hSourceTail,
              hTargetTail, hTailRel, hTailLayoutRel⟩
          rcases targetTailResult with ⟨targetTail, targetTailCtx⟩
          rcases
              Locals.Direct.Block.runOpen_append_regular_exists targetProgram
                (Lower.cleanupToLive targetCtx.layout stmtLive :: lowerStmt)
                lowerRest targetCtx targetRunCtx target targetAfter
                targetTail targetTailCtx
                ⟨targetHeadFuel, by
                  simpa [Lower.cleanupToLive] using hTargetHeadBlock⟩
                ⟨tailTargetFuel, hTargetTail⟩ with
            ⟨blockFuel, hTargetAppend⟩
          refine
            ⟨sourceTailResult, blockFuel, (targetTail, targetTailCtx),
              ?_, hTargetAppend, hTailRel, ?_⟩
          · simp [Source.Block.runOpen, hSourceHead]
            change
              Source.Block.runOpen prim sourceProgram stmtSourceCtx fuel
                { stmts := rest } sourceAfter = .ok sourceTailResult
            exact hSourceTail
          · rcases sourceTailResult with ⟨sourceTail, sourceTailCtx⟩
            cases sourceTail with
            | mk sourceTailState sourceTailMode =>
                cases targetTail with
                | mk targetTailState targetTailMode =>
                    cases sourceTailMode <;> cases targetTailMode <;>
                      simp [SourceDirectBridge.LiveBlockOpenRegularLayoutRel,
                        SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo]
                        at hTailLayoutRel ⊢
                    exact
                      SourceDirect.CleanupLayoutRel.trans hTailLayoutRel
                        (SourceDirect.CleanupLayoutRel.trans hHeadLayout
                          hEntryLayout)
      | brk =>
          have hNonregular :
              ({ state := sourceAfter, mode := Locals.Source.Mode.brk } :
                Source.Outcome).mode ≠ .regular := by
            simp
          have hSourceCtx :=
            Source.Stmt.run_nonregular_ctx hSourceHead hNonregular
          have hTargetNonregular :
              targetHead.mode ≠ .regular :=
            SourceDirectBridge.LiveStmtRunResultRel.target_nonregular_of_source_nonregular
              hHeadRel hNonregular
          rcases
              Locals.Direct.Block.runOpen_append_nonregular_exists
                targetProgram
                (Lower.cleanupToLive targetCtx.layout stmtLive :: lowerStmt)
                lowerRest targetCtx target targetHead targetRunCtx
                ⟨targetHeadFuel, by
                  simpa [Lower.cleanupToLive] using hTargetHeadBlock⟩
                hTargetNonregular with
            ⟨blockFuel, hTargetAppend⟩
          refine
            ⟨(({ state := sourceAfter, mode := Locals.Source.Mode.brk } :
                Source.Outcome), sourceCtx), blockFuel,
              (targetHead, targetRunCtx), ?_, hTargetAppend, ?_, ?_⟩
          · simp [Source.Block.runOpen, hSourceHead]
          · exact
              SourceDirectBridge.LiveBlockOpenResultRel.of_stmt_nonregular
                hHeadRel hSourceCtx hNonregular
          · simp [SourceDirectBridge.LiveBlockOpenRegularLayoutRel,
              SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo]
      | cont =>
          have hNonregular :
              ({ state := sourceAfter, mode := Locals.Source.Mode.cont } :
                Source.Outcome).mode ≠ .regular := by
            simp
          have hSourceCtx :=
            Source.Stmt.run_nonregular_ctx hSourceHead hNonregular
          have hTargetNonregular :
              targetHead.mode ≠ .regular :=
            SourceDirectBridge.LiveStmtRunResultRel.target_nonregular_of_source_nonregular
              hHeadRel hNonregular
          rcases
              Locals.Direct.Block.runOpen_append_nonregular_exists
                targetProgram
                (Lower.cleanupToLive targetCtx.layout stmtLive :: lowerStmt)
                lowerRest targetCtx target targetHead targetRunCtx
                ⟨targetHeadFuel, by
                  simpa [Lower.cleanupToLive] using hTargetHeadBlock⟩
                hTargetNonregular with
            ⟨blockFuel, hTargetAppend⟩
          refine
            ⟨(({ state := sourceAfter, mode := Locals.Source.Mode.cont } :
                Source.Outcome), sourceCtx), blockFuel,
              (targetHead, targetRunCtx), ?_, hTargetAppend, ?_, ?_⟩
          · simp [Source.Block.runOpen, hSourceHead]
          · exact
              SourceDirectBridge.LiveBlockOpenResultRel.of_stmt_nonregular
                hHeadRel hSourceCtx hNonregular
          · simp [SourceDirectBridge.LiveBlockOpenRegularLayoutRel,
              SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo]
      | leave =>
          have hNonregular :
              ({ state := sourceAfter, mode := Locals.Source.Mode.leave } :
                Source.Outcome).mode ≠ .regular := by
            simp
          have hSourceCtx :=
            Source.Stmt.run_nonregular_ctx hSourceHead hNonregular
          have hTargetNonregular :
              targetHead.mode ≠ .regular :=
            SourceDirectBridge.LiveStmtRunResultRel.target_nonregular_of_source_nonregular
              hHeadRel hNonregular
          rcases
              Locals.Direct.Block.runOpen_append_nonregular_exists
                targetProgram
                (Lower.cleanupToLive targetCtx.layout stmtLive :: lowerStmt)
                lowerRest targetCtx target targetHead targetRunCtx
                ⟨targetHeadFuel, by
                  simpa [Lower.cleanupToLive] using hTargetHeadBlock⟩
                hTargetNonregular with
            ⟨blockFuel, hTargetAppend⟩
          refine
            ⟨(({ state := sourceAfter, mode := Locals.Source.Mode.leave } :
                Source.Outcome), sourceCtx), blockFuel,
              (targetHead, targetRunCtx), ?_, hTargetAppend, ?_, ?_⟩
          · simp [Source.Block.runOpen, hSourceHead]
          · exact
              SourceDirectBridge.LiveBlockOpenResultRel.of_stmt_nonregular
                hHeadRel hSourceCtx hNonregular
          · simp [SourceDirectBridge.LiveBlockOpenRegularLayoutRel,
              SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo]
      | halt kind =>
          have hNonregular :
              (Source.Outcome.halt kind sourceAfter).mode ≠ .regular := by
            simp [Source.Outcome.halt, Locals.Source.Outcome.halt]
          have hSourceCtx :=
            Source.Stmt.run_nonregular_ctx hSourceHead hNonregular
          have hTargetNonregular :
              targetHead.mode ≠ .regular :=
            SourceDirectBridge.LiveStmtRunResultRel.target_nonregular_of_source_nonregular
              hHeadRel hNonregular
          rcases
              Locals.Direct.Block.runOpen_append_nonregular_exists
                targetProgram
                (Lower.cleanupToLive targetCtx.layout stmtLive :: lowerStmt)
                lowerRest targetCtx target targetHead targetRunCtx
                ⟨targetHeadFuel, by
                  simpa [Lower.cleanupToLive] using hTargetHeadBlock⟩
                hTargetNonregular with
            ⟨blockFuel, hTargetAppend⟩
          refine
            ⟨(Source.Outcome.halt kind sourceAfter, sourceCtx), blockFuel,
              (targetHead, targetRunCtx), ?_, hTargetAppend, ?_, ?_⟩
          · simp [Source.Block.runOpen, hSourceHead, Source.Outcome.halt,
              Locals.Source.Outcome.halt]
          · exact
              SourceDirectBridge.LiveBlockOpenResultRel.of_stmt_nonregular
                hHeadRel hSourceCtx hNonregular
          · simp [SourceDirectBridge.LiveBlockOpenRegularLayoutRel,
              SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo,
              Source.Outcome.halt, Locals.Source.Outcome.halt]

theorem stmtList_cons_runBridge_of_lower_components_with_layout_to
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name} {protectedDepth retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx} {baseLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {rest : List Stmt}
    {stmtLive liveLayout preparedLayout : List Name}
    {prep lowerStmt lowerRest : List Locals.Stmt}
    {source : Source.State} {target : Locals.RunState}
    (hLiveLayout :
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive)
    (hPrepare :
      Prepare.forStmtAboveSuffix? protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout))
    (hStateRel :
      SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hHead :
      ∀ {cleaned},
        SourceDirect.StateRel preparedLayout hiddenReturns source cleaned →
        SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
          returns retc fuel sourceCtx
          (targetCtx.withLayout preparedLayout)
          hiddenReturns stmt { stmts := lowerStmt } source cleaned)
    (hTail :
      ∀ {sourceAfter : Source.State} {targetAfter : Locals.RunState}
        {sourceCtxAfter : Source.Ctx} {targetCtxAfter : Locals.Ctx},
        SourceDirect.StateRel targetCtxAfter.layout hiddenReturns sourceAfter
          targetAfter →
        SourceDirectBridge.LiveCtxRel retc sourceCtxAfter targetCtxAfter →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayoutTo prim
          sourceProgram targetProgram returns retc fuel sourceCtxAfter
          targetCtxAfter baseLayout hiddenReturns { stmts := rest }
          { stmts := lowerRest } sourceAfter targetAfter) :
    SourceDirectBridge.LiveBlockOpenRunBridgeWithLayoutTo prim sourceProgram
      targetProgram returns retc (fuel + 1) sourceCtx targetCtx baseLayout
      hiddenReturns { stmts := stmt :: rest }
      { stmts :=
          Lower.cleanupToLive targetCtx.layout stmtLive ::
            (prep ++ (lowerStmt ++ lowerRest)) } source target := by
  rcases Target.cleanupToLive_runOpen_exists
      (program := targetProgram) (ctx := targetCtx) (live := stmtLive)
      hStateRel with
    ⟨cleaned, cleanupFuel, hCleanup, hCleanRel⟩
  rcases Target.prepareForStmtAboveSuffix_runOpen_exists
      (program := targetProgram) (protectedDepth := protectedDepth)
      (returns := returns) (live := stmtLive) (stmt := stmt)
      (ctx := targetCtx.withLayout liveLayout)
      (prep := prep) (finalLayout := preparedLayout)
      (hiddenReturns := hiddenReturns) (source := source)
      (target := cleaned)
      (by simpa [Locals.Ctx.withLayout] using hPrepare)
      (by simpa [Locals.Ctx.withLayout, hLiveLayout] using hCleanRel)
    with
    ⟨prepared, prepareFuel, hPrepareRun, hPreparedRel⟩
  rcases hHead hPreparedRel with
    ⟨sourceHeadResult, stmtTargetFuel, targetHeadResult, hSourceHead,
      hTargetHead, hHeadRel⟩
  rcases sourceHeadResult with ⟨sourceHead, stmtSourceCtx⟩
  rcases targetHeadResult with ⟨targetHead, targetRunCtx⟩
  rcases
      Locals.Direct.Block.runOpen_append_regular_exists targetProgram
        prep lowerStmt (targetCtx.withLayout liveLayout)
        (targetCtx.withLayout preparedLayout)
        cleaned prepared targetHead targetRunCtx
        ⟨prepareFuel,
          by simpa [Locals.Ctx.withLayout] using hPrepareRun⟩
        ⟨stmtTargetFuel, hTargetHead⟩ with
    ⟨targetPreparedHeadFuel, hTargetPreparedHeadBlock⟩
  rcases
      Locals.Direct.Block.runOpen_append_regular_exists targetProgram
        [Lower.cleanupToLive targetCtx.layout stmtLive]
        (prep ++ lowerStmt) targetCtx
        (targetCtx.withLayout liveLayout)
        target cleaned targetHead targetRunCtx
        ⟨cleanupFuel,
          by simpa [Lower.cleanupToLive, hLiveLayout] using hCleanup⟩
        ⟨targetPreparedHeadFuel,
          by simpa [Locals.Ctx.withLayout] using hTargetPreparedHeadBlock⟩ with
    ⟨targetHeadFuel, hTargetHeadBlock⟩
  cases sourceHead with
  | mk sourceAfter sourceMode =>
      cases sourceMode with
      | regular =>
          rcases
              SourceDirectBridge.LiveStmtRunResultRel.source_regular_target_regular
                hHeadRel with
            ⟨targetAfter, hTargetHeadEq, hHeadStateRel, hHeadCtxRel⟩
          subst targetHead
          rcases hTail hHeadStateRel hHeadCtxRel with
            ⟨sourceTailResult, tailTargetFuel, targetTailResult, hSourceTail,
              hTargetTail, hTailRel, hTailLayoutRel⟩
          rcases targetTailResult with ⟨targetTail, targetTailCtx⟩
          rcases
              Locals.Direct.Block.runOpen_append_regular_exists targetProgram
                (Lower.cleanupToLive targetCtx.layout stmtLive ::
                  (prep ++ lowerStmt))
                lowerRest targetCtx targetRunCtx target targetAfter
                targetTail targetTailCtx
                ⟨targetHeadFuel, by
                  simpa [Lower.cleanupToLive, List.append_assoc] using
                    hTargetHeadBlock⟩
                ⟨tailTargetFuel, hTargetTail⟩ with
            ⟨blockFuel, hTargetAppend⟩
          refine
            ⟨sourceTailResult, blockFuel, (targetTail, targetTailCtx),
              ?_, by simpa [List.append_assoc] using hTargetAppend,
              hTailRel, hTailLayoutRel⟩
          simp [Source.Block.runOpen, hSourceHead]
          change
            Source.Block.runOpen prim sourceProgram stmtSourceCtx fuel
              { stmts := rest } sourceAfter = .ok sourceTailResult
          exact hSourceTail
      | brk =>
          have hNonregular :
              ({ state := sourceAfter, mode := Locals.Source.Mode.brk } :
                Source.Outcome).mode ≠ .regular := by

          .ok sourceTailResult →
        SourceDirect.StateRel targetCtxAfter.layout hiddenReturns sourceAfter
          targetAfter →
        SourceDirectBridge.LiveCtxRel retc sourceCtxAfter targetCtxAfter →
        ∃ targetTailFuel targetTailResult,
          Locals.Direct.Block.runOpen targetProgram targetCtxAfter
              targetTailFuel { stmts := lowerRest } targetAfter =
            .ok targetTailResult ∧
          SourceDirectBridge.LiveBlockOpenResultRel retc returns hiddenReturns

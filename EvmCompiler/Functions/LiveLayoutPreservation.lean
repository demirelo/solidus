    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {sourceCtx sourceInitCtx : Source.Ctx}
    {fuel : Nat} {init : Block} {source sourceAfterInit : Source.State}
    (hSourceNoDup : sourceCtx.scope.Nodup)

              | halt kind =>
                  have hNonregular :
                      (Source.Outcome.halt kind sourceState).mode ≠
                        .regular := by
                    simp [Source.Outcome.halt, Locals.Source.Outcome.halt]
                  have hTargetNonregular :
                      targetOutcome.mode ≠ .regular :=
                    SourceDirectBridge.LiveBlockOpenResultRel.target_nonregular_of_source_nonregular
                      hOpenRel hNonregular
                  rcases blockScoped_nonregular_from_open
                      (prim := prim) (sourceProgram := sourceProgram)
                      (targetProgram := targetProgram) (returns := returns)
                      (retc := retc) (sourceFuel := fuel)
                      (targetFuel := bodyTargetFuel)
                      (sourceCtx := sourceCtx) (sourceCtxOut := sourceCtxOut)
                      (targetCtx := targetCtx) (targetCtxOut := targetCtxOut)
                      (hiddenReturns := hiddenReturns)
                      (source := sourceAfterCond) (target := targetAfterCond)
                      (sourceOutcome := Source.Outcome.halt kind sourceState)
                      (targetOutcome := targetOutcome) (block := body)
                      (targetBlock := lowerBody)
                      hSourceOpen hTargetOpen hOpenRel hNonregular with
                    ⟨hSourceScoped, hTargetScoped, _hOutcomeRel⟩
                  have hSourceStmt :
                      Source.Stmt.run prim sourceProgram sourceCtx (fuel + 1)
                          (.if_ cond body) source =
                        .ok (Source.Outcome.halt kind sourceState,
                          sourceCtx) := by
                    simp [Source.Stmt.run, hSourceCondTrue, hSourceScoped,
                      Source.Outcome.halt, Locals.Source.Outcome.halt]
                  have hTargetStmt :
                      Locals.Direct.Stmt.run targetProgram targetCtx
                          (bodyTargetFuel + 1) (.if_ cond lowerBody) target =
                        .ok (targetOutcome, targetCtx) := by
                    simp [Locals.Direct.Stmt.run, hTargetCondTrue,
                      hTargetScoped]
                  rcases Target.runOpen_singleton_nonregular_exists
                      (program := targetProgram) hTargetStmt
                      hTargetNonregular with
                    ⟨targetFuel, hTargetBlock⟩
                  have hResultRel :
                      SourceDirectBridge.LiveLoopStmtRunResultRel retc returns
                        loopLayout hiddenReturns
                        (Source.Outcome.halt kind sourceState, sourceCtx)
                        (targetOutcome, targetCtx) := by
                    rcases targetOutcome with ⟨targetState, targetMode⟩
                    cases targetMode <;>
                      simp [SourceDirectBridge.LiveLoopBlockOpenResultRel,
                        SourceDirectBridge.LiveLoopStmtRunResultRel,
                        Source.Outcome.halt, Locals.Source.Outcome.halt] at hLoopRel ⊢
                    exact ⟨hLoopRel.1, hCtx⟩
                  exact
                    ⟨(Source.Outcome.halt kind sourceState, sourceCtx),
                      targetFuel, (targetOutcome, targetCtx), hSourceStmt,
                      hTargetBlock, hResultRel,
                      by
                        simp [SourceDirectBridge.LiveStmtRegularLayoutRelTo,
                          Source.Outcome.halt,
                          Locals.Source.Outcome.halt]⟩

theorem if_liveLoopStmtRunBridge_from_source_run_of_lower
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns loopLayout : List Name}
    {liveCtx : Ctx} {after nextLayout : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {cond : Expr 1} {body : Block}
    {lowerStmt : List Locals.Stmt}
    {sourceResult : Source.Outcome × Source.Ctx}
    (hLower :
      Lower.Stmt.toLocals? returns liveCtx targetCtx.layout after
        (.if_ cond body) = some (lowerStmt, nextLayout))
    (hAccessCheck :
      StmtAccess.accessible? returns targetCtx.layout (.if_ cond body) =
        true)
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hNoDup : targetCtx.layout.Nodup)
    (hCondScoped : Scope.ExprScoped sourceCtx.scope cond)
    (hRel : SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hSourceRun :
      Source.Stmt.run prim sourceProgram sourceCtx (fuel + 1)
          (.if_ cond body) source =
        .ok sourceResult)
    (hBody :
      ∀ {sourceAfterCond : Source.State}
        {lowerBody bodyLayout targetAfterCond sourceOpenResult},
        Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout targetCtx.layout) targetCtx.layout
          (Checked.scopedAfter targetCtx.layout after) body =
          some (lowerBody, bodyLayout) →
        Source.Expr.evalCondition prim cond source =
          .ok (sourceAfterCond, true) →
        Source.Block.runOpen prim sourceProgram sourceCtx fuel body
          sourceAfterCond =
          .ok sourceOpenResult →
        SourceDirect.StateRel targetCtx.layout hiddenReturns sourceAfterCond
          targetAfterCond →
        SourceDirectBridge.LiveLoopBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns loopLayout retc fuel sourceCtx
          targetCtx hiddenReturns body lowerBody sourceAfterCond
          targetAfterCond) :
    SourceDirectBridge.LiveLoopStmtRunBridgeWithLayout prim sourceProgram
      targetProgram returns loopLayout retc (fuel + 1) sourceCtx targetCtx
      hiddenReturns (.if_ cond body) { stmts := lowerStmt } source target := by
  have hAccess :
      Locals.SourceLowering.Expr.Accessible targetCtx.layout 0 cond :=
    StmtAccess.accessible?_sound hAccessCheck
  have hOwned : Locals.Source.Expr.SourceOwned cond :=
    SourceDirect.SourceScope.exprScoped_sourceOwned hCondScoped
  cases hEvalOne : Source.Expr.evalOne prim cond source with
  | error err =>
      simp [Source.Stmt.run, Source.Expr.evalCondition,
        Locals.Source.Expr.evalCondition, hEvalOne] at hSourceRun
  | ok evalResult =>
      rcases evalResult with ⟨sourceAfterCond, value⟩
      rcases SourceDirect.Expr.evalCondition_bridge_sourceOwned hPrim rfl
          hNoDup hOwned hAccess hRel hEvalOne with
        ⟨targetAfterCond, hSourceCond, hTargetCond, hCondRel⟩
      cases hTruth : (value != EvmYul.UInt256.ofNat 0) with
      | false =>
          have hSourceStmt :
              Source.Stmt.run prim sourceProgram sourceCtx (fuel + 1)
                  (.if_ cond body) source =
                .ok (Source.Outcome.regular sourceAfterCond, sourceCtx) := by
            simp [Source.Stmt.run, hSourceCond, hTruth]
          simp only [Lower.Stmt.toLocals?] at hLower
          let bodyCtx := liveCtx.withProtectedLayout targetCtx.layout
          cases hLowerBody :
              Lower.Block.toLocals? returns bodyCtx targetCtx.layout
                (Checked.scopedAfter targetCtx.layout after) body with
          | none =>
              simp [bodyCtx, hLowerBody] at hLower
          | some lowered =>
              rcases lowered with ⟨lowerBody, bodyLayout⟩
              simp [bodyCtx, hLowerBody] at hLower
              rcases hLower with ⟨rfl, _hNextLayout⟩
              have hTargetStmt :
                  Locals.Direct.Stmt.run targetProgram targetCtx (fuel + 1)
                      (.if_ cond lowerBody) target =
                    .ok (Structured.Outcome.regular targetAfterCond,
                      targetCtx) := by
                simp [Locals.Direct.Stmt.run, hTargetCond, hTruth]
              rcases Target.runOpen_singleton_regular_exists
                  (program := targetProgram) hTargetStmt with
                ⟨targetFuel, hTargetBlock⟩
              have hResultRel :
                  SourceDirectBridge.LiveLoopStmtRunResultRel retc returns
                    loopLayout hiddenReturns
                    (Source.Outcome.regular sourceAfterCond, sourceCtx)
                    (Structured.Outcome.regular targetAfterCond,
                      targetCtx) := by
                simpa [SourceDirectBridge.LiveLoopStmtRunResultRel,
                  Source.Outcome.regular, Locals.Source.Outcome.regular,
                  Structured.Outcome.regular] using
                  (show
                    SourceDirect.StateRel targetCtx.layout hiddenReturns
                        sourceAfterCond targetAfterCond ∧
                      SourceDirectBridge.LiveCtxRel retc sourceCtx
                        targetCtx from
                    ⟨hCondRel, hCtx⟩)
              exact
                ⟨(Source.Outcome.regular sourceAfterCond, sourceCtx),
                  targetFuel,
                  (Structured.Outcome.regular targetAfterCond, targetCtx),
                  hSourceStmt, hTargetBlock, hResultRel,
                  SourceDirect.CleanupLayoutRel.refl targetCtx.layout⟩
      | true =>
          exact
            if_liveLoopStmtRunBridge_of_lower
              (prim := prim) hPrim (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (loopLayout := loopLayout)
              (liveCtx := liveCtx) (after := after)
              (nextLayout := nextLayout) (retc := retc) (fuel := fuel)
              (sourceCtx := sourceCtx) (targetCtx := targetCtx)
              (hiddenReturns := hiddenReturns) (source := source)
              (sourceAfterCond := sourceAfterCond) (target := target)
              (cond := cond) (body := body) (lowerStmt := lowerStmt)
              (value := value) hLower hCtx hNoDup hOwned hAccess hRel
              hEvalOne
              (fun {lowerBody bodyLayout targetAfterCond} hLowerBody
                  hCondRel => by
                cases hSourceScoped :
                    Source.Block.runScoped prim sourceProgram sourceCtx body
                      fuel sourceAfterCond with
                | error err =>
                    simp [Source.Stmt.run, hSourceCond, hTruth,
                      hSourceScoped] at hSourceRun
                | ok sourceOutcome =>
                    rcases
                        SourceDirect.SourceRun.block_runScoped_open_exists
                          hSourceScoped with
                      ⟨sourceOpen, sourceCtxOut, hSourceOpen⟩
                    exact hBody
                      (sourceAfterCond := sourceAfterCond)
                      (lowerBody := lowerBody)
                      (bodyLayout := bodyLayout)
                      (targetAfterCond := targetAfterCond)
                      (sourceOpenResult := (sourceOpen, sourceCtxOut))
                      hLowerBody
                      (by simpa [hTruth] using hSourceCond)
                      hSourceOpen hCondRel)

theorem switch_liveStmtRunBridge_of_lower
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name} {liveCtx : Ctx} {after nextLayout : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source sourceAfterScrutinee : Source.State}
    {target : Locals.RunState}
    {scrutinee : Expr 1} {cases : List (Word × Block)}
    {defaultBody : Option Block}
    {lowerStmt : List Locals.Stmt} {value : Word}
    (hLower :
      Lower.Stmt.toLocals? returns liveCtx targetCtx.layout after
        (.switch scrutinee cases defaultBody) = some (lowerStmt, nextLayout))
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hNoDup : targetCtx.layout.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned scrutinee)
    (hAccess :
      Locals.SourceLowering.Expr.Accessible targetCtx.layout 0 scrutinee)
    (hRel :
      SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hEvalOne :
      Source.Expr.evalOne prim scrutinee source =
        .ok (sourceAfterScrutinee, value))
    (hBody :
      ∀ {body lowerBody bodyLayout targetAfterPop},
        Source.Switch.select value cases defaultBody = some body →
        Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout targetCtx.layout) targetCtx.layout
          (Checked.scopedAfter targetCtx.layout after) body =
          some (lowerBody, bodyLayout) →
        SourceDirect.StateRel targetCtx.layout hiddenReturns
          sourceAfterScrutinee targetAfterPop →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
          targetProgram returns retc fuel sourceCtx targetCtx hiddenReturns
          body lowerBody sourceAfterScrutinee targetAfterPop) :
    SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
      returns retc (fuel + 1) sourceCtx targetCtx hiddenReturns
      (.switch scrutinee cases defaultBody) { stmts := lowerStmt } source
      target := by
  simp only [Lower.Stmt.toLocals?] at hLower
  let branchCtx := liveCtx.withProtectedLayout targetCtx.layout
  cases hLowerCases :
      Lower.CaseList.toLocals? returns branchCtx targetCtx.layout
        (Checked.scopedAfter targetCtx.layout after) cases with
  | none =>
      simp [branchCtx, hLowerCases] at hLower
  | some lowerCases =>
      cases hLowerDefault :
          Lower.Default.toLocals? returns branchCtx targetCtx.layout
            (Checked.scopedAfter targetCtx.layout after) defaultBody with
      | none =>
          simp [branchCtx, hLowerCases, hLowerDefault] at hLower
      | some lowerDefault =>
          simp [branchCtx, hLowerCases, hLowerDefault] at hLower
          rcases hLower with ⟨rfl, _hNextLayout⟩
          rcases SourceDirect.Expr.evalOne_pop_bridge_sourceOwned hPrim rfl
              hNoDup hOwned hAccess hRel hEvalOne with
            ⟨targetAfterExpr, targetAfterPop, stackAfterPop, hRunState, hPop,
              hTargetAfterPop, hPopRel⟩
          cases hSelect :
              Source.Switch.select value cases defaultBody with
          | none =>
              have hSelectFn :
                  EvmCompiler.Functions.Switch.select value cases
                      defaultBody = none := by
                simpa [SourceDirect.Switch.source_select_eq] using hSelect
              have hTargetSelect :
                  Locals.Direct.Switch.select value lowerCases lowerDefault =
                    none :=
                Lower.SwitchLowering.select_none_of_toLocals?
                  hLowerCases hLowerDefault hSelectFn
              have hSourceStmt :
                  Source.Stmt.run prim sourceProgram sourceCtx (fuel + 1)
                      (.switch scrutinee cases defaultBody) source =
                    .ok (Source.Outcome.regular sourceAfterScrutinee,
                      sourceCtx) := by
                simp [Source.Stmt.run, hEvalOne, hSelect]
              have hTargetStmt :
                  Locals.Direct.Stmt.run targetProgram targetCtx (fuel + 1)
                      (.switch scrutinee lowerCases lowerDefault) target =
                    .ok (Structured.Outcome.regular targetAfterPop,
                      targetCtx) := by
                simp [Locals.Direct.Stmt.run, hRunState, hPop,
                  hTargetAfterPop, hTargetSelect]
              rcases Target.runOpen_singleton_regular_exists
                  (program := targetProgram) hTargetStmt with
                ⟨targetFuel, hTargetBlock⟩
              exact
                ⟨(Source.Outcome.regular sourceAfterScrutinee, sourceCtx),
                  targetFuel,
                  (Structured.Outcome.regular targetAfterPop, targetCtx),
                  hSourceStmt, hTargetBlock,
                  SourceDirectBridge.LiveStmtRunResultRel.regular hPopRel
                    hCtx⟩
          | some body =>
              have hSelectFn :
                  EvmCompiler.Functions.Switch.select value cases
                      defaultBody = some body := by
                simpa [SourceDirect.Switch.source_select_eq] using hSelect
              rcases
                  Lower.SwitchLowering.select_some_of_toLocals?
                    hLowerCases hLowerDefault hSelectFn with
                ⟨lowerBody, bodyLayout, hTargetSelect, hLowerBody⟩
              rcases hBody hSelect hLowerBody hPopRel with
                ⟨sourceOpenResult, bodyTargetFuel, targetOpenResult,
                  hSourceOpen, hTargetOpen, hOpenRel, hOpenLayout⟩
              rcases sourceOpenResult with ⟨sourceOutcome, sourceCtxOut⟩
              rcases targetOpenResult with ⟨targetOutcome, targetCtxOut⟩
              cases sourceOutcome with
              | mk sourceState sourceMode =>
                  cases sourceMode with
                  | regular =>
                      rcases
                          SourceDirectBridge.LiveBlockOpenResultRel.source_regular_target_regular
                            hOpenRel with
                        ⟨targetInner, hTargetOutcomeEq, _hOpenStateRel,
                          _hOpenCtxRel⟩
                      subst targetOutcome
                      have hLayout :
                          SourceDirect.CleanupLayoutRel targetCtxOut.layout
                            targetCtx.layout := by
                        simpa [SourceDirectBridge.LiveBlockOpenRegularLayoutRel,
                          SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo]
                          using hOpenLayout
                      rcases blockScoped_regular_from_open
                          (prim := prim) (sourceProgram := sourceProgram)
                          (targetProgram := targetProgram)
                          (returns := returns) (retc := retc)
                          (sourceFuel := fuel)
                          (targetFuel := bodyTargetFuel)
                          (sourceCtx := sourceCtx)
                          (sourceCtxOut := sourceCtxOut)
                          (targetCtx := targetCtx)
                          (targetCtxOut := targetCtxOut)
                          (hiddenReturns := hiddenReturns)
                          (source := sourceAfterScrutinee)
                          (sourceInner := sourceState)
                          (target := targetAfterPop)
                          (targetInner := targetInner) (block := body)
                          (targetBlock := lowerBody)
                          hCtx hSourceOpen hTargetOpen hOpenRel hLayout with
                        ⟨targetScoped, hSourceScoped, hTargetScoped,
                          hScopedRel⟩
                      have hSourceStmt :
                          Source.Stmt.run prim sourceProgram sourceCtx
                              (fuel + 1)
                              (.switch scrutinee cases defaultBody) source =
                            .ok
                              (Source.Outcome.regular
                                (Locals.Source.State.restrictTo
                                  sourceCtx.scope sourceState),
                                sourceCtx) := by
                        simp [Source.Stmt.run, hEvalOne, hSelect,
                          hSourceScoped]
                      have hTargetStmt :
                          Locals.Direct.Stmt.run targetProgram targetCtx
                              (bodyTargetFuel + 1)
                              (.switch scrutinee lowerCases lowerDefault)
                              target =
                            .ok
                              (Structured.Outcome.regular targetScoped,
                                targetCtx) := by
                        have hTargetScoped' :
                            Locals.Direct.Block.runScoped targetProgram
                                targetCtx lowerBody bodyTargetFuel
                                (targetAfterExpr.withEVM
                                  { targetAfterExpr.evm with
                                    stack := stackAfterPop }) =
                              .ok (Structured.Outcome.regular
                                targetScoped) := by
                          simpa [hTargetAfterPop] using hTargetScoped
                        simp [Locals.Direct.Stmt.run, hRunState, hPop,
                          hTargetSelect, hTargetScoped']
                      rcases Target.runOpen_singleton_regular_exists
                          (program := targetProgram) hTargetStmt with
                        ⟨targetFuel, hTargetBlock⟩
                      have hScopedStateRel :
                          SourceDirect.StateRel targetCtx.layout
                            hiddenReturns
                            (Locals.Source.State.restrictTo sourceCtx.scope
                              sourceState)
                            targetScoped :=
                        SourceDirectBridge.LiveBlockScopedOutcomeRel.regular_stateRel
                          hScopedRel
                      exact
                        ⟨(Source.Outcome.regular
                            (Locals.Source.State.restrictTo sourceCtx.scope
                              sourceState),
                            sourceCtx),
                          targetFuel,
                          (Structured.Outcome.regular targetScoped,
                            targetCtx),
                          hSourceStmt, hTargetBlock,
                          SourceDirectBridge.LiveStmtRunResultRel.regular
                            hScopedStateRel hCtx⟩
                  | brk =>
                      have hNonregular :
                          ({ state := sourceState,
                              mode := Locals.Source.Mode.brk } :
                            Source.Outcome).mode ≠ .regular := by
                        simp
                      have hTargetNonregular :
                          targetOutcome.mode ≠ .regular :=
                        SourceDirectBridge.LiveBlockOpenResultRel.target_nonregular_of_source_nonregular
                          hOpenRel hNonregular
                      rcases blockScoped_nonregular_from_open
                          (prim := prim) (sourceProgram := sourceProgram)
                          (targetProgram := targetProgram)
                          (returns := returns) (retc := retc)
                          (sourceFuel := fuel)
                          (targetFuel := bodyTargetFuel)
                          (sourceCtx := sourceCtx)
                          (sourceCtxOut := sourceCtxOut)
                          (targetCtx := targetCtx)
                          (targetCtxOut := targetCtxOut)
                          (hiddenReturns := hiddenReturns)
                          (source := sourceAfterScrutinee)
                          (target := targetAfterPop)
                          (sourceOutcome :=
                            { state := sourceState,
                              mode := Locals.Source.Mode.brk })
                          (targetOutcome := targetOutcome) (block := body)
                          (targetBlock := lowerBody)
                          hSourceOpen hTargetOpen hOpenRel hNonregular with
                        ⟨hSourceScoped, hTargetScoped, hOutcomeRel⟩
                      have hSourceStmt :
                          Source.Stmt.run prim sourceProgram sourceCtx
                              (fuel + 1)
                              (.switch scrutinee cases defaultBody) source =
                            .ok
                              (({ state := sourceState,
                                  mode := Locals.Source.Mode.brk } :
                                Source.Outcome),
                                sourceCtx) := by
                        simp [Source.Stmt.run, hEvalOne, hSelect,
                          hSourceScoped]
                      have hTargetStmt :
                          Locals.Direct.Stmt.run targetProgram targetCtx
                              (bodyTargetFuel + 1)
                              (.switch scrutinee lowerCases lowerDefault)
                              target =
                            .ok (targetOutcome, targetCtx) := by
                        have hTargetScoped' :
                            Locals.Direct.Block.runScoped targetProgram
                                targetCtx lowerBody bodyTargetFuel
                                (targetAfterExpr.withEVM
                                  { targetAfterExpr.evm with
                                    stack := stackAfterPop }) =
                              .ok targetOutcome := by
                          simpa [hTargetAfterPop] using hTargetScoped
                        simp [Locals.Direct.Stmt.run, hRunState, hPop,
                          hTargetSelect, hTargetScoped']
                      rcases Target.runOpen_singleton_nonregular_exists
                          (program := targetProgram) hTargetStmt
                          hTargetNonregular with
                        ⟨targetFuel, hTargetBlock⟩
                      exact
                        ⟨(({ state := sourceState,
                              mode := Locals.Source.Mode.brk } :
                            Source.Outcome),
                            sourceCtx),
                          targetFuel, (targetOutcome, targetCtx),
                          hSourceStmt, hTargetBlock,
                          SourceDirectBridge.LiveStmtRunResultRel.of_nonregular
                            hOutcomeRel hCtx hNonregular⟩
                  | cont =>
                      have hNonregular :
                          ({ state := sourceState,
                              mode := Locals.Source.Mode.cont } :
                            Source.Outcome).mode ≠ .regular := by
                        simp
                      have hTargetNonregular :
                          targetOutcome.mode ≠ .regular :=
                        SourceDirectBridge.LiveBlockOpenResultRel.target_nonregular_of_source_nonregular
                          hOpenRel hNonregular
                      rcases blockScoped_nonregular_from_open
                          (prim := prim) (sourceProgram := sourceProgram)
                          (targetProgram := targetProgram)
                          (returns := returns) (retc := retc)
                          (sourceFuel := fuel)
                          (targetFuel := bodyTargetFuel)
                          (sourceCtx := sourceCtx)
                          (sourceCtxOut := sourceCtxOut)
                          (targetCtx := targetCtx)
                          (targetCtxOut := targetCtxOut)
                          (hiddenReturns := hiddenReturns)
                          (source := sourceAfterScrutinee)
                          (target := targetAfterPop)
                          (sourceOutcome :=
                            { state := sourceState,
                              mode := Locals.Source.Mode.cont })
                          (targetOutcome := targetOutcome) (block := body)
                          (targetBlock := lowerBody)
                          hSourceOpen hTargetOpen hOpenRel hNonregular with
                        ⟨hSourceScoped, hTargetScoped, hOutcomeRel⟩
                      have hSourceStmt :
                          Source.Stmt.run prim sourceProgram sourceCtx
                              (fuel + 1)
                              (.switch scrutinee cases defaultBody) source =
                            .ok
                              (({ state := sourceState,
                                  mode := Locals.Source.Mode.cont } :
                                Source.Outcome),
                                sourceCtx) := by
                        simp [Source.Stmt.run, hEvalOne, hSelect,
                          hSourceScoped]
                      have hTargetStmt :
                          Locals.Direct.Stmt.run targetProgram targetCtx
                              (bodyTargetFuel + 1)
                              (.switch scrutinee lowerCases lowerDefault)
                              target =
                            .ok (targetOutcome, targetCtx) := by
                        have hTargetScoped' :
                            Locals.Direct.Block.runScoped targetProgram
                                targetCtx lowerBody bodyTargetFuel
                                (targetAfterExpr.withEVM
                                  { targetAfterExpr.evm with
                                    stack := stackAfterPop }) =
                              .ok targetOutcome := by
                          simpa [hTargetAfterPop] using hTargetScoped
                        simp [Locals.Direct.Stmt.run, hRunState, hPop,
                          hTargetSelect, hTargetScoped']
                      rcases Target.runOpen_singleton_nonregular_exists
                          (program := targetProgram) hTargetStmt
                          hTargetNonregular with
                        ⟨targetFuel, hTargetBlock⟩
                      exact
                        ⟨(({ state := sourceState,
                              mode := Locals.Source.Mode.cont } :
                            Source.Outcome),
                            sourceCtx),
                          targetFuel, (targetOutcome, targetCtx),
                          hSourceStmt, hTargetBlock,
                          SourceDirectBridge.LiveStmtRunResultRel.of_nonregular
                            hOutcomeRel hCtx hNonregular⟩
                  | leave =>
                      have hNonregular :
                          ({ state := sourceState,
                              mode := Locals.Source.Mode.leave } :
                            Source.Outcome).mode ≠ .regular := by
                        simp
                      have hTargetNonregular :
                          targetOutcome.mode ≠ .regular :=
                        SourceDirectBridge.LiveBlockOpenResultRel.target_nonregular_of_source_nonregular
                          hOpenRel hNonregular
                      rcases blockScoped_nonregular_from_open
                          (prim := prim) (sourceProgram := sourceProgram)
                          (targetProgram := targetProgram)
                          (returns := returns) (retc := retc)
                          (sourceFuel := fuel)
                          (targetFuel := bodyTargetFuel)
                          (sourceCtx := sourceCtx)
                          (sourceCtxOut := sourceCtxOut)
                          (targetCtx := targetCtx)
                          (targetCtxOut := targetCtxOut)
                          (hiddenReturns := hiddenReturns)
                          (source := sourceAfterScrutinee)
                          (target := targetAfterPop)
                          (sourceOutcome :=
                            { state := sourceState,
                              mode := Locals.Source.Mode.leave })
                          (targetOutcome := targetOutcome) (block := body)
                          (targetBlock := lowerBody)
                          hSourceOpen hTargetOpen hOpenRel hNonregular with
                        ⟨hSourceScoped, hTargetScoped, hOutcomeRel⟩
                      have hSourceStmt :
                          Source.Stmt.run prim sourceProgram sourceCtx
                              (fuel + 1)
                              (.switch scrutinee cases defaultBody) source =
                            .ok
                              (({ state := sourceState,
                                  mode := Locals.Source.Mode.leave } :
                                Source.Outcome),
                                sourceCtx) := by
                        simp [Source.Stmt.run, hEvalOne, hSelect,
                          hSourceScoped]
                      have hTargetStmt :
                          Locals.Direct.Stmt.run targetProgram targetCtx

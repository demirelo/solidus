theorem allFuel_callback_families
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {sourceProgram : Program} {targetProgram : Locals.Program} :
    ∀ maxFuel,
      ScopedNoInternalCallShapeRecursiveOpenBlockLayoutToOutcomeAnyEntryCallbacksUpToOfLeaveFrame
          prim sourceProgram targetProgram maxFuel ∧
        ScopedNoInternalCallShapeRecursiveLoopOpenBlockLayoutToOutcomeCallbacksUpToOfLeaveFrame
          prim sourceProgram targetProgram maxFuel := by
  intro maxFuel
  induction maxFuel with
  | zero =>
      exact
        ⟨ScopedNoInternalCallShapeRecursiveOpenBlockLayoutToOutcomeAnyEntryCallbacksUpToOfLeaveFrame.zero,
          ScopedNoInternalCallShapeRecursiveLoopOpenBlockLayoutToOutcomeCallbacksUpToOfLeaveFrame.zero⟩
  | succ maxFuel ih =>
      exact
        ⟨by
            simpa [Nat.succ_eq_add_one] using
              anyEntry_succ_of_callback_families
                (prim := prim) hPrim (sourceProgram := sourceProgram)
                (targetProgram := targetProgram) ih.1 ih.2,
          by
            simpa [Nat.succ_eq_add_one] using
              loopOpenBlock_succ_of_callback_families
                (prim := prim) hPrim (sourceProgram := sourceProgram)
                (targetProgram := targetProgram) ih.1 ih.2⟩

theorem anyEntry_allFuel
    {prim : Source.PrimitiveSemantics}

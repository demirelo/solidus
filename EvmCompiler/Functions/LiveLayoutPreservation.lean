namespace Target

theorem runOpen_singleton_regular_exists {program : Locals.Program}
    {ctx midCtx : Locals.Ctx} {fuel : Nat} {stmt : Locals.Stmt}
    {state mid : Locals.RunState}
    (hRun :
      Locals.Direct.Stmt.run program ctx fuel stmt state =
        .ok (Structured.Outcome.regular mid, midCtx)) :
    ∃ blockFuel,
      Locals.Direct.Block.runOpen program ctx blockFuel { stmts := [stmt] }
        state =
        .ok (Structured.Outcome.regular mid, midCtx) := by
  refine ⟨fuel + 2, ?_⟩
  have hRun' :
      Locals.Direct.Stmt.run program ctx (fuel + 1) stmt state =
        .ok (Structured.Outcome.regular mid, midCtx) :=
    Locals.Direct.Stmt.run_mono program (Nat.le_succ fuel) hRun
  simp [Locals.Direct.Block.runOpen, hRun', Structured.Outcome.regular]

theorem runOpen_singleton_nonregular_exists {program : Locals.Program}
    {ctx : Locals.Ctx} {fuel : Nat} {stmt : Locals.Stmt}
    {state : Locals.RunState} {outcome : Locals.Outcome}
    (hRun :
      Locals.Direct.Stmt.run program ctx fuel stmt state = .ok (outcome, ctx))
    (hNonregular : outcome.mode ≠ .regular) :
    ∃ blockFuel,
      Locals.Direct.Block.runOpen program ctx blockFuel { stmts := [stmt] }
        state =
        .ok (outcome, ctx) := by
  refine ⟨fuel + 2, ?_⟩
  have hRun' :
      Locals.Direct.Stmt.run program ctx (fuel + 1) stmt state =
        .ok (outcome, ctx) :=
    Locals.Direct.Stmt.run_mono program (Nat.le_succ fuel) hRun
  cases outcome with
  | mk outcomeState outcomeMode =>
      cases outcomeMode <;>
        simp [Locals.Direct.Block.runOpen, hRun',
          Structured.Outcome.regular] at hNonregular ⊢

theorem cleanupToLive_runOpen_exists {program : Locals.Program}
    {ctx : Locals.Ctx} {live : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState} :
    SourceDirect.StateRel ctx.layout hiddenReturns source target →
    ∃ cleaned cleanupFuel,
      Locals.Direct.Block.runOpen program ctx cleanupFuel
          { stmts := [Lower.cleanupToLive ctx.layout live] } target =
        .ok (Structured.Outcome.regular cleaned,
          ctx.withLayout (Layout.trimDeadPrefix ctx.layout live)) ∧
      SourceDirect.StateRel (Layout.trimDeadPrefix ctx.layout live)
        hiddenReturns source cleaned := by
  intro hRel
  rcases SourceDirectBridge.cleanupStmt_trimDeadPrefix_exists
      (program := program) (ctx := ctx) (fuel := 0) (live := live)
      hRel with
    ⟨cleaned, hStmt, hCleanRel⟩
  rcases runOpen_singleton_regular_exists (program := program) hStmt with
    ⟨cleanupFuel, hCleanup⟩
  exact ⟨cleaned, cleanupFuel, hCleanup, hCleanRel⟩

theorem cleanupToLive_prefix_runOpen_exists {program : Locals.Program}
    {ctx runCtx : Locals.Ctx} {live : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {tail : List Locals.Stmt} {outcome : Locals.Outcome}
    (hRel : SourceDirect.StateRel ctx.layout hiddenReturns source target)
    (hTail :
      ∀ {cleaned},
        SourceDirect.StateRel (Layout.trimDeadPrefix ctx.layout live)
          hiddenReturns source cleaned →
        ∃ tailFuel,
          Locals.Direct.Block.runOpen program
            (ctx.withLayout (Layout.trimDeadPrefix ctx.layout live)) tailFuel
            { stmts := tail } cleaned =
            .ok (outcome, runCtx)) :
    ∃ blockFuel,
      Locals.Direct.Block.runOpen program ctx blockFuel
        { stmts := Lower.cleanupToLive ctx.layout live :: tail } target =
        .ok (outcome, runCtx) := by
  rcases cleanupToLive_runOpen_exists
      (program := program) (ctx := ctx) (live := live) hRel with
    ⟨cleaned, cleanupFuel, hCleanup, hCleanRel⟩
  rcases hTail hCleanRel with ⟨tailFuel, hTailRun⟩
  simpa [Lower.cleanupToLive] using
    Locals.Direct.Block.runOpen_append_regular_exists program
      [Lower.cleanupToLive ctx.layout live] tail ctx
      (ctx.withLayout (Layout.trimDeadPrefix ctx.layout live))
      target cleaned outcome runCtx
      ⟨cleanupFuel, by simpa [Lower.cleanupToLive] using hCleanup⟩
      ⟨tailFuel, hTailRun⟩

theorem promoteName_runOpen_exists {program : Locals.Program}
    {ctx : Locals.Ctx} {name : Name} {promoted : List Name}
    {idx : Nat} {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (hPromote : Layout.promoteName? ctx.layout name = some (promoted, idx))
    (hRel : SourceDirect.StateRel ctx.layout hiddenReturns source target) :
    ∃ promotedTarget promoteFuel,
      Locals.Direct.Block.runOpen program ctx promoteFuel
          { stmts := [Locals.Stmt.promoteName name] } target =
        .ok (Structured.Outcome.regular promotedTarget,
          ctx.withLayout promoted) ∧
      SourceDirect.StateRel promoted hiddenReturns source promotedTarget := by
  rcases Layout.promoteName?_eq_some hPromote with
    ⟨hIndex, hBound, hPromoted, _hTop, _hLen⟩
  have hLayoutAt : ctx.layout[idx]? = some name :=
    Layout.index?_sound hIndex
  have hDepth :
      Locals.Layout.lookupDepth? name ctx.layout = some (idx + 1) :=
    Layout.index?_lookupDepth? hIndex
  rcases hRel with ⟨hLowerRel, hReturns⟩
  rcases hLowerRel with ⟨hSharedRel, hStackRel⟩
  rcases Locals.SourceLowering.StackStoreRel.lookup_value hStackRel hLayoutAt
    with ⟨value, hStackAt, hStore⟩
  have hStackSplit :
      target.evm.stack =
        target.evm.stack.take idx ++ [value] ++
          target.evm.stack.drop (idx + 1) := by
    have hSplit :=
      Locals.StackLowering.list_eq_take_getElem?_drop hStackAt
    simpa [List.singleton_append] using hSplit
  have hFrontLen :
      (target.evm.stack.take idx).length ≤ 16 := by
    rcases List.getElem?_eq_some_iff.mp hStackAt with ⟨hLt, _hVal⟩
    simp [List.length_take, Nat.min_eq_left (Nat.le_of_lt hLt), hBound]
  have hTakeLen :
      (target.evm.stack.take idx).length = idx := by
    rcases List.getElem?_eq_some_iff.mp hStackAt with ⟨hLt, _hVal⟩
    simp [List.length_take, Nat.min_eq_left (Nat.le_of_lt hLt)]
  rcases Locals.SourceLowering.Assignment.swapRestoreUpTo_run_exists
      (state := target.evm) (front := target.evm.stack.take idx)
      (suffix := target.evm.stack.drop (idx + 1)) (token := value)
      hFrontLen with
    ⟨code, evmAfterPromote, hCode, hCodeRun, hPromoteStack,
      hPromoteShared⟩
  have hCodeRunTarget :
      Structured.Code.run code target.evm = .ok evmAfterPromote := by
    have hCodeRun' := hCodeRun
    rw [← hStackSplit] at hCodeRun'
    simpa using hCodeRun'
  have hDepthSub : idx + 1 - 1 = idx := by omega
  have hCodeIdx : Locals.Ctx.swapRestoreUpTo? idx = some code := by
    simpa [hTakeLen] using hCode
  have hLocalsPromoted :
      Locals.Layout.promoteAt idx ctx.layout = promoted := by
    simpa [Layout.promoteAt, Locals.Layout.promoteAt] using hPromoted.symm
  let promotedTarget : Locals.RunState := target.withEVM evmAfterPromote
  have hStmtRun :
      Locals.Direct.Stmt.run program ctx 1 (.promoteName name) target =
        .ok (Structured.Outcome.regular promotedTarget,
          ctx.withLayout promoted) := by
    simp [Locals.Direct.Stmt.run, hDepth, hDepthSub, hBound, hCodeIdx,
      hCodeRunTarget, promotedTarget, hLocalsPromoted]
  rcases Target.runOpen_singleton_regular_exists
      (program := program) hStmtRun with
    ⟨promoteFuel, hBlockRun⟩
  have hLowerPromoted :
      Locals.SourceLowering.StateRel promoted source promotedTarget := by
    rw [← hLocalsPromoted]
    simpa [Locals.Layout.promoteAt, hLayoutAt] using
      Locals.SourceLowering.StateRel.promoteAt
        (layout := ctx.layout) (source := source) (target := target)
        (promotedTarget := promotedTarget) (name := name) (value := value)
        (idx := idx) hLayoutAt hStackAt hStore
        (by
          simp [promotedTarget, hPromoteShared])
        (by
          simp [promotedTarget, hPromoteStack])
        ⟨hSharedRel, hStackRel⟩
  have hReturnsPromoted : promotedTarget.returns = hiddenReturns := by
    simp [promotedTarget, hReturns]
  exact
    ⟨promotedTarget, promoteFuel, hBlockRun,
      ⟨hLowerPromoted, hReturnsPromoted⟩⟩

theorem prepareLoop_runOpen_exists {program : Locals.Program}
    {returns live : List Name} {stmt : Stmt}
    {reqs : List Prepare.NameReq} {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} :
    ∀ {fuel ctx prep finalLayout target},
      Prepare.loop returns live stmt reqs fuel ctx.layout =
          some (prep, finalLayout) →
        SourceDirect.StateRel ctx.layout hiddenReturns source target →
        ∃ prepared prepareFuel,
          Locals.Direct.Block.runOpen program ctx prepareFuel
              { stmts := prep } target =
            .ok (Structured.Outcome.regular prepared,
              ctx.withLayout finalLayout) ∧
          SourceDirect.StateRel finalLayout hiddenReturns source prepared := by
  intro fuel
  induction fuel with
  | zero =>
      intro ctx prep finalLayout target hPrepare hRel
      unfold Prepare.loop at hPrepare
      cases hChecked : Prepare.checked? returns live ctx.layout stmt with
      | false =>
          simp [hChecked] at hPrepare
      | true =>
          simp [hChecked] at hPrepare
          rcases hPrepare with ⟨rfl, rfl⟩
          refine ⟨target, 1, ?_, hRel⟩
          simp [Locals.Direct.Block.runOpen, Locals.Ctx.withLayout]
  | succ fuel ih =>
      intro ctx prep finalLayout target hPrepare hRel
      unfold Prepare.loop at hPrepare
      cases hChecked : Prepare.checked? returns live ctx.layout stmt with
      | true =>
          simp [hChecked] at hPrepare
          rcases hPrepare with ⟨rfl, rfl⟩
          refine ⟨target, 1, ?_, hRel⟩
          simp [Locals.Direct.Block.runOpen, Locals.Ctx.withLayout]
      | false =>
          simp [hChecked] at hPrepare
          cases hPromote :
              Prepare.promoteBlocked? ctx.layout reqs with
          | none =>
              simp [hPromote] at hPrepare
          | some promotedPair =>
              rcases promotedPair with ⟨promoteStmt, promotedLayout⟩
              simp [hPromote] at hPrepare
              cases hRest :
                  Prepare.loop returns live stmt reqs fuel promotedLayout with
              | none =>
                  simp [hRest] at hPrepare
              | some restPair =>
                  rcases restPair with ⟨restPrep, restLayout⟩
                  simp [hRest] at hPrepare
                  rcases hPrepare with ⟨rfl, rfl⟩
                  rcases Prepare.promoteBlocked?_eq_some hPromote with
                    ⟨name, idx, hPromoteStmt, hPromoteLayout⟩
                  subst promoteStmt
                  rcases promoteName_runOpen_exists
                      (program := program) (ctx := ctx)
                      (hiddenReturns := hiddenReturns) (source := source)
                      (target := target) hPromoteLayout hRel with
                    ⟨promotedTarget, promoteFuel, hPromoteRun,
                      hPromotedRel⟩
                  rcases ih
                      (ctx := ctx.withLayout promotedLayout)
                      (prep := restPrep) (finalLayout := restLayout)
                      (target := promotedTarget)
                      (by simpa [Locals.Ctx.withLayout] using hRest)
                      (by simpa [Locals.Ctx.withLayout] using hPromotedRel)
                    with
                    ⟨prepared, restFuel, hRestRun, hPreparedRel⟩
                  rcases
                      Locals.Direct.Block.runOpen_append_regular_exists program
                        [Locals.Stmt.promoteName name] restPrep ctx
                        (ctx.withLayout promotedLayout) target promotedTarget
                        (Structured.Outcome.regular prepared)
                        (ctx.withLayout restLayout)
                        ⟨promoteFuel, by simpa using hPromoteRun⟩
                        ⟨restFuel,
                          by
                            simpa [Locals.Ctx.withLayout] using hRestRun⟩
                    with
                    ⟨prepareFuel, hPrepareRun⟩
                  exact
                    ⟨prepared, prepareFuel,
                      by simpa using hPrepareRun, hPreparedRel⟩

theorem prepareLoopAboveSuffix_runOpen_exists {program : Locals.Program}
    {protectedDepth : Nat}
    {returns live : List Name} {stmt : Stmt}
    {reqs : List Prepare.NameReq} {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} :
    ∀ {fuel ctx prep finalLayout target},
      Prepare.loopAboveSuffix protectedDepth returns live stmt reqs fuel
          ctx.layout =
          some (prep, finalLayout) →
        SourceDirect.StateRel ctx.layout hiddenReturns source target →
        ∃ prepared prepareFuel,
          Locals.Direct.Block.runOpen program ctx prepareFuel
              { stmts := prep } target =
            .ok (Structured.Outcome.regular prepared,
              ctx.withLayout finalLayout) ∧
          SourceDirect.StateRel finalLayout hiddenReturns source prepared := by
  intro fuel
  induction fuel with
  | zero =>
      intro ctx prep finalLayout target hPrepare hRel
      unfold Prepare.loopAboveSuffix at hPrepare
      cases hChecked : Prepare.checked? returns live ctx.layout stmt with
      | false =>
          simp [hChecked] at hPrepare
      | true =>
          simp [hChecked] at hPrepare
          rcases hPrepare with ⟨rfl, rfl⟩
          refine ⟨target, 1, ?_, hRel⟩
          simp [Locals.Direct.Block.runOpen, Locals.Ctx.withLayout]
  | succ fuel ih =>
      intro ctx prep finalLayout target hPrepare hRel
      unfold Prepare.loopAboveSuffix at hPrepare
      cases hChecked : Prepare.checked? returns live ctx.layout stmt with
      | true =>
          simp [hChecked] at hPrepare
          rcases hPrepare with ⟨rfl, rfl⟩
          refine ⟨target, 1, ?_, hRel⟩
          simp [Locals.Direct.Block.runOpen, Locals.Ctx.withLayout]
      | false =>
          simp [hChecked] at hPrepare
          cases hPromote :
              Prepare.promoteBlockedAboveSuffix? protectedDepth ctx.layout
                reqs with
          | none =>
              simp [hPromote] at hPrepare
          | some promotedPair =>
              rcases promotedPair with ⟨promoteStmt, promotedLayout⟩
              simp [hPromote] at hPrepare
              cases hRest :
                  Prepare.loopAboveSuffix protectedDepth returns live stmt reqs
                    fuel promotedLayout with
              | none =>
                  simp [hRest] at hPrepare
              | some restPair =>
                  rcases restPair with ⟨restPrep, restLayout⟩
                  simp [hRest] at hPrepare
                  rcases hPrepare with ⟨rfl, rfl⟩
                  rcases Prepare.promoteBlockedAboveSuffix?_eq_some hPromote with
                    ⟨name, idx, hPromoteStmt, hPromoteLayout, _hIdx⟩
                  subst promoteStmt
                  rcases promoteName_runOpen_exists
                      (program := program) (ctx := ctx)
                      (hiddenReturns := hiddenReturns) (source := source)
                      (target := target) hPromoteLayout hRel with
                    ⟨promotedTarget, promoteFuel, hPromoteRun,
                      hPromotedRel⟩
                  rcases ih
                      (ctx := ctx.withLayout promotedLayout)
                      (prep := restPrep) (finalLayout := restLayout)
                      (target := promotedTarget)
                      (by simpa [Locals.Ctx.withLayout] using hRest)
                      (by simpa [Locals.Ctx.withLayout] using hPromotedRel)
                    with
                    ⟨prepared, restFuel, hRestRun, hPreparedRel⟩
                  rcases
                      Locals.Direct.Block.runOpen_append_regular_exists program
                        [Locals.Stmt.promoteName name] restPrep ctx
                        (ctx.withLayout promotedLayout) target promotedTarget
                        (Structured.Outcome.regular prepared)
                        (ctx.withLayout restLayout)
                        ⟨promoteFuel, by simpa using hPromoteRun⟩
                        ⟨restFuel,
                          by
                            simpa [Locals.Ctx.withLayout] using hRestRun⟩
                    with
                    ⟨prepareFuel, hPrepareRun⟩
                  exact
                    ⟨prepared, prepareFuel,
                      by simpa using hPrepareRun, hPreparedRel⟩

theorem prepareForStmtAboveSuffix_runOpen_exists {program : Locals.Program}
    {protectedDepth : Nat}
    {returns live : List Name} {stmt : Stmt} {ctx : Locals.Ctx}
    {prep : List Locals.Stmt} {finalLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (hPrepare :
      Prepare.forStmtAboveSuffix? protectedDepth returns ctx.layout live stmt =
        some (prep, finalLayout))
    (hRel : SourceDirect.StateRel ctx.layout hiddenReturns source target) :
    ∃ prepared prepareFuel,
      Locals.Direct.Block.runOpen program ctx prepareFuel
          { stmts := prep } target =
        .ok (Structured.Outcome.regular prepared,
          ctx.withLayout finalLayout) ∧
      SourceDirect.StateRel finalLayout hiddenReturns source prepared := by
  unfold Prepare.forStmtAboveSuffix? at hPrepare
  exact prepareLoopAboveSuffix_runOpen_exists hPrepare hRel

theorem pushReturns_runOpen_exists {program : Locals.Program}
    (ctx : Locals.Ctx) :
    ∀ {returns : List Name} {state state' : Locals.RunState},
      Functions.Direct.pushReturns ctx returns state = .ok state' →
      ∃ fuel,
        Locals.Direct.Block.runOpen program ctx fuel
          { stmts := Functions.Lower.pushReturns returns } state =
          .ok (Structured.Outcome.regular state', ctx) := by
  intro returns
  cases returns with
  | nil =>
      intro state state' hRun
      simp [Functions.Direct.pushReturns] at hRun
      cases hRun
      exact ⟨1, by
        simp [Functions.Lower.pushReturns, Locals.Direct.Block.runOpen,
          Structured.Outcome.regular]⟩
  | cons name rest =>
      intro state state' hRun
      unfold Functions.Direct.pushReturns at hRun
      cases hExprs :
          Locals.Direct.Expr.ExprSeq.runCode ctx 0
            (Functions.Lower.returnExprs (name :: rest)) state.evm with
      | error err =>
          simp [hExprs] at hRun
      | ok evmAfterReturns =>
          simp [hExprs] at hRun
          cases hRun
          refine ⟨2, ?_⟩
          simp [Functions.Lower.pushReturns, Locals.Direct.Block.runOpen,
            Locals.Direct.Stmt.run, hExprs, Structured.Outcome.regular]

end Target

theorem blockScoped_regular_from_open
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name}
    {retc sourceFuel targetFuel : Nat}
    {sourceCtx sourceCtxOut : Source.Ctx}
    {targetCtx targetCtxOut : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source sourceInner : Source.State}
    {target targetInner : Locals.RunState}
    {block : Block} {targetBlock : Locals.Block}
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hSourceOpen :
      Source.Block.runOpen prim sourceProgram sourceCtx sourceFuel block
          source =
        .ok (Source.Outcome.regular sourceInner, sourceCtxOut))
    (hTargetOpen :
      Locals.Direct.Block.runOpen targetProgram targetCtx targetFuel
          targetBlock target =
        .ok (Structured.Outcome.regular targetInner, targetCtxOut))
    (hOpenRel :
      SourceDirectBridge.LiveBlockOpenResultRel retc returns hiddenReturns
        (Source.Outcome.regular sourceInner, sourceCtxOut)
        (Structured.Outcome.regular targetInner, targetCtxOut))
    (hLayout :
      SourceDirect.CleanupLayoutRel targetCtxOut.layout targetCtx.layout) :
    ∃ targetScoped,
      Source.Block.runScoped prim sourceProgram sourceCtx block sourceFuel
          source =
        .ok
          (Source.Outcome.regular
            (Locals.Source.State.restrictTo sourceCtx.scope sourceInner)) ∧
      Locals.Direct.Block.runScoped targetProgram targetCtx targetBlock
          targetFuel target =
        .ok (Structured.Outcome.regular targetScoped) ∧
      SourceDirectBridge.LiveBlockScopedOutcomeRel returns
        targetCtx.layout hiddenReturns
        (Source.Outcome.regular
          (Locals.Source.State.restrictTo sourceCtx.scope sourceInner))
        (Structured.Outcome.regular targetScoped) := by
  have hRegularRel :
      SourceDirect.StateRel targetCtxOut.layout hiddenReturns sourceInner
          targetInner ∧
        SourceDirectBridge.LiveCtxRel retc sourceCtxOut targetCtxOut :=
    SourceDirectBridge.LiveBlockOpenResultRel.regular_stateRel hOpenRel
  rcases hRegularRel with ⟨hStateRel, _hFinalCtxRel⟩
  have hStateRelFull :
      SourceDirect.StateRel targetCtxOut.layout hiddenReturns sourceInner
        targetInner :=
    hStateRel
  rcases hStateRel with ⟨⟨_hSharedRel, hStackRel⟩, _hReturns⟩
  have hDepth : targetCtx.layout.length ≤ targetCtxOut.layout.length := by
    have hLength := congrArg List.length hLayout
    simp at hLength
    omega
  rcases SourceDirect.Cleanup.runCleanupTo_exists
      (ctx := targetCtxOut) (targetDepth := targetCtx.layout.length)
      (state := targetInner) hDepth hStackRel.1 with
    ⟨targetScoped, hCleanup⟩
  have hScopedRel :
      SourceDirect.StateRel targetCtx.layout hiddenReturns
        (Locals.Source.State.restrictTo sourceCtx.scope sourceInner)
        targetScoped :=
    SourceDirectBridge.stateRel_cleanupTo_layout_subset
      (ctx := targetCtxOut) (outer := targetCtx.layout)
      (scope := sourceCtx.scope) (hiddenReturns := hiddenReturns)
      (source := sourceInner) (target := targetInner)
      (cleaned := targetScoped) hStateRelFull hLayout hCtx.1 hCleanup
  refine ⟨targetScoped, ?_, ?_, ?_⟩
  · simp [Source.Block.runScoped, hSourceOpen, Source.Outcome.regular,
      Locals.Source.Outcome.regular]
  · simp [Locals.Direct.Block.runScoped, hTargetOpen, hCleanup,
      Structured.Outcome.regular]
  · exact SourceDirectBridge.LiveBlockScopedOutcomeRel.regular hScopedRel

theorem blockScoped_nonregular_from_open
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name}
    {retc sourceFuel targetFuel : Nat}
    {sourceCtx sourceCtxOut : Source.Ctx}
    {targetCtx targetCtxOut : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {sourceOutcome : Source.Outcome} {targetOutcome : Locals.Outcome}
    {block : Block} {targetBlock : Locals.Block}
    (hSourceOpen :
      Source.Block.runOpen prim sourceProgram sourceCtx sourceFuel block
          source =
        .ok (sourceOutcome, sourceCtxOut))
    (hTargetOpen :
      Locals.Direct.Block.runOpen targetProgram targetCtx targetFuel
          targetBlock target =
        .ok (targetOutcome, targetCtxOut))
    (hOpenRel :
      SourceDirectBridge.LiveBlockOpenResultRel retc returns hiddenReturns
        (sourceOutcome, sourceCtxOut) (targetOutcome, targetCtxOut))
    (hNonregular : sourceOutcome.mode ≠ .regular) :
    Source.Block.runScoped prim sourceProgram sourceCtx block sourceFuel
        source =
      .ok sourceOutcome ∧
    Locals.Direct.Block.runScoped targetProgram targetCtx targetBlock
        targetFuel target =
      .ok targetOutcome ∧
    ∃ outcomeLayout,
      SourceDirect.StmtOutcomeRel returns outcomeLayout hiddenReturns
        sourceOutcome targetOutcome := by
  cases sourceOutcome with
  | mk sourceState sourceMode =>
      cases targetOutcome with
      | mk targetState targetMode =>
          cases sourceMode <;> cases targetMode <;>
            simp [Source.Block.runScoped, Locals.Direct.Block.runScoped,
              hSourceOpen, hTargetOpen,
              SourceDirectBridge.LiveBlockOpenResultRel,
              SourceDirect.StmtOutcomeRel] at hOpenRel hNonregular ⊢
          all_goals exact hOpenRel.1

theorem blockScoped_from_open_bridge_with_layout
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name}
    {retc sourceFuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {sourceOutcome : Source.Outcome}
    {block : Block} {targetBlock : Locals.Block}
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hSourceScoped :
      Source.Block.runScoped prim sourceProgram sourceCtx block sourceFuel
          source =
        .ok sourceOutcome)
    (hBridge :
      SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
        targetProgram returns retc sourceFuel sourceCtx targetCtx
        hiddenReturns block targetBlock source target) :
    ∃ targetFuel targetOutcome,
      Locals.Direct.Block.runScoped targetProgram targetCtx targetBlock
          targetFuel target =
        .ok targetOutcome ∧
      SourceDirectBridge.LiveBlockScopedOutcomeRel returns targetCtx.layout
        hiddenReturns sourceOutcome targetOutcome := by
  rcases hBridge with
    ⟨sourceResult, targetFuel, targetResult, hSourceOpen, hTargetOpen,
      hOpenRel, hLayout⟩
  rcases sourceResult with ⟨sourceOpen, sourceCtxOut⟩
  rcases targetResult with ⟨targetOpen, targetCtxOut⟩
  cases sourceOpen with
  | mk sourceState sourceMode =>
      cases targetOpen with
      | mk targetState targetMode =>
          cases sourceMode <;> cases targetMode <;>
            simp [SourceDirectBridge.LiveBlockOpenResultRel,
              SourceDirect.StmtOutcomeRel] at hOpenRel
          · rcases
                blockScoped_regular_from_open
                  (prim := prim) (sourceProgram := sourceProgram)
                  (targetProgram := targetProgram) (returns := returns)
                  (retc := retc) (sourceFuel := sourceFuel)
                  (targetFuel := targetFuel) (sourceCtx := sourceCtx)
                  (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
                  (targetCtxOut := targetCtxOut)
                  (hiddenReturns := hiddenReturns) (source := source)
                  (sourceInner := sourceState) (target := target)
                  (targetInner := targetState) (block := block)
                  (targetBlock := targetBlock) hCtx hSourceOpen hTargetOpen
                  (by
                    simpa [SourceDirectBridge.LiveBlockOpenResultRel]
                      using hOpenRel)
                  (by
                    simpa [SourceDirectBridge.LiveBlockOpenRegularLayoutRel,
                      SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo]
                      using hLayout) with
              ⟨targetScoped, hSourceScoped', hTargetScoped, hScopedRel⟩
            rw [hSourceScoped] at hSourceScoped'
            cases hSourceScoped'
            exact
              ⟨targetFuel, Structured.Outcome.regular targetScoped,
                hTargetScoped, hScopedRel⟩
          · have hSourceScoped' :
                Source.Block.runScoped prim sourceProgram sourceCtx block
                    sourceFuel source =
                  .ok (Source.Outcome.brk sourceState) := by
              simp [Source.Block.runScoped, hSourceOpen, Source.Outcome.brk,
                Locals.Source.Outcome.brk]
            rw [hSourceScoped] at hSourceScoped'
            cases hSourceScoped'
            have hTargetScoped :
                Locals.Direct.Block.runScoped targetProgram targetCtx
                    targetBlock targetFuel target =
                  .ok (Structured.Outcome.brk targetState) := by
              simp [Locals.Direct.Block.runScoped, hTargetOpen,
                Structured.Outcome.brk]
            exact
              ⟨targetFuel, Structured.Outcome.brk targetState,
                hTargetScoped,
                by
                  simpa [SourceDirectBridge.LiveBlockScopedOutcomeRel,
                    SourceDirect.StmtOutcomeRel] using hOpenRel.1⟩
          · have hSourceScoped' :
                Source.Block.runScoped prim sourceProgram sourceCtx block
                    sourceFuel source =
                  .ok (Source.Outcome.cont sourceState) := by
              simp [Source.Block.runScoped, hSourceOpen,
                Source.Outcome.cont, Locals.Source.Outcome.cont]
            rw [hSourceScoped] at hSourceScoped'
            cases hSourceScoped'
            have hTargetScoped :
                Locals.Direct.Block.runScoped targetProgram targetCtx
                    targetBlock targetFuel target =
                  .ok (Structured.Outcome.cont targetState) := by
              simp [Locals.Direct.Block.runScoped, hTargetOpen,
                Structured.Outcome.cont]
            exact
              ⟨targetFuel, Structured.Outcome.cont targetState,
                hTargetScoped,
                by
                  simpa [SourceDirectBridge.LiveBlockScopedOutcomeRel,
                    SourceDirect.StmtOutcomeRel] using hOpenRel.1⟩
          · have hSourceScoped' :
                Source.Block.runScoped prim sourceProgram sourceCtx block
                    sourceFuel source =
                  .ok (Source.Outcome.leave sourceState) := by
              simp [Source.Block.runScoped, hSourceOpen,
                Source.Outcome.leave, Locals.Source.Outcome.leave]
            rw [hSourceScoped] at hSourceScoped'
            cases hSourceScoped'
            have hTargetScoped :
                Locals.Direct.Block.runScoped targetProgram targetCtx
                    targetBlock targetFuel target =
                  .ok (Structured.Outcome.leave targetState) := by
              simp [Locals.Direct.Block.runScoped, hTargetOpen,
                Structured.Outcome.leave]
            exact
              ⟨targetFuel, Structured.Outcome.leave targetState,
                hTargetScoped,
                by
                  show ∃ outcomeLayout,
                    SourceDirect.StmtOutcomeRel returns outcomeLayout
                      hiddenReturns (Source.Outcome.leave sourceState)
                      (Structured.Outcome.leave targetState)
                  exact
                    ⟨targetCtx.layout,
                      by
                        simpa [SourceDirect.StmtOutcomeRel] using
                          hOpenRel.1⟩⟩
          · rename_i sourceKind targetKind
            have hSourceScoped' :
                Source.Block.runScoped prim sourceProgram sourceCtx block
                    sourceFuel source =
                  .ok (Source.Outcome.halt sourceKind sourceState) := by
              simp [Source.Block.runScoped, hSourceOpen,
                Source.Outcome.halt, Locals.Source.Outcome.halt]
            rw [hSourceScoped] at hSourceScoped'
            cases hSourceScoped'
            have hTargetScoped :
                Locals.Direct.Block.runScoped targetProgram targetCtx
                    targetBlock targetFuel target =
                  .ok (Structured.Outcome.halt targetKind targetState) := by
              simp [Locals.Direct.Block.runScoped, hTargetOpen,
                Structured.Outcome.halt]
            exact
              ⟨targetFuel, Structured.Outcome.halt targetKind targetState,
                hTargetScoped,
                by
                  show ∃ outcomeLayout,
                    SourceDirect.StmtOutcomeRel returns outcomeLayout
                      hiddenReturns
                      (Source.Outcome.halt sourceKind sourceState)
                      (Structured.Outcome.halt targetKind targetState)
                  exact
                    ⟨targetCtx.layout,
                      by
                        simpa [SourceDirect.StmtOutcomeRel] using
                          hOpenRel.1⟩⟩

theorem blockScoped_from_open_target_result_with_layout
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name}
    {retc sourceFuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {sourceOutcome : Source.Outcome}
    {block : Block} {targetBlock : Locals.Block}
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hSourceScoped :
      Source.Block.runScoped prim sourceProgram sourceCtx block sourceFuel
          source =
        .ok sourceOutcome)
    (hOpenTarget :
      ∀ {sourceResult : Source.Outcome × Source.Ctx},
        Source.Block.runOpen prim sourceProgram sourceCtx sourceFuel block
            source =
          .ok sourceResult →
        ∃ targetFuel targetResult,
          Locals.Direct.Block.runOpen targetProgram targetCtx targetFuel
              targetBlock target =
            .ok targetResult ∧
          SourceDirectBridge.LiveBlockOpenResultRel retc returns hiddenReturns
            sourceResult targetResult ∧
          SourceDirectBridge.LiveBlockOpenRegularLayoutRel targetCtx
            sourceResult targetResult) :
    ∃ targetFuel targetOutcome,
      Locals.Direct.Block.runScoped targetProgram targetCtx targetBlock
          targetFuel target =
        .ok targetOutcome ∧
      SourceDirectBridge.LiveBlockScopedOutcomeRel returns targetCtx.layout
        hiddenReturns sourceOutcome targetOutcome := by
  rcases SourceDirect.SourceRun.block_runScoped_open_exists hSourceScoped with
    ⟨sourceOpen, sourceCtxOut, hSourceOpen⟩
  rcases hOpenTarget hSourceOpen with
    ⟨targetFuel, targetResult, hTargetOpen, hOpenRel, hLayout⟩
  let sourceResult : Source.Outcome × Source.Ctx :=
    (sourceOpen, sourceCtxOut)
  have hBridge :
      SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
        targetProgram returns retc sourceFuel sourceCtx targetCtx
        hiddenReturns block targetBlock source target := by
    exact
      ⟨sourceResult, targetFuel, targetResult, hSourceOpen, hTargetOpen,
        hOpenRel, hLayout⟩
  exact
    blockScoped_from_open_bridge_with_layout
      (prim := prim) (sourceProgram := sourceProgram)
      (targetProgram := targetProgram) (returns := returns) (retc := retc)
      (sourceFuel := sourceFuel) (sourceCtx := sourceCtx)
      (targetCtx := targetCtx) (hiddenReturns := hiddenReturns)
      (source := source) (target := target) (sourceOutcome := sourceOutcome)
      (block := block) (targetBlock := targetBlock)
      hCtx hSourceScoped hBridge

theorem blockScoped_from_loop_open_bridge_with_layout
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns loopLayout : List Name}
    {retc sourceFuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {sourceOutcome : Source.Outcome}
    {block : Block} {targetBlock : Locals.Block}
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hLoopLayout : targetCtx.layout = loopLayout)
    (hSourceScoped :
      Source.Block.runScoped prim sourceProgram sourceCtx block sourceFuel
          source =
        .ok sourceOutcome)
    (hBridge :
      SourceDirectBridge.LiveLoopBlockOpenRunBridgeWithLayout prim
        sourceProgram targetProgram returns loopLayout retc sourceFuel
        sourceCtx targetCtx hiddenReturns block targetBlock source target) :
    ∃ targetFuel targetOutcome,
      Locals.Direct.Block.runScoped targetProgram targetCtx targetBlock
          targetFuel target =
        .ok targetOutcome ∧
      SourceDirect.StmtOutcomeRel returns loopLayout hiddenReturns
        sourceOutcome targetOutcome := by
  rcases hBridge with
    ⟨sourceResult, targetFuel, targetResult, hSourceOpen, hTargetOpen,
      hLoopRel, hLayout⟩
  rcases sourceResult with ⟨sourceOpen, sourceCtxOut⟩
  rcases targetResult with ⟨targetOpen, targetCtxOut⟩
  cases sourceOpen with
  | mk sourceState sourceMode =>
      cases targetOpen with
      | mk targetState targetMode =>
          cases sourceMode <;> cases targetMode <;>
            simp [SourceDirectBridge.LiveLoopBlockOpenResultRel,
              SourceDirect.StmtOutcomeRel] at hLoopRel
          · have hOpenRel :
                SourceDirectBridge.LiveBlockOpenResultRel retc returns
                  hiddenReturns
                  (Source.Outcome.regular sourceState, sourceCtxOut)
                  (Structured.Outcome.regular targetState, targetCtxOut) :=
              SourceDirectBridge.LiveLoopBlockOpenResultRel.to_liveBlockOpenResultRel
                (loopLayout := loopLayout)
                (by
                  simpa [SourceDirectBridge.LiveLoopBlockOpenResultRel]
                    using hLoopRel)
            rcases
                blockScoped_regular_from_open
                  (prim := prim) (sourceProgram := sourceProgram)
                  (targetProgram := targetProgram) (returns := returns)
                  (retc := retc) (sourceFuel := sourceFuel)
                  (targetFuel := targetFuel) (sourceCtx := sourceCtx)
                  (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
                  (targetCtxOut := targetCtxOut)
                  (hiddenReturns := hiddenReturns) (source := source)
                  (sourceInner := sourceState) (target := target)
                  (targetInner := targetState) (block := block)
                  (targetBlock := targetBlock) hCtx hSourceOpen hTargetOpen
                  hOpenRel
                  (by
                    simpa [SourceDirectBridge.LiveBlockOpenRegularLayoutRel,
                      SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo]
                      using hLayout) with
              ⟨targetScoped, hSourceScoped', hTargetScoped, hScopedRel⟩
            rw [hSourceScoped] at hSourceScoped'
            cases hSourceScoped'
            exact
              ⟨targetFuel, Structured.Outcome.regular targetScoped,
                hTargetScoped,
                SourceDirect.StmtOutcomeRel.regular
                  (by
                    simpa [hLoopLayout] using
                      SourceDirectBridge.LiveBlockScopedOutcomeRel.regular_stateRel
                        hScopedRel)⟩
          · have hSourceScoped' :
                Source.Block.runScoped prim sourceProgram sourceCtx block
                    sourceFuel source =
                  .ok (Source.Outcome.brk sourceState) := by
              simp [Source.Block.runScoped, hSourceOpen, Source.Outcome.brk,
                Locals.Source.Outcome.brk]
            rw [hSourceScoped] at hSourceScoped'
            cases hSourceScoped'
            have hTargetScoped :
                Locals.Direct.Block.runScoped targetProgram targetCtx
                    targetBlock targetFuel target =
                  .ok (Structured.Outcome.brk targetState) := by
              simp [Locals.Direct.Block.runScoped, hTargetOpen,
                Structured.Outcome.brk]
            exact
              ⟨targetFuel, Structured.Outcome.brk targetState,
                hTargetScoped, SourceDirect.StmtOutcomeRel.brk hLoopRel.1⟩
          · have hSourceScoped' :
                Source.Block.runScoped prim sourceProgram sourceCtx block
                    sourceFuel source =
                  .ok (Source.Outcome.cont sourceState) := by
              simp [Source.Block.runScoped, hSourceOpen,
                Source.Outcome.cont, Locals.Source.Outcome.cont]
            rw [hSourceScoped] at hSourceScoped'
            cases hSourceScoped'
            have hTargetScoped :
                Locals.Direct.Block.runScoped targetProgram targetCtx
                    targetBlock targetFuel target =
                  .ok (Structured.Outcome.cont targetState) := by
              simp [Locals.Direct.Block.runScoped, hTargetOpen,
                Structured.Outcome.cont]
            exact
              ⟨targetFuel, Structured.Outcome.cont targetState,
                hTargetScoped, SourceDirect.StmtOutcomeRel.cont hLoopRel.1⟩
          · have hSourceScoped' :
                Source.Block.runScoped prim sourceProgram sourceCtx block
                    sourceFuel source =
                  .ok (Source.Outcome.leave sourceState) := by
              simp [Source.Block.runScoped, hSourceOpen,
                Source.Outcome.leave, Locals.Source.Outcome.leave]
            rw [hSourceScoped] at hSourceScoped'
            cases hSourceScoped'
            have hTargetScoped :
                Locals.Direct.Block.runScoped targetProgram targetCtx
                    targetBlock targetFuel target =
                  .ok (Structured.Outcome.leave targetState) := by
              simp [Locals.Direct.Block.runScoped, hTargetOpen,
                Structured.Outcome.leave]
            exact
              ⟨targetFuel, Structured.Outcome.leave targetState,
                hTargetScoped, hLoopRel.1⟩
          · rename_i sourceKind targetKind
            have hSourceScoped' :
                Source.Block.runScoped prim sourceProgram sourceCtx block
                    sourceFuel source =
                  .ok (Source.Outcome.halt sourceKind sourceState) := by
              simp [Source.Block.runScoped, hSourceOpen,
                Source.Outcome.halt, Locals.Source.Outcome.halt]
            rw [hSourceScoped] at hSourceScoped'
            cases hSourceScoped'
            have hTargetScoped :
                Locals.Direct.Block.runScoped targetProgram targetCtx
                    targetBlock targetFuel target =
                  .ok (Structured.Outcome.halt targetKind targetState) := by
              simp [Locals.Direct.Block.runScoped, hTargetOpen,
                Structured.Outcome.halt]
            exact
              ⟨targetFuel, Structured.Outcome.halt targetKind targetState,
                hTargetScoped, hLoopRel.1⟩

theorem block_liveStmtRunBridge_of_open_bridge
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name} {retc sourceFuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {body : Block} {lowerBody : Locals.Block}
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hBody :
      SourceDirectBridge.LiveBlockOpenRunBridge prim sourceProgram
        targetProgram returns retc sourceFuel sourceCtx targetCtx
        hiddenReturns body lowerBody source target)
    (hRegularLayout :
      ∀ {sourceInner : Source.State} {sourceCtxOut : Source.Ctx}
        {targetInner : Locals.RunState} {targetCtxOut : Locals.Ctx}
        {bodyTargetFuel : Nat},
        Source.Block.runOpen prim sourceProgram sourceCtx sourceFuel body
            source =
          .ok (Source.Outcome.regular sourceInner, sourceCtxOut) →
        Locals.Direct.Block.runOpen targetProgram targetCtx bodyTargetFuel
            lowerBody target =
          .ok (Structured.Outcome.regular targetInner, targetCtxOut) →
        SourceDirectBridge.LiveBlockOpenResultRel retc returns hiddenReturns
          (Source.Outcome.regular sourceInner, sourceCtxOut)
          (Structured.Outcome.regular targetInner, targetCtxOut) →
        SourceDirect.CleanupLayoutRel targetCtxOut.layout
          targetCtx.layout) :
    SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
      returns retc sourceFuel sourceCtx targetCtx hiddenReturns (.block body)
      { stmts := [Locals.Stmt.block lowerBody] } source target := by
  rcases hBody with
    ⟨sourceResult, bodyTargetFuel, targetResult, hSourceOpen, hTargetOpen,
      hOpenRel⟩
  rcases sourceResult with ⟨sourceOutcome, sourceCtxOut⟩
  rcases targetResult with ⟨targetOutcome, targetCtxOut⟩
  cases sourceOutcome with
  | mk sourceState sourceMode =>
      cases sourceMode with
      | regular =>
          rcases
              SourceDirectBridge.LiveBlockOpenResultRel.source_regular_target_regular
                hOpenRel with
            ⟨targetInner, hTargetOutcomeEq, _hOpenStateRel,
              _hOpenCtxRel⟩
          subst targetOutcome
          have hLayout :
              SourceDirect.CleanupLayoutRel targetCtxOut.layout
                targetCtx.layout :=
            hRegularLayout hSourceOpen hTargetOpen hOpenRel
          rcases blockScoped_regular_from_open
              (prim := prim) (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (retc := retc) (sourceFuel := sourceFuel)
              (targetFuel := bodyTargetFuel) (sourceCtx := sourceCtx)
              (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
              (targetCtxOut := targetCtxOut)
              (hiddenReturns := hiddenReturns) (source := source)
              (sourceInner := sourceState) (target := target)
              (targetInner := targetInner) (block := body)
              (targetBlock := lowerBody)
              hCtx hSourceOpen hTargetOpen hOpenRel hLayout with
            ⟨targetScoped, hSourceScoped, hTargetScoped, hScopedRel⟩
          have hSourceStmt :
              Source.Stmt.run prim sourceProgram sourceCtx sourceFuel
                  (.block body) source =
                .ok
                  (Source.Outcome.regular
                    (Locals.Source.State.restrictTo sourceCtx.scope
                      sourceState),
                    sourceCtx) := by
            simp [Source.Stmt.run, hSourceScoped]
          have hTargetStmt :
              Locals.Direct.Stmt.run targetProgram targetCtx bodyTargetFuel
                  (.block lowerBody) target =
                .ok (Structured.Outcome.regular targetScoped, targetCtx) := by
            simp [Locals.Direct.Stmt.run, hTargetScoped]
          rcases Target.runOpen_singleton_regular_exists
              (program := targetProgram) hTargetStmt with
            ⟨stmtTargetFuel, hTargetBlock⟩
          have hScopedStateRel :
              SourceDirect.StateRel targetCtx.layout hiddenReturns
                (Locals.Source.State.restrictTo sourceCtx.scope sourceState)
                targetScoped :=
            SourceDirectBridge.LiveBlockScopedOutcomeRel.regular_stateRel
              hScopedRel
          refine
            ⟨(Source.Outcome.regular
                (Locals.Source.State.restrictTo sourceCtx.scope sourceState),
                sourceCtx),
              stmtTargetFuel,
              (Structured.Outcome.regular targetScoped, targetCtx),
              hSourceStmt, hTargetBlock, ?_⟩
          exact
            SourceDirectBridge.LiveStmtRunResultRel.regular hScopedStateRel
              hCtx
      | brk =>
          have hNonregular :
              ({ state := sourceState, mode := Locals.Source.Mode.brk } :
                Source.Outcome).mode ≠ .regular := by
            simp
          have hTargetNonregular :
              targetOutcome.mode ≠ .regular :=
            SourceDirectBridge.LiveBlockOpenResultRel.target_nonregular_of_source_nonregular
              hOpenRel hNonregular
          rcases blockScoped_nonregular_from_open
              (prim := prim) (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (retc := retc) (sourceFuel := sourceFuel)
              (targetFuel := bodyTargetFuel) (sourceCtx := sourceCtx)
              (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
              (targetCtxOut := targetCtxOut)
              (hiddenReturns := hiddenReturns) (source := source)
              (target := target)
              (sourceOutcome :=
                { state := sourceState, mode := Locals.Source.Mode.brk })
              (targetOutcome := targetOutcome) (block := body)
              (targetBlock := lowerBody)
              hSourceOpen hTargetOpen hOpenRel hNonregular with
            ⟨hSourceScoped, hTargetScoped, hOutcomeRel⟩
          have hSourceStmt :
              Source.Stmt.run prim sourceProgram sourceCtx sourceFuel
                  (.block body) source =
                .ok
                  (({ state := sourceState,
                      mode := Locals.Source.Mode.brk } : Source.Outcome),
                    sourceCtx) := by
            simp [Source.Stmt.run, hSourceScoped]
          have hTargetStmt :
              Locals.Direct.Stmt.run targetProgram targetCtx bodyTargetFuel
                  (.block lowerBody) target =
                .ok (targetOutcome, targetCtx) := by
            simp [Locals.Direct.Stmt.run, hTargetScoped]
          rcases Target.runOpen_singleton_nonregular_exists
              (program := targetProgram) hTargetStmt hTargetNonregular with
            ⟨stmtTargetFuel, hTargetBlock⟩
          refine
            ⟨(({ state := sourceState,
                  mode := Locals.Source.Mode.brk } : Source.Outcome),
                sourceCtx),
              stmtTargetFuel, (targetOutcome, targetCtx), hSourceStmt,
              hTargetBlock, ?_⟩
          exact
            SourceDirectBridge.LiveStmtRunResultRel.of_nonregular
              hOutcomeRel hCtx hNonregular
      | cont =>
          have hNonregular :
              ({ state := sourceState, mode := Locals.Source.Mode.cont } :
                Source.Outcome).mode ≠ .regular := by
            simp
          have hTargetNonregular :
              targetOutcome.mode ≠ .regular :=
            SourceDirectBridge.LiveBlockOpenResultRel.target_nonregular_of_source_nonregular
              hOpenRel hNonregular
          rcases blockScoped_nonregular_from_open
              (prim := prim) (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (retc := retc) (sourceFuel := sourceFuel)
              (targetFuel := bodyTargetFuel) (sourceCtx := sourceCtx)
              (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
              (targetCtxOut := targetCtxOut)
              (hiddenReturns := hiddenReturns) (source := source)
              (target := target)
              (sourceOutcome :=
                { state := sourceState, mode := Locals.Source.Mode.cont })
              (targetOutcome := targetOutcome) (block := body)
              (targetBlock := lowerBody)
              hSourceOpen hTargetOpen hOpenRel hNonregular with
            ⟨hSourceScoped, hTargetScoped, hOutcomeRel⟩
          have hSourceStmt :
              Source.Stmt.run prim sourceProgram sourceCtx sourceFuel
                  (.block body) source =
                .ok
                  (({ state := sourceState,
                      mode := Locals.Source.Mode.cont } : Source.Outcome),
                    sourceCtx) := by
            simp [Source.Stmt.run, hSourceScoped]
          have hTargetStmt :
              Locals.Direct.Stmt.run targetProgram targetCtx bodyTargetFuel
                  (.block lowerBody) target =
                .ok (targetOutcome, targetCtx) := by
            simp [Locals.Direct.Stmt.run, hTargetScoped]
          rcases Target.runOpen_singleton_nonregular_exists
              (program := targetProgram) hTargetStmt hTargetNonregular with
            ⟨stmtTargetFuel, hTargetBlock⟩
          refine
            ⟨(({ state := sourceState,
                  mode := Locals.Source.Mode.cont } : Source.Outcome),
                sourceCtx),
              stmtTargetFuel, (targetOutcome, targetCtx), hSourceStmt,
              hTargetBlock, ?_⟩
          exact
            SourceDirectBridge.LiveStmtRunResultRel.of_nonregular
              hOutcomeRel hCtx hNonregular
      | leave =>
          have hNonregular :
              ({ state := sourceState, mode := Locals.Source.Mode.leave } :
                Source.Outcome).mode ≠ .regular := by
            simp
          have hTargetNonregular :
              targetOutcome.mode ≠ .regular :=
            SourceDirectBridge.LiveBlockOpenResultRel.target_nonregular_of_source_nonregular
              hOpenRel hNonregular
          rcases blockScoped_nonregular_from_open
              (prim := prim) (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (retc := retc) (sourceFuel := sourceFuel)
              (targetFuel := bodyTargetFuel) (sourceCtx := sourceCtx)
              (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
              (targetCtxOut := targetCtxOut)
              (hiddenReturns := hiddenReturns) (source := source)
              (target := target)
              (sourceOutcome :=
                { state := sourceState, mode := Locals.Source.Mode.leave })
              (targetOutcome := targetOutcome) (block := body)
              (targetBlock := lowerBody)
              hSourceOpen hTargetOpen hOpenRel hNonregular with
            ⟨hSourceScoped, hTargetScoped, hOutcomeRel⟩
          have hSourceStmt :
              Source.Stmt.run prim sourceProgram sourceCtx sourceFuel
                  (.block body) source =
                .ok
                  (({ state := sourceState,
                      mode := Locals.Source.Mode.leave } : Source.Outcome),
                    sourceCtx) := by
            simp [Source.Stmt.run, hSourceScoped]
          have hTargetStmt :
              Locals.Direct.Stmt.run targetProgram targetCtx bodyTargetFuel
                  (.block lowerBody) target =
                .ok (targetOutcome, targetCtx) := by
            simp [Locals.Direct.Stmt.run, hTargetScoped]
          rcases Target.runOpen_singleton_nonregular_exists
              (program := targetProgram) hTargetStmt hTargetNonregular with
            ⟨stmtTargetFuel, hTargetBlock⟩
          refine
            ⟨(({ state := sourceState,
                  mode := Locals.Source.Mode.leave } : Source.Outcome),
                sourceCtx),
              stmtTargetFuel, (targetOutcome, targetCtx), hSourceStmt,
              hTargetBlock, ?_⟩
          exact
            SourceDirectBridge.LiveStmtRunResultRel.of_nonregular
              hOutcomeRel hCtx hNonregular
      | halt kind =>
          have hNonregular :
              (Source.Outcome.halt kind sourceState).mode ≠ .regular := by
            simp [Source.Outcome.halt, Locals.Source.Outcome.halt]
          have hTargetNonregular :
              targetOutcome.mode ≠ .regular :=
            SourceDirectBridge.LiveBlockOpenResultRel.target_nonregular_of_source_nonregular
              hOpenRel hNonregular
          rcases blockScoped_nonregular_from_open
              (prim := prim) (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (retc := retc) (sourceFuel := sourceFuel)
              (targetFuel := bodyTargetFuel) (sourceCtx := sourceCtx)
              (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
              (targetCtxOut := targetCtxOut)
              (hiddenReturns := hiddenReturns) (source := source)
              (target := target)
              (sourceOutcome := Source.Outcome.halt kind sourceState)
              (targetOutcome := targetOutcome) (block := body)
              (targetBlock := lowerBody)
              hSourceOpen hTargetOpen hOpenRel hNonregular with
            ⟨hSourceScoped, hTargetScoped, hOutcomeRel⟩
          have hSourceStmt :
              Source.Stmt.run prim sourceProgram sourceCtx sourceFuel
                  (.block body) source =
                .ok (Source.Outcome.halt kind sourceState, sourceCtx) := by
            simp [Source.Stmt.run, hSourceScoped]
          have hTargetStmt :
              Locals.Direct.Stmt.run targetProgram targetCtx bodyTargetFuel
                  (.block lowerBody) target =
                .ok (targetOutcome, targetCtx) := by
            simp [Locals.Direct.Stmt.run, hTargetScoped]
          rcases Target.runOpen_singleton_nonregular_exists
              (program := targetProgram) hTargetStmt hTargetNonregular with
            ⟨stmtTargetFuel, hTargetBlock⟩
          refine
            ⟨(Source.Outcome.halt kind sourceState, sourceCtx),
              stmtTargetFuel, (targetOutcome, targetCtx), hSourceStmt,
              hTargetBlock, ?_⟩
          exact
            SourceDirectBridge.LiveStmtRunResultRel.of_nonregular
              hOutcomeRel hCtx hNonregular

theorem block_liveStmtRunBridge_of_open_bridge_with_layout
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name} {retc sourceFuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {body : Block} {lowerBody : Locals.Block}
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hBody :
      SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
        targetProgram returns retc sourceFuel sourceCtx targetCtx
        hiddenReturns body lowerBody source target) :
    SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
      returns retc sourceFuel sourceCtx targetCtx hiddenReturns (.block body)
      { stmts := [Locals.Stmt.block lowerBody] } source target :=
by
  rcases hBody with
    ⟨sourceResult, bodyTargetFuel, targetResult, hSourceOpen, hTargetOpen,
      hOpenRel, hOpenLayout⟩
  exact
    block_liveStmtRunBridge_of_open_bridge
      (prim := prim) (sourceProgram := sourceProgram)
      (targetProgram := targetProgram) (returns := returns) (retc := retc)
      (sourceFuel := sourceFuel) (sourceCtx := sourceCtx)
      (targetCtx := targetCtx) (hiddenReturns := hiddenReturns)
      (source := source) (target := target) (body := body)
      (lowerBody := lowerBody) hCtx
      ⟨sourceResult, bodyTargetFuel, targetResult, hSourceOpen, hTargetOpen,
        hOpenRel⟩
      (by
        intro sourceInner sourceCtxOut targetInner targetCtxOut targetFuel
          hSourceOpen' hTargetOpen' _hOpenRel'
        rw [hSourceOpen] at hSourceOpen'
        cases hSourceOpen'
        have hTargetOpenMax :
            Locals.Direct.Block.runOpen targetProgram targetCtx
                (Nat.max bodyTargetFuel targetFuel) lowerBody target =
              .ok targetResult :=
          Locals.Direct.Block.runOpen_mono targetProgram
            (Nat.le_max_left bodyTargetFuel targetFuel) hTargetOpen
        have hTargetOpen'Max :
            Locals.Direct.Block.runOpen targetProgram targetCtx
                (Nat.max bodyTargetFuel targetFuel) lowerBody target =
              .ok (Structured.Outcome.regular targetInner, targetCtxOut) :=
          Locals.Direct.Block.runOpen_mono targetProgram
            (Nat.le_max_right bodyTargetFuel targetFuel) hTargetOpen'
        rw [hTargetOpenMax] at hTargetOpen'Max
        cases hTargetOpen'Max
        simpa [SourceDirectBridge.LiveBlockOpenRegularLayoutRel,
          SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo] using
          hOpenLayout)

theorem block_liveLoopStmtRunBridge_of_open_bridge_with_layout
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns loopLayout : List Name} {retc sourceFuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {body : Block} {lowerBody : Locals.Block}
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hBody :
      SourceDirectBridge.LiveLoopBlockOpenRunBridgeWithLayout prim
        sourceProgram targetProgram returns loopLayout retc sourceFuel
        sourceCtx targetCtx hiddenReturns body lowerBody source target) :
    SourceDirectBridge.LiveLoopStmtRunBridgeWithLayout prim sourceProgram
      targetProgram returns loopLayout retc sourceFuel sourceCtx targetCtx
      hiddenReturns (.block body) { stmts := [Locals.Stmt.block lowerBody] }
      source target := by
  rcases hBody with
    ⟨sourceResult, bodyTargetFuel, targetResult, hSourceOpen, hTargetOpen,
      hLoopRel, hOpenLayout⟩
  have hOpenRel :
      SourceDirectBridge.LiveBlockOpenResultRel retc returns hiddenReturns
        sourceResult targetResult :=
    SourceDirectBridge.LiveLoopBlockOpenResultRel.to_liveBlockOpenResultRel
      hLoopRel
  rcases sourceResult with ⟨sourceOutcome, sourceCtxOut⟩
  rcases targetResult with ⟨targetOutcome, targetCtxOut⟩
  cases sourceOutcome with
  | mk sourceState sourceMode =>
      cases sourceMode with
      | regular =>
          rcases
              SourceDirectBridge.LiveBlockOpenResultRel.source_regular_target_regular
                hOpenRel with
            ⟨targetInner, hTargetOutcomeEq, _hOpenStateRel,
              _hOpenCtxRel⟩
          subst targetOutcome
          have hLayout :
              SourceDirect.CleanupLayoutRel targetCtxOut.layout
                targetCtx.layout := by
            simpa [SourceDirectBridge.LiveBlockOpenRegularLayoutRel,
              SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo]
              using hOpenLayout
          rcases blockScoped_regular_from_open
              (prim := prim) (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (retc := retc) (sourceFuel := sourceFuel)
              (targetFuel := bodyTargetFuel) (sourceCtx := sourceCtx)
              (sourceCtxOut := sourceCtxOut) (targetCtx := targetCtx)
              (targetCtxOut := targetCtxOut)
              (hiddenReturns := hiddenReturns) (source := source)
              (sourceInner := sourceState) (target := target)
              (targetInner := targetInner) (block := body)
              (targetBlock := lowerBody)
              hCtx hSourceOpen hTargetOpen hOpenRel hLayout with
            ⟨targetScoped, hSourceScoped, hTargetScoped, hScopedRel⟩
          have hSourceStmt :
              Source.Stmt.run prim sourceProgram sourceCtx sourceFuel
                  (.block body) source =
                .ok
                  (Source.Outcome.regular
                    (Locals.Source.State.restrictTo sourceCtx.scope
                      sourceState),
                    sourceCtx) := by
            simp [Source.Stmt.run, hSourceScoped]
          have hTargetStmt :
              Locals.Direct.Stmt.run targetProgram targetCtx bodyTargetFuel
                  (.block lowerBody) target =
                .ok (Structured.Outcome.regular targetScoped, targetCtx) := by
            simp [Locals.Direct.Stmt.run, hTargetScoped]
          rcases Target.runOpen_singleton_regular_exists
              (program := targetProgram) hTargetStmt with
            ⟨stmtTargetFuel, hTargetBlock⟩
          have hScopedStateRel :
              SourceDirect.StateRel targetCtx.layout hiddenReturns
                (Locals.Source.State.restrictTo sourceCtx.scope sourceState)
                targetScoped :=
            SourceDirectBridge.LiveBlockScopedOutcomeRel.regular_stateRel
              hScopedRel
          have hResultRel :
              SourceDirectBridge.LiveLoopStmtRunResultRel retc returns
                loopLayout hiddenReturns
                (Source.Outcome.regular
                  (Locals.Source.State.restrictTo sourceCtx.scope
                    sourceState),
                  sourceCtx)
                (Structured.Outcome.regular targetScoped, targetCtx) := by
            simpa [SourceDirectBridge.LiveLoopStmtRunResultRel,
              Source.Outcome.regular, Locals.Source.Outcome.regular,
              Structured.Outcome.regular] using
              (show
                SourceDirect.StateRel targetCtx.layout hiddenReturns
                    (Locals.Source.State.restrictTo sourceCtx.scope
                      sourceState) targetScoped ∧
                  SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx from

    (hTargetDepthAfter : targetCtxAfter.breakDepth? = some targetDepth) :
    targetCtxAfter.layout.drop
        (targetCtxAfter.layout.length - targetDepth) =
      loopLayout := by
  have hHeadRegular :
      Source.Stmt.run prim sourceProgram sourceCtx fuel stmt source =
        .ok (Source.Outcome.regular sourceAfter, sourceCtxAfter) := by
    simpa [hHeadEq] using hSourceHead
  have hTargetDepthBefore :
      targetCtx.breakDepth? = some targetDepth := by
    simpa [hTargetCtxEq, Locals.Ctx.withLayout] using hTargetDepthAfter
  have hTargetHandlerAfter :
      SourceDirectBridge.LiveTargetHandlerScopeRel sourceCtxAfter targetCtx := by
    constructor
    · intro depth hDepth name hName
      rw [hSourceCtxScope]
      exact
        SourceDirect.SourceScope.stmt_outEnv_contains_of_contains
          (stmt := stmt) (hTargetHandlerScope.1 hDepth hName)
    · intro depth hDepth name hName
      rw [hSourceCtxScope]

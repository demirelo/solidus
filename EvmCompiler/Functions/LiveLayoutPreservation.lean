            .ok targetTailResult ∧
          SourceDirectBridge.LiveLoopBlockOpenResultRel retc returns
            loopLayout hiddenReturns sourceTailResult targetTailResult ∧
          SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo baseLayout

theorem terminal_liveStmtRunBridge {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {kind : Assembly.HaltKind}
    {sharedAfter : EvmYul.SharedState .EVM}
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hRel : SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hTerminal : prim.terminal kind source.shared [] = .ok sharedAfter) :
    SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
      returns retc fuel sourceCtx targetCtx hiddenReturns (.terminal kind)
      { stmts := [Locals.Stmt.terminal kind] } source target := by
  rcases hRel with ⟨⟨hSharedRel, hStackRel⟩, hReturns⟩
  rcases SourceDirect.Cleanup.runCleanupAll_exists
      (ctx := targetCtx) (state := target) hStackRel.1 with
    ⟨cleaned, hCleanup, hCleanupShared, _hCleanupReturns⟩
  rcases hPrim.terminal_step_exists
      (kind := kind) (shared := source.shared) (shared' := sharedAfter)
      (values := []) (evm := cleaned.evm)
      (baseStack := cleaned.evm.stack)
      hTerminal (by simpa [hCleanupShared] using hSharedRel)
      (by simp) with
    ⟨evmAfter, hStep, hStepShared⟩
  let sourceAfter := source.withShared sharedAfter
  let targetAfter : Locals.RunState := cleaned.withEVM evmAfter
  have hTargetStmt :
      Locals.Direct.Stmt.run targetProgram targetCtx 0 (.terminal kind)
          target =
        .ok (Structured.Outcome.halt kind targetAfter, targetCtx) := by
    simp [Locals.Direct.Stmt.run, hCleanup, hStep, targetAfter]
  rcases Target.runOpen_singleton_nonregular_exists
      (program := targetProgram) hTargetStmt
      (by simp [Structured.Outcome.halt]) with
    ⟨targetFuel, hTargetBlock⟩
  have hOutcomeRel :
      SourceDirect.StmtOutcomeRel returns targetCtx.layout hiddenReturns
        (Source.Outcome.halt kind sourceAfter)
        (Structured.Outcome.halt kind targetAfter) :=
    SourceDirect.StmtOutcomeRel.halt
      (returns := returns) (layout := targetCtx.layout)
      (hiddenReturns := hiddenReturns)
      (source := sourceAfter) (target := targetAfter)
      (by simpa [sourceAfter, targetAfter, Locals.Source.State.withShared,
        Structured.RunState.withEVM] using hStepShared.symm)
  have hResultRel :
      SourceDirectBridge.LiveStmtRunResultRel retc returns hiddenReturns
        (Source.Outcome.halt kind sourceAfter, sourceCtx)
        (Structured.Outcome.halt kind targetAfter, targetCtx) :=
    SourceDirectBridge.LiveStmtRunResultRel.of_nonregular
      ⟨targetCtx.layout, hOutcomeRel⟩ hCtx
      (by simp [Source.Outcome.halt, Locals.Source.Outcome.halt])
  refine
    ⟨(Source.Outcome.halt kind sourceAfter, sourceCtx), targetFuel,
      (Structured.Outcome.halt kind targetAfter, targetCtx), ?_, ?_,
      hResultRel⟩
  · simp [Source.Stmt.run, hTerminal, sourceAfter]
  · exact hTargetBlock


namespace ScopedNoInternalCallShapeRecursiveOpenBlockOutcomeCallbacksUpToOfLeaveFrame

theorem zero {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program} :
    ScopedNoInternalCallShapeRecursiveOpenBlockOutcomeCallbacksUpToOfLeaveFrame
      prim sourceProgram targetProgram 0 := by
  refine { block := ?_ }
  intro returns liveCtx after outLayout retc fuel sourceCtx targetCtx
    hiddenReturns block lowerBlock source target sourceResult hFuel _hLower
    _hProtectedEntry hSourceRun _hStateRel _hNoCall _hScopedBlock
    _hSourceNoDup _hOutcomeCleanup _hNoDup _hReturnsLen _hLeaveFrame
    _hControlRel _hHandlerScope _hReturnsEq
  have hFuelEq : fuel = 0 := Nat.eq_zero_of_le_zero hFuel
  subst fuel
  simp [Source.Block.runOpen, Source.invalid, Structured.invalid] at hSourceRun

theorem mono {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {smallFuel bigFuel : Nat}
    (hLe : smallFuel ≤ bigFuel)
    (hCallbacks :
      ScopedNoInternalCallShapeRecursiveOpenBlockOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram bigFuel) :
    ScopedNoInternalCallShapeRecursiveOpenBlockOutcomeCallbacksUpToOfLeaveFrame
      prim sourceProgram targetProgram smallFuel := by
  refine { block := ?_ }
  intro returns liveCtx after outLayout retc fuel sourceCtx targetCtx
    hiddenReturns block lowerBlock source target sourceResult hFuel
    hProtectedEntry hLower hSourceRun hStateRel hNoCall hScopedBlock
    hSourceNoDup hOutcomeCleanup hNoDup hReturnsLen hLeaveFrame hControlRel
    hHandlerScope hReturnsEq
  exact hCallbacks.block (Nat.le_trans hFuel hLe) hProtectedEntry hLower
    hSourceRun hStateRel hNoCall hScopedBlock hSourceNoDup hOutcomeCleanup
    hNoDup hReturnsLen hLeaveFrame hControlRel hHandlerScope hReturnsEq

theorem blockScoped_openBridge_of_cleanup
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {maxFuel : Nat}
    (hCallbacks :
      ScopedNoInternalCallShapeRecursiveOpenBlockOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel)
    {returns : List Name} {liveCtx : Ctx} {after outLayout : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {block : Block} {lowerBlock : Locals.Block}
    {source : Source.State} {target : Locals.RunState}
    {sourceOutcome : Source.Outcome}
    (hFuelLe : fuel ≤ maxFuel)
    (hProtectedEntry : targetCtx.layout.length ≤ liveCtx.protectedDepth)
    (hLower :
      Lower.Block.toLocals? returns liveCtx targetCtx.layout
          (Checked.scopedAfter targetCtx.layout after) block =
        some (lowerBlock, outLayout))
    (hSourceScoped :
      Source.Block.runScoped prim sourceProgram sourceCtx block fuel source =
        .ok sourceOutcome)
    (hStateRel :
      SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hNoCall : NoInternalCall.Block.Holds block)
    (hScopedBlock : Scope.Block.Scoped sourceCtx.scope block)
    (hSourceNoDup : sourceCtx.scope.Nodup)
    (hCtxCleanup :
      SourceDirectBridge.LiveCtxCleanupRel retc sourceCtx targetCtx)
    (hNoDup : targetCtx.layout.Nodup)
    (hReturnsLen : returns.length = retc)
    (hLeaveFrame : SourceDirect.LeaveFrameAvailable sourceCtx hiddenReturns)
    (hControlRel : SourceDirectBridge.LiveControlRel liveCtx sourceCtx)
    (hHandlerScope :
      SourceDirectBridge.LiveHandlerScopeRel liveCtx sourceCtx)
    (hReturnsEq : liveCtx.returns = returns) :
    SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
      targetProgram returns retc fuel sourceCtx targetCtx hiddenReturns block
      lowerBlock source target := by
  rcases SourceDirect.SourceRun.block_runScoped_open_exists hSourceScoped with
    ⟨sourceOpen, sourceCtxOut, hSourceOpen⟩
  exact
    hCallbacks.block (returns := returns) (liveCtx := liveCtx)
      (after := after) (outLayout := outLayout) (retc := retc)
      (fuel := fuel) (sourceCtx := sourceCtx) (targetCtx := targetCtx)
      (hiddenReturns := hiddenReturns) (block := block)
      (lowerBlock := lowerBlock) (source := source) (target := target)
      (sourceResult := (sourceOpen, sourceCtxOut)) hFuelLe
      hProtectedEntry hLower hSourceOpen hStateRel hNoCall hScopedBlock
      hSourceNoDup
      (SourceDirectBridge.LiveCtxOutcomeCleanupRel.of_cleanupRel hCtxCleanup)
      hNoDup hReturnsLen hLeaveFrame hControlRel hHandlerScope hReturnsEq

theorem runForLoop_with_block_callback_families
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {maxFuel : Nat}
    (hOpenCallbacks :
      ScopedNoInternalCallShapeRecursiveOpenBlockOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel)
    (hLoopOpenBlock :
      ScopedNoInternalCallShapeRecursiveLoopOpenBlockLayoutToOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel)
    {returns : List Name}
    {postLiveCtx bodyLiveCtx : Ctx}
    {postAfter postOut bodyAfter bodyOut : List Name}
    {retc fuel : Nat}
    {loopCtx postBase bodyBase : Source.Ctx}
    {targetLoopCtx targetPostBase targetBodyBase : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {cond : Expr 1} {post body : Block}
    {lowerPost lowerBody : Locals.Block}
    {sourceLoop : Source.Outcome}
    (hFuelLe : fuel ≤ maxFuel)
    (hPostProtected :
      targetPostBase.layout.length ≤ postLiveCtx.protectedDepth)
    (hBodyProtected :
      targetBodyBase.layout.length ≤ bodyLiveCtx.protectedDepth)
    (hLowerPost :
      Lower.Block.toLocals? returns postLiveCtx targetPostBase.layout
          (Checked.scopedAfter targetPostBase.layout postAfter) post =
        some (lowerPost, postOut))
    (hLowerBody :
      Lower.Block.toLocals? returns bodyLiveCtx targetBodyBase.layout
          bodyAfter body =
        some (lowerBody, bodyOut))
    (hCtx : SourceDirectBridge.LiveCtxRel retc loopCtx targetLoopCtx)
    (hPostCtx : SourceDirectBridge.LiveCtxRel retc postBase targetPostBase)
    (hBodyCtx : SourceDirectBridge.LiveCtxRel retc bodyBase targetBodyBase)
    (hTargetPostLayout : targetPostBase.layout = targetLoopCtx.layout)
    (hTargetBodyLayout : targetBodyBase.layout = targetLoopCtx.layout)
    (hPostBreakNone : postBase.breakScope? = none)
    (hPostContinueNone : postBase.continueScope? = none)
    (hLoopNoDup : targetLoopCtx.layout.Nodup)
    (hPostNoDup : targetPostBase.layout.Nodup)
    (hBodyNoDup : targetBodyBase.layout.Nodup)
    (hPostSourceNoDup : postBase.scope.Nodup)
    (hBodySourceNoDup : bodyBase.scope.Nodup)
    (hReturnsLen : returns.length = retc)
    (hPostLeaveFrame :
      SourceDirect.LeaveFrameAvailable postBase hiddenReturns)
    (hBodyLeaveFrame :
      SourceDirect.LeaveFrameAvailable bodyBase hiddenReturns)
    (hPostControlRel :
      SourceDirectBridge.LiveControlRel postLiveCtx postBase)
    (hBodyTargetControlRel :
      SourceDirectBridge.LiveTargetControlRel bodyLiveCtx targetBodyBase)
    (hBodyReturnScopeRel :
      SourceDirectBridge.LiveReturnScopeRel bodyLiveCtx bodyBase)
    (hPostHandlerScope :
      SourceDirectBridge.LiveHandlerScopeRel postLiveCtx postBase)
    (hBodyTargetHandlerScopeRel :
      SourceDirectBridge.LiveTargetHandlerScopeRel bodyBase targetBodyBase)
    (hPostReturnsEq : postLiveCtx.returns = returns)
    (hBodyReturnsEq : bodyLiveCtx.returns = returns)
    (hPostCleanup :
      SourceDirectBridge.LiveCtxCleanupRel retc postBase targetPostBase)
    (hBodyCleanup :
      SourceDirectBridge.LiveCtxCleanupRel retc bodyBase targetBodyBase)
    (hBodyBreakLoopDrop :
      ∀ {targetDepth},
        targetBodyBase.breakDepth? = some targetDepth →
          targetBodyBase.layout.drop
              (targetBodyBase.layout.length - targetDepth) =
            targetLoopCtx.layout)
    (hBodyContinueLoopDrop :
      ∀ {targetDepth},
        targetBodyBase.continueDepth? = some targetDepth →
          targetBodyBase.layout.drop
              (targetBodyBase.layout.length - targetDepth) =
            targetLoopCtx.layout)
    (hBodyRegularBase :
      targetBodyBase.layout.length ≤ bodyLiveCtx.protectedDepth ∧
        (∀ {name : Name}, name ∈ targetBodyBase.layout → name ∈ bodyAfter) ∧
          SourceDirect.CleanupLayoutRel targetBodyBase.layout
            targetBodyBase.layout)
    (hOwned : Locals.Source.Expr.SourceOwned cond)
    (hAccess :
      Locals.SourceLowering.Expr.Accessible targetLoopCtx.layout 0 cond)
    (hRel :
      SourceDirect.StateRel targetLoopCtx.layout hiddenReturns source target)
    (hSourceRun :
      Source.Stmt.runForLoop prim sourceProgram loopCtx cond postBase post
          bodyBase body (fuel + 1) source =
        .ok sourceLoop)
    (hPostNoCall : NoInternalCall.Block.Holds post)
    (hBodyNoCall : NoInternalCall.Block.Holds body)
    (hPostScoped : Scope.Block.Scoped postBase.scope post)
    (hBodyScoped : Scope.Block.Scoped bodyBase.scope body)
    (hLoop :
      ∀ {sourcePost : Source.State} {targetPost : Locals.RunState}
        {sourceLoop' : Source.Outcome},
        Source.Stmt.runForLoop prim sourceProgram loopCtx cond postBase post
            bodyBase body fuel sourcePost =
          .ok sourceLoop' →
        SourceDirect.StateRel targetLoopCtx.layout hiddenReturns sourcePost
          targetPost →
        ∃ targetFuel targetLoop',
          Locals.Direct.Stmt.runForLoop targetProgram targetLoopCtx cond
              targetPostBase lowerPost targetBodyBase lowerBody targetFuel
              targetPost =
            .ok targetLoop' ∧
          SourceDirect.StmtOutcomeRel returns targetLoopCtx.layout
            hiddenReturns sourceLoop' targetLoop') :
    ∃ targetFuel targetLoop,
      Locals.Direct.Stmt.runForLoop targetProgram targetLoopCtx cond
          targetPostBase lowerPost targetBodyBase lowerBody targetFuel target =
        .ok targetLoop ∧
      SourceDirect.StmtOutcomeRel returns targetLoopCtx.layout hiddenReturns
        sourceLoop targetLoop := by
  exact
    runForLoop_from_exact_source_run_live_with_block_bridges
      (prim := prim) hPrim (sourceProgram := sourceProgram)
      (targetProgram := targetProgram) (returns := returns) (retc := retc)
      (fuel := fuel) (loopCtx := loopCtx) (postBase := postBase)
      (bodyBase := bodyBase) (targetLoopCtx := targetLoopCtx)
      (targetPostBase := targetPostBase) (targetBodyBase := targetBodyBase)
      (source := source) (target := target) (hiddenReturns := hiddenReturns)
      (cond := cond) (post := post) (body := body)
      (lowerPost := lowerPost) (lowerBody := lowerBody)
      (sourceLoop := sourceLoop) hCtx hPostCtx hBodyCtx hTargetPostLayout
      hTargetBodyLayout hPostBreakNone hPostContinueNone hLoopNoDup hOwned
      hAccess hRel hSourceRun
      (by
        intro sourceAfterCond targetAfterCond sourceBody hSourceBody hBodyRel
        exact
          ScopedNoInternalCallShapeRecursiveLoopOpenBlockLayoutToOutcomeCallbacksUpToOfLeaveFrame.blockScoped_loopOpenBridge
            (prim := prim) hLoopOpenBlock (returns := returns)
            (loopLayout := targetLoopCtx.layout) (liveCtx := bodyLiveCtx)
            (after := bodyAfter) (outLayout := bodyOut)
            (baseLayout := targetBodyBase.layout) (retc := retc)
            (fuel := fuel) (sourceCtx := bodyBase)
            (targetCtx := targetBodyBase)
            (hiddenReturns := hiddenReturns) (block := body)
            (lowerBlock := lowerBody) (source := sourceAfterCond)
            (target := targetAfterCond) (sourceOutcome := sourceBody)
            hFuelLe hBodyProtected hLowerBody hSourceBody
            (by simpa [hTargetBodyLayout] using hBodyRel)
            hBodyNoCall hBodyScoped hBodySourceNoDup hBodyCleanup
            hBodyNoDup hReturnsLen hBodyLeaveFrame hBodyTargetControlRel
            hBodyReturnScopeRel hBodyTargetHandlerScopeRel hBodyReturnsEq
            hBodyBreakLoopDrop hBodyContinueLoopDrop
            (fun _hRegular => hBodyRegularBase))
      (by
        intro sourceBody targetBody sourcePost _hBodyNext hSourcePost hPostRel
        exact
          ScopedNoInternalCallShapeRecursiveOpenBlockOutcomeCallbacksUpToOfLeaveFrame.blockScoped_openBridge_of_cleanup
            (prim := prim) hOpenCallbacks (returns := returns)
            (liveCtx := postLiveCtx) (after := postAfter)
            (outLayout := postOut) (retc := retc) (fuel := fuel)
            (sourceCtx := postBase) (targetCtx := targetPostBase)
            (hiddenReturns := hiddenReturns) (block := post)
            (lowerBlock := lowerPost) (source := sourceBody.state)
            (target := targetBody.state) (sourceOutcome := sourcePost)
            hFuelLe hPostProtected hLowerPost hSourcePost hPostRel
            hPostNoCall hPostScoped hPostSourceNoDup hPostCleanup hPostNoDup
            hReturnsLen hPostLeaveFrame hPostControlRel hPostHandlerScope
            hPostReturnsEq)
      hLoop

theorem runForLoop_with_block_callback_families_induction
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {maxFuel : Nat}
    (hOpenCallbacks :
      ScopedNoInternalCallShapeRecursiveOpenBlockOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel)
    (hLoopOpenBlock :
      ScopedNoInternalCallShapeRecursiveLoopOpenBlockLayoutToOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel)
    {returns : List Name}
    {postLiveCtx bodyLiveCtx : Ctx}
    {postAfter postOut bodyAfter bodyOut : List Name}
    {retc fuel : Nat}
    {loopCtx postBase bodyBase : Source.Ctx}
    {targetLoopCtx targetPostBase targetBodyBase : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {cond : Expr 1} {post body : Block}
    {lowerPost lowerBody : Locals.Block}
    {sourceLoop : Source.Outcome}
    (hFuelLe : fuel ≤ maxFuel)
    (hPostProtected :
      targetPostBase.layout.length ≤ postLiveCtx.protectedDepth)
    (hBodyProtected :
      targetBodyBase.layout.length ≤ bodyLiveCtx.protectedDepth)
    (hLowerPost :
      Lower.Block.toLocals? returns postLiveCtx targetPostBase.layout
          (Checked.scopedAfter targetPostBase.layout postAfter) post =
        some (lowerPost, postOut))
    (hLowerBody :
      Lower.Block.toLocals? returns bodyLiveCtx targetBodyBase.layout
          bodyAfter body =
        some (lowerBody, bodyOut))
    (hCtx : SourceDirectBridge.LiveCtxRel retc loopCtx targetLoopCtx)
    (hPostCtx : SourceDirectBridge.LiveCtxRel retc postBase targetPostBase)
    (hBodyCtx : SourceDirectBridge.LiveCtxRel retc bodyBase targetBodyBase)
    (hTargetPostLayout : targetPostBase.layout = targetLoopCtx.layout)
    (hTargetBodyLayout : targetBodyBase.layout = targetLoopCtx.layout)
    (hPostBreakNone : postBase.breakScope? = none)
    (hPostContinueNone : postBase.continueScope? = none)
    (hLoopNoDup : targetLoopCtx.layout.Nodup)
    (hPostNoDup : targetPostBase.layout.Nodup)
    (hBodyNoDup : targetBodyBase.layout.Nodup)
    (hPostSourceNoDup : postBase.scope.Nodup)
    (hBodySourceNoDup : bodyBase.scope.Nodup)
    (hReturnsLen : returns.length = retc)
    (hPostLeaveFrame :
      SourceDirect.LeaveFrameAvailable postBase hiddenReturns)
    (hBodyLeaveFrame :
      SourceDirect.LeaveFrameAvailable bodyBase hiddenReturns)
    (hPostControlRel :
      SourceDirectBridge.LiveControlRel postLiveCtx postBase)
    (hBodyTargetControlRel :
      SourceDirectBridge.LiveTargetControlRel bodyLiveCtx targetBodyBase)
    (hBodyReturnScopeRel :
      SourceDirectBridge.LiveReturnScopeRel bodyLiveCtx bodyBase)
    (hPostHandlerScope :
      SourceDirectBridge.LiveHandlerScopeRel postLiveCtx postBase)
    (hBodyTargetHandlerScopeRel :
      SourceDirectBridge.LiveTargetHandlerScopeRel bodyBase targetBodyBase)
    (hPostReturnsEq : postLiveCtx.returns = returns)
    (hBodyReturnsEq : bodyLiveCtx.returns = returns)
    (hPostCleanup :
      SourceDirectBridge.LiveCtxCleanupRel retc postBase targetPostBase)
    (hBodyCleanup :
      SourceDirectBridge.LiveCtxCleanupRel retc bodyBase targetBodyBase)
    (hBodyBreakLoopDrop :
      ∀ {targetDepth},
        targetBodyBase.breakDepth? = some targetDepth →
          targetBodyBase.layout.drop
              (targetBodyBase.layout.length - targetDepth) =
            targetLoopCtx.layout)
    (hBodyContinueLoopDrop :
      ∀ {targetDepth},
        targetBodyBase.continueDepth? = some targetDepth →
          targetBodyBase.layout.drop
              (targetBodyBase.layout.length - targetDepth) =
            targetLoopCtx.layout)
    (hBodyRegularBase :
      targetBodyBase.layout.length ≤ bodyLiveCtx.protectedDepth ∧
        (∀ {name : Name}, name ∈ targetBodyBase.layout → name ∈ bodyAfter) ∧
          SourceDirect.CleanupLayoutRel targetBodyBase.layout
            targetBodyBase.layout)
    (hOwned : Locals.Source.Expr.SourceOwned cond)
    (hAccess :
      Locals.SourceLowering.Expr.Accessible targetLoopCtx.layout 0 cond)
    (hRel :
      SourceDirect.StateRel targetLoopCtx.layout hiddenReturns source target)
    (hSourceRun :
      Source.Stmt.runForLoop prim sourceProgram loopCtx cond postBase post
          bodyBase body (fuel + 1) source =
        .ok sourceLoop)
    (hPostNoCall : NoInternalCall.Block.Holds post)
    (hBodyNoCall : NoInternalCall.Block.Holds body)
    (hPostScoped : Scope.Block.Scoped postBase.scope post)
    (hBodyScoped : Scope.Block.Scoped bodyBase.scope body) :
    ∃ targetFuel targetLoop,
      Locals.Direct.Stmt.runForLoop targetProgram targetLoopCtx cond
          targetPostBase lowerPost targetBodyBase lowerBody targetFuel target =
        .ok targetLoop ∧
      SourceDirect.StmtOutcomeRel returns targetLoopCtx.layout hiddenReturns
        sourceLoop targetLoop := by
  induction fuel generalizing source target sourceLoop with
  | zero =>
      exact
        runForLoop_with_block_callback_families
          (prim := prim) hPrim (sourceProgram := sourceProgram)
          (targetProgram := targetProgram) hOpenCallbacks hLoopOpenBlock
          (returns := returns)
          (postLiveCtx := postLiveCtx) (bodyLiveCtx := bodyLiveCtx)
          (postAfter := postAfter) (postOut := postOut)
          (bodyAfter := bodyAfter) (bodyOut := bodyOut)
          (retc := retc) (fuel := 0) (loopCtx := loopCtx)
          (postBase := postBase) (bodyBase := bodyBase)
          (targetLoopCtx := targetLoopCtx)
          (targetPostBase := targetPostBase)
          (targetBodyBase := targetBodyBase)
          (source := source) (target := target)
          (hiddenReturns := hiddenReturns) (cond := cond) (post := post)
          (body := body) (lowerPost := lowerPost)
          (lowerBody := lowerBody) (sourceLoop := sourceLoop)
          hFuelLe hPostProtected hBodyProtected hLowerPost hLowerBody hCtx

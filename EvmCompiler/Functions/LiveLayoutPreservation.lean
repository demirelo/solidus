          _hLowerStmt _hLowerRest {breakScope} {targetDepth} hBreak
          hTargetDepth => by
        cases hEq
        have hBase :
            SourceDirectBridge.LiveCleanupScopeRel targetCtx.layout targetDepth
              breakScope :=
          hBreakCleanupScope hBreak hTargetDepth
        have hTrim :
            SourceDirectBridge.LiveCleanupScopeRel liveLayout targetDepth
              breakScope := by
          have hTrimBase :
            SourceDirectBridge.LiveCleanupScopeRel
              (Layout.trimDeadPrefix targetCtx.layout liveCtx.breakLive)
              targetDepth breakScope :=
            SourceDirectBridge.LiveControlRel.breakCleanup_trimDeadPrefix
              (live := liveCtx) (source := sourceCtx)
              (layout := targetCtx.layout) (scope := breakScope)
              (depth := targetDepth) hControlRel hBreak hBase
          simpa [Stmt.liveBefore, hStmtLive, hLiveLayout] using hTrimBase
        have hLiveNoDup : liveLayout.Nodup := by
          rw [hLiveLayout, hStmtLive]
          exact Layout.trimDeadPrefix_nodup hNoDup
        have hDepth : targetDepth ≤ liveCtx.protectedDepth := by
          have hDepthLive :
              targetDepth ≤ liveCtx.breakLive.length :=
            SourceDirectBridge.LiveCleanupScopeRel.depth_le_live_length_of_nodup_sameScope
              hTrim hLiveNoDup (hControlRel.1 breakScope hBreak)
          simp [Ctx.protectedDepth]
          omega
        exact
          SourceDirectBridge.LiveCleanupScopeRel.forStmtAboveSuffix_of_depth_bound
            hPrepare hTrim hDepth)
      (fun {stmt} {rest} {restLive} {stmtLive} {liveLayout} {prep}
          {preparedLayout} {lowerStmt} {nextLayout} {lowerRest} hEq
          _hRestLive hStmtLive hLiveLayout hPrepare _hEntry _hAccess
          _hLowerStmt _hLowerRest {continueScope} {targetDepth} hContinue
          hTargetDepth => by
        cases hEq
        have hBase :
            SourceDirectBridge.LiveCleanupScopeRel targetCtx.layout targetDepth
              continueScope :=
          hContinueCleanupScope hContinue hTargetDepth
        have hTrim :
            SourceDirectBridge.LiveCleanupScopeRel liveLayout targetDepth
              continueScope := by
          have hTrimBase :
            SourceDirectBridge.LiveCleanupScopeRel
              (Layout.trimDeadPrefix targetCtx.layout liveCtx.continueLive)
              targetDepth continueScope :=
            SourceDirectBridge.LiveControlRel.continueCleanup_trimDeadPrefix
              (live := liveCtx) (source := sourceCtx)
              (layout := targetCtx.layout) (scope := continueScope)
              (depth := targetDepth) hControlRel hContinue hBase
          simpa [Stmt.liveBefore, hStmtLive, hLiveLayout] using hTrimBase
        have hLiveNoDup : liveLayout.Nodup := by
          rw [hLiveLayout, hStmtLive]
          exact Layout.trimDeadPrefix_nodup hNoDup
        have hDepth : targetDepth ≤ liveCtx.protectedDepth := by
          have hDepthLive :
              targetDepth ≤ liveCtx.continueLive.length :=
            SourceDirectBridge.LiveCleanupScopeRel.depth_le_live_length_of_nodup_sameScope
              hTrim hLiveNoDup (hControlRel.2.1 continueScope hContinue)
          simp [Ctx.protectedDepth]
          omega
        exact
          SourceDirectBridge.LiveCleanupScopeRel.forStmtAboveSuffix_of_depth_bound
            hPrepare hTrim hDepth)
      (fun {_stmt} {_rest} _hEq {leaveScope} hLeave =>
        SourceDirectBridge.LiveControlRel.returnScope_of_returns_eq
          hControlRel hReturnsEq hLeave)
      hBlock hIfBody hSwitchBody hForInit hForLoop hTail

structure ScopedNoInternalCallCallbackBundle
    (prim : Source.PrimitiveSemantics)
    (sourceProgram : Program) (targetProgram : Locals.Program)
    (returns : List Name) (liveCtx : Ctx) (after outLayout : List Name)
    (retc fuel : Nat) (sourceCtx : Source.Ctx) (targetCtx : Locals.Ctx)
    (hiddenReturns : List Structured.ReturnDest)
    (source : Source.State) : Prop where
  ctxCleanup :
    SourceDirectBridge.LiveCtxCleanupRel retc sourceCtx targetCtx
  blockBody :
    ∀ {stmt rest restLive stmtLive liveLayout prep preparedLayout lowerStmt
        nextLayout lowerRest},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive = Stmt.liveBefore liveCtx restLive stmt →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout stmt = true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      ∀ {cleaned},
        SourceDirect.StateRel preparedLayout hiddenReturns source cleaned →
      ∀ {body lowerBody bodyLayout sourceOpenResult},
        NoInternalCall.Block.Holds body →
        Scope.Block.Scoped sourceCtx.scope body →
        Lower.Block.toLocals? returns
            (liveCtx.withProtectedLayout preparedLayout) preparedLayout
          (Checked.scopedAfter preparedLayout restLive) body =
          some (lowerBody, bodyLayout) →
        Source.Block.runOpen prim sourceProgram sourceCtx fuel body source =
          .ok sourceOpenResult →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns retc fuel sourceCtx
          (targetCtx.withLayout preparedLayout)
          hiddenReturns body lowerBody source cleaned
  ifBody :
    ∀ {stmt rest restLive stmtLive liveLayout prep preparedLayout lowerStmt
        nextLayout lowerRest},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive = Stmt.liveBefore liveCtx restLive stmt →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout stmt = true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      ∀ {sourceAfterCond : Source.State}
        {body lowerBody bodyLayout targetAfterCond sourceOpenResult},
        NoInternalCall.Block.Holds body →
        Scope.Block.Scoped sourceCtx.scope body →
        Lower.Block.toLocals? returns
            (liveCtx.withProtectedLayout preparedLayout) preparedLayout
          (Checked.scopedAfter preparedLayout restLive) body =
          some (lowerBody, bodyLayout) →
        Source.Block.runOpen prim sourceProgram sourceCtx fuel.pred body
            sourceAfterCond =
          .ok sourceOpenResult →
        SourceDirect.StateRel preparedLayout hiddenReturns sourceAfterCond
          targetAfterCond →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns retc fuel.pred sourceCtx
          (targetCtx.withLayout preparedLayout)
          hiddenReturns body lowerBody sourceAfterCond targetAfterCond
  switchBody :
    ∀ {stmt rest restLive stmtLive liveLayout prep preparedLayout lowerStmt
        nextLayout lowerRest},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive = Stmt.liveBefore liveCtx restLive stmt →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout stmt = true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      ∀ {sourceAfterScrutinee : Source.State}
        {value body lowerBody bodyLayout targetAfterPop sourceOpenResult}
        {cases : List (Word × Block)} {defaultBody : Option Block},
        NoInternalCall.Block.Holds body →
        Scope.Block.Scoped sourceCtx.scope body →
        Source.Switch.select value cases defaultBody = some body →
        Lower.Block.toLocals? returns
            (liveCtx.withProtectedLayout preparedLayout) preparedLayout
          (Checked.scopedAfter preparedLayout restLive) body =
          some (lowerBody, bodyLayout) →
        Source.Block.runOpen prim sourceProgram sourceCtx fuel.pred body
            sourceAfterScrutinee =
          .ok sourceOpenResult →
        SourceDirect.StateRel preparedLayout hiddenReturns sourceAfterScrutinee
          targetAfterPop →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns retc fuel.pred sourceCtx
          (targetCtx.withLayout preparedLayout)
          hiddenReturns body lowerBody sourceAfterScrutinee targetAfterPop
  forInit :
    ∀ {stmt rest restLive stmtLive liveLayout prep preparedLayout lowerStmt
        nextLayout lowerRest},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive = Stmt.liveBefore liveCtx restLive stmt →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout stmt = true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      ∀ {init post body : Block} {cond : Expr 1},
      NoInternalCall.Block.Holds init →
      Scope.Block.Scoped sourceCtx.scope init →
      let cleanedLayout := preparedLayout
      let loopMentioned :=
        NameSet.unions [Reads.expr cond, Reads.block post, Reads.block body,
          restLive]
      let postLive := Block.liveBefore liveCtx loopMentioned post
      let bodyCtx := liveCtx.withLoop restLive postLive
      let bodyLive := Block.liveBefore bodyCtx postLive body
      let loopLive :=
        NameSet.unions [Reads.expr cond, restLive, postLive, bodyLive]
      let initAfter := NameSet.union loopLive cleanedLayout
      ∀ {cleaned},
        SourceDirect.StateRel cleanedLayout hiddenReturns source cleaned →
      ∀ {lowerInit loopLayout sourceInitResult},
        Lower.Block.toLocals? returns (liveCtx.withProtectedLayout cleanedLayout) cleanedLayout initAfter init =
          some (lowerInit, loopLayout) →
        Source.Block.runOpen prim sourceProgram sourceCtx.withoutLoopControl
            fuel.pred init source =
          .ok sourceInitResult →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns retc fuel.pred
          sourceCtx.withoutLoopControl
          (targetCtx.withLayout cleanedLayout).withoutLoopControl
          hiddenReturns init lowerInit source cleaned
  forLoop :
    ∀ {stmt rest restLive stmtLive liveLayout prep preparedLayout lowerStmt
        nextLayout lowerRest},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive = Stmt.liveBefore liveCtx restLive stmt →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout stmt = true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      ∀ {init post body : Block} {cond : Expr 1},
      NoInternalCall.Block.Holds init →
      NoInternalCall.Block.Holds post →
      NoInternalCall.Block.Holds body →
      Scope.Block.Scoped sourceCtx.scope init →
      Scope.Block.Scoped (Scope.Block.outEnv sourceCtx.scope init) post →
      Scope.Block.Scoped (Scope.Block.outEnv sourceCtx.scope init) body →
      let cleanedLayout := preparedLayout
      let loopMentioned :=
        NameSet.unions [Reads.expr cond, Reads.block post, Reads.block body,
          restLive]
      let postLive := Block.liveBefore liveCtx loopMentioned post
      let bodyCtx := liveCtx.withLoop restLive postLive
      let bodyLive := Block.liveBefore bodyCtx postLive body
      let loopLive :=
        NameSet.unions [Reads.expr cond, restLive, postLive, bodyLive]
      let initAfter := NameSet.union loopLive cleanedLayout
      ∀ {cleaned},
        SourceDirect.StateRel cleanedLayout hiddenReturns source cleaned →
      ∀ {lowerInit loopLayout lowerPost postLayout lowerBody bodyLayout}
        {sourceInitCtx : Source.Ctx} {targetInitCtx : Locals.Ctx}
        {sourceAfterInit : Source.State}
        {targetAfterInit : Locals.RunState}
        {sourceLoop : Source.Outcome} {initTargetFuel : Nat},
        Lower.Block.toLocals? returns (liveCtx.withProtectedLayout cleanedLayout) cleanedLayout initAfter init =
          some (lowerInit, loopLayout) →
        ExprAccess.expr? 0 loopLayout cond = true →
        (let postAfter := Checked.scopedAfter loopLayout loopMentioned
         Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout loopLayout) loopLayout postAfter post =
          some (lowerPost, postLayout)) →
        (let bodyAfter := Checked.scopedAfter loopLayout postLive
         let bodyLoopCtx :=
          liveCtx.withLoop (Checked.scopedAfter loopLayout restLive) bodyAfter
         let bodyCheckCtx := bodyLoopCtx.withProtectedLayout loopLayout
         Lower.Block.toLocals? returns bodyCheckCtx loopLayout bodyAfter body =
          some (lowerBody, bodyLayout)) →
        Source.Block.runOpen prim sourceProgram sourceCtx.withoutLoopControl
            fuel.pred init source =
          .ok (Source.Outcome.regular sourceAfterInit, sourceInitCtx) →
        Locals.Direct.Block.runOpen targetProgram
            (targetCtx.withLayout cleanedLayout).withoutLoopControl
            initTargetFuel lowerInit cleaned =
          .ok (Structured.Outcome.regular targetAfterInit, targetInitCtx) →
        Source.Stmt.runForLoop prim sourceProgram sourceInitCtx cond
            sourceInitCtx.withoutLoopControl post
            (sourceInitCtx.withLoopControl sourceInitCtx.scope
              sourceInitCtx.scope)
            body fuel.pred sourceAfterInit =
          .ok sourceLoop →
        SourceDirect.StateRel targetInitCtx.layout hiddenReturns
          sourceAfterInit targetAfterInit →
        SourceDirectBridge.LiveCtxRel retc sourceInitCtx targetInitCtx →
        ∃ loopTargetFuel targetLoop,
          Locals.Direct.Stmt.runForLoop targetProgram targetInitCtx cond
              targetInitCtx.withoutLoopControl lowerPost
              (targetInitCtx.withLoopControl targetInitCtx.layout.length)
              lowerBody loopTargetFuel targetAfterInit =
            .ok targetLoop ∧
          SourceDirect.StmtOutcomeRel returns targetInitCtx.layout
            hiddenReturns sourceLoop targetLoop
  tail :
    ∀ {stmt rest restLive stmtLive liveLayout prep preparedLayout lowerStmt
        nextLayout lowerRest},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive = Stmt.liveBefore liveCtx restLive stmt →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout stmt = true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      ∀ {sourceAfter : Source.State} {targetAfter : Locals.RunState}
        {sourceCtxAfter : Source.Ctx} {targetCtxAfter : Locals.Ctx}
        {sourceTailResult : Source.Outcome × Source.Ctx},
        targetCtxAfter.layout = nextLayout →
        sourceCtxAfter.scope = Scope.Stmt.outEnv sourceCtx.scope stmt →
        NoInternalCall.Block.Holds { stmts := rest } →
        Scope.Block.Scoped sourceCtxAfter.scope { stmts := rest } →
        Source.Block.runOpen prim sourceProgram sourceCtxAfter fuel
            { stmts := rest } sourceAfter =
          .ok sourceTailResult →
        SourceDirect.StateRel targetCtxAfter.layout hiddenReturns sourceAfter
          targetAfter →
        SourceDirectBridge.LiveCtxRel retc sourceCtxAfter targetCtxAfter →
        ∃ targetTailFuel targetTailResult,
          Locals.Direct.Block.runOpen targetProgram targetCtxAfter
              targetTailFuel { stmts := lowerRest } targetAfter =
            .ok targetTailResult ∧
          SourceDirectBridge.LiveBlockOpenResultRel retc returns
            hiddenReturns sourceTailResult targetTailResult ∧
          SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo targetCtx.layout
            sourceTailResult targetTailResult
  tailEntry :
    ∀ {stmt rest restLive stmtLive liveLayout prep preparedLayout lowerStmt
        nextLayout lowerRest},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive = Stmt.liveBefore liveCtx restLive stmt →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout stmt = true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      ∀ {sourceHeadResult : Source.Outcome × Source.Ctx}
        {sourceAfter : Source.State} {targetAfter : Locals.RunState}
        {sourceCtxAfter : Source.Ctx} {targetCtxAfter : Locals.Ctx}
        {sourceTailResult : Source.Outcome × Source.Ctx},
        Source.Stmt.run prim sourceProgram sourceCtx fuel stmt source =
          .ok sourceHeadResult →
        sourceHeadResult.1.mode = .regular →
        targetCtxAfter.layout = nextLayout →
        targetCtxAfter = targetCtx.withLayout nextLayout →
        sourceCtxAfter.scope = Scope.Stmt.outEnv sourceCtx.scope stmt →
        NoInternalCall.Block.Holds { stmts := rest } →
        Scope.Block.Scoped sourceCtxAfter.scope { stmts := rest } →
        Source.Block.runOpen prim sourceProgram sourceCtxAfter fuel
            { stmts := rest } sourceAfter =
          .ok sourceTailResult →
        SourceDirect.StateRel targetCtxAfter.layout hiddenReturns sourceAfter
          targetAfter →
        SourceDirectBridge.LiveCtxRel retc sourceCtxAfter targetCtxAfter →
        ∃ targetTailFuel targetTailResult,
          Locals.Direct.Block.runOpen targetProgram targetCtxAfter
              targetTailFuel { stmts := lowerRest } targetAfter =
            .ok targetTailResult ∧
          SourceDirectBridge.LiveBlockOpenResultRel retc returns
            hiddenReturns sourceTailResult targetTailResult ∧
          SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo
            targetCtxAfter.layout sourceTailResult targetTailResult

/-- Body callbacks indexed by the statement constructor that can actually use
them.  This is the constructible replacement target for the broader body fields
in `ScopedNoInternalCallCallbackBundle`: atomic heads do not have to prove
unreachable block/if/switch/for body obligations. -/
structure ScopedNoInternalCallShapeBodyCallbacks
    (prim : Source.PrimitiveSemantics)
    (sourceProgram : Program) (targetProgram : Locals.Program)
    (returns : List Name) (liveCtx : Ctx) (after outLayout : List Name)
    (retc fuel : Nat) (sourceCtx : Source.Ctx) (targetCtx : Locals.Ctx)
    (hiddenReturns : List Structured.ReturnDest)
    (source : Source.State) : Prop where
  blockBody :
    ∀ {body : Block} {rest : List Stmt}
      {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
      {prep lowerStmt lowerRest : List Locals.Stmt},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive = Stmt.liveBefore liveCtx restLive (.block body) →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive (.block body) =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout (.block body) = true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive
          (.block body) =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      ∀ {cleaned},
        SourceDirect.StateRel preparedLayout hiddenReturns source cleaned →
      ∀ {lowerBody : Locals.Block} {bodyLayout : List Name}
        {sourceOpenResult : Source.Outcome × Source.Ctx},
        NoInternalCall.Block.Holds body →
        Scope.Block.Scoped sourceCtx.scope body →
        Lower.Block.toLocals? returns
            (liveCtx.withProtectedLayout preparedLayout) preparedLayout
          (Checked.scopedAfter preparedLayout restLive) body =
          some (lowerBody, bodyLayout) →
        Source.Block.runOpen prim sourceProgram sourceCtx fuel body source =
          .ok sourceOpenResult →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns retc fuel sourceCtx
          (targetCtx.withLayout preparedLayout)
          hiddenReturns body lowerBody source cleaned
  ifBody :
    ∀ {cond : Expr 1} {body : Block} {rest : List Stmt}
      {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
      {prep lowerStmt lowerRest : List Locals.Stmt},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive = Stmt.liveBefore liveCtx restLive (.if_ cond body) →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive (.if_ cond body) =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout (.if_ cond body) = true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive
          (.if_ cond body) =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      ∀ {sourceAfterCond : Source.State}
        {lowerBody : Locals.Block} {bodyLayout : List Name}
        {targetAfterCond : Locals.RunState}
        {sourceOpenResult : Source.Outcome × Source.Ctx},
        NoInternalCall.Block.Holds body →
        Scope.Block.Scoped sourceCtx.scope body →
        Lower.Block.toLocals? returns
            (liveCtx.withProtectedLayout preparedLayout) preparedLayout
          (Checked.scopedAfter preparedLayout restLive) body =
          some (lowerBody, bodyLayout) →
        Source.Expr.evalCondition prim cond source =
          .ok (sourceAfterCond, true) →
        Source.Block.runOpen prim sourceProgram sourceCtx fuel.pred body
            sourceAfterCond =
          .ok sourceOpenResult →
        SourceDirect.StateRel preparedLayout hiddenReturns sourceAfterCond
          targetAfterCond →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns retc fuel.pred sourceCtx
          (targetCtx.withLayout preparedLayout)
          hiddenReturns body lowerBody sourceAfterCond targetAfterCond
  switchBody :
    ∀ {switchExpr : Expr 1} {cases : List (Word × Block)}
      {defaultBody : Option Block} {rest : List Stmt}
      {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
      {prep lowerStmt lowerRest : List Locals.Stmt},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive =
        Stmt.liveBefore liveCtx restLive
          (.switch switchExpr cases defaultBody) →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive (.switch switchExpr cases defaultBody) =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout
          (.switch switchExpr cases defaultBody) =
        true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive
          (.switch switchExpr cases defaultBody) =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      ∀ {sourceAfterScrutinee : Source.State}
        {value : Word} {body : Block} {lowerBody : Locals.Block}
        {bodyLayout : List Name} {targetAfterPop : Locals.RunState}
        {sourceOpenResult : Source.Outcome × Source.Ctx},
        NoInternalCall.Block.Holds body →
        Scope.Block.Scoped sourceCtx.scope body →
        Source.Switch.select value cases defaultBody = some body →
        Source.Expr.evalOne prim switchExpr source =
          .ok (sourceAfterScrutinee, value) →
        Lower.Block.toLocals? returns
            (liveCtx.withProtectedLayout preparedLayout) preparedLayout
          (Checked.scopedAfter preparedLayout restLive) body =
          some (lowerBody, bodyLayout) →
        Source.Block.runOpen prim sourceProgram sourceCtx fuel.pred body
            sourceAfterScrutinee =
          .ok sourceOpenResult →
        SourceDirect.StateRel preparedLayout hiddenReturns sourceAfterScrutinee
          targetAfterPop →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns retc fuel.pred sourceCtx
          (targetCtx.withLayout preparedLayout)
          hiddenReturns body lowerBody sourceAfterScrutinee targetAfterPop
  forInit :
    ∀ {init post body : Block} {cond : Expr 1} {rest : List Stmt}
      {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
      {prep lowerStmt lowerRest : List Locals.Stmt},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive =
        Stmt.liveBefore liveCtx restLive (.for_ init cond post body) →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive (.for_ init cond post body) =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout
          (.for_ init cond post body) =
        true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive
          (.for_ init cond post body) =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      NoInternalCall.Block.Holds init →
      Scope.Block.Scoped sourceCtx.scope init →
      let cleanedLayout := preparedLayout
      let loopMentioned :=
        NameSet.unions [Reads.expr cond, Reads.block post, Reads.block body,
          restLive]
      let postLive := Block.liveBefore liveCtx loopMentioned post
      let bodyCtx := liveCtx.withLoop restLive postLive
      let bodyLive := Block.liveBefore bodyCtx postLive body
      let loopLive :=
        NameSet.unions [Reads.expr cond, restLive, postLive, bodyLive]
      let initAfter := NameSet.union loopLive cleanedLayout
      ∀ {cleaned},
        SourceDirect.StateRel cleanedLayout hiddenReturns source cleaned →
      ∀ {lowerInit : Locals.Block} {loopLayout : List Name}
        {sourceInitResult : Source.Outcome × Source.Ctx},
        Lower.Block.toLocals? returns (liveCtx.withProtectedLayout cleanedLayout) cleanedLayout initAfter init =
          some (lowerInit, loopLayout) →
        Source.Block.runOpen prim sourceProgram sourceCtx.withoutLoopControl
            fuel.pred init source =
          .ok sourceInitResult →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns retc fuel.pred
          sourceCtx.withoutLoopControl
          (targetCtx.withLayout cleanedLayout).withoutLoopControl
          hiddenReturns init lowerInit source cleaned
  forLoop :
    ∀ {init post body : Block} {cond : Expr 1} {rest : List Stmt}
      {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
      {prep lowerStmt lowerRest : List Locals.Stmt},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive =
        Stmt.liveBefore liveCtx restLive (.for_ init cond post body) →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive (.for_ init cond post body) =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout
          (.for_ init cond post body) =
        true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive
          (.for_ init cond post body) =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      NoInternalCall.Block.Holds init →
      NoInternalCall.Block.Holds post →
      NoInternalCall.Block.Holds body →
      Scope.Block.Scoped sourceCtx.scope init →
      Scope.Block.Scoped (Scope.Block.outEnv sourceCtx.scope init) post →
      Scope.Block.Scoped (Scope.Block.outEnv sourceCtx.scope init) body →
      let cleanedLayout := preparedLayout
      let loopMentioned :=
        NameSet.unions [Reads.expr cond, Reads.block post, Reads.block body,
          restLive]
      let postLive := Block.liveBefore liveCtx loopMentioned post
      let bodyCtx := liveCtx.withLoop restLive postLive
      let bodyLive := Block.liveBefore bodyCtx postLive body
      let loopLive :=
        NameSet.unions [Reads.expr cond, restLive, postLive, bodyLive]
      let initAfter := NameSet.union loopLive cleanedLayout
      ∀ {cleaned},
        SourceDirect.StateRel cleanedLayout hiddenReturns source cleaned →
      ∀ {lowerInit loopLayout lowerPost postLayout lowerBody bodyLayout}
        {sourceInitCtx : Source.Ctx} {targetInitCtx : Locals.Ctx}
        {sourceAfterInit : Source.State}
        {targetAfterInit : Locals.RunState}
        {sourceLoop : Source.Outcome} {initTargetFuel : Nat},
        Lower.Block.toLocals? returns (liveCtx.withProtectedLayout cleanedLayout) cleanedLayout initAfter init =
          some (lowerInit, loopLayout) →
        ExprAccess.expr? 0 loopLayout cond = true →
        (let postAfter := Checked.scopedAfter loopLayout loopMentioned
         Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout loopLayout) loopLayout postAfter post =
          some (lowerPost, postLayout)) →
        (let bodyAfter := Checked.scopedAfter loopLayout postLive
         let bodyLoopCtx :=
          liveCtx.withLoop (Checked.scopedAfter loopLayout restLive) bodyAfter
         let bodyCheckCtx := bodyLoopCtx.withProtectedLayout loopLayout
         Lower.Block.toLocals? returns bodyCheckCtx loopLayout bodyAfter body =
          some (lowerBody, bodyLayout)) →
        Source.Block.runOpen prim sourceProgram sourceCtx.withoutLoopControl
            fuel.pred init source =
          .ok (Source.Outcome.regular sourceAfterInit, sourceInitCtx) →
        Locals.Direct.Block.runOpen targetProgram
            (targetCtx.withLayout cleanedLayout).withoutLoopControl
            initTargetFuel lowerInit cleaned =
          .ok (Structured.Outcome.regular targetAfterInit, targetInitCtx) →
        Source.Stmt.runForLoop prim sourceProgram sourceInitCtx cond
            sourceInitCtx.withoutLoopControl post
            (sourceInitCtx.withLoopControl sourceInitCtx.scope
              sourceInitCtx.scope)
            body fuel.pred sourceAfterInit =
          .ok sourceLoop →
        SourceDirect.StateRel targetInitCtx.layout hiddenReturns
          sourceAfterInit targetAfterInit →
        SourceDirectBridge.LiveCtxRel retc sourceInitCtx targetInitCtx →
        ∃ loopTargetFuel targetLoop,
          Locals.Direct.Stmt.runForLoop targetProgram targetInitCtx cond
              targetInitCtx.withoutLoopControl lowerPost
              (targetInitCtx.withLoopControl targetInitCtx.layout.length)
              lowerBody loopTargetFuel targetAfterInit =
            .ok targetLoop ∧
          SourceDirect.StmtOutcomeRel returns targetInitCtx.layout
            hiddenReturns sourceLoop targetLoop

/-- Outcome-indexed body callbacks for a concrete one-head open-block run.
The `block`/`if`/`switch` body obligations carry the enclosing source run so
their cleanup facts can be derived from the actually observed outer outcome. -/
structure ScopedNoInternalCallShapeOutcomeBodyCallbacks
    (prim : Source.PrimitiveSemantics)
    (sourceProgram : Program) (targetProgram : Locals.Program)
    (returns : List Name) (liveCtx : Ctx) (after outLayout : List Name)
    (retc fuel : Nat) (sourceCtx : Source.Ctx) (targetCtx : Locals.Ctx)
    (hiddenReturns : List Structured.ReturnDest)
    (source : Source.State) (sourceResult : Source.Outcome × Source.Ctx) :
    Prop where
  blockBody :
    ∀ {body : Block} {rest : List Stmt}
      {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
      {prep lowerStmt lowerRest : List Locals.Stmt},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive = Stmt.liveBefore liveCtx restLive (.block body) →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive (.block body) =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout (.block body) = true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive
          (.block body) =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      Source.Block.runOpen prim sourceProgram sourceCtx (fuel + 1)
          { stmts := .block body :: rest } source =
        .ok sourceResult →
      ∀ {cleaned},
        SourceDirect.StateRel preparedLayout hiddenReturns source cleaned →
      ∀ {lowerBody : Locals.Block} {bodyLayout : List Name}
        {sourceOpenResult : Source.Outcome × Source.Ctx},
        NoInternalCall.Block.Holds body →
        Scope.Block.Scoped sourceCtx.scope body →
        Lower.Block.toLocals? returns
            (liveCtx.withProtectedLayout preparedLayout) preparedLayout
          (Checked.scopedAfter preparedLayout restLive) body =
          some (lowerBody, bodyLayout) →
        Source.Block.runOpen prim sourceProgram sourceCtx fuel body source =
          .ok sourceOpenResult →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns retc fuel sourceCtx
          (targetCtx.withLayout preparedLayout)
          hiddenReturns body lowerBody source cleaned
  ifBody :
    ∀ {cond : Expr 1} {body : Block} {rest : List Stmt}
      {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
      {prep lowerStmt lowerRest : List Locals.Stmt},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive = Stmt.liveBefore liveCtx restLive (.if_ cond body) →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive (.if_ cond body) =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout (.if_ cond body) = true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive
          (.if_ cond body) =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      Source.Block.runOpen prim sourceProgram sourceCtx (fuel + 1)
          { stmts := .if_ cond body :: rest } source =
        .ok sourceResult →
      ∀ {sourceAfterCond : Source.State}
        {lowerBody : Locals.Block} {bodyLayout : List Name}
        {targetAfterCond : Locals.RunState}
        {sourceOpenResult : Source.Outcome × Source.Ctx},
        NoInternalCall.Block.Holds body →
        Scope.Block.Scoped sourceCtx.scope body →
        Lower.Block.toLocals? returns
            (liveCtx.withProtectedLayout preparedLayout) preparedLayout
          (Checked.scopedAfter preparedLayout restLive) body =
          some (lowerBody, bodyLayout) →
        Source.Expr.evalCondition prim cond source =
          .ok (sourceAfterCond, true) →
        Source.Block.runOpen prim sourceProgram sourceCtx fuel.pred body
            sourceAfterCond =
          .ok sourceOpenResult →
        SourceDirect.StateRel preparedLayout hiddenReturns sourceAfterCond
          targetAfterCond →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns retc fuel.pred sourceCtx
          (targetCtx.withLayout preparedLayout)
          hiddenReturns body lowerBody sourceAfterCond targetAfterCond
  switchBody :
    ∀ {switchExpr : Expr 1} {cases : List (Word × Block)}
      {defaultBody : Option Block} {rest : List Stmt}
      {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
      {prep lowerStmt lowerRest : List Locals.Stmt},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive =
        Stmt.liveBefore liveCtx restLive
          (.switch switchExpr cases defaultBody) →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive (.switch switchExpr cases defaultBody) =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout
          (.switch switchExpr cases defaultBody) =
        true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive
          (.switch switchExpr cases defaultBody) =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      Source.Block.runOpen prim sourceProgram sourceCtx (fuel + 1)
          { stmts := .switch switchExpr cases defaultBody :: rest } source =
        .ok sourceResult →
      ∀ {sourceAfterScrutinee : Source.State}
        {value : Word} {body : Block} {lowerBody : Locals.Block}
        {bodyLayout : List Name} {targetAfterPop : Locals.RunState}
        {sourceOpenResult : Source.Outcome × Source.Ctx},
        NoInternalCall.Block.Holds body →
        Scope.Block.Scoped sourceCtx.scope body →
        Source.Switch.select value cases defaultBody = some body →
        Source.Expr.evalOne prim switchExpr source =
          .ok (sourceAfterScrutinee, value) →
        Lower.Block.toLocals? returns
            (liveCtx.withProtectedLayout preparedLayout) preparedLayout
          (Checked.scopedAfter preparedLayout restLive) body =
          some (lowerBody, bodyLayout) →
        Source.Block.runOpen prim sourceProgram sourceCtx fuel.pred body
            sourceAfterScrutinee =
          .ok sourceOpenResult →
        SourceDirect.StateRel preparedLayout hiddenReturns sourceAfterScrutinee
          targetAfterPop →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns retc fuel.pred sourceCtx
          (targetCtx.withLayout preparedLayout)
          hiddenReturns body lowerBody sourceAfterScrutinee targetAfterPop
  forInit :
    ∀ {init post body : Block} {cond : Expr 1} {rest : List Stmt}
      {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
      {prep lowerStmt lowerRest : List Locals.Stmt},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive =
        Stmt.liveBefore liveCtx restLive (.for_ init cond post body) →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive (.for_ init cond post body) =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout
          (.for_ init cond post body) =
        true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive
          (.for_ init cond post body) =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      NoInternalCall.Block.Holds init →
      Scope.Block.Scoped sourceCtx.scope init →
      let cleanedLayout := preparedLayout
      let loopMentioned :=
        NameSet.unions [Reads.expr cond, Reads.block post, Reads.block body,
          restLive]
      let postLive := Block.liveBefore liveCtx loopMentioned post
      let bodyCtx := liveCtx.withLoop restLive postLive
      let bodyLive := Block.liveBefore bodyCtx postLive body
      let loopLive :=
        NameSet.unions [Reads.expr cond, restLive, postLive, bodyLive]
      let initAfter := NameSet.union loopLive cleanedLayout
      ∀ {cleaned},
        SourceDirect.StateRel cleanedLayout hiddenReturns source cleaned →
      ∀ {lowerInit : Locals.Block} {loopLayout : List Name}
        {sourceInitResult : Source.Outcome × Source.Ctx},
        Lower.Block.toLocals? returns (liveCtx.withProtectedLayout cleanedLayout) cleanedLayout initAfter init =
          some (lowerInit, loopLayout) →
        Source.Block.runOpen prim sourceProgram sourceCtx.withoutLoopControl
            fuel.pred init source =
          .ok sourceInitResult →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns retc fuel.pred
          sourceCtx.withoutLoopControl
          (targetCtx.withLayout cleanedLayout).withoutLoopControl
          hiddenReturns init lowerInit source cleaned
  forLoop :
    ∀ {init post body : Block} {cond : Expr 1} {rest : List Stmt}
      {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
      {prep lowerStmt lowerRest : List Locals.Stmt},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive =
        Stmt.liveBefore liveCtx restLive (.for_ init cond post body) →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive (.for_ init cond post body) =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout
          (.for_ init cond post body) =
        true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive
          (.for_ init cond post body) =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      NoInternalCall.Block.Holds init →
      NoInternalCall.Block.Holds post →
      NoInternalCall.Block.Holds body →
      Scope.Block.Scoped sourceCtx.scope init →
      Scope.Block.Scoped (Scope.Block.outEnv sourceCtx.scope init) post →
      Scope.Block.Scoped (Scope.Block.outEnv sourceCtx.scope init) body →
      let cleanedLayout := preparedLayout
      let loopMentioned :=
        NameSet.unions [Reads.expr cond, Reads.block post, Reads.block body,
          restLive]
      let postLive := Block.liveBefore liveCtx loopMentioned post
      let bodyCtx := liveCtx.withLoop restLive postLive
      let bodyLive := Block.liveBefore bodyCtx postLive body
      let loopLive :=
        NameSet.unions [Reads.expr cond, restLive, postLive, bodyLive]
      let initAfter := NameSet.union loopLive cleanedLayout
      ∀ {cleaned},
        SourceDirect.StateRel cleanedLayout hiddenReturns source cleaned →
      ∀ {lowerInit loopLayout lowerPost postLayout lowerBody bodyLayout}
        {sourceInitCtx : Source.Ctx} {targetInitCtx : Locals.Ctx}
        {sourceAfterInit : Source.State}
        {targetAfterInit : Locals.RunState}
        {sourceLoop : Source.Outcome} {initTargetFuel : Nat},
        Lower.Block.toLocals? returns (liveCtx.withProtectedLayout cleanedLayout) cleanedLayout initAfter init =
          some (lowerInit, loopLayout) →
        ExprAccess.expr? 0 loopLayout cond = true →
        (let postAfter := Checked.scopedAfter loopLayout loopMentioned
         Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout loopLayout) loopLayout postAfter post =
          some (lowerPost, postLayout)) →
        (let bodyAfter := Checked.scopedAfter loopLayout postLive
         let bodyLoopCtx :=
          liveCtx.withLoop (Checked.scopedAfter loopLayout restLive) bodyAfter
         let bodyCheckCtx := bodyLoopCtx.withProtectedLayout loopLayout
         Lower.Block.toLocals? returns bodyCheckCtx loopLayout bodyAfter body =
          some (lowerBody, bodyLayout)) →
        Source.Block.runOpen prim sourceProgram sourceCtx.withoutLoopControl
            fuel.pred init source =
          .ok (Source.Outcome.regular sourceAfterInit, sourceInitCtx) →
        Locals.Direct.Block.runOpen targetProgram
            (targetCtx.withLayout cleanedLayout).withoutLoopControl
            initTargetFuel lowerInit cleaned =
          .ok (Structured.Outcome.regular targetAfterInit, targetInitCtx) →
        Source.Stmt.runForLoop prim sourceProgram sourceInitCtx cond
            sourceInitCtx.withoutLoopControl post
            (sourceInitCtx.withLoopControl sourceInitCtx.scope
              sourceInitCtx.scope)
            body fuel.pred sourceAfterInit =
          .ok sourceLoop →
        SourceDirect.StateRel targetInitCtx.layout hiddenReturns
          sourceAfterInit targetAfterInit →
        SourceDirectBridge.LiveCtxRel retc sourceInitCtx targetInitCtx →
        ∃ loopTargetFuel targetLoop,
          Locals.Direct.Stmt.runForLoop targetProgram targetInitCtx cond
              targetInitCtx.withoutLoopControl lowerPost
              (targetInitCtx.withLoopControl targetInitCtx.layout.length)
              lowerBody loopTargetFuel targetAfterInit =
            .ok targetLoop ∧
          SourceDirect.StmtOutcomeRel returns targetInitCtx.layout
            hiddenReturns sourceLoop targetLoop

/-- Shape-indexed recursive callback bundle.  This is the intended public-facing
successor to `ScopedNoInternalCallCallbackBundle` for all-fuels construction:
recursive body callbacks are available only for the statement constructor that
actually exposes that body, while tail callbacks keep their trace-aware shape. -/
structure ScopedNoInternalCallShapeCallbackBundle
    (prim : Source.PrimitiveSemantics)
    (sourceProgram : Program) (targetProgram : Locals.Program)
    (returns : List Name) (liveCtx : Ctx) (after outLayout : List Name)
    (retc fuel : Nat) (sourceCtx : Source.Ctx) (targetCtx : Locals.Ctx)
    (hiddenReturns : List Structured.ReturnDest)
    (source : Source.State) : Prop
    extends ScopedNoInternalCallShapeBodyCallbacks prim sourceProgram
      targetProgram returns liveCtx after outLayout retc fuel sourceCtx
      targetCtx hiddenReturns source where
  ctxCleanup :
    SourceDirectBridge.LiveCtxCleanupRel retc sourceCtx targetCtx
  tail :
    ∀ {stmt rest restLive stmtLive liveLayout prep preparedLayout lowerStmt
        nextLayout lowerRest},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive = Stmt.liveBefore liveCtx restLive stmt →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout stmt = true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      ∀ {sourceAfter : Source.State} {targetAfter : Locals.RunState}
        {sourceCtxAfter : Source.Ctx} {targetCtxAfter : Locals.Ctx}
        {sourceTailResult : Source.Outcome × Source.Ctx},
        targetCtxAfter.layout = nextLayout →
        sourceCtxAfter.scope = Scope.Stmt.outEnv sourceCtx.scope stmt →
        NoInternalCall.Block.Holds { stmts := rest } →
        Scope.Block.Scoped sourceCtxAfter.scope { stmts := rest } →
        Source.Block.runOpen prim sourceProgram sourceCtxAfter fuel
            { stmts := rest } sourceAfter =
          .ok sourceTailResult →
        SourceDirect.StateRel targetCtxAfter.layout hiddenReturns sourceAfter
          targetAfter →
        SourceDirectBridge.LiveCtxRel retc sourceCtxAfter targetCtxAfter →
        ∃ targetTailFuel targetTailResult,
          Locals.Direct.Block.runOpen targetProgram targetCtxAfter
              targetTailFuel { stmts := lowerRest } targetAfter =
            .ok targetTailResult ∧
          SourceDirectBridge.LiveBlockOpenResultRel retc returns
            hiddenReturns sourceTailResult targetTailResult ∧
          SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo targetCtx.layout
            sourceTailResult targetTailResult
  tailEntry :
    ∀ {stmt rest restLive stmtLive liveLayout prep preparedLayout lowerStmt
        nextLayout lowerRest},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive = Stmt.liveBefore liveCtx restLive stmt →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout stmt = true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      ∀ {sourceHeadResult : Source.Outcome × Source.Ctx}
        {sourceAfter : Source.State} {targetAfter : Locals.RunState}
        {sourceCtxAfter : Source.Ctx} {targetCtxAfter : Locals.Ctx}
        {sourceTailResult : Source.Outcome × Source.Ctx},
        Source.Stmt.run prim sourceProgram sourceCtx fuel stmt source =
          .ok sourceHeadResult →
        sourceHeadResult.1.mode = .regular →
        targetCtxAfter.layout = nextLayout →
        targetCtxAfter = targetCtx.withLayout nextLayout →
        sourceCtxAfter.scope = Scope.Stmt.outEnv sourceCtx.scope stmt →
        NoInternalCall.Block.Holds { stmts := rest } →
        Scope.Block.Scoped sourceCtxAfter.scope { stmts := rest } →
        Source.Block.runOpen prim sourceProgram sourceCtxAfter fuel
            { stmts := rest } sourceAfter =
          .ok sourceTailResult →
        SourceDirect.StateRel targetCtxAfter.layout hiddenReturns sourceAfter
          targetAfter →
        SourceDirectBridge.LiveCtxRel retc sourceCtxAfter targetCtxAfter →
        ∃ targetTailFuel targetTailResult,
          Locals.Direct.Block.runOpen targetProgram targetCtxAfter
              targetTailFuel { stmts := lowerRest } targetAfter =
            .ok targetTailResult ∧
          SourceDirectBridge.LiveBlockOpenResultRel retc returns
            hiddenReturns sourceTailResult targetTailResult ∧
            SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo
              targetCtxAfter.layout sourceTailResult targetTailResult

/-- Shape-indexed callbacks for a concrete open-block run.  Unlike
`ScopedNoInternalCallShapeCallbackBundle`, this only asks for cleanup facts for
the actually observed source outcome, which is enough for `break`/`continue`
heads and avoids smuggling unused handler cleanup through the open-block
boundary. -/
structure ScopedNoInternalCallShapeOutcomeCallbackBundle
    (prim : Source.PrimitiveSemantics)
    (sourceProgram : Program) (targetProgram : Locals.Program)
    (returns : List Name) (liveCtx : Ctx) (after outLayout : List Name)
    (retc fuel : Nat) (sourceCtx : Source.Ctx) (targetCtx : Locals.Ctx)
    (hiddenReturns : List Structured.ReturnDest)
    (source : Source.State) (sourceResult : Source.Outcome × Source.Ctx) :
    Prop
    extends ScopedNoInternalCallShapeOutcomeBodyCallbacks prim sourceProgram
      targetProgram returns liveCtx after outLayout retc fuel sourceCtx
      targetCtx hiddenReturns source sourceResult where
  outcomeCleanup :
    SourceDirectBridge.LiveCtxOutcomeCleanupRel retc sourceCtx targetCtx
      sourceResult.1
  tailEntry :
    ∀ {stmt rest restLive stmtLive liveLayout prep preparedLayout lowerStmt
        nextLayout lowerRest},
      restLive = StmtList.liveBefore liveCtx after rest →
      stmtLive = Stmt.liveBefore liveCtx restLive stmt →
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive →
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout) →
      Layout.entryWindowOk? preparedLayout stmtLive = true →
      StmtAccess.accessible? returns preparedLayout stmt = true →
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout) →
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout) →
      ∀ {sourceHeadResult : Source.Outcome × Source.Ctx}
        {sourceAfter : Source.State} {targetAfter : Locals.RunState}
        {sourceCtxAfter : Source.Ctx} {targetCtxAfter : Locals.Ctx}
        {sourceTailResult : Source.Outcome × Source.Ctx},
        Source.Block.runOpen prim sourceProgram sourceCtx (fuel + 1)
            { stmts := stmt :: rest } source =
          .ok sourceResult →
        Source.Stmt.run prim sourceProgram sourceCtx fuel stmt source =
          .ok sourceHeadResult →
        sourceHeadResult = (Source.Outcome.regular sourceAfter, sourceCtxAfter) →
        sourceHeadResult.1.mode = .regular →
        targetCtxAfter.layout = nextLayout →
        targetCtxAfter = targetCtx.withLayout nextLayout →
        sourceCtxAfter.scope = Scope.Stmt.outEnv sourceCtx.scope stmt →
        NoInternalCall.Block.Holds { stmts := rest } →
        Scope.Block.Scoped sourceCtxAfter.scope { stmts := rest } →
        Source.Block.runOpen prim sourceProgram sourceCtxAfter fuel
            { stmts := rest } sourceAfter =
          .ok sourceTailResult →
        SourceDirect.StateRel targetCtxAfter.layout hiddenReturns sourceAfter
          targetAfter →
        SourceDirectBridge.LiveCtxRel retc sourceCtxAfter targetCtxAfter →
        ∃ targetTailFuel targetTailResult,
          Locals.Direct.Block.runOpen targetProgram targetCtxAfter
              targetTailFuel { stmts := lowerRest } targetAfter =
            .ok targetTailResult ∧
          SourceDirectBridge.LiveBlockOpenResultRel retc returns
            hiddenReturns sourceTailResult targetTailResult ∧
          SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo
            targetCtxAfter.layout sourceTailResult targetTailResult

theorem ScopedNoInternalCallShapeCallbackBundle.to_outcome
    {prim : Source.PrimitiveSemantics}

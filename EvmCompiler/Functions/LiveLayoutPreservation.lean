      | ok result =>
          simp [Source.Stmt.run, hEval, Source.Outcome.regular,
            Source.Outcome.brk] at hRun
          cases hRun.1
  | assign assigned value =>
      cases hContains : source.vars.contains assigned with
      | false =>
          simp [Source.Stmt.run, hContains, Source.invalid,
            Structured.invalid] at hRun
      | true =>
          cases hEval : Source.Expr.evalOne prim value source with
          | error err =>
              simp [Source.Stmt.run, hContains, hEval] at hRun
          | ok result =>
              simp [Source.Stmt.run, hContains, hEval,
                Source.Outcome.regular, Source.Outcome.brk] at hRun
              cases hRun.1
  | block body =>
      cases hScopedRun :
          Source.Block.runScoped prim program sourceCtx body fuel source with
      | error err =>
          simp [Source.Stmt.run, hScopedRun] at hRun
      | ok scopedOutcome =>
          cases scopedOutcome with
          | mk scopedState scopedMode =>
              cases scopedMode
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.regular,
                  Source.Outcome.brk] at hRun
                cases hRun.1
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.brk] at hRun
                rcases block_runScoped_brk_open_exists hScopedRun with
                  ⟨sourceCtxInner, hOpen⟩
                exact
                  block_targetBreakSuffix_mem_of_brk_run
                    (live := live) (targetCtx := targetCtx) (block := body)
                    (after := after) hTargetHandler
                    (SourceScopeFacts.stmt_scoped_block hScoped) hOpen
                    hTargetLive hTargetDepth hName
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.brk,
                  Source.Outcome.cont] at hRun
                cases hRun.1
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.brk,
                  Source.Outcome.leave] at hRun
                cases hRun.1
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.brk,
                  Source.Outcome.halt] at hRun
                cases hRun.1
  | if_ cond body =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hCond : Source.Expr.evalCondition prim cond source with
          | error err =>
              simp [Source.Stmt.run, hCond] at hRun
          | ok condResult =>
              rcases condResult with ⟨sourceAfterCond, condTrue⟩
              cases condTrue with
              | false =>
                  simp [Source.Stmt.run, hCond, Source.Outcome.regular,
                    Source.Outcome.brk] at hRun
                  cases hRun.1
              | true =>
                  cases hScopedRun :
                      Source.Block.runScoped prim program sourceCtx body fuel
                        sourceAfterCond with
                  | error err =>
                      simp [Source.Stmt.run, hCond, hScopedRun] at hRun
                  | ok scopedOutcome =>
                      cases scopedOutcome with
                      | mk scopedState scopedMode =>
                          cases scopedMode
                          · simp [Source.Stmt.run, hCond, hScopedRun,
                              Source.Outcome.regular, Source.Outcome.brk]
                              at hRun
                            cases hRun.1
                          · simp [Source.Stmt.run, hCond, hScopedRun,
                              Source.Outcome.brk] at hRun
                            rcases block_runScoped_brk_open_exists
                                hScopedRun with
                              ⟨sourceCtxInner, hOpen⟩
                            exact
                              LiveBefore.if_body_subset_stmt
                                (cond := cond)
                                (block_targetBreakSuffix_mem_of_brk_run
                                  (live := live) (targetCtx := targetCtx)
                                  (block := body) (after := after)
                                  hTargetHandler
                                  (SourceScopeFacts.stmt_scoped_if_body
                                    hScoped)

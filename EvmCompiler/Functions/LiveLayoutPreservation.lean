          ⟨breakScope, hBreakScope⟩
        have hCleanupPrepared :
            SourceDirectBridge.LiveCleanupScopeRel preparedLayout
              targetDepth breakScope :=
          SourceDirectBridge.LiveCtxOutcomeCleanupRel.breakCleanup
            hPreparedOutcomeCleanup hMode hBreakScope hDepth
        have hMemBase :
            name ∈
              targetCtx.layout.drop (targetCtx.layout.length - targetDepth) :=
          SourceDirectBridge.LiveCleanupScopeRel.forStmtAboveSuffix_trimDeadPrefix_suffix_mem
            (hLiveLayout := hLiveLayout) (hPrepare := hPrepare)
            hDepthProtected
            (by
              have hTrim :
                  SourceDirectBridge.LiveCtxOutcomeCleanupRel retc sourceCtx

    {sourceProgram : Program} {targetProgram : Locals.Program} :
    ScopedNoInternalCallRecursiveOpenBlockOutcomeCallbacksUpToOfLeaveFrame prim
      sourceProgram targetProgram 0 := by
  refine { block := ?_ }
  intro returns liveCtx after outLayout retc fuel sourceCtx targetCtx

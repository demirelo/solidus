      hStateRel hNoCall.2 hScoped.2 SourceDirect.CtxRel.initial
      (by simp [Locals.Ctx.initial]) rfl
      SourceDirect.LeaveFrameAvailable.initial
      SourceDirectBridge.LiveControlRel.initial rfl hCallbacks with
    ⟨targetFuel, targetOutcome, hTargetRun, hOutcomeRel⟩
  refine ⟨targetFuel, targetOutcome, ?_, ?_⟩
  · simpa [Locals.Direct.Program.runState] using hTargetRun
  · simpa [SourceDirectBridge.LiveBlockScopedOutcomeRel,
      SourceDirect.BlockScopedOutcomeRel] using hOutcomeRel

theorem runState_toLocalsNoInternalCall_exists_of_all_recursiveCallbacksUpTo
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {fuel : Nat}
    {source : Source.State} {target : Locals.RunState}
    {sourceOutcome : Source.Outcome}
    (hLower :
      Lower.Program.toLocalsNoInternalCall? sourceProgram =
        some targetProgram)
    (hSourceRun :
      Source.Program.runState prim (fuel + 1) sourceProgram source =
        .ok sourceOutcome)
    (hStateRel :
      SourceDirect.StateRel [] [] source target)
    (hScoped : sourceProgram.Scoped)
    (hCallbacks :
      ∀ maxFuel,
        ScopedNoInternalCallRecursiveCallbacksUpTo prim sourceProgram
          targetProgram maxFuel) :
    ∃ targetFuel targetOutcome,
      Locals.Direct.Program.runState targetFuel targetProgram target =
        .ok targetOutcome ∧
      SourceDirect.BlockScopedOutcomeRel [] [] [] sourceOutcome
        targetOutcome :=
  runState_toLocalsNoInternalCall_exists_of_recursiveCallbacksUpTo
    (prim := prim) hPrim (sourceProgram := sourceProgram)
    (targetProgram := targetProgram) (maxFuel := fuel) (fuel := fuel)
    (source := source) (target := target) (sourceOutcome := sourceOutcome)
    (Nat.le_refl fuel) hLower hSourceRun hStateRel hScoped
    (hCallbacks fuel)

end Program


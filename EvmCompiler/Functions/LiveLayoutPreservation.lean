                          sourceState),
                        sourceCtx),
                      targetFuel,
                      (Structured.Outcome.regular targetScoped, targetCtx),
                      hSourceStmt, hTargetBlock, hResultRel,
                      SourceDirect.CleanupLayoutRel.refl targetCtx.layout⟩
              | brk =>
                  have hNonregular :
                      ({ state := sourceState,
                          mode := Locals.Source.Mode.brk } :

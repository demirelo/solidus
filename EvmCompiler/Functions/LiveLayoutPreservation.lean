          hBodyBreakLoopDrop hBodyContinueLoopDrop hBodyRegularBase hOwned
          hAccess hRel hSourceRun hPostNoCall hBodyNoCall hPostScoped
          hBodyScoped
          (by
            intro sourcePost targetPost sourceLoop' hSourceLoop _hRel

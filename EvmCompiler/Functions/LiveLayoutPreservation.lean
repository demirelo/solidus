    (hOwned : Locals.Source.Expr.SourceOwned scrutinee)
    (hAccess :
      Locals.SourceLowering.Expr.Accessible targetCtx.layout 0 scrutinee)
    (hRel :
      SourceDirect.StateRel targetCtx.layout hiddenReturns source target)

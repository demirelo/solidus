theorem stmtList_cons_target_result_of_source_run_lower_components_with_layout_to
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx} {baseLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {rest : List Stmt}
    {stmtLive : List Name} {lowerStmt lowerRest : List Locals.Stmt}
    {source : Source.State} {target : Locals.RunState}
    {sourceResult : Source.Outcome × Source.Ctx}
    (hSourceRun :
      Source.Block.runOpen prim sourceProgram sourceCtx (fuel + 1)
          { stmts := stmt :: rest } source =
        .ok sourceResult)
    (hStateRel :
      SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hHead :
      ∀ {cleaned sourceHeadResult},
        Source.Stmt.run prim sourceProgram sourceCtx fuel stmt source =
          .ok sourceHeadResult →
        SourceDirect.StateRel
          (Layout.trimDeadPrefix targetCtx.layout stmtLive) hiddenReturns
          source cleaned →
        SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
          returns retc fuel sourceCtx
          (targetCtx.withLayout
            (Layout.trimDeadPrefix targetCtx.layout stmtLive))
          hiddenReturns stmt { stmts := lowerStmt } source cleaned)
    (hTail :
      ∀ {sourceAfter : Source.State} {targetAfter : Locals.RunState}
        {sourceCtxAfter : Source.Ctx} {targetCtxAfter : Locals.Ctx}
        {sourceTailResult : Source.Outcome × Source.Ctx},
        Source.Block.runOpen prim sourceProgram sourceCtxAfter fuel
            { stmts := rest } sourceAfter =
          .ok sourceTailResult →
        SourceDirect.StateRel targetCtxAfter.layout hiddenReturns sourceAfter
          targetAfter →
        SourceDirectBridge.LiveCtxRel retc sourceCtxAfter targetCtxAfter →
        ∃ targetTailFuel targetTailResult,
          Locals.Direct.Block.runOpen targetProgram targetCtxAfter
              targetTailFuel { stmts := lowerRest } targetAfter =
            .ok targetTailResult ∧
          SourceDirectBridge.LiveBlockOpenResultRel retc returns hiddenReturns
            sourceTailResult targetTailResult ∧
          SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo baseLayout
            sourceTailResult targetTailResult) :
    ∃ targetFuel targetResult,
      Locals.Direct.Block.runOpen targetProgram targetCtx targetFuel
          { stmts :=
              Lower.cleanupToLive targetCtx.layout stmtLive ::
                lowerStmt ++ lowerRest } target =
        .ok targetResult ∧
      SourceDirectBridge.LiveBlockOpenResultRel retc returns hiddenReturns
        sourceResult targetResult ∧
      SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo baseLayout
        sourceResult targetResult := by
  rcases Target.cleanupToLive_runOpen_exists
      (program := targetProgram) (ctx := targetCtx) (live := stmtLive)
      hStateRel with
    ⟨cleaned, cleanupFuel, hCleanup, hCleanRel⟩
  rcases SourceDirect.Block.source_runOpen_cons_head
      (prim := prim) (program := sourceProgram) (fuel := fuel)
      (sourceCtx := sourceCtx) (source := source) (stmt := stmt)
      (rest := rest) (sourceResult := sourceResult) hSourceRun with
    ⟨sourceHead, stmtSourceCtx, hSourceHead, hSourceTailOfRegular,
      hSourceResultOfNonregular⟩
  rcases hHead hSourceHead hCleanRel with
    ⟨sourceHeadResult, stmtTargetFuel, targetHeadResult, hSourceHead',
      hTargetHead, hHeadRel⟩
  rw [hSourceHead] at hSourceHead'
  cases hSourceHead'
  rcases targetHeadResult with ⟨targetHead, targetRunCtx⟩
  rcases
      Locals.Direct.Block.runOpen_append_regular_exists targetProgram
        [Lower.cleanupToLive targetCtx.layout stmtLive] lowerStmt targetCtx
        (targetCtx.withLayout
          (Layout.trimDeadPrefix targetCtx.layout stmtLive))
        target cleaned targetHead targetRunCtx
        ⟨cleanupFuel, by simpa [Lower.cleanupToLive] using hCleanup⟩
        ⟨stmtTargetFuel, hTargetHead⟩ with
    ⟨targetHeadFuel, hTargetHeadBlock⟩
  cases sourceHead with
  | mk sourceAfter sourceMode =>
      cases sourceMode with
      | regular =>
          rcases
              SourceDirectBridge.LiveStmtRunResultRel.source_regular_target_regular
                hHeadRel with
            ⟨targetAfter, hTargetHeadEq, hHeadStateRel, hHeadCtxRel⟩
          subst targetHead
          have hSourceTail :
              Source.Block.runOpen prim sourceProgram stmtSourceCtx fuel
                  { stmts := rest } sourceAfter =
                .ok sourceResult :=
            hSourceTailOfRegular rfl
          rcases hTail hSourceTail hHeadStateRel hHeadCtxRel with
            ⟨tailTargetFuel, targetTailResult, hTargetTail, hTailRel,
              hTailLayoutRel⟩
          rcases targetTailResult with ⟨targetTail, targetTailCtx⟩
          rcases
              Locals.Direct.Block.runOpen_append_regular_exists targetProgram
                (Lower.cleanupToLive targetCtx.layout stmtLive :: lowerStmt)
                lowerRest targetCtx targetRunCtx target targetAfter
                targetTail targetTailCtx
                ⟨targetHeadFuel, by
                  simpa [Lower.cleanupToLive] using hTargetHeadBlock⟩
                ⟨tailTargetFuel, hTargetTail⟩ with
            ⟨blockFuel, hTargetAppend⟩
          exact
            ⟨blockFuel, (targetTail, targetTailCtx), hTargetAppend, hTailRel,
              hTailLayoutRel⟩
      | brk =>
          have hNonregular :
              ({ state := sourceAfter, mode := Locals.Source.Mode.brk } :
                Source.Outcome).mode ≠ .regular := by
            simp
          have hSourceCtx :=
            Source.Stmt.run_nonregular_ctx hSourceHead hNonregular
          have hSourceResult :
              sourceResult =
                (({ state := sourceAfter, mode := Locals.Source.Mode.brk } :
                  Source.Outcome), sourceCtx) :=
            hSourceResultOfNonregular hNonregular
          have hTargetNonregular :
              targetHead.mode ≠ .regular :=
            SourceDirectBridge.LiveStmtRunResultRel.target_nonregular_of_source_nonregular
              hHeadRel hNonregular
          rcases
              Locals.Direct.Block.runOpen_append_nonregular_exists
                targetProgram
                (Lower.cleanupToLive targetCtx.layout stmtLive :: lowerStmt)
                lowerRest targetCtx target targetHead targetRunCtx
                ⟨targetHeadFuel, by
                  simpa [Lower.cleanupToLive] using hTargetHeadBlock⟩
                hTargetNonregular with
            ⟨blockFuel, hTargetAppend⟩
          refine
            ⟨blockFuel, (targetHead, targetRunCtx), hTargetAppend, ?_, ?_⟩
          · rw [hSourceResult]
            exact
              SourceDirectBridge.LiveBlockOpenResultRel.of_stmt_nonregular
                hHeadRel hSourceCtx hNonregular
          · rw [hSourceResult]
            simp [SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo]
      | cont =>
          have hNonregular :
              ({ state := sourceAfter, mode := Locals.Source.Mode.cont } :
                Source.Outcome).mode ≠ .regular := by
            simp
          have hSourceCtx :=
            Source.Stmt.run_nonregular_ctx hSourceHead hNonregular
          have hSourceResult :
              sourceResult =
                (({ state := sourceAfter, mode := Locals.Source.Mode.cont } :
                  Source.Outcome), sourceCtx) :=
            hSourceResultOfNonregular hNonregular
          have hTargetNonregular :
              targetHead.mode ≠ .regular :=
            SourceDirectBridge.LiveStmtRunResultRel.target_nonregular_of_source_nonregular
              hHeadRel hNonregular
          rcases
              Locals.Direct.Block.runOpen_append_nonregular_exists
                targetProgram
                (Lower.cleanupToLive targetCtx.layout stmtLive :: lowerStmt)
                lowerRest targetCtx target targetHead targetRunCtx
                ⟨targetHeadFuel, by
                  simpa [Lower.cleanupToLive] using hTargetHeadBlock⟩
                hTargetNonregular with
            ⟨blockFuel, hTargetAppend⟩
          refine
            ⟨blockFuel, (targetHead, targetRunCtx), hTargetAppend, ?_, ?_⟩
          · rw [hSourceResult]
            exact
              SourceDirectBridge.LiveBlockOpenResultRel.of_stmt_nonregular
                hHeadRel hSourceCtx hNonregular
          · rw [hSourceResult]
            simp [SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo]
      | leave =>
          have hNonregular :
              ({ state := sourceAfter, mode := Locals.Source.Mode.leave } :
                Source.Outcome).mode ≠ .regular := by
            simp
          have hSourceCtx :=
            Source.Stmt.run_nonregular_ctx hSourceHead hNonregular
          have hSourceResult :
              sourceResult =
                (({ state := sourceAfter, mode := Locals.Source.Mode.leave } :
                  Source.Outcome), sourceCtx) :=
            hSourceResultOfNonregular hNonregular
          have hTargetNonregular :
              targetHead.mode ≠ .regular :=
            SourceDirectBridge.LiveStmtRunResultRel.target_nonregular_of_source_nonregular
              hHeadRel hNonregular
          rcases
              Locals.Direct.Block.runOpen_append_nonregular_exists
                targetProgram
                (Lower.cleanupToLive targetCtx.layout stmtLive :: lowerStmt)
                lowerRest targetCtx target targetHead targetRunCtx
                ⟨targetHeadFuel, by
                  simpa [Lower.cleanupToLive] using hTargetHeadBlock⟩
                hTargetNonregular with
            ⟨blockFuel, hTargetAppend⟩
          refine
            ⟨blockFuel, (targetHead, targetRunCtx), hTargetAppend, ?_, ?_⟩
          · rw [hSourceResult]
            exact
              SourceDirectBridge.LiveBlockOpenResultRel.of_stmt_nonregular
                hHeadRel hSourceCtx hNonregular
          · rw [hSourceResult]
            simp [SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo]
      | halt kind =>
          have hNonregular :
              (Source.Outcome.halt kind sourceAfter).mode ≠ .regular := by
            simp [Source.Outcome.halt, Locals.Source.Outcome.halt]
          have hSourceCtx :=
            Source.Stmt.run_nonregular_ctx hSourceHead hNonregular
          have hSourceResult :
              sourceResult =
                (Source.Outcome.halt kind sourceAfter, sourceCtx) :=
            hSourceResultOfNonregular hNonregular
          have hTargetNonregular :
              targetHead.mode ≠ .regular :=
            SourceDirectBridge.LiveStmtRunResultRel.target_nonregular_of_source_nonregular
              hHeadRel hNonregular
          rcases
              Locals.Direct.Block.runOpen_append_nonregular_exists
                targetProgram
                (Lower.cleanupToLive targetCtx.layout stmtLive :: lowerStmt)
                lowerRest targetCtx target targetHead targetRunCtx
                ⟨targetHeadFuel, by
                  simpa [Lower.cleanupToLive] using hTargetHeadBlock⟩
                hTargetNonregular with
            ⟨blockFuel, hTargetAppend⟩
          refine
            ⟨blockFuel, (targetHead, targetRunCtx), hTargetAppend, ?_, ?_⟩
          · rw [hSourceResult]
            exact
              SourceDirectBridge.LiveBlockOpenResultRel.of_stmt_nonregular
                hHeadRel hSourceCtx hNonregular
          · rw [hSourceResult]
            simp [SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo,
              Source.Outcome.halt, Locals.Source.Outcome.halt]

theorem stmtList_cons_target_result_of_source_run_lower_components_with_layout_to_tail_nextLayout
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name} {liveCtx : Ctx} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx} {baseLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {rest : List Stmt}
    {stmtLive stmtAfter liveLayout preparedLayout nextLayout : List Name}
    {prep lowerStmt lowerRest : List Locals.Stmt}
    {source : Source.State} {target : Locals.RunState}
    {sourceResult : Source.Outcome × Source.Ctx}
    (hLowerStmt :
      Lower.Stmt.toLocals? returns liveCtx preparedLayout stmtAfter stmt =
        some (lowerStmt, nextLayout))
    (hLiveLayout :
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive)
    (hPrepare :
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout))
    (hSourceRun :
      Source.Block.runOpen prim sourceProgram sourceCtx (fuel + 1)
          { stmts := stmt :: rest } source =
        .ok sourceResult)
    (hStateRel :
      SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hHead :
      ∀ {cleaned sourceHeadResult},
        Source.Stmt.run prim sourceProgram sourceCtx fuel stmt source =
          .ok sourceHeadResult →
        SourceDirect.StateRel preparedLayout hiddenReturns source cleaned →
        SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
          returns retc fuel sourceCtx
          (targetCtx.withLayout preparedLayout)
          hiddenReturns stmt { stmts := lowerStmt } source cleaned)
    (hTail :
      ∀ {sourceHeadResult : Source.Outcome × Source.Ctx}
        {sourceAfter : Source.State} {targetAfter : Locals.RunState}
        {sourceCtxAfter : Source.Ctx} {targetCtxAfter : Locals.Ctx}
        {sourceTailResult : Source.Outcome × Source.Ctx},
        Source.Block.runOpen prim sourceProgram sourceCtx (fuel + 1)
            { stmts := stmt :: rest } source =
          .ok sourceResult →
        Source.Stmt.run prim sourceProgram sourceCtx fuel stmt source =
          .ok sourceHeadResult →
        sourceHeadResult = (Source.Outcome.regular sourceAfter, sourceCtxAfter) →
        sourceHeadResult.1.mode = .regular →
        targetCtxAfter.layout = nextLayout →
        targetCtxAfter = targetCtx.withLayout nextLayout →
        sourceCtxAfter.scope = Scope.Stmt.outEnv sourceCtx.scope stmt →
        Source.Block.runOpen prim sourceProgram sourceCtxAfter fuel

theorem block_runScoped_brk_open_exists
    {prim : Source.PrimitiveSemantics} {program : Program}
    {sourceCtx : Source.Ctx} {fuel : Nat} {block : Block}
    {source sourceOut : Source.State}
    (hRun :
      Source.Block.runScoped prim program sourceCtx block fuel source =
        .ok (Source.Outcome.brk sourceOut)) :
    ∃ sourceCtxOut,
      Source.Block.runOpen prim program sourceCtx fuel block source =
        .ok (Source.Outcome.brk sourceOut, sourceCtxOut) := by
  unfold Source.Block.runScoped at hRun
  cases hOpen :
      Source.Block.runOpen prim program sourceCtx fuel block source with
  | error err =>
      simp [hOpen] at hRun
  | ok result =>
      rcases result with ⟨openOutcome, sourceCtxOut⟩
      cases openOutcome with
      | mk openState openMode =>
          cases openMode
          · simp [hOpen, Source.Outcome.regular, Source.Outcome.brk] at hRun
            cases hRun
          · simp [hOpen, Source.Outcome.brk, Locals.Source.Outcome.brk] at hRun
            cases hRun
            refine ⟨sourceCtxOut, ?_⟩
            simp [hOpen, Source.Outcome.brk, Locals.Source.Outcome.brk]
          · simp [hOpen, Source.Outcome.brk, Source.Outcome.cont] at hRun
            cases hRun
          · simp [hOpen, Source.Outcome.brk, Source.Outcome.leave] at hRun
            cases hRun
          · simp [hOpen, Source.Outcome.brk, Source.Outcome.halt] at hRun
            cases hRun

mutual
theorem block_breakLive_mem_of_brk_run
    {prim : Source.PrimitiveSemantics} {program : Program}
    {live : Ctx} {sourceCtx sourceCtxOut : Source.Ctx}
    {fuel : Nat} {block : Block} {source sourceOut : Source.State}
    {after : List Name}
    (hHandler :
      SourceDirectBridge.LiveHandlerScopeRel live sourceCtx)
    (hScoped : Scope.Block.Scoped sourceCtx.scope block)
    (hRun :
      Source.Block.runOpen prim program sourceCtx fuel block source =
        .ok (Source.Outcome.brk sourceOut, sourceCtxOut)) :
    (∃ breakScope, sourceCtx.breakScope? = some breakScope) ∧
      ∀ {name : Name}, name ∈ live.breakLive →
        name ∈ Block.liveBefore live after block := by
  cases block with
  | mk stmts =>
      exact
        stmtList_breakLive_mem_of_brk_run
          (live := live) (stmts := stmts) hHandler hScoped hRun

theorem stmt_breakLive_mem_of_brk_run
    {prim : Source.PrimitiveSemantics} {program : Program}
    {live : Ctx} {sourceCtx sourceCtxOut : Source.Ctx}
    {fuel : Nat} {stmt : Stmt} {source sourceOut : Source.State}
    {after : List Name}
    (hHandler :
      SourceDirectBridge.LiveHandlerScopeRel live sourceCtx)
    (hScoped : Scope.Stmt.Scoped sourceCtx.scope stmt)
    (hRun :
      Source.Stmt.run prim program sourceCtx fuel stmt source =
        .ok (Source.Outcome.brk sourceOut, sourceCtxOut)) :
    (∃ breakScope, sourceCtx.breakScope? = some breakScope) ∧
      ∀ {name : Name}, name ∈ live.breakLive →
        name ∈ Stmt.liveBefore live after stmt := by
  cases stmt with
  | expr expr =>
      cases hEval : Source.Expr.eval prim expr source with
      | error err =>
          simp [Source.Stmt.run, hEval] at hRun
      | ok result =>
          simp [Source.Stmt.run, hEval, Source.Outcome.regular,
            Source.Outcome.brk] at hRun
          cases hRun.1
  | let_ declared value =>
      cases hEval : Source.Expr.evalOne prim value source with
      | error err =>
          simp [Source.Stmt.run, hEval] at hRun
      | ok result =>
          simp [Source.Stmt.run, hEval, Source.Outcome.regular,
            Source.Outcome.brk] at hRun
          cases hRun.1
  | assign assigned value =>
      cases hContains : source.vars.contains assigned with
      | false =>
          simp [Source.Stmt.run, hContains, Source.invalid,
            Structured.invalid] at hRun
      | true =>
          cases hEval : Source.Expr.evalOne prim value source with
          | error err =>
              simp [Source.Stmt.run, hContains, hEval] at hRun
          | ok result =>
              simp [Source.Stmt.run, hContains, hEval,
                Source.Outcome.regular, Source.Outcome.brk] at hRun
              cases hRun.1
  | block body =>
      cases hScopedRun :
          Source.Block.runScoped prim program sourceCtx body fuel source with
      | error err =>
          simp [Source.Stmt.run, hScopedRun] at hRun
      | ok scopedOutcome =>
          cases scopedOutcome with
          | mk scopedState scopedMode =>
              cases scopedMode
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.regular,
                  Source.Outcome.brk] at hRun
                cases hRun.1
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.brk] at hRun
                rcases block_runScoped_brk_open_exists hScopedRun with
                  ⟨sourceCtxInner, hOpen⟩
                exact
                  block_breakLive_mem_of_brk_run
                    (live := live) (block := body) (after := after)
                    hHandler (SourceScopeFacts.stmt_scoped_block hScoped)
                    hOpen
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.brk,
                  Source.Outcome.cont] at hRun
                cases hRun.1
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.brk,
                  Source.Outcome.leave] at hRun
                cases hRun.1
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.brk,
                  Source.Outcome.halt] at hRun
                cases hRun.1
  | if_ cond body =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hCond : Source.Expr.evalCondition prim cond source with
          | error err =>
              simp [Source.Stmt.run, hCond] at hRun
          | ok condResult =>
              rcases condResult with ⟨sourceAfterCond, condTrue⟩
              cases condTrue with
              | false =>
                  simp [Source.Stmt.run, hCond, Source.Outcome.regular,
                    Source.Outcome.brk] at hRun
                  cases hRun.1
              | true =>
                  cases hScopedRun :
                      Source.Block.runScoped prim program sourceCtx body fuel
                        sourceAfterCond with
                  | error err =>
                      simp [Source.Stmt.run, hCond, hScopedRun] at hRun
                  | ok scopedOutcome =>
                      cases scopedOutcome with
                      | mk scopedState scopedMode =>
                          cases scopedMode
                          · simp [Source.Stmt.run, hCond, hScopedRun,
                              Source.Outcome.regular, Source.Outcome.brk]
                              at hRun
                            cases hRun.1
                          · simp [Source.Stmt.run, hCond, hScopedRun,
                              Source.Outcome.brk] at hRun
                            rcases block_runScoped_brk_open_exists
                                hScopedRun with
                              ⟨sourceCtxInner, hOpen⟩
                            rcases
                              block_breakLive_mem_of_brk_run
                                (live := live) (block := body)
                                (after := after) hHandler
                                (SourceScopeFacts.stmt_scoped_if_body hScoped)
                                hOpen with
                              ⟨hBreakExists, hBodyLive⟩
                            exact
                              ⟨hBreakExists, fun {name} hName =>
                                LiveBefore.if_body_subset_stmt
                                  (cond := cond) (hBodyLive hName)⟩
                          · simp [Source.Stmt.run, hCond, hScopedRun,
                              Source.Outcome.brk, Source.Outcome.cont] at hRun
                            cases hRun.1
                          · simp [Source.Stmt.run, hCond, hScopedRun,
                              Source.Outcome.brk, Source.Outcome.leave] at hRun
                            cases hRun.1
                          · simp [Source.Stmt.run, hCond, hScopedRun,
                              Source.Outcome.brk, Source.Outcome.halt] at hRun
                            cases hRun.1
  | switch scrutinee cases defaultBody =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hScrutinee : Source.Expr.evalOne prim scrutinee source with
          | error err =>
              simp [Source.Stmt.run, hScrutinee] at hRun
          | ok scrutineeResult =>
              rcases scrutineeResult with ⟨sourceAfterScrutinee, value⟩
              cases hSelect : Source.Switch.select value cases defaultBody with
              | none =>
                  simp [Source.Stmt.run, hScrutinee, hSelect,
                    Source.Outcome.regular, Source.Outcome.brk] at hRun
                  cases hRun.1
              | some body =>
                  cases hScopedRun :
                      Source.Block.runScoped prim program sourceCtx body fuel
                        sourceAfterScrutinee with
                  | error err =>
                      simp [Source.Stmt.run, hScrutinee, hSelect, hScopedRun]
                        at hRun
                  | ok scopedOutcome =>
                      cases scopedOutcome with
                      | mk scopedState scopedMode =>
                          cases scopedMode
                          · simp [Source.Stmt.run, hScrutinee, hSelect,
                              hScopedRun, Source.Outcome.regular,
                              Source.Outcome.brk] at hRun
                            cases hRun.1
                          · simp [Source.Stmt.run, hScrutinee, hSelect,
                              hScopedRun, Source.Outcome.brk] at hRun
                            rcases block_runScoped_brk_open_exists
                                hScopedRun with
                              ⟨sourceCtxInner, hOpen⟩
                            have hSelectLower :
                                Switch.select value cases defaultBody =
                                  some body := by
                              simpa [SourceDirect.Switch.source_select_eq]
                                using hSelect
                            rcases
                              block_breakLive_mem_of_brk_run
                                (live := live) (block := body)
                                (after := after) hHandler
                                (SourceScopeFacts.stmt_scoped_switch_select_body
                                  hScoped hSelect)
                                hOpen with
                              ⟨hBreakExists, hBodyLive⟩
                            exact
                              ⟨hBreakExists, fun {name} hName =>
                                LiveBefore.switch_selected_body_subset_stmt
                                  (switchExpr := scrutinee) hSelectLower
                                  (hBodyLive hName)⟩
                          · simp [Source.Stmt.run, hScrutinee, hSelect,
                              hScopedRun, Source.Outcome.brk,
                              Source.Outcome.cont] at hRun
                            cases hRun.1
                          · simp [Source.Stmt.run, hScrutinee, hSelect,
                              hScopedRun, Source.Outcome.brk,
                              Source.Outcome.leave] at hRun
                            cases hRun.1
                          · simp [Source.Stmt.run, hScrutinee, hSelect,
                              hScopedRun, Source.Outcome.brk,
                              Source.Outcome.halt] at hRun
                            cases hRun.1
  | for_ init cond post body =>
      have hNot := (SourceDirect.SourceRun.for_stmt_not_break_continue hRun).1
      exact False.elim (hNot rfl)
  | brk =>
      cases hBreak : sourceCtx.breakScope? with
      | none =>
          simp [Source.Stmt.run, hBreak, Source.invalid,
            Structured.invalid] at hRun
      | some breakScope =>
          exact
            ⟨⟨breakScope, rfl⟩, fun {name} hName =>
              by simpa [Stmt.liveBefore] using hName⟩
  | cont =>
      cases hContinue : sourceCtx.continueScope? with
      | none =>
          simp [Source.Stmt.run, hContinue, Source.invalid,
            Structured.invalid] at hRun
      | some continueScope =>
          simp [Source.Stmt.run, hContinue, Source.Outcome.brk,
            Source.Outcome.cont] at hRun
          cases hRun.1
  | leave =>
      cases hLeave : sourceCtx.leaveScope? with
      | none =>
          simp [Source.Stmt.run, hLeave, Source.invalid,
            Structured.invalid] at hRun
      | some leaveScope =>
          simp [Source.Stmt.run, hLeave, Source.Outcome.brk,
            Source.Outcome.leave] at hRun
          cases hRun.1
  | call targets functionName args =>
      have hNot := (SourceDirect.SourceRun.call_stmt_not_break_continue hRun).1
      exact False.elim (hNot rfl)
  | terminal kind =>
      cases hTerminal : prim.terminal kind source.shared [] with
      | error err =>
          simp [Source.Stmt.run, hTerminal] at hRun
      | ok shared =>
          simp [Source.Stmt.run, hTerminal, Source.Outcome.brk,
            Source.Outcome.halt] at hRun
          cases hRun.1
  | terminalArgs kind args =>
      cases hArgs : Locals.Source.Expr.ExprSeq.eval prim args source with
      | error err =>
          simp [Source.Stmt.run, hArgs] at hRun
      | ok argResult =>
          rcases argResult with ⟨sourceAfterArgs, values⟩
          cases hTerminal :
              prim.terminal kind sourceAfterArgs.shared values with
          | error err =>
              simp [Source.Stmt.run, hArgs, hTerminal] at hRun
          | ok shared =>
              simp [Source.Stmt.run, hArgs, hTerminal, Source.Outcome.brk,
                Source.Outcome.halt] at hRun
              cases hRun.1

theorem stmtList_breakLive_mem_of_brk_run
    {prim : Source.PrimitiveSemantics} {program : Program}
    {live : Ctx} {sourceCtx sourceCtxOut : Source.Ctx}
    {fuel : Nat} {stmts : List Stmt} {source sourceOut : Source.State}
    {after : List Name}
    (hHandler :
      SourceDirectBridge.LiveHandlerScopeRel live sourceCtx)
    (hScoped : Scope.StmtList.Scoped sourceCtx.scope stmts)
    (hRun :
      Source.Block.runOpen prim program sourceCtx fuel { stmts := stmts }
          source =
        .ok (Source.Outcome.brk sourceOut, sourceCtxOut)) :
    (∃ breakScope, sourceCtx.breakScope? = some breakScope) ∧
      ∀ {name : Name}, name ∈ live.breakLive →
        name ∈ StmtList.liveBefore live after stmts := by
  cases stmts with
  | nil =>
      cases fuel with
      | zero =>
          simp [Source.Block.runOpen, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          simp [Source.Block.runOpen, Source.Outcome.regular,
            Source.Outcome.brk] at hRun
          cases hRun.1
  | cons stmt rest =>
      cases fuel with
      | zero =>
          simp [Source.Block.runOpen, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          rcases SourceDirect.Block.source_runOpen_cons_head
              (fuel := fuel) hRun with
            ⟨sourceHead, sourceCtxAfter, hHead, hTailIf, hNonregular⟩
          rcases SourceScopeFacts.stmtList_scoped_cons hScoped with
            ⟨hStmtScoped, hRestScopedBase⟩
          cases hHeadMode : sourceHead.mode with
          | regular =>
              have hHeadRegular :
                  Source.Stmt.run prim program sourceCtx fuel stmt source =
                    .ok (Source.Outcome.regular sourceHead.state,
                      sourceCtxAfter) := by
                cases sourceHead with
                | mk sourceHeadState sourceHeadMode =>
                    cases sourceHeadMode <;> simp at hHeadMode
                    simpa [Source.Outcome.regular] using hHead
              have hTailRun :
                  Source.Block.runOpen prim program sourceCtxAfter fuel
                      { stmts := rest } sourceHead.state =
                    .ok (Source.Outcome.brk sourceOut, sourceCtxOut) := by
                simpa [hHeadMode] using hTailIf hHeadMode
              have hCtxAfterScope :
                  sourceCtxAfter.scope =
                    Scope.Stmt.outEnv sourceCtx.scope stmt :=
                SourceDirect.SourceRun.stmt_regular_scope hHeadRegular
              have hRestScoped :
                  Scope.StmtList.Scoped sourceCtxAfter.scope rest := by
                simpa [hCtxAfterScope] using hRestScopedBase
              have hHandlerAfter :
                  SourceDirectBridge.LiveHandlerScopeRel live sourceCtxAfter :=
                SourceDirectBridge.LiveHandlerScopeRel.stmt_regular
                  hHandler hHeadRegular
              rcases
                stmtList_breakLive_mem_of_brk_run
                  (live := live) (stmts := rest) hHandlerAfter hRestScoped
                  hTailRun with
                ⟨⟨breakScopeAfter, hBreakAfter⟩, hRestLive⟩
              have hBreakBase : sourceCtx.breakScope? = some breakScopeAfter := by
                rw [← SourceDirect.SourceRun.stmt_regular_breakScope
                  hHeadRegular]
                exact hBreakAfter
              refine ⟨⟨breakScopeAfter, hBreakBase⟩, ?_⟩
              intro name hName
              have hScope : name ∈ sourceCtx.scope :=
                hHandler.1 breakScopeAfter hBreakBase name hName
              have hHeadLive :
                  name ∈ Stmt.liveBefore live
                    (StmtList.liveBefore live after rest) stmt :=
                RegularRunLiveBefore.stmt_after_mem_of_regular_run
                  (live := live) (stmt := stmt) hStmtScoped hHeadRegular
                  hScope (hRestLive hName)
              simpa [StmtList.liveBefore] using hHeadLive
          | brk =>
              have hHeadRun :
                  Source.Stmt.run prim program sourceCtx fuel stmt source =
                    .ok (Source.Outcome.brk sourceHead.state,
                      sourceCtxAfter) := by
                cases sourceHead with
                | mk sourceHeadState sourceHeadMode =>
                    cases sourceHeadMode <;> simp at hHeadMode
                    simpa [Source.Outcome.brk] using hHead
              rcases
                stmt_breakLive_mem_of_brk_run
                  (live := live) (stmt := stmt)
                  (after := StmtList.liveBefore live after rest)
                  hHandler hStmtScoped hHeadRun with
                ⟨hBreakExists, hStmtLive⟩
              exact
                ⟨hBreakExists, fun {name} hName =>
                  by simpa [StmtList.liveBefore] using hStmtLive hName⟩
          | cont =>
              have hEq := hNonregular (by simp [hHeadMode])
              cases sourceHead with
              | mk sourceHeadState sourceHeadMode =>
                  cases sourceHeadMode <;> simp [Source.Outcome.brk,
                    Source.Outcome.cont] at hHeadMode hEq
                  cases hEq.1
          | leave =>
              have hEq := hNonregular (by simp [hHeadMode])
              cases sourceHead with
              | mk sourceHeadState sourceHeadMode =>
                  cases sourceHeadMode <;> simp [Source.Outcome.brk,
                    Source.Outcome.leave] at hHeadMode hEq
                  cases hEq.1
          | halt kind =>
              have hEq := hNonregular (by simp [hHeadMode])
              cases sourceHead with
              | mk sourceHeadState sourceHeadMode =>
                  cases sourceHeadMode <;> simp [Source.Outcome.brk,
                    Source.Outcome.halt] at hHeadMode hEq
                  cases hEq.1
end

theorem block_runScoped_cont_open_exists
    {prim : Source.PrimitiveSemantics} {program : Program}
    {sourceCtx : Source.Ctx} {fuel : Nat} {block : Block}
    {source sourceOut : Source.State}
    (hRun :
      Source.Block.runScoped prim program sourceCtx block fuel source =
        .ok (Source.Outcome.cont sourceOut)) :
    ∃ sourceCtxOut,
      Source.Block.runOpen prim program sourceCtx fuel block source =
        .ok (Source.Outcome.cont sourceOut, sourceCtxOut) := by
  unfold Source.Block.runScoped at hRun
  cases hOpen :
      Source.Block.runOpen prim program sourceCtx fuel block source with
  | error err =>
      simp [hOpen] at hRun
  | ok result =>
      rcases result with ⟨openOutcome, sourceCtxOut⟩
      cases openOutcome with
      | mk openState openMode =>
          cases openMode
          · simp [hOpen, Source.Outcome.regular, Source.Outcome.cont] at hRun
            cases hRun
          · simp [hOpen, Source.Outcome.brk, Source.Outcome.cont] at hRun
            cases hRun
          · simp [hOpen, Source.Outcome.cont, Locals.Source.Outcome.cont]
              at hRun
            cases hRun
            refine ⟨sourceCtxOut, ?_⟩
            simp [hOpen, Source.Outcome.cont, Locals.Source.Outcome.cont]
          · simp [hOpen, Source.Outcome.cont, Source.Outcome.leave] at hRun
            cases hRun
          · simp [hOpen, Source.Outcome.cont, Source.Outcome.halt] at hRun
            cases hRun

mutual
theorem block_continueLive_mem_of_cont_run
    {prim : Source.PrimitiveSemantics} {program : Program}
    {live : Ctx} {sourceCtx sourceCtxOut : Source.Ctx}
    {fuel : Nat} {block : Block} {source sourceOut : Source.State}
    {after : List Name}
    (hHandler :
      SourceDirectBridge.LiveHandlerScopeRel live sourceCtx)
    (hScoped : Scope.Block.Scoped sourceCtx.scope block)
    (hRun :
      Source.Block.runOpen prim program sourceCtx fuel block source =
        .ok (Source.Outcome.cont sourceOut, sourceCtxOut)) :
    (∃ continueScope, sourceCtx.continueScope? = some continueScope) ∧
      ∀ {name : Name}, name ∈ live.continueLive →
        name ∈ Block.liveBefore live after block := by
  cases block with
  | mk stmts =>
      exact
        stmtList_continueLive_mem_of_cont_run
          (live := live) (stmts := stmts) hHandler hScoped hRun

theorem stmt_continueLive_mem_of_cont_run
    {prim : Source.PrimitiveSemantics} {program : Program}
    {live : Ctx} {sourceCtx sourceCtxOut : Source.Ctx}
    {fuel : Nat} {stmt : Stmt} {source sourceOut : Source.State}
    {after : List Name}
    (hHandler :
      SourceDirectBridge.LiveHandlerScopeRel live sourceCtx)
    (hScoped : Scope.Stmt.Scoped sourceCtx.scope stmt)
    (hRun :
      Source.Stmt.run prim program sourceCtx fuel stmt source =
        .ok (Source.Outcome.cont sourceOut, sourceCtxOut)) :
    (∃ continueScope, sourceCtx.continueScope? = some continueScope) ∧
      ∀ {name : Name}, name ∈ live.continueLive →
        name ∈ Stmt.liveBefore live after stmt := by
  cases stmt with
  | expr expr =>
      cases hEval : Source.Expr.eval prim expr source with
      | error err =>
          simp [Source.Stmt.run, hEval] at hRun
      | ok result =>
          simp [Source.Stmt.run, hEval, Source.Outcome.regular,
            Source.Outcome.cont] at hRun
          cases hRun.1
  | let_ declared value =>
      cases hEval : Source.Expr.evalOne prim value source with
      | error err =>
          simp [Source.Stmt.run, hEval] at hRun
      | ok result =>
          simp [Source.Stmt.run, hEval, Source.Outcome.regular,
            Source.Outcome.cont] at hRun
          cases hRun.1
  | assign assigned value =>
      cases hContains : source.vars.contains assigned with
      | false =>
          simp [Source.Stmt.run, hContains, Source.invalid,
            Structured.invalid] at hRun
      | true =>
          cases hEval : Source.Expr.evalOne prim value source with
          | error err =>
              simp [Source.Stmt.run, hContains, hEval] at hRun
          | ok result =>
              simp [Source.Stmt.run, hContains, hEval,
                Source.Outcome.regular, Source.Outcome.cont] at hRun
              cases hRun.1
  | block body =>
      cases hScopedRun :
          Source.Block.runScoped prim program sourceCtx body fuel source with
      | error err =>
          simp [Source.Stmt.run, hScopedRun] at hRun
      | ok scopedOutcome =>
          cases scopedOutcome with
          | mk scopedState scopedMode =>
              cases scopedMode
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.regular,
                  Source.Outcome.cont] at hRun
                cases hRun.1
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.brk,
                  Source.Outcome.cont] at hRun
                cases hRun.1
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.cont] at hRun
                rcases block_runScoped_cont_open_exists hScopedRun with
                  ⟨sourceCtxInner, hOpen⟩
                exact
                  block_continueLive_mem_of_cont_run
                    (live := live) (block := body) (after := after)
                    hHandler (SourceScopeFacts.stmt_scoped_block hScoped)
                    hOpen
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.cont,
                  Source.Outcome.leave] at hRun
                cases hRun.1
              · simp [Source.Stmt.run, hScopedRun, Source.Outcome.cont,
                  Source.Outcome.halt] at hRun
                cases hRun.1
  | if_ cond body =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hCond : Source.Expr.evalCondition prim cond source with
          | error err =>
              simp [Source.Stmt.run, hCond] at hRun
          | ok condResult =>
              rcases condResult with ⟨sourceAfterCond, condTrue⟩
              cases condTrue with
              | false =>
                  simp [Source.Stmt.run, hCond, Source.Outcome.regular,
                    Source.Outcome.cont] at hRun
                  cases hRun.1
              | true =>
                  cases hScopedRun :
                      Source.Block.runScoped prim program sourceCtx body fuel
                        sourceAfterCond with
                  | error err =>
                      simp [Source.Stmt.run, hCond, hScopedRun] at hRun
                  | ok scopedOutcome =>
                      cases scopedOutcome with
                      | mk scopedState scopedMode =>
                          cases scopedMode
                          · simp [Source.Stmt.run, hCond, hScopedRun,
                              Source.Outcome.regular, Source.Outcome.cont]
                              at hRun
                            cases hRun.1
                          · simp [Source.Stmt.run, hCond, hScopedRun,
                              Source.Outcome.brk, Source.Outcome.cont] at hRun
                            cases hRun.1
                          · simp [Source.Stmt.run, hCond, hScopedRun,
                              Source.Outcome.cont] at hRun
                            rcases block_runScoped_cont_open_exists
                                hScopedRun with
                              ⟨sourceCtxInner, hOpen⟩
                            rcases
                              block_continueLive_mem_of_cont_run
                                (live := live) (block := body)
                                (after := after) hHandler
                                (SourceScopeFacts.stmt_scoped_if_body hScoped)
                                hOpen with
                              ⟨hContinueExists, hBodyLive⟩
                            exact
                              ⟨hContinueExists, fun {name} hName =>
                                LiveBefore.if_body_subset_stmt
                                  (cond := cond) (hBodyLive hName)⟩
                          · simp [Source.Stmt.run, hCond, hScopedRun,
                              Source.Outcome.cont, Source.Outcome.leave] at hRun
                            cases hRun.1
                          · simp [Source.Stmt.run, hCond, hScopedRun,
                              Source.Outcome.cont, Source.Outcome.halt] at hRun
                            cases hRun.1
  | switch scrutinee cases defaultBody =>
      cases fuel with
      | zero =>
          simp [Source.Stmt.run, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          cases hScrutinee : Source.Expr.evalOne prim scrutinee source with
          | error err =>
              simp [Source.Stmt.run, hScrutinee] at hRun
          | ok scrutineeResult =>
              rcases scrutineeResult with ⟨sourceAfterScrutinee, value⟩
              cases hSelect : Source.Switch.select value cases defaultBody with
              | none =>
                  simp [Source.Stmt.run, hScrutinee, hSelect,
                    Source.Outcome.regular, Source.Outcome.cont] at hRun
                  cases hRun.1
              | some body =>
                  cases hScopedRun :
                      Source.Block.runScoped prim program sourceCtx body fuel
                        sourceAfterScrutinee with
                  | error err =>
                      simp [Source.Stmt.run, hScrutinee, hSelect, hScopedRun]
                        at hRun
                  | ok scopedOutcome =>
                      cases scopedOutcome with
                      | mk scopedState scopedMode =>
                          cases scopedMode
                          · simp [Source.Stmt.run, hScrutinee, hSelect,
                              hScopedRun, Source.Outcome.regular,
                              Source.Outcome.cont] at hRun
                            cases hRun.1
                          · simp [Source.Stmt.run, hScrutinee, hSelect,
                              hScopedRun, Source.Outcome.brk,
                              Source.Outcome.cont] at hRun
                            cases hRun.1
                          · simp [Source.Stmt.run, hScrutinee, hSelect,
                              hScopedRun, Source.Outcome.cont] at hRun
                            rcases block_runScoped_cont_open_exists
                                hScopedRun with
                              ⟨sourceCtxInner, hOpen⟩
                            have hSelectLower :
                                Switch.select value cases defaultBody =
                                  some body := by
                              simpa [SourceDirect.Switch.source_select_eq]
                                using hSelect
                            rcases
                              block_continueLive_mem_of_cont_run
                                (live := live) (block := body)
                                (after := after) hHandler
                                (SourceScopeFacts.stmt_scoped_switch_select_body
                                  hScoped hSelect)
                                hOpen with
                              ⟨hContinueExists, hBodyLive⟩
                            exact
                              ⟨hContinueExists, fun {name} hName =>
                                LiveBefore.switch_selected_body_subset_stmt
                                  (switchExpr := scrutinee) hSelectLower
                                  (hBodyLive hName)⟩
                          · simp [Source.Stmt.run, hScrutinee, hSelect,
                              hScopedRun, Source.Outcome.cont,
                              Source.Outcome.leave] at hRun
                            cases hRun.1
                          · simp [Source.Stmt.run, hScrutinee, hSelect,
                              hScopedRun, Source.Outcome.cont,
                              Source.Outcome.halt] at hRun
                            cases hRun.1
  | for_ init cond post body =>
      have hNot := (SourceDirect.SourceRun.for_stmt_not_break_continue hRun).2
      exact False.elim (hNot rfl)
  | brk =>
      cases hBreak : sourceCtx.breakScope? with
      | none =>
          simp [Source.Stmt.run, hBreak, Source.invalid,
            Structured.invalid] at hRun
      | some breakScope =>
          simp [Source.Stmt.run, hBreak, Source.Outcome.brk,
            Source.Outcome.cont] at hRun
          cases hRun.1
  | cont =>
      cases hContinue : sourceCtx.continueScope? with
      | none =>
          simp [Source.Stmt.run, hContinue, Source.invalid,
            Structured.invalid] at hRun
      | some continueScope =>
          exact
            ⟨⟨continueScope, rfl⟩, fun {name} hName =>
              by simpa [Stmt.liveBefore] using hName⟩
  | leave =>
      cases hLeave : sourceCtx.leaveScope? with
      | none =>
          simp [Source.Stmt.run, hLeave, Source.invalid,
            Structured.invalid] at hRun
      | some leaveScope =>
          simp [Source.Stmt.run, hLeave, Source.Outcome.cont,
            Source.Outcome.leave] at hRun
          cases hRun.1
  | call targets functionName args =>
      have hNot := (SourceDirect.SourceRun.call_stmt_not_break_continue hRun).2
      exact False.elim (hNot rfl)
  | terminal kind =>
      cases hTerminal : prim.terminal kind source.shared [] with
      | error err =>
          simp [Source.Stmt.run, hTerminal] at hRun
      | ok shared =>
          simp [Source.Stmt.run, hTerminal, Source.Outcome.cont,
            Source.Outcome.halt] at hRun
          cases hRun.1
  | terminalArgs kind args =>
      cases hArgs : Locals.Source.Expr.ExprSeq.eval prim args source with
      | error err =>
          simp [Source.Stmt.run, hArgs] at hRun
      | ok argResult =>
          rcases argResult with ⟨sourceAfterArgs, values⟩
          cases hTerminal :
              prim.terminal kind sourceAfterArgs.shared values with
          | error err =>
              simp [Source.Stmt.run, hArgs, hTerminal] at hRun
          | ok shared =>
              simp [Source.Stmt.run, hArgs, hTerminal, Source.Outcome.cont,
                Source.Outcome.halt] at hRun
              cases hRun.1

theorem stmtList_continueLive_mem_of_cont_run
    {prim : Source.PrimitiveSemantics} {program : Program}
    {live : Ctx} {sourceCtx sourceCtxOut : Source.Ctx}
    {fuel : Nat} {stmts : List Stmt} {source sourceOut : Source.State}
    {after : List Name}
    (hHandler :
      SourceDirectBridge.LiveHandlerScopeRel live sourceCtx)
    (hScoped : Scope.StmtList.Scoped sourceCtx.scope stmts)
    (hRun :
      Source.Block.runOpen prim program sourceCtx fuel { stmts := stmts }
          source =
        .ok (Source.Outcome.cont sourceOut, sourceCtxOut)) :
    (∃ continueScope, sourceCtx.continueScope? = some continueScope) ∧
      ∀ {name : Name}, name ∈ live.continueLive →
        name ∈ StmtList.liveBefore live after stmts := by
  cases stmts with
  | nil =>
      cases fuel with
      | zero =>
          simp [Source.Block.runOpen, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          simp [Source.Block.runOpen, Source.Outcome.regular,
            Source.Outcome.cont] at hRun
          cases hRun.1
  | cons stmt rest =>
      cases fuel with
      | zero =>
          simp [Source.Block.runOpen, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          rcases SourceDirect.Block.source_runOpen_cons_head
              (fuel := fuel) hRun with
            ⟨sourceHead, sourceCtxAfter, hHead, hTailIf, hNonregular⟩
          rcases SourceScopeFacts.stmtList_scoped_cons hScoped with
            ⟨hStmtScoped, hRestScopedBase⟩
          cases hHeadMode : sourceHead.mode with
          | regular =>
              have hHeadRegular :
                  Source.Stmt.run prim program sourceCtx fuel stmt source =
                    .ok (Source.Outcome.regular sourceHead.state,
                      sourceCtxAfter) := by
                cases sourceHead with
                | mk sourceHeadState sourceHeadMode =>
                    cases sourceHeadMode <;> simp at hHeadMode
                    simpa [Source.Outcome.regular] using hHead
              have hTailRun :
                  Source.Block.runOpen prim program sourceCtxAfter fuel
                      { stmts := rest } sourceHead.state =
                    .ok (Source.Outcome.cont sourceOut, sourceCtxOut) := by
                simpa [hHeadMode] using hTailIf hHeadMode
              have hCtxAfterScope :
                  sourceCtxAfter.scope =
                    Scope.Stmt.outEnv sourceCtx.scope stmt :=
                SourceDirect.SourceRun.stmt_regular_scope hHeadRegular
              have hRestScoped :
                  Scope.StmtList.Scoped sourceCtxAfter.scope rest := by
                simpa [hCtxAfterScope] using hRestScopedBase
              have hHandlerAfter :
                  SourceDirectBridge.LiveHandlerScopeRel live sourceCtxAfter :=
                SourceDirectBridge.LiveHandlerScopeRel.stmt_regular
                  hHandler hHeadRegular
              rcases
                stmtList_continueLive_mem_of_cont_run
                  (live := live) (stmts := rest) hHandlerAfter hRestScoped
                  hTailRun with
                ⟨⟨continueScopeAfter, hContinueAfter⟩, hRestLive⟩
              have hContinueBase :
                  sourceCtx.continueScope? = some continueScopeAfter := by
                rw [← SourceDirect.SourceRun.stmt_regular_continueScope
                  hHeadRegular]
                exact hContinueAfter
              refine ⟨⟨continueScopeAfter, hContinueBase⟩, ?_⟩
              intro name hName
              have hScope : name ∈ sourceCtx.scope :=
                hHandler.2 continueScopeAfter hContinueBase name hName
              have hHeadLive :
                  name ∈ Stmt.liveBefore live
                    (StmtList.liveBefore live after rest) stmt :=
                RegularRunLiveBefore.stmt_after_mem_of_regular_run
                  (live := live) (stmt := stmt) hStmtScoped hHeadRegular
                  hScope (hRestLive hName)
              simpa [StmtList.liveBefore] using hHeadLive
          | brk =>
              have hEq := hNonregular (by simp [hHeadMode])
              cases sourceHead with
              | mk sourceHeadState sourceHeadMode =>
                  cases sourceHeadMode <;> simp [Source.Outcome.brk,
                    Source.Outcome.cont] at hHeadMode hEq
                  cases hEq.1
          | cont =>
              have hHeadRun :
                  Source.Stmt.run prim program sourceCtx fuel stmt source =
                    .ok (Source.Outcome.cont sourceHead.state,
                      sourceCtxAfter) := by
                cases sourceHead with
                | mk sourceHeadState sourceHeadMode =>
                    cases sourceHeadMode <;> simp at hHeadMode
                    simpa [Source.Outcome.cont] using hHead
              rcases
                stmt_continueLive_mem_of_cont_run
                  (live := live) (stmt := stmt)
                  (after := StmtList.liveBefore live after rest)
                  hHandler hStmtScoped hHeadRun with
                ⟨hContinueExists, hStmtLive⟩
              exact
                ⟨hContinueExists, fun {name} hName =>
                  by simpa [StmtList.liveBefore] using hStmtLive hName⟩
          | leave =>
              have hEq := hNonregular (by simp [hHeadMode])
              cases sourceHead with
              | mk sourceHeadState sourceHeadMode =>
                  cases sourceHeadMode <;> simp [Source.Outcome.cont,
                    Source.Outcome.leave] at hHeadMode hEq
                  cases hEq.1
          | halt kind =>
              have hEq := hNonregular (by simp [hHeadMode])
              cases sourceHead with
              | mk sourceHeadState sourceHeadMode =>
                  cases sourceHeadMode <;> simp [Source.Outcome.cont,
                    Source.Outcome.halt] at hHeadMode hEq
                  cases hEq.1
end

mutual
theorem block_targetBreakSuffix_mem_of_brk_run
    {prim : Source.PrimitiveSemantics} {program : Program}
    {live : Ctx} {sourceCtx sourceCtxOut : Source.Ctx}
    {targetCtx : Locals.Ctx}
    {fuel targetDepth : Nat} {block : Block}
    {source sourceOut : Source.State}
    {after : List Name} {name : Name}
    (hTargetHandler :
      SourceDirectBridge.LiveTargetHandlerScopeRel sourceCtx targetCtx)
    (hScoped : Scope.Block.Scoped sourceCtx.scope block)
    (hRun :
      Source.Block.runOpen prim program sourceCtx fuel block source =
        .ok (Source.Outcome.brk sourceOut, sourceCtxOut))
    (hTargetLive :
      ∀ {depth : Nat},
        targetCtx.breakDepth? = some depth →
          ∀ {name : Name},
            name ∈ targetCtx.layout.drop
                (targetCtx.layout.length - depth) →
              name ∈ live.breakLive)
    (hTargetDepth : targetCtx.breakDepth? = some targetDepth)
    (hName :
      name ∈ targetCtx.layout.drop
        (targetCtx.layout.length - targetDepth)) :
    name ∈ Block.liveBefore live after block := by
  cases block with
  | mk stmts =>
      exact
        stmtList_targetBreakSuffix_mem_of_brk_run
          (live := live) (targetCtx := targetCtx) (stmts := stmts)
          hTargetHandler hScoped hRun hTargetLive hTargetDepth hName

theorem stmt_targetBreakSuffix_mem_of_brk_run
    {prim : Source.PrimitiveSemantics} {program : Program}
    {live : Ctx} {sourceCtx sourceCtxOut : Source.Ctx}
    {targetCtx : Locals.Ctx}
    {fuel targetDepth : Nat} {stmt : Stmt}
    {source sourceOut : Source.State}
    {after : List Name} {name : Name}
    (hTargetHandler :
      SourceDirectBridge.LiveTargetHandlerScopeRel sourceCtx targetCtx)
    (hScoped : Scope.Stmt.Scoped sourceCtx.scope stmt)
    (hRun :
      Source.Stmt.run prim program sourceCtx fuel stmt source =
        .ok (Source.Outcome.brk sourceOut, sourceCtxOut))
    (hTargetLive :
      ∀ {depth : Nat},
        targetCtx.breakDepth? = some depth →

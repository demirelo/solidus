              (stmtSourceCtx := stmtSourceCtx) (targetCtx := targetCtx)
              (targetRunCtx := targetRunCtx)
              (hiddenReturns := hiddenReturns) (stmt := stmt)
              (rest := rest)
              (targetStmtBlock :=
                { stmts :=
                    Lower.cleanupToLive targetCtx.layout stmtLive ::
                      (prep ++ lowerStmt) })
              (targetTail := lowerRest) (source := source) (target := target)
              (sourceOutcome :=
                { state := sourceAfter, mode := Locals.Source.Mode.cont })
              (targetOutcome := targetHead) (stmtTargetFuel := targetHeadFuel)
              hSourceHead hSourceCtx hNonregular
              (by simpa [List.append_assoc] using hTargetHeadBlock) hHeadRel
      | leave =>
          have hNonregular :
              ({ state := sourceAfter, mode := Locals.Source.Mode.leave } :
                Source.Outcome).mode ≠ .regular := by
            simp
          have hSourceCtx :=
            Source.Stmt.run_nonregular_ctx hSourceHead hNonregular
          simpa [Lower.cleanupToLive] using
            blockOpen_cons_nonregular_runBridge_of_parts
              (prim := prim) (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
              (stmtSourceCtx := stmtSourceCtx) (targetCtx := targetCtx)
              (targetRunCtx := targetRunCtx)
              (hiddenReturns := hiddenReturns) (stmt := stmt)
              (rest := rest)
              (targetStmtBlock :=
                { stmts :=
                    Lower.cleanupToLive targetCtx.layout stmtLive ::
                      (prep ++ lowerStmt) })
              (targetTail := lowerRest) (source := source) (target := target)
              (sourceOutcome :=
                { state := sourceAfter, mode := Locals.Source.Mode.leave })
              (targetOutcome := targetHead) (stmtTargetFuel := targetHeadFuel)
              hSourceHead hSourceCtx hNonregular
              (by simpa [List.append_assoc] using hTargetHeadBlock) hHeadRel
      | halt kind =>
          have hNonregular :
              (Source.Outcome.halt kind sourceAfter).mode ≠ .regular := by
            simp [Source.Outcome.halt, Locals.Source.Outcome.halt]
          have hSourceCtx :=
            Source.Stmt.run_nonregular_ctx hSourceHead hNonregular
          simpa [Lower.cleanupToLive] using
            blockOpen_cons_nonregular_runBridge_of_parts
              (prim := prim) (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
              (stmtSourceCtx := stmtSourceCtx) (targetCtx := targetCtx)

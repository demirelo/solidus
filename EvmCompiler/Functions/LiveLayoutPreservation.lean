import EvmCompiler.Functions.LiveLayoutBridge
import EvmCompiler.Functions.Preservation

namespace EvmCompiler
namespace Functions
namespace LiveLayout

/-!
Semantic preservation helpers for the cleanup-emitting live-layout lowerer.

The lightweight `LiveLayoutBridge` module owns state-relation facts about
dead-prefix cleanup.  This module imports the heavier direct-preservation
lemmas so those cleanup facts can be composed with target block execution.
-/

namespace TargetLayout

namespace Stmt

def regularOutLayout (layout : List Name) : Locals.Stmt → List Name
  | .let_ name _value => name :: layout
  | .promoteName name =>
      match Locals.Layout.lookupDepth? name layout with
      | none => layout
      | some depth =>
          let idx := depth - 1
          if idx ≤ 16 then Locals.Layout.promoteAt idx layout else layout
  | .cleanupTo targetLayout => targetLayout
  | _ => layout

set_option linter.unusedSimpArgs false in
theorem run_regular_layout {program : Locals.Program}
    {ctx runCtx : Locals.Ctx} {fuel : Nat} {stmt : Locals.Stmt}
    {state final : Locals.RunState}
    (hRun :
      Locals.Direct.Stmt.run program ctx fuel stmt state =
        .ok (Structured.Outcome.regular final, runCtx)) :
    runCtx.layout = regularOutLayout ctx.layout stmt := by
  cases stmt with
  | expr expr =>
      cases hEval : Locals.Direct.Expr.runState ctx expr state with
      | error err =>
          simp [Locals.Direct.Stmt.run, hEval] at hRun
      | ok state' =>
          simp [Locals.Direct.Stmt.run, hEval] at hRun
          rcases hRun with ⟨_hOutcome, hCtxEq⟩
          cases hCtxEq
          rfl
  | exprs exprs =>
      cases hEval :
          Locals.Direct.Expr.ExprSeq.runCode ctx 0 exprs state.evm with
      | error err =>
          simp [Locals.Direct.Stmt.run, hEval] at hRun
      | ok evm =>
          simp [Locals.Direct.Stmt.run, hEval] at hRun
          rcases hRun with ⟨_hOutcome, hCtxEq⟩
          cases hCtxEq
          rfl
  | let_ name value =>
      cases hEval : Locals.Direct.Expr.runState ctx value state with
      | error err =>
          simp [Locals.Direct.Stmt.run, hEval] at hRun
      | ok state' =>
          simp [Locals.Direct.Stmt.run, hEval, Locals.Ctx.withLayout] at hRun
          rcases hRun with ⟨_hOutcome, hCtxEq⟩
          cases hCtxEq
          rfl
  | assign name value =>
      cases hDepth : Locals.Layout.lookupDepth? name ctx.layout with
      | none =>
          simp [Locals.Direct.Stmt.run, hDepth, Locals.invalid,
            Structured.invalid] at hRun
      | some depth =>
          cases hSwap : Locals.StackOp.swap? depth with
          | none =>
              simp [Locals.Direct.Stmt.run, hDepth, hSwap, Locals.invalid,
                Structured.invalid] at hRun
          | some swapOp =>
              cases hValue :
                  Locals.Direct.Expr.runCode ctx 0 value state.evm with
              | error err =>
                  simp [Locals.Direct.Stmt.run, hDepth, hSwap, hValue] at hRun
              | ok evmAfterValue =>
                  cases hSwapStep : swapOp.step evmAfterValue with
                  | error err =>
                      simp [Locals.Direct.Stmt.run, hDepth, hSwap, hValue,
                        hSwapStep] at hRun
                  | ok evmAfterSwap =>
                      cases hPop :
                          Structured.BasicOp.pop.step evmAfterSwap with
                      | error err =>
                          simp [Locals.Direct.Stmt.run, hDepth, hSwap, hValue,
                            hSwapStep, hPop] at hRun
                      | ok evmAfterPop =>
                          simp [Locals.Direct.Stmt.run, hDepth, hSwap, hValue,
                            hSwapStep, hPop] at hRun
                          rcases hRun with ⟨_hOutcome, hCtxEq⟩
                          cases hCtxEq
                          rfl
  | assignTop name =>
      cases hDepth : Locals.Layout.lookupDepth? name ctx.layout with
      | none =>
          simp [Locals.Direct.Stmt.run, hDepth, Locals.invalid,
            Structured.invalid] at hRun
      | some depth =>
          cases hSwap : Locals.StackOp.swap? depth with
          | none =>
              simp [Locals.Direct.Stmt.run, hDepth, hSwap, Locals.invalid,
                Structured.invalid] at hRun
          | some swapOp =>
              cases hSwapStep : swapOp.step state.evm with
              | error err =>
                  simp [Locals.Direct.Stmt.run, hDepth, hSwap, hSwapStep]
                    at hRun
              | ok evmAfterSwap =>
                  cases hPop :
                      Structured.BasicOp.pop.step evmAfterSwap with
                  | error err =>
                      simp [Locals.Direct.Stmt.run, hDepth, hSwap, hSwapStep,
                        hPop] at hRun
                  | ok evmAfterPop =>
                      simp [Locals.Direct.Stmt.run, hDepth, hSwap, hSwapStep,
                        hPop] at hRun
                      rcases hRun with ⟨_hOutcome, hCtxEq⟩
                      cases hCtxEq
                      rfl
    | assignTopWithOffset offset name =>
        cases hDepth : Locals.Layout.lookupDepth? name ctx.layout with
        | none =>
            simp [Locals.Direct.Stmt.run, hDepth, Locals.invalid,
              Structured.invalid] at hRun
        | some depth =>
            cases hSwap : Locals.StackOp.swap? (offset + depth) with
            | none =>
                simp [Locals.Direct.Stmt.run, hDepth, hSwap, Locals.invalid,
                  Structured.invalid] at hRun
            | some swapOp =>
                cases hSwapStep : swapOp.step state.evm with
                | error err =>
                    simp [Locals.Direct.Stmt.run, hDepth, hSwap, hSwapStep]
                      at hRun
                | ok evmAfterSwap =>
                    cases hPop :
                        Structured.BasicOp.pop.step evmAfterSwap with
                    | error err =>
                        simp [Locals.Direct.Stmt.run, hDepth, hSwap, hSwapStep,
                          hPop] at hRun
                    | ok evmAfterPop =>
                        simp [Locals.Direct.Stmt.run, hDepth, hSwap, hSwapStep,
                          hPop] at hRun
                        rcases hRun with ⟨_hOutcome, hCtxEq⟩
                        cases hCtxEq
                        rfl
    | promoteName name =>
        cases hDepth : Locals.Layout.lookupDepth? name ctx.layout with
        | none =>
            simp [Locals.Direct.Stmt.run, hDepth, Locals.invalid,
              Structured.invalid] at hRun
        | some depth =>
            let idx := depth - 1
            by_cases hBound : depth ≤ 17
            · cases hCode : Locals.Ctx.swapRestoreUpTo? idx with
              | none =>
                  simp [Locals.Direct.Stmt.run, hDepth, idx, hBound, hCode,
                    Locals.invalid, Structured.invalid] at hRun
              | some code =>
                  cases hPromote : Structured.Code.run code state.evm with
                  | error err =>
                      simp [Locals.Direct.Stmt.run, hDepth, idx, hBound, hCode,
                        hPromote] at hRun
                  | ok evmAfterPromote =>
                      simp [Locals.Direct.Stmt.run, hDepth, idx, hBound, hCode,
                        hPromote, Locals.Ctx.withLayout, regularOutLayout]
                        at hRun ⊢
                      rcases hRun with ⟨_hOutcome, hCtxEq⟩
                      cases hCtxEq
                      rfl
            · simp [Locals.Direct.Stmt.run, hDepth, idx, hBound, Locals.invalid,
                Structured.invalid] at hRun
    | cleanupTo targetLayout =>
        simp only [Locals.Direct.Stmt.run] at hRun
        by_cases hSuffix :
            targetLayout =
              ctx.layout.drop (ctx.layout.length - targetLayout.length)
        · rw [if_pos hSuffix] at hRun
          cases hCleanup :
              Locals.Direct.Ctx.runCleanupTo ctx targetLayout.length state with
          | error err =>
              simp [hCleanup] at hRun
          | ok stateAfterCleanup =>
              simp [hCleanup, Locals.Ctx.withLayout] at hRun
              rcases hRun with ⟨_hOutcome, hCtxEq⟩
              cases hCtxEq
              rfl
        · rw [if_neg hSuffix] at hRun
          simp [Locals.invalid, Structured.invalid] at hRun
  | block body =>
      cases hBlock :
          Locals.Direct.Block.runScoped program ctx body fuel state with
      | error err =>
          simp [Locals.Direct.Stmt.run, hBlock] at hRun
      | ok outcome =>
          cases outcome with
          | mk blockState mode =>
              cases mode <;> simp [Locals.Direct.Stmt.run, hBlock,
                Structured.Outcome.regular, Structured.Outcome.brk,
                Structured.Outcome.cont, Structured.Outcome.leave,
                Structured.Outcome.halt] at hRun
              case regular =>
                rcases hRun with ⟨_hOutcome, hCtxEq⟩
                cases hCtxEq
                rfl
  | if_ cond body =>
      cases fuel with
      | zero =>
          simp [Locals.Direct.Stmt.run, Locals.invalid,
            Structured.invalid] at hRun
      | succ fuel =>
          cases hCond : Locals.Direct.Expr.runCondition ctx cond state with
          | error err =>
              simp [Locals.Direct.Stmt.run, hCond] at hRun
          | ok condResult =>
              rcases condResult with ⟨stateAfterCond, condTrue⟩
              cases condTrue <;>
                simp [Locals.Direct.Stmt.run, hCond] at hRun
              · rcases hRun with ⟨_hOutcome, hCtxEq⟩
                cases hCtxEq
                rfl
              · cases hBlock :
                    Locals.Direct.Block.runScoped program ctx body fuel
                      stateAfterCond with
                | error err =>
                    simp [hBlock] at hRun
                | ok outcome =>
                    cases outcome with
                    | mk blockState mode =>
                        cases mode <;> simp [hBlock,
                          Structured.Outcome.regular, Structured.Outcome.brk,
                          Structured.Outcome.cont, Structured.Outcome.leave,
                          Structured.Outcome.halt] at hRun
                        case regular =>
                          rcases hRun with ⟨_hOutcome, hCtxEq⟩
                          cases hCtxEq
                          rfl
  | switch scrutinee cases defaultBody =>
      cases fuel with
      | zero =>
          simp [Locals.Direct.Stmt.run, Locals.invalid,
            Structured.invalid] at hRun
      | succ fuel =>
          cases hScrutinee :
              Locals.Direct.Expr.runState ctx scrutinee state with
          | error err =>
              simp [Locals.Direct.Stmt.run, hScrutinee] at hRun
          | ok stateAfterScrutinee =>
              cases hPop : stateAfterScrutinee.evm.stack.pop with
              | none =>
                  simp [Locals.Direct.Stmt.run, hScrutinee, hPop] at hRun
              | some popResult =>
                  rcases popResult with ⟨stack, value⟩
                  let stateAfterPop :=
                    stateAfterScrutinee.withEVM
                      { stateAfterScrutinee.evm with stack := stack }
                  cases hSelect :
                      Locals.Direct.Switch.select value cases defaultBody with
                  | none =>
                      simp [Locals.Direct.Stmt.run, hScrutinee, hPop,
                        hSelect, stateAfterPop] at hRun
                      rcases hRun with ⟨_hOutcome, hCtxEq⟩
                      cases hCtxEq
                      rfl
                  | some body =>
                      cases hBlock :
                          Locals.Direct.Block.runScoped program ctx body fuel
                            stateAfterPop with
                      | error err =>
                          simp [Locals.Direct.Stmt.run, hScrutinee, hPop,
                            hSelect, stateAfterPop, hBlock] at hRun
                      | ok outcome =>
                          cases outcome with
                          | mk blockState mode =>
                              cases mode <;> simp [Locals.Direct.Stmt.run,
                                hScrutinee, hPop, hSelect, stateAfterPop,
                                hBlock, Structured.Outcome.regular,
                                Structured.Outcome.brk,
                                Structured.Outcome.cont,
                                Structured.Outcome.leave,
                                Structured.Outcome.halt] at hRun
                              case regular =>
                                rcases hRun with ⟨_hOutcome, hCtxEq⟩
                                cases hCtxEq
                                rfl
  | for_ init cond post body =>
      cases fuel with
      | zero =>
          simp [Locals.Direct.Stmt.run, Locals.invalid,
            Structured.invalid] at hRun
      | succ fuel =>
          cases hInit :
              Locals.Direct.Block.runOpen program ctx.withoutLoopControl fuel
                init state with
          | error err =>
              simp [Locals.Direct.Stmt.run, hInit] at hRun
          | ok initResult =>
              rcases initResult with ⟨initOutcome, initCtx⟩
              cases initOutcome with
              | mk initState initMode =>
                  cases initMode <;> simp [Locals.Direct.Stmt.run, hInit,
                    Structured.Outcome.regular, Structured.Outcome.brk,
                    Structured.Outcome.cont, Structured.Outcome.leave,
                    Structured.Outcome.halt, Locals.invalid,
                    Structured.invalid] at hRun
                  case regular =>
                    cases hLoop :
                        Locals.Direct.Stmt.runForLoop program initCtx cond
                          initCtx.withoutLoopControl post
                          (initCtx.withLoopControl initCtx.layout.length) body
                          fuel initState with
                    | error err =>
                        simp [hLoop] at hRun
                    | ok loopOutcome =>
                        cases loopOutcome with
                        | mk loopState loopMode =>
                            cases loopMode <;> simp [hLoop,
                              Structured.Outcome.regular,
                              Structured.Outcome.brk, Structured.Outcome.cont,
                              Structured.Outcome.leave, Structured.Outcome.halt,
                              Locals.invalid, Structured.invalid] at hRun
                            case regular =>
                              cases hCleanup :
                                  Locals.Direct.Ctx.runCleanupTo initCtx
                                    ctx.layout.length loopState with
                              | error err =>
                                  simp [hCleanup] at hRun
                              | ok state' =>
                                  simp [hCleanup] at hRun
                                  rcases hRun with ⟨_hOutcome, hCtxEq⟩
                                  cases hCtxEq
                                  rfl
  | brk =>
      cases hBreak : ctx.breakDepth? with
      | none =>
          simp [Locals.Direct.Stmt.run, hBreak, Locals.invalid,
            Structured.invalid] at hRun
      | some target =>
          cases hCleanup :
              Locals.Direct.Ctx.runCleanupTo ctx target state with
          | error err =>
              simp [Locals.Direct.Stmt.run, hBreak, hCleanup] at hRun
          | ok state' =>
              simp [Locals.Direct.Stmt.run, hBreak, hCleanup,
                Structured.Outcome.brk] at hRun
              exact False.elim (by
                rcases hRun with ⟨hOutcome, _hCtx⟩
                cases hOutcome)
  | cont =>
      cases hContinue : ctx.continueDepth? with
      | none =>
          simp [Locals.Direct.Stmt.run, hContinue, Locals.invalid,
            Structured.invalid] at hRun
      | some target =>
          cases hCleanup :
              Locals.Direct.Ctx.runCleanupTo ctx target state with
          | error err =>
              simp [Locals.Direct.Stmt.run, hContinue, hCleanup] at hRun
          | ok state' =>
              simp [Locals.Direct.Stmt.run, hContinue, hCleanup,
                Structured.Outcome.cont] at hRun
              exact False.elim (by
                rcases hRun with ⟨hOutcome, _hCtx⟩
                cases hOutcome)
  | leave =>
      cases hLeave : ctx.leaveDepth? with
      | none =>
          simp [Locals.Direct.Stmt.run, hLeave, Locals.invalid,
            Structured.invalid] at hRun
      | some target =>
          cases hCleanup :
              Locals.Direct.Ctx.runCleanupToPreserving ctx ctx.leaveRetc target
                state with
          | error err =>
              simp [Locals.Direct.Stmt.run, hLeave, hCleanup] at hRun
          | ok state' =>
              cases hReturns : state'.returns with
              | nil =>
                  simp [Locals.Direct.Stmt.run, hLeave, hCleanup, hReturns,
                    Locals.invalid, Structured.invalid] at hRun
              | cons head tail =>
                  simp [Locals.Direct.Stmt.run, hLeave, hCleanup, hReturns,
                    Structured.Outcome.leave] at hRun
                  exact False.elim (by
                    rcases hRun with ⟨hOutcome, _hCtx⟩
                    cases hOutcome)
  | call name =>
      cases fuel with
      | zero =>
          simp [Locals.Direct.Stmt.run, Locals.invalid,
            Structured.invalid] at hRun
      | succ fuel =>
          cases hLookup :
              Locals.Direct.ProcList.lookup? name program.procs with
          | none =>
              simp [Locals.Direct.Stmt.run, hLookup, Locals.invalid,
                Structured.invalid] at hRun
          | some proc =>
              cases hSplit :
                  Structured.StackFrame.splitArgs? proc.argc state.evm.stack
                  with
              | none =>
                  simp [Locals.Direct.Stmt.run, hLookup, hSplit] at hRun
              | some splitResult =>
                  rcases splitResult with ⟨args, callerStack⟩
                  let callEVM := { state.evm with stack := args }
                  let callState :=
                    (state.withEVM callEVM).pushReturn callerStack proc.retc
                  cases hBody :
                      Locals.Direct.Block.runOpen program
                        (Locals.Ctx.procEntryWithLayoutAndRetc
                          proc.entryLayout proc.retc) fuel proc.body callState
                      with
                  | error err =>
                      simp [Locals.Direct.Stmt.run, hLookup, hSplit, callEVM,
                        callState, hBody] at hRun
                  | ok bodyResult =>
                      rcases bodyResult with ⟨outcome, bodyCtx⟩
                      cases outcome with
                      | mk outcomeState mode =>
                          cases mode <;> simp [Locals.Direct.Stmt.run,
                            hLookup, hSplit, callEVM, callState, hBody,
                            Structured.Outcome.regular, Structured.Outcome.brk,
                            Structured.Outcome.cont, Structured.Outcome.leave,
                            Structured.Outcome.halt, Locals.invalid,
                            Structured.invalid] at hRun
                          case regular =>
                            cases hCleanup :
                                Locals.Direct.Ctx.runCleanupToPreserving bodyCtx
                                  proc.retc 0 outcomeState with
                            | error err =>
                                simp [hCleanup] at hRun
                            | ok bodyState =>
                                cases hPop : bodyState.popReturn? with
                                | none =>
                                    simp [hCleanup, hPop, Locals.invalid,
                                      Structured.invalid] at hRun
                                | some popResult =>
                                    rcases popResult with ⟨frame, returned⟩
                                    cases hAttach :
                                        Structured.StackFrame.attachReturns?
                                          frame bodyState.evm.stack with
                                    | none =>
                                        simp [hCleanup, hPop, hAttach,
                                          Locals.invalid, Structured.invalid]
                                          at hRun
                                    | some stack =>
                                        simp [hCleanup, hPop, hAttach] at hRun
                                        rcases hRun with ⟨_hOutcome, hCtxEq⟩
                                        cases hCtxEq
                                        rfl
                          case leave =>
                            cases hPop : outcomeState.popReturn? with
                            | none =>
                                simp [hPop, Locals.invalid,
                                  Structured.invalid] at hRun
                            | some popResult =>
                                rcases popResult with ⟨frame, returned⟩
                                cases hAttach :
                                    Structured.StackFrame.attachReturns? frame
                                      outcomeState.evm.stack with
                                | none =>
                                    simp [hPop, hAttach, Locals.invalid,
                                      Structured.invalid] at hRun
                                | some stack =>
                                    simp [hPop, hAttach] at hRun
                                    rcases hRun with ⟨_hOutcome, hCtxEq⟩
                                    cases hCtxEq
                                    rfl
  | terminal kind =>
      cases hCleanup : Locals.Direct.Ctx.runCleanupAll ctx state with
      | error err =>
          simp [Locals.Direct.Stmt.run, hCleanup] at hRun
      | ok stateAfterCleanup =>
          cases hTerminal :
              Structured.Terminal.step kind stateAfterCleanup.evm with
          | error err =>
              simp [Locals.Direct.Stmt.run, hCleanup, hTerminal] at hRun
          | ok evm =>
              simp [Locals.Direct.Stmt.run, hCleanup, hTerminal,
                Structured.Outcome.halt] at hRun
              exact False.elim (by
                rcases hRun with ⟨hOutcome, _hCtx⟩
                cases hOutcome)
  | terminalArgs kind args =>
      cases hArgs :
          Locals.Direct.Expr.ExprSeq.runCode ctx 0 args state.evm with
      | error err =>
          simp [Locals.Direct.Stmt.run, hArgs] at hRun
      | ok evmAfterArgs =>
          cases hTerminal : Structured.Terminal.step kind evmAfterArgs with
          | error err =>
              simp [Locals.Direct.Stmt.run, hArgs, hTerminal] at hRun
              | ok evm =>
                  simp [Locals.Direct.Stmt.run, hArgs, hTerminal,
                    Structured.Outcome.halt] at hRun
                  exact False.elim (by
                    rcases hRun with ⟨hOutcome, _hCtx⟩
                    cases hOutcome)

set_option linter.unusedSimpArgs false in
theorem run_regular_ctx {program : Locals.Program}
    {ctx runCtx : Locals.Ctx} {fuel : Nat} {stmt : Locals.Stmt}
    {state final : Locals.RunState}
    (hRun :
      Locals.Direct.Stmt.run program ctx fuel stmt state =
        .ok (Structured.Outcome.regular final, runCtx)) :
    runCtx = ctx.withLayout (regularOutLayout ctx.layout stmt) := by
  cases stmt with
  | expr expr =>
      cases hEval : Locals.Direct.Expr.runState ctx expr state with
      | error err =>
          simp [Locals.Direct.Stmt.run, hEval] at hRun
      | ok state' =>
          simp [Locals.Direct.Stmt.run, hEval, Locals.Ctx.withLayout,
            regularOutLayout] at hRun
          rcases hRun with ⟨_hOutcome, hCtxEq⟩
          cases hCtxEq
          cases ctx
          rfl
  | exprs exprs =>
      cases hEval :
          Locals.Direct.Expr.ExprSeq.runCode ctx 0 exprs state.evm with
      | error err =>
          simp [Locals.Direct.Stmt.run, hEval] at hRun
      | ok evm =>
          simp [Locals.Direct.Stmt.run, hEval, Locals.Ctx.withLayout,
            regularOutLayout] at hRun
          rcases hRun with ⟨_hOutcome, hCtxEq⟩
          cases hCtxEq
          cases ctx
          rfl
  | let_ name value =>
      cases hEval : Locals.Direct.Expr.runState ctx value state with
      | error err =>
          simp [Locals.Direct.Stmt.run, hEval] at hRun
      | ok state' =>
          simp [Locals.Direct.Stmt.run, hEval, Locals.Ctx.withLayout,
            regularOutLayout] at hRun
          rcases hRun with ⟨_hOutcome, hCtxEq⟩
          exact hCtxEq.symm
  | assign name value =>
      cases hDepth : Locals.Layout.lookupDepth? name ctx.layout with
      | none =>
          simp [Locals.Direct.Stmt.run, hDepth, Locals.invalid,
            Structured.invalid] at hRun
      | some depth =>
          cases hSwap : Locals.StackOp.swap? depth with
          | none =>
              simp [Locals.Direct.Stmt.run, hDepth, hSwap, Locals.invalid,
                Structured.invalid] at hRun
          | some swapOp =>
              cases hValue :
                  Locals.Direct.Expr.runCode ctx 0 value state.evm with
              | error err =>
                  simp [Locals.Direct.Stmt.run, hDepth, hSwap, hValue] at hRun
              | ok evmAfterValue =>
                  cases hSwapStep : swapOp.step evmAfterValue with
                  | error err =>
                      simp [Locals.Direct.Stmt.run, hDepth, hSwap, hValue,
                        hSwapStep] at hRun
                  | ok evmAfterSwap =>
                      cases hPop :
                          Structured.BasicOp.pop.step evmAfterSwap with
                      | error err =>
                          simp [Locals.Direct.Stmt.run, hDepth, hSwap, hValue,
                            hSwapStep, hPop] at hRun
                      | ok evmAfterPop =>
                          simp [Locals.Direct.Stmt.run, hDepth, hSwap, hValue,
                            hSwapStep, hPop, Locals.Ctx.withLayout,
                            regularOutLayout] at hRun
                          rcases hRun with ⟨_hOutcome, hCtxEq⟩
                          cases hCtxEq
                          cases ctx
                          rfl
  | assignTop name =>
      cases hDepth : Locals.Layout.lookupDepth? name ctx.layout with
      | none =>
          simp [Locals.Direct.Stmt.run, hDepth, Locals.invalid,
            Structured.invalid] at hRun
      | some depth =>
          cases hSwap : Locals.StackOp.swap? depth with
          | none =>
              simp [Locals.Direct.Stmt.run, hDepth, hSwap, Locals.invalid,
                Structured.invalid] at hRun
          | some swapOp =>
              cases hSwapStep : swapOp.step state.evm with
              | error err =>
                  simp [Locals.Direct.Stmt.run, hDepth, hSwap, hSwapStep]
                    at hRun
              | ok evmAfterSwap =>
                  cases hPop :
                      Structured.BasicOp.pop.step evmAfterSwap with
                  | error err =>
                      simp [Locals.Direct.Stmt.run, hDepth, hSwap, hSwapStep,
                        hPop] at hRun
                  | ok evmAfterPop =>
                      simp [Locals.Direct.Stmt.run, hDepth, hSwap, hSwapStep,
                        hPop, Locals.Ctx.withLayout, regularOutLayout] at hRun
                      rcases hRun with ⟨_hOutcome, hCtxEq⟩
                      cases hCtxEq
                      cases ctx
                      rfl
  | assignTopWithOffset offset name =>
      cases hDepth : Locals.Layout.lookupDepth? name ctx.layout with
      | none =>
          simp [Locals.Direct.Stmt.run, hDepth, Locals.invalid,
            Structured.invalid] at hRun
      | some depth =>
          cases hSwap : Locals.StackOp.swap? (offset + depth) with
          | none =>
              simp [Locals.Direct.Stmt.run, hDepth, hSwap, Locals.invalid,
                Structured.invalid] at hRun
          | some swapOp =>
              cases hSwapStep : swapOp.step state.evm with
              | error err =>
                  simp [Locals.Direct.Stmt.run, hDepth, hSwap, hSwapStep]
                    at hRun
              | ok evmAfterSwap =>
                  cases hPop :
                      Structured.BasicOp.pop.step evmAfterSwap with
                  | error err =>
                      simp [Locals.Direct.Stmt.run, hDepth, hSwap, hSwapStep,
                        hPop] at hRun
                  | ok evmAfterPop =>
                      simp [Locals.Direct.Stmt.run, hDepth, hSwap, hSwapStep,
                        hPop, Locals.Ctx.withLayout, regularOutLayout] at hRun
                      rcases hRun with ⟨_hOutcome, hCtxEq⟩
                      cases hCtxEq
                      cases ctx
                      rfl
  | promoteName name =>
      cases hDepth : Locals.Layout.lookupDepth? name ctx.layout with
      | none =>
          simp [Locals.Direct.Stmt.run, hDepth, Locals.invalid,
            Structured.invalid] at hRun
      | some depth =>
          let idx := depth - 1
          by_cases hBound : depth ≤ 17
          · cases hCode : Locals.Ctx.swapRestoreUpTo? idx with
            | none =>
                simp [Locals.Direct.Stmt.run, hDepth, idx, hBound, hCode,
                  Locals.invalid, Structured.invalid] at hRun
            | some code =>
                cases hPromote : Structured.Code.run code state.evm with
                | error err =>
                    simp [Locals.Direct.Stmt.run, hDepth, idx, hBound, hCode,
                      hPromote] at hRun
                | ok evmAfterPromote =>
                    have hIdxBound : depth - 1 ≤ 16 := by omega
                    have hOutLayout :
                        regularOutLayout ctx.layout
                            (Locals.Stmt.promoteName name) =
                          Locals.Layout.promoteAt (depth - 1) ctx.layout := by
                      simp [regularOutLayout, hDepth, idx, hIdxBound]
                    simp [Locals.Direct.Stmt.run, hDepth, idx, hBound, hCode,
                      hPromote, Locals.Ctx.withLayout, regularOutLayout,
                      hIdxBound]
                      at hRun
                    rcases hRun with ⟨_hOutcome, hCtxEq⟩
                    simpa [Locals.Ctx.withLayout, hOutLayout] using hCtxEq.symm
          · simp [Locals.Direct.Stmt.run, hDepth, idx, hBound, Locals.invalid,
              Structured.invalid] at hRun
  | cleanupTo targetLayout =>
      simp only [Locals.Direct.Stmt.run] at hRun
      by_cases hSuffix :
          targetLayout =
            ctx.layout.drop (ctx.layout.length - targetLayout.length)
      · rw [if_pos hSuffix] at hRun
        cases hCleanup :
            Locals.Direct.Ctx.runCleanupTo ctx targetLayout.length state with
        | error err =>
            simp [hCleanup] at hRun
        | ok stateAfterCleanup =>
            simp [hCleanup, Locals.Ctx.withLayout, regularOutLayout] at hRun
            rcases hRun with ⟨_hOutcome, hCtxEq⟩
            exact hCtxEq.symm
      · rw [if_neg hSuffix] at hRun
        simp [Locals.invalid, Structured.invalid] at hRun
  | block body =>
      cases hBlock :
          Locals.Direct.Block.runScoped program ctx body fuel state with
      | error err =>
          simp [Locals.Direct.Stmt.run, hBlock] at hRun
      | ok outcome =>
          cases outcome with
          | mk blockState mode =>
              cases mode <;> simp [Locals.Direct.Stmt.run, hBlock,
                Structured.Outcome.regular, Structured.Outcome.brk,
                Structured.Outcome.cont, Structured.Outcome.leave,
                Structured.Outcome.halt, Locals.Ctx.withLayout,
                regularOutLayout] at hRun
              case regular =>
                rcases hRun with ⟨_hOutcome, hCtxEq⟩
                cases hCtxEq
                cases ctx
                rfl
  | if_ cond body =>
      cases fuel with
      | zero =>
          simp [Locals.Direct.Stmt.run, Locals.invalid,
            Structured.invalid] at hRun
      | succ fuel =>
          cases hCond : Locals.Direct.Expr.runCondition ctx cond state with
          | error err =>
              simp [Locals.Direct.Stmt.run, hCond] at hRun
          | ok condResult =>
              rcases condResult with ⟨stateAfterCond, condTrue⟩
              cases condTrue <;>
                simp [Locals.Direct.Stmt.run, hCond, Locals.Ctx.withLayout,
                  regularOutLayout] at hRun
              · rcases hRun with ⟨_hOutcome, hCtxEq⟩
                cases hCtxEq
                cases ctx
                rfl
              · cases hBlock :
                    Locals.Direct.Block.runScoped program ctx body fuel
                      stateAfterCond with
                | error err =>
                    simp [hBlock] at hRun
                | ok outcome =>
                    cases outcome with
                    | mk blockState mode =>
                        cases mode <;> simp [hBlock,
                          Structured.Outcome.regular, Structured.Outcome.brk,
                          Structured.Outcome.cont, Structured.Outcome.leave,
                          Structured.Outcome.halt, Locals.Ctx.withLayout,
                          regularOutLayout] at hRun
                        case regular =>
                          rcases hRun with ⟨_hOutcome, hCtxEq⟩
                          cases hCtxEq
                          cases ctx
                          rfl
  | switch scrutinee cases defaultBody =>
      cases fuel with
      | zero =>
          simp [Locals.Direct.Stmt.run, Locals.invalid,
            Structured.invalid] at hRun
      | succ fuel =>
          cases hScrutinee :
              Locals.Direct.Expr.runState ctx scrutinee state with
          | error err =>
              simp [Locals.Direct.Stmt.run, hScrutinee] at hRun
          | ok stateAfterScrutinee =>
              cases hPop : stateAfterScrutinee.evm.stack.pop with
              | none =>
                  simp [Locals.Direct.Stmt.run, hScrutinee, hPop] at hRun
              | some popResult =>
                  rcases popResult with ⟨stack, value⟩
                  let stateAfterPop :=
                    stateAfterScrutinee.withEVM
                      { stateAfterScrutinee.evm with stack := stack }
                  cases hSelect :
                      Locals.Direct.Switch.select value cases defaultBody with
                  | none =>
                      simp [Locals.Direct.Stmt.run, hScrutinee, hPop,
                        hSelect, stateAfterPop, Locals.Ctx.withLayout,
                        regularOutLayout] at hRun
                      rcases hRun with ⟨_hOutcome, hCtxEq⟩
                      cases hCtxEq
                      cases ctx
                      rfl
                  | some body =>
                      cases hBlock :
                          Locals.Direct.Block.runScoped program ctx body fuel
                            stateAfterPop with
                      | error err =>
                          simp [Locals.Direct.Stmt.run, hScrutinee, hPop,
                            hSelect, stateAfterPop, hBlock] at hRun
                      | ok outcome =>
                          cases outcome with
                          | mk blockState mode =>
                              cases mode <;> simp [Locals.Direct.Stmt.run,
                                hScrutinee, hPop, hSelect, stateAfterPop,
                                hBlock, Structured.Outcome.regular,
                                Structured.Outcome.brk,
                                Structured.Outcome.cont,
                                Structured.Outcome.leave,
                                Structured.Outcome.halt,
                                Locals.Ctx.withLayout, regularOutLayout]
                                at hRun
                              case regular =>
                                rcases hRun with ⟨_hOutcome, hCtxEq⟩
                                cases hCtxEq
                                cases ctx
                                rfl
  | for_ init cond post body =>
      cases fuel with
      | zero =>
          simp [Locals.Direct.Stmt.run, Locals.invalid,
            Structured.invalid] at hRun
      | succ fuel =>
          cases hInit :
              Locals.Direct.Block.runOpen program ctx.withoutLoopControl fuel
                init state with
          | error err =>
              simp [Locals.Direct.Stmt.run, hInit] at hRun
          | ok initResult =>
              rcases initResult with ⟨initOutcome, initCtx⟩
              cases initOutcome with
              | mk initState initMode =>
                  cases initMode <;> simp [Locals.Direct.Stmt.run, hInit,
                    Structured.Outcome.regular, Structured.Outcome.brk,
                    Structured.Outcome.cont, Structured.Outcome.leave,
                    Structured.Outcome.halt, Locals.invalid,
                    Structured.invalid, Locals.Ctx.withLayout,
                    regularOutLayout] at hRun
                  case regular =>
                    cases hLoop :
                        Locals.Direct.Stmt.runForLoop program initCtx cond
                          initCtx.withoutLoopControl post
                          (initCtx.withLoopControl initCtx.layout.length) body
                          fuel initState with
                    | error err =>
                        simp [hLoop] at hRun
                    | ok loopOutcome =>
                        cases loopOutcome with
                        | mk loopState loopMode =>
                            cases loopMode <;> simp [hLoop,
                              Structured.Outcome.regular,
                              Structured.Outcome.brk, Structured.Outcome.cont,
                              Structured.Outcome.leave, Structured.Outcome.halt,
                              Locals.invalid, Structured.invalid,
                              Locals.Ctx.withLayout, regularOutLayout] at hRun
                            case regular =>
                              cases hCleanup :
                                  Locals.Direct.Ctx.runCleanupTo initCtx
                                    ctx.layout.length loopState with
                              | error err =>
                                  simp [hCleanup] at hRun
                              | ok state' =>
                                  simp [hCleanup, Locals.Ctx.withLayout,
                                    regularOutLayout] at hRun
                                  rcases hRun with ⟨_hOutcome, hCtxEq⟩
                                  cases hCtxEq
                                  cases ctx
                                  rfl
  | brk =>
      cases hBreak : ctx.breakDepth? with
      | none =>
          simp [Locals.Direct.Stmt.run, hBreak, Locals.invalid,
            Structured.invalid] at hRun
      | some target =>
          cases hCleanup :
              Locals.Direct.Ctx.runCleanupTo ctx target state with
          | error err =>
              simp [Locals.Direct.Stmt.run, hBreak, hCleanup] at hRun
          | ok state' =>
              simp [Locals.Direct.Stmt.run, hBreak, hCleanup,
                Structured.Outcome.brk] at hRun
              exact False.elim (by
                rcases hRun with ⟨hOutcome, _hCtx⟩
                cases hOutcome)
  | cont =>
      cases hContinue : ctx.continueDepth? with
      | none =>
          simp [Locals.Direct.Stmt.run, hContinue, Locals.invalid,
            Structured.invalid] at hRun
      | some target =>
          cases hCleanup :
              Locals.Direct.Ctx.runCleanupTo ctx target state with
          | error err =>
              simp [Locals.Direct.Stmt.run, hContinue, hCleanup] at hRun
          | ok state' =>
              simp [Locals.Direct.Stmt.run, hContinue, hCleanup,
                Structured.Outcome.cont] at hRun
              exact False.elim (by
                rcases hRun with ⟨hOutcome, _hCtx⟩
                cases hOutcome)
  | leave =>
      cases hLeave : ctx.leaveDepth? with
      | none =>
          simp [Locals.Direct.Stmt.run, hLeave, Locals.invalid,
            Structured.invalid] at hRun
      | some target =>
          cases hCleanup :
              Locals.Direct.Ctx.runCleanupToPreserving ctx ctx.leaveRetc target
                state with
          | error err =>
              simp [Locals.Direct.Stmt.run, hLeave, hCleanup] at hRun
          | ok state' =>
              cases hReturns : state'.returns with
              | nil =>
                  simp [Locals.Direct.Stmt.run, hLeave, hCleanup, hReturns,
                    Locals.invalid, Structured.invalid] at hRun
              | cons head tail =>
                  simp [Locals.Direct.Stmt.run, hLeave, hCleanup, hReturns,
                    Structured.Outcome.leave] at hRun
                  exact False.elim (by
                    rcases hRun with ⟨hOutcome, _hCtx⟩
                    cases hOutcome)
  | call name =>
      cases fuel with
      | zero =>
          simp [Locals.Direct.Stmt.run, Locals.invalid,
            Structured.invalid] at hRun
      | succ fuel =>
          cases hLookup :
              Locals.Direct.ProcList.lookup? name program.procs with
          | none =>
              simp [Locals.Direct.Stmt.run, hLookup, Locals.invalid,
                Structured.invalid] at hRun
          | some proc =>
              cases hSplit :
                  Structured.StackFrame.splitArgs? proc.argc state.evm.stack
                  with
              | none =>
                  simp [Locals.Direct.Stmt.run, hLookup, hSplit] at hRun
              | some splitResult =>
                  rcases splitResult with ⟨args, callerStack⟩
                  let callEVM := { state.evm with stack := args }
                  let callState :=
                    (state.withEVM callEVM).pushReturn callerStack proc.retc
                  cases hBody :
                      Locals.Direct.Block.runOpen program
                        (Locals.Ctx.procEntryWithLayoutAndRetc
                          proc.entryLayout proc.retc) fuel proc.body callState
                      with
                  | error err =>
                      simp [Locals.Direct.Stmt.run, hLookup, hSplit, callEVM,
                        callState, hBody] at hRun
                  | ok bodyResult =>
                      rcases bodyResult with ⟨outcome, bodyCtx⟩
                      cases outcome with
                      | mk outcomeState mode =>
                          cases mode <;> simp [Locals.Direct.Stmt.run,
                            hLookup, hSplit, callEVM, callState, hBody,
                            Structured.Outcome.regular, Structured.Outcome.brk,
                            Structured.Outcome.cont, Structured.Outcome.leave,
                            Structured.Outcome.halt, Locals.invalid,
                            Structured.invalid, Locals.Ctx.withLayout,
                            regularOutLayout] at hRun
                          case regular =>
                            cases hCleanup :
                                Locals.Direct.Ctx.runCleanupToPreserving bodyCtx
                                  proc.retc 0 outcomeState with
                            | error err =>
                                simp [hCleanup] at hRun
                            | ok bodyState =>
                                cases hPop : bodyState.popReturn? with
                                | none =>
                                    simp [hCleanup, hPop, Locals.invalid,
                                      Structured.invalid] at hRun
                                | some popResult =>
                                    rcases popResult with ⟨frame, returned⟩
                                    cases hAttach :
                                        Structured.StackFrame.attachReturns?
                                          frame bodyState.evm.stack with
                                    | none =>
                                        simp [hCleanup, hPop, hAttach,
                                          Locals.invalid, Structured.invalid]
                                          at hRun
                                    | some stack =>
                                        simp [hCleanup, hPop, hAttach] at hRun
                                        rcases hRun with ⟨_hOutcome, hCtxEq⟩
                                        cases hCtxEq
                                        cases ctx
                                        rfl
                          case leave =>
                            cases hPop : outcomeState.popReturn? with
                            | none =>
                                simp [hPop, Locals.invalid,
                                  Structured.invalid] at hRun
                            | some popResult =>
                                rcases popResult with ⟨frame, returned⟩
                                cases hAttach :
                                    Structured.StackFrame.attachReturns? frame
                                      outcomeState.evm.stack with
                                | none =>
                                    simp [hPop, hAttach, Locals.invalid,
                                      Structured.invalid] at hRun
                                | some stack =>
                                    simp [hPop, hAttach] at hRun
                                    rcases hRun with ⟨_hOutcome, hCtxEq⟩
                                    cases hCtxEq
                                    cases ctx
                                    rfl
  | terminal kind =>
      cases hCleanup : Locals.Direct.Ctx.runCleanupAll ctx state with
      | error err =>
          simp [Locals.Direct.Stmt.run, hCleanup] at hRun
      | ok stateAfterCleanup =>
          cases hTerminal :
              Structured.Terminal.step kind stateAfterCleanup.evm with
          | error err =>
              simp [Locals.Direct.Stmt.run, hCleanup, hTerminal] at hRun
          | ok evm =>
              simp [Locals.Direct.Stmt.run, hCleanup, hTerminal,
                Structured.Outcome.halt] at hRun
              exact False.elim (by
                rcases hRun with ⟨hOutcome, _hCtx⟩
                cases hOutcome)
  | terminalArgs kind args =>
      cases hArgs :
          Locals.Direct.Expr.ExprSeq.runCode ctx 0 args state.evm with
      | error err =>
          simp [Locals.Direct.Stmt.run, hArgs] at hRun
      | ok evmAfterArgs =>
          cases hTerminal : Structured.Terminal.step kind evmAfterArgs with
          | error err =>
              simp [Locals.Direct.Stmt.run, hArgs, hTerminal] at hRun
          | ok evm =>
              simp [Locals.Direct.Stmt.run, hArgs, hTerminal,
                Structured.Outcome.halt] at hRun
              exact False.elim (by
                rcases hRun with ⟨hOutcome, _hCtx⟩
                cases hOutcome)

end Stmt

namespace StmtList

def regularOutLayout : List Name → List Locals.Stmt → List Name
  | layout, [] => layout
  | layout, stmt :: rest =>
      regularOutLayout (Stmt.regularOutLayout layout stmt) rest

theorem regularOutLayout_append (layout : List Name)
    (left right : List Locals.Stmt) :
    regularOutLayout layout (left ++ right) =
      regularOutLayout (regularOutLayout layout left) right := by
  induction left generalizing layout with
  | nil =>
      simp [regularOutLayout]
  | cons stmt rest ih =>
      simp [regularOutLayout, ih]

set_option linter.unusedSimpArgs false in
theorem runOpen_regular_layout {program : Locals.Program}
    {ctx runCtx : Locals.Ctx} {fuel : Nat} {stmts : List Locals.Stmt}
    {state final : Locals.RunState}
    (hRun :
      Locals.Direct.Block.runOpen program ctx fuel { stmts := stmts } state =
        .ok (Structured.Outcome.regular final, runCtx)) :
    runCtx.layout = regularOutLayout ctx.layout stmts := by
  induction stmts generalizing ctx runCtx fuel state final with
  | nil =>
      cases fuel with
      | zero =>
          simp [Locals.Direct.Block.runOpen, Locals.invalid,
            Structured.invalid] at hRun
      | succ fuel =>
          simp [Locals.Direct.Block.runOpen, regularOutLayout] at hRun
          rcases hRun with ⟨_hOutcome, hCtxEq⟩
          cases hCtxEq
          rfl
  | cons stmt rest ih =>
      cases fuel with
      | zero =>
          simp [Locals.Direct.Block.runOpen, Locals.invalid,
            Structured.invalid] at hRun
      | succ fuel =>
          cases hStmt :
              Locals.Direct.Stmt.run program ctx fuel stmt state with
          | error err =>
              simp [Locals.Direct.Block.runOpen, hStmt] at hRun
          | ok stmtResult =>
              rcases stmtResult with ⟨outcome, stmtCtx⟩
              cases outcome with
              | mk stmtState mode =>
                  cases mode <;> simp [Locals.Direct.Block.runOpen, hStmt,
                    Structured.Outcome.regular, Structured.Outcome.brk,
                    Structured.Outcome.cont, Structured.Outcome.leave,
                    Structured.Outcome.halt, regularOutLayout] at hRun
                  case regular =>
                    have hHeadLayout :
                        stmtCtx.layout =
                          Stmt.regularOutLayout ctx.layout stmt :=
                      Stmt.run_regular_layout hStmt
                    have hTailLayout :
                        runCtx.layout =
                          regularOutLayout stmtCtx.layout rest :=
                      ih hRun
                    simpa [regularOutLayout, hHeadLayout] using hTailLayout

set_option linter.unusedSimpArgs false in
theorem runOpen_regular_ctx {program : Locals.Program}
    {ctx runCtx : Locals.Ctx} {fuel : Nat} {stmts : List Locals.Stmt}
    {state final : Locals.RunState}
    (hRun :
      Locals.Direct.Block.runOpen program ctx fuel { stmts := stmts } state =
        .ok (Structured.Outcome.regular final, runCtx)) :
    runCtx = ctx.withLayout (regularOutLayout ctx.layout stmts) := by
  induction stmts generalizing ctx runCtx fuel state final with
  | nil =>
      cases fuel with
      | zero =>
          simp [Locals.Direct.Block.runOpen, Locals.invalid,
            Structured.invalid] at hRun
      | succ fuel =>
          simp [Locals.Direct.Block.runOpen, regularOutLayout,
            Locals.Ctx.withLayout] at hRun
          rcases hRun with ⟨_hOutcome, hCtxEq⟩
          cases hCtxEq
          cases ctx
          rfl
  | cons stmt rest ih =>
      cases fuel with
      | zero =>
          simp [Locals.Direct.Block.runOpen, Locals.invalid,
            Structured.invalid] at hRun
      | succ fuel =>
          cases hStmt :
              Locals.Direct.Stmt.run program ctx fuel stmt state with
          | error err =>
              simp [Locals.Direct.Block.runOpen, hStmt] at hRun
          | ok stmtResult =>
              rcases stmtResult with ⟨outcome, stmtCtx⟩
              cases outcome with
              | mk stmtState mode =>
                  cases mode <;> simp [Locals.Direct.Block.runOpen, hStmt,
                    Structured.Outcome.regular, Structured.Outcome.brk,
                    Structured.Outcome.cont, Structured.Outcome.leave,
                    Structured.Outcome.halt, regularOutLayout] at hRun
                  case regular =>
                    have hHeadCtx :
                        stmtCtx =
                          ctx.withLayout
                            (Stmt.regularOutLayout ctx.layout stmt) :=
                      Stmt.run_regular_ctx hStmt
                    subst stmtCtx
                    have hTailCtx := ih hRun
                    simpa [regularOutLayout, Locals.Ctx.withLayout]
                      using hTailCtx

theorem block_runOpen_regular_layout {program : Locals.Program}
    {ctx runCtx : Locals.Ctx} {fuel : Nat} {block : Locals.Block}
    {state final : Locals.RunState}
    (hRun :
      Locals.Direct.Block.runOpen program ctx fuel block state =
        .ok (Structured.Outcome.regular final, runCtx)) :
    runCtx.layout = regularOutLayout ctx.layout block.stmts := by
  cases block with
  | mk stmts =>
      exact runOpen_regular_layout hRun

theorem block_runOpen_regular_ctx {program : Locals.Program}
    {ctx runCtx : Locals.Ctx} {fuel : Nat} {block : Locals.Block}
    {state final : Locals.RunState}
    (hRun :
      Locals.Direct.Block.runOpen program ctx fuel block state =
        .ok (Structured.Outcome.regular final, runCtx)) :
    runCtx = ctx.withLayout (regularOutLayout ctx.layout block.stmts) := by
  cases block with
  | mk stmts =>
      exact runOpen_regular_ctx hRun

theorem pushReturns_preserves (layout returns : List Name) :
    regularOutLayout layout (Functions.Lower.pushReturns returns) =
      layout := by
  cases returns with
  | nil =>
      simp [Functions.Lower.pushReturns, regularOutLayout]
  | cons name rest =>
      simp [Functions.Lower.pushReturns, regularOutLayout,
        Stmt.regularOutLayout]

theorem evalArgs_preserves (layout : List Name) (args : List (Expr 1)) :
    regularOutLayout layout (Functions.Lower.evalArgs args) = layout := by
  cases args with
  | nil =>
      simp [Functions.Lower.evalArgs, regularOutLayout]
  | cons arg rest =>
      simp [Functions.Lower.evalArgs, regularOutLayout,
        Stmt.regularOutLayout]

theorem assignReturnedTopsRev_preserves (layout targets : List Name) :
    regularOutLayout layout
        (Functions.Lower.assignReturnedTopsRev targets) =
      layout := by
  induction targets generalizing layout with
  | nil =>
      simp [Functions.Lower.assignReturnedTopsRev, regularOutLayout]
  | cons name rest ih =>
      simp [Functions.Lower.assignReturnedTopsRev, regularOutLayout,
        Stmt.regularOutLayout, ih]

theorem assignReturnedTops_preserves (layout targets : List Name) :
    regularOutLayout layout (Functions.Lower.assignReturnedTops targets) =
      layout := by
  simpa [Functions.Lower.assignReturnedTops] using
    assignReturnedTopsRev_preserves layout targets.reverse

theorem initReturns_layout (layout returns : List Name) :
    regularOutLayout layout (Functions.Lower.initReturns returns) =
      returns.reverse ++ layout := by
  induction returns generalizing layout with
  | nil =>
      simp [Functions.Lower.initReturns, regularOutLayout]
  | cons name rest ih =>
      simp [Functions.Lower.initReturns, regularOutLayout,
        Stmt.regularOutLayout, ih, List.cons_append]

theorem functionsStmt_toLocals_layout (returns layout : List Name)
    (stmt : Stmt) :
    regularOutLayout layout (Functions.Stmt.toLocals returns stmt) =
      Checked.Stmt.regularOutLayout layout stmt := by
  cases stmt <;>
    simp [Functions.Stmt.toLocals, Checked.Stmt.regularOutLayout,
      regularOutLayout, Stmt.regularOutLayout]
  · simp [regularOutLayout_append, pushReturns_preserves,
      regularOutLayout, Stmt.regularOutLayout]
  · simp [regularOutLayout_append, evalArgs_preserves,
      assignReturnedTops_preserves, regularOutLayout, Stmt.regularOutLayout]

end StmtList

namespace Prepare

theorem promoteName_regularOutLayout {layout : List Name} {name : Name}
    {promoted : List Name} {idx : Nat}
    (hPromote :
      Layout.promoteName? layout name = some (promoted, idx)) :
    Stmt.regularOutLayout layout (.promoteName name) = promoted := by
  rcases Layout.promoteName?_eq_some hPromote with
    ⟨hIndex, hBound, hPromoted, _hTop, _hLen⟩
  have hDepth :
      Locals.Layout.lookupDepth? name layout = some (idx + 1) :=
    Layout.index?_lookupDepth? hIndex
  have hDepthSub : idx + 1 - 1 = idx := by omega
  rw [hPromoted]
  simp [Stmt.regularOutLayout, hDepth, hDepthSub, hBound,
    Layout.promoteAt, Locals.Layout.promoteAt]
  rfl

theorem loop_regularOutLayout {returns live : List Name} {stmt : Stmt}
    {reqs : List LiveLayout.Prepare.NameReq} :
    ∀ {fuel layout prep finalLayout},
      LiveLayout.Prepare.loop returns live stmt reqs fuel layout =
          some (prep, finalLayout) →
        StmtList.regularOutLayout layout prep = finalLayout := by
  intro fuel
  induction fuel with
  | zero =>
      intro layout prep finalLayout hLoop
      unfold LiveLayout.Prepare.loop at hLoop
      cases hChecked :
          LiveLayout.Prepare.checked? returns live layout stmt with
      | false =>
          simp [hChecked] at hLoop
      | true =>
          simp [hChecked] at hLoop
          rcases hLoop with ⟨rfl, rfl⟩
          simp [StmtList.regularOutLayout]
  | succ fuel ih =>
      intro layout prep finalLayout hLoop
      unfold LiveLayout.Prepare.loop at hLoop
      cases hChecked :
          LiveLayout.Prepare.checked? returns live layout stmt with
      | true =>
          simp [hChecked] at hLoop
          rcases hLoop with ⟨rfl, rfl⟩
          simp [StmtList.regularOutLayout]
      | false =>
          simp [hChecked] at hLoop
          cases hPromote :
              LiveLayout.Prepare.promoteBlocked? layout reqs with
          | none =>
              simp [hPromote] at hLoop
          | some promotedPair =>
              rcases promotedPair with ⟨promoteStmt, promotedLayout⟩
              simp [hPromote] at hLoop
              cases hRest :
                  LiveLayout.Prepare.loop returns live stmt reqs fuel
                    promotedLayout with
              | none =>
                  simp [hRest] at hLoop
              | some restPair =>
                  rcases restPair with ⟨restPrep, restLayout⟩
                  simp [hRest] at hLoop
                  rcases hLoop with ⟨rfl, rfl⟩
                  rcases LiveLayout.Prepare.promoteBlocked?_eq_some hPromote
                    with ⟨name, idx, hPromoteStmt, hPromoteLayout⟩
                  subst promoteStmt
                  have hHeadLayout :=
                    promoteName_regularOutLayout hPromoteLayout
                  have hTailLayout := ih hRest
                  simp [StmtList.regularOutLayout, hHeadLayout, hTailLayout]

theorem loopAboveSuffix_regularOutLayout {protectedDepth : Nat}
    {returns live : List Name} {stmt : Stmt}
    {reqs : List LiveLayout.Prepare.NameReq} :
    ∀ {fuel layout prep finalLayout},
      LiveLayout.Prepare.loopAboveSuffix protectedDepth returns live stmt reqs
          fuel layout =
          some (prep, finalLayout) →
        StmtList.regularOutLayout layout prep = finalLayout := by
  intro fuel
  induction fuel with
  | zero =>
      intro layout prep finalLayout hLoop
      unfold LiveLayout.Prepare.loopAboveSuffix at hLoop
      cases hChecked :
          LiveLayout.Prepare.checked? returns live layout stmt with
      | false =>
          simp [hChecked] at hLoop
      | true =>
          simp [hChecked] at hLoop
          rcases hLoop with ⟨rfl, rfl⟩
          simp [StmtList.regularOutLayout]
  | succ fuel ih =>
      intro layout prep finalLayout hLoop
      unfold LiveLayout.Prepare.loopAboveSuffix at hLoop
      cases hChecked :
          LiveLayout.Prepare.checked? returns live layout stmt with
      | true =>
          simp [hChecked] at hLoop
          rcases hLoop with ⟨rfl, rfl⟩
          simp [StmtList.regularOutLayout]
      | false =>
          simp [hChecked] at hLoop
          cases hPromote :
              LiveLayout.Prepare.promoteBlockedAboveSuffix? protectedDepth
                layout reqs with
          | none =>
              simp [hPromote] at hLoop
          | some promotedPair =>
              rcases promotedPair with ⟨promoteStmt, promotedLayout⟩
              simp [hPromote] at hLoop
              cases hRest :
                  LiveLayout.Prepare.loopAboveSuffix protectedDepth returns
                    live stmt reqs fuel promotedLayout with
              | none =>
                  simp [hRest] at hLoop
              | some restPair =>
                  rcases restPair with ⟨restPrep, restLayout⟩
                  simp [hRest] at hLoop
                  rcases hLoop with ⟨rfl, rfl⟩
                  rcases
                      LiveLayout.Prepare.promoteBlockedAboveSuffix?_eq_some
                        hPromote with
                    ⟨name, idx, hPromoteStmt, hPromoteLayout, _hIdx⟩
                  subst promoteStmt
                  have hHeadLayout :=
                    promoteName_regularOutLayout hPromoteLayout
                  have hTailLayout := ih hRest
                  simp [StmtList.regularOutLayout, hHeadLayout, hTailLayout]

theorem forStmtAboveSuffix?_regularOutLayout {protectedDepth : Nat}
    {returns layout live : List Name}
    {stmt : Stmt} {prep : List Locals.Stmt} {finalLayout : List Name}
    (hPrepare :
      LiveLayout.Prepare.forStmtAboveSuffix? protectedDepth returns layout
          live stmt =
        some (prep, finalLayout)) :
    StmtList.regularOutLayout layout prep = finalLayout := by
  unfold LiveLayout.Prepare.forStmtAboveSuffix? at hPrepare
  exact loopAboveSuffix_regularOutLayout hPrepare

end Prepare

namespace Lower

theorem stmt_toLocals?_layout {returns : List Name} {ctx : Ctx}
    {layout after : List Name} {stmt : Stmt}
    {lowerStmts : List Locals.Stmt} {outLayout : List Name}
    (hLower :
      LiveLayout.Lower.Stmt.toLocals? returns ctx layout after stmt =
        some (lowerStmts, outLayout)) :
    StmtList.regularOutLayout layout lowerStmts = outLayout := by
  cases stmt with
  | expr expr =>
      simp [LiveLayout.Lower.Stmt.toLocals?] at hLower
      rcases hLower with ⟨hLowerStmts, hOut⟩
      subst lowerStmts
      subst outLayout
      simpa using
        StmtList.functionsStmt_toLocals_layout returns layout (.expr expr)
  | let_ name value =>
      simp [LiveLayout.Lower.Stmt.toLocals?] at hLower
      rcases hLower with ⟨hLowerStmts, hOut⟩
      subst lowerStmts
      subst outLayout
      simpa using
        StmtList.functionsStmt_toLocals_layout returns layout
          (.let_ name value)
  | assign name value =>
      simp [LiveLayout.Lower.Stmt.toLocals?] at hLower
      rcases hLower with ⟨hLowerStmts, hOut⟩
      subst lowerStmts
      subst outLayout
      simpa using
        StmtList.functionsStmt_toLocals_layout returns layout
          (.assign name value)
  | block body =>
      simp only [LiveLayout.Lower.Stmt.toLocals?] at hLower
      let bodyCtx := ctx.withProtectedLayout layout
      cases hBody :
          LiveLayout.Lower.Block.toLocals? returns bodyCtx layout
            (Checked.scopedAfter layout after) body with
      | none =>
          simp [bodyCtx, hBody] at hLower
      | some result =>
          rcases result with ⟨lowerBody, bodyLayout⟩
          simp [bodyCtx, hBody] at hLower
          rcases hLower with ⟨hLowerStmts, hOut⟩
          subst lowerStmts
          subst outLayout
          simp [StmtList.regularOutLayout, Stmt.regularOutLayout]
  | if_ cond body =>
      simp only [LiveLayout.Lower.Stmt.toLocals?] at hLower
      let bodyCtx := ctx.withProtectedLayout layout
      cases hBody :
          LiveLayout.Lower.Block.toLocals? returns bodyCtx layout
            (Checked.scopedAfter layout after) body with
      | none =>
          simp [bodyCtx, hBody] at hLower
      | some result =>
          rcases result with ⟨lowerBody, bodyLayout⟩
          simp [bodyCtx, hBody] at hLower
          rcases hLower with ⟨hLowerStmts, hOut⟩
          subst lowerStmts
          subst outLayout
          simp [StmtList.regularOutLayout, Stmt.regularOutLayout]
  | switch scrutinee cases defaultBody =>
      simp only [LiveLayout.Lower.Stmt.toLocals?] at hLower
      let branchCtx := ctx.withProtectedLayout layout
      cases hCases :
          LiveLayout.Lower.CaseList.toLocals? returns branchCtx layout
            (Checked.scopedAfter layout after) cases with
      | none =>
          simp [branchCtx, hCases] at hLower
      | some lowerCases =>
          cases hDefault :
              LiveLayout.Lower.Default.toLocals? returns branchCtx layout
                (Checked.scopedAfter layout after) defaultBody with
          | none =>
              simp [branchCtx, hCases, hDefault] at hLower
          | some lowerDefault =>
              simp [branchCtx, hCases, hDefault] at hLower
              rcases hLower with ⟨hLowerStmts, hOut⟩
              subst lowerStmts
              subst outLayout
              simp [StmtList.regularOutLayout, Stmt.regularOutLayout]
  | for_ init cond post body =>
      rcases LiveLayout.Lower.ForLowering.components_of_toLocals? hLower with
        ⟨lowerInit, loopLayout, lowerPost, postLayout, lowerBody, bodyLayout,
          hInit, hCond, hPost, hBody, hLowerStmts, hOut⟩
      subst lowerStmts
      subst outLayout
      simp [StmtList.regularOutLayout, Stmt.regularOutLayout]
  | brk =>
      simp [LiveLayout.Lower.Stmt.toLocals?] at hLower
      rcases hLower with ⟨hLowerStmts, hOut⟩
      subst lowerStmts
      subst outLayout
      simpa using
        StmtList.functionsStmt_toLocals_layout returns layout .brk
  | cont =>
      simp [LiveLayout.Lower.Stmt.toLocals?] at hLower
      rcases hLower with ⟨hLowerStmts, hOut⟩
      subst lowerStmts
      subst outLayout
      simpa using
        StmtList.functionsStmt_toLocals_layout returns layout .cont
  | leave =>
      simp [LiveLayout.Lower.Stmt.toLocals?] at hLower
      rcases hLower with ⟨hLowerStmts, hOut⟩
      subst lowerStmts
      subst outLayout
      simpa using
        StmtList.functionsStmt_toLocals_layout returns layout .leave
  | call targets functionName args =>
      simp [LiveLayout.Lower.Stmt.toLocals?] at hLower
      rcases hLower with ⟨hLowerStmts, hOut⟩
      subst lowerStmts
      subst outLayout
      simpa using
        StmtList.functionsStmt_toLocals_layout returns layout
          (.call targets functionName args)
  | terminal kind =>
      simp [LiveLayout.Lower.Stmt.toLocals?] at hLower
      rcases hLower with ⟨hLowerStmts, hOut⟩
      subst lowerStmts
      subst outLayout
      simpa using
        StmtList.functionsStmt_toLocals_layout returns layout
          (.terminal kind)
  | terminalArgs kind args =>
      simp [LiveLayout.Lower.Stmt.toLocals?] at hLower
      rcases hLower with ⟨hLowerStmts, hOut⟩
      subst lowerStmts
      subst outLayout
      exact
        StmtList.functionsStmt_toLocals_layout returns layout
          (.terminalArgs kind args)

theorem stmt_toLocals?_cleanupLayoutRel {returns : List Name} {ctx : Ctx}
    {layout after : List Name} {stmt : Stmt}
    {lowerStmts : List Locals.Stmt} {outLayout : List Name}
    (hLower :
      LiveLayout.Lower.Stmt.toLocals? returns ctx layout after stmt =
        some (lowerStmts, outLayout)) :
    SourceDirect.CleanupLayoutRel outLayout layout := by
  have hOut :=
    EvmCompiler.Functions.LiveLayout.Lower.stmt_toLocals?_regularOutLayout
      hLower
  rw [hOut]
  exact
    EvmCompiler.Functions.LiveLayout.Checked.Stmt.regularOutLayout_cleanupLayoutRel
      layout stmt

theorem stmtList_toLocals?_layout {returns : List Name} {ctx : Ctx}
    {layout after : List Name} {stmts : List Stmt}
    {lowerStmts : List Locals.Stmt} {outLayout : List Name}
    (hLower :
      LiveLayout.Lower.StmtList.toLocals? returns ctx layout after stmts =
        some (lowerStmts, outLayout)) :
    StmtList.regularOutLayout layout lowerStmts = outLayout := by
  induction stmts generalizing layout lowerStmts outLayout with
  | nil =>
      unfold LiveLayout.Lower.StmtList.toLocals? at hLower
      cases hEntry : Layout.entryWindowOk? layout after with
      | false =>
          simp [hEntry] at hLower
      | true =>
          let liveLayout := Layout.trimDeadPrefix layout after
          simp [hEntry] at hLower
          rcases hLower with ⟨hLowerStmts, hOut⟩
          subst lowerStmts
          subst outLayout
          simp [StmtList.regularOutLayout, Stmt.regularOutLayout]
  | cons stmt rest ih =>
      rcases LiveLayout.Lower.StmtList.toLocals?_cons_components hLower with
        ⟨restLive, stmtLive, liveLayout, prep, preparedLayout, lowerStmt,
          nextLayout, lowerRest, hRestLive, hStmtLive, hLiveLayout, hPrepare,
          hEntry, hAccess, hLowerStmt, hLowerRest, hLowerStmts⟩
      rw [hLowerStmts]
      have hPrepLayout :=
        Prepare.forStmtAboveSuffix?_regularOutLayout hPrepare
      have hStmtLayout := stmt_toLocals?_layout hLowerStmt
      have hRestLayout := ih hLowerRest
      simp [StmtList.regularOutLayout, Stmt.regularOutLayout,
        LiveLayout.Lower.cleanupToLive]
      rw [StmtList.regularOutLayout_append, ← hLiveLayout, hPrepLayout,
        StmtList.regularOutLayout_append, hStmtLayout, hRestLayout]

theorem block_toLocals?_layout {returns : List Name} {ctx : Ctx}
    {layout after : List Name} {block : Block}
    {lowerBlock : Locals.Block} {outLayout : List Name}
    (hLower :
      LiveLayout.Lower.Block.toLocals? returns ctx layout after block =
        some (lowerBlock, outLayout)) :
    StmtList.regularOutLayout layout lowerBlock.stmts = outLayout := by
  cases block with
  | mk stmts =>
      simp only [LiveLayout.Lower.Block.toLocals?] at hLower
      cases hList :
          LiveLayout.Lower.StmtList.toLocals? returns ctx layout after stmts
          with
      | none =>
          simp [hList] at hLower
      | some result =>
          rcases result with ⟨lowerStmts, listOutLayout⟩
          simp [hList] at hLower
          rcases hLower with ⟨hLowerBlock, hOut⟩
          subst lowerBlock
          subst outLayout
          exact stmtList_toLocals?_layout hList

theorem block_runOpen_regular_layout_of_lower {returns : List Name}
    {ctx : Ctx} {layout after : List Name} {block : Block}
    {lowerBlock : Locals.Block} {outLayout : List Name}
    {program : Locals.Program} {targetCtx runCtx : Locals.Ctx}
    {fuel : Nat} {state final : Locals.RunState}
    (hLower :
      LiveLayout.Lower.Block.toLocals? returns ctx layout after block =
        some (lowerBlock, outLayout))
    (hCtxLayout : targetCtx.layout = layout)
    (hRun :
      Locals.Direct.Block.runOpen program targetCtx fuel lowerBlock state =
        .ok (Structured.Outcome.regular final, runCtx)) :
    runCtx.layout = outLayout := by
  have hStatic : StmtList.regularOutLayout layout lowerBlock.stmts = outLayout :=
    block_toLocals?_layout hLower
  have hRunLayout :
      runCtx.layout =
        StmtList.regularOutLayout targetCtx.layout lowerBlock.stmts :=
    StmtList.block_runOpen_regular_layout hRun
  calc
    runCtx.layout =
        StmtList.regularOutLayout targetCtx.layout lowerBlock.stmts :=
      hRunLayout
    _ = StmtList.regularOutLayout layout lowerBlock.stmts := by
      rw [hCtxLayout]
    _ = outLayout := hStatic

theorem block_runOpen_regular_ctx_of_lower {returns : List Name}
    {ctx : Ctx} {layout after : List Name} {block : Block}
    {lowerBlock : Locals.Block} {outLayout : List Name}
    {program : Locals.Program} {targetCtx runCtx : Locals.Ctx}
    {fuel : Nat} {state final : Locals.RunState}
    (hLower :
      LiveLayout.Lower.Block.toLocals? returns ctx layout after block =
        some (lowerBlock, outLayout))
    (hCtxLayout : targetCtx.layout = layout)
    (hRun :
      Locals.Direct.Block.runOpen program targetCtx fuel lowerBlock state =
        .ok (Structured.Outcome.regular final, runCtx)) :
    runCtx = targetCtx.withLayout outLayout := by
  have hStatic : StmtList.regularOutLayout layout lowerBlock.stmts = outLayout :=
    block_toLocals?_layout hLower
  have hRunCtx :
      runCtx =
        targetCtx.withLayout
          (StmtList.regularOutLayout targetCtx.layout lowerBlock.stmts) :=
    StmtList.block_runOpen_regular_ctx hRun
  calc
    runCtx =
        targetCtx.withLayout
          (StmtList.regularOutLayout targetCtx.layout lowerBlock.stmts) :=
      hRunCtx
    _ =
        targetCtx.withLayout
          (StmtList.regularOutLayout layout lowerBlock.stmts) := by
      rw [hCtxLayout]
    _ = targetCtx.withLayout outLayout := by
      rw [hStatic]

theorem stmt_runOpen_regular_layout_of_lower {returns : List Name}
    {ctx : Ctx} {layout after : List Name} {stmt : Stmt}
    {lowerStmts : List Locals.Stmt} {outLayout : List Name}

          fuel init source =
        .ok (Source.Outcome.regular sourceAfterInit, sourceInitCtx)) :
    sourceInitCtx.scope = Scope.Block.outEnv sourceCtx.scope init := by
  have hScope := SourceDirect.SourceRun.block_runOpen_regular_scope hSourceInit

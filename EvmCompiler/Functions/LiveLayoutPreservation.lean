    simpa [Block.liveBefore, hRestLive] using hMem
  have hSuffixBeforeStmt :
      ∀ {name : Name},
        name ∈
            targetCtx.layout.drop
              (targetCtx.layout.length - targetDepth) →
          name ∈ stmtLive := by
    intro name hName

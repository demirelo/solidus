        ScopedNoInternalCallShapeRecursiveCallbacksUpTo.mono hLe
          hCallbacks.shape
      openBlock :=
        ScopedNoInternalCallShapeRecursiveOpenBlockLayoutToOutcomeCallbacksUpToOfLeaveFrame.mono
          hLe hCallbacks.openBlock
      loopOpenBlock :=
        ScopedNoInternalCallShapeRecursiveLoopOpenBlockLayoutToOutcomeCallbacksUpToOfLeaveFrame.mono
          hLe hCallbacks.loopOpenBlock }


        (hSuffixBeforeRest hName)
  have hTrim :
      SourceDirectBridge.LiveCleanupScopeRel liveLayout targetDepth
        breakScope := by
    rw [hLiveLayout]
    exact
      SourceDirectBridge.LiveCleanupScopeRel.trimDeadPrefix_of_keep hBase
        (by
          intro name hName
          exact hSuffixBeforeStmt hName)
  have hDepthProtected : targetDepth ≤ liveCtx.protectedDepth :=
    hBreakDepthProtected hOuterMode hTargetDepthBefore
  have hPrepared :
      SourceDirectBridge.LiveCleanupScopeRel preparedLayout targetDepth
        breakScope :=
    SourceDirectBridge.LiveCleanupScopeRel.forStmtAboveSuffix_of_depth_bound
      hPrepare hTrim hDepthProtected
  have hStmtCleanup :
      SourceDirect.CleanupLayoutRel nextLayout preparedLayout :=
    TargetLayout.Lower.stmt_toLocals?_cleanupLayoutRel hLowerStmt
  have hNextPrepared :
      nextLayout.drop (nextLayout.length - targetDepth) =
        preparedLayout.drop (preparedLayout.length - targetDepth) := by
    have hPreparedLen : preparedLayout.length ≤ nextLayout.length := by
      have hLength := congrArg List.length hStmtCleanup
      simp [List.length_drop] at hLength
      omega
    have hPreparedDepth : targetDepth ≤ preparedLayout.length := hPrepared.1
    have hIndex :
        nextLayout.length - targetDepth =
          (nextLayout.length - preparedLayout.length) +
            (preparedLayout.length - targetDepth) := by
      omega
    calc
      nextLayout.drop (nextLayout.length - targetDepth)
          =
        nextLayout.drop
          ((nextLayout.length - preparedLayout.length) +
            (preparedLayout.length - targetDepth)) := by
          rw [hIndex]
      _ = (nextLayout.drop (nextLayout.length - preparedLayout.length)).drop
            (preparedLayout.length - targetDepth) := by
          rw [List.drop_drop]
      _ = preparedLayout.drop (preparedLayout.length - targetDepth) := by
          rw [hStmtCleanup]
  calc
    targetCtxAfter.layout.drop
        (targetCtxAfter.layout.length - targetDepth)
        =
      nextLayout.drop (nextLayout.length - targetDepth) := by
        simp [hTargetCtxEq, Locals.Ctx.withLayout]
    _ = preparedLayout.drop (preparedLayout.length - targetDepth) :=
        hNextPrepared
    _ = targetCtx.layout.drop (targetCtx.layout.length - targetDepth) :=
        SourceDirectBridge.LiveCleanupScopeRel.forStmtAboveSuffix_trimDeadPrefix_suffix_drop
          (hLiveLayout := hLiveLayout) (hPrepare := hPrepare)
          hDepthProtected hTrim.1
    _ = loopLayout := hBreakLoopDrop hOuterMode hTargetDepthBefore


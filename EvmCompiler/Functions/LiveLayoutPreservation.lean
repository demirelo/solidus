private theorem source_runForLoop_ok_ne_zero
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {loopCtx postBase bodyBase : Source.Ctx}
    {cond : Expr 1} {post body : Block}
    {fuel : Nat} {source : Source.State} {sourceLoop : Source.Outcome}
    (hRun :
      Source.Stmt.runForLoop prim sourceProgram loopCtx cond postBase post
          bodyBase body fuel source =
        .ok sourceLoop) :
    fuel ≠ 0 := by
  intro hFuel
  subst fuel
  simp [Source.Stmt.runForLoop, Source.invalid, Structured.invalid] at hRun

private theorem source_runForLoop_ok_as_succ
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {loopCtx postBase bodyBase : Source.Ctx}
    {cond : Expr 1} {post body : Block}
    {fuel : Nat} {source : Source.State} {sourceLoop : Source.Outcome}
    (hRun :
      Source.Stmt.runForLoop prim sourceProgram loopCtx cond postBase post
          bodyBase body fuel source =
        .ok sourceLoop) :
    ∃ predFuel, fuel = predFuel + 1 := by
  exact Nat.exists_eq_succ_of_ne_zero (source_runForLoop_ok_ne_zero hRun)

private theorem forLoop_init_target_ctx_of_lower
    {returns : List Name} {liveCtx : Ctx}
    {cleanedLayout initAfter : List Name}
    {init : Block} {lowerInit : Locals.Block} {loopLayout : List Name}
    {targetProgram : Locals.Program} {targetCtx targetInitCtx : Locals.Ctx}
    {cleaned targetAfterInit : Locals.RunState} {initTargetFuel : Nat}
    (hLowerInit :
      Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout cleanedLayout) cleanedLayout
          initAfter init =
        some (lowerInit, loopLayout))
    (hTargetInit :
      Locals.Direct.Block.runOpen targetProgram
          (targetCtx.withLayout cleanedLayout).withoutLoopControl
          initTargetFuel lowerInit cleaned =
        .ok (Structured.Outcome.regular targetAfterInit, targetInitCtx)) :
    targetInitCtx =
      ((targetCtx.withLayout cleanedLayout).withoutLoopControl).withLayout
        loopLayout := by
  exact
    TargetLayout.Lower.block_runOpen_regular_ctx_of_lower
      (returns := returns) (ctx := liveCtx.withProtectedLayout cleanedLayout)
      (layout := cleanedLayout) (after := initAfter) (block := init)
      (lowerBlock := lowerInit) (outLayout := loopLayout)
      (targetCtx := (targetCtx.withLayout cleanedLayout).withoutLoopControl)
      hLowerInit
      (by simp [Locals.Ctx.withLayout, Locals.Ctx.withoutLoopControl])
      hTargetInit

private theorem forLoop_init_target_layout_of_lower
    {returns : List Name} {liveCtx : Ctx}
    {cleanedLayout initAfter : List Name}
    {init : Block} {lowerInit : Locals.Block} {loopLayout : List Name}
    {targetProgram : Locals.Program} {targetCtx targetInitCtx : Locals.Ctx}
    {cleaned targetAfterInit : Locals.RunState} {initTargetFuel : Nat}
    (hLowerInit :
      Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout cleanedLayout) cleanedLayout
          initAfter init =
        some (lowerInit, loopLayout))
    (hTargetInit :
      Locals.Direct.Block.runOpen targetProgram
          (targetCtx.withLayout cleanedLayout).withoutLoopControl
          initTargetFuel lowerInit cleaned =
        .ok (Structured.Outcome.regular targetAfterInit, targetInitCtx)) :
    targetInitCtx.layout = loopLayout := by
  have hCtx :=
    forLoop_init_target_ctx_of_lower (targetCtx := targetCtx)
      hLowerInit hTargetInit
  rw [hCtx]
  simp [Locals.Ctx.withLayout]

private theorem forLoop_init_target_nodup_of_lower
    {returns : List Name} {liveCtx : Ctx}
    {sourceEnv cleanedLayout initAfter : List Name}
    {init : Block} {lowerInit : Locals.Block} {loopLayout : List Name}
    {targetProgram : Locals.Program} {targetCtx targetInitCtx : Locals.Ctx}
    {cleaned targetAfterInit : Locals.RunState} {initTargetFuel : Nat}
    (hLowerInit :
      Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout cleanedLayout) cleanedLayout
          initAfter init =
        some (lowerInit, loopLayout))
    (hTargetInit :
      Locals.Direct.Block.runOpen targetProgram
          (targetCtx.withLayout cleanedLayout).withoutLoopControl
          initTargetFuel lowerInit cleaned =
        .ok (Structured.Outcome.regular targetAfterInit, targetInitCtx))
    (hSubset : ∀ {name : Name}, name ∈ cleanedLayout → name ∈ sourceEnv)
    (hCleanedNoDup : cleanedLayout.Nodup)
    (hInitScoped : Scope.Block.Scoped sourceEnv init) :
    targetInitCtx.layout.Nodup := by
  have hCheck := Lower.Block.toLocals?_checked hLowerInit
  have hLoopNoDup : loopLayout.Nodup :=
    Lower.Checked.Block.check?_nodup hCheck hSubset hCleanedNoDup hInitScoped
  have hLayout :=
    forLoop_init_target_layout_of_lower (targetCtx := targetCtx)
      hLowerInit hTargetInit
  rwa [hLayout]

private theorem forLoop_init_source_scope_of_run
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {sourceCtx sourceInitCtx : Source.Ctx}

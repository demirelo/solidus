    (hBodyNoCall : NoInternalCall.Block.Holds body)
    (hBodyScoped : Scope.Block.Scoped sourceCtx.scope body)
    (hSelect : Source.Switch.select value cases defaultBody = some body)
    (hLowerBody :
      Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout preparedLayout) preparedLayout
        (Checked.scopedAfter preparedLayout restLive) body =
        some (lowerBody, bodyLayout))
    (hSourceOpen :
      Source.Block.runOpen prim sourceProgram sourceCtx fuel.pred body
          sourceAfterScrutinee =
        .ok sourceOpenResult)
    (hRel :
      SourceDirect.StateRel preparedLayout hiddenReturns sourceAfterScrutinee
        targetAfterPop) :
    SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
      targetProgram returns retc fuel.pred sourceCtx
      (targetCtx.withLayout preparedLayout)
      hiddenReturns body lowerBody sourceAfterScrutinee targetAfterPop := by
  have hSelectLower :
      Switch.select value cases defaultBody = some body := by
    simpa [SourceDirect.Switch.source_select_eq] using hSelect
  have hBreakLiveSubset :
      sourceOpenResult.1.mode = .brk →
        ∀ {name : Name}, name ∈ liveCtx.breakLive → name ∈ stmtLive := by
    intro hMode name hName
    rw [hStmtLive]
    exact
      LiveBefore.switch_selected_body_subset_stmt
        (switchExpr := switchExpr) hSelectLower
        (hBreakBodyLiveSubset hMode hName)
  have hContinueLiveSubset :
      sourceOpenResult.1.mode = .cont →
        ∀ {name : Name}, name ∈ liveCtx.continueLive → name ∈ stmtLive := by
    intro hMode name hName
    rw [hStmtLive]
    exact
      LiveBefore.switch_selected_body_subset_stmt
        (switchExpr := switchExpr) hSelectLower
        (hContinueBodyLiveSubset hMode hName)
  exact
    blockBody_of_open_block_of_mode_live_subset
      (prim := prim) hCallbacks (returns := returns) (liveCtx := liveCtx)
      (after := after) (outLayout := outLayout) (retc := retc)
      (fuel := fuel.pred) (sourceCtx := sourceCtx) (targetCtx := targetCtx)
      (hiddenReturns := hiddenReturns) (source := sourceAfterScrutinee)
      hFuelPredLe hCtxCleanup hNoDup hSourceNoDup hReturnsLen hLeaveFrame hControlRel
      hHandlerScope hReturnsEq
      (stmt := .switch switchExpr cases defaultBody) (rest := rest)
      (restLive := restLive) (stmtLive := stmtLive)
      (liveLayout := liveLayout) (preparedLayout := preparedLayout)
      (prep := prep) (nextLayout := nextLayout)
      (lowerStmt := lowerStmt) (lowerRest := lowerRest) hRestLive
      hStmtLive hLiveLayout hPrepare hEntry hAccess hLowerStmt hLowerRest
      hRel hBodyNoCall hBodyScoped hLowerBody hSourceOpen
      hBreakLiveSubset hContinueLiveSubset

theorem switchBody_of_open_block_of_selected_body_mode_live_subset_of_run
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {maxFuel : Nat}
    (hCallbacks :
      ScopedNoInternalCallShapeRecursiveOpenBlockOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel)
    {returns : List Name} {liveCtx : Ctx} {after outLayout : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    (hFuelPredLe : fuel.pred ≤ maxFuel)
    (hCtxCleanup :
      SourceDirectBridge.LiveCtxCleanupRel retc sourceCtx targetCtx)
    (hNoDup : targetCtx.layout.Nodup)
    (hSourceNoDup : sourceCtx.scope.Nodup)
    (hReturnsLen : returns.length = retc)
    (hLeaveFrame : SourceDirect.LeaveFrameAvailable sourceCtx hiddenReturns)
    (hControlRel :
      SourceDirectBridge.LiveControlRel liveCtx sourceCtx)
    (hHandlerScope :
      SourceDirectBridge.LiveHandlerScopeRel liveCtx sourceCtx)
    (hReturnsEq : liveCtx.returns = returns)
    {switchExpr : Expr 1} {cases : List (Word × Block)}
    {defaultBody : Option Block} {rest : List Stmt}
    {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
    {prep lowerStmt lowerRest : List Locals.Stmt}
    (hRestLive : restLive = StmtList.liveBefore liveCtx after rest)
    (hStmtLive :
      stmtLive = Stmt.liveBefore liveCtx restLive
        (.switch switchExpr cases defaultBody))
    (hLiveLayout : liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive)
    (hPrepare :
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive (.switch switchExpr cases defaultBody) =
        some (prep, preparedLayout))
    (hEntry : Layout.entryWindowOk? preparedLayout stmtLive = true)
    (hAccess :
      StmtAccess.accessible? returns preparedLayout
        (.switch switchExpr cases defaultBody) =
          true)
    (hLowerStmt :
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive
        (.switch switchExpr cases defaultBody) =
        some (lowerStmt, nextLayout))
    (hLowerRest :
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout))
    {sourceAfterScrutinee : Source.State} {targetAfterPop : Locals.RunState}
    {value : Word} {body : Block} {lowerBody : Locals.Block}
    {bodyLayout : List Name} {sourceOpenResult : Source.Outcome × Source.Ctx}
    (hBodyNoCall : NoInternalCall.Block.Holds body)
    (hBodyScoped : Scope.Block.Scoped sourceCtx.scope body)
    (hSelect : Source.Switch.select value cases defaultBody = some body)
    (hLowerBody :
      Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout preparedLayout) preparedLayout
        (Checked.scopedAfter preparedLayout restLive) body =
        some (lowerBody, bodyLayout))
    (hSourceOpen :
      Source.Block.runOpen prim sourceProgram sourceCtx fuel.pred body
          sourceAfterScrutinee =
        .ok sourceOpenResult)
    (hRel :
      SourceDirect.StateRel preparedLayout hiddenReturns sourceAfterScrutinee
        targetAfterPop) :
    SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
      targetProgram returns retc fuel.pred sourceCtx
      (targetCtx.withLayout preparedLayout)
      hiddenReturns body lowerBody sourceAfterScrutinee targetAfterPop := by
  have hBreakBodyLiveSubset :
      sourceOpenResult.1.mode = .brk →
        ∀ {name : Name}, name ∈ liveCtx.breakLive →
          name ∈ Block.liveBefore liveCtx restLive body := by
    intro hMode name hName
    rcases sourceOpenResult with ⟨⟨sourceOut, mode⟩, sourceCtxOut⟩
    cases mode <;> simp at hMode
    exact
      (HandlerRunLiveBefore.block_breakLive_mem_of_brk_run
        (live := liveCtx) (after := restLive) hHandlerScope hBodyScoped
        (by simpa [Source.Outcome.brk] using hSourceOpen)).2 hName
  have hContinueBodyLiveSubset :
      sourceOpenResult.1.mode = .cont →
        ∀ {name : Name}, name ∈ liveCtx.continueLive →
          name ∈ Block.liveBefore liveCtx restLive body := by
    intro hMode name hName
    rcases sourceOpenResult with ⟨⟨sourceOut, mode⟩, sourceCtxOut⟩
    cases mode <;> simp at hMode
    exact
      (HandlerRunLiveBefore.block_continueLive_mem_of_cont_run
        (live := liveCtx) (after := restLive) hHandlerScope hBodyScoped
        (by simpa [Source.Outcome.cont] using hSourceOpen)).2 hName
  exact
    switchBody_of_open_block_of_selected_body_mode_live_subset
      (prim := prim) hCallbacks (returns := returns) (liveCtx := liveCtx)
      (after := after) (outLayout := outLayout) (retc := retc)
      (fuel := fuel) (sourceCtx := sourceCtx) (targetCtx := targetCtx)
      (hiddenReturns := hiddenReturns) hFuelPredLe hCtxCleanup hNoDup
      hSourceNoDup hReturnsLen hLeaveFrame hControlRel hHandlerScope hReturnsEq
      hRestLive hStmtLive hLiveLayout hPrepare hEntry hAccess hLowerStmt
      hLowerRest hBreakBodyLiveSubset hContinueBodyLiveSubset hBodyNoCall
      hBodyScoped hSelect hLowerBody hSourceOpen hRel

theorem switchBody_of_open_block_of_outer_outcome_cleanup_of_run
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {maxFuel : Nat}
    (hCallbacks :
      ScopedNoInternalCallShapeRecursiveOpenBlockOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel)
    {returns : List Name} {liveCtx : Ctx} {after outLayout : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source sourceAfterScrutinee : Source.State}
    {sourceResult : Source.Outcome × Source.Ctx}
    {switchExpr : Expr 1} {cases : List (Word × Block)}
    {defaultBody : Option Block} {rest : List Stmt}
    {value : Word} {body : Block}
    (hFuelPredLe : fuel.pred ≤ maxFuel)
    (hSourceRun :
      Source.Block.runOpen prim sourceProgram sourceCtx (fuel + 1)
          { stmts := .switch switchExpr cases defaultBody :: rest } source =
        .ok sourceResult)
    (hEvalOne :
      Source.Expr.evalOne prim switchExpr source =
        .ok (sourceAfterScrutinee, value))
    (hSelect : Source.Switch.select value cases defaultBody = some body)
    (hOutcomeCleanup :
      SourceDirectBridge.LiveCtxOutcomeCleanupRel retc sourceCtx targetCtx
        sourceResult.1)
    (hNoDup : targetCtx.layout.Nodup)
    (hSourceNoDup : sourceCtx.scope.Nodup)
    (hReturnsLen : returns.length = retc)
    (hLeaveFrame : SourceDirect.LeaveFrameAvailable sourceCtx hiddenReturns)
    (hControlRel :
      SourceDirectBridge.LiveControlRel liveCtx sourceCtx)
    (hHandlerScope :
      SourceDirectBridge.LiveHandlerScopeRel liveCtx sourceCtx)
    (hReturnsEq : liveCtx.returns = returns)
    {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
    {prep lowerStmt lowerRest : List Locals.Stmt}
    (hRestLive : restLive = StmtList.liveBefore liveCtx after rest)
    (hStmtLive :
      stmtLive = Stmt.liveBefore liveCtx restLive
        (.switch switchExpr cases defaultBody))
    (hLiveLayout : liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive)
    (hPrepare :
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive (.switch switchExpr cases defaultBody) =
        some (prep, preparedLayout))
    (hEntry : Layout.entryWindowOk? preparedLayout stmtLive = true)
    (hAccess :
      StmtAccess.accessible? returns preparedLayout
        (.switch switchExpr cases defaultBody) =
          true)
    (hLowerStmt :
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive
        (.switch switchExpr cases defaultBody) =
        some (lowerStmt, nextLayout))
    (hLowerRest :
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout))
    {targetAfterPop : Locals.RunState}
    {lowerBody : Locals.Block} {bodyLayout : List Name}
    {sourceOpenResult : Source.Outcome × Source.Ctx}
    (hBodyNoCall : NoInternalCall.Block.Holds body)
    (hBodyScoped : Scope.Block.Scoped sourceCtx.scope body)
    (hLowerBody :
      Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout preparedLayout) preparedLayout
        (Checked.scopedAfter preparedLayout restLive) body =
        some (lowerBody, bodyLayout))
    (hSourceOpen :
      Source.Block.runOpen prim sourceProgram sourceCtx fuel.pred body
          sourceAfterScrutinee =
        .ok sourceOpenResult)
    (hRel :
      SourceDirect.StateRel preparedLayout hiddenReturns sourceAfterScrutinee
        targetAfterPop) :
    SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
      targetProgram returns retc fuel.pred sourceCtx
      (targetCtx.withLayout preparedLayout)
      hiddenReturns body lowerBody sourceAfterScrutinee targetAfterPop := by
  have hSelectLower :
      Switch.select value cases defaultBody = some body := by
    simpa [SourceDirect.Switch.source_select_eq] using hSelect
  have hBreakBodyLiveSubset :
      sourceOpenResult.1.mode = .brk →
        ∀ {name : Name}, name ∈ liveCtx.breakLive →
          name ∈ Block.liveBefore liveCtx restLive body := by
    intro hMode name hName
    rcases sourceOpenResult with ⟨⟨sourceOut, mode⟩, sourceCtxOut⟩
    cases mode <;> simp at hMode
    exact
      (HandlerRunLiveBefore.block_breakLive_mem_of_brk_run
        (live := liveCtx) (after := restLive) hHandlerScope hBodyScoped
        (by simpa [Source.Outcome.brk] using hSourceOpen)).2 hName
  have hContinueBodyLiveSubset :
      sourceOpenResult.1.mode = .cont →
        ∀ {name : Name}, name ∈ liveCtx.continueLive →
          name ∈ Block.liveBefore liveCtx restLive body := by
    intro hMode name hName
    rcases sourceOpenResult with ⟨⟨sourceOut, mode⟩, sourceCtxOut⟩
    cases mode <;> simp at hMode
    exact
      (HandlerRunLiveBefore.block_continueLive_mem_of_cont_run
        (live := liveCtx) (after := restLive) hHandlerScope hBodyScoped
        (by simpa [Source.Outcome.cont] using hSourceOpen)).2 hName
  have hBreakOuterMode :
      sourceOpenResult.1.mode = .brk → sourceResult.1.mode = .brk := by
    intro hMode
    exact
      HandlerRunLiveBefore.block_runOpen_cons_switch_body_brk_mode
        hEvalOne hSelect hSourceOpen hMode hSourceRun
  have hContinueOuterMode :
      sourceOpenResult.1.mode = .cont → sourceResult.1.mode = .cont := by
    intro hMode
    exact
      HandlerRunLiveBefore.block_runOpen_cons_switch_body_cont_mode
        hEvalOne hSelect hSourceOpen hMode hSourceRun
  have hBreakLiveSubset :
      sourceOpenResult.1.mode = .brk →
        ∀ {name : Name}, name ∈ liveCtx.breakLive → name ∈ stmtLive := by
    intro hMode name hName
    rw [hStmtLive]
    exact
      LiveBefore.switch_selected_body_subset_stmt
        (switchExpr := switchExpr) hSelectLower
        (hBreakBodyLiveSubset hMode hName)
  have hContinueLiveSubset :
      sourceOpenResult.1.mode = .cont →
        ∀ {name : Name}, name ∈ liveCtx.continueLive → name ∈ stmtLive := by
    intro hMode name hName
    rw [hStmtLive]
    exact
      LiveBefore.switch_selected_body_subset_stmt
        (switchExpr := switchExpr) hSelectLower
        (hContinueBodyLiveSubset hMode hName)
  exact
    blockBody_of_open_block_of_outer_mode_live_subset
      (prim := prim) hCallbacks (returns := returns) (liveCtx := liveCtx)
      (after := after) (outLayout := outLayout) (retc := retc)
      (fuel := fuel.pred) (sourceCtx := sourceCtx) (targetCtx := targetCtx)
      (hiddenReturns := hiddenReturns) (source := sourceAfterScrutinee)
      (sourceResult := sourceResult) hFuelPredLe hOutcomeCleanup hNoDup
      hSourceNoDup hReturnsLen hLeaveFrame hControlRel hHandlerScope hReturnsEq
      (stmt := .switch switchExpr cases defaultBody) (rest := rest)
      (restLive := restLive) (stmtLive := stmtLive)
      (liveLayout := liveLayout) (preparedLayout := preparedLayout)
      (prep := prep) (nextLayout := nextLayout)
      (lowerStmt := lowerStmt) (lowerRest := lowerRest) hRestLive
      hStmtLive hLiveLayout hPrepare hEntry hAccess hLowerStmt hLowerRest
      hRel hBodyNoCall hBodyScoped hLowerBody hSourceOpen hBreakOuterMode
      hContinueOuterMode hBreakLiveSubset hContinueLiveSubset

private theorem forInit_of_open_block
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {maxFuel : Nat}
    (hCallbacks :
      ScopedNoInternalCallShapeRecursiveOpenBlockOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel)
    {returns : List Name} {liveCtx : Ctx} {after outLayout : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State}
    (hFuelPredLe : fuel.pred ≤ maxFuel)
    (hCtxRel :
      SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hNoDup : targetCtx.layout.Nodup)
    (hSourceNoDup : sourceCtx.scope.Nodup)
    (hReturnsLen : returns.length = retc)
    (hLeaveFrame : SourceDirect.LeaveFrameAvailable sourceCtx hiddenReturns)
    (hReturnScopeRel :
      SourceDirectBridge.LiveReturnScopeRel liveCtx sourceCtx)
    (hReturnsEq : liveCtx.returns = returns)
    {stmt : Stmt} {rest : List Stmt}
    {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
    {prep lowerStmt lowerRest : List Locals.Stmt}
    (_hRestLive : restLive = StmtList.liveBefore liveCtx after rest)
    (_hStmtLive : stmtLive = Stmt.liveBefore liveCtx restLive stmt)
    (hLiveLayout : liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive)
    (hPrepare :
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout))
    (_hEntry : Layout.entryWindowOk? preparedLayout stmtLive = true)
    (_hAccess : StmtAccess.accessible? returns preparedLayout stmt = true)
    (_hLowerStmt :
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout))
    (_hLowerRest :
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout))
    {init post body : Block} {cond : Expr 1}
    (hInitNoCall : NoInternalCall.Block.Holds init)
    (hInitScoped : Scope.Block.Scoped sourceCtx.scope init)
    {cleaned : Locals.RunState}
    (hCleanRel :
      SourceDirect.StateRel preparedLayout hiddenReturns source cleaned)
    {lowerInit : Locals.Block} {loopLayout : List Name}
    {sourceInitResult : Source.Outcome × Source.Ctx}
    (hLowerInit :
      (let cleanedLayout := preparedLayout
       let loopMentioned :=
        NameSet.unions [Reads.expr cond, Reads.block post, Reads.block body,
          restLive]
       let postLive := Block.liveBefore liveCtx loopMentioned post
       let bodyCtx := liveCtx.withLoop restLive postLive
       let bodyLive := Block.liveBefore bodyCtx postLive body
       let loopLive :=
        NameSet.unions [Reads.expr cond, restLive, postLive, bodyLive]
       let initAfter := NameSet.union loopLive cleanedLayout
       Lower.Block.toLocals? returns (liveCtx.withProtectedLayout cleanedLayout) cleanedLayout initAfter init =
        some (lowerInit, loopLayout)))
    (hSourceInit :
      Source.Block.runOpen prim sourceProgram sourceCtx.withoutLoopControl
          fuel.pred init source =
        .ok sourceInitResult) :
    SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
      targetProgram returns retc fuel.pred sourceCtx.withoutLoopControl
      (targetCtx.withLayout preparedLayout).withoutLoopControl
      hiddenReturns init lowerInit source cleaned := by
  let loopMentioned :=
    NameSet.unions [Reads.expr cond, Reads.block post, Reads.block body,
      restLive]
  let postLive := Block.liveBefore liveCtx loopMentioned post
  let bodyCtx := liveCtx.withLoop restLive postLive
  let bodyLive := Block.liveBefore bodyCtx postLive body
  let loopLive := NameSet.unions [Reads.expr cond, restLive, postLive, bodyLive]
  have hInitCtxCleanup :
      SourceDirectBridge.LiveCtxCleanupRel retc sourceCtx.withoutLoopControl
        (targetCtx.withLayout preparedLayout).withoutLoopControl := by
    refine
      { ctxRel := ?_
        breakCleanup := ?_
        continueCleanup := ?_ }
    · have hPreparedCtx :
        SourceDirectBridge.LiveCtxRel retc sourceCtx
            (targetCtx.withLayout preparedLayout) :=
        SourceDirectBridge.LiveCtxRel.withLayout_of_subset hCtxRel
          (by
            intro name hMem
            have hLiveMem := Prepare.forStmtAboveSuffix?_mem hPrepare hMem
            rw [hLiveLayout] at hLiveMem
            exact Layout.mem_trimDeadPrefix hLiveMem)
      simpa [Locals.Ctx.withoutLoopControl] using
        SourceDirectBridge.LiveCtxRel.withoutLoopControl hPreparedCtx
    · intro breakScope targetDepth hBreak _hTargetDepth
      simp [Source.Ctx.withoutLoopControl] at hBreak
    · intro continueScope targetDepth hContinue _hTargetDepth
      simp [Source.Ctx.withoutLoopControl] at hContinue
  have hPreparedNoDup : preparedLayout.Nodup := by
    apply Prepare.forStmtAboveSuffix?_nodup hPrepare
    rw [hLiveLayout]
    exact Layout.trimDeadPrefix_nodup hNoDup
  exact
    hCallbacks.block (returns := returns)
      (liveCtx := liveCtx.withProtectedLayout preparedLayout)
      (after := loopLive) (outLayout := loopLayout) (retc := retc)
      (fuel := fuel.pred) (sourceCtx := sourceCtx.withoutLoopControl)
      (targetCtx := (targetCtx.withLayout preparedLayout).withoutLoopControl)
      (hiddenReturns := hiddenReturns) (block := init)
      (lowerBlock := lowerInit) (source := source) (target := cleaned)
      (sourceResult := sourceInitResult) hFuelPredLe
      (by
        simp [Locals.Ctx.withLayout, Locals.Ctx.withoutLoopControl,
          Ctx.withProtectedLayout, Ctx.withProtectedSuffixDepth,
          Ctx.protectedDepth])
      (by
        simpa [loopMentioned, postLive, bodyCtx, bodyLive, loopLive,
          Checked.scopedAfter, Locals.Ctx.withLayout,
          Locals.Ctx.withoutLoopControl] using hLowerInit)
      hSourceInit
      (by
        simpa [Locals.Ctx.withLayout, Locals.Ctx.withoutLoopControl]
          using hCleanRel)
      hInitNoCall
      (by simpa [Source.Ctx.withoutLoopControl] using hInitScoped)
      (by simpa [Source.Ctx.withoutLoopControl] using hSourceNoDup)
      (SourceDirectBridge.LiveCtxOutcomeCleanupRel.of_cleanupRel
        hInitCtxCleanup)
      (by
        simpa [Locals.Ctx.withLayout, Locals.Ctx.withoutLoopControl]
          using hPreparedNoDup)
      hReturnsLen
      (SourceDirect.LeaveFrameAvailable.withoutLoopControl hLeaveFrame)
      (by
        exact
          liveControlRel_withoutLoopControl_of_returnScope
            (SourceDirectBridge.LiveReturnScopeRel.withProtectedLayout
              preparedLayout hReturnScopeRel))
      (by
        simpa [Ctx.withProtectedLayout, Ctx.withProtectedSuffixDepth,
          SourceDirectBridge.LiveHandlerScopeRel] using
          SourceDirectBridge.LiveHandlerScopeRel.withoutLoopControl)
      (by
        simpa [Ctx.withProtectedLayout, Ctx.withProtectedSuffixDepth]
          using hReturnsEq)

theorem outcomeBodyCallbacks_of_anyEntry_callbacks
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {maxFuel : Nat}
    (hAny :
      ScopedNoInternalCallShapeRecursiveOpenBlockLayoutToOutcomeAnyEntryCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel)
    (hLoopOpenBlock :
      ScopedNoInternalCallShapeRecursiveLoopOpenBlockLayoutToOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel)
    {returns : List Name} {liveCtx : Ctx} {after outLayout : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {sourceResult : Source.Outcome × Source.Ctx}
    (hFuelLe : fuel ≤ maxFuel)
    (hOutcomeCleanup :
      SourceDirectBridge.LiveCtxOutcomeCleanupRel retc sourceCtx targetCtx
        sourceResult.1)
    (hNoDup : targetCtx.layout.Nodup)
    (hSourceNoDup : sourceCtx.scope.Nodup)
    (hReturnsLen : returns.length = retc)
    (hLeaveFrame : SourceDirect.LeaveFrameAvailable sourceCtx hiddenReturns)
    (hControlRel :
      SourceDirectBridge.LiveControlRel liveCtx sourceCtx)
    (hHandlerScope :
      SourceDirectBridge.LiveHandlerScopeRel liveCtx sourceCtx)
    (hReturnsEq : liveCtx.returns = returns) :
    ScopedNoInternalCallShapeOutcomeBodyCallbacks prim sourceProgram
      targetProgram returns liveCtx after outLayout retc fuel sourceCtx
      targetCtx hiddenReturns source sourceResult := by
  have hOpenCallbacks :
      ScopedNoInternalCallShapeRecursiveOpenBlockOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel :=
    ScopedNoInternalCallShapeRecursiveOpenBlockLayoutToOutcomeAnyEntryCallbacksUpToOfLeaveFrame.to_scopedAfter_callbacks
      hAny
  have hCtxRel :
      SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx :=
    SourceDirectBridge.LiveCtxOutcomeCleanupRel.ctxRel hOutcomeCleanup
  have hFuelPredLe : fuel.pred ≤ maxFuel :=
    Nat.le_trans (Nat.pred_le fuel) hFuelLe
  refine
    { blockBody := ?_
      ifBody := ?_
      switchBody := ?_
      forInit := ?_
      forLoop := ?_ }
  · intro body rest restLive stmtLive liveLayout preparedLayout nextLayout
      prep lowerStmt lowerRest hRestLive hStmtLive hLiveLayout hPrepare hEntry
      hAccess hLowerStmt hLowerRest hSourceRun cleaned hCleanRel lowerBody
      bodyLayout sourceOpenResult hBodyNoCall hBodyScoped hLowerBody
      hSourceOpen
    exact
      blockBody_of_open_block_of_outer_outcome_cleanup_of_run
        (prim := prim) hOpenCallbacks (returns := returns)
        (liveCtx := liveCtx) (after := after) (outLayout := outLayout)
        (retc := retc) (fuel := fuel) (sourceCtx := sourceCtx)
        (targetCtx := targetCtx) (hiddenReturns := hiddenReturns)
        (source := source) (sourceResult := sourceResult) (body := body)
        (rest := rest) hFuelLe hSourceRun hOutcomeCleanup hNoDup
        hSourceNoDup hReturnsLen hLeaveFrame hControlRel hHandlerScope
        hReturnsEq hRestLive hStmtLive hLiveLayout hPrepare hEntry hAccess
        hLowerStmt hLowerRest hCleanRel hBodyNoCall hBodyScoped hLowerBody
        hSourceOpen

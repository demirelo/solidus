theorem stmtList_cons_loop_target_result_of_source_run_lower_components_with_layout_to_tail_nextLayout
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns loopLayout : List Name} {liveCtx : Ctx} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx} {baseLayout : List Name}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {rest : List Stmt}
    {stmtLive stmtAfter liveLayout preparedLayout nextLayout : List Name}
    {prep lowerStmt lowerRest : List Locals.Stmt}
    {source : Source.State} {target : Locals.RunState}
    {sourceResult : Source.Outcome × Source.Ctx}
    (hLowerStmt :
      Lower.Stmt.toLocals? returns liveCtx preparedLayout stmtAfter stmt =
        some (lowerStmt, nextLayout))
    (hLiveLayout :
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive)
    (hPrepare :
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout))

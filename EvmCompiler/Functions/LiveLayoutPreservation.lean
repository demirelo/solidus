        exact hBreakTargetLive hMode hDepthBase hMemBase)
      (by
        intro hMode targetDepth hDepth name hName
        have hDepthBase : targetCtx.continueDepth? = some targetDepth := by
          simpa [Locals.Ctx.withLayout] using hDepth
        have hDepthProtected := hContinueDepthProtected hMode hDepthBase
        rcases
            SourceDirectBridge.LiveCtxRel.continueScope_some_of_target
              (SourceDirectBridge.LiveCtxOutcomeCleanupRel.ctxRel
                hPreparedOutcomeCleanup) hDepth with
          ⟨continueScope, hContinueScope⟩
        have hCleanupPrepared :
            SourceDirectBridge.LiveCleanupScopeRel preparedLayout
              targetDepth continueScope :=
          SourceDirectBridge.LiveCtxOutcomeCleanupRel.continueCleanup
            hPreparedOutcomeCleanup hMode hContinueScope hDepth
        have hMemBase :
            name ∈
              targetCtx.layout.drop (targetCtx.layout.length - targetDepth) :=
          SourceDirectBridge.LiveCleanupScopeRel.forStmtAboveSuffix_trimDeadPrefix_suffix_mem
            (hLiveLayout := hLiveLayout) (hPrepare := hPrepare)
            hDepthProtected
            (by
              have hTrim :
                  SourceDirectBridge.LiveCtxOutcomeCleanupRel retc sourceCtx

  have hStmtCleanup :
      SourceDirect.CleanupLayoutRel nextLayout preparedLayout :=
    TargetLayout.Lower.stmt_toLocals?_cleanupLayoutRel hLowerStmt
  have hNameNext :
      name ∈ nextLayout.drop (nextLayout.length - targetDepth) := by
    simpa [hTargetCtxEq, Locals.Ctx.withLayout] using hNameAfter
  have hNamePrepared :
      name ∈ preparedLayout.drop (preparedLayout.length - targetDepth) := by

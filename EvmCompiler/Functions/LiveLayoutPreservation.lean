                      (prim := prim) (sourceProgram := sourceProgram)
                      (targetProgram := targetProgram) (returns := returns)
                      (retc := retc) (sourceFuel := fuel)
                      (targetFuel := bodyTargetFuel)
                      (sourceCtx := sourceCtx) (sourceCtxOut := sourceCtxOut)
                      (targetCtx := targetCtx) (targetCtxOut := targetCtxOut)
                      (hiddenReturns := hiddenReturns)
                      (source := sourceAfterCond) (sourceInner := sourceState)
                      (target := targetAfterCond) (targetInner := targetInner)
                      (block := body) (targetBlock := lowerBody)

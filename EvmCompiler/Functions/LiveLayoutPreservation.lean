            ⟨hStmtScoped, hRestScopedBase⟩
          cases hHeadMode : sourceHead.mode with
          | regular =>
              have hHeadRegular :
                  Source.Stmt.run prim program sourceCtx fuel stmt source =
                    .ok (Source.Outcome.regular sourceHead.state,
                      sourceCtxAfter) := by
                cases sourceHead with
                | mk sourceHeadState sourceHeadMode =>
                    cases sourceHeadMode <;> simp at hHeadMode
                    simpa [Source.Outcome.regular] using hHead
              have hTailRun :
                  Source.Block.runOpen prim program sourceCtxAfter fuel
                      { stmts := rest } sourceHead.state =
                    .ok (Source.Outcome.cont sourceOut, sourceCtxOut) := by
                simpa [hHeadMode] using hTailIf hHeadMode
              have hCtxAfterScope :
                  sourceCtxAfter.scope =
                    Scope.Stmt.outEnv sourceCtx.scope stmt :=
                SourceDirect.SourceRun.stmt_regular_scope hHeadRegular
              have hRestScoped :
                  Scope.StmtList.Scoped sourceCtxAfter.scope rest := by
                simpa [hCtxAfterScope] using hRestScopedBase
              have hTargetHandlerAfter :
                  SourceDirectBridge.LiveTargetHandlerScopeRel sourceCtxAfter
                    targetCtx := by
                constructor
                · intro depth hDepth name hMem
                  rw [hCtxAfterScope]
                  exact
                    SourceDirect.SourceScope.stmt_outEnv_contains_of_contains
                      (stmt := stmt) (hTargetHandler.1 hDepth hMem)
                · intro depth hDepth name hMem
                  rw [hCtxAfterScope]
                  exact
                    SourceDirect.SourceScope.stmt_outEnv_contains_of_contains
                      (stmt := stmt) (hTargetHandler.2 hDepth hMem)
              have hRestLive :
                  name ∈ StmtList.liveBefore live after rest :=
                stmtList_targetContinueSuffix_mem_of_cont_run
                  (live := live) (targetCtx := targetCtx) (stmts := rest)
                  hTargetHandlerAfter hRestScoped hTailRun hTargetLive
                  hTargetDepth hName
              have hScope : name ∈ sourceCtx.scope :=
                hTargetHandler.2 hTargetDepth hName
              have hHeadLive :
                  name ∈ Stmt.liveBefore live
                    (StmtList.liveBefore live after rest) stmt :=
                RegularRunLiveBefore.stmt_after_mem_of_regular_run
                  (live := live) (stmt := stmt) hStmtScoped hHeadRegular
                  hScope hRestLive
              simpa [StmtList.liveBefore] using hHeadLive
          | brk =>
              have hEq := hNonregular (by simp [hHeadMode])
              cases sourceHead with
              | mk sourceHeadState sourceHeadMode =>
                  cases sourceHeadMode <;> simp [Source.Outcome.brk,
                    Source.Outcome.cont] at hHeadMode hEq
                  cases hEq.1
          | cont =>
              have hHeadRun :
                  Source.Stmt.run prim program sourceCtx fuel stmt source =
                    .ok (Source.Outcome.cont sourceHead.state,
                      sourceCtxAfter) := by
                cases sourceHead with
                | mk sourceHeadState sourceHeadMode =>
                    cases sourceHeadMode <;> simp at hHeadMode
                    simpa [Source.Outcome.cont] using hHead
              have hStmtLive :
                  name ∈ Stmt.liveBefore live
                    (StmtList.liveBefore live after rest) stmt :=
                stmt_targetContinueSuffix_mem_of_cont_run
                  (live := live) (targetCtx := targetCtx) (stmt := stmt)
                  (after := StmtList.liveBefore live after rest)
                  hTargetHandler hStmtScoped hHeadRun hTargetLive
                  hTargetDepth hName
              simpa [StmtList.liveBefore] using hStmtLive
          | leave =>
              have hEq := hNonregular (by simp [hHeadMode])
              cases sourceHead with
              | mk sourceHeadState sourceHeadMode =>
                  cases sourceHeadMode <;> simp [Source.Outcome.cont,
                    Source.Outcome.leave] at hHeadMode hEq
                  cases hEq.1
          | halt kind =>
              have hEq := hNonregular (by simp [hHeadMode])
              cases sourceHead with
              | mk sourceHeadState sourceHeadMode =>
                  cases sourceHeadMode <;> simp [Source.Outcome.cont,
                    Source.Outcome.halt] at hHeadMode hEq
                  cases hEq.1
end

end HandlerRunLiveBefore

theorem preparedLayout_cleanupLayoutRel_of_scopedAfter_regular_tail
    {prim : Source.PrimitiveSemantics} {sourceProgram : Program}
    {returns : List Name} {liveCtx : Ctx} {after outLayout : List Name}
    {retc fuel : Nat}
    {sourceCtx sourceHeadCtx sourceCtxAfter sourceTailCtx : Source.Ctx}
    {targetCtx : Locals.Ctx} {stmt : Stmt} {rest : List Stmt}
    {restLive stmtLive liveLayout : List Name}
    {prep : List Locals.Stmt} {preparedLayout nextLayout : List Name}
    {lowerStmt lowerRest : List Locals.Stmt}
    {source sourceHeadState sourceTailState sourceAfter : Source.State}
    (hProtectedEntry : targetCtx.layout.length ≤ liveCtx.protectedDepth)
    (hCtxRel :
      SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hScopedHead : Scope.Stmt.Scoped sourceCtx.scope stmt)
    (hScopedRest :
      Scope.Block.Scoped sourceCtxAfter.scope { stmts := rest })
    (hRestLive :
      restLive =
        StmtList.liveBefore liveCtx
          (Checked.scopedAfter targetCtx.layout after) rest)
    (hStmtLive :
      stmtLive = Stmt.liveBefore liveCtx restLive stmt)
    (hLiveLayout :
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive)
    (hPrepare :
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout))
    (_hEntry : Layout.entryWindowOk? preparedLayout stmtLive = true)
    (_hAccess : StmtAccess.accessible? returns preparedLayout stmt = true)
    (_hLowerStmt :
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout))
    (_hLowerRest :
      Lower.StmtList.toLocals? returns liveCtx nextLayout
          (Checked.scopedAfter targetCtx.layout after) rest =
        some (lowerRest, outLayout))
    (hSourceHead :
      Source.Stmt.run prim sourceProgram sourceCtx fuel stmt source =
        .ok (Source.Outcome.regular sourceHeadState, sourceHeadCtx))
    (hSourceCtxScope :
      sourceCtxAfter.scope = Scope.Stmt.outEnv sourceCtx.scope stmt)
    (hSourceTail :
      Source.Block.runOpen prim sourceProgram sourceCtxAfter fuel
          { stmts := rest } sourceAfter =
        .ok (Source.Outcome.regular sourceTailState, sourceTailCtx)) :
    SourceDirect.CleanupLayoutRel preparedLayout targetCtx.layout := by
  have hLiveCleanup :
      SourceDirect.CleanupLayoutRel liveLayout targetCtx.layout := by
    rw [hLiveLayout]
    exact
      Layout.cleanupLayoutRel_trimDeadPrefix_of_all_mem
        (by
          intro name hNameLayout
          have hNameScope : name ∈ sourceCtx.scope :=
            hCtxRel.1 hNameLayout
          have hNameScopeAfter : name ∈ sourceCtxAfter.scope := by
            rw [hSourceCtxScope]
            exact SourceDirect.SourceScope.stmt_outEnv_contains_of_contains
              (stmt := stmt) hNameScope
          have hNameAfter :
              name ∈ Checked.scopedAfter targetCtx.layout after :=
            Checked.mem_scopedAfter_of_mem_layout hNameLayout
          have hNameRestLive : name ∈ restLive := by
            rw [hRestLive]
            exact
              RegularRunLiveBefore.block_after_mem_of_regular_run
                (live := liveCtx) (block := { stmts := rest })
                (sourceCtx := sourceCtxAfter) hScopedRest hSourceTail
                hNameScopeAfter hNameAfter
          rw [hStmtLive]
          exact
            RegularRunLiveBefore.stmt_after_mem_of_regular_run
              (live := liveCtx) (stmt := stmt)
              (sourceCtx := sourceCtx) hScopedHead hSourceHead hNameScope
              hNameRestLive)
  exact
    Prepare.forStmtAboveSuffix?_cleanupLayoutRel_of_baseDepth
      hPrepare hLiveCleanup hProtectedEntry

theorem preparedLayout_cleanupLayoutRel_of_regular_tail_to_base
    {prim : Source.PrimitiveSemantics} {sourceProgram : Program}
    {returns : List Name} {liveCtx : Ctx} {after baseLayout : List Name}
    {retc fuel : Nat}
    {sourceCtx sourceCtxAfter sourceTailCtx : Source.Ctx}
    {targetCtx : Locals.Ctx} {stmt : Stmt} {rest : List Stmt}
    {restLive stmtLive liveLayout : List Name}
    {prep : List Locals.Stmt} {preparedLayout : List Name}
    {source sourceAfter sourceTailState : Source.State}
    (hEntryBase :
      SourceDirect.CleanupLayoutRel targetCtx.layout baseLayout)
    (hBaseDepth : baseLayout.length ≤ liveCtx.protectedDepth)
    (hAfterContainsBase :
      ∀ {name : Name}, name ∈ baseLayout → name ∈ after)
    (hCtxRel :
      SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hScopedHead : Scope.Stmt.Scoped sourceCtx.scope stmt)
    (hScopedRest :
      Scope.Block.Scoped sourceCtxAfter.scope { stmts := rest })
    (hRestLive :
      restLive = StmtList.liveBefore liveCtx after rest)
    (hStmtLive :
      stmtLive = Stmt.liveBefore liveCtx restLive stmt)
    (hLiveLayout :
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive)
    (hPrepare :
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout))
    (hSourceHead :
      Source.Stmt.run prim sourceProgram sourceCtx fuel stmt source =
        .ok (Source.Outcome.regular sourceAfter, sourceCtxAfter))
    (hSourceCtxScope :
      sourceCtxAfter.scope = Scope.Stmt.outEnv sourceCtx.scope stmt)
    (hSourceTail :
      Source.Block.runOpen prim sourceProgram sourceCtxAfter fuel
          { stmts := rest } sourceAfter =
        .ok (Source.Outcome.regular sourceTailState, sourceTailCtx)) :
    SourceDirect.CleanupLayoutRel preparedLayout baseLayout := by
  have hBaseMemEntry :
      ∀ {name : Name}, name ∈ baseLayout → name ∈ targetCtx.layout := by
    intro name hName
    have hDrop :
        targetCtx.layout.drop (targetCtx.layout.length - baseLayout.length) =
          baseLayout := hEntryBase
    rw [← hDrop] at hName
    exact List.mem_of_mem_drop hName
  have hBaseMemStmtLive :
      ∀ {name : Name}, name ∈ baseLayout → name ∈ stmtLive := by
    intro name hName
    have hNameScope : name ∈ sourceCtx.scope :=
      hCtxRel.1 (hBaseMemEntry hName)
    have hNameScopeAfter : name ∈ sourceCtxAfter.scope := by
      rw [hSourceCtxScope]
      exact SourceDirect.SourceScope.stmt_outEnv_contains_of_contains
        (stmt := stmt) hNameScope
    have hNameRestLive : name ∈ restLive := by
      rw [hRestLive]
      exact
        RegularRunLiveBefore.block_after_mem_of_regular_run
          (live := liveCtx) (block := { stmts := rest })
          (sourceCtx := sourceCtxAfter) hScopedRest hSourceTail
          hNameScopeAfter (hAfterContainsBase hName)
    rw [hStmtLive]
    exact
      RegularRunLiveBefore.stmt_after_mem_of_regular_run
        (live := liveCtx) (stmt := stmt)
        (sourceCtx := sourceCtx) hScopedHead hSourceHead hNameScope
        hNameRestLive
  have hTrimBase :
      Layout.trimDeadPrefix baseLayout stmtLive = baseLayout :=
    Layout.trimDeadPrefix_eq_self_of_all_mem hBaseMemStmtLive
  have hLiveCleanup :
      SourceDirect.CleanupLayoutRel liveLayout baseLayout := by
    have hTrimRel :
        SourceDirect.CleanupLayoutRel
          (Layout.trimDeadPrefix targetCtx.layout stmtLive)
          (Layout.trimDeadPrefix baseLayout stmtLive) :=
      Layout.cleanupLayoutRel_trimDeadPrefix_of_cleanupLayoutRel
        (layout := targetCtx.layout) (base := baseLayout)
        (live := stmtLive) hEntryBase
    simpa [hLiveLayout, hTrimBase] using hTrimRel
  exact
    Prepare.forStmtAboveSuffix?_cleanupLayoutRel_of_baseDepth
      hPrepare hLiveCleanup hBaseDepth

theorem preparedLayout_cleanupLayoutRel_of_block_scopedAfter_regular_tail
    {prim : Source.PrimitiveSemantics} {sourceProgram : Program}
    {returns : List Name} {liveCtx : Ctx} {after outLayout : List Name}
    {retc fuel : Nat}
    {sourceCtx sourceCtxAfter : Source.Ctx} {targetCtx : Locals.Ctx}
    {block : Block} {stmt : Stmt} {rest : List Stmt}
    {restLive stmtLive liveLayout : List Name}
    {prep : List Locals.Stmt} {preparedLayout nextLayout : List Name}
    {lowerStmt lowerRest : List Locals.Stmt}
    {source sourceAfter : Source.State}
    {sourceHeadResult sourceTailResult : Source.Outcome × Source.Ctx}
    (hProtectedEntry : targetCtx.layout.length ≤ liveCtx.protectedDepth)
    (hCtxRel :
      SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hScopedBlock : Scope.Block.Scoped sourceCtx.scope block)
    (hRestLive :
      restLive =
        StmtList.liveBefore liveCtx
          (Checked.scopedAfter targetCtx.layout after) rest)
    (hStmtLive :
      stmtLive = Stmt.liveBefore liveCtx restLive stmt)
    (hLiveLayout :
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive)
    (hPrepare :
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout))
    (hEntry : Layout.entryWindowOk? preparedLayout stmtLive = true)
    (hAccess : StmtAccess.accessible? returns preparedLayout stmt = true)
    (hLowerStmt :
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout))
    (hLowerRest :
      Lower.StmtList.toLocals? returns liveCtx nextLayout
          (Checked.scopedAfter targetCtx.layout after) rest =
        some (lowerRest, outLayout))
    (hCons : block.stmts = stmt :: rest)
    (hSourceHead :
      Source.Stmt.run prim sourceProgram sourceCtx fuel stmt source =
        .ok sourceHeadResult)
    (hHeadMode : sourceHeadResult.1.mode = .regular)
    (hSourceCtxScope :
      sourceCtxAfter.scope = Scope.Stmt.outEnv sourceCtx.scope stmt)
    (hSourceTail :
      Source.Block.runOpen prim sourceProgram sourceCtxAfter fuel
          { stmts := rest } sourceAfter =
        .ok sourceTailResult)
    (hTailMode : sourceTailResult.1.mode = .regular) :
    SourceDirect.CleanupLayoutRel preparedLayout targetCtx.layout := by
  have hScopedCons :
      Scope.Block.Scoped sourceCtx.scope { stmts := stmt :: rest } := by
    cases block with
    | mk stmts =>
        simp at hCons
        subst stmts
        simpa using hScopedBlock
  rcases SourceScopeFacts.block_scoped_cons hScopedCons with
    ⟨hScopedHead, hScopedRestBase⟩
  have hScopedRest :
      Scope.Block.Scoped sourceCtxAfter.scope { stmts := rest } := by
    simpa [hSourceCtxScope] using hScopedRestBase
  rcases sourceHeadResult with ⟨sourceHeadOutcome, sourceHeadCtx⟩
  cases sourceHeadOutcome with
  | mk sourceHeadState sourceHeadMode =>
      cases sourceHeadMode <;> simp at hHeadMode
      rcases sourceTailResult with ⟨sourceTailOutcome, sourceTailCtx⟩
      cases sourceTailOutcome with
      | mk sourceTailState sourceTailMode =>
          cases sourceTailMode <;> simp at hTailMode
          exact
            preparedLayout_cleanupLayoutRel_of_scopedAfter_regular_tail
              (prim := prim) (sourceProgram := sourceProgram)
              (returns := returns) (liveCtx := liveCtx) (after := after)
              (outLayout := outLayout) (retc := retc) (fuel := fuel)
              (sourceCtx := sourceCtx) (sourceHeadCtx := sourceHeadCtx)
              (sourceCtxAfter := sourceCtxAfter)
              (sourceTailCtx := sourceTailCtx) (targetCtx := targetCtx)
              (stmt := stmt) (rest := rest) (restLive := restLive)
              (stmtLive := stmtLive) (liveLayout := liveLayout)
              (prep := prep) (preparedLayout := preparedLayout)
              (nextLayout := nextLayout) (lowerStmt := lowerStmt)
              (lowerRest := lowerRest) (source := source)
              (sourceHeadState := sourceHeadState)
              (sourceTailState := sourceTailState)
              (sourceAfter := sourceAfter) hProtectedEntry hCtxRel
              hScopedHead hScopedRest hRestLive hStmtLive hLiveLayout hPrepare
              hEntry hAccess hLowerStmt hLowerRest
              (by simpa [Source.Outcome.regular] using hSourceHead)
              hSourceCtxScope
              (by simpa [Source.Outcome.regular] using hSourceTail)

theorem tail_outcomeCleanup_of_regular_head
    {prim : Source.PrimitiveSemantics} {sourceProgram : Program}
    {returns : List Name} {liveCtx : Ctx} {after outLayout : List Name}
    {retc fuel : Nat}
    {sourceCtx sourceCtxAfter : Source.Ctx}
    {targetCtx targetCtxAfter : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {stmt : Stmt} {rest : List Stmt}
    {restLive stmtLive liveLayout : List Name}
    {prep : List Locals.Stmt} {preparedLayout nextLayout : List Name}
    {lowerStmt lowerRest : List Locals.Stmt}
    {source sourceAfter : Source.State}
    {sourceResult sourceHeadResult sourceTailResult :
      Source.Outcome × Source.Ctx}
    (hOutcomeCleanup :
      SourceDirectBridge.LiveCtxOutcomeCleanupRel retc sourceCtx targetCtx
        sourceResult.1)
    (hScopedHead : Scope.Stmt.Scoped sourceCtx.scope stmt)
    (hScopedRest :
      Scope.Block.Scoped sourceCtxAfter.scope { stmts := rest })
    (hRestLive :
      restLive = StmtList.liveBefore liveCtx after rest)
    (hStmtLive :
      stmtLive = Stmt.liveBefore liveCtx restLive stmt)
    (hLiveLayout :
      liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive)
    (hPrepare :
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout))
    (hLowerStmt :
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout))
    (hSourceRun :
      Source.Block.runOpen prim sourceProgram sourceCtx (fuel + 1)
          { stmts := stmt :: rest } source =
        .ok sourceResult)
    (hSourceHead :
      Source.Stmt.run prim sourceProgram sourceCtx fuel stmt source =
        .ok sourceHeadResult)
    (hHeadEq :
      sourceHeadResult = (Source.Outcome.regular sourceAfter, sourceCtxAfter))
    (hTargetCtxEq : targetCtxAfter = targetCtx.withLayout nextLayout)
    (hSourceTail :
      Source.Block.runOpen prim sourceProgram sourceCtxAfter fuel
          { stmts := rest } sourceAfter =
        .ok sourceTailResult)
    (hTailCtx :
      SourceDirectBridge.LiveCtxRel retc sourceCtxAfter targetCtxAfter)
    (hNoDup : targetCtx.layout.Nodup)
    (hControlRel :
      SourceDirectBridge.LiveControlRel liveCtx sourceCtx)
    (hHandlerScope :
      SourceDirectBridge.LiveHandlerScopeRel liveCtx sourceCtx) :
    SourceDirectBridge.LiveCtxOutcomeCleanupRel retc sourceCtxAfter
      targetCtxAfter sourceTailResult.1 := by
  have hHeadRegular :
      Source.Stmt.run prim sourceProgram sourceCtx fuel stmt source =
        .ok (Source.Outcome.regular sourceAfter, sourceCtxAfter) := by
    simpa [hHeadEq] using hSourceHead
  have hHandlerAfter :
      SourceDirectBridge.LiveHandlerScopeRel liveCtx sourceCtxAfter :=
    SourceDirectBridge.LiveHandlerScopeRel.stmt_regular hHandlerScope
      hHeadRegular
  have hStmtCleanup :
      SourceDirect.CleanupLayoutRel nextLayout preparedLayout :=
    TargetLayout.Lower.stmt_toLocals?_cleanupLayoutRel hLowerStmt
  have hLiveNoDup : liveLayout.Nodup := by
    rw [hLiveLayout]
    exact Layout.trimDeadPrefix_nodup hNoDup
  refine ⟨hTailCtx, ?_⟩
  rcases sourceTailResult with ⟨sourceTailOutcome, sourceTailCtx⟩
  rcases sourceTailOutcome with ⟨sourceTailState, sourceTailMode⟩
  cases sourceTailMode <;> simp
  · intro breakScope targetDepth hBreakAfter hTargetDepthAfter
    have hTailBrk :
        Source.Block.runOpen prim sourceProgram sourceCtxAfter fuel
            { stmts := rest } sourceAfter =
          .ok (Source.Outcome.brk sourceTailState, sourceTailCtx) := by
      simpa [Source.Outcome.brk] using hSourceTail
    have hOuterTailRun :
        Source.Block.runOpen prim sourceProgram sourceCtxAfter fuel
            { stmts := rest } sourceAfter =
          .ok sourceResult := by
      simpa [Source.Block.runOpen, hHeadRegular, Source.Outcome.regular,
        Locals.Source.Outcome.regular] using hSourceRun
    have hSourceResultEq :
        (Source.Outcome.brk sourceTailState, sourceTailCtx) =
          sourceResult := by
      simpa [hTailBrk] using hOuterTailRun
    have hOuterMode : sourceResult.1.mode = .brk := by
      rw [← hSourceResultEq]
      rfl
    have hBreakBefore : sourceCtx.breakScope? = some breakScope := by
      rw [← SourceDirect.SourceRun.stmt_regular_breakScope hHeadRegular]
      exact hBreakAfter
    have hTargetDepthBefore :
        targetCtx.breakDepth? = some targetDepth := by
      simpa [hTargetCtxEq, Locals.Ctx.withLayout] using hTargetDepthAfter
    have hBase :
        SourceDirectBridge.LiveCleanupScopeRel targetCtx.layout targetDepth
          breakScope :=
      SourceDirectBridge.LiveCtxOutcomeCleanupRel.breakCleanup
        hOutcomeCleanup hOuterMode hBreakBefore hTargetDepthBefore
    have hBreakLiveBeforeRest :
        ∀ {name : Name}, name ∈ liveCtx.breakLive → name ∈ restLive := by
      intro name hName
      have hMem :=
        (HandlerRunLiveBefore.block_breakLive_mem_of_brk_run
          (live := liveCtx) (after := after) hHandlerAfter hScopedRest
          hTailBrk).2 hName
      simpa [Block.liveBefore, hRestLive] using hMem
    have hBreakLiveBeforeStmt :
        ∀ {name : Name}, name ∈ liveCtx.breakLive → name ∈ stmtLive := by
      intro name hName
      rw [hStmtLive]
      have hSourceScope : name ∈ sourceCtx.scope :=
        hHandlerScope.1 breakScope hBreakBefore name hName
      exact
        RegularRunLiveBefore.stmt_after_mem_of_regular_run
          (live := liveCtx) (after := restLive) hScopedHead hHeadRegular
          hSourceScope (hBreakLiveBeforeRest hName)
    have hTrim :
        SourceDirectBridge.LiveCleanupScopeRel liveLayout targetDepth
          breakScope := by
      rw [hLiveLayout]
      exact
        SourceDirectBridge.LiveCleanupScopeRel.trimDeadPrefix_of_keep hBase
          (by
            intro name hName
            exact
              hBreakLiveBeforeStmt
                (((hControlRel.1 breakScope hBreakBefore).2 name).mpr
                  (hBase.2 hName)))
    have hDepth : targetDepth ≤ liveCtx.protectedDepth := by
      have hDepthLive :
          targetDepth ≤ liveCtx.breakLive.length :=
        SourceDirectBridge.LiveCleanupScopeRel.depth_le_live_length_of_nodup_sameScope
          hTrim hLiveNoDup (hControlRel.1 breakScope hBreakBefore)
      simp [Ctx.protectedDepth]
      omega
    have hPrepared :
        SourceDirectBridge.LiveCleanupScopeRel preparedLayout targetDepth
          breakScope :=
      SourceDirectBridge.LiveCleanupScopeRel.forStmtAboveSuffix_of_depth_bound
        hPrepare hTrim hDepth
    have hNext :
        SourceDirectBridge.LiveCleanupScopeRel nextLayout targetDepth
          breakScope :=
      SourceDirectBridge.LiveCleanupScopeRel.of_cleanupLayoutRel hStmtCleanup
        hPrepared
    simpa [hTargetCtxEq, Locals.Ctx.withLayout] using hNext
  · intro continueScope targetDepth hContinueAfter hTargetDepthAfter
    have hTailCont :
        Source.Block.runOpen prim sourceProgram sourceCtxAfter fuel
            { stmts := rest } sourceAfter =
          .ok (Source.Outcome.cont sourceTailState, sourceTailCtx) := by
      simpa [Source.Outcome.cont] using hSourceTail
    have hOuterTailRun :
        Source.Block.runOpen prim sourceProgram sourceCtxAfter fuel
            { stmts := rest } sourceAfter =
          .ok sourceResult := by
      simpa [Source.Block.runOpen, hHeadRegular, Source.Outcome.regular,
        Locals.Source.Outcome.regular] using hSourceRun
    have hSourceResultEq :
        (Source.Outcome.cont sourceTailState, sourceTailCtx) =
          sourceResult := by
      simpa [hTailCont] using hOuterTailRun
    have hOuterMode : sourceResult.1.mode = .cont := by
      rw [← hSourceResultEq]
      rfl
    have hContinueBefore :
        sourceCtx.continueScope? = some continueScope := by
      rw [← SourceDirect.SourceRun.stmt_regular_continueScope hHeadRegular]
      exact hContinueAfter
    have hTargetDepthBefore :
        targetCtx.continueDepth? = some targetDepth := by
      simpa [hTargetCtxEq, Locals.Ctx.withLayout] using hTargetDepthAfter
    have hBase :
        SourceDirectBridge.LiveCleanupScopeRel targetCtx.layout targetDepth
          continueScope :=
      SourceDirectBridge.LiveCtxOutcomeCleanupRel.continueCleanup
        hOutcomeCleanup hOuterMode hContinueBefore hTargetDepthBefore
    have hContinueLiveBeforeRest :
        ∀ {name : Name}, name ∈ liveCtx.continueLive → name ∈ restLive := by
      intro name hName
      have hMem :=
        (HandlerRunLiveBefore.block_continueLive_mem_of_cont_run
          (live := liveCtx) (after := after) hHandlerAfter hScopedRest
          hTailCont).2 hName
      simpa [Block.liveBefore, hRestLive] using hMem
    have hContinueLiveBeforeStmt :
        ∀ {name : Name}, name ∈ liveCtx.continueLive → name ∈ stmtLive := by
      intro name hName
      rw [hStmtLive]
      have hSourceScope : name ∈ sourceCtx.scope :=
        hHandlerScope.2 continueScope hContinueBefore name hName
      exact
        RegularRunLiveBefore.stmt_after_mem_of_regular_run
          (live := liveCtx) (after := restLive) hScopedHead hHeadRegular
          hSourceScope (hContinueLiveBeforeRest hName)
    have hTrim :
        SourceDirectBridge.LiveCleanupScopeRel liveLayout targetDepth
          continueScope := by
      rw [hLiveLayout]
      exact
        SourceDirectBridge.LiveCleanupScopeRel.trimDeadPrefix_of_keep hBase
          (by

                      hTargetBlock, hResultRel,
                      by simp [SourceDirectBridge.LiveStmtRegularLayoutRelTo]⟩
              | leave =>
                  have hNonregular :
                      ({ state := sourceState,
                          mode := Locals.Source.Mode.leave } :
                        Source.Outcome).mode ≠ .regular := by
                    simp
                  have hTargetNonregular :

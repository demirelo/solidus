                      (targetFuel := bodyTargetFuel)
                      (sourceCtx := sourceCtx) (sourceCtxOut := sourceCtxOut)
                      (targetCtx := targetCtx) (targetCtxOut := targetCtxOut)
                      (hiddenReturns := hiddenReturns)
                      (source := sourceAfterCond) (target := targetAfterCond)
                      (sourceOutcome :=
                        { state := sourceState,
                          mode := Locals.Source.Mode.leave })
                      (targetOutcome := targetOutcome) (block := body)
                      (targetBlock := lowerBody)
                      hSourceOpen hTargetOpen hOpenRel hNonregular with

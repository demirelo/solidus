theorem expr_liveStmtRunBridge {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source sourceAfterExpr : Source.State}
    {target : Locals.RunState}
    {expr : Expr 0} {values : List Word}
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hNoDup : targetCtx.layout.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned expr)
    (hAccess :
      Locals.SourceLowering.Expr.Accessible targetCtx.layout 0 expr)
    (hRel : SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hEval :
      Source.Expr.eval prim expr source = .ok (sourceAfterExpr, values)) :
    SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
      returns retc fuel sourceCtx targetCtx hiddenReturns (.expr expr)
      { stmts := [Locals.Stmt.expr expr] } source target := by
  have hValuesLen : values.length = 0 :=
    Locals.SourceLowering.Expr.eval_length_of_sourceOwned hPrim hOwned hEval
  have hValuesNil : values = [] := by
    cases values with
    | nil => rfl
    | cons head tail =>
        simp at hValuesLen
  rcases SourceDirect.Expr.eval_bridge_sourceOwned hPrim
      (layout := targetCtx.layout)
      (hiddenReturns := hiddenReturns) (source := source)
      (source' := sourceAfterExpr) (values := values)
      (target := target) (ctx := targetCtx)
      rfl hNoDup hOwned hAccess hRel hEval with
    ⟨evm, hTargetExpr, hExprRel⟩
  let targetAfter := target.withEVM evm
  have hTargetRunState :
      Locals.Direct.Expr.runState targetCtx expr target =
        .ok targetAfter := by
    simp [Locals.Direct.Expr.runState, hTargetExpr, targetAfter]
  have hTargetStmt :
      Locals.Direct.Stmt.run targetProgram targetCtx 0 (.expr expr) target =
        .ok (Structured.Outcome.regular targetAfter, targetCtx) := by
    simp [Locals.Direct.Stmt.run, hTargetRunState]
  rcases Target.runOpen_singleton_regular_exists
      (program := targetProgram) hTargetStmt with
    ⟨targetFuel, hTargetBlock⟩
  have hExprRelNil :
      SourceDirect.ExprResultRel targetCtx.layout hiddenReturns sourceAfterExpr
        [] targetAfter := by
    simpa [hValuesNil, targetAfter] using hExprRel
  have hStateRel :
      SourceDirect.StateRel targetCtx.layout hiddenReturns sourceAfterExpr
        targetAfter :=
    SourceDirect.ExprResultRel.to_stateRel_nil hExprRelNil
  refine
    ⟨(Source.Outcome.regular sourceAfterExpr, sourceCtx), targetFuel,
      (Structured.Outcome.regular targetAfter, targetCtx), ?_, ?_, ?_⟩
  · simp [Source.Stmt.run, hEval]
  · exact hTargetBlock
  · exact SourceDirectBridge.LiveStmtRunResultRel.regular hStateRel hCtx

theorem let_liveStmtRunBridge {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name} {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source sourceAfterValue : Source.State}
    {target : Locals.RunState}
    {name : Name} {value : Word} {expr : Expr 1}
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hNoDup : targetCtx.layout.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned expr)
    (hAccess :
      Locals.SourceLowering.Expr.Accessible targetCtx.layout 0 expr)
    (hFresh : name ∉ sourceCtx.scope)
    (hRel : SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hEvalOne :
      Source.Expr.evalOne prim expr source = .ok (sourceAfterValue, value)) :
    SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
      returns retc fuel sourceCtx targetCtx hiddenReturns (.let_ name expr)
      { stmts := [Locals.Stmt.let_ name expr] } source target := by
  have hFreshTarget : name ∉ targetCtx.layout := by
    intro hMem
    exact hFresh (hCtx.1 hMem)
  rcases SourceDirect.Expr.evalOne_bridge_sourceOwned hPrim
      (layout := targetCtx.layout)
      (hiddenReturns := hiddenReturns) (source := source)
      (source' := sourceAfterValue) (target := target) (ctx := targetCtx)
      rfl hNoDup hOwned hAccess hRel hEvalOne with
    ⟨evm, hTargetExpr, hExprRel⟩
  let targetAfter := target.withEVM evm
  let sourceCtxOut : Source.Ctx :=
    { sourceCtx with scope := name :: sourceCtx.scope }
  let targetCtxOut : Locals.Ctx :=
    targetCtx.withLayout (name :: targetCtx.layout)
  have hTargetRunState :
      Locals.Direct.Expr.runState targetCtx expr target =
        .ok targetAfter := by
    simp [Locals.Direct.Expr.runState, hTargetExpr, targetAfter]
  have hTargetStmt :
      Locals.Direct.Stmt.run targetProgram targetCtx 0 (.let_ name expr)
          target =
        .ok (Structured.Outcome.regular targetAfter, targetCtxOut) := by
    simp [Locals.Direct.Stmt.run, hTargetRunState, targetCtxOut]
  rcases Target.runOpen_singleton_regular_exists
      (program := targetProgram) hTargetStmt with
    ⟨targetFuel, hTargetBlock⟩
  have hStateRel :
      SourceDirect.StateRel (name :: targetCtx.layout) hiddenReturns
        (sourceAfterValue.insert name value) targetAfter :=
    SourceDirect.ExprResultRel.to_stateRel_cons_insert hFreshTarget hExprRel
  refine
    ⟨(Source.Outcome.regular (sourceAfterValue.insert name value),
        sourceCtxOut),
      targetFuel,
      (Structured.Outcome.regular targetAfter, targetCtxOut), ?_, ?_, ?_⟩
  · simp [Source.Stmt.run, hEvalOne, sourceCtxOut]
  · exact hTargetBlock
  · exact
      SourceDirectBridge.LiveStmtRunResultRel.regular hStateRel
        (by simpa [sourceCtxOut, targetCtxOut] using
          SourceDirectBridge.LiveCtxRel.withScopeCons (name := name) hCtx)


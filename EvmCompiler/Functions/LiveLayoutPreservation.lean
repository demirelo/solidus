        have hDepthProtected := hBreakDepthProtected hMode hDepthBase
        have hDepthLive : targetDepth ≤ liveLayout.length := by
          have hTrim :
              SourceDirectBridge.LiveCtxOutcomeCleanupRel retc sourceCtx

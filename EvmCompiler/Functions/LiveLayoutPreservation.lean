        intro hMode targetDepth hDepth name hName
        have hDepthBase : targetCtx.breakDepth? = some targetDepth := by
          simpa [Locals.Ctx.withLayout] using hDepth
        have hDepthProtected := hBreakDepthProtected hMode hDepthBase
        rcases
            SourceDirectBridge.LiveCtxRel.breakScope_some_of_target
              (SourceDirectBridge.LiveCtxOutcomeCleanupRel.ctxRel

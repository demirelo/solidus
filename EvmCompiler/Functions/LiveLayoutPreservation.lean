    (hBreakDepthProtected :
      sourceResult.1.mode = .brk →
        ∀ {targetDepth},
          targetCtx.breakDepth? = some targetDepth →
            targetDepth ≤ liveCtx.protectedDepth)
    (hContinueDepthProtected :
      sourceResult.1.mode = .cont →
        ∀ {targetDepth},
          targetCtx.continueDepth? = some targetDepth →
            targetDepth ≤ liveCtx.protectedDepth)
    (hBreakTargetLive :
      sourceResult.1.mode = .brk →
        ∀ {targetDepth},
          targetCtx.breakDepth? = some targetDepth →
            ∀ {name : Name},
              name ∈
                  targetCtx.layout.drop
                    (targetCtx.layout.length - targetDepth) →

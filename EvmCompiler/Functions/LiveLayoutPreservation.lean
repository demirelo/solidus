theorem assign_returns {program : Locals.Program} {ctx : Locals.Ctx}
    {fuel : Nat} {name : Name} {expr : Expr 1}
    {state : Locals.RunState} {targetAfter : Locals.RunState}
    (hRun :
      Locals.Direct.Stmt.run program ctx fuel (.assign name expr) state =
        .ok (Structured.Outcome.regular targetAfter, ctx)) :
    targetAfter.returns = state.returns := by
  unfold Locals.Direct.Stmt.run at hRun
  cases hDepth : Locals.Layout.lookupDepth? name ctx.layout with
  | none =>
      simp [hDepth, Locals.invalid, Structured.invalid] at hRun
  | some depth =>
      cases hSwap? : Locals.StackOp.swap? depth with
      | none =>
          simp [hDepth, hSwap?, Locals.invalid, Structured.invalid] at hRun
      | some swapOp =>
          simp [hDepth, hSwap?] at hRun
          cases hExpr : Locals.Direct.Expr.runCode ctx 0 expr state.evm with
          | error err =>
              simp [hExpr] at hRun
          | ok evmAfterValue =>
              cases hSwap : swapOp.step evmAfterValue with
              | error err =>
                  simp [hExpr, hSwap] at hRun
              | ok evmAfterSwap =>
                  cases hPop :
                      Structured.BasicOp.pop.step evmAfterSwap with
                  | error err =>
                      simp [hExpr, hSwap, hPop] at hRun
                  | ok evmAfterPop =>
                      simp [hExpr, hSwap, hPop] at hRun
                      cases hRun
                      rfl

end Target

theorem cleanupToLive_empty_block_bridge
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {retc : Nat} {returns live : List Name}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (hStateRel :
      SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hCtxRel :
      SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx) :
    ∃ targetResult targetFuel,
      Source.Block.runOpen prim sourceProgram sourceCtx 1 { stmts := [] }
          source =
        .ok (Source.Outcome.regular source, sourceCtx) ∧
      Locals.Direct.Block.runOpen targetProgram targetCtx targetFuel
          { stmts := [Lower.cleanupToLive targetCtx.layout live] } target =
        .ok targetResult ∧
      SourceDirectBridge.LiveBlockOpenResultRel retc returns hiddenReturns
        (Source.Outcome.regular source, sourceCtx) targetResult := by
  rcases Target.cleanupToLive_runOpen_exists
      (program := targetProgram) (ctx := targetCtx) (live := live)
      hStateRel with
    ⟨cleaned, cleanupFuel, hCleanup, hCleanRel⟩
  let targetResult :=
    (Structured.Outcome.regular cleaned,
      targetCtx.withLayout (Layout.trimDeadPrefix targetCtx.layout live))
  refine ⟨targetResult, cleanupFuel, ?_, ?_, ?_⟩
  · simp [Source.Block.runOpen]
  · simpa [targetResult] using hCleanup
  · exact
      SourceDirectBridge.LiveBlockOpenResultRel.regular
        hCleanRel
        (SourceDirectBridge.LiveCtxRel.cleanupTo_trimDeadPrefix hCtxRel)

theorem cleanupToLive_empty_block_runBridge
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {retc : Nat} {returns live : List Name}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (hStateRel :
      SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hCtxRel :
      SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx) :
    SourceDirectBridge.LiveBlockOpenRunBridge prim sourceProgram
      targetProgram returns retc 1 sourceCtx targetCtx hiddenReturns
      { stmts := [] } { stmts := [Lower.cleanupToLive targetCtx.layout live] }
      source target := by
  rcases cleanupToLive_empty_block_bridge
      (prim := prim) (sourceProgram := sourceProgram)
      (targetProgram := targetProgram) (retc := retc) (returns := returns)
      (live := live) hStateRel hCtxRel with
    ⟨targetResult, targetFuel, hSourceRun, hTargetRun, hResultRel⟩
  exact ⟨(Source.Outcome.regular source, sourceCtx), targetFuel,
    targetResult, hSourceRun, hTargetRun, hResultRel⟩

theorem cleanupToLive_empty_block_runBridge_with_layout
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {retc : Nat} {returns live : List Name}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    (hStateRel :
      SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hCtxRel :
      SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hLayout :
      SourceDirect.CleanupLayoutRel
        (Layout.trimDeadPrefix targetCtx.layout live) targetCtx.layout) :
    SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
      targetProgram returns retc 1 sourceCtx targetCtx hiddenReturns
      { stmts := [] } { stmts := [Lower.cleanupToLive targetCtx.layout live] }
      source target := by
  rcases Target.cleanupToLive_runOpen_exists
      (program := targetProgram) (ctx := targetCtx) (live := live)
      hStateRel with
    ⟨cleaned, cleanupFuel, hCleanup, hCleanRel⟩
  let targetResult :=
    (Structured.Outcome.regular cleaned,
      targetCtx.withLayout (Layout.trimDeadPrefix targetCtx.layout live))

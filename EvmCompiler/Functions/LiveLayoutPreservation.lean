    (hContinueTargetLive :
      sourceOpenResult.1.mode = .cont →
        ∀ {targetDepth},
          targetCtx.continueDepth? = some targetDepth →
            ∀ {name : Name},
              name ∈
                  targetCtx.layout.drop
                    (targetCtx.layout.length - targetDepth) →

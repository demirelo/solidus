    (hBreak : sourceCtx.breakScope? = some breakScope)
    (hCleanupScope :
      ∀ {targetDepth},
        targetCtx.breakDepth? = some targetDepth →
          SourceDirectBridge.LiveCleanupScopeRel targetCtx.layout targetDepth

  exact
    { shape := ScopedNoInternalCallShapeRecursiveCallbacksUpTo.zero
      openBlock :=
        ScopedNoInternalCallShapeRecursiveOpenBlockLayoutToOutcomeCallbacksUpToOfLeaveFrame.zero

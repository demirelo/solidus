    ∃ targetAfterCond,
      Source.Expr.evalCondition prim cond source =
        .ok (sourceAfterCond, truth) ∧
      Locals.Direct.Expr.runCondition targetLoopCtx cond target =
        .ok (targetAfterCond, truth) ∧
      SourceDirect.StateRel targetLoopCtx.layout hiddenReturns sourceAfterCond

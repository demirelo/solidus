theorem stmtList_targetBreakSuffix_mem_of_brk_run
    {prim : Source.PrimitiveSemantics} {program : Program}
    {live : Ctx} {sourceCtx sourceCtxOut : Source.Ctx}
    {targetCtx : Locals.Ctx}
    {fuel targetDepth : Nat} {stmts : List Stmt}
    {source sourceOut : Source.State}
    {after : List Name} {name : Name}
    (hTargetHandler :
      SourceDirectBridge.LiveTargetHandlerScopeRel sourceCtx targetCtx)
    (hScoped : Scope.StmtList.Scoped sourceCtx.scope stmts)
    (hRun :
      Source.Block.runOpen prim program sourceCtx fuel { stmts := stmts }
          source =
        .ok (Source.Outcome.brk sourceOut, sourceCtxOut))
    (hTargetLive :
      ∀ {depth : Nat},
        targetCtx.breakDepth? = some depth →
          ∀ {name : Name},
            name ∈ targetCtx.layout.drop
                (targetCtx.layout.length - depth) →
              name ∈ live.breakLive)
    (hTargetDepth : targetCtx.breakDepth? = some targetDepth)
    (hName :
      name ∈ targetCtx.layout.drop
        (targetCtx.layout.length - targetDepth)) :
    name ∈ StmtList.liveBefore live after stmts := by
  cases stmts with
  | nil =>
      cases fuel with
      | zero =>
          simp [Source.Block.runOpen, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          simp [Source.Block.runOpen, Source.Outcome.regular,
            Source.Outcome.brk] at hRun
          cases hRun.1
  | cons stmt rest =>
      cases fuel with
      | zero =>
          simp [Source.Block.runOpen, Source.invalid, Structured.invalid] at hRun
      | succ fuel =>
          rcases SourceDirect.Block.source_runOpen_cons_head
              (fuel := fuel) hRun with
            ⟨sourceHead, sourceCtxAfter, hHead, hTailIf, hNonregular⟩
          rcases SourceScopeFacts.stmtList_scoped_cons hScoped with
            ⟨hStmtScoped, hRestScopedBase⟩
          cases hHeadMode : sourceHead.mode with
          | regular =>
              have hHeadRegular :
                  Source.Stmt.run prim program sourceCtx fuel stmt source =
                    .ok (Source.Outcome.regular sourceHead.state,
                      sourceCtxAfter) := by
                cases sourceHead with
                | mk sourceHeadState sourceHeadMode =>
                    cases sourceHeadMode <;> simp at hHeadMode
                    simpa [Source.Outcome.regular] using hHead
              have hTailRun :
                  Source.Block.runOpen prim program sourceCtxAfter fuel
                      { stmts := rest } sourceHead.state =
                    .ok (Source.Outcome.brk sourceOut, sourceCtxOut) := by
                simpa [hHeadMode] using hTailIf hHeadMode
              have hCtxAfterScope :
                  sourceCtxAfter.scope =
                    Scope.Stmt.outEnv sourceCtx.scope stmt :=
                SourceDirect.SourceRun.stmt_regular_scope hHeadRegular
              have hRestScoped :
                  Scope.StmtList.Scoped sourceCtxAfter.scope rest := by
                simpa [hCtxAfterScope] using hRestScopedBase
              have hTargetHandlerAfter :
                  SourceDirectBridge.LiveTargetHandlerScopeRel sourceCtxAfter
                    targetCtx := by
                constructor
                · intro depth hDepth name hMem
                  rw [hCtxAfterScope]
                  exact
                    SourceDirect.SourceScope.stmt_outEnv_contains_of_contains
                      (stmt := stmt) (hTargetHandler.1 hDepth hMem)
                · intro depth hDepth name hMem
                  rw [hCtxAfterScope]
                  exact
                    SourceDirect.SourceScope.stmt_outEnv_contains_of_contains
                      (stmt := stmt) (hTargetHandler.2 hDepth hMem)
              have hRestLive :
                  name ∈ StmtList.liveBefore live after rest :=
                stmtList_targetBreakSuffix_mem_of_brk_run
                  (live := live) (targetCtx := targetCtx) (stmts := rest)
                  hTargetHandlerAfter hRestScoped hTailRun hTargetLive
                  hTargetDepth hName
              have hScope : name ∈ sourceCtx.scope :=
                hTargetHandler.1 hTargetDepth hName
              have hHeadLive :
                  name ∈ Stmt.liveBefore live
                    (StmtList.liveBefore live after rest) stmt :=
                RegularRunLiveBefore.stmt_after_mem_of_regular_run
                  (live := live) (stmt := stmt) hStmtScoped hHeadRegular
                  hScope hRestLive
              simpa [StmtList.liveBefore] using hHeadLive
          | brk =>
              have hHeadRun :
                  Source.Stmt.run prim program sourceCtx fuel stmt source =
                    .ok (Source.Outcome.brk sourceHead.state,
                      sourceCtxAfter) := by
                cases sourceHead with
                | mk sourceHeadState sourceHeadMode =>
                    cases sourceHeadMode <;> simp at hHeadMode
                    simpa [Source.Outcome.brk] using hHead
              have hStmtLive :
                  name ∈ Stmt.liveBefore live
                    (StmtList.liveBefore live after rest) stmt :=
                stmt_targetBreakSuffix_mem_of_brk_run
                  (live := live) (targetCtx := targetCtx) (stmt := stmt)
                  (after := StmtList.liveBefore live after rest)
                  hTargetHandler hStmtScoped hHeadRun hTargetLive
                  hTargetDepth hName
              simpa [StmtList.liveBefore] using hStmtLive
          | cont =>
              have hEq := hNonregular (by simp [hHeadMode])
              cases sourceHead with
              | mk sourceHeadState sourceHeadMode =>
                  cases sourceHeadMode <;> simp [Source.Outcome.brk,
                    Source.Outcome.cont] at hHeadMode hEq
                  cases hEq.1
          | leave =>
              have hEq := hNonregular (by simp [hHeadMode])
              cases sourceHead with
              | mk sourceHeadState sourceHeadMode =>
                  cases sourceHeadMode <;> simp [Source.Outcome.brk,
                    Source.Outcome.leave] at hHeadMode hEq
                  cases hEq.1
          | halt kind =>
              have hEq := hNonregular (by simp [hHeadMode])
              cases sourceHead with
              | mk sourceHeadState sourceHeadMode =>
                  cases sourceHeadMode <;> simp [Source.Outcome.brk,
                    Source.Outcome.halt] at hHeadMode hEq
                  cases hEq.1
end


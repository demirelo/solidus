    {returns loopLayout : List Name} {liveCtx : Ctx}
    {after outLayout : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State}
    (hFuelLe : fuel ≤ maxFuel)
    (hCtxCleanup :
      SourceDirectBridge.LiveCtxCleanupRel retc sourceCtx targetCtx)
    (hNoDup : targetCtx.layout.Nodup)
    (hSourceNoDup : sourceCtx.scope.Nodup)
    (hReturnsLen : returns.length = retc)
    (hLeaveFrame : SourceDirect.LeaveFrameAvailable sourceCtx hiddenReturns)
    (hControlRel :
      SourceDirectBridge.LiveControlRel liveCtx sourceCtx)
    (hHandlerScope :
      SourceDirectBridge.LiveHandlerScopeRel liveCtx sourceCtx)
    (hReturnsEq : liveCtx.returns = returns)
    {stmt : Stmt} {rest : List Stmt}
    {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
    {prep lowerStmt lowerRest : List Locals.Stmt}
    (hRestLive : restLive = StmtList.liveBefore liveCtx after rest)
    (hStmtLive : stmtLive = Stmt.liveBefore liveCtx restLive stmt)
    (hLiveLayout : liveLayout = Layout.trimDeadPrefix targetCtx.layout stmtLive)
    (hPrepare :
      Prepare.forStmtAboveSuffix? liveCtx.protectedDepth returns liveLayout
        stmtLive stmt =
        some (prep, preparedLayout))
    (hEntry : Layout.entryWindowOk? preparedLayout stmtLive = true)
    (hAccess : StmtAccess.accessible? returns preparedLayout stmt = true)
    (hLowerStmt :
      Lower.Stmt.toLocals? returns liveCtx preparedLayout restLive stmt =
        some (lowerStmt, nextLayout))
    (hLowerRest :
      Lower.StmtList.toLocals? returns liveCtx nextLayout after rest =
        some (lowerRest, outLayout))
    {cleaned : Locals.RunState}
    (hCleanRel :
      SourceDirect.StateRel preparedLayout hiddenReturns source cleaned)
    {body : Block} {lowerBody : Locals.Block} {bodyLayout : List Name}
    {sourceOpenResult : Source.Outcome × Source.Ctx}
    (hBodyNoCall : NoInternalCall.Block.Holds body)
    (hBodyScoped : Scope.Block.Scoped sourceCtx.scope body)
    (hLowerBody :
      Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout preparedLayout) preparedLayout
        (Checked.scopedAfter preparedLayout restLive) body =
        some (lowerBody, bodyLayout))
    (hSourceOpen :
      Source.Block.runOpen prim sourceProgram sourceCtx fuel body source =
        .ok sourceOpenResult)
    (hBreakLiveSubset :
      sourceOpenResult.1.mode = .brk →
        ∀ {name : Name}, name ∈ liveCtx.breakLive → name ∈ stmtLive)
    (hContinueLiveSubset :
      sourceOpenResult.1.mode = .cont →
        ∀ {name : Name}, name ∈ liveCtx.continueLive → name ∈ stmtLive)
    (hBreakLoopState :
      ∀ {sourceResult : Source.Outcome × Source.Ctx}
        {targetFuel : Nat}
        {targetResult : Locals.Outcome × Locals.Ctx},
        Source.Block.runOpen prim sourceProgram sourceCtx fuel body source =
          .ok sourceResult →
        Locals.Direct.Block.runOpen targetProgram

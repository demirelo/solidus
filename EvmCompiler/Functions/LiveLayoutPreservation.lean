theorem runForLoop_from_exact_source_run_live_with_block_bridges
    {prim : Source.PrimitiveSemantics}
    (hPrim : Locals.SourceLowering.PrimitiveSound prim)
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name}
    {retc fuel : Nat}
    {loopCtx postBase bodyBase : Source.Ctx}
    {targetLoopCtx targetPostBase targetBodyBase : Locals.Ctx}
    {source : Source.State} {target : Locals.RunState}
    {hiddenReturns : List Structured.ReturnDest}
    {cond : Expr 1} {post body : Block}
    {lowerPost lowerBody : Locals.Block}
    {sourceLoop : Source.Outcome}
    (hCtx : SourceDirectBridge.LiveCtxRel retc loopCtx targetLoopCtx)
    (hPostCtx : SourceDirectBridge.LiveCtxRel retc postBase targetPostBase)
    (hBodyCtx : SourceDirectBridge.LiveCtxRel retc bodyBase targetBodyBase)
    (hTargetPostLayout : targetPostBase.layout = targetLoopCtx.layout)
    (hTargetBodyLayout : targetBodyBase.layout = targetLoopCtx.layout)
    (hPostBreakNone : postBase.breakScope? = none)
    (hPostContinueNone : postBase.continueScope? = none)
    (hNoDup : targetLoopCtx.layout.Nodup)
    (hOwned : Locals.Source.Expr.SourceOwned cond)
    (hAccess :
      Locals.SourceLowering.Expr.Accessible targetLoopCtx.layout 0 cond)
    (hRel :
      SourceDirect.StateRel targetLoopCtx.layout hiddenReturns source target)
    (hSourceRun :
      Source.Stmt.runForLoop prim sourceProgram loopCtx cond postBase post
          bodyBase body (fuel + 1) source =
        .ok sourceLoop)
    (hBody :
      ∀ {sourceAfterCond : Source.State} {targetAfterCond : Locals.RunState}
        {sourceBody : Source.Outcome},
        Source.Block.runScoped prim sourceProgram bodyBase body fuel
            sourceAfterCond =
          .ok sourceBody →
        SourceDirect.StateRel targetLoopCtx.layout hiddenReturns
          sourceAfterCond targetAfterCond →
        SourceDirectBridge.LiveLoopBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns targetLoopCtx.layout retc fuel
          bodyBase targetBodyBase hiddenReturns body lowerBody
          sourceAfterCond targetAfterCond)
    (hPost :
      ∀ {sourceBody : Source.Outcome} {targetBody : Locals.Outcome}
        {sourcePost : Source.Outcome},
        (sourceBody.mode = .regular ∨ sourceBody.mode = .cont) →
        Source.Block.runScoped prim sourceProgram postBase post fuel
            sourceBody.state =
          .ok sourcePost →
        SourceDirect.StateRel targetPostBase.layout hiddenReturns
          sourceBody.state targetBody.state →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns retc fuel postBase targetPostBase
          hiddenReturns post lowerPost sourceBody.state targetBody.state)
    (hLoop :
      ∀ {sourcePost : Source.State} {targetPost : Locals.RunState}
        {sourceLoop' : Source.Outcome},
        Source.Stmt.runForLoop prim sourceProgram loopCtx cond postBase post
            bodyBase body fuel sourcePost =
          .ok sourceLoop' →
        SourceDirect.StateRel targetLoopCtx.layout hiddenReturns sourcePost
          targetPost →
        ∃ targetFuel targetLoop',
          Locals.Direct.Stmt.runForLoop targetProgram targetLoopCtx cond
              targetPostBase lowerPost targetBodyBase lowerBody targetFuel
              targetPost =
            .ok targetLoop' ∧
          SourceDirect.StmtOutcomeRel returns targetLoopCtx.layout
            hiddenReturns sourceLoop' targetLoop') :
    ∃ targetFuel targetLoop,
      Locals.Direct.Stmt.runForLoop targetProgram targetLoopCtx cond
          targetPostBase lowerPost targetBodyBase lowerBody targetFuel target =
        .ok targetLoop ∧
      SourceDirect.StmtOutcomeRel returns targetLoopCtx.layout hiddenReturns
        sourceLoop targetLoop := by
  exact
    runForLoop_from_exact_source_run_live
      (prim := prim) hPrim (sourceProgram := sourceProgram)
      (targetProgram := targetProgram) (returns := returns) (retc := retc)
      (fuel := fuel) (loopCtx := loopCtx) (postBase := postBase)
      (bodyBase := bodyBase) (targetLoopCtx := targetLoopCtx)
      (targetPostBase := targetPostBase) (targetBodyBase := targetBodyBase)
      (source := source) (target := target) (hiddenReturns := hiddenReturns)
      (cond := cond) (post := post) (body := body)
      (lowerPost := lowerPost) (lowerBody := lowerBody)
      (sourceLoop := sourceLoop) hCtx hNoDup hOwned hAccess hRel hSourceRun
      (by
        intro sourceAfterCond targetAfterCond sourceBody hSourceBody hBodyRel
        rcases
            blockScoped_from_loop_open_bridge_with_layout
              (prim := prim) (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (loopLayout := targetLoopCtx.layout) (retc := retc)
              (sourceFuel := fuel) (sourceCtx := bodyBase)
              (targetCtx := targetBodyBase) (hiddenReturns := hiddenReturns)
              (source := sourceAfterCond) (target := targetAfterCond)
              (sourceOutcome := sourceBody) (block := body)
              (targetBlock := lowerBody) hBodyCtx hTargetBodyLayout
              hSourceBody (hBody hSourceBody hBodyRel) with
          ⟨targetFuel, targetBody, hTargetBody, hBodyOutcomeRel⟩
        exact ⟨targetFuel, targetBody, hTargetBody, hBodyOutcomeRel⟩)
      (by
        intro sourceBody targetBody sourcePost hBodyNext hSourcePost hBodyRel
        have hPostStateRel :
            SourceDirect.StateRel targetPostBase.layout hiddenReturns
              sourceBody.state targetBody.state := by
          have hLoopStateRel :
              SourceDirect.StateRel targetLoopCtx.layout hiddenReturns
                sourceBody.state targetBody.state :=
            SourceDirect.StmtOutcomeRel.stateRel_of_regular_or_cont
              hBodyRel hBodyNext
          simpa [hTargetPostLayout] using hLoopStateRel
        rcases
            blockScoped_from_open_bridge_with_layout
              (prim := prim) (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (retc := retc) (sourceFuel := fuel) (sourceCtx := postBase)
              (targetCtx := targetPostBase) (hiddenReturns := hiddenReturns)
              (source := sourceBody.state) (target := targetBody.state)
              (sourceOutcome := sourcePost) (block := post)
              (targetBlock := lowerPost) hPostCtx hSourcePost
              (hPost hBodyNext hSourcePost hPostStateRel) with
          ⟨targetFuel, targetPost, hTargetPost, hPostScopedRel⟩
        have hPostNoBC :
            sourcePost.mode ≠ .brk ∧ sourcePost.mode ≠ .cont :=
          SourceDirect.SourceRun.block_runScoped_not_break_continue_of_no_loop_control
            hSourcePost hPostBreakNone hPostContinueNone
        have hPostRel :
            SourceDirect.StmtOutcomeRel returns targetPostBase.layout
              hiddenReturns sourcePost targetPost :=
          SourceDirectBridge.LiveBlockScopedOutcomeRel.to_stmtOutcomeRel_of_not_break_continue
            hPostScopedRel hPostNoBC.1 hPostNoBC.2
        exact
          ⟨targetFuel, targetPost, hTargetPost,
            by
              simpa [hTargetPostLayout] using hPostRel⟩)
      hLoop

theorem for_leave_or_halt_liveStmtRunBridge_from_init_open
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name}
    {retc sourceFuel initTargetFuel : Nat}
    {sourceCtx sourceInitCtx : Source.Ctx}
    {targetCtx targetInitCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {init post body : Block} {cond : Expr 1}
    {lowerInit lowerPost lowerBody : Locals.Block}
    {sourceInit : Source.Outcome} {targetInit : Locals.Outcome}
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hSourceInit :
      Source.Block.runOpen prim sourceProgram sourceCtx.withoutLoopControl
          sourceFuel init source =
        .ok (sourceInit, sourceInitCtx))
    (hTargetInit :
      Locals.Direct.Block.runOpen targetProgram targetCtx.withoutLoopControl
          initTargetFuel lowerInit target =
        .ok (targetInit, targetInitCtx))
    (hInitRel :
      SourceDirectBridge.LiveBlockOpenResultRel retc returns hiddenReturns
        (sourceInit, sourceInitCtx) (targetInit, targetInitCtx))
    (hPass :
      sourceInit.mode = .leave ∨
        ∃ kind, sourceInit.mode = .halt kind) :
    SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
      returns retc (sourceFuel + 1) sourceCtx targetCtx hiddenReturns
      (.for_ init cond post body)
      { stmts := [Locals.Stmt.for_ lowerInit cond lowerPost lowerBody] }
      source target := by
  have hNonregular : sourceInit.mode ≠ .regular := by
    intro hRegular
    rcases hPass with hLeave | ⟨kind, hHalt⟩
    · rw [hRegular] at hLeave
      cases hLeave
    · rw [hRegular] at hHalt
      cases hHalt
  rcases
      SourceDirectBridge.LiveBlockOpenResultRel.outcomeRel_of_nonregular
        hInitRel hNonregular with
    ⟨outcomeLayout, hOutcomeRel⟩
  have hTargetNonregular : targetInit.mode ≠ .regular :=
    SourceDirectBridge.LiveBlockOpenResultRel.target_nonregular_of_source_nonregular
      hInitRel hNonregular
  have hSourceStmt :
      Source.Stmt.run prim sourceProgram sourceCtx (sourceFuel + 1)
          (.for_ init cond post body) source =
        .ok (sourceInit, sourceCtx) := by
    cases sourceInit with
    | mk sourceInitState sourceInitMode =>
        cases sourceInitMode <;>
          simp [Source.Stmt.run, Source.Outcome.regular,
            Locals.Source.Outcome.regular, hSourceInit] at hPass ⊢
  have hTargetStmt :
      Locals.Direct.Stmt.run targetProgram targetCtx (initTargetFuel + 1)
          (.for_ lowerInit cond lowerPost lowerBody) target =
        .ok (targetInit, targetCtx) := by
    cases sourceInit with
    | mk sourceInitState sourceInitMode =>
        cases targetInit with
        | mk targetInitState targetInitMode =>
            cases sourceInitMode <;> cases targetInitMode <;>
              simp [Locals.Direct.Stmt.run, Structured.Outcome.regular,
                hTargetInit, SourceDirect.StmtOutcomeRel]
                at hOutcomeRel hPass ⊢
  rcases Target.runOpen_singleton_nonregular_exists
      (program := targetProgram) hTargetStmt hTargetNonregular with
    ⟨targetFuel, hTargetBlock⟩
  exact
    ⟨(sourceInit, sourceCtx), targetFuel, (targetInit, targetCtx),
      hSourceStmt, hTargetBlock,
      SourceDirectBridge.LiveStmtRunResultRel.of_nonregular
        ⟨outcomeLayout, hOutcomeRel⟩ hCtx hNonregular⟩

theorem for_regular_liveStmtRunBridge_from_init_loop_regular
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name}
    {retc sourceFuel initTargetFuel loopTargetFuel : Nat}
    {sourceCtx sourceInitCtx : Source.Ctx}
    {targetCtx targetInitCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source sourceAfterInit sourceLoop : Source.State}
    {target targetAfterInit targetLoop : Locals.RunState}
    {init post body : Block} {cond : Expr 1}
    {lowerInit lowerPost lowerBody : Locals.Block}
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hSourceInit :
      Source.Block.runOpen prim sourceProgram sourceCtx.withoutLoopControl
          sourceFuel init source =
        .ok (Source.Outcome.regular sourceAfterInit, sourceInitCtx))
    (hTargetInit :
      Locals.Direct.Block.runOpen targetProgram targetCtx.withoutLoopControl
          initTargetFuel lowerInit target =
        .ok (Structured.Outcome.regular targetAfterInit, targetInitCtx))
    (hLoop :
      Source.Stmt.runForLoop prim sourceProgram sourceInitCtx cond
          sourceInitCtx.withoutLoopControl post
          (sourceInitCtx.withLoopControl sourceInitCtx.scope
            sourceInitCtx.scope)
          body sourceFuel sourceAfterInit =
        .ok (Source.Outcome.regular sourceLoop))
    (hTargetLoop :
      Locals.Direct.Stmt.runForLoop targetProgram targetInitCtx cond
          targetInitCtx.withoutLoopControl lowerPost
          (targetInitCtx.withLoopControl targetInitCtx.layout.length)
          lowerBody loopTargetFuel targetAfterInit =
        .ok (Structured.Outcome.regular targetLoop))
    (hLoopRel :
      SourceDirect.StateRel targetInitCtx.layout hiddenReturns sourceLoop
        targetLoop)
    (hLayout :
      SourceDirect.CleanupLayoutRel targetInitCtx.layout targetCtx.layout) :
    SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
      returns retc (sourceFuel + 1) sourceCtx targetCtx hiddenReturns
      (.for_ init cond post body)
      { stmts := [Locals.Stmt.for_ lowerInit cond lowerPost lowerBody] }
      source target := by
  rcases hLoopRel with ⟨⟨_hShared, hStackRel⟩, _hReturns⟩
  have hDepth : targetCtx.layout.length ≤ targetInitCtx.layout.length := by
    have hLength := congrArg List.length hLayout
    simp at hLength
    omega
  rcases SourceDirect.Cleanup.runCleanupTo_exists
      (ctx := targetInitCtx) (targetDepth := targetCtx.layout.length)
      (state := targetLoop) hDepth hStackRel.1 with
    ⟨targetAfter, hCleanup⟩
  have hLoopRelFull :
      SourceDirect.StateRel targetInitCtx.layout hiddenReturns sourceLoop
        targetLoop :=
    ⟨⟨_hShared, hStackRel⟩, _hReturns⟩
  have hFinalRel :
      SourceDirect.StateRel targetCtx.layout hiddenReturns
        (Locals.Source.State.restrictTo sourceCtx.scope sourceLoop)
        targetAfter :=
    SourceDirectBridge.stateRel_cleanupTo_layout_subset
      (ctx := targetInitCtx) (outer := targetCtx.layout)
      (scope := sourceCtx.scope) (hiddenReturns := hiddenReturns)
      (source := sourceLoop) (target := targetLoop) (cleaned := targetAfter)
      hLoopRelFull hLayout hCtx.1 hCleanup
  let targetFuel := Nat.max initTargetFuel loopTargetFuel
  have hTargetInit' :
      Locals.Direct.Block.runOpen targetProgram targetCtx.withoutLoopControl
          targetFuel lowerInit target =
        .ok (Structured.Outcome.regular targetAfterInit, targetInitCtx) :=
    Locals.Direct.Block.runOpen_mono targetProgram
      (Nat.le_max_left initTargetFuel loopTargetFuel) hTargetInit
  have hTargetLoop' :
      Locals.Direct.Stmt.runForLoop targetProgram targetInitCtx cond
          targetInitCtx.withoutLoopControl lowerPost
          (targetInitCtx.withLoopControl targetInitCtx.layout.length)
          lowerBody targetFuel targetAfterInit =
        .ok (Structured.Outcome.regular targetLoop) :=
    Locals.Direct.Stmt.runForLoop_mono targetProgram
      (Nat.le_max_right initTargetFuel loopTargetFuel) hTargetLoop
  have hSourceStmt :
      Source.Stmt.run prim sourceProgram sourceCtx (sourceFuel + 1)
          (.for_ init cond post body) source =
        .ok
          (Source.Outcome.regular
            (Locals.Source.State.restrictTo sourceCtx.scope sourceLoop),
            sourceCtx) := by
    simp [Source.Stmt.run, Source.Outcome.regular,
      Locals.Source.Outcome.regular, hSourceInit, hLoop]
  have hTargetStmt :
      Locals.Direct.Stmt.run targetProgram targetCtx (targetFuel + 1)
          (.for_ lowerInit cond lowerPost lowerBody) target =
        .ok (Structured.Outcome.regular targetAfter, targetCtx) := by
    simp [Locals.Direct.Stmt.run, Structured.Outcome.regular, targetFuel,
      hTargetInit', hTargetLoop', hCleanup]
  rcases Target.runOpen_singleton_regular_exists
      (program := targetProgram) hTargetStmt with
    ⟨targetBlockFuel, hTargetBlock⟩
  exact
    ⟨(Source.Outcome.regular
        (Locals.Source.State.restrictTo sourceCtx.scope sourceLoop),
        sourceCtx),
      targetBlockFuel, (Structured.Outcome.regular targetAfter, targetCtx),
      hSourceStmt, hTargetBlock,
      SourceDirectBridge.LiveStmtRunResultRel.regular hFinalRel hCtx⟩

theorem for_leave_or_halt_liveStmtRunBridge_from_init_loop
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name}
    {retc sourceFuel initTargetFuel loopTargetFuel : Nat}
    {sourceCtx sourceInitCtx : Source.Ctx}
    {targetCtx targetInitCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source sourceAfterInit : Source.State}
    {target targetAfterInit : Locals.RunState}
    {init post body : Block} {cond : Expr 1}
    {lowerInit lowerPost lowerBody : Locals.Block}
    {sourceLoop : Source.Outcome} {targetLoop : Locals.Outcome}
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hSourceInit :
      Source.Block.runOpen prim sourceProgram sourceCtx.withoutLoopControl
          sourceFuel init source =
        .ok (Source.Outcome.regular sourceAfterInit, sourceInitCtx))
    (hTargetInit :
      Locals.Direct.Block.runOpen targetProgram targetCtx.withoutLoopControl
          initTargetFuel lowerInit target =
        .ok (Structured.Outcome.regular targetAfterInit, targetInitCtx))
    (hLoop :
      Source.Stmt.runForLoop prim sourceProgram sourceInitCtx cond
          sourceInitCtx.withoutLoopControl post
          (sourceInitCtx.withLoopControl sourceInitCtx.scope
            sourceInitCtx.scope)
          body sourceFuel sourceAfterInit =
        .ok sourceLoop)
    (hTargetLoop :
      Locals.Direct.Stmt.runForLoop targetProgram targetInitCtx cond
          targetInitCtx.withoutLoopControl lowerPost
          (targetInitCtx.withLoopControl targetInitCtx.layout.length)
          lowerBody loopTargetFuel targetAfterInit =
        .ok targetLoop)
    (hOutcomeRel :
      ∃ outcomeLayout,
        SourceDirect.StmtOutcomeRel returns outcomeLayout hiddenReturns
          sourceLoop targetLoop)
    (hPass :
      sourceLoop.mode = .leave ∨
        ∃ kind, sourceLoop.mode = .halt kind) :
    SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
      returns retc (sourceFuel + 1) sourceCtx targetCtx hiddenReturns
      (.for_ init cond post body)
      { stmts := [Locals.Stmt.for_ lowerInit cond lowerPost lowerBody] }
      source target := by
  have hNonregular : sourceLoop.mode ≠ .regular := by
    intro hRegular
    rcases hPass with hLeave | ⟨kind, hHalt⟩
    · rw [hRegular] at hLeave
      cases hLeave
    · rw [hRegular] at hHalt
      cases hHalt
  rcases hOutcomeRel with ⟨outcomeLayout, hOutcomeRel⟩
  have hTargetNonregular : targetLoop.mode ≠ .regular := by
    cases sourceLoop with
    | mk sourceLoopState sourceLoopMode =>
        cases targetLoop with
        | mk targetLoopState targetLoopMode =>
            cases sourceLoopMode <;> cases targetLoopMode <;>
              simp [SourceDirect.StmtOutcomeRel] at hOutcomeRel hNonregular ⊢
  let targetFuel := Nat.max initTargetFuel loopTargetFuel
  have hTargetInit' :
      Locals.Direct.Block.runOpen targetProgram targetCtx.withoutLoopControl
          targetFuel lowerInit target =
        .ok (Structured.Outcome.regular targetAfterInit, targetInitCtx) :=
    Locals.Direct.Block.runOpen_mono targetProgram
      (Nat.le_max_left initTargetFuel loopTargetFuel) hTargetInit
  have hTargetLoop' :
      Locals.Direct.Stmt.runForLoop targetProgram targetInitCtx cond
          targetInitCtx.withoutLoopControl lowerPost
          (targetInitCtx.withLoopControl targetInitCtx.layout.length)
          lowerBody targetFuel targetAfterInit =
        .ok targetLoop :=
    Locals.Direct.Stmt.runForLoop_mono targetProgram
      (Nat.le_max_right initTargetFuel loopTargetFuel) hTargetLoop
  have hSourceStmt :
      Source.Stmt.run prim sourceProgram sourceCtx (sourceFuel + 1)
          (.for_ init cond post body) source =
        .ok (sourceLoop, sourceCtx) := by
    cases sourceLoop with
    | mk sourceLoopState sourceLoopMode =>
        cases sourceLoopMode <;>
          simp [Source.Stmt.run, Source.Outcome.regular,
            Locals.Source.Outcome.regular, hSourceInit, hLoop]
            at hPass ⊢
  have hTargetStmt :
      Locals.Direct.Stmt.run targetProgram targetCtx (targetFuel + 1)
          (.for_ lowerInit cond lowerPost lowerBody) target =
        .ok (targetLoop, targetCtx) := by
    cases sourceLoop with
    | mk sourceLoopState sourceLoopMode =>
        cases targetLoop with
        | mk targetLoopState targetLoopMode =>
            cases sourceLoopMode <;> cases targetLoopMode <;>
              simp [Locals.Direct.Stmt.run, Structured.Outcome.regular,
                targetFuel, hTargetInit', hTargetLoop',
                SourceDirect.StmtOutcomeRel] at hOutcomeRel hPass ⊢
  rcases Target.runOpen_singleton_nonregular_exists
      (program := targetProgram) hTargetStmt hTargetNonregular with
    ⟨targetBlockFuel, hTargetBlock⟩
  exact
    ⟨(sourceLoop, sourceCtx), targetBlockFuel, (targetLoop, targetCtx),
      hSourceStmt, hTargetBlock,
      SourceDirectBridge.LiveStmtRunResultRel.of_nonregular
        ⟨outcomeLayout, hOutcomeRel⟩ hCtx hNonregular⟩

theorem for_liveStmtRunBridge_from_exact_source_run_of_lower
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {returns : List Name} {liveCtx : Ctx} {after nextLayout : List Name}
    {retc fuel : Nat}
    {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {init post body : Block} {cond : Expr 1}
    {lowerStmt : List Locals.Stmt}
    {sourceResult : Source.Outcome × Source.Ctx}
    (hLower :
      Lower.Stmt.toLocals? returns liveCtx targetCtx.layout after
        (.for_ init cond post body) = some (lowerStmt, nextLayout))
    (hCtx : SourceDirectBridge.LiveCtxRel retc sourceCtx targetCtx)
    (hSourceRun :
      Source.Stmt.run prim sourceProgram sourceCtx (fuel + 1)
          (.for_ init cond post body) source =
        .ok sourceResult)
    (hInit :
      let loopMentioned :=
        NameSet.unions [Reads.expr cond, Reads.block post, Reads.block body,
          after]
      let postLive := Block.liveBefore liveCtx loopMentioned post
      let bodyCtx := liveCtx.withLoop after postLive
      let bodyLive := Block.liveBefore bodyCtx postLive body
      let loopLive :=
        NameSet.unions [Reads.expr cond, after, postLive, bodyLive]
      let initAfter := NameSet.union loopLive targetCtx.layout
      ∀ {lowerInit loopLayout sourceInitResult},
        Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout targetCtx.layout) targetCtx.layout
          initAfter init =
          some (lowerInit, loopLayout) →
        Source.Block.runOpen prim sourceProgram sourceCtx.withoutLoopControl
          fuel init source =
          .ok sourceInitResult →
        SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
          targetProgram returns retc fuel sourceCtx.withoutLoopControl
          targetCtx.withoutLoopControl hiddenReturns init lowerInit source
          target)
    (hLoop :
      let loopMentioned :=
        NameSet.unions [Reads.expr cond, Reads.block post, Reads.block body,
          after]
      let postLive := Block.liveBefore liveCtx loopMentioned post
      let bodyCtx := liveCtx.withLoop after postLive
      let bodyLive := Block.liveBefore bodyCtx postLive body
      let loopLive :=
        NameSet.unions [Reads.expr cond, after, postLive, bodyLive]
      let initAfter := NameSet.union loopLive targetCtx.layout
      ∀ {lowerInit loopLayout lowerPost postLayout lowerBody bodyLayout}
        {sourceInitCtx : Source.Ctx} {targetInitCtx : Locals.Ctx}
        {sourceAfterInit : Source.State}
        {targetAfterInit : Locals.RunState}
        {sourceLoop : Source.Outcome} {initTargetFuel : Nat},
        Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout targetCtx.layout) targetCtx.layout
          initAfter init =
          some (lowerInit, loopLayout) →
        ExprAccess.expr? 0 loopLayout cond = true →
        (let postAfter := Checked.scopedAfter loopLayout loopMentioned
         let postCtx := liveCtx.withProtectedLayout loopLayout
         Lower.Block.toLocals? returns postCtx loopLayout postAfter post =
          some (lowerPost, postLayout)) →
        (let bodyAfter := Checked.scopedAfter loopLayout postLive
         let bodyLoopCtx :=
          liveCtx.withLoop (Checked.scopedAfter loopLayout after) bodyAfter
         let bodyCheckCtx :=
          bodyLoopCtx.withProtectedLayout loopLayout
         Lower.Block.toLocals? returns bodyCheckCtx loopLayout bodyAfter body =
          some (lowerBody, bodyLayout)) →
        Source.Block.runOpen prim sourceProgram sourceCtx.withoutLoopControl
            fuel init source =
          .ok (Source.Outcome.regular sourceAfterInit, sourceInitCtx) →
        Locals.Direct.Block.runOpen targetProgram targetCtx.withoutLoopControl
            initTargetFuel lowerInit target =
          .ok (Structured.Outcome.regular targetAfterInit, targetInitCtx) →
        Source.Stmt.runForLoop prim sourceProgram sourceInitCtx cond
            sourceInitCtx.withoutLoopControl post
            (sourceInitCtx.withLoopControl sourceInitCtx.scope
              sourceInitCtx.scope)
            body fuel sourceAfterInit =
          .ok sourceLoop →
        SourceDirect.StateRel targetInitCtx.layout hiddenReturns
          sourceAfterInit targetAfterInit →
        SourceDirectBridge.LiveCtxRel retc sourceInitCtx targetInitCtx →
        ∃ loopTargetFuel targetLoop,
          Locals.Direct.Stmt.runForLoop targetProgram targetInitCtx cond
              targetInitCtx.withoutLoopControl lowerPost
              (targetInitCtx.withLoopControl targetInitCtx.layout.length)
              lowerBody loopTargetFuel targetAfterInit =
            .ok targetLoop ∧
          SourceDirect.StmtOutcomeRel returns targetInitCtx.layout
            hiddenReturns sourceLoop targetLoop) :
    SourceDirectBridge.LiveStmtRunBridge prim sourceProgram targetProgram
      returns retc (fuel + 1) sourceCtx targetCtx hiddenReturns
      (.for_ init cond post body) { stmts := lowerStmt } source target := by
  rcases Lower.ForLowering.components_of_toLocals? hLower with
    ⟨lowerInit, loopLayout, lowerPost, postLayout, lowerBody, bodyLayout,
      hLowerInit, hCond, hLowerPost, hLowerBody, hLowerStmt,
      _hNextLayout⟩
  subst lowerStmt
  have hInitBridge :
      SourceDirectBridge.LiveBlockOpenRunBridgeWithLayout prim sourceProgram
        targetProgram returns retc fuel sourceCtx.withoutLoopControl
        targetCtx.withoutLoopControl hiddenReturns init lowerInit source
        target := by
    cases hSourceInit :
        Source.Block.runOpen prim sourceProgram sourceCtx.withoutLoopControl fuel
          init source with
    | error err =>
        simp [Source.Stmt.run, hSourceInit] at hSourceRun
    | ok sourceInitResult =>
        exact hInit hLowerInit hSourceInit
  rcases hInitBridge with
    ⟨sourceInitResult, initTargetFuel, targetInitResult, hSourceInit,
      hTargetInit, hInitRel, hInitLayoutRel⟩
  rcases sourceInitResult with ⟨sourceInit, sourceInitCtx⟩
  rcases targetInitResult with ⟨targetInit, targetInitCtx⟩
  cases sourceInit with
  | mk sourceInitState sourceInitMode =>
      cases sourceInitMode with
      | regular =>
          cases targetInit with
          | mk targetInitState targetInitMode =>
              cases targetInitMode with
              | regular =>
                  have hInitRegular :
                      SourceDirect.StateRel targetInitCtx.layout
                          hiddenReturns sourceInitState targetInitState ∧
                        SourceDirectBridge.LiveCtxRel retc sourceInitCtx
                          targetInitCtx := by
                    simpa [SourceDirectBridge.LiveBlockOpenResultRel,
                      Source.Outcome.regular, Locals.Source.Outcome.regular,
                      Structured.Outcome.regular] using hInitRel
                  rcases hInitRegular with ⟨hInitStateRel, hInitCtxRel⟩
                  have hLayout :
                      SourceDirect.CleanupLayoutRel targetInitCtx.layout
                        targetCtx.layout := by
                    simpa [SourceDirectBridge.LiveBlockOpenRegularLayoutRel,
                      SourceDirectBridge.LiveBlockOpenRegularLayoutRelTo,
                      Locals.Ctx.withoutLoopControl] using hInitLayoutRel
                  cases hSourceLoop :
                      Source.Stmt.runForLoop prim sourceProgram sourceInitCtx
                          cond sourceInitCtx.withoutLoopControl post
                          (sourceInitCtx.withLoopControl sourceInitCtx.scope
                            sourceInitCtx.scope)
                          body fuel sourceInitState with
                  | error err =>
                      simp [Source.Stmt.run, Source.Outcome.regular,
                        Locals.Source.Outcome.regular, hSourceInit,
                        hSourceLoop] at hSourceRun
                  | ok sourceLoop =>
                      rcases
                          hLoop hLowerInit hCond hLowerPost hLowerBody
                            hSourceInit hTargetInit hSourceLoop hInitStateRel
                            hInitCtxRel with
                        ⟨loopTargetFuel, targetLoop, hTargetLoop,
                          hLoopRel⟩
                      cases sourceLoop with
                      | mk sourceLoopState sourceLoopMode =>
                          cases sourceLoopMode with
                          | regular =>
                              cases targetLoop with
                              | mk targetLoopState targetLoopMode =>
                                  cases targetLoopMode with
                                  | regular =>
                                      have hLoopStateRel :
                                          SourceDirect.StateRel
                                            targetInitCtx.layout hiddenReturns
                                            sourceLoopState targetLoopState := by
                                        simpa [SourceDirect.StmtOutcomeRel,
                                          Source.Outcome.regular,
                                          Locals.Source.Outcome.regular,
                                          Structured.Outcome.regular]
                                          using hLoopRel
                                      exact
                                        for_regular_liveStmtRunBridge_from_init_loop_regular
                                          (prim := prim)
                                          (sourceProgram := sourceProgram)
                                          (targetProgram := targetProgram)
                                          (returns := returns) (retc := retc)
                                          (sourceFuel := fuel)
                                          (initTargetFuel := initTargetFuel)
                                          (loopTargetFuel := loopTargetFuel)
                                          (sourceCtx := sourceCtx)
                                          (sourceInitCtx := sourceInitCtx)
                                          (targetCtx := targetCtx)
                                          (targetInitCtx := targetInitCtx)
                                          (source := source)
                                          (sourceAfterInit := sourceInitState)
                                          (sourceLoop := sourceLoopState)
                                          (target := target)
                                          (targetAfterInit := targetInitState)
                                          (targetLoop := targetLoopState)
                                          (hiddenReturns := hiddenReturns)
                                          (init := init) (post := post)
                                          (body := body) (cond := cond)
                                          (lowerInit := lowerInit)
                                          (lowerPost := lowerPost)
                                          (lowerBody := lowerBody)
                                          hCtx hSourceInit hTargetInit
                                          hSourceLoop hTargetLoop
                                          hLoopStateRel hLayout
                                  | brk =>
                                      exact False.elim (by
                                        simpa [SourceDirect.StmtOutcomeRel]
                                          using hLoopRel)
                                  | cont =>
                                      exact False.elim (by
                                        simpa [SourceDirect.StmtOutcomeRel]
                                          using hLoopRel)
                                  | leave =>
                                      exact False.elim (by
                                        simpa [SourceDirect.StmtOutcomeRel]
                                          using hLoopRel)
                                  | halt kind =>
                                      exact False.elim (by
                                        simpa [SourceDirect.StmtOutcomeRel]
                                          using hLoopRel)
                          | brk =>
                              exact False.elim (by
                                simpa [Source.Stmt.run,
                                  Source.Outcome.regular,
                                  Locals.Source.Outcome.regular, hSourceInit,
                                  hSourceLoop, Source.invalid,
                                  Structured.invalid] using hSourceRun)
                          | cont =>
                              exact False.elim (by
                                simpa [Source.Stmt.run,
                                  Source.Outcome.regular,
                                  Locals.Source.Outcome.regular, hSourceInit,
                                  hSourceLoop, Source.invalid,
                                  Structured.invalid] using hSourceRun)
                          | leave =>
                              have hPass :
                                  ({ state := sourceLoopState,
                                      mode := Locals.Source.Mode.leave } :
                                    Source.Outcome).mode = .leave ∨
                                    ∃ kind,
                                      ({ state := sourceLoopState,
                                          mode := Locals.Source.Mode.leave } :
                                        Source.Outcome).mode = .halt kind := by
                                exact Or.inl rfl
                              exact
                                for_leave_or_halt_liveStmtRunBridge_from_init_loop
                                  (prim := prim)
                                  (sourceProgram := sourceProgram)
                                  (targetProgram := targetProgram)
                                  (returns := returns) (retc := retc)
                                  (sourceFuel := fuel)
                                  (initTargetFuel := initTargetFuel)
                                  (loopTargetFuel := loopTargetFuel)
                                  (sourceCtx := sourceCtx)
                                  (sourceInitCtx := sourceInitCtx)
                                  (targetCtx := targetCtx)
                                  (targetInitCtx := targetInitCtx)
                                  (source := source)
                                  (sourceAfterInit := sourceInitState)
                                  (target := target)
                                  (targetAfterInit := targetInitState)
                                  (hiddenReturns := hiddenReturns)
                                  (init := init) (post := post)
                                  (body := body) (cond := cond)
                                  (lowerInit := lowerInit)
                                  (lowerPost := lowerPost)
                                  (lowerBody := lowerBody)
                                  (sourceLoop :=
                                    { state := sourceLoopState,
                                      mode := Locals.Source.Mode.leave })
                                  (targetLoop := targetLoop)
                                  hCtx hSourceInit hTargetInit hSourceLoop
                                  hTargetLoop
                                  ⟨targetInitCtx.layout, hLoopRel⟩ hPass
                          | halt kind =>
                              have hPass :
                                  (Source.Outcome.halt kind
                                    sourceLoopState).mode = .leave ∨
                                    ∃ haltKind,
                                      (Source.Outcome.halt kind
                                        sourceLoopState).mode =
                                          .halt haltKind := by
                                exact Or.inr ⟨kind, rfl⟩
                              exact
                                for_leave_or_halt_liveStmtRunBridge_from_init_loop
                                  (prim := prim)
                                  (sourceProgram := sourceProgram)
                                  (targetProgram := targetProgram)
                                  (returns := returns) (retc := retc)
                                  (sourceFuel := fuel)
                                  (initTargetFuel := initTargetFuel)
                                  (loopTargetFuel := loopTargetFuel)
                                  (sourceCtx := sourceCtx)
                                  (sourceInitCtx := sourceInitCtx)
                                  (targetCtx := targetCtx)
                                  (targetInitCtx := targetInitCtx)
                                  (source := source)
                                  (sourceAfterInit := sourceInitState)
                                  (target := target)
                                  (targetAfterInit := targetInitState)
                                  (hiddenReturns := hiddenReturns)
                                  (init := init) (post := post)
                                  (body := body) (cond := cond)
                                  (lowerInit := lowerInit)
                                  (lowerPost := lowerPost)
                                  (lowerBody := lowerBody)
                                  (sourceLoop :=
                                    Source.Outcome.halt kind sourceLoopState)
                                  (targetLoop := targetLoop)
                                  hCtx hSourceInit hTargetInit hSourceLoop
                                  hTargetLoop
                                  ⟨targetInitCtx.layout, hLoopRel⟩ hPass
              | brk =>
                  exact False.elim (by
                    simpa [SourceDirectBridge.LiveBlockOpenResultRel,
                      SourceDirect.StmtOutcomeRel] using hInitRel)
              | cont =>
                  exact False.elim (by
                    simpa [SourceDirectBridge.LiveBlockOpenResultRel,
                      SourceDirect.StmtOutcomeRel] using hInitRel)
              | leave =>
                  exact False.elim (by
                    simpa [SourceDirectBridge.LiveBlockOpenResultRel,
                      SourceDirect.StmtOutcomeRel] using hInitRel)
              | halt kind =>
                  exact False.elim (by
                    simpa [SourceDirectBridge.LiveBlockOpenResultRel,
                      SourceDirect.StmtOutcomeRel] using hInitRel)
      | brk =>
          exact False.elim (by
            simpa [Source.Stmt.run, Source.Outcome.regular,
              Locals.Source.Outcome.regular, hSourceInit, Source.invalid,
              Structured.invalid] using hSourceRun)
      | cont =>
          exact False.elim (by
            simpa [Source.Stmt.run, Source.Outcome.regular,
              Locals.Source.Outcome.regular, hSourceInit, Source.invalid,
              Structured.invalid] using hSourceRun)
      | leave =>
          have hPass :
              ({ state := sourceInitState,
                  mode := Locals.Source.Mode.leave } :
                Source.Outcome).mode = .leave ∨
                ∃ kind,
                  ({ state := sourceInitState,
                      mode := Locals.Source.Mode.leave } :
                    Source.Outcome).mode = .halt kind := by
            exact Or.inl rfl
          exact
            for_leave_or_halt_liveStmtRunBridge_from_init_open
              (prim := prim) (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (retc := retc) (sourceFuel := fuel)
              (initTargetFuel := initTargetFuel) (sourceCtx := sourceCtx)
              (sourceInitCtx := sourceInitCtx) (targetCtx := targetCtx)
              (targetInitCtx := targetInitCtx) (source := source)
              (target := target) (hiddenReturns := hiddenReturns)
              (init := init) (post := post) (body := body) (cond := cond)
              (lowerInit := lowerInit) (lowerPost := lowerPost)
              (lowerBody := lowerBody)
              (sourceInit :=
                { state := sourceInitState, mode := Locals.Source.Mode.leave })
              (targetInit := targetInit)
              hCtx hSourceInit hTargetInit hInitRel hPass
      | halt kind =>
          have hPass :
              (Source.Outcome.halt kind sourceInitState).mode = .leave ∨
                ∃ haltKind,
                  (Source.Outcome.halt kind sourceInitState).mode =
                    .halt haltKind := by
            exact Or.inr ⟨kind, rfl⟩
          exact
            for_leave_or_halt_liveStmtRunBridge_from_init_open
              (prim := prim) (sourceProgram := sourceProgram)
              (targetProgram := targetProgram) (returns := returns)
              (retc := retc) (sourceFuel := fuel)
              (initTargetFuel := initTargetFuel) (sourceCtx := sourceCtx)
              (sourceInitCtx := sourceInitCtx) (targetCtx := targetCtx)
              (targetInitCtx := targetInitCtx) (source := source)
              (target := target) (hiddenReturns := hiddenReturns)
              (init := init) (post := post) (body := body) (cond := cond)
              (lowerInit := lowerInit) (lowerPost := lowerPost)
              (lowerBody := lowerBody)
              (sourceInit := Source.Outcome.halt kind sourceInitState)
              (targetInit := targetInit)
              hCtx hSourceInit hTargetInit hInitRel hPass

namespace SourceTarget


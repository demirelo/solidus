      ScopedNoInternalCallShapeRecursiveLoopOpenBlockLayoutToOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel)
    {returns loopLayout : List Name} {liveCtx : Ctx}
    {after outLayout baseLayout : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {block : Block} {lowerBlock : Locals.Block}
    {source : Source.State} {target : Locals.RunState}
    {sourceOutcome : Source.Outcome}
    (hFuelLe : fuel ≤ maxFuel)
    (hProtectedEntry : targetCtx.layout.length ≤ liveCtx.protectedDepth)
    (hLower :
      Lower.Block.toLocals? returns liveCtx targetCtx.layout after block =
        some (lowerBlock, outLayout))
    (hSourceScoped :
      Source.Block.runScoped prim sourceProgram sourceCtx block fuel source =
        .ok sourceOutcome)
    (hStateRel :
      SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hNoCall : NoInternalCall.Block.Holds block)
    (hScopedBlock : Scope.Block.Scoped sourceCtx.scope block)
    (hSourceNoDup : sourceCtx.scope.Nodup)
    (hCtxCleanup :
      SourceDirectBridge.LiveCtxCleanupRel retc sourceCtx targetCtx)
    (hNoDup : targetCtx.layout.Nodup)
    (hReturnsLen : returns.length = retc)
    (hLeaveFrame : SourceDirect.LeaveFrameAvailable sourceCtx hiddenReturns)
    (hTargetControlRel :
      SourceDirectBridge.LiveTargetControlRel liveCtx targetCtx)
    (hReturnScopeRel :
      SourceDirectBridge.LiveReturnScopeRel liveCtx sourceCtx)
    (hTargetHandlerScopeRel :
      SourceDirectBridge.LiveTargetHandlerScopeRel sourceCtx targetCtx)
    (hReturnsEq : liveCtx.returns = returns)
    (hBreakLoopDrop :
      ∀ {targetDepth},
        targetCtx.breakDepth? = some targetDepth →
          targetCtx.layout.drop (targetCtx.layout.length - targetDepth) =
            loopLayout)
    (hContinueLoopDrop :
      ∀ {targetDepth},
        targetCtx.continueDepth? = some targetDepth →
          targetCtx.layout.drop (targetCtx.layout.length - targetDepth) =
            loopLayout)
    (hRegularBase :
      sourceOutcome.mode = .regular →
        baseLayout.length ≤ liveCtx.protectedDepth ∧
          (∀ {name : Name}, name ∈ baseLayout → name ∈ after) ∧
            SourceDirect.CleanupLayoutRel targetCtx.layout baseLayout) :
    SourceDirectBridge.LiveLoopBlockOpenRunBridgeWithLayoutTo prim
      sourceProgram targetProgram returns loopLayout retc fuel sourceCtx
      targetCtx baseLayout hiddenReturns block lowerBlock source target := by
  rcases SourceDirect.SourceRun.block_runScoped_open_exists hSourceScoped with
    ⟨sourceOpen, sourceCtxOut, hSourceOpen⟩
  exact
    hCallbacks.block (returns := returns) (loopLayout := loopLayout)
      (liveCtx := liveCtx) (after := after) (outLayout := outLayout)
      (baseLayout := baseLayout) (retc := retc) (fuel := fuel)
      (sourceCtx := sourceCtx) (targetCtx := targetCtx)
      (hiddenReturns := hiddenReturns) (block := block)
      (lowerBlock := lowerBlock) (source := source) (target := target)
      (sourceResult := (sourceOpen, sourceCtxOut)) hFuelLe
      hLower hSourceOpen hStateRel hNoCall hScopedBlock
      hSourceNoDup
      (SourceDirectBridge.LiveCtxOutcomeCleanupRel.of_cleanupRel hCtxCleanup)
      hNoDup hReturnsLen hLeaveFrame
      (fun _hMode {targetDepth} hDepth =>
        SourceDirectBridge.LiveTargetControlRel.breakDepth_le_protectedDepth
          hTargetControlRel hDepth)
      (fun _hMode {targetDepth} hDepth =>
        SourceDirectBridge.LiveTargetControlRel.continueDepth_le_protectedDepth
          hTargetControlRel hDepth)
      (fun _hMode {targetDepth} hDepth {name} hName =>
        (hTargetControlRel.1 hDepth).2 hName)
      (fun _hMode {targetDepth} hDepth {name} hName =>
        (hTargetControlRel.2 hDepth).2 hName)
      hReturnScopeRel hTargetHandlerScopeRel hReturnsEq
      (fun _hMode => hBreakLoopDrop)
      (fun _hMode => hContinueLoopDrop)
      (by
        intro hRegular
        exact hRegularBase
          (by
            unfold Source.Block.runScoped at hSourceScoped
            rw [hSourceOpen] at hSourceScoped
            cases sourceOpen with
            | mk sourceOpenState sourceOpenMode =>
                cases sourceOpenMode <;>
                  simp [Source.Outcome.regular, Source.Outcome.brk,
                    Source.Outcome.cont, Source.Outcome.leave,
                    Source.Outcome.halt] at hRegular hSourceScoped ⊢
                case regular =>
                  cases hSourceScoped
                  rfl))

set_option maxHeartbeats 400000 in
theorem preparedBody_to_loop_open_of_outer_mode_target_suffix
    {prim : Source.PrimitiveSemantics}
    {sourceProgram : Program} {targetProgram : Locals.Program}
    {maxFuel : Nat}
    (hCallbacks :
      ScopedNoInternalCallShapeRecursiveLoopOpenBlockLayoutToOutcomeCallbacksUpToOfLeaveFrame
        prim sourceProgram targetProgram maxFuel)
    {returns loopLayout : List Name} {liveCtx : Ctx}
    {after outLayout : List Name}
    {retc fuel : Nat} {sourceCtx : Source.Ctx} {targetCtx : Locals.Ctx}
    {hiddenReturns : List Structured.ReturnDest}
    {source : Source.State} {target : Locals.RunState}
    {sourceResult sourceOpenResult : Source.Outcome × Source.Ctx}
    (hFuelLe : fuel ≤ maxFuel)
    (hOutcomeCleanup :
      SourceDirectBridge.LiveCtxOutcomeCleanupRel retc sourceCtx targetCtx
        sourceResult.1)
    (hNoDup : targetCtx.layout.Nodup)
    (hSourceNoDup : sourceCtx.scope.Nodup)
    (hReturnsLen : returns.length = retc)
    (hLeaveFrame : SourceDirect.LeaveFrameAvailable sourceCtx hiddenReturns)
    (hReturnScopeRel :
      SourceDirectBridge.LiveReturnScopeRel liveCtx sourceCtx)
    (hReturnsEq : liveCtx.returns = returns)
    {stmt : Stmt} {rest : List Stmt}
    {restLive stmtLive liveLayout preparedLayout nextLayout : List Name}
    {prep lowerStmt lowerRest : List Locals.Stmt}
    (hBreakOuterMode :
      sourceOpenResult.1.mode = .brk → sourceResult.1.mode = .brk)
    (hContinueOuterMode :
      sourceOpenResult.1.mode = .cont → sourceResult.1.mode = .cont)
    (hBreakDepthProtected :
      sourceOpenResult.1.mode = .brk →
        ∀ {targetDepth},
          targetCtx.breakDepth? = some targetDepth →
            targetDepth ≤ liveCtx.protectedDepth)
    (hContinueDepthProtected :
      sourceOpenResult.1.mode = .cont →
        ∀ {targetDepth},
          targetCtx.continueDepth? = some targetDepth →
            targetDepth ≤ liveCtx.protectedDepth)
    (hBreakKeepLive :
      sourceOpenResult.1.mode = .brk →
        ∀ {targetDepth},
          targetCtx.breakDepth? = some targetDepth →
            ∀ {name : Name},
              name ∈
                  targetCtx.layout.drop
                    (targetCtx.layout.length - targetDepth) →
                name ∈ stmtLive)
    (hContinueKeepLive :
      sourceOpenResult.1.mode = .cont →
        ∀ {targetDepth},
          targetCtx.continueDepth? = some targetDepth →
            ∀ {name : Name},
              name ∈
                  targetCtx.layout.drop
                    (targetCtx.layout.length - targetDepth) →
                name ∈ stmtLive)
    (hBreakTargetLive :
      sourceOpenResult.1.mode = .brk →
        ∀ {targetDepth},
          targetCtx.breakDepth? = some targetDepth →
            ∀ {name : Name},
              name ∈
                  targetCtx.layout.drop
                    (targetCtx.layout.length - targetDepth) →

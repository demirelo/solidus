      Source.Block.runOpen prim sourceProgram sourceCtx (fuel + 1)
          { stmts := stmt :: rest } source =
        .ok sourceResult)
    (hStateRel :
      SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hHead :
      ∀ {cleaned sourceHeadResult},
        Source.Stmt.run prim sourceProgram sourceCtx fuel stmt source =
          .ok sourceHeadResult →
        SourceDirect.StateRel preparedLayout hiddenReturns source cleaned →
        SourceDirectBridge.LiveLoopStmtRunBridgeWithLayout prim sourceProgram
          targetProgram returns loopLayout retc fuel sourceCtx
          (targetCtx.withLayout preparedLayout)
          hiddenReturns stmt { stmts := lowerStmt } source cleaned)
    (hTail :
      ∀ {sourceHeadResult : Source.Outcome × Source.Ctx}
        {sourceAfter : Source.State} {targetAfter : Locals.RunState}

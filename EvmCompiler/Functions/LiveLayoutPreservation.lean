    (hNoDup : targetCtx.layout.Nodup)
    (hScrutineeScoped : Scope.ExprScoped sourceCtx.scope scrutinee)
    (hRel : SourceDirect.StateRel targetCtx.layout hiddenReturns source target)
    (hSourceRun :
      Source.Stmt.run prim sourceProgram sourceCtx (fuel + 1)
          (.switch scrutinee cases defaultBody) source =
        .ok sourceResult)
    (hBody :
      ∀ {sourceAfterScrutinee : Source.State}
        {value body lowerBody bodyLayout targetAfterPop sourceOpenResult},
        Source.Switch.select value cases defaultBody = some body →
        Source.Expr.evalOne prim scrutinee source =
          .ok (sourceAfterScrutinee, value) →
        Lower.Block.toLocals? returns
          (liveCtx.withProtectedLayout targetCtx.layout) targetCtx.layout
          (Checked.scopedAfter targetCtx.layout after) body =
          some (lowerBody, bodyLayout) →
        Source.Block.runOpen prim sourceProgram sourceCtx fuel body
          sourceAfterScrutinee =
          .ok sourceOpenResult →
        SourceDirect.StateRel targetCtx.layout hiddenReturns
          sourceAfterScrutinee targetAfterPop →
        SourceDirectBridge.LiveLoopBlockOpenRunBridgeWithLayout prim
          sourceProgram targetProgram returns loopLayout retc fuel sourceCtx
          targetCtx hiddenReturns body lowerBody sourceAfterScrutinee
          targetAfterPop) :
    SourceDirectBridge.LiveLoopStmtRunBridgeWithLayout prim sourceProgram
      targetProgram returns loopLayout retc (fuel + 1) sourceCtx targetCtx
      hiddenReturns (.switch scrutinee cases defaultBody) { stmts := lowerStmt }
      source target := by
  have hAccess :
      Locals.SourceLowering.Expr.Accessible targetCtx.layout 0 scrutinee :=
    StmtAccess.accessible?_sound hAccessCheck
  have hOwned : Locals.Source.Expr.SourceOwned scrutinee :=
    SourceDirect.SourceScope.exprScoped_sourceOwned hScrutineeScoped
  cases hEvalOne : Source.Expr.evalOne prim scrutinee source with
  | error err =>
      simp [Source.Stmt.run, hEvalOne] at hSourceRun
  | ok evalResult =>
      rcases evalResult with ⟨sourceAfterScrutinee, value⟩
      exact
        switch_liveLoopStmtRunBridge_of_lower
          (prim := prim) hPrim (sourceProgram := sourceProgram)
          (targetProgram := targetProgram) (returns := returns)
          (loopLayout := loopLayout)
          (liveCtx := liveCtx) (after := after)
          (nextLayout := nextLayout) (retc := retc) (fuel := fuel)
          (sourceCtx := sourceCtx) (targetCtx := targetCtx)
          (hiddenReturns := hiddenReturns) (source := source)
          (sourceAfterScrutinee := sourceAfterScrutinee)
          (target := target) (scrutinee := scrutinee) (cases := cases)
          (defaultBody := defaultBody) (lowerStmt := lowerStmt)
          (value := value) hLower hCtx hNoDup hOwned hAccess hRel hEvalOne
          (fun {body lowerBody bodyLayout targetAfterPop} hSelect hLowerBody
              hPopRel => by
            cases hSourceScoped :
                Source.Block.runScoped prim sourceProgram sourceCtx body fuel
                  sourceAfterScrutinee with
            | error err =>
                simp [Source.Stmt.run, hEvalOne, hSelect, hSourceScoped]
                  at hSourceRun
            | ok sourceOutcome =>
                rcases
                    SourceDirect.SourceRun.block_runScoped_open_exists
                      hSourceScoped with
                  ⟨sourceOpen, sourceCtxOut, hSourceOpen⟩
                exact hBody
                  (sourceAfterScrutinee := sourceAfterScrutinee)
                  (value := value)
                  (body := body)
                  (lowerBody := lowerBody)
                  (bodyLayout := bodyLayout)
                  (targetAfterPop := targetAfterPop)
                  (sourceOpenResult := (sourceOpen, sourceCtxOut))

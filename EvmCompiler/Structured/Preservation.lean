theorem call {program : Program}
    {layout : ProcedurePreservation.ProgramLayout program}
    (hCall : ProcedurePreservation.CallObligationForAllFuel layout)
    {ctx : CompileContext} {supply : LabelSupply} {name : Name} :
    ProcedurePreservation.StmtPreservesInProgramLayout layout ctx supply
      (.call name) := by
  intro fuel source outcome target tokens hProgramWF hCtxProcs hCalls
    hResolve segment hPc hRel hEval

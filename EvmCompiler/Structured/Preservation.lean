        (outcome := Outcome.halt kind bodyState) (target := afterEntry)
        (tokens := token :: tokens) hAfterEntry.2 hAfterEntry.1
        (by simpa [callState] using hBody)
    exact
      ARunResult.mono
        (by
          simpa [procSegment, bodyCode, dispatchCode, ctx, bcode, dcode,
            exitLabel, List.append_assoc] using hBodyRun)
        (by
          intro result hResult
          cases result with
          | running afterBody =>
              cases hResult
          | halted halt =>
              simpa [CompiledOutcomeRel, Outcome.halt] using hResult)

theorem call_regular_in_layout {program : Program} {ctx : CompileContext}
    {proc : Proc} {bodySupply dispatchSupply : LabelSupply}
    {sites : List CallSite} {site : CallSite} {fuel : Nat}
    {state bodyState returned : RunState}
    {args callerStack stack : EvmYul.Stack Word} {frame : ReturnDest}
    {target : EVMState} {tokens : List Word} {token : Word}
    {pre between post : Assembly.Program}
    (hBodyPres :
      BlockPreservesAtFuel program (bodyCtx program proc) bodySupply proc.body
        fuel)
    (hSplit :
      StackFrame.splitArgs? proc.argc state.evm.stack =
        some (args, callerStack))
    (hBody :
      Block.Eval program fuel proc.body
        ((state.withEVM { state.evm with stack := args }).pushReturn
          callerStack proc.retc)
        (Outcome.regular bodyState))
    (hPop : bodyState.popReturn? = some (frame, returned))
    (hAttach :
      StackFrame.attachReturns? frame bodyState.evm.stack = some stack)
    (hMem : site ∈ sites.filter (CallSite.forProc proc.name))
    (hNoDup :
      ((sites.filter (CallSite.forProc proc.name)).map CallSite.token).Nodup)
    (hToken : site.token = token)
    (hArgBound : args.length ≤ 16)
    (hBound : proc.retc < 16)
    (hFits :
      AssemblyProgram.PCFitsFrom pre
        (callSiteCode proc args token site.returnLabel ++ between ++
          procSegment program proc bodySupply dispatchSupply sites))
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : Frame.StateRel state target tokens)
    (hExact :
      ExactLabels
        (pre ++ callSiteCode proc args token site.returnLabel ++ between ++
          procSegment program proc bodySupply dispatchSupply sites ++ post)) :
    ARunResult
      (pre ++ callSiteCode proc args token site.returnLabel ++ between ++
        procSegment program proc bodySupply dispatchSupply sites ++ post)
      target
      (fun result =>
        CompiledOutcomeRel
          (pre ++ callSiteCode proc args token site.returnLabel ++ between ++
            procSegment program proc bodySupply dispatchSupply sites ++ post)
          ctx
          (Assembly.Program.pcAfter
            (pre ++ callSiteCode proc args token site.returnLabel))
          (Outcome.regular
            (returned.withEVM { bodyState.evm with stack := stack }))
          result tokens) := by
  let jumpCode := callJumpCode proc args token
  let returnCode : Assembly.Program := [Assembly.Instr.label site.returnLabel]
  let procCode := procSegment program proc bodySupply dispatchSupply sites
  let procPre := pre ++ jumpCode ++ returnCode ++ between
  have hFitsJump :
      AssemblyProgram.PCFitsFrom pre jumpCode := by
    exact
      AssemblyProgram.PCFitsFrom.left
        (pre := pre) (first := jumpCode)
        (second := returnCode ++ between ++ procCode)
        (by
          simpa [jumpCode, returnCode, procCode, callSiteCode,
            List.append_assoc] using hFits)
  have hFitsAfterJump :
      AssemblyProgram.PCFitsFrom (pre ++ jumpCode)
        (returnCode ++ between ++ procCode) := by
    exact
      AssemblyProgram.PCFitsFrom.right
        (pre := pre) (first := jumpCode)
        (second := returnCode ++ between ++ procCode)
        (by
          simpa [jumpCode, returnCode, procCode, callSiteCode,
            List.append_assoc] using hFits)
  have hFitsReturn :
      AssemblyProgram.PCFitsFrom (pre ++ jumpCode) returnCode := by
    exact
      AssemblyProgram.PCFitsFrom.left
        (pre := pre ++ jumpCode) (first := returnCode)
        (second := between ++ procCode) hFitsAfterJump
  have hFitsAfterReturn :
      AssemblyProgram.PCFitsFrom ((pre ++ jumpCode) ++ returnCode)
        (between ++ procCode) := by
    exact
      AssemblyProgram.PCFitsFrom.right
        (pre := pre ++ jumpCode) (first := returnCode)
        (second := between ++ procCode) hFitsAfterJump
  have hFitsProc :
      AssemblyProgram.PCFitsFrom procPre procCode := by
    have hRight :
        AssemblyProgram.PCFitsFrom
          (((pre ++ jumpCode) ++ returnCode) ++ between) procCode := by
      exact
        AssemblyProgram.PCFitsFrom.right
          (pre := (pre ++ jumpCode) ++ returnCode)
          (first := between) (second := procCode) hFitsAfterReturn
    simpa [procPre, List.append_assoc] using hRight
  have hEntryPc :
      Assembly.Program.labelPc
        (pre ++ callSiteCode proc args token site.returnLabel ++ between ++
          procSegment program proc bodySupply dispatchSupply sites ++ post)
        (ProcLabel.entry proc.name) =
          some (Assembly.Program.byteLength procPre) := by
    have hHere :=
      hExact.labelPc_at procPre (ProcLabel.entry proc.name)
        (bodyCode program proc bodySupply ++
          [Assembly.Instr.label (ProcLabel.exit proc.name)] ++
          dispatchCode proc sites dispatchSupply ++ post)
        (by
          simp [procPre, procSegment, callSiteCode, jumpCode,
            returnCode, bodyCode, dispatchCode, List.append_assoc])
    simpa [procPre, procCode, procSegment, callSiteCode, jumpCode,
      returnCode, bodyCode, dispatchCode, List.append_assoc] using hHere
  have hExactProc :
      ExactLabels (procPre ++ procCode ++ post) := by
    simpa [procPre, procCode, procSegment, callSiteCode, jumpCode,
      returnCode, List.append_assoc] using hExact
  have hReturnPc :
      Assembly.Program.labelPc (procPre ++ procCode ++ post)
        site.returnLabel =
          some (Assembly.Program.byteLength (pre ++ jumpCode)) := by
    have hHere :=
      hExact.labelPc_at (pre ++ jumpCode) site.returnLabel
        (between ++ procCode ++ post)
        (by
          simp [procCode, callSiteCode, jumpCode, List.append_assoc])
    simpa [procPre, procCode, callSiteCode, jumpCode, returnCode,
      List.append_assoc] using hHere
  have hCallEntry :=
    Frame.StateRel.source_callEntry_after_prologue_and_jump
      (source := state) (target := target) (tokens := tokens)
      (argc := proc.argc) (retc := proc.retc) (args := args)
      (callerStack := callerStack) (token := token)
      (entryLabel := ProcLabel.entry proc.name)
      (entryDest := Assembly.Program.byteLength procPre)
      (pre := pre) (post := returnCode ++ between ++ procCode ++ post)
      (by simpa [jumpCode, callJumpCode, List.append_assoc] using hFitsJump)
      hPc hRel hSplit hArgBound
      (by
        simpa [procPre, procCode, procSegment, callSiteCode, callJumpCode,
          jumpCode, returnCode, List.append_assoc] using hEntryPc)
  refine
    ARunResult.bind_running
      (program :=
        pre ++ callSiteCode proc args token site.returnLabel ++ between ++
          procSegment program proc bodySupply dispatchSupply sites ++ post)
      (middle := fun afterJump =>
        Frame.StateRel
          ((state.withEVM { state.evm with stack := args }).pushReturn
            callerStack proc.retc)
          afterJump (token :: tokens) ∧
          afterJump.pc = Assembly.Program.pcAfter procPre)
      ?_ ?_
  · exact
      ARunResult.mono
        (by
          simpa [procPre, procCode, callSiteCode, callJumpCode, jumpCode,
            returnCode, procSegment, List.append_assoc] using hCallEntry)
        (by
          intro result hResult
          cases result with
          | halted halt =>
              cases hResult
          | running afterJump =>
              rcases hResult with ⟨hRelAfterJump, hPcAfterJump⟩
              exact ⟨hRelAfterJump, by
                simpa [Assembly.Program.pcAfter, procPre, callJumpCode,
                  jumpCode, returnCode, List.append_assoc] using hPcAfterJump⟩)
  · intro afterJump hAfterJump
    have hBodyDispatch :=
      regular_body_then_dispatch
        (program := program) (proc := proc) (bodySupply := bodySupply)
        (dispatchSupply := dispatchSupply) (sites := sites)
        (site := site)
        (returnDest := Assembly.Program.byteLength (pre ++ jumpCode))
        (fuel := fuel) (state := state) (bodyState := bodyState)
        (returned := returned) (args := args) (callerStack := callerStack)
        (stack := stack) (frame := frame) (target := afterJump)
        (tokens := tokens) (token := token) (pre := procPre) (post := post)
        (procBodyPreservesAtSegment_of_local
          (program := program) (proc := proc) (bodySupply := bodySupply)
          (dispatchSupply := dispatchSupply) (sites := sites)
          (fuel := fuel) (pre := procPre) (post := post)
          hBodyPres (by simpa [procCode] using hFitsProc) hExactProc)
        hBody hPop hAttach hMem hNoDup hToken hBound
        (by simpa [procCode] using hFitsProc)
        hAfterJump.2 hAfterJump.1 hExactProc hReturnPc
    refine
      ARunResult.bind_running
        (program :=
          pre ++ callSiteCode proc args token site.returnLabel ++ between ++
            procSegment program proc bodySupply dispatchSupply sites ++ post)
        (middle := fun afterDispatch =>
          Frame.StateRel
            (returned.withEVM { bodyState.evm with stack := stack })
            afterDispatch tokens ∧
            afterDispatch.pc =
              Assembly.Program.pcAfter (pre ++ jumpCode))
        ?_ ?_
    · exact
        ARunResult.mono
          (by
            simpa [procPre, procCode, callSiteCode, jumpCode, returnCode,
              procSegment, List.append_assoc] using hBodyDispatch)
          (by
            intro result hResult
            cases result with
            | halted halt =>
                cases hResult
            | running afterDispatch =>
                rcases hResult with ⟨hRelAfterDispatch, hPcAfterDispatch⟩
                exact ⟨hRelAfterDispatch, by
                  simpa [Assembly.Program.pcAfter] using hPcAfterDispatch⟩)
    · intro afterDispatch hAfterDispatch
      have hReturnRun :=
        Frame.StateRel.label_runResult_at
          (label := site.returnLabel) (pre := pre ++ jumpCode)
          (post := between ++ procCode ++ post)
          (source :=
            returned.withEVM { bodyState.evm with stack := stack })
          (target := afterDispatch) (tokens := tokens)
          (AssemblyProgram.PCFitsFrom.start hFitsReturn)
          hAfterDispatch.2 hAfterDispatch.1
      exact
        ARunResult.mono
          (by
            simpa [procCode, callSiteCode, jumpCode, returnCode,
              procSegment, List.append_assoc] using hReturnRun)
          (by
            intro result hResult
            cases result with
            | halted halt =>
                cases hResult
            | running final =>
                rcases hResult with ⟨hRelFinal, hPcFinal⟩
                exact ⟨hRelFinal, by
                  simpa [callSiteCode, jumpCode, returnCode, List.append_assoc]
                    using hPcFinal⟩)


theorem preserves_leave {program : Program} {ctx : CompileContext}
    {supply : LabelSupply} {label : Assembly.Label}
    (hCtx : ctx.leaveLabel? = some label) :
    StmtPreserves program ctx supply .leave := by
  intro pre post fuel source outcome target tokens hFits hResolve _hExact
    hPc hRel hEval
  cases hEval with
  | leave hReturns =>
      rcases hResolve.leave label hCtx with ⟨dest, hLabel⟩
      exact
        leave (program := program) (fuel := fuel) (ctx := ctx)
          (supply := supply) (source := source) (target := target)
          (tokens := tokens) (pre := pre) (post := post)
          (label := label) (dest := dest)
          hCtx (AssemblyProgram.PCFitsFrom.start hFits) hPc hRel
          (by
            simpa [Stmt.compileFromCtxCore, Stmt.jumpOrInvalid, hCtx]
              using hLabel)
          (Stmt.Eval.leave hReturns)

theorem terminal {program : Program} {fuel : Nat} {ctx : CompileContext}
    {supply : LabelSupply} {source outState : RunState}
    {target : EVMState} {tokens : List Word} {pre post : Assembly.Program}
    {kind : Assembly.HaltKind}
    (hSafe : Terminal.RelSafe kind)
    (hFit : PCFits pre)
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : Frame.StateRel source target tokens)
    (hEval :
      Stmt.Eval program fuel (.terminal kind) source
        (Outcome.halt kind outState)) :
    ARunResult
      (pre ++ (Stmt.compileFromCtxCore (.terminal kind) ctx supply).code ++
        post)
      target
      (fun result =>
        CompiledOutcomeRel
          (pre ++ (Stmt.compileFromCtxCore (.terminal kind) ctx supply).code ++
            post)
          ctx
          (Assembly.Program.pcAfter
            (pre ++ (Stmt.compileFromCtxCore (.terminal kind) ctx supply).code))
          (Outcome.halt kind outState) result tokens) := by
  cases hEval with
  | terminal hStep =>
      rcases Frame.StateRel.terminal_stepResult_at
          (kind := kind) (pre := pre) (post := post)
          hSafe hFit hPc hRel hStep with
        ⟨targetFinal, hTargetStep, hTargetRel⟩
      refine
        ⟨1,
          .halted
            { kind := kind
              state := targetFinal
              output := kind.output targetFinal },
          ?_, ?_⟩
      · change
          Assembly.Source.runNResult
              (pre ++
                (Stmt.compileFromCtxCore (.terminal kind) ctx supply).code ++
                  post)
              1 target =
            .ok
              (.halted
                { kind := kind
                  state := targetFinal
                  output := kind.output targetFinal })
        have hStep' :
            Assembly.Source.stepResult
                (pre ++ Assembly.Instr.prim kind.toPrimOp :: post) target =
              .ok
                (.halted
                  { kind := kind
                    state := targetFinal
                    output := kind.output targetFinal }) := by
          simpa using hTargetStep
        simp [Stmt.compileFromCtxCore, Assembly.Source.runNResult,
          hStep', Bind.bind, Except.bind]
      · exact ⟨rfl, tokens, hTargetRel⟩

theorem preserves_terminal {program : Program} {ctx : CompileContext}
    {supply : LabelSupply} {kind : Assembly.HaltKind}
    (hSafe : Terminal.RelSafe kind) :
    StmtPreserves program ctx supply (.terminal kind) := by
  intro pre post fuel source outcome target tokens hFits _hResolve _hExact
    hPc hRel hEval
  cases hEval with
  | terminal hStep =>
      exact
        terminal (program := program) (fuel := fuel) (ctx := ctx)
          (supply := supply) (source := source)
          (outState := source.withEVM _)
          (target := target) (tokens := tokens) (pre := pre) (post := post)
          (kind := kind) hSafe (AssemblyProgram.PCFitsFrom.start hFits)
          hPc hRel (Stmt.Eval.terminal hStep)

end StmtPreservation


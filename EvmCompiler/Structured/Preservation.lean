theorem switchDefaultPreservesInProgramLayoutAtFuel_some {program : Program}
    {layout : ProgramLayout program} {fuel : Nat} {ctx : CompileContext}
    {supply : LabelSupply} {body : Block}
    (hDefault :
      SwitchDefaultPreservesInProgramLayoutAtFuel layout fuel ctx supply
        (some body)) :
    BlockPreservesInProgramLayoutAtFuel layout fuel ctx supply body := by
  exact hDefault

theorem switchCasesPreservesInProgramLayout_of_all {program : Program}
    {layout : ProgramLayout program} {ctx : CompileContext}
    {endLabel : Assembly.Label} {base supply : LabelSupply} {idx : Nat}
    {cases : List (Word × Block)}
    (hAll :
      ∀ {bodySupply : LabelSupply} {value : Word} {body : Block},
        (value, body) ∈ cases →
          BlockPreservesInProgramLayout layout ctx bodySupply body) :
    SwitchCasesPreservesInProgramLayout layout ctx endLabel base supply idx
      cases := by
  induction cases generalizing supply idx with
  | nil =>
      trivial
  | cons head rest ih =>
      rcases head with ⟨value, body⟩
      exact
        ⟨ hAll (bodySupply := supply) (value := value) (body := body)
            (by simp)
        , ih (supply := (Block.compileFromCtx body ctx supply).next)
            (idx := idx + 1) (by
              intro bodySupply value' body' hMem
              exact
                hAll (bodySupply := bodySupply) (value := value')
                  (body := body') (by simp [hMem])) ⟩

theorem switchCasesPreservesInProgramLayoutAtFuel_of_preserves
    {program : Program}
    {layout : ProgramLayout program} {fuel : Nat} {ctx : CompileContext}
    {endLabel : Assembly.Label} {base supply : LabelSupply} {idx : Nat}
    {cases : List (Word × Block)}
    (hCases :
      SwitchCasesPreservesInProgramLayout layout ctx endLabel base supply idx
        cases) :
    SwitchCasesPreservesInProgramLayoutAtFuel layout fuel ctx endLabel base
      supply idx cases := by
  induction cases generalizing supply idx with
  | nil =>
      trivial
  | cons head rest ih =>
      rcases head with ⟨value, body⟩
      constructor
      · exact
          blockPreservesInProgramLayoutAtFuel_of_preserves
            (fuel := fuel)
            (switchCasesPreservesInProgramLayout_head hCases)
      · exact
          ih
            (by
              simpa using switchCasesPreservesInProgramLayout_tail hCases)

theorem switchDefaultPreservesInProgramLayoutAtFuel_of_preserves
    {program : Program}
    {layout : ProgramLayout program} {fuel : Nat} {ctx : CompileContext}
    {supply : LabelSupply} {defaultBody : Option Block}
    (hDefault :
      SwitchDefaultPreservesInProgramLayout layout ctx supply defaultBody) :
    SwitchDefaultPreservesInProgramLayoutAtFuel layout fuel ctx supply
      defaultBody := by
  cases defaultBody with
  | none =>
      trivial
  | some body =>
      exact
        blockPreservesInProgramLayoutAtFuel_of_preserves
          (fuel := fuel)
          (switchDefaultPreservesInProgramLayout_some hDefault)

theorem switchCases_calls_included_head {ctx : CompileContext}
    {endLabel : Assembly.Label} {base supply : LabelSupply} {idx : Nat}
    {value : Word} {body : Block} {rest : List (Word × Block)}
    {sites : List CallSite}
    (hCalls :
      CallsIncluded
        (SwitchCases.compileFromCtx ((value, body) :: rest) ctx endLabel base
          supply idx).calls sites) :
    CallsIncluded (Block.compileFromCtx body ctx supply).calls sites := by
  let compiledBody := Block.compileFromCtx body ctx supply
  let compiledHead : CompileResult :=
    { code :=
        [ Assembly.Instr.label (LabelSupply.label base (idx + 2))
        , Assembly.Instr.prim .pop ] ++
          compiledBody.code ++ [Assembly.Instr.jump endLabel]
      next := compiledBody.next
      calls := compiledBody.calls }
  let compiledTail :=
    SwitchCases.compileFromCtx rest ctx endLabel base compiledHead.next
      (idx + 1)
  have hAppend :
      CallsIncluded (compiledBody.calls ++ compiledTail.calls) sites := by
    simpa [SwitchCases.compileFromCtx, CompileResult.append, compiledBody,
      compiledHead, compiledTail] using hCalls
  exact CallsIncluded.left hAppend

theorem switchCases_calls_included_tail {ctx : CompileContext}
    {endLabel : Assembly.Label} {base supply : LabelSupply} {idx : Nat}
    {value : Word} {body : Block} {rest : List (Word × Block)}
    {sites : List CallSite}
    (hCalls :
      CallsIncluded
        (SwitchCases.compileFromCtx ((value, body) :: rest) ctx endLabel base
          supply idx).calls sites) :
    CallsIncluded
      (SwitchCases.compileFromCtx rest ctx endLabel base
        (Block.compileFromCtx body ctx supply).next (idx + 1)).calls sites := by
  let compiledBody := Block.compileFromCtx body ctx supply
  let compiledHead : CompileResult :=
    { code :=
        [ Assembly.Instr.label (LabelSupply.label base (idx + 2))
        , Assembly.Instr.prim .pop ] ++
          compiledBody.code ++ [Assembly.Instr.jump endLabel]
      next := compiledBody.next
      calls := compiledBody.calls }
  let compiledTail :=
    SwitchCases.compileFromCtx rest ctx endLabel base compiledHead.next
      (idx + 1)
  have hAppend :
      CallsIncluded (compiledBody.calls ++ compiledTail.calls) sites := by
    simpa [SwitchCases.compileFromCtx, CompileResult.append, compiledBody,
      compiledHead, compiledTail] using hCalls
  simpa [compiledBody, compiledHead, compiledTail] using
    CallsIncluded.right hAppend

theorem switchDefault_calls_included_some {ctx : CompileContext}
    {endLabel defaultLabel : Assembly.Label} {supply : LabelSupply}
    {body : Block} {sites : List CallSite}
    (hCalls :
      CallsIncluded
        (SwitchDefault.compileFromCtx (some body) ctx endLabel defaultLabel
          supply).calls sites) :
    CallsIncluded (Block.compileFromCtx body ctx supply).calls sites := by
  simpa [SwitchDefault.compileFromCtx] using hCalls

theorem for_calls_included_init {ctx : CompileContext}
    {supply : LabelSupply} {init post body : Block} {cond : Code}
    {sites : List CallSite}
    (hCalls :
      CallsIncluded
        (Stmt.compileFromCtxCore (.for_ init cond post body) ctx supply).calls
        sites) :
    CallsIncluded
      (Block.compileFromCtx init
        { ctx with breakLabel? := none, continueLabel? := none }
        (LabelSupply.next supply)).calls sites := by
  let loopOuterCtx : CompileContext :=
    { ctx with breakLabel? := none, continueLabel? := none }
  let compiledInit :=
    Block.compileFromCtx init loopOuterCtx (LabelSupply.next supply)
  let bodyCtx : CompileContext :=
    { ctx with
      breakLabel? := some (LabelSupply.label supply 3)
      continueLabel? := some (LabelSupply.label supply 2) }
  let compiledBody := Block.compileFromCtx body bodyCtx compiledInit.next
  let compiledPost := Block.compileFromCtx post loopOuterCtx compiledBody.next
  have hAppend :
      CallsIncluded
        (compiledInit.calls ++ (compiledBody.calls ++ compiledPost.calls))
        sites := by
    simpa [Stmt.compileFromCtxCore, loopOuterCtx, bodyCtx, compiledInit,
      compiledBody, compiledPost, List.append_assoc] using hCalls
  simpa [loopOuterCtx, compiledInit] using CallsIncluded.left hAppend

theorem for_calls_included_body {ctx : CompileContext}
    {supply : LabelSupply} {init post body : Block} {cond : Code}
    {sites : List CallSite}
    (hCalls :
      CallsIncluded
        (Stmt.compileFromCtxCore (.for_ init cond post body) ctx supply).calls
        sites) :
    let loopOuterCtx : CompileContext :=
      { ctx with breakLabel? := none, continueLabel? := none }
    let compiledInit :=
      Block.compileFromCtx init loopOuterCtx (LabelSupply.next supply)
    let bodyCtx : CompileContext :=
      { ctx with
        breakLabel? := some (LabelSupply.label supply 3)
        continueLabel? := some (LabelSupply.label supply 2) }
    CallsIncluded (Block.compileFromCtx body bodyCtx compiledInit.next).calls
      sites := by
  let loopOuterCtx : CompileContext :=
    { ctx with breakLabel? := none, continueLabel? := none }
  let compiledInit :=
    Block.compileFromCtx init loopOuterCtx (LabelSupply.next supply)
  let bodyCtx : CompileContext :=
    { ctx with
      breakLabel? := some (LabelSupply.label supply 3)
      continueLabel? := some (LabelSupply.label supply 2) }
  let compiledBody := Block.compileFromCtx body bodyCtx compiledInit.next
  let compiledPost := Block.compileFromCtx post loopOuterCtx compiledBody.next
  have hAppend :

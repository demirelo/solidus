    exact
      AssemblyProgram.PCFitsFrom.right
        (pre := (pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++ bcode)
        (first := [Assembly.Instr.label exitLabel])
        (second := dcode)

      (by simpa [callState] using hRel)
  refine
    ARunResult.bind_running
      (program :=
        pre ++ procSegment program proc bodySupply dispatchSupply sites ++ post)
      (middle := fun afterEntry =>
        Frame.StateRel callState afterEntry (token :: tokens) ∧
          afterEntry.pc =
            Assembly.Program.pcAfter
              (pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)]))
      ?_ ?_
  · simpa [procSegment, bcode, dcode, bodyCode, dispatchCode, exitLabel,
      callState, List.append_assoc] using hEntryRun
  · intro afterEntry hAfterEntry
    have hBodyRun :=
      hBodyPres
        (source := callState)
        (outcome := Outcome.regular bodyState) (target := afterEntry)
        (tokens := token :: tokens) hAfterEntry.2 hAfterEntry.1
        (by simpa [callState] using hBody)
    have hBodyRunRegular :
        ARunResult
          (pre ++ procSegment program proc bodySupply dispatchSupply sites ++
            post)
          afterEntry
          (fun result =>
            match result with
            | .running afterBody =>
                Frame.StateRel bodyState afterBody (token :: tokens) ∧
                  afterBody.pc =
                    Assembly.Program.pcAfter
                      ((pre ++
                          [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++
                        bcode)
            | .halted _ => False) := by
      exact
        ARunResult.mono
          (by
            simpa [procSegment, bodyCode, dispatchCode, ctx, bcode, dcode,
              exitLabel, List.append_assoc] using hBodyRun)
          (by
            intro result hResult
            cases result with
            | halted halt =>
                cases hResult
            | running afterBody =>
                simpa [CompiledOutcomeRel, Outcome.regular, bcode]
                  using hResult)
    refine
      ARunResult.bind_running
        (program :=
          pre ++ procSegment program proc bodySupply dispatchSupply sites ++ post)
        (middle := fun afterBody =>
          Frame.StateRel bodyState afterBody (token :: tokens) ∧
            afterBody.pc =
              Assembly.Program.pcAfter
                ((pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++
                  bcode))
        hBodyRunRegular ?_
    intro afterBody hAfterBody
    have hExitRun :=
      Frame.StateRel.label_runResult_at
        (label := exitLabel)
        (pre :=
          (pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++ bcode)
        (post := dcode ++ post)
        (source := bodyState) (target := afterBody)
        (tokens := token :: tokens)
        (AssemblyProgram.PCFitsFrom.start hFitsExit)
        hAfterBody.2 hAfterBody.1
    refine
      ARunResult.bind_running
        (program :=
          pre ++ procSegment program proc bodySupply dispatchSupply sites ++ post)
        (middle := fun afterExit =>
          Frame.StateRel bodyState afterExit (token :: tokens) ∧
            afterExit.pc =
              Assembly.Program.pcAfter
                (((pre ++
                    [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++
                  bcode) ++ [Assembly.Instr.label exitLabel]))
        ?_ ?_
    · simpa [procSegment, bcode, dcode, bodyCode, dispatchCode, exitLabel,
        List.append_assoc] using hExitRun
    · intro afterExit hAfterExit
      have hReturnDispatch :
          Assembly.Program.labelPc
            ((((pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++
              bcode) ++ [Assembly.Instr.label exitLabel]) ++ dcode ++ post)
            site.returnLabel = some returnDest := by
        simpa [procSegment, bcode, dcode, bodyCode, dispatchCode, exitLabel,
          List.append_assoc] using hReturnLabel
      have hExactDispatch :
          ExactLabels
            ((((pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++
              bcode) ++ [Assembly.Instr.label exitLabel]) ++ dcode ++ post) := by
        simpa [procSegment, bcode, dcode, bodyCode, dispatchCode, exitLabel,
          List.append_assoc] using hExact
      have hDispatch :=
        DispatchPreservation.forProc_selected_runResult_at
          (proc := proc) (sites := sites) (supply := dispatchSupply)
          (site := site) (returnDest := returnDest)
          (pre :=
            ((pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++
              bcode) ++ [Assembly.Instr.label exitLabel])
          (post := post) (callee := bodyState) (target := afterExit)
          (tokens := tokens) (token := token) (frame := frame)
          (returns := returned.returns)
          hMem hNoDup hToken hRetc
          (by simpa [dispatchCode, dcode] using hFitsDispatch)
          hAfterExit.2 hAfterExit.1 hReturns hBound hExactDispatch
          hReturnDispatch
      exact
        ARunResult.mono
          (by
            simpa [procSegment, dispatchCode, dcode, bcode, bodyCode,
              exitLabel, List.append_assoc] using hDispatch)
          (by
            intro result hResult
            cases result with
            | halted halt =>
                cases hResult
            | running final =>
                rcases hResult with ⟨hRelFinal, hPcFinal⟩
                exact ⟨by simpa [hSourceEq] using hRelFinal, hPcFinal⟩)


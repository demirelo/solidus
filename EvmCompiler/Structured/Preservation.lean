set_option maxHeartbeats 800000 in
theorem preserves_for_in_programLayout {program : Program}
    {layout : ProgramLayout program}
    {ctx : CompileContext} {supply : LabelSupply}
    {init post body : Block} {cond : Code}
    (hCondSafe : Code.RunnerSafe cond)
    (hCondFrame : Code.FrameSafe cond)
    (hInit :
      BlockPreservesInProgramLayout layout
        { ctx with breakLabel? := none, continueLabel? := none }
        (LabelSupply.next supply) init)
    (hBody :
      BlockPreservesInProgramLayout layout
        { ctx with
          breakLabel? := some (LabelSupply.label supply 3)
          continueLabel? := some (LabelSupply.label supply 2) }
        (Block.compileFromCtx init
          { ctx with breakLabel? := none, continueLabel? := none }
          (LabelSupply.next supply)).next
        body)
    (hPost :
      BlockPreservesInProgramLayout layout
        { ctx with breakLabel? := none, continueLabel? := none }
        (Block.compileFromCtx body
          { ctx with
            breakLabel? := some (LabelSupply.label supply 3)
            continueLabel? := some (LabelSupply.label supply 2) }
          (Block.compileFromCtx init
            { ctx with breakLabel? := none, continueLabel? := none }
            (LabelSupply.next supply)).next).next
        post) :
    StmtPreservesInProgramLayout layout ctx supply
      (.for_ init cond post body) := by
  intro fuel source outcome target tokens hProgramWF hCtxProcs hCalls
    hResolve segment hPc hRel hEval
  let loopLabel := LabelSupply.label supply 0
  let bodyLabel := LabelSupply.label supply 1
  let postLabel := LabelSupply.label supply 2
  let endLabel := LabelSupply.label supply 3
  let loopOuterCtx : CompileContext :=
    { ctx with breakLabel? := none, continueLabel? := none }
  let compiledInit :=
    Block.compileFromCtx init loopOuterCtx (LabelSupply.next supply)
  let bodyCtx : CompileContext :=
    { ctx with
      breakLabel? := some endLabel
      continueLabel? := some postLabel }
  let compiledBody := Block.compileFromCtx body bodyCtx compiledInit.next
  let compiledPost := Block.compileFromCtx post loopOuterCtx compiledBody.next
  let coreCode :=
    ForLoop.coreCode cond compiledBody.code compiledPost.code loopLabel
      bodyLabel postLabel endLabel
  have hCodeEq :
      (Stmt.compileFromCtxCore (.for_ init cond post body) ctx supply).code =
        compiledInit.code ++ coreCode := by
    simp [Stmt.compileFromCtxCore, loopLabel, bodyLabel, postLabel, endLabel,
      loopOuterCtx, bodyCtx, compiledInit, compiledBody, compiledPost,
      coreCode, ForLoop.coreCode, List.append_assoc]
  let appendSeg : CodeSegment layout.asm (compiledInit.code ++ coreCode) :=
    CodeSegment.cast_code hCodeEq segment
  let initSeg : CodeSegment layout.asm compiledInit.code :=
    CodeSegment.left appendSeg
  let coreSeg : CodeSegment layout.asm coreCode :=
    CodeSegment.right appendSeg
  have hInitCalls :
      CallsIncluded compiledInit.calls layout.sites := by
    simpa [loopOuterCtx, compiledInit] using
      for_calls_included_init
        (ctx := ctx) (supply := supply) (init := init) (post := post)
        (body := body) (cond := cond) hCalls
  have hBodyCalls :
      CallsIncluded compiledBody.calls layout.sites := by
    simpa [loopOuterCtx, bodyCtx, compiledInit, compiledBody] using
      for_calls_included_body
        (ctx := ctx) (supply := supply) (init := init) (post := post)
        (body := body) (cond := cond) hCalls
  have hPostCalls :
      CallsIncluded compiledPost.calls layout.sites := by
    simpa [loopOuterCtx, bodyCtx, compiledInit, compiledBody, compiledPost]
      using
        for_calls_included_post
          (ctx := ctx) (supply := supply) (init := init) (post := post)
          (body := body) (cond := cond) hCalls
  have hLoopOuterResolve :
      ContextLabelsResolve layout.asm loopOuterCtx :=
    ContextLabelsResolve.without_break_continue
      (ctx := ctx) hResolve
  have hInitPc : target.pc = initSeg.startPc := by
    simpa [initSeg, appendSeg, CodeSegment.startPc, CodeSegment.left,
      CodeSegment.cast_code] using hPc
  have hCoreFallthrough :
      coreSeg.fallthroughPc = segment.fallthroughPc := by
    simp [coreSeg, appendSeg, CodeSegment.fallthroughPc, CodeSegment.right,
      CodeSegment.cast_code, hCodeEq, List.append_assoc]
  let outerFuel := fuel
  cases hEval with
  | for_init_regular hInitEval hLoopEval =>
      rename_i initState
      have hInitRun :=
        hInit (source := source) (outcome := Outcome.regular initState)
          (target := target) (tokens := tokens)
          hProgramWF
          (by simpa [loopOuterCtx] using hCtxProcs)
          hInitCalls hLoopOuterResolve initSeg
          hInitPc hRel hInitEval
      have hInitRegular :
          ARunResult layout.asm target
            (fun result =>
              match result with
              | .running targetAfterInit =>
                  Frame.StateRel initState targetAfterInit tokens ∧
                    targetAfterInit.pc = coreSeg.startPc
              | .halted _ => False) := by
        exact
          ARunResult.mono hInitRun
            (by
              intro result hResult
              cases result with
              | halted halt =>
                  cases hResult
              | running targetAfterInit =>
                  rcases hResult with ⟨hRelInit, hPcInit⟩
                  exact
                    ⟨hRelInit, by
                      simpa [initSeg, coreSeg, appendSeg, CodeSegment.startPc,
                        CodeSegment.fallthroughPc, CodeSegment.left,
                        CodeSegment.right, CodeSegment.cast_code, hCodeEq,
                        List.append_assoc] using hPcInit⟩)
      refine
        ARunResult.bind_running
          (program := layout.asm)
          (middle := fun targetAfterInit =>
            Frame.StateRel initState targetAfterInit tokens ∧
              targetAfterInit.pc = coreSeg.startPc)
          hInitRegular ?_
      intro targetAfterInit hAfterInit
      have hLoopRun :=
        for_eval_in_programLayout
          (program := program) (layout := layout) (ctx := ctx)
          (cond := cond) (body := body) (post := post)
          (bodySupply := compiledInit.next) (postSupply := compiledBody.next)
          (loopLabel := loopLabel) (bodyLabel := bodyLabel)
          (postLabel := postLabel) (endLabel := endLabel)
          (maxFuel := outerFuel)
          hCondSafe hCondFrame
          (fun {_bodyFuel} _hLt =>
            blockPreservesInProgramLayoutAtFuel_of_preserves hBody)
          (fun {_postFuel} _hLt =>
            blockPreservesInProgramLayoutAtFuel_of_preserves hPost)
          (bodyCode := compiledBody.code) (postCode := compiledPost.code)
          (source := initState) (outcome := outcome)
          (target := targetAfterInit) (tokens := tokens)
          rfl rfl
          (by omega)
          (by simpa [coreCode] using coreSeg)
          hProgramWF hCtxProcs
          hBodyCalls
          hPostCalls
          hResolve hAfterInit.2 hAfterInit.1 hLoopEval
      exact
        ARunResult.mono hLoopRun
          (by
            intro result hResult
            simpa [hCoreFallthrough] using hResult)
  | for_init_leave hInitEval =>
      rename_i outState
      have hInitRun :=
        hInit (source := source) (outcome := Outcome.leave outState)
          (target := target) (tokens := tokens)
          hProgramWF
          (by simpa [loopOuterCtx] using hCtxProcs)
          hInitCalls hLoopOuterResolve initSeg
          hInitPc hRel hInitEval
      exact
        ARunResult.mono hInitRun
          (by
            intro result hResult
            cases result with
            | running target' =>
                simpa [loopOuterCtx, CompiledOutcomeRel, Outcome.leave]
                  using hResult
            | halted halt =>
                cases hResult)
  | for_init_halt hInitEval =>
      rename_i outState kind
      have hInitRun :=
        hInit (source := source) (outcome := Outcome.halt kind outState)
          (target := target) (tokens := tokens)
          hProgramWF
          (by simpa [loopOuterCtx] using hCtxProcs)
          hInitCalls hLoopOuterResolve initSeg
          hInitPc hRel hInitEval
      exact
        ARunResult.mono hInitRun
          (by
            intro result hResult
            cases result with
            | running target' =>
                cases hResult
            | halted halt =>
                simpa [loopOuterCtx, CompiledOutcomeRel, Outcome.halt]
                  using hResult)

theorem preserves_cons_in {program : Program} {asm : Assembly.Program}
    {sites : List CallSite} {layout : CallLayout program asm sites}
    {ctx : CompileContext} {supply : LabelSupply}
    {stmt : Stmt} {rest : List Stmt}
    (hStmt : StmtPreservesIn layout ctx supply stmt)
    (hRest :
      BlockPreservesIn layout ctx
        (Stmt.compileFromCtxCore stmt ctx supply).next { stmts := rest }) :
    BlockPreservesIn layout ctx supply { stmts := stmt :: rest } := by
  intro fuel source outcome target tokens hProgramWF hCtxProcs hCalls
    hResolve hExact segment hPc hRel hEval
  let compiledStmt := Stmt.compileFromCtxCore stmt ctx supply
  let compiledRest :=
    Block.compileFromCtx { stmts := rest } ctx compiledStmt.next
  have hCodeEq :
      (Block.compileFromCtx { stmts := stmt :: rest } ctx supply).code =
        compiledStmt.code ++ compiledRest.code := by
    simp [Block.compileFromCtx, CompileResult.append,
      compiledStmt, compiledRest]
  have hCallsEq :
      (Block.compileFromCtx { stmts := stmt :: rest } ctx supply).calls =
        compiledStmt.calls ++ compiledRest.calls := by
    simp [Block.compileFromCtx, CompileResult.append,
      compiledStmt, compiledRest]
  let appendSeg :
      CodeSegment asm (compiledStmt.code ++ compiledRest.code) :=
    CodeSegment.cast_code hCodeEq segment
  let stmtSeg : CodeSegment asm compiledStmt.code :=
    CodeSegment.left appendSeg
  let restSeg : CodeSegment asm compiledRest.code :=
    CodeSegment.right appendSeg
  have hCallsAppend :
      CallsIncluded (compiledStmt.calls ++ compiledRest.calls) sites := by
    simpa [hCallsEq] using hCalls
  have hStmtCalls : CallsIncluded compiledStmt.calls sites :=
    CallsIncluded.left hCallsAppend
  have hRestCalls : CallsIncluded compiledRest.calls sites :=
    CallsIncluded.right hCallsAppend
  have hStmtPc : target.pc = stmtSeg.startPc := by
    simpa [stmtSeg, appendSeg, CodeSegment.startPc, CodeSegment.left,
      CodeSegment.cast_code] using hPc
  have hRestFallthrough :
      restSeg.fallthroughPc = segment.fallthroughPc := by
    simp [restSeg, appendSeg, CodeSegment.fallthroughPc, CodeSegment.right,
      CodeSegment.cast_code, hCodeEq, List.append_assoc]
  cases hEval with
  | cons_regular hStmtEval hRestEval =>
      rename_i innerFuel mid
      have hStmtRun :=
        hStmt (fuel := innerFuel) (source := source)
          (outcome := Outcome.regular mid) (target := target)
          (tokens := tokens) hProgramWF hCtxProcs
          (by simpa [compiledStmt] using hStmtCalls)
          hResolve hExact
          (by simpa [compiledStmt] using stmtSeg)
          hStmtPc hRel hStmtEval
      have hStmtRunRegular :
          ARunResult asm target
            (fun result =>
              match result with
              | .running targetMid =>
                  Frame.StateRel mid targetMid tokens ∧
                    targetMid.pc = restSeg.startPc
              | .halted _ => False) := by
        exact
          ARunResult.mono hStmtRun
            (by
              intro result hResult
              cases result with
              | halted halt =>
                  cases hResult
              | running targetMid =>
                  rcases hResult with ⟨hRelMid, hPcMid⟩
                  exact ⟨hRelMid, by
                    simpa [stmtSeg, restSeg, appendSeg,
                      CodeSegment.startPc, CodeSegment.fallthroughPc,
                      CodeSegment.left, CodeSegment.right,
                      CodeSegment.cast_code, List.append_assoc] using
                      hPcMid⟩)
      refine
        ARunResult.bind_running
          (program := asm)
          (middle := fun targetMid =>
            Frame.StateRel mid targetMid tokens ∧
              targetMid.pc = restSeg.startPc)
          hStmtRunRegular ?_
      intro targetMid hMid
      have hRestRun :=
        hRest (fuel := innerFuel) (source := mid) (outcome := outcome)
          (target := targetMid) (tokens := tokens)
          hProgramWF hCtxProcs
          (by simpa [compiledRest] using hRestCalls)
          hResolve hExact
          (by simpa [compiledRest] using restSeg)
          hMid.2 hMid.1 hRestEval
      exact
        ARunResult.mono hRestRun
          (by
            intro result hResult
            simpa [hRestFallthrough] using hResult)
  | cons_brk hStmtEval =>
      rename_i innerFuel outState
      have hStmtRun :=
        hStmt (fuel := innerFuel) (source := source)
          (outcome := Outcome.brk outState) (target := target)
          (tokens := tokens) hProgramWF hCtxProcs
          (by simpa [compiledStmt] using hStmtCalls)
          hResolve hExact
          (by simpa [compiledStmt] using stmtSeg)
          hStmtPc hRel hStmtEval
      exact
        ARunResult.mono hStmtRun
          (by
            intro result hResult
            cases result with
            | running target' =>
                simpa [CompiledOutcomeRel, Outcome.brk] using hResult
            | halted halt =>
                cases hResult)
  | cons_cont hStmtEval =>
      rename_i innerFuel outState
      have hStmtRun :=
        hStmt (fuel := innerFuel) (source := source)
          (outcome := Outcome.cont outState) (target := target)
          (tokens := tokens) hProgramWF hCtxProcs
          (by simpa [compiledStmt] using hStmtCalls)
          hResolve hExact
          (by simpa [compiledStmt] using stmtSeg)
          hStmtPc hRel hStmtEval
      exact
        ARunResult.mono hStmtRun
          (by
            intro result hResult
            cases result with
            | running target' =>
                simpa [CompiledOutcomeRel, Outcome.cont] using hResult
            | halted halt =>
                cases hResult)
  | cons_leave hStmtEval =>
      rename_i innerFuel outState
      have hStmtRun :=
        hStmt (fuel := innerFuel) (source := source)
          (outcome := Outcome.leave outState) (target := target)
          (tokens := tokens) hProgramWF hCtxProcs
          (by simpa [compiledStmt] using hStmtCalls)
          hResolve hExact
          (by simpa [compiledStmt] using stmtSeg)
          hStmtPc hRel hStmtEval
      exact
        ARunResult.mono hStmtRun
          (by
            intro result hResult
            cases result with
            | running target' =>
                simpa [CompiledOutcomeRel, Outcome.leave] using hResult
            | halted halt =>
                cases hResult)
  | cons_halt hStmtEval =>
      rename_i innerFuel outState kind
      have hStmtRun :=
        hStmt (fuel := innerFuel) (source := source)
          (outcome := Outcome.halt kind outState) (target := target)
          (tokens := tokens) hProgramWF hCtxProcs
          (by simpa [compiledStmt] using hStmtCalls)
          hResolve hExact
          (by simpa [compiledStmt] using stmtSeg)
          hStmtPc hRel hStmtEval
      exact
        ARunResult.mono hStmtRun
          (by
            intro result hResult
            cases result with
            | running target' =>
                cases hResult
            | halted halt =>
                simpa [CompiledOutcomeRel, Outcome.halt] using hResult)

theorem preserves_cons_in_programLayout {program : Program}
    {layout : ProgramLayout program}
    {ctx : CompileContext} {supply : LabelSupply}
    {stmt : Stmt} {rest : List Stmt}
    (hStmt : StmtPreservesInProgramLayout layout ctx supply stmt)
    (hRest :
      BlockPreservesInProgramLayout layout ctx
        (Stmt.compileFromCtxCore stmt ctx supply).next { stmts := rest }) :
    BlockPreservesInProgramLayout layout ctx supply { stmts := stmt :: rest } := by
  intro fuel source outcome target tokens hProgramWF hCtxProcs hCalls
    hResolve segment hPc hRel hEval
  exact
    preserves_cons_in
      (program := program) (asm := layout.asm) (sites := layout.sites)
      (layout := layout.toCallLayout)
      (ctx := ctx) (supply := supply) (stmt := stmt) (rest := rest)
      (stmt_preserves_in_of_programLayout (layout := layout) hStmt)
      (block_preserves_in_of_programLayout (layout := layout) hRest)
      hProgramWF hCtxProcs hCalls hResolve layout.exactLabels segment hPc
      hRel hEval

/--
Fuel-bounded variant of the whole-program statement preservation interface.

This is the bridge needed to discharge recursive procedure calls without
putting procedure-body preservation into `ProgramLayout`: source calls consume
one unit of fuel before evaluating the callee body, so the call proof can use a
bounded call obligation for strictly smaller source fuel.
-/
def StmtPreservesInProgramLayoutUpTo {program : Program}
    (layout : ProgramLayout program) (maxFuel : Nat)
    (ctx : CompileContext) (supply : LabelSupply) (stmt : Stmt) : Prop :=
  ∀ {fuel : Nat} {source : RunState} {outcome : Outcome}
    {target : EVMState} {tokens : List Word},
    fuel < maxFuel →
      program.WF →
      ctx.procs = program.procs →
      CallsIncluded (Stmt.compileFromCtxCore stmt ctx supply).calls
        layout.sites →
      ContextLabelsResolve layout.asm ctx →
      (segment :
        CodeSegment layout.asm
          (Stmt.compileFromCtxCore stmt ctx supply).code) →
      target.pc = segment.startPc →
      Frame.StateRel source target tokens →
      Stmt.Eval program fuel stmt source outcome →
      ARunResult layout.asm target
        (fun result =>
          CompiledOutcomeRel layout.asm ctx segment.fallthroughPc outcome result
            tokens)

def BlockPreservesInProgramLayoutUpTo {program : Program}
    (layout : ProgramLayout program) (maxFuel : Nat)
    (ctx : CompileContext) (supply : LabelSupply) (block : Block) : Prop :=
  ∀ {fuel : Nat} {source : RunState} {outcome : Outcome}
    {target : EVMState} {tokens : List Word},
    fuel < maxFuel →
      program.WF →
      ctx.procs = program.procs →
      CallsIncluded (Block.compileFromCtx block ctx supply).calls
        layout.sites →
      ContextLabelsResolve layout.asm ctx →
      (segment :
        CodeSegment layout.asm (Block.compileFromCtx block ctx supply).code) →
      target.pc = segment.startPc →
      Frame.StateRel source target tokens →
      Block.Eval program fuel block source outcome →
      ARunResult layout.asm target
        (fun result =>
          CompiledOutcomeRel layout.asm ctx segment.fallthroughPc outcome result
            tokens)

structure CallObligationUpTo {program : Program}
    (layout : ProgramLayout program) (maxFuel : Nat) : Prop where
  preserves :
    ∀ {ctx : CompileContext} {supply : LabelSupply} {name : Name},
      StmtPreservesInProgramLayoutUpTo layout maxFuel ctx supply (.call name)

def CallObligationForAllFuel {program : Program}
    (layout : ProgramLayout program) : Prop :=
  ∀ maxFuel, CallObligationUpTo layout maxFuel

theorem callObligationUpTo_zero {program : Program}
    (layout : ProgramLayout program) :
    CallObligationUpTo layout 0 := by
  constructor
  intro ctx supply name fuel source outcome target tokens hLt
  omega

theorem stmtPreservesInProgramLayoutUpTo_mono {program : Program}
    {layout : ProgramLayout program} {small big : Nat}
    {ctx : CompileContext} {supply : LabelSupply} {stmt : Stmt}
    (hLe : small ≤ big)
    (hPreserves :
      StmtPreservesInProgramLayoutUpTo layout big ctx supply stmt) :
    StmtPreservesInProgramLayoutUpTo layout small ctx supply stmt := by
  intro fuel source outcome target tokens hLt
  exact hPreserves (by omega)

theorem blockPreservesInProgramLayoutUpTo_mono {program : Program}
    {layout : ProgramLayout program} {small big : Nat}
    {ctx : CompileContext} {supply : LabelSupply} {block : Block}
    (hLe : small ≤ big)
    (hPreserves :
      BlockPreservesInProgramLayoutUpTo layout big ctx supply block) :
    BlockPreservesInProgramLayoutUpTo layout small ctx supply block := by
  intro fuel source outcome target tokens hLt
  exact hPreserves (by omega)

theorem blockPreservesInProgramLayoutAtFuel_of_upTo {program : Program}
    {layout : ProgramLayout program} {maxFuel fuel : Nat}
    {ctx : CompileContext} {supply : LabelSupply} {block : Block}
    (hLt : fuel < maxFuel)
    (hPreserves :
      BlockPreservesInProgramLayoutUpTo layout maxFuel ctx supply block) :
    BlockPreservesInProgramLayoutAtFuel layout fuel ctx supply block := by
  intro source outcome target tokens hProgramWF hCtxProcs hCalls hResolve
    segment hPc hRel hEval
  exact
    hPreserves (fuel := fuel) (source := source) (outcome := outcome)
      (target := target) (tokens := tokens)
      hLt hProgramWF hCtxProcs hCalls hResolve segment hPc hRel hEval

theorem callObligationUpTo_mono {program : Program}
    {layout : ProgramLayout program} {small big : Nat}
    (hLe : small ≤ big)
    (hCall : CallObligationUpTo layout big) :
    CallObligationUpTo layout small := by
  constructor
  intro ctx supply name
  exact
    stmtPreservesInProgramLayoutUpTo_mono
      (layout := layout) (small := small) (big := big)
      (ctx := ctx) (supply := supply) (stmt := .call name) hLe
      hCall.preserves

theorem stmt_preserves_upTo_of_preserves {program : Program}
    {layout : ProgramLayout program} {maxFuel : Nat}
    {ctx : CompileContext} {supply : LabelSupply} {stmt : Stmt}
    (hPreserves : StmtPreservesInProgramLayout layout ctx supply stmt) :
    StmtPreservesInProgramLayoutUpTo layout maxFuel ctx supply stmt := by
  intro fuel source outcome target tokens _hLt hProgramWF hCtxProcs hCalls
    hResolve segment hPc hRel hEval
  exact
    hPreserves hProgramWF hCtxProcs hCalls hResolve segment hPc hRel hEval

theorem block_preserves_upTo_of_preserves {program : Program}
    {layout : ProgramLayout program} {maxFuel : Nat}
    {ctx : CompileContext} {supply : LabelSupply} {block : Block}
    (hPreserves : BlockPreservesInProgramLayout layout ctx supply block) :
    BlockPreservesInProgramLayoutUpTo layout maxFuel ctx supply block := by
  intro fuel source outcome target tokens _hLt hProgramWF hCtxProcs hCalls
    hResolve segment hPc hRel hEval
  exact
    hPreserves hProgramWF hCtxProcs hCalls hResolve segment hPc hRel hEval

theorem preserves_cons_in_programLayout_upTo {program : Program}
    {layout : ProgramLayout program} {maxFuel : Nat}
    {ctx : CompileContext} {supply : LabelSupply}
    {stmt : Stmt} {rest : List Stmt}
    (hStmt : StmtPreservesInProgramLayoutUpTo layout maxFuel ctx supply stmt)
    (hRest :
      BlockPreservesInProgramLayoutUpTo layout maxFuel ctx
        (Stmt.compileFromCtxCore stmt ctx supply).next { stmts := rest }) :
    BlockPreservesInProgramLayoutUpTo layout maxFuel ctx supply
      { stmts := stmt :: rest } := by
  intro fuel source outcome target tokens hLt hProgramWF hCtxProcs hCalls
    hResolve segment hPc hRel hEval
  let compiledStmt := Stmt.compileFromCtxCore stmt ctx supply
  let compiledRest :=
    Block.compileFromCtx { stmts := rest } ctx compiledStmt.next
  have hCodeEq :
      (Block.compileFromCtx { stmts := stmt :: rest } ctx supply).code =
        compiledStmt.code ++ compiledRest.code := by
    simp [Block.compileFromCtx, CompileResult.append,
      compiledStmt, compiledRest]
  have hCallsEq :
      (Block.compileFromCtx { stmts := stmt :: rest } ctx supply).calls =
        compiledStmt.calls ++ compiledRest.calls := by
    simp [Block.compileFromCtx, CompileResult.append,
      compiledStmt, compiledRest]
  let appendSeg :
      CodeSegment layout.asm (compiledStmt.code ++ compiledRest.code) :=
    CodeSegment.cast_code hCodeEq segment
  let stmtSeg : CodeSegment layout.asm compiledStmt.code :=
    CodeSegment.left appendSeg
  let restSeg : CodeSegment layout.asm compiledRest.code :=
    CodeSegment.right appendSeg
  have hCallsAppend :
      CallsIncluded (compiledStmt.calls ++ compiledRest.calls) layout.sites := by
    simpa [hCallsEq] using hCalls
  have hStmtCalls : CallsIncluded compiledStmt.calls layout.sites :=
    CallsIncluded.left hCallsAppend
  have hRestCalls : CallsIncluded compiledRest.calls layout.sites :=
    CallsIncluded.right hCallsAppend
  have hStmtPc : target.pc = stmtSeg.startPc := by
    simpa [stmtSeg, appendSeg, CodeSegment.startPc, CodeSegment.left,
      CodeSegment.cast_code] using hPc
  have hRestFallthrough :
      restSeg.fallthroughPc = segment.fallthroughPc := by
    simp [restSeg, appendSeg, CodeSegment.fallthroughPc, CodeSegment.right,
      CodeSegment.cast_code, hCodeEq, List.append_assoc]
  cases hEval with
  | cons_regular hStmtEval hRestEval =>
      rename_i innerFuel mid
      have hInnerLt : innerFuel < maxFuel := by omega
      have hStmtRun :=
        hStmt (fuel := innerFuel) (source := source)
          (outcome := Outcome.regular mid) (target := target)
          (tokens := tokens) hInnerLt hProgramWF hCtxProcs
          (by simpa [compiledStmt] using hStmtCalls)
          hResolve
          (by simpa [compiledStmt] using stmtSeg)
          hStmtPc hRel hStmtEval
      have hStmtRunRegular :
          ARunResult layout.asm target
            (fun result =>
              match result with
              | .running targetMid =>
                  Frame.StateRel mid targetMid tokens ∧
                    targetMid.pc = restSeg.startPc
              | .halted _ => False) := by
        exact
          ARunResult.mono hStmtRun
            (by
              intro result hResult
              cases result with
              | halted halt =>
                  cases hResult
              | running targetMid =>
                  rcases hResult with ⟨hRelMid, hPcMid⟩
                  exact ⟨hRelMid, by
                    simpa [stmtSeg, restSeg, appendSeg,
                      CodeSegment.startPc, CodeSegment.fallthroughPc,
                      CodeSegment.left, CodeSegment.right,
                      CodeSegment.cast_code, List.append_assoc] using
                      hPcMid⟩)
      refine
        ARunResult.bind_running
          (program := layout.asm)
          (middle := fun targetMid =>
            Frame.StateRel mid targetMid tokens ∧
              targetMid.pc = restSeg.startPc)
          hStmtRunRegular ?_
      intro targetMid hMid
      have hRestRun :=
        hRest (fuel := innerFuel) (source := mid) (outcome := outcome)
          (target := targetMid) (tokens := tokens) hInnerLt
          hProgramWF hCtxProcs
          (by simpa [compiledRest] using hRestCalls)
          hResolve
          (by simpa [compiledRest] using restSeg)
          hMid.2 hMid.1 hRestEval
      exact
        ARunResult.mono hRestRun
          (by
            intro result hResult
            simpa [hRestFallthrough] using hResult)
  | cons_brk hStmtEval =>
      rename_i innerFuel outState
      have hInnerLt : innerFuel < maxFuel := by omega
      have hStmtRun :=
        hStmt (fuel := innerFuel) (source := source)
          (outcome := Outcome.brk outState) (target := target)
          (tokens := tokens) hInnerLt hProgramWF hCtxProcs
          (by simpa [compiledStmt] using hStmtCalls)
          hResolve
          (by simpa [compiledStmt] using stmtSeg)
          hStmtPc hRel hStmtEval
      exact
        ARunResult.mono hStmtRun
          (by
            intro result hResult
            cases result with
            | running target' =>
                simpa [CompiledOutcomeRel, Outcome.brk] using hResult
            | halted halt =>
                cases hResult)
  | cons_cont hStmtEval =>
      rename_i innerFuel outState
      have hInnerLt : innerFuel < maxFuel := by omega
      have hStmtRun :=
        hStmt (fuel := innerFuel) (source := source)
          (outcome := Outcome.cont outState) (target := target)
          (tokens := tokens) hInnerLt hProgramWF hCtxProcs
          (by simpa [compiledStmt] using hStmtCalls)
          hResolve
          (by simpa [compiledStmt] using stmtSeg)
          hStmtPc hRel hStmtEval
      exact
        ARunResult.mono hStmtRun
          (by
            intro result hResult
            cases result with
            | running target' =>
                simpa [CompiledOutcomeRel, Outcome.cont] using hResult
            | halted halt =>
                cases hResult)
  | cons_leave hStmtEval =>
      rename_i innerFuel outState
      have hInnerLt : innerFuel < maxFuel := by omega
      have hStmtRun :=
        hStmt (fuel := innerFuel) (source := source)
          (outcome := Outcome.leave outState) (target := target)
          (tokens := tokens) hInnerLt hProgramWF hCtxProcs
          (by simpa [compiledStmt] using hStmtCalls)
          hResolve
          (by simpa [compiledStmt] using stmtSeg)
          hStmtPc hRel hStmtEval
      exact
        ARunResult.mono hStmtRun
          (by
            intro result hResult
            cases result with
            | running target' =>
                simpa [CompiledOutcomeRel, Outcome.leave] using hResult
            | halted halt =>
                cases hResult)
  | cons_halt hStmtEval =>
      rename_i innerFuel outState kind
      have hInnerLt : innerFuel < maxFuel := by omega
      have hStmtRun :=
        hStmt (fuel := innerFuel) (source := source)
          (outcome := Outcome.halt kind outState) (target := target)
          (tokens := tokens) hInnerLt hProgramWF hCtxProcs
          (by simpa [compiledStmt] using hStmtCalls)
          hResolve
          (by simpa [compiledStmt] using stmtSeg)
          hStmtPc hRel hStmtEval
      exact
        ARunResult.mono hStmtRun
          (by
            intro result hResult
            cases result with
            | running target' =>
                cases hResult
            | halted halt =>
                simpa [CompiledOutcomeRel, Outcome.halt] using hResult)

theorem preserves_if_in_programLayout_upTo {program : Program}
    {layout : ProgramLayout program} {maxFuel : Nat}
    {ctx : CompileContext} {supply : LabelSupply}
    {cond : Code} {body : Block}
    (hCondSafe : Code.RunnerSafe cond)
    (hCondFrame : Code.FrameSafe cond)
    (hBody :
      BlockPreservesInProgramLayoutUpTo layout maxFuel ctx
        (LabelSupply.next supply) body) :
    StmtPreservesInProgramLayoutUpTo layout maxFuel ctx supply (.if_ cond body) := by
  intro fuel source outcome target tokens hLt hProgramWF hCtxProcs hCalls
    hResolve segment hPc hRel hEval
  let pre := segment.pre
  let post := segment.post
  let bodyLabel := LabelSupply.label supply 0
  let endLabel := LabelSupply.label supply 1
  let compiledBody := Block.compileFromCtx body ctx (LabelSupply.next supply)
  let preAfterJumpi : Assembly.Program :=
    pre ++ cond.toAssembly ++ [Assembly.Instr.jumpi bodyLabel]
  let preBodyLabel : Assembly.Program :=
    pre ++ cond.toAssembly ++
      [Assembly.Instr.jumpi bodyLabel, Assembly.Instr.jump endLabel]
  let preBody : Assembly.Program :=
    pre ++ cond.toAssembly ++
      [ Assembly.Instr.jumpi bodyLabel
      , Assembly.Instr.jump endLabel
      , Assembly.Instr.label bodyLabel
      ]
  let preEndLabel : Assembly.Program :=
    pre ++ cond.toAssembly ++
      [ Assembly.Instr.jumpi bodyLabel
      , Assembly.Instr.jump endLabel
      , Assembly.Instr.label bodyLabel
      ] ++
      compiledBody.code
  have hLocalAsm :
      pre ++ (Stmt.compileFromCtxCore (.if_ cond body) ctx supply).code ++
        post =
        layout.asm := by
    simpa [pre, post] using segment.hAsm.symm
  have hFitsIf :
      AssemblyProgram.PCFitsFrom pre
        (cond.toAssembly ++
          [ Assembly.Instr.jumpi bodyLabel
          , Assembly.Instr.jump endLabel
          , Assembly.Instr.label bodyLabel
          ] ++
          compiledBody.code ++ [Assembly.Instr.label endLabel]) := by
    simpa [pre, Stmt.compileFromCtxCore, bodyLabel, endLabel, compiledBody]
      using segment.hFits
  have hCondAsmFits :
      AssemblyProgram.PCFitsFrom pre cond.toAssembly :=
    AssemblyProgram.PCFitsFrom.left (pre := pre)
      (first := cond.toAssembly)
      (second :=
        [ Assembly.Instr.jumpi bodyLabel
        , Assembly.Instr.jump endLabel
        , Assembly.Instr.label bodyLabel
        ] ++ compiledBody.code ++ [Assembly.Instr.label endLabel])
      (by simpa [List.append_assoc] using hFitsIf)
  have hCondFits : Code.PCFitsFrom pre cond :=
    Code.PCFitsFrom.of_assembly hCondAsmFits
  have hJumpEndFit : PCFits preAfterJumpi := by
    have hPrefix :
        AssemblyProgram.PCFitsFrom pre
          (cond.toAssembly ++ [Assembly.Instr.jumpi bodyLabel]) :=
      AssemblyProgram.PCFitsFrom.left (pre := pre)
        (first := cond.toAssembly ++ [Assembly.Instr.jumpi bodyLabel])
        (second :=
          [Assembly.Instr.jump endLabel, Assembly.Instr.label bodyLabel] ++
            compiledBody.code ++ [Assembly.Instr.label endLabel])
        (by simpa [List.append_assoc] using hFitsIf)
    simpa [preAfterJumpi, List.append_assoc] using
      AssemblyProgram.PCFitsFrom.end hPrefix
  have hBodyLabelFit : PCFits preBodyLabel := by
    have hPrefix :
        AssemblyProgram.PCFitsFrom pre
          (cond.toAssembly ++
            [Assembly.Instr.jumpi bodyLabel, Assembly.Instr.jump endLabel]) :=
      AssemblyProgram.PCFitsFrom.left (pre := pre)
        (first :=
          cond.toAssembly ++
            [Assembly.Instr.jumpi bodyLabel, Assembly.Instr.jump endLabel])
        (second :=
          [Assembly.Instr.label bodyLabel] ++ compiledBody.code ++
            [Assembly.Instr.label endLabel])
        (by simpa [List.append_assoc] using hFitsIf)
    simpa [preBodyLabel, List.append_assoc] using
      AssemblyProgram.PCFitsFrom.end hPrefix
  have hEndLabelFit : PCFits preEndLabel := by
    have hPrefix :
        AssemblyProgram.PCFitsFrom pre
          (cond.toAssembly ++
            [ Assembly.Instr.jumpi bodyLabel
            , Assembly.Instr.jump endLabel
            , Assembly.Instr.label bodyLabel
            ] ++ compiledBody.code) :=
      AssemblyProgram.PCFitsFrom.left (pre := pre)
        (first :=
          cond.toAssembly ++
            [ Assembly.Instr.jumpi bodyLabel
            , Assembly.Instr.jump endLabel
            , Assembly.Instr.label bodyLabel
            ] ++ compiledBody.code)
        (second := [Assembly.Instr.label endLabel])
        (by simpa [List.append_assoc] using hFitsIf)
    simpa [preEndLabel, List.append_assoc] using
      AssemblyProgram.PCFitsFrom.end hPrefix
  have hBodyFits :
      AssemblyProgram.PCFitsFrom preBody compiledBody.code := by
    have hAfterBodyLabel :
        AssemblyProgram.PCFitsFrom preBody
          (compiledBody.code ++ [Assembly.Instr.label endLabel]) := by
      simpa [preBody, List.append_assoc] using
        AssemblyProgram.PCFitsFrom.right (pre := pre)
          (first :=
            cond.toAssembly ++
              [ Assembly.Instr.jumpi bodyLabel
              , Assembly.Instr.jump endLabel
              , Assembly.Instr.label bodyLabel
              ])
          (second := compiledBody.code ++ [Assembly.Instr.label endLabel])
          (by simpa [List.append_assoc] using hFitsIf)
    exact
      AssemblyProgram.PCFitsFrom.left (pre := preBody)
        (first := compiledBody.code)
        (second := [Assembly.Instr.label endLabel]) hAfterBodyLabel
  have hExactIf :
      ExactLabels
        (pre ++ cond.toAssembly ++
          [ Assembly.Instr.jumpi bodyLabel
          , Assembly.Instr.jump endLabel
          , Assembly.Instr.label bodyLabel
          ] ++
          compiledBody.code ++ [Assembly.Instr.label endLabel] ++ post) := by
    have hExactLocal :
        ExactLabels
          (pre ++ (Stmt.compileFromCtxCore (.if_ cond body) ctx supply).code ++
            post) :=
      ExactLabels.cast_asm hLocalAsm.symm layout.exactLabels
    simpa [Stmt.compileFromCtxCore, bodyLabel, endLabel, compiledBody,
      List.append_assoc] using hExactLocal
  have hBodyLabel :
      Assembly.Program.labelPc
          (pre ++ cond.toAssembly ++
            [Assembly.Instr.jumpi bodyLabel] ++
            ([Assembly.Instr.jump endLabel, Assembly.Instr.label bodyLabel] ++
              compiledBody.code ++ [Assembly.Instr.label endLabel] ++ post))
          bodyLabel =
        some (Assembly.Program.byteLength preBodyLabel) := by
    have hHere :=
      hExactIf.labelPc_at preBodyLabel bodyLabel
        (compiledBody.code ++ [Assembly.Instr.label endLabel] ++ post)
        (by simp [preBodyLabel, List.append_assoc])
    simpa [preBodyLabel, List.append_assoc] using hHere
  have hEndLabel :
      Assembly.Program.labelPc
          (preAfterJumpi ++ [Assembly.Instr.jump endLabel] ++
            ([Assembly.Instr.label bodyLabel] ++ compiledBody.code) ++
            [Assembly.Instr.label endLabel] ++ post)
          endLabel =
        some (Assembly.Program.byteLength preEndLabel) := by
    have hHere :=
      hExactIf.labelPc_at preEndLabel endLabel post
        (by simp [preEndLabel, List.append_assoc])
    simpa [preAfterJumpi, preEndLabel, List.append_assoc] using hHere
  have hBodyCalls : CallsIncluded compiledBody.calls layout.sites := by
    simpa [Stmt.compileFromCtxCore, bodyLabel, endLabel, compiledBody]
      using hCalls
  let bodySeg : CodeSegment layout.asm compiledBody.code :=
    { pre := preBody
      post := [Assembly.Instr.label endLabel] ++ post
      hAsm := by
        simpa [Stmt.compileFromCtxCore, bodyLabel, endLabel, compiledBody,
          pre, post, preBody, List.append_assoc] using segment.hAsm
      hFits := hBodyFits }
  cases hEval with
  | if_false hCondRun =>
      rename_i stateAfterCond
      have hCondJump :=
        Frame.StateRel.runCondition_jumpi_result_ctx
          (code := cond) (label := bodyLabel)
          (dest := Assembly.Program.byteLength preBodyLabel)
          (pre := pre)
          (post :=
            [Assembly.Instr.jump endLabel, Assembly.Instr.label bodyLabel] ++
              compiledBody.code ++ [Assembly.Instr.label endLabel] ++ post)
          hCondSafe hCondFrame hCondFits
          (by simpa [pre, CodeSegment.startPc] using hPc)
          hRel hBodyLabel hCondRun
      have hCondFalseLocal :
          ARunResult
            (pre ++
              (Stmt.compileFromCtxCore (.if_ cond body) ctx supply).code ++ post)
            target
            (fun result =>
              match result with
              | .running targetAfterCond =>
                  Frame.StateRel stateAfterCond targetAfterCond tokens ∧
                    targetAfterCond.pc = Assembly.Program.pcAfter preAfterJumpi
              | .halted _ => False) := by
        exact ARunResult.mono
          (by
            simpa [Stmt.compileFromCtxCore, bodyLabel, endLabel, compiledBody,
              preAfterJumpi, List.append_assoc] using hCondJump)
          (by
            intro result hResult
            cases result with
            | halted halt =>
                cases hResult
            | running targetAfterCond =>
                simpa [preAfterJumpi] using hResult)
      have hCondFalse :
          ARunResult layout.asm target
            (fun result =>
              match result with
              | .running targetAfterCond =>
                  Frame.StateRel stateAfterCond targetAfterCond tokens ∧
                    targetAfterCond.pc = Assembly.Program.pcAfter preAfterJumpi
              | .halted _ => False) :=
        ARunResult.cast_program hLocalAsm hCondFalseLocal
      refine
        ARunResult.bind_running
          (program := layout.asm)
          (middle := fun targetAfterCond =>
            Frame.StateRel stateAfterCond targetAfterCond tokens ∧
              targetAfterCond.pc = Assembly.Program.pcAfter preAfterJumpi)
          hCondFalse ?_
      intro targetAfterCond hAfterCond
      have hJumpEnd :=
        Frame.StateRel.jump_then_label_runResult_at
          (label := endLabel) (pre := preAfterJumpi)
          (between := [Assembly.Instr.label bodyLabel] ++ compiledBody.code)
          (post := post)
          hJumpEndFit
          (by simpa [preAfterJumpi, preEndLabel, List.append_assoc]
            using hEndLabelFit)
          hAfterCond.2 hAfterCond.1
          (by simpa [preAfterJumpi, preEndLabel, List.append_assoc]
            using hEndLabel)
      have hJumpEndLocal :
          ARunResult
            (pre ++
              (Stmt.compileFromCtxCore (.if_ cond body) ctx supply).code ++ post)
            targetAfterCond
            (fun result =>
              CompiledOutcomeRel layout.asm ctx segment.fallthroughPc
                (Outcome.regular stateAfterCond) result tokens) := by
        exact ARunResult.mono
          (by
            simpa [Stmt.compileFromCtxCore, bodyLabel, endLabel, compiledBody,
              preAfterJumpi, preEndLabel, List.append_assoc] using hJumpEnd)
          (by
            intro result hResult
            cases result with
            | halted halt =>
                cases hResult
            | running targetFinal =>
                simpa [pre, post, Stmt.compileFromCtxCore, bodyLabel, endLabel,
                  compiledBody, preAfterJumpi, preEndLabel,
                  CompiledOutcomeRel, Outcome.regular,
                  CodeSegment.fallthroughPc, List.append_assoc] using hResult)
      exact ARunResult.cast_program hLocalAsm hJumpEndLocal
  | if_true hCondRun hBodyEval =>
      rename_i stateAfterCond
      have hCondJump :=
        Frame.StateRel.runCondition_jumpi_result_ctx
          (code := cond) (label := bodyLabel)
          (dest := Assembly.Program.byteLength preBodyLabel)
          (pre := pre)
          (post :=
            [Assembly.Instr.jump endLabel, Assembly.Instr.label bodyLabel] ++
              compiledBody.code ++ [Assembly.Instr.label endLabel] ++ post)
          hCondSafe hCondFrame hCondFits
          (by simpa [pre, CodeSegment.startPc] using hPc)
          hRel hBodyLabel hCondRun
      have hCondTrueLocal :
          ARunResult
            (pre ++
              (Stmt.compileFromCtxCore (.if_ cond body) ctx supply).code ++ post)
            target
            (fun result =>
              match result with
              | .running targetAfterCond =>
                  Frame.StateRel stateAfterCond targetAfterCond tokens ∧
                    targetAfterCond.pc = Assembly.Program.pcAfter preBodyLabel
              | .halted _ => False) := by
        exact ARunResult.mono
          (by
            simpa [Stmt.compileFromCtxCore, bodyLabel, endLabel, compiledBody,
              preBodyLabel, List.append_assoc] using hCondJump)
          (by
            intro result hResult
            cases result with
            | halted halt =>
                cases hResult
            | running targetAfterCond =>
                simpa [preBodyLabel] using hResult)
      have hCondTrue :
          ARunResult layout.asm target
            (fun result =>
              match result with
              | .running targetAfterCond =>
                  Frame.StateRel stateAfterCond targetAfterCond tokens ∧
                    targetAfterCond.pc = Assembly.Program.pcAfter preBodyLabel
              | .halted _ => False) :=
        ARunResult.cast_program hLocalAsm hCondTrueLocal
      refine
        ARunResult.bind_running
          (program := layout.asm)
          (middle := fun targetAfterCond =>
            Frame.StateRel stateAfterCond targetAfterCond tokens ∧
              targetAfterCond.pc = Assembly.Program.pcAfter preBodyLabel)
          hCondTrue ?_
      intro targetAfterCond hAfterCond
      have hBodyLabelRun :=
        Frame.StateRel.label_runResult_at
          (label := bodyLabel) (pre := preBodyLabel)
          (post := compiledBody.code ++ [Assembly.Instr.label endLabel] ++ post)
          hBodyLabelFit hAfterCond.2 hAfterCond.1
      have hBodyLabelRunLocal :
          ARunResult
            (pre ++
              (Stmt.compileFromCtxCore (.if_ cond body) ctx supply).code ++ post)
            targetAfterCond
            (fun result =>
              match result with
              | .running targetAtBody =>
                  Frame.StateRel stateAfterCond targetAtBody tokens ∧
                    targetAtBody.pc = Assembly.Program.pcAfter preBody
              | .halted _ => False) := by
        simpa [Stmt.compileFromCtxCore, bodyLabel, endLabel, compiledBody,
          preBodyLabel, preBody, List.append_assoc] using hBodyLabelRun
      have hBodyLabelRun' :
          ARunResult layout.asm targetAfterCond
            (fun result =>
              match result with
              | .running targetAtBody =>
                  Frame.StateRel stateAfterCond targetAtBody tokens ∧
                    targetAtBody.pc = Assembly.Program.pcAfter preBody
              | .halted _ => False) :=
        ARunResult.cast_program hLocalAsm hBodyLabelRunLocal
      refine
        ARunResult.bind_running
          (program := layout.asm)
          (middle := fun targetAtBody =>
            Frame.StateRel stateAfterCond targetAtBody tokens ∧
              targetAtBody.pc = Assembly.Program.pcAfter preBody)
          hBodyLabelRun' ?_
      intro targetAtBody hAtBody
      have hBodyRun :=
        hBody (source := stateAfterCond) (outcome := outcome)
          (target := targetAtBody) (tokens := tokens)
          (by omega) hProgramWF hCtxProcs hBodyCalls hResolve bodySeg
          (by simpa [bodySeg, CodeSegment.startPc] using hAtBody.2)
          hAtBody.1 hBodyEval
      cases outcome with
      | mk outState outMode =>
          cases outMode with
          | regular =>
              have hBodyRegular :
                  ARunResult layout.asm targetAtBody
                    (fun result =>
                      match result with
                      | .running targetBeforeEnd =>
                          Frame.StateRel outState targetBeforeEnd tokens ∧
                            targetBeforeEnd.pc =
                              Assembly.Program.pcAfter
                                (preBody ++ compiledBody.code)
                      | .halted _ => False) := by
                exact ARunResult.mono hBodyRun (by
                  intro result hResult
                  cases result with
                  | halted halt =>
                      cases hResult
                  | running targetBeforeEnd =>
                      simpa [bodySeg, CodeSegment.fallthroughPc,
                        CompiledOutcomeRel, Outcome.regular, preEndLabel,
                        List.append_assoc] using hResult)
              refine
                ARunResult.bind_running
                  (program := layout.asm)
                  (middle := fun targetBeforeEnd =>
                    Frame.StateRel outState targetBeforeEnd tokens ∧
                      targetBeforeEnd.pc =
                        Assembly.Program.pcAfter
                          (preBody ++ compiledBody.code))
                  hBodyRegular ?_
              intro targetBeforeEnd hBeforeEnd
              have hEndRun :=
                Frame.StateRel.label_runResult_at
                  (label := endLabel) (pre := preEndLabel) (post := post)
                  hEndLabelFit (by
                    simpa [preEndLabel, preBody, List.append_assoc]
                      using hBeforeEnd.2)
                  hBeforeEnd.1
              have hEndRunLocal :
                  ARunResult
                    (pre ++
                      (Stmt.compileFromCtxCore (.if_ cond body) ctx supply).code ++
                        post)
                    targetBeforeEnd
                    (fun result =>
                      CompiledOutcomeRel layout.asm ctx segment.fallthroughPc
                        (Outcome.regular outState) result tokens) := by
                exact ARunResult.mono
                  (by
                    simpa [Stmt.compileFromCtxCore, bodyLabel, endLabel,
                      compiledBody, preEndLabel, List.append_assoc]
                      using hEndRun)
                  (by
                    intro result hResult
                    cases result with
                    | halted halt =>
                        cases hResult
                    | running targetFinal =>
                        simpa [pre, post, Stmt.compileFromCtxCore, bodyLabel,
                          endLabel, compiledBody, preEndLabel,
                          CompiledOutcomeRel, Outcome.regular,
                          CodeSegment.fallthroughPc, List.append_assoc]
                          using hResult)
              exact ARunResult.cast_program hLocalAsm hEndRunLocal
          | brk =>
              exact ARunResult.mono hBodyRun (by
                intro result hResult
                cases result with
                | running target' =>
                    simpa [bodySeg, CodeSegment.fallthroughPc,
                      CompiledOutcomeRel, Outcome.brk] using hResult
                | halted halt =>
                    cases hResult)
          | cont =>
              exact ARunResult.mono hBodyRun (by
                intro result hResult
                cases result with
                | running target' =>
                    simpa [bodySeg, CodeSegment.fallthroughPc,
                      CompiledOutcomeRel, Outcome.cont] using hResult
                | halted halt =>
                    cases hResult)
          | leave =>
              exact ARunResult.mono hBodyRun (by
                intro result hResult
                cases result with
                | running target' =>
                    simpa [bodySeg, CodeSegment.fallthroughPc,
                      CompiledOutcomeRel, Outcome.leave] using hResult
                | halted halt =>
                    cases hResult)
          | halt kind =>
              exact ARunResult.mono hBodyRun (by
                intro result hResult
                cases result with
                | running target' =>
                    cases hResult
                | halted halt =>
                    simpa [bodySeg, CodeSegment.fallthroughPc,
                      CompiledOutcomeRel, Outcome.halt] using hResult)

set_option maxHeartbeats 800000 in
theorem preserves_for_in_programLayout_upTo {program : Program}
    {layout : ProgramLayout program} {maxFuel : Nat}
    {ctx : CompileContext} {supply : LabelSupply}
    {init post body : Block} {cond : Code}
    (hCondSafe : Code.RunnerSafe cond)
    (hCondFrame : Code.FrameSafe cond)
    (hInit :
      BlockPreservesInProgramLayoutUpTo layout maxFuel
        { ctx with breakLabel? := none, continueLabel? := none }
        (LabelSupply.next supply) init)
    (hBody :
      BlockPreservesInProgramLayoutUpTo layout maxFuel
        { ctx with
          breakLabel? := some (LabelSupply.label supply 3)
          continueLabel? := some (LabelSupply.label supply 2) }
        (Block.compileFromCtx init
          { ctx with breakLabel? := none, continueLabel? := none }
          (LabelSupply.next supply)).next
        body)
    (hPost :
      BlockPreservesInProgramLayoutUpTo layout maxFuel
        { ctx with breakLabel? := none, continueLabel? := none }
        (Block.compileFromCtx body
          { ctx with
            breakLabel? := some (LabelSupply.label supply 3)
            continueLabel? := some (LabelSupply.label supply 2) }
          (Block.compileFromCtx init
            { ctx with breakLabel? := none, continueLabel? := none }
            (LabelSupply.next supply)).next).next
        post) :
    StmtPreservesInProgramLayoutUpTo layout maxFuel ctx supply
      (.for_ init cond post body) := by
  intro fuel source outcome target tokens hLt hProgramWF hCtxProcs hCalls
    hResolve segment hPc hRel hEval
  let loopLabel := LabelSupply.label supply 0
  let bodyLabel := LabelSupply.label supply 1
  let postLabel := LabelSupply.label supply 2
  let endLabel := LabelSupply.label supply 3
  let loopOuterCtx : CompileContext :=
    { ctx with breakLabel? := none, continueLabel? := none }
  let compiledInit :=
    Block.compileFromCtx init loopOuterCtx (LabelSupply.next supply)
  let bodyCtx : CompileContext :=
    { ctx with
      breakLabel? := some endLabel
      continueLabel? := some postLabel }
  let compiledBody := Block.compileFromCtx body bodyCtx compiledInit.next
  let compiledPost := Block.compileFromCtx post loopOuterCtx compiledBody.next
  let coreCode :=
    ForLoop.coreCode cond compiledBody.code compiledPost.code loopLabel
      bodyLabel postLabel endLabel
  have hCodeEq :
      (Stmt.compileFromCtxCore (.for_ init cond post body) ctx supply).code =
        compiledInit.code ++ coreCode := by
    simp [Stmt.compileFromCtxCore, loopLabel, bodyLabel, postLabel, endLabel,
      loopOuterCtx, bodyCtx, compiledInit, compiledBody, compiledPost,
      coreCode, ForLoop.coreCode, List.append_assoc]
  let appendSeg : CodeSegment layout.asm (compiledInit.code ++ coreCode) :=
    CodeSegment.cast_code hCodeEq segment
  let initSeg : CodeSegment layout.asm compiledInit.code :=
    CodeSegment.left appendSeg
  let coreSeg : CodeSegment layout.asm coreCode :=
    CodeSegment.right appendSeg
  have hInitCalls :
      CallsIncluded compiledInit.calls layout.sites := by
    simpa [loopOuterCtx, compiledInit] using
      for_calls_included_init
        (ctx := ctx) (supply := supply) (init := init) (post := post)
        (body := body) (cond := cond) hCalls
  have hBodyCalls :
      CallsIncluded compiledBody.calls layout.sites := by
    simpa [loopOuterCtx, bodyCtx, compiledInit, compiledBody] using
      for_calls_included_body
        (ctx := ctx) (supply := supply) (init := init) (post := post)
        (body := body) (cond := cond) hCalls
  have hPostCalls :
      CallsIncluded compiledPost.calls layout.sites := by
    simpa [loopOuterCtx, bodyCtx, compiledInit, compiledBody, compiledPost]
      using
        for_calls_included_post
          (ctx := ctx) (supply := supply) (init := init) (post := post)
          (body := body) (cond := cond) hCalls
  have hLoopOuterResolve :
      ContextLabelsResolve layout.asm loopOuterCtx :=
    ContextLabelsResolve.without_break_continue
      (ctx := ctx) hResolve
  have hInitPc : target.pc = initSeg.startPc := by
    simpa [initSeg, appendSeg, CodeSegment.startPc, CodeSegment.left,
      CodeSegment.cast_code] using hPc
  have hCoreFallthrough :
      coreSeg.fallthroughPc = segment.fallthroughPc := by
    simp [coreSeg, appendSeg, CodeSegment.fallthroughPc, CodeSegment.right,
      CodeSegment.cast_code, hCodeEq, List.append_assoc]
  let outerFuel := fuel
  cases hEval with
  | for_init_regular hInitEval hLoopEval =>
      rename_i initState
      have hInitRun :=
        hInit (source := source) (outcome := Outcome.regular initState)
          (target := target) (tokens := tokens)
          (by omega) hProgramWF
          (by simpa [loopOuterCtx] using hCtxProcs)
          hInitCalls hLoopOuterResolve initSeg
          hInitPc hRel hInitEval
      have hInitRegular :
          ARunResult layout.asm target
            (fun result =>
              match result with
              | .running targetAfterInit =>
                  Frame.StateRel initState targetAfterInit tokens ∧
                    targetAfterInit.pc = coreSeg.startPc
              | .halted _ => False) := by
        exact
          ARunResult.mono hInitRun
            (by
              intro result hResult
              cases result with
              | halted halt =>
                  cases hResult
              | running targetAfterInit =>
                  rcases hResult with ⟨hRelInit, hPcInit⟩
                  exact
                    ⟨hRelInit, by
                      simpa [initSeg, coreSeg, appendSeg, CodeSegment.startPc,
                        CodeSegment.fallthroughPc, CodeSegment.left,
                        CodeSegment.right, CodeSegment.cast_code, hCodeEq,
                        List.append_assoc] using hPcInit⟩)
      refine
        ARunResult.bind_running
          (program := layout.asm)
          (middle := fun targetAfterInit =>
            Frame.StateRel initState targetAfterInit tokens ∧
              targetAfterInit.pc = coreSeg.startPc)
          hInitRegular ?_
      intro targetAfterInit hAfterInit
      have hLoopRun :=
        for_eval_in_programLayout
          (program := program) (layout := layout) (ctx := ctx)
          (cond := cond) (body := body) (post := post)
          (bodySupply := compiledInit.next) (postSupply := compiledBody.next)
          (loopLabel := loopLabel) (bodyLabel := bodyLabel)
          (postLabel := postLabel) (endLabel := endLabel)
          (maxFuel := maxFuel)
          hCondSafe hCondFrame
          (fun {_bodyFuel} hBodyFuelLt =>
            blockPreservesInProgramLayoutAtFuel_of_upTo hBodyFuelLt hBody)
          (fun {_postFuel} hPostFuelLt =>
            blockPreservesInProgramLayoutAtFuel_of_upTo hPostFuelLt hPost)
          (bodyCode := compiledBody.code) (postCode := compiledPost.code)
          (source := initState) (outcome := outcome)
          (target := targetAfterInit) (tokens := tokens)
          rfl rfl
          (by omega)
          (by simpa [coreCode] using coreSeg)
          hProgramWF hCtxProcs
          hBodyCalls
          hPostCalls
          hResolve hAfterInit.2 hAfterInit.1 hLoopEval
      exact
        ARunResult.mono hLoopRun
          (by
            intro result hResult
            simpa [hCoreFallthrough] using hResult)
  | for_init_leave hInitEval =>
      rename_i outState
      have hInitRun :=
        hInit (source := source) (outcome := Outcome.leave outState)
          (target := target) (tokens := tokens)
          (by omega) hProgramWF
          (by simpa [loopOuterCtx] using hCtxProcs)
          hInitCalls hLoopOuterResolve initSeg
          hInitPc hRel hInitEval
      exact
        ARunResult.mono hInitRun
          (by
            intro result hResult
            cases result with
            | running target' =>
                simpa [loopOuterCtx, CompiledOutcomeRel, Outcome.leave]
                  using hResult
            | halted halt =>
                cases hResult)
  | for_init_halt hInitEval =>
      rename_i outState kind
      have hInitRun :=
        hInit (source := source) (outcome := Outcome.halt kind outState)
          (target := target) (tokens := tokens)
          (by omega) hProgramWF
          (by simpa [loopOuterCtx] using hCtxProcs)
          hInitCalls hLoopOuterResolve initSeg
          hInitPc hRel hInitEval
      exact
        ARunResult.mono hInitRun
          (by
            intro result hResult
            cases result with
            | running target' =>
                cases hResult
            | halted halt =>
                simpa [loopOuterCtx, CompiledOutcomeRel, Outcome.halt]
                  using hResult)


def SwitchCasesPreservesInProgramLayoutUpTo {program : Program}
    (layout : ProgramLayout program) (maxFuel : Nat) (ctx : CompileContext)
    (endLabel : Assembly.Label) (base supply : LabelSupply) :
    Nat → List (Word × Block) → Prop
  | _idx, [] => True
  | idx, (_value, body) :: rest =>
      let bodySupply := supply
      let compiledBody := Block.compileFromCtx body ctx bodySupply
      BlockPreservesInProgramLayoutUpTo layout maxFuel ctx bodySupply body ∧
        SwitchCasesPreservesInProgramLayoutUpTo layout maxFuel ctx endLabel base
          compiledBody.next (idx + 1) rest

def SwitchDefaultPreservesInProgramLayoutUpTo {program : Program}
    (layout : ProgramLayout program) (maxFuel : Nat) (ctx : CompileContext)
    (supply : LabelSupply) : Option Block → Prop
  | none => True
  | some body => BlockPreservesInProgramLayoutUpTo layout maxFuel ctx supply body

theorem switchCasesPreservesInProgramLayoutUpTo_head {program : Program}
    {layout : ProgramLayout program} {maxFuel : Nat} {ctx : CompileContext}
    {endLabel : Assembly.Label} {base supply idx : LabelSupply}
    {value : Word} {body : Block} {rest : List (Word × Block)}
    (hCases :
      SwitchCasesPreservesInProgramLayoutUpTo layout maxFuel ctx endLabel base
        supply idx ((value, body) :: rest)) :
    BlockPreservesInProgramLayoutUpTo layout maxFuel ctx supply body := by
  exact hCases.1

theorem switchCasesPreservesInProgramLayoutUpTo_tail {program : Program}
    {layout : ProgramLayout program} {maxFuel : Nat} {ctx : CompileContext}
    {endLabel : Assembly.Label} {base supply idx : LabelSupply}
    {value : Word} {body : Block} {rest : List (Word × Block)}
    (hCases :
      SwitchCasesPreservesInProgramLayoutUpTo layout maxFuel ctx endLabel base
        supply idx ((value, body) :: rest)) :
    SwitchCasesPreservesInProgramLayoutUpTo layout maxFuel ctx endLabel base
      (Block.compileFromCtx body ctx supply).next (idx + 1) rest := by
  exact hCases.2

theorem switchDefaultPreservesInProgramLayoutUpTo_some {program : Program}
    {layout : ProgramLayout program} {maxFuel : Nat} {ctx : CompileContext}
    {supply : LabelSupply} {body : Block}
    (hDefault :
      SwitchDefaultPreservesInProgramLayoutUpTo layout maxFuel ctx supply
      (some body)) :
    BlockPreservesInProgramLayoutUpTo layout maxFuel ctx supply body := by
  exact hDefault

theorem switchCasesPreservesInProgramLayoutAtFuel_of_upTo
    {program : Program}
    {layout : ProgramLayout program} {maxFuel fuel : Nat}
    {ctx : CompileContext} {endLabel : Assembly.Label}
    {base supply idx : LabelSupply} {cases : List (Word × Block)}
    (hLt : fuel < maxFuel)
    (hCases :
      SwitchCasesPreservesInProgramLayoutUpTo layout maxFuel ctx endLabel base
        supply idx cases) :
    SwitchCasesPreservesInProgramLayoutAtFuel layout fuel ctx endLabel base
      supply idx cases := by
  induction cases generalizing supply idx with
  | nil =>
      trivial
  | cons head rest ih =>
      rcases head with ⟨value, body⟩
      constructor
      · exact
          blockPreservesInProgramLayoutAtFuel_of_upTo
            (layout := layout) (maxFuel := maxFuel) (fuel := fuel)
            (ctx := ctx) (supply := supply) (block := body)
            hLt
            (switchCasesPreservesInProgramLayoutUpTo_head hCases)
      · exact
          ih
            (by
              simpa using
                switchCasesPreservesInProgramLayoutUpTo_tail hCases)

theorem switchDefaultPreservesInProgramLayoutAtFuel_of_upTo
    {program : Program}
    {layout : ProgramLayout program} {maxFuel fuel : Nat}
    {ctx : CompileContext} {supply : LabelSupply}
    {defaultBody : Option Block}
    (hLt : fuel < maxFuel)
    (hDefault :
      SwitchDefaultPreservesInProgramLayoutUpTo layout maxFuel ctx supply
        defaultBody) :
    SwitchDefaultPreservesInProgramLayoutAtFuel layout fuel ctx supply
      defaultBody := by
  cases defaultBody with
  | none =>
      trivial
  | some body =>
      exact
        blockPreservesInProgramLayoutAtFuel_of_upTo
          (layout := layout) (maxFuel := maxFuel) (fuel := fuel)
          (ctx := ctx) (supply := supply) (block := body)
          hLt (switchDefaultPreservesInProgramLayoutUpTo_some hDefault)

theorem switchCasesPreservesInProgramLayoutUpTo_of_all {program : Program}
    {layout : ProgramLayout program} {maxFuel : Nat} {ctx : CompileContext}
    {endLabel : Assembly.Label} {base supply idx : LabelSupply}
    {cases : List (Word × Block)}
    (hAll :
      ∀ bodySupply value body,
        (value, body) ∈ cases →
          BlockPreservesInProgramLayoutUpTo layout maxFuel ctx bodySupply body) :
    SwitchCasesPreservesInProgramLayoutUpTo layout maxFuel ctx endLabel base
      supply idx cases := by
  induction cases generalizing supply idx with
  | nil =>
      trivial
  | cons head rest ih =>
      rcases head with ⟨value, body⟩
      constructor
      · exact hAll supply value body (by simp)
      · exact ih
          (by
            intro bodySupply value' body' hMem
            exact hAll bodySupply value' body' (by simp [hMem]))

set_option maxHeartbeats 800000 in
theorem preserves_switch_in_programLayout_upTo {program : Program}
    {layout : ProgramLayout program} {maxFuel : Nat}
    {ctx : CompileContext} {supply : LabelSupply}
    {scrutinee : Code} {cases : List (Word × Block)}
    {defaultBody : Option Block}
    (hScrutineeSafe : Code.RunnerSafe scrutinee)
    (hScrutineeFrame : Code.FrameSafe scrutinee)
    (hCases :
      SwitchCasesPreservesInProgramLayoutUpTo layout maxFuel ctx
        (LabelSupply.label supply 0) supply (LabelSupply.next supply) 0
        cases)
    (hDefault :
      SwitchDefaultPreservesInProgramLayoutUpTo layout maxFuel ctx
        (SwitchCases.compileFromCtx cases ctx (LabelSupply.label supply 0)
          supply (LabelSupply.next supply) 0).next defaultBody) :
    StmtPreservesInProgramLayoutUpTo layout maxFuel ctx supply
      (.switch scrutinee cases defaultBody) := by
  intro fuel source outcome target tokens hLt hProgramWF hCtxProcs hCalls
    hResolve segment hPc hRel hEval
  let pre := segment.pre
  let post := segment.post
  let endLabel := LabelSupply.label supply 0
  let defaultLabel := LabelSupply.label supply 1
  let compiledCases :=
    SwitchCases.compileFromCtx cases ctx endLabel supply
      (LabelSupply.next supply) 0
  let compiledDefault :=
    SwitchDefault.compileFromCtx defaultBody ctx endLabel defaultLabel
      compiledCases.next
  let preTests : Assembly.Program := pre ++ scrutinee.toAssembly
  let tailCode : Assembly.Program :=
    Stmt.switchTests supply 0 cases ++
      [Assembly.Instr.jump defaultLabel] ++ ([] : Assembly.Program) ++
      compiledCases.code ++ compiledDefault.code ++
      [Assembly.Instr.label endLabel]
  have hLocalAsm :
      pre ++
        (Stmt.compileFromCtxCore
          (.switch scrutinee cases defaultBody) ctx supply).code ++ post =
        layout.asm := by
    simpa [pre, post] using segment.hAsm.symm
  have hCallsAppend :
      CallsIncluded (compiledCases.calls ++ compiledDefault.calls)
        layout.sites := by
    simpa [Stmt.compileFromCtxCore, endLabel, defaultLabel, compiledCases,
      compiledDefault, List.append_assoc] using hCalls
  have hCaseCalls : CallsIncluded compiledCases.calls layout.sites :=
    CallsIncluded.left hCallsAppend
  have hDefaultCalls : CallsIncluded compiledDefault.calls layout.sites :=
    CallsIncluded.right hCallsAppend
  have hFitsSwitch :
      AssemblyProgram.PCFitsFrom pre
        (scrutinee.toAssembly ++
          Stmt.switchTests supply 0 cases ++
          [Assembly.Instr.jump defaultLabel] ++
          compiledCases.code ++ compiledDefault.code ++
          [Assembly.Instr.label endLabel]) := by
    simpa [pre, Stmt.compileFromCtxCore, endLabel, defaultLabel,
      compiledCases, compiledDefault, List.append_assoc] using segment.hFits
  have hScrutineeFitsAsm :
      AssemblyProgram.PCFitsFrom pre scrutinee.toAssembly :=
    AssemblyProgram.PCFitsFrom.left (pre := pre)
      (first := scrutinee.toAssembly)
      (second :=
        Stmt.switchTests supply 0 cases ++
          [Assembly.Instr.jump defaultLabel] ++
          compiledCases.code ++ compiledDefault.code ++
          [Assembly.Instr.label endLabel])
      (by simpa [List.append_assoc] using hFitsSwitch)
  have hScrutineeFits : Code.PCFitsFrom pre scrutinee :=
    Code.PCFitsFrom.of_assembly hScrutineeFitsAsm
  have hTailFits :
      AssemblyProgram.PCFitsFrom preTests tailCode := by
    have hRight :
        AssemblyProgram.PCFitsFrom preTests
          (Stmt.switchTests supply 0 cases ++
            [Assembly.Instr.jump defaultLabel] ++
            compiledCases.code ++ compiledDefault.code ++
            [Assembly.Instr.label endLabel]) := by
      simpa [preTests, List.append_assoc] using
        AssemblyProgram.PCFitsFrom.right (pre := pre)
          (first := scrutinee.toAssembly)
          (second :=
            Stmt.switchTests supply 0 cases ++
              [Assembly.Instr.jump defaultLabel] ++
              compiledCases.code ++ compiledDefault.code ++
              [Assembly.Instr.label endLabel])
          (by simpa [List.append_assoc] using hFitsSwitch)
    simpa [tailCode, List.append_assoc] using hRight
  have hExactLocal :
      ExactLabels
        (pre ++
          (Stmt.compileFromCtxCore
            (.switch scrutinee cases defaultBody) ctx supply).code ++ post) :=
    ExactLabels.cast_asm hLocalAsm.symm layout.exactLabels
  cases hEval with
  | switch_none hScrutinee hPop hSelect =>
      have hRunLocal :=
        SwitchPreservation.switch_none_result_ctx
          (ctx := ctx) (supply := supply) (scrutinee := scrutinee)
          (cases := cases) (defaultBody := defaultBody)
          (source := source) (stateAfterScrutinee := _)
          (target := target) (tokens := tokens)
          (stack := _) (value := _) (pre := pre) (post := post)
          hScrutineeSafe hScrutineeFrame
          (by simpa [pre] using segment.hFits)
          hExactLocal
          (by simpa [pre, CodeSegment.startPc] using hPc)
          hRel hScrutinee hPop hSelect
      exact
        ARunResult.cast_program_mono hLocalAsm hRunLocal
          (by
            intro result hResult
            cases result with
            | halted halt =>
                cases hResult
            | running targetState =>
                simpa [pre, post, CodeSegment.fallthroughPc,
                  Stmt.compileFromCtxCore, endLabel, defaultLabel,
                  compiledCases, compiledDefault, CompiledOutcomeRel,
                  Outcome.regular, List.append_assoc] using hResult)
  | switch_some hScrutinee hPop hStateAfterPop hSelect hBodyEval =>
      rename_i bodyFuel stateAfterScrutinee stateAfterPop stack value selected
      subst stateAfterPop
      have hScrutineeRunLocal :
          ARunResult
            (pre ++
              (Stmt.compileFromCtxCore
                (.switch scrutinee cases defaultBody) ctx supply).code ++ post)
            target
            (fun result =>
              match result with
              | .running targetAfterScrutinee =>
                  Frame.StateRel stateAfterScrutinee targetAfterScrutinee tokens ∧
                    targetAfterScrutinee.pc = Assembly.Program.pcAfter preTests
              | .halted _ => False) := by
        have hRun :=
          Frame.StateRel.source_run_code_ctx_result
            (source := source) (final := stateAfterScrutinee)
            (target := target) (tokens := tokens) (code := scrutinee)
            (pre := pre)
            (post :=
              Stmt.switchTests supply 0 cases ++
                [Assembly.Instr.jump defaultLabel] ++
                compiledCases.code ++ compiledDefault.code ++
                [Assembly.Instr.label endLabel] ++ post)
            hScrutineeSafe hScrutineeFrame hScrutineeFits
            (by simpa [pre, CodeSegment.startPc] using hPc)
            hRel hScrutinee
        simpa [Stmt.compileFromCtxCore, endLabel, defaultLabel, compiledCases,
          compiledDefault, preTests, List.append_assoc] using hRun
      have hScrutineeRun :
          ARunResult layout.asm target
            (fun result =>
              match result with
              | .running targetAfterScrutinee =>
                  Frame.StateRel stateAfterScrutinee targetAfterScrutinee tokens ∧
                    targetAfterScrutinee.pc = Assembly.Program.pcAfter preTests
              | .halted _ => False) :=
        ARunResult.cast_program hLocalAsm hScrutineeRunLocal
      refine
        ARunResult.bind_running
          (program := layout.asm)
          (middle := fun targetAfterScrutinee =>
            Frame.StateRel stateAfterScrutinee targetAfterScrutinee tokens ∧
              targetAfterScrutinee.pc = Assembly.Program.pcAfter preTests)
          hScrutineeRun ?_
      intro targetAfterScrutinee hAfterScrutinee
      let selectedSeg : CodeSegment layout.asm tailCode :=
        { pre := preTests
          post := post
          hAsm := by
            simpa [pre, post, preTests, tailCode, Stmt.compileFromCtxCore,
              endLabel, defaultLabel, compiledCases, compiledDefault,
              List.append_assoc] using segment.hAsm
          hFits := hTailFits }
      have hSelected :
          ARunResult layout.asm targetAfterScrutinee
            (fun result =>
              CompiledOutcomeRel layout.asm ctx selectedSeg.fallthroughPc
                outcome result tokens) := by
        refine
          selected_cases_result_ctx_in_programLayout
            (program := program) (layout := layout) (ctx := ctx)
            (base := supply) (supply := LabelSupply.next supply) (idx := 0)
            (cases := cases) (defaultBody := defaultBody)
            (selected := selected) (casePrefix := ([] : Assembly.Program))
            (defaultLabel := defaultLabel) (endLabel := endLabel)
            (fuel := bodyFuel)
            (source := stateAfterScrutinee) (outcome := outcome)
            (target := targetAfterScrutinee) (tokens := tokens)
            (stack := stack) (value := value)
            ?_ ?_
            (by simpa [endLabel, compiledCases] using hCaseCalls)
            (by simpa [endLabel, defaultLabel, compiledCases, compiledDefault]
              using hDefaultCalls)
            selectedSeg hProgramWF hCtxProcs hResolve
            (by simpa [selectedSeg, CodeSegment.startPc] using hAfterScrutinee.2)
            hAfterScrutinee.1 hPop hSelect hBodyEval
        · exact
            switchCasesPreservesInProgramLayoutAtFuel_of_upTo
              (fuel := bodyFuel) (by omega) hCases
        · have hDefaultUpTo :
              SwitchDefaultPreservesInProgramLayoutUpTo layout maxFuel ctx
                compiledCases.next defaultBody := by
            simpa [endLabel, compiledCases] using hDefault
          cases hDefaultBody : defaultBody with
          | none =>
              trivial
          | some body =>
              change
                BlockPreservesInProgramLayoutAtFuel layout bodyFuel ctx
                  compiledCases.next body
              have hBodyUpTo :
                  BlockPreservesInProgramLayoutUpTo layout maxFuel ctx
                    compiledCases.next body :=
                switchDefaultPreservesInProgramLayoutUpTo_some
                  (by simpa [hDefaultBody] using hDefaultUpTo)
              intro source' outcome' target' tokens' hProgramWF' hCtxProcs'
                hCalls' hResolve' segment' hPc' hRel' hEval'
              exact
                hBodyUpTo
                  (fuel := bodyFuel) (source := source')
                  (outcome := outcome') (target := target')
                  (tokens := tokens') (by omega)
                  hProgramWF' hCtxProcs' hCalls' hResolve' segment'
                  hPc' hRel' hEval'
      exact
        ARunResult.mono hSelected
          (by
            intro result hResult
            simpa [selectedSeg, tailCode, pre, post, preTests,
              CodeSegment.fallthroughPc, Stmt.compileFromCtxCore, endLabel,
              defaultLabel, compiledCases, compiledDefault, List.append_assoc]
              using hResult)

theorem callObligationUpTo_succ_of_procBodies {program : Program}
    (layout : ProgramLayout program) {maxFuel : Nat}
    (hProcBodies :
      ∀ {name : Name} {proc : Proc}
        (hLookup : ProcList.lookup? name program.procs = some proc),
        BlockPreservesInProgramLayoutUpTo layout maxFuel
          (bodyCtx program proc) (layout.procLayout hLookup).bodySupply
          proc.body) :
    CallObligationUpTo layout (maxFuel + 1) := by
  constructor
  intro ctx supply name fuel source outcome target tokens hLt hProgramWF
    hCtxProcs hCalls _hResolve callSeg hPc hRel hEval
  cases hEval with
  | call_regular hLookup hSplit hBody hPop hAttach =>
      rename_i evalFuel evalProc args callerStack stack bodyState returned frame
      have hLookupCtx : ProcList.lookup? name ctx.procs = some evalProc := by
        simpa [hCtxProcs] using hLookup
      have hProcWF : Proc.WF evalProc :=
        Program.procWF_of_lookup? hProgramWF hLookup
      exact
        call_stmt_segments
          (program := program) (ctx := ctx) (name := name)
          (proc := evalProc) (supply := supply)
          (bodySupply := (layout.procLayout hLookup).bodySupply)
          (dispatchSupply := (layout.procLayout hLookup).dispatchSupply)
          (sites := layout.sites)
          (site :=
            { procName := name
              token := Stmt.callToken supply
              returnLabel := LabelSupply.label supply 0 })
          (fuel := evalFuel + 1) (state := source)
          (outcome :=
            Outcome.regular
              (returned.withEVM { bodyState.evm with stack := stack }))
          (target := target) (tokens := tokens) (asm := layout.asm)
          callSeg (layout.procLayout hLookup).segment hCtxProcs hLookupCtx
          (fun {bodyFuel} hBodyFuelLt =>
            procBodyPreservesAtSegment_of_programLayout
              (program := program) (layout := layout) (proc := evalProc)
              (bodySupply := (layout.procLayout hLookup).bodySupply)
              (dispatchSupply := (layout.procLayout hLookup).dispatchSupply)
              (fuel := bodyFuel)
              (layout.procLayout hLookup).segment
              (blockPreservesInProgramLayoutAtFuel_of_upTo
                (layout := layout) (maxFuel := maxFuel) (fuel := bodyFuel)
                (ctx := bodyCtx program evalProc)
                (supply := (layout.procLayout hLookup).bodySupply)
                (block := evalProc.body)
                (by omega)
                (hProcBodies hLookup))
              hProgramWF (layout.procLayout hLookup).bodyCalls)
          rfl
          (generated_callSite_mem_of_included
            (ctx := ctx) (supply := supply) (name := name)
            (proc := evalProc) (sites := layout.sites)
            hLookupCtx hCalls)
          layout.noDupTokens hProcWF.1 hProcWF.2.1 hPc hRel
          layout.exactLabels
          (Stmt.Eval.call_regular hLookup hSplit hBody hPop hAttach)
  | call_leave hLookup hSplit hBody hPop hAttach =>
      rename_i evalFuel evalProc args callerStack stack bodyState returned frame
      have hLookupCtx : ProcList.lookup? name ctx.procs = some evalProc := by
        simpa [hCtxProcs] using hLookup
      have hProcWF : Proc.WF evalProc :=
        Program.procWF_of_lookup? hProgramWF hLookup
      exact
        call_stmt_segments
          (program := program) (ctx := ctx) (name := name)
          (proc := evalProc) (supply := supply)
          (bodySupply := (layout.procLayout hLookup).bodySupply)
          (dispatchSupply := (layout.procLayout hLookup).dispatchSupply)
          (sites := layout.sites)
          (site :=
            { procName := name
              token := Stmt.callToken supply
              returnLabel := LabelSupply.label supply 0 })
          (fuel := evalFuel + 1) (state := source)
          (outcome :=
            Outcome.regular
              (returned.withEVM { bodyState.evm with stack := stack }))
          (target := target) (tokens := tokens) (asm := layout.asm)
          callSeg (layout.procLayout hLookup).segment hCtxProcs hLookupCtx
          (fun {bodyFuel} hBodyFuelLt =>
            procBodyPreservesAtSegment_of_programLayout
              (program := program) (layout := layout) (proc := evalProc)
              (bodySupply := (layout.procLayout hLookup).bodySupply)
              (dispatchSupply := (layout.procLayout hLookup).dispatchSupply)
              (fuel := bodyFuel)
              (layout.procLayout hLookup).segment
              (blockPreservesInProgramLayoutAtFuel_of_upTo
                (layout := layout) (maxFuel := maxFuel) (fuel := bodyFuel)
                (ctx := bodyCtx program evalProc)
                (supply := (layout.procLayout hLookup).bodySupply)
                (block := evalProc.body)
                (by omega)
                (hProcBodies hLookup))
              hProgramWF (layout.procLayout hLookup).bodyCalls)
          rfl
          (generated_callSite_mem_of_included
            (ctx := ctx) (supply := supply) (name := name)
            (proc := evalProc) (sites := layout.sites)
            hLookupCtx hCalls)
          layout.noDupTokens hProcWF.1 hProcWF.2.1 hPc hRel
          layout.exactLabels
          (Stmt.Eval.call_leave hLookup hSplit hBody hPop hAttach)
  | call_halt hLookup hSplit hBody =>
      rename_i evalFuel evalProc args callerStack bodyState kind
      have hLookupCtx : ProcList.lookup? name ctx.procs = some evalProc := by
        simpa [hCtxProcs] using hLookup
      have hProcWF : Proc.WF evalProc :=
        Program.procWF_of_lookup? hProgramWF hLookup
      exact
        call_stmt_segments
          (program := program) (ctx := ctx) (name := name)
          (proc := evalProc) (supply := supply)
          (bodySupply := (layout.procLayout hLookup).bodySupply)
          (dispatchSupply := (layout.procLayout hLookup).dispatchSupply)
          (sites := layout.sites)
          (site :=
            { procName := name
              token := Stmt.callToken supply
              returnLabel := LabelSupply.label supply 0 })
          (fuel := evalFuel + 1) (state := source)
          (outcome := Outcome.halt kind bodyState)
          (target := target) (tokens := tokens) (asm := layout.asm)
          callSeg (layout.procLayout hLookup).segment hCtxProcs hLookupCtx
          (fun {bodyFuel} hBodyFuelLt =>
            procBodyPreservesAtSegment_of_programLayout
              (program := program) (layout := layout) (proc := evalProc)
              (bodySupply := (layout.procLayout hLookup).bodySupply)
              (dispatchSupply := (layout.procLayout hLookup).dispatchSupply)
              (fuel := bodyFuel)
              (layout.procLayout hLookup).segment
              (blockPreservesInProgramLayoutAtFuel_of_upTo
                (layout := layout) (maxFuel := maxFuel) (fuel := bodyFuel)
                (ctx := bodyCtx program evalProc)
                (supply := (layout.procLayout hLookup).bodySupply)
                (block := evalProc.body)
                (by omega)
                (hProcBodies hLookup))
              hProgramWF (layout.procLayout hLookup).bodyCalls)
          rfl
          (generated_callSite_mem_of_included
            (ctx := ctx) (supply := supply) (name := name)
            (proc := evalProc) (sites := layout.sites)
            hLookupCtx hCalls)
          layout.noDupTokens hProcWF.1 hProcWF.2.1 hPc hRel
          layout.exactLabels
          (Stmt.Eval.call_halt hLookup hSplit hBody)

theorem callObligationForAllFuel_of_procPreserves {program : Program}
    (layout : ProgramLayout program)
    (hProcPreserves : ProgramLayout.ProcPreservesLocal layout) :
    CallObligationForAllFuel layout := by
  intro maxFuel
  constructor
  intro ctx supply name
  exact
    stmt_preserves_upTo_of_preserves
      (maxFuel := maxFuel)
      (preserves_call_in_programLayout layout hProcPreserves)

end ProcedurePreservation

namespace BlockPreservation

theorem nil {program : Program} {fuel : Nat} {ctx : CompileContext}
    {supply : LabelSupply} {source : RunState} {target : EVMState}
    {tokens : List Word} {pre post : Assembly.Program}
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : Frame.StateRel source target tokens)
    (hEval :
      Block.Eval program fuel { stmts := [] } source
        (Outcome.regular source)) :
    ARunResult
      (pre ++ (Block.compileFromCtx { stmts := [] } ctx supply).code ++ post)
      target
      (fun result =>
        match result with
        | .running target' =>
            Frame.StateRel source target' tokens ∧
              target'.pc =
                Assembly.Program.pcAfter
                  (pre ++
                    (Block.compileFromCtx { stmts := [] } ctx supply).code)
        | .halted _ => False) := by
  cases hEval
  refine ARunResult.pure ?_
  simpa [Block.compileFromCtx] using And.intro hRel hPc

theorem nil_outcome {program : Program} {fuel : Nat} {ctx : CompileContext}
    {supply : LabelSupply} {source : RunState} {target : EVMState}
    {tokens : List Word} {pre post : Assembly.Program}
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : Frame.StateRel source target tokens)
    (hEval :
      Block.Eval program fuel { stmts := [] } source
        (Outcome.regular source)) :
    ARunResult
      (pre ++ (Block.compileFromCtx { stmts := [] } ctx supply).code ++ post)
      target
      (fun result =>
        CompiledOutcomeRel
          (pre ++ (Block.compileFromCtx { stmts := [] } ctx supply).code ++ post)
          ctx
          (Assembly.Program.pcAfter
            (pre ++ (Block.compileFromCtx { stmts := [] } ctx supply).code))
          (Outcome.regular source) result tokens) := by
  exact
    ARunResult.mono
      (nil (program := program) (fuel := fuel) (ctx := ctx) (supply := supply)
        hPc hRel hEval)
      (by
        intro result hResult
        cases result with
        | halted halt =>
            cases hResult
        | running target' =>
            exact hResult)

theorem preserves_nil {program : Program} {ctx : CompileContext}
    {supply : LabelSupply} :
    BlockPreserves program ctx supply { stmts := [] } := by
  intro pre post fuel source outcome target tokens _hFits _hResolve _hExact
    hPc hRel hEval
  cases hEval
  refine ARunResult.pure ?_
  simpa [Block.compileFromCtx, CompiledOutcomeRel, Outcome.regular] using
    And.intro hRel hPc

theorem cons {program : Program} {ctx : CompileContext}
    {supply : LabelSupply} {stmt : Stmt} {rest : List Stmt}
    (hStmt : StmtPreserves program ctx supply stmt)
    (hRest :
      BlockPreserves program ctx
        (Stmt.compileFromCtxCore stmt ctx supply).next { stmts := rest }) :
    BlockPreserves program ctx supply { stmts := stmt :: rest } := by
  intro pre post fuel source outcome target tokens hFits hResolve hExact
    hPc hRel hEval
  let compiledStmt := Stmt.compileFromCtxCore stmt ctx supply
  let compiledRest :=
    Block.compileFromCtx { stmts := rest } ctx compiledStmt.next
  have hFits' :
      AssemblyProgram.PCFitsFrom pre
        (compiledStmt.code ++ compiledRest.code) := by
    simpa [Block.compileFromCtx, CompileResult.append,
      compiledStmt, compiledRest] using hFits
  have hStmtFits :
      AssemblyProgram.PCFitsFrom pre compiledStmt.code :=
    AssemblyProgram.PCFitsFrom.left
      (pre := pre) (first := compiledStmt.code)
      (second := compiledRest.code) hFits'
  have hRestFits :
      AssemblyProgram.PCFitsFrom (pre ++ compiledStmt.code)
        compiledRest.code :=
    AssemblyProgram.PCFitsFrom.right
      (pre := pre) (first := compiledStmt.code)
      (second := compiledRest.code) hFits'
  have hStmtResolve :
      ContextLabelsResolve
        (pre ++ compiledStmt.code ++ (compiledRest.code ++ post)) ctx := by
    simpa [Block.compileFromCtx, CompileResult.append,
      compiledStmt, compiledRest, List.append_assoc] using hResolve
  have hRestResolve :
      ContextLabelsResolve
        ((pre ++ compiledStmt.code) ++ compiledRest.code ++ post) ctx := by
    simpa [Block.compileFromCtx, CompileResult.append,
      compiledStmt, compiledRest, List.append_assoc] using hResolve
  have hStmtExact :
      ExactLabels
        (pre ++ compiledStmt.code ++ (compiledRest.code ++ post)) := by
    simpa [Block.compileFromCtx, CompileResult.append,
      compiledStmt, compiledRest, List.append_assoc] using hExact
  have hRestExact :
      ExactLabels
        ((pre ++ compiledStmt.code) ++ compiledRest.code ++ post) := by
    simpa [Block.compileFromCtx, CompileResult.append,
      compiledStmt, compiledRest, List.append_assoc] using hExact
  cases hEval with
  | cons_regular hStmtEval hRestEval =>
      rename_i innerFuel mid
      have hStmtRun :=
        hStmt (pre := pre) (post := compiledRest.code ++ post)
          (fuel := innerFuel) (source := source)
          (outcome := Outcome.regular mid) (target := target)
          (tokens := tokens)
          hStmtFits hStmtResolve hStmtExact hPc hRel hStmtEval
      have hStmtRunRegular :
          ARunResult
            (pre ++ compiledStmt.code ++ (compiledRest.code ++ post))
            target
            (fun result =>
              match result with
              | .running targetMid =>
                  Frame.StateRel mid targetMid tokens ∧
                    targetMid.pc =
                      Assembly.Program.pcAfter (pre ++ compiledStmt.code)
              | .halted _ => False) := by
        exact ARunResult.mono hStmtRun (by
          intro result hResult
          cases result with
          | halted halt =>
              cases hResult
          | running targetMid =>
              simpa [CompiledOutcomeRel, Outcome.regular] using hResult)
      refine
        ARunResult.bind_running
          (program := pre ++
            (Block.compileFromCtx { stmts := stmt :: rest } ctx supply).code ++
              post)
          (middle := fun targetMid =>
            Frame.StateRel mid targetMid tokens ∧
              targetMid.pc =
                Assembly.Program.pcAfter (pre ++ compiledStmt.code))
          ?_ ?_
      · simpa [Block.compileFromCtx, CompileResult.append,
          compiledStmt, compiledRest, List.append_assoc] using hStmtRunRegular
      · intro targetMid hMid
        have hRestRun :=
          hRest (pre := pre ++ compiledStmt.code) (post := post)
            (fuel := innerFuel) (source := mid) (outcome := outcome)
            (target := targetMid) (tokens := tokens)
            hRestFits hRestResolve hRestExact hMid.2 hMid.1 hRestEval
        simpa [Block.compileFromCtx, CompileResult.append,
          compiledStmt, compiledRest, List.append_assoc] using hRestRun
  | cons_brk hStmtEval =>
      rename_i innerFuel outState
      have hStmtRun :=
        hStmt (pre := pre) (post := compiledRest.code ++ post)
          (fuel := innerFuel) (source := source)
          (outcome := Outcome.brk outState) (target := target)
          (tokens := tokens)
          hStmtFits hStmtResolve hStmtExact hPc hRel hStmtEval
      refine ARunResult.mono (by
        simpa [Block.compileFromCtx, CompileResult.append,
          compiledStmt, compiledRest, List.append_assoc] using hStmtRun) ?_
      intro result hResult
      cases result with
      | running target' =>
          simpa [Block.compileFromCtx, CompileResult.append, compiledStmt,
            compiledRest, List.append_assoc, CompiledOutcomeRel, Outcome.brk]
            using hResult
      | halted halt =>
          cases hResult
  | cons_cont hStmtEval =>
      rename_i innerFuel outState
      have hStmtRun :=
        hStmt (pre := pre) (post := compiledRest.code ++ post)
          (fuel := innerFuel) (source := source)
          (outcome := Outcome.cont outState) (target := target)
          (tokens := tokens)
          hStmtFits hStmtResolve hStmtExact hPc hRel hStmtEval
      refine ARunResult.mono (by
        simpa [Block.compileFromCtx, CompileResult.append,
          compiledStmt, compiledRest, List.append_assoc] using hStmtRun) ?_
      intro result hResult
      cases result with
      | running target' =>
          simpa [Block.compileFromCtx, CompileResult.append, compiledStmt,
            compiledRest, List.append_assoc, CompiledOutcomeRel, Outcome.cont]
            using hResult
      | halted halt =>
          cases hResult
  | cons_leave hStmtEval =>
      rename_i innerFuel outState
      have hStmtRun :=
        hStmt (pre := pre) (post := compiledRest.code ++ post)
          (fuel := innerFuel) (source := source)
          (outcome := Outcome.leave outState) (target := target)
          (tokens := tokens)
          hStmtFits hStmtResolve hStmtExact hPc hRel hStmtEval
      refine ARunResult.mono (by
        simpa [Block.compileFromCtx, CompileResult.append,
          compiledStmt, compiledRest, List.append_assoc] using hStmtRun) ?_
      intro result hResult
      cases result with
      | running target' =>
          simpa [Block.compileFromCtx, CompileResult.append, compiledStmt,
            compiledRest, List.append_assoc, CompiledOutcomeRel, Outcome.leave]
            using hResult
      | halted halt =>
          cases hResult
  | cons_halt hStmtEval =>
      rename_i innerFuel outState kind
      have hStmtRun :=
        hStmt (pre := pre) (post := compiledRest.code ++ post)
          (fuel := innerFuel) (source := source)
          (outcome := Outcome.halt kind outState) (target := target)
          (tokens := tokens)
          hStmtFits hStmtResolve hStmtExact hPc hRel hStmtEval
      refine ARunResult.mono (by
        simpa [Block.compileFromCtx, CompileResult.append,
          compiledStmt, compiledRest, List.append_assoc] using hStmtRun) ?_
      intro result hResult
      cases result with
      | running target' =>
          cases hResult
      | halted halt =>
          simpa [Block.compileFromCtx, CompileResult.append, compiledStmt,
            compiledRest, List.append_assoc, CompiledOutcomeRel, Outcome.halt]
            using hResult

end BlockPreservation

structure ControlContextSupports (canBreak canContinue canLeave : Bool)
    (ctx : CompileContext) : Prop where
  brk :
    canBreak = true → ∃ label, ctx.breakLabel? = some label
  cont :
    canContinue = true → ∃ label, ctx.continueLabel? = some label
  leave :
    canLeave = true → ∃ label, ctx.leaveLabel? = some label

namespace ControlContextSupports

theorem withoutBreakContinue {canLeave : Bool} {ctx : CompileContext}
    (hCtx : ControlContextSupports false false canLeave ctx) :
    ControlContextSupports false false canLeave
      { ctx with breakLabel? := none, continueLabel? := none } := by
  refine ⟨?_, ?_, ?_⟩
  · intro hFalse
    cases hFalse
  · intro hFalse
    cases hFalse
  · intro hLeave
    exact hCtx.leave hLeave

theorem loopOuter {canBreak canContinue canLeave : Bool}
    {ctx : CompileContext}
    (hCtx : ControlContextSupports canBreak canContinue canLeave ctx) :
    ControlContextSupports false false canLeave
      { ctx with breakLabel? := none, continueLabel? := none } := by
  refine ⟨?_, ?_, ?_⟩
  · intro hFalse
    cases hFalse
  · intro hFalse
    cases hFalse
  · intro hLeave
    exact hCtx.leave hLeave

theorem loopBody {canBreak canContinue canLeave : Bool}
    {ctx : CompileContext} {breakLabel continueLabel : Assembly.Label}
    (hCtx : ControlContextSupports canBreak canContinue canLeave ctx) :
    ControlContextSupports true true canLeave
      { ctx with
        breakLabel? := some breakLabel
        continueLabel? := some continueLabel } := by
  refine ⟨?_, ?_, ?_⟩
  · intro _hBreak
    exact ⟨breakLabel, rfl⟩
  · intro _hContinue
    exact ⟨continueLabel, rfl⟩
  · intro hLeave
    exact hCtx.leave hLeave

end ControlContextSupports

mutual
  inductive Block.TerminalSafe : Block → Prop where
    | nil : Block.TerminalSafe { stmts := [] }
    | cons {stmt : Stmt} {rest : List Stmt}
        (hStmt : Stmt.TerminalSafe stmt)
        (hRest : Block.TerminalSafe { stmts := rest }) :
        Block.TerminalSafe { stmts := stmt :: rest }

  inductive Stmt.TerminalSafe : Stmt → Prop where
    | code {code : Code} :
        Stmt.TerminalSafe (.code code)
    | if_ {cond : Code} {body : Block}
        (hBody : Block.TerminalSafe body) :
        Stmt.TerminalSafe (.if_ cond body)
    | switch {scrutinee : Code} {cases : List (Word × Block)}
        {defaultBody : Option Block}
        (hCases :
          ∀ value body, (value, body) ∈ cases → Block.TerminalSafe body)
        (hDefault :
          ∀ body, defaultBody = some body → Block.TerminalSafe body) :
        Stmt.TerminalSafe (.switch scrutinee cases defaultBody)
    | for_ {init post body : Block} {cond : Code}
        (hInit : Block.TerminalSafe init)
        (hPost : Block.TerminalSafe post)
        (hBody : Block.TerminalSafe body) :
        Stmt.TerminalSafe (.for_ init cond post body)
    | brk : Stmt.TerminalSafe .brk
    | cont : Stmt.TerminalSafe .cont
    | leave : Stmt.TerminalSafe .leave
    | call {name : Name} : Stmt.TerminalSafe (.call name)
    | terminal {kind : Assembly.HaltKind} (hSafe : Terminal.RelSafe kind) :
        Stmt.TerminalSafe (.terminal kind)
end

namespace Proc

def TerminalSafe (proc : Proc) : Prop :=
  Block.TerminalSafe proc.body

end Proc

namespace ProcList

def TerminalSafe : List Proc → Prop
  | [] => True
  | proc :: rest => Proc.TerminalSafe proc ∧ TerminalSafe rest

theorem TerminalSafe_of_lookup? {procs : List Proc} {name : Name} {proc : Proc}
    (hSafe : TerminalSafe procs)
    (hLookup : EvmCompiler.Structured.ProcList.lookup? name procs = some proc) :
    Proc.TerminalSafe proc := by
  induction procs with
  | nil =>
      simp [EvmCompiler.Structured.ProcList.lookup?] at hLookup
  | cons head rest ih =>
      unfold EvmCompiler.Structured.ProcList.lookup? at hLookup
      by_cases hName : head.name = name
      · simp [hName] at hLookup
        cases hLookup
        exact hSafe.1
      · simp [hName] at hLookup
        exact ih hSafe.2 hLookup

end ProcList

namespace Program

def TerminalSafe (program : Program) : Prop :=
  ProcList.TerminalSafe program.procs ∧ Block.TerminalSafe program.body

theorem procTerminalSafe_of_lookup? {program : Program} {name : Name}
    {proc : Proc}
    (hSafe : Program.TerminalSafe program)
    (hLookup :
      EvmCompiler.Structured.ProcList.lookup? name program.procs = some proc) :
    Proc.TerminalSafe proc :=
  ProcList.TerminalSafe_of_lookup? hSafe.1 hLookup

/--
Backend semantic contracts needed by the Structured-to-assembly lowering.

Higher layers should usually prove these by construction from their own typing
or layout invariants.  Keeping them separate from source well-formedness makes
that proof obligation explicit: `WF` is the ordinary source-side acceptance
condition, while `BackendSafe` says the low-level primitive code cannot observe
or corrupt compiler-inserted return-frame material.
-/
structure BackendSafe (program : Program) : Prop where
  runner : Program.RunnerSafe program
  frame : program.FrameSafe
  terminal : Program.TerminalSafe program

structure Accepted (program : Program) : Prop where
  wf : program.WF
  runner : Program.RunnerSafe program
  frame : program.FrameSafe
  terminal : Program.TerminalSafe program

namespace BackendSafe

theorem ofAccepted {program : Program} (hAccepted : Accepted program) :
    BackendSafe program where
  runner := hAccepted.runner
  frame := hAccepted.frame
  terminal := hAccepted.terminal

end BackendSafe

theorem accepted_of_wf_backendSafe {program : Program}
    (hWF : program.WF) (hBackend : BackendSafe program) :
    Accepted program where
  wf := hWF
  runner := hBackend.runner
  frame := hBackend.frame
  terminal := hBackend.terminal

noncomputable def wfChecked (program : Program) : Bool := by
  classical
  exact decide program.WF

noncomputable def backendSafeChecked (program : Program) : Bool := by
  classical
  exact decide (BackendSafe program)

theorem wf_of_check {program : Program}
    (h : wfChecked program = true) :
    program.WF := by
  unfold wfChecked at h
  classical
  exact of_decide_eq_true h

theorem wf_check_of {program : Program}
    (h : program.WF) :
    wfChecked program = true := by
  unfold wfChecked
  classical
  exact decide_eq_true h

theorem backendSafe_of_check {program : Program}
    (h : backendSafeChecked program = true) :
    BackendSafe program := by
  unfold backendSafeChecked at h
  classical
  exact of_decide_eq_true h

theorem backendSafe_check_of {program : Program}
    (h : BackendSafe program) :
    backendSafeChecked program = true := by
  unfold backendSafeChecked
  classical
  exact decide_eq_true h

/-- Proof-producing acceptance checker for source programs.

This keeps the public compiler theorem small: a successful checked
compilation carries the structural well-formedness, runner-safety, frame, and
terminal-safety evidence needed by the preservation proof. -/
noncomputable def accepted (program : Program) : Bool :=
  wfChecked program && backendSafeChecked program

theorem accepted_of_check {program : Program}
    (h : accepted program = true) :
    Accepted program := by
  unfold accepted at h
  cases hWFChecked : wfChecked program <;>
    cases hBackendChecked : backendSafeChecked program <;>
    simp [hWFChecked, hBackendChecked] at h
  exact
    accepted_of_wf_backendSafe
      (wf_of_check hWFChecked)
      (backendSafe_of_check hBackendChecked)

theorem accepted_check_of {program : Program}
    (h : Accepted program) :
  accepted program = true := by
  unfold accepted
  rw [wf_check_of h.wf, backendSafe_check_of (BackendSafe.ofAccepted h)]
  rfl

end Program

namespace CompilerPreservation

structure CallObligation (program : Program) : Prop where
  preserves :
    ∀ {ctx : CompileContext} {supply : LabelSupply} {name : Name},
      StmtPreserves program ctx supply (.call name)

set_option maxHeartbeats 800000 in
set_option maxRecDepth 2000 in
mutual
  theorem block {program : Program} {ctx : CompileContext}
      {supply : LabelSupply} {block : Block}
      {canBreak canContinue canLeave : Bool}
      (hWF : Block.WF canBreak canContinue canLeave block)
      (hRunner : Block.RunnerSafe block)
      (hFrame : Block.FrameSafe block)
      (hTerminal : Block.TerminalSafe block)
      (hCtx : ControlContextSupports canBreak canContinue canLeave ctx)
      (hCall : CallObligation program) :
      BlockPreserves program ctx supply block := by
    cases hWF with
    | nil =>
        exact BlockPreservation.preserves_nil
    | cons hStmtWF hRestWF =>
        rename_i headStmt rest
        cases hRunner with
        | cons hStmtRunner hRestRunner =>
        cases hFrame with
        | cons hStmtFrame hRestFrame =>
        cases hTerminal with
        | cons hStmtTerminal hRestTerminal =>
            exact
              BlockPreservation.cons
                (stmt (program := program) (ctx := ctx) (supply := supply)
                  hStmtWF hStmtRunner hStmtFrame hStmtTerminal hCtx hCall)
                (block (program := program) (ctx := ctx)
                  (supply := (Stmt.compileFromCtxCore headStmt ctx supply).next)
                  hRestWF hRestRunner hRestFrame hRestTerminal hCtx hCall)
  termination_by sizeOf block
  decreasing_by
    all_goals
      simp_wf
      subst_vars
      simp
      all_goals omega

  theorem stmt {program : Program} {ctx : CompileContext}
      {supply : LabelSupply} {stmt : Stmt}
      {canBreak canContinue canLeave : Bool}
      (hWF : Stmt.WF canBreak canContinue canLeave stmt)
      (hRunner : Stmt.RunnerSafe stmt)
      (hFrame : Stmt.FrameSafe stmt)
      (hTerminal : Stmt.TerminalSafe stmt)
      (hCtx : ControlContextSupports canBreak canContinue canLeave ctx)
      (hCall : CallObligation program) :
      StmtPreserves program ctx supply stmt := by
    cases hWF with
    | code =>
        cases hRunner with
        | code hCodeRunner =>
        cases hFrame with
        | code hCodeFrame =>
            exact StmtPreservation.preserves_code hCodeRunner hCodeFrame
    | if_ hBodyWF =>
        cases hRunner with
        | if_ hCondRunner hBodyRunner =>
        cases hFrame with
        | if_ hCondFrame hBodyFrame =>
        cases hTerminal with
        | if_ hBodyTerminal =>
            exact
              StmtPreservation.preserves_if hCondRunner hCondFrame
                (block (program := program) (ctx := ctx)
                  (supply := LabelSupply.next supply)
                  hBodyWF hBodyRunner hBodyFrame hBodyTerminal hCtx hCall)
    | switch hCasesWF hDefaultWF =>
        rename_i scrutinee cases defaultBody
        cases hRunner with
        | switch hScrutineeRunner hCasesRunner hDefaultRunner =>
        cases hFrame with
        | switch hScrutineeFrame hCasesFrame hDefaultFrame =>
        cases hTerminal with
        | switch hCasesTerminal hDefaultTerminal =>
            have hCasesPreserves :
                SwitchPreservation.CasesPreserves program ctx
                  (LabelSupply.label supply 0) supply
                  (LabelSupply.next supply) 0 cases :=
              SwitchPreservation.casesPreserves_of_all
                (program := program) (ctx := ctx)
                (endLabel := LabelSupply.label supply 0)
                (base := supply) (supply := LabelSupply.next supply)
                (cases := cases)
                (idx := 0)
                (hAll := by
                  intro bodySupply value body hMem
                  exact
                    block (program := program) (ctx := ctx)
                      (supply := bodySupply)
                      (hCasesWF value body hMem)
                      (hCasesRunner value body hMem)
                      (hCasesFrame value body hMem)
                      (hCasesTerminal value body hMem)
                      hCtx hCall)
            have hDefaultPreserves :
                SwitchPreservation.DefaultPreserves program ctx
                  (SwitchCases.compileFromCtx cases ctx
                    (LabelSupply.label supply 0) supply
                    (LabelSupply.next supply) 0).next defaultBody := by
              cases hDefault : defaultBody with
              | none =>
                  trivial
              | some defaultBody =>
                  exact
                    block (program := program) (ctx := ctx)
                      (supply :=
                        (SwitchCases.compileFromCtx cases ctx
                          (LabelSupply.label supply 0) supply
                          (LabelSupply.next supply) 0).next)
                      (hDefaultWF defaultBody hDefault)
                      (hDefaultRunner defaultBody hDefault)
                      (hDefaultFrame defaultBody hDefault)
                      (hDefaultTerminal defaultBody hDefault)
                      hCtx hCall
            exact
              (StmtPreservation.preserves_switch
                (program := program) (ctx := ctx) (supply := supply)
                (scrutinee := scrutinee) (cases := cases)
                (defaultBody := defaultBody)
                hScrutineeRunner hScrutineeFrame hCasesPreserves
                hDefaultPreserves :
                StmtPreserves program ctx supply
                  (.switch scrutinee cases defaultBody))
    | for_ hInitWF hPostWF hBodyWF =>
        rename_i init post body cond
        cases hRunner with
        | for_ hInitRunner hCondRunner hPostRunner hBodyRunner =>
        cases hFrame with
        | for_ hInitFrame hCondFrame hPostFrame hBodyFrame =>
        cases hTerminal with
        | for_ hInitTerminal hPostTerminal hBodyTerminal =>
            let loopOuterCtx : CompileContext :=
              { ctx with breakLabel? := none, continueLabel? := none }
            let bodyCtx : CompileContext :=
              { ctx with
                breakLabel? := some (LabelSupply.label supply 3)
                continueLabel? := some (LabelSupply.label supply 2) }
            exact
              (StmtPreservation.preserves_for
                (program := program) (ctx := ctx) (supply := supply)
                (init := init) (cond := cond) (post := post) (body := body)
                hCondRunner hCondFrame
                (block (program := program) (ctx := loopOuterCtx)
                  (supply := LabelSupply.next supply)
                  hInitWF hInitRunner hInitFrame hInitTerminal
                  (ControlContextSupports.loopOuter hCtx) hCall)
                (block (program := program) (ctx := bodyCtx)
                  (supply :=
                    (Block.compileFromCtx init loopOuterCtx
                      (LabelSupply.next supply)).next)
                  hBodyWF hBodyRunner hBodyFrame hBodyTerminal
                  (ControlContextSupports.loopBody hCtx) hCall)
                (block (program := program) (ctx := loopOuterCtx)
                  (supply :=
                    (Block.compileFromCtx body bodyCtx
                      (Block.compileFromCtx init loopOuterCtx
                        (LabelSupply.next supply)).next).next)
                  hPostWF hPostRunner hPostFrame hPostTerminal
                  (ControlContextSupports.loopOuter hCtx) hCall) :
                StmtPreserves program ctx supply
                  (.for_ init cond post body))
    | brk hAllowed =>
        rcases hCtx.brk hAllowed with ⟨label, hLabel⟩
        exact StmtPreservation.preserves_brk hLabel
    | cont hAllowed =>
        rcases hCtx.cont hAllowed with ⟨label, hLabel⟩
        exact StmtPreservation.preserves_cont hLabel
    | leave hAllowed =>
        rcases hCtx.leave hAllowed with ⟨label, hLabel⟩
        exact StmtPreservation.preserves_leave hLabel
    | call =>
        exact hCall.preserves
    | terminal =>
        cases hTerminal with
        | terminal hSafe =>
            exact StmtPreservation.preserves_terminal hSafe
  termination_by sizeOf stmt
  decreasing_by
    all_goals
      simp_wf
      subst_vars
      first
      | simp
        all_goals omega
      | exact
          lt_trans (by simp)
            (lt_trans (list_sizeOf_lt_sizeOf_of_mem hMem) (by simp; omega))
end

theorem main_block {program : Program}
    (hWF : program.WF)
    (hRunner : Program.RunnerSafe program)
    (hFrame : program.FrameSafe)
    (hTerminal : Program.TerminalSafe program)
    (hCall : CallObligation program) :
    BlockPreserves program { procs := program.procs } 0 program.body := by
  exact
    block (program := program) (ctx := { procs := program.procs })
      (supply := 0) (canBreak := false) (canContinue := false)
      (canLeave := false)
      hWF.2.2.2.2 hRunner.2 hFrame.2 hTerminal.2
      (by
        refine ⟨?_, ?_, ?_⟩
        · intro hFalse
          cases hFalse
        · intro hFalse
          cases hFalse
        · intro hFalse
          cases hFalse)
      hCall

end CompilerPreservation


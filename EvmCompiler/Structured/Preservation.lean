theorem swap_snoc {state : EVMState} {front suffix : List Word}
    {top last : Word} :
    EvmYul.swap (front.length + 1)
        { state with stack := top :: front ++ [last] ++ suffix } =
      .ok (EvmYul.EVM.State.replaceStackAndIncrPC
        { state with stack := top :: front ++ [last] ++ suffix }
        (last :: front ++ [top] ++ suffix)) := by
  have hTake :
      List.take (front.length + 1) (front ++ last :: suffix) =
        front ++ [last] := by
    simpa [List.length_append] using
      (List.take_left (l₁ := front ++ [last]) (l₂ := suffix))
  have hDrop :
      List.drop (front.length + 1) (front ++ last :: suffix) =
        suffix := by
    simpa [List.length_append] using
      (List.drop_left (l₁ := front ++ [last]) (l₂ := suffix))
  have hLast :
      (top :: (front ++ [last])).getLast?.getD default = last := by
    have hLast? : (top :: (front ++ [last])).getLast? = some last := by
      simpa using (List.getLast?_concat (l := top :: front) (a := last))
    simp [hLast?]
  have hDropLast : (front ++ [last]).dropLast = front := by
    simpa using (List.dropLast_concat (l₁ := front) (b := last))
  simp [EvmYul.swap, hTake, hDrop, hLast, hDropLast,
    List.length_append, List.append_assoc]

theorem dup_append_token {state : EVMState} {front suffix : List Word}
    {token : Word} :
    EvmYul.dup (front.length + 1)
        { state with stack := front ++ [token] ++ suffix } =
      .ok (EvmYul.EVM.State.replaceStackAndIncrPC
        { state with stack := front ++ [token] ++ suffix }
        (token :: front ++ [token] ++ suffix)) := by
  have hTake :
      List.take (front.length + 1) (front ++ token :: suffix) =
        front ++ [token] := by
    simpa [List.length_append] using
      (List.take_left (l₁ := front ++ [token]) (l₂ := suffix))
  simp [EvmYul.dup, hTake, List.length_append, List.append_assoc]

theorem pop_cons_step {state : EVMState} {top : Word}
    {suffix : List Word} :
    Assembly.Target.stepInstr (.prim .pop) { state with stack := top :: suffix } =
      .ok (({ state with stack := top :: suffix }).replaceStackAndIncrPC suffix) :=
  rfl

theorem sinkTopUnder_target_exists {state : EVMState}
    {args suffix : List Word} {token : Word}
    (hBound : args.length ≤ 16) :
    ∃ final,
      Assembly.Target.runList (targetProgram (StackShuffle.sinkTopUnder args.length))
        { state with stack := token :: args ++ suffix } = .ok final ∧
      final.stack = args ++ token :: suffix ∧
      eraseControl final =
        eraseControl { state with stack := args ++ token :: suffix } := by
  induction args using List.reverseRecOn generalizing state suffix token with
  | nil =>
      refine ⟨{ state with stack := token :: suffix }, rfl, rfl, rfl⟩
  | append_singleton front last ih =>
      have hSwapBound : front.length + 1 ≤ 16 := by
        simpa [List.length_append] using hBound
      have hFrontBound : front.length ≤ 16 := by omega
      let start : EVMState :=
        { state with stack := token :: front ++ [last] ++ suffix }
      let mid : EVMState :=
        start.replaceStackAndIncrPC (last :: front ++ [token] ++ suffix)
      have hStep :
          Assembly.Target.stepInstr
              (targetInstr (StackShuffle.swapInstr (front.length + 1)))
              start =
            .ok mid := by
        rw [swapInstr_step_eq_swap (by omega) hSwapBound]
        exact swap_snoc (state := state) (front := front)
          (suffix := suffix) (top := token) (last := last)
      rcases ih (state := mid) (suffix := token :: suffix) (token := last)
          hFrontBound with
        ⟨final, hRunRest, hStack, hErase⟩
      have hMidStack : mid.stack = last :: front ++ token :: suffix := by
        simp [mid, start, EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC, List.append_assoc]
      have hMidRecord :
          { mid with stack := last :: (front ++ token :: suffix) } = mid := by
        rw [show last :: (front ++ token :: suffix) =
            last :: front ++ token :: suffix by rfl]
        rw [← hMidStack]
      refine ⟨final, ?_, ?_, ?_⟩
      · simp [targetProgram, StackShuffle.sinkTopUnder, List.length_append]
        rw [show { state with stack := token :: (front ++ last :: suffix) } =
            start by simp [start, List.append_assoc]]
        unfold Assembly.Target.runList
        rw [hStep]
        change
          Assembly.Target.runList
              (List.map targetInstr (StackShuffle.sinkTopUnder front.length))
              mid =
            .ok final
        simpa [targetProgram, hMidRecord] using hRunRest
      · simpa [List.append_assoc] using hStack
      · simpa [hMidStack, List.append_assoc, eraseControl, Assembly.eraseGas,
          mid, start, EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC] using hErase

theorem liftBuriedToTop_target_exists {state : EVMState}
    {front suffix : List Word} {token : Word}
    (hBound : front.length ≤ 16) :
    ∃ final,
      Assembly.Target.runList
          (targetProgram (StackShuffle.liftBuriedToTop front.length))
          { state with stack := front ++ token :: suffix } = .ok final ∧
      final.stack = token :: front ++ suffix ∧
      eraseControl final =
        eraseControl { state with stack := token :: front ++ suffix } := by
  induction front using List.reverseRecOn generalizing state suffix token with
  | nil =>
      refine ⟨{ state with stack := token :: suffix }, rfl, rfl, rfl⟩
  | append_singleton front last ih =>
      have hSwapBound : front.length + 1 ≤ 16 := by
        simpa [List.length_append] using hBound
      have hFrontBound : front.length ≤ 16 := by omega
      rcases ih (state := state) (suffix := token :: suffix) (token := last)
          hFrontBound with
        ⟨mid, hRunLift, hMidStack, hMidErase⟩
      let finalState : EVMState :=
        mid.replaceStackAndIncrPC (token :: front ++ [last] ++ suffix)
      have hMidRecord :
          { mid with stack := last :: front ++ [token] ++ suffix } = mid := by
        have hStackEq : last :: front ++ [token] ++ suffix = mid.stack := by
          rw [hMidStack]
          simp [List.append_assoc]
        rw [hStackEq]
      have hStep :
          Assembly.Target.stepInstr
              (targetInstr (StackShuffle.swapInstr (front.length + 1)))
              mid =
            .ok finalState := by
        rw [← hMidRecord]
        rw [swapInstr_step_eq_swap (by omega) hSwapBound]
        exact swap_snoc (state := mid) (front := front) (suffix := suffix)
          (top := last) (last := token)
      refine ⟨finalState, ?_, ?_, ?_⟩
      · rw [show StackShuffle.liftBuriedToTop (front ++ [last]).length =
            StackShuffle.liftBuriedToTop front.length ++
              [StackShuffle.swapInstr (front.length + 1)] by
          simp [StackShuffle.liftBuriedToTop, List.length_append]]
        simp [targetProgram, List.map_append]
        exact AssemblyTarget.runList_append_ok hRunLift (by
          change
            Assembly.Target.runList
                [targetInstr (StackShuffle.swapInstr (front.length + 1))]
                mid =
              Except.ok finalState
          unfold Assembly.Target.runList
          rw [hStep]
          rfl)
      · simp [finalState, EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC, List.append_assoc]
      · have hEraseFinal :=
          eraseControl_replaceStackAndIncrPC_of_eq
            (left := mid)
            (right := { state with stack := last :: front ++ token :: suffix })
            (leftStack := token :: front ++ [last] ++ suffix)
            (rightStack := token :: front ++ [last] ++ suffix)
            (pcΔ := 1) hMidErase rfl
        simpa [finalState, EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC, eraseControl, Assembly.eraseGas,
          List.append_assoc] using hEraseFinal

theorem removeBuriedUnder_target_exists {state : EVMState}
    {returnValues suffix : List Word} {token : Word}
    (hBound : returnValues.length ≤ 16) :
    ∃ final,
      Assembly.Target.runList
          (targetProgram (StackShuffle.removeBuriedUnder returnValues.length))
          { state with stack := returnValues ++ token :: suffix } = .ok final ∧
      final.stack = returnValues ++ suffix ∧
      eraseControl final =

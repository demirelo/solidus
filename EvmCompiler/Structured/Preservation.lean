          Except.ok afterPush
      unfold Assembly.Target.runList
      rw [hPush]
      rfl) hRunSink
  · simpa [afterPush, eraseControl, Assembly.eraseGas,
      EvmYul.EVM.State.replaceStackAndIncrPC, EvmYul.EVM.State.incrPC]
      using hErase

theorem sinkTopUnder_source_exists {state : EVMState}
    {args suffix : List Word} {token : Word}
    {pre post : Assembly.Program}
    (hFits :
      AssemblyProgram.PCFitsFrom pre
        (StackShuffle.sinkTopUnder args.length))
    (hPc :
      ({ state with stack := token :: args ++ suffix }).pc =
        Assembly.Program.pcAfter pre)
    (hBound : args.length ≤ 16) :
    ARunResult
      (pre ++ StackShuffle.sinkTopUnder args.length ++ post)
      { state with stack := token :: args ++ suffix }
      (fun result =>
        match result with
        | .running final =>
            final.stack = args ++ token :: suffix ∧
              eraseControl final =
                eraseControl { state with stack := args ++ token :: suffix } ∧
              final.pc =
                Assembly.Program.pcAfter
                  (pre ++ StackShuffle.sinkTopUnder args.length)
        | .halted _ => False) := by
  induction args using List.reverseRecOn generalizing state suffix token pre with
  | nil =>
      refine ARunResult.pure ?_
      simpa [StackShuffle.sinkTopUnder] using hPc
  | append_singleton front last ih =>
      have hSwapBound : front.length + 1 ≤ 16 := by
        simpa [List.length_append] using hBound
      have hFrontBound : front.length ≤ 16 := by omega
      let swap := StackShuffle.swapInstr (front.length + 1)
      let start : EVMState :=
        { state with stack := token :: front ++ [last] ++ suffix }
      let mid : EVMState :=
        start.replaceStackAndIncrPC (last :: front ++ [token] ++ suffix)
      have hStep :
          Assembly.Target.stepInstr (targetInstr swap) start = .ok mid := by
        rw [show swap = StackShuffle.swapInstr (front.length + 1) from rfl]
        rw [swapInstr_step_eq_swap (by omega) hSwapBound]
        exact swap_snoc (state := state) (front := front)
          (suffix := suffix) (top := token) (last := last)
      have hSwapLocal : SourceLocalInstr swap := by
        exact swapInstr_sourceLocal (n := front.length + 1) (by omega) hSwapBound
      have hSwapNoHalt : swap.haltKind? = none := by
        exact swapInstr_haltKind?_none (n := front.length + 1) (by omega)
          hSwapBound
      have hSwapByte : swap.byteSize = 1 := by
        exact swapInstr_byteSize (n := front.length + 1) (by omega) hSwapBound
      have hFitsCons :
          PCFits pre ∧
            AssemblyProgram.PCFitsFrom (pre ++ [swap])
              (StackShuffle.sinkTopUnder front.length) := by
        simpa [StackShuffle.sinkTopUnder, List.length_append, swap,
          List.append_assoc] using hFits
      have hFirstFit : PCFits pre := by
        exact hFitsCons.1
      have hFirst :
          ARunResult
            (pre ++ StackShuffle.sinkTopUnder (front ++ [last]).length ++ post)
            start
            (fun result =>
              match result with
              | .running targetAfterSwap =>
                  targetAfterSwap = mid ∧
                    targetAfterSwap.pc =
                      Assembly.Program.pcAfter (pre ++ [swap])
              | .halted _ => False) := by
        refine ⟨1, .running mid, ?_, ?_⟩
        · rw [show
            pre ++ StackShuffle.sinkTopUnder (front ++ [last]).length ++ post =
              pre ++ [swap] ++
                (StackShuffle.sinkTopUnder front.length ++ post) by
              simp [StackShuffle.sinkTopUnder, List.length_append, swap,
                List.append_assoc]]
          unfold Assembly.Source.runNResult
          rw [source_stepResult_local
            (instr := swap) (pre := pre)
            (post := StackShuffle.sinkTopUnder front.length ++ post)
            (state := start) (final := mid)
            hSwapLocal hSwapNoHalt hFirstFit
            (by simpa [start, List.append_assoc] using hPc)
            hStep]
          rfl
        · refine ⟨rfl, ?_⟩
          have hPcState : state.pc = Assembly.Program.pcAfter pre := by
            simpa [start, List.append_assoc] using hPc
          calc
            mid.pc
                = state.pc + EvmYul.UInt256.ofNat 1 := by
                    simp [mid, start, EvmYul.EVM.State.replaceStackAndIncrPC,
                      EvmYul.EVM.State.incrPC]
            _ = Assembly.Program.pcAfter pre + EvmYul.UInt256.ofNat 1 := by
                    rw [hPcState]
            _ = EvmYul.UInt256.ofNat (Assembly.Program.byteLength pre + 1) := by
                    rw [Assembly.Program.pcAfter, Assembly.UInt256_ofNat_add]
            _ = Assembly.Program.pcAfter (pre ++ [swap]) := by
                    simp [Assembly.Program.pcAfter,
                      Assembly.Program.byteLength_append,
                      Assembly.Program.byteLength, hSwapByte]
      refine
        ARunResult.bind_running
          (program :=
            pre ++ StackShuffle.sinkTopUnder (front ++ [last]).length ++ post)
          (middle := fun targetAfterSwap =>
            targetAfterSwap = mid ∧
              targetAfterSwap.pc = Assembly.Program.pcAfter (pre ++ [swap]))
          hFirst ?_
      intro targetAfterSwap hAfterSwap
      cases hAfterSwap.1
      have hRestFits :
          AssemblyProgram.PCFitsFrom (pre ++ [swap])
            (StackShuffle.sinkTopUnder front.length) := by
        exact hFitsCons.2
      have hMidStack : mid.stack = last :: front ++ token :: suffix := by
        simp [mid, start, EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC, List.append_assoc]
      have hMidRecord :
          { mid with stack := last :: (front ++ token :: suffix) } = mid := by
        rw [show last :: (front ++ token :: suffix) =
            last :: front ++ token :: suffix by rfl]
        rw [← hMidStack]
      have hRest :=
        ih (state := mid) (suffix := token :: suffix) (token := last)
          (pre := pre ++ [swap])
          hRestFits hAfterSwap.2 hFrontBound
      exact ARunResult.mono
        (by
          simpa [StackShuffle.sinkTopUnder, List.length_append, swap,
            hMidRecord,
            List.append_assoc] using hRest)
        (by
          intro result hResult
          cases result with
          | halted halt =>
              cases hResult
          | running final =>
              rcases hResult with ⟨hStack, hErase, hPcFinal⟩
              refine ⟨?_, ?_, ?_⟩
              · simpa [List.append_assoc] using hStack
              · calc
                  eraseControl final
                      =
                    eraseControl
                      { mid with stack := front ++ [last] ++ token :: suffix } :=
                        by simpa [List.append_assoc] using hErase
                  _ =
                    eraseControl
                      { state with stack := front ++ [last] ++ token :: suffix } := by
                        simp [mid, start, eraseControl, Assembly.eraseGas,
                          EvmYul.EVM.State.replaceStackAndIncrPC,
                          EvmYul.EVM.State.incrPC]
              · simpa [StackShuffle.sinkTopUnder, List.length_append, swap,
                  List.append_assoc] using hPcFinal)

theorem callPrologue_source_exists {state : EVMState}
    {args suffix : List Word} {token : Word}
    {pre post : Assembly.Program}
    (hFits :
      AssemblyProgram.PCFitsFrom pre
        ([Assembly.Instr.push token] ++ StackShuffle.sinkTopUnder args.length))
    (hPc :
      ({ state with stack := args ++ suffix }).pc =
        Assembly.Program.pcAfter pre)
    (hBound : args.length ≤ 16) :
    ARunResult
      (pre ++
        ([Assembly.Instr.push token] ++ StackShuffle.sinkTopUnder args.length) ++
        post)
      { state with stack := args ++ suffix }
      (fun result =>
        match result with
        | .running final =>
            final.stack = args ++ token :: suffix ∧
              eraseControl final =
                eraseControl { state with stack := args ++ token :: suffix } ∧
              final.pc =
                Assembly.Program.pcAfter
                  (pre ++
                    ([Assembly.Instr.push token] ++
                      StackShuffle.sinkTopUnder args.length))
        | .halted _ => False) := by
  let start : EVMState := { state with stack := args ++ suffix }
  let afterPush : EVMState :=
    start.replaceStackAndIncrPC (token :: args ++ suffix) (pcΔ := 33)
  have hPushStep :
      Assembly.Target.stepInstr (targetInstr (Assembly.Instr.push token))
          start =
        .ok afterPush := by
    simp [targetInstr, start, afterPush, Assembly.Target.stepInstr,
      EvmYul.Stack.push, EvmYul.EVM.State.replaceStackAndIncrPC,
      EvmYul.EVM.State.incrPC]
  have hFirst :
      ARunResult
        (pre ++
          ([Assembly.Instr.push token] ++ StackShuffle.sinkTopUnder args.length) ++
          post)
        start
        (fun result =>
          match result with
          | .running targetAfterPush =>
              targetAfterPush = afterPush ∧
                targetAfterPush.pc =
                  Assembly.Program.pcAfter (pre ++ [Assembly.Instr.push token])
          | .halted _ => False) := by
    refine ⟨1, .running afterPush, ?_, ?_⟩
    · rw [show
        pre ++
            ([Assembly.Instr.push token] ++ StackShuffle.sinkTopUnder args.length) ++
            post =
          pre ++ [Assembly.Instr.push token] ++
            (StackShuffle.sinkTopUnder args.length ++ post) by
          simp [List.append_assoc]]
      unfold Assembly.Source.runNResult
      rw [source_stepResult_local
        (instr := Assembly.Instr.push token) (pre := pre)
        (post := StackShuffle.sinkTopUnder args.length ++ post)
        (state := start) (final := afterPush)
        (by simp [SourceLocalInstr]) rfl hFits.1
        (by simpa [start] using hPc) hPushStep]
      rfl
    · refine ⟨rfl, ?_⟩
      have hPcState : state.pc = Assembly.Program.pcAfter pre := by
        simpa [start] using hPc
      calc
        afterPush.pc
            = state.pc + EvmYul.UInt256.ofNat 33 := by
                simp [afterPush, start,
                  EvmYul.EVM.State.replaceStackAndIncrPC,
                  EvmYul.EVM.State.incrPC]
        _ = Assembly.Program.pcAfter pre + EvmYul.UInt256.ofNat 33 := by
                rw [hPcState]
        _ = EvmYul.UInt256.ofNat (Assembly.Program.byteLength pre + 33) := by
                rw [Assembly.Program.pcAfter, Assembly.UInt256_ofNat_add]
        _ = Assembly.Program.pcAfter (pre ++ [Assembly.Instr.push token]) := by
                simp [Assembly.Program.pcAfter,
                  Assembly.Program.byteLength_append,
                  Assembly.Program.byteLength, Assembly.Instr.byteSize,
                  Assembly.Instr.push32Size]
  refine
    ARunResult.bind_running
      (program :=
        pre ++
          ([Assembly.Instr.push token] ++ StackShuffle.sinkTopUnder args.length) ++
          post)
      (middle := fun targetAfterPush =>
        targetAfterPush = afterPush ∧
          targetAfterPush.pc =
            Assembly.Program.pcAfter (pre ++ [Assembly.Instr.push token]))
      hFirst ?_
  intro targetAfterPush hAfterPush
  cases hAfterPush.1
  have hRest :=
    sinkTopUnder_source_exists
      (state := afterPush) (args := args) (suffix := suffix)
      (token := token) (pre := pre ++ [Assembly.Instr.push token])
      (post := post)
      (by simpa [List.append_assoc] using hFits.2)
      hAfterPush.2 hBound
  exact ARunResult.mono
    (by simpa [List.append_assoc] using hRest)
    (by
      intro result hResult
      cases result with
      | halted halt =>
          cases hResult
      | running final =>
          rcases hResult with ⟨hStack, hErase, hPcFinal⟩
          refine ⟨hStack, ?_, ?_⟩
          · calc
              eraseControl final
                  = eraseControl { afterPush with stack := args ++ token :: suffix } :=
                    hErase
              _ = eraseControl { state with stack := args ++ token :: suffix } := by
                    simp [afterPush, start, eraseControl, Assembly.eraseGas,
                      EvmYul.EVM.State.replaceStackAndIncrPC,
                      EvmYul.EVM.State.incrPC]
          · simpa [List.append_assoc] using hPcFinal)

theorem liftBuriedToTop_source_exists {state : EVMState}
    {front suffix : List Word} {token : Word}
    {pre post : Assembly.Program}
    (hFits :
      AssemblyProgram.PCFitsFrom pre
        (StackShuffle.liftBuriedToTop front.length))
    (hPc :
      ({ state with stack := front ++ token :: suffix }).pc =
        Assembly.Program.pcAfter pre)
    (hBound : front.length ≤ 16) :
    ARunResult
      (pre ++ StackShuffle.liftBuriedToTop front.length ++ post)
      { state with stack := front ++ token :: suffix }
      (fun result =>
        match result with
        | .running final =>
            final.stack = token :: front ++ suffix ∧
              eraseControl final =
                eraseControl { state with stack := token :: front ++ suffix } ∧
              final.pc =
                Assembly.Program.pcAfter
                  (pre ++ StackShuffle.liftBuriedToTop front.length)
        | .halted _ => False) := by
  induction front using List.reverseRecOn generalizing state suffix token pre post with
  | nil =>
      refine ARunResult.pure ?_
      simpa [StackShuffle.liftBuriedToTop] using hPc
  | append_singleton front last ih =>
      have hSwapBound : front.length + 1 ≤ 16 := by
        simpa [List.length_append] using hBound
      have hFrontBound : front.length ≤ 16 := by omega
      let swap := StackShuffle.swapInstr (front.length + 1)
      have hCodeEq :
          StackShuffle.liftBuriedToTop (front ++ [last]).length =
            StackShuffle.liftBuriedToTop front.length ++ [swap] := by
        simp [StackShuffle.liftBuriedToTop, List.length_append, swap]
      have hCodeLenEq :
          StackShuffle.liftBuriedToTop (front.length + 1) =
            StackShuffle.liftBuriedToTop front.length ++ [swap] := by
        simpa [List.length_append] using hCodeEq
      have hFitsAppend :
          AssemblyProgram.PCFitsFrom pre
            (StackShuffle.liftBuriedToTop front.length ++ [swap]) := by
        simpa [hCodeEq] using hFits
      have hLiftFits :
          AssemblyProgram.PCFitsFrom pre
            (StackShuffle.liftBuriedToTop front.length) :=
        AssemblyProgram.PCFitsFrom.left hFitsAppend
      have hSwapFits :
          AssemblyProgram.PCFitsFrom
            (pre ++ StackShuffle.liftBuriedToTop front.length) [swap] :=
        AssemblyProgram.PCFitsFrom.right hFitsAppend
      have hLift :=
        ih (state := state) (suffix := token :: suffix) (token := last)
          (pre := pre) (post := [swap] ++ post)
          hLiftFits
          (by simpa [List.append_assoc] using hPc)
          hFrontBound
      refine
        ARunResult.bind_running
          (program :=
            pre ++ StackShuffle.liftBuriedToTop (front ++ [last]).length ++ post)
          (middle := fun targetAfterLift =>
            targetAfterLift.stack = last :: front ++ token :: suffix ∧
              eraseControl targetAfterLift =
                eraseControl { state with stack := last :: front ++ token :: suffix } ∧
              targetAfterLift.pc =
                Assembly.Program.pcAfter
                  (pre ++ StackShuffle.liftBuriedToTop front.length))
          ?_ ?_
      · exact ARunResult.mono
          (by simpa [hCodeLenEq, List.append_assoc] using hLift)
          (by
            intro result hResult
            cases result with
            | halted halt =>
                cases hResult
            | running mid =>
                rcases hResult with ⟨hStack, hErase, hPcMid⟩
                exact ⟨by simpa [List.append_assoc] using hStack,
                  by simpa [List.append_assoc] using hErase, hPcMid⟩)
      · intro mid hMid
        have hMidRecord :
            { mid with stack := last :: front ++ [token] ++ suffix } = mid := by
          rw [show last :: front ++ [token] ++ suffix =
              last :: front ++ token :: suffix by simp [List.append_assoc]]
          rw [← hMid.1]
        let finalState : EVMState :=
          mid.replaceStackAndIncrPC (token :: front ++ [last] ++ suffix)
        have hStep :
            Assembly.Target.stepInstr (targetInstr swap) mid =
              .ok finalState := by
          rw [← hMidRecord]
          rw [show swap = StackShuffle.swapInstr (front.length + 1) from rfl]
          rw [swapInstr_step_eq_swap (by omega) hSwapBound]
          exact swap_snoc (state := mid) (front := front) (suffix := suffix)
            (top := last) (last := token)
        have hSwapLocal : SourceLocalInstr swap := by
          exact swapInstr_sourceLocal (n := front.length + 1) (by omega)
            hSwapBound
        have hSwapNoHalt : swap.haltKind? = none := by
          exact swapInstr_haltKind?_none (n := front.length + 1) (by omega)
            hSwapBound
        have hSwapByte : swap.byteSize = 1 := by
          exact swapInstr_byteSize (n := front.length + 1) (by omega)
            hSwapBound
        refine ⟨1, .running finalState, ?_, ?_⟩
        · rw [show
            pre ++ StackShuffle.liftBuriedToTop (front ++ [last]).length ++ post =
              (pre ++ StackShuffle.liftBuriedToTop front.length) ++
                [swap] ++ post by
              rw [hCodeEq]
              simp [List.append_assoc]]
          unfold Assembly.Source.runNResult
          rw [source_stepResult_local
            (instr := swap)
            (pre := pre ++ StackShuffle.liftBuriedToTop front.length)
            (post := post) (state := mid) (final := finalState)
            hSwapLocal hSwapNoHalt
            (AssemblyProgram.PCFitsFrom.start hSwapFits)
            hMid.2.2 hStep]
          rfl
        · refine ⟨?_, ?_, ?_⟩
          · simp [finalState, EvmYul.EVM.State.replaceStackAndIncrPC,
              EvmYul.EVM.State.incrPC, List.append_assoc]
          · calc
              eraseControl finalState
                  =
                eraseControl
                  { mid with stack := token :: front ++ [last] ++ suffix } := by
                    simp [finalState, eraseControl, Assembly.eraseGas,
                      EvmYul.EVM.State.replaceStackAndIncrPC,
                      EvmYul.EVM.State.incrPC]
              _ =
                eraseControl
                  { state with stack := token :: front ++ [last] ++ suffix } := by
                    have hEraseMid := hMid.2.1
                    simpa [eraseControl, Assembly.eraseGas, List.append_assoc]
                      using
                        eraseControl_with_stack_congr
                          (left := mid)
                          (right :=
                            { state with stack := last :: front ++ token :: suffix })
                          (stack := token :: front ++ [last] ++ suffix)
                          hEraseMid
          · calc
              finalState.pc
                  = mid.pc + EvmYul.UInt256.ofNat 1 := by
                      simp [finalState, EvmYul.EVM.State.replaceStackAndIncrPC,
                        EvmYul.EVM.State.incrPC]
              _ =
                Assembly.Program.pcAfter
                    (pre ++ StackShuffle.liftBuriedToTop front.length) +
                  EvmYul.UInt256.ofNat 1 := by
                    rw [hMid.2.2]
              _ =
                EvmYul.UInt256.ofNat
                  (Assembly.Program.byteLength
                      (pre ++ StackShuffle.liftBuriedToTop front.length) + 1) := by
                    rw [Assembly.Program.pcAfter, Assembly.UInt256_ofNat_add]
              _ =
                Assembly.Program.pcAfter
                  (pre ++ StackShuffle.liftBuriedToTop front.length ++ [swap]) := by
                    simp [Assembly.Program.pcAfter,
                      Assembly.Program.byteLength_append,
                      Assembly.Program.byteLength, hSwapByte, Nat.add_assoc]
              _ =
                Assembly.Program.pcAfter
                  (pre ++ StackShuffle.liftBuriedToTop (front ++ [last]).length) := by
                    rw [hCodeEq]
                    simp [List.append_assoc]

theorem removeBuriedUnder_source_exists {state : EVMState}
    {returnValues suffix : List Word} {token : Word}
    {pre post : Assembly.Program}
    (hFits :
      AssemblyProgram.PCFitsFrom pre
        (StackShuffle.removeBuriedUnder returnValues.length))
    (hPc :
      ({ state with stack := returnValues ++ token :: suffix }).pc =
        Assembly.Program.pcAfter pre)
    (hBound : returnValues.length ≤ 16) :
    ARunResult
      (pre ++ StackShuffle.removeBuriedUnder returnValues.length ++ post)
      { state with stack := returnValues ++ token :: suffix }
      (fun result =>
        match result with
        | .running final =>
            final.stack = returnValues ++ suffix ∧
              eraseControl final =
                eraseControl { state with stack := returnValues ++ suffix } ∧
              final.pc =
                Assembly.Program.pcAfter
                  (pre ++ StackShuffle.removeBuriedUnder returnValues.length)
        | .halted _ => False) := by
  have hFitsLift :
      AssemblyProgram.PCFitsFrom pre
        (StackShuffle.liftBuriedToTop returnValues.length) := by
    exact
      AssemblyProgram.PCFitsFrom.left
        (by simpa [StackShuffle.removeBuriedUnder, List.append_assoc] using hFits)
  have hFitsPop :
      AssemblyProgram.PCFitsFrom
        (pre ++ StackShuffle.liftBuriedToTop returnValues.length)
        [Assembly.Instr.prim .pop] := by
    exact
      AssemblyProgram.PCFitsFrom.right
        (by simpa [StackShuffle.removeBuriedUnder, List.append_assoc] using hFits)
  have hLift :=
    liftBuriedToTop_source_exists
      (state := state) (front := returnValues) (suffix := suffix)
      (token := token) (pre := pre) (post := [Assembly.Instr.prim .pop] ++ post)
      hFitsLift hPc hBound
  refine
    ARunResult.bind_running
      (program :=
        pre ++ StackShuffle.removeBuriedUnder returnValues.length ++ post)
      (middle := fun mid =>
        mid.stack = token :: returnValues ++ suffix ∧
          eraseControl mid =
            eraseControl { state with stack := token :: returnValues ++ suffix } ∧
          mid.pc =
            Assembly.Program.pcAfter
              (pre ++ StackShuffle.liftBuriedToTop returnValues.length))
      ?_ ?_
  · exact ARunResult.mono
      (by
        simpa [StackShuffle.removeBuriedUnder, List.append_assoc] using hLift)
      (by
        intro result hResult
        cases result with
        | halted halt =>
            cases hResult
        | running mid =>
            rcases hResult with ⟨hStack, hErase, hPcMid⟩
            exact ⟨hStack, hErase, hPcMid⟩)
  · intro mid hMid
    have hMidRecord :
        { mid with stack := token :: returnValues ++ suffix } = mid := by
      rw [← hMid.1]
    let finalState : EVMState :=
      mid.replaceStackAndIncrPC (returnValues ++ suffix)
    have hPopStep :
        Assembly.Target.stepInstr (targetInstr (Assembly.Instr.prim .pop)) mid =
          .ok finalState := by
      rw [← hMidRecord]
      exact pop_cons_step (state := mid) (top := token)
        (suffix := returnValues ++ suffix)
    refine ⟨1, .running finalState, ?_, ?_⟩
    · rw [show
        pre ++ StackShuffle.removeBuriedUnder returnValues.length ++ post =
          (pre ++ StackShuffle.liftBuriedToTop returnValues.length) ++
            [Assembly.Instr.prim .pop] ++ post by
          simp [StackShuffle.removeBuriedUnder, List.append_assoc]]
      unfold Assembly.Source.runNResult
      rw [source_stepResult_local
        (instr := Assembly.Instr.prim .pop)
        (pre := pre ++ StackShuffle.liftBuriedToTop returnValues.length)
        (post := post) (state := mid) (final := finalState)
        (by simp [SourceLocalInstr]) rfl
        (AssemblyProgram.PCFitsFrom.start hFitsPop)
        hMid.2.2 hPopStep]
      rfl
    · refine ⟨?_, ?_, ?_⟩
      · simp [finalState, EvmYul.EVM.State.replaceStackAndIncrPC,
          EvmYul.EVM.State.incrPC]
      · calc
          eraseControl finalState
              =
            eraseControl { mid with stack := returnValues ++ suffix } := by
                simp [finalState, eraseControl, Assembly.eraseGas,
                  EvmYul.EVM.State.replaceStackAndIncrPC,
                  EvmYul.EVM.State.incrPC]
          _ =
            eraseControl { state with stack := returnValues ++ suffix } := by
                exact
                  eraseControl_with_stack_congr
                    (left := mid)
                    (right :=
                      { state with stack := token :: returnValues ++ suffix })
                    (stack := returnValues ++ suffix)
                    hMid.2.1
      · calc
          finalState.pc
              = mid.pc + EvmYul.UInt256.ofNat 1 := by
                  simp [finalState, EvmYul.EVM.State.replaceStackAndIncrPC,
                    EvmYul.EVM.State.incrPC]
          _ =
            Assembly.Program.pcAfter
                (pre ++ StackShuffle.liftBuriedToTop returnValues.length) +
              EvmYul.UInt256.ofNat 1 := by
                rw [hMid.2.2]
          _ =
            EvmYul.UInt256.ofNat
              (Assembly.Program.byteLength
                  (pre ++ StackShuffle.liftBuriedToTop returnValues.length) + 1) := by
                rw [Assembly.Program.pcAfter, Assembly.UInt256_ofNat_add]
          _ =
            Assembly.Program.pcAfter
              (pre ++ StackShuffle.removeBuriedUnder returnValues.length) := by
                simp [StackShuffle.removeBuriedUnder,
                  Assembly.Program.pcAfter, Assembly.Program.byteLength_append,
                  Assembly.Program.byteLength, Assembly.Instr.byteSize,
                  Nat.add_assoc]

end StackShuffle

mutual
  inductive Block.RunnerSafe : Block → Prop where
    | nil : Block.RunnerSafe { stmts := [] }
    | cons {stmt : Stmt} {rest : List Stmt}
        (hStmt : Stmt.RunnerSafe stmt)
        (hRest : Block.RunnerSafe { stmts := rest }) :
        Block.RunnerSafe { stmts := stmt :: rest }

  inductive Stmt.RunnerSafe : Stmt → Prop where
    | code {code : Code} (hCode : Code.RunnerSafe code) :
        Stmt.RunnerSafe (.code code)
    | if_ {cond : Code} {body : Block}
        (hCond : Code.RunnerSafe cond)
        (hBody : Block.RunnerSafe body) :
        Stmt.RunnerSafe (.if_ cond body)
    | switch {scrutinee : Code} {cases : List (Word × Block)}
        {defaultBody : Option Block}
        (hScrutinee : Code.RunnerSafe scrutinee)
        (hCases :
          ∀ value body, (value, body) ∈ cases → Block.RunnerSafe body)
        (hDefault :
          ∀ body, defaultBody = some body → Block.RunnerSafe body) :
        Stmt.RunnerSafe (.switch scrutinee cases defaultBody)
    | for_ {init post body : Block} {cond : Code}
        (hInit : Block.RunnerSafe init)
        (hCond : Code.RunnerSafe cond)
        (hPost : Block.RunnerSafe post)
        (hBody : Block.RunnerSafe body) :
        Stmt.RunnerSafe (.for_ init cond post body)
    | brk : Stmt.RunnerSafe .brk
    | cont : Stmt.RunnerSafe .cont
    | leave : Stmt.RunnerSafe .leave
    | call {name : Name} : Stmt.RunnerSafe (.call name)
    | terminal {kind : Assembly.HaltKind} : Stmt.RunnerSafe (.terminal kind)
end

namespace Proc

def RunnerSafe (proc : Proc) : Prop :=
  Block.RunnerSafe proc.body

end Proc

namespace ProcList

def RunnerSafe : List Proc → Prop
  | [] => True
  | proc :: rest => Proc.RunnerSafe proc ∧ RunnerSafe rest

end ProcList

namespace Program

def RunnerSafe (program : Program) : Prop :=
  ProcList.RunnerSafe program.procs ∧ Block.RunnerSafe program.body

end Program

namespace ProcList

theorem RunnerSafe_of_lookup? {procs : List Proc} {name : Name} {proc : Proc}
    (hSafe : RunnerSafe procs)
    (hLookup : EvmCompiler.Structured.ProcList.lookup? name procs = some proc) :
    Proc.RunnerSafe proc := by
  induction procs with
  | nil =>
      simp [EvmCompiler.Structured.ProcList.lookup?] at hLookup
  | cons head rest ih =>
      unfold EvmCompiler.Structured.ProcList.lookup? at hLookup
      by_cases hName : head.name = name
      · simp [hName] at hLookup
        cases hLookup
        exact hSafe.1
      · simp [hName] at hLookup
        exact ih hSafe.2 hLookup

theorem FrameSafe_of_lookup? {procs : List Proc} {name : Name} {proc : Proc}
    (hSafe : EvmCompiler.Structured.ProcList.FrameSafe procs)
    (hLookup : EvmCompiler.Structured.ProcList.lookup? name procs = some proc) :
    Proc.FrameSafe proc := by
  induction procs with
  | nil =>
      simp [EvmCompiler.Structured.ProcList.lookup?] at hLookup
  | cons head rest ih =>
      unfold EvmCompiler.Structured.ProcList.lookup? at hLookup
      by_cases hName : head.name = name
      · simp [hName] at hLookup
        cases hLookup
        exact hSafe.1
      · simp [hName] at hLookup
        exact ih hSafe.2 hLookup

end ProcList

namespace Program

theorem procRunnerSafe_of_lookup? {program : Program} {name : Name}
    {proc : Proc}
    (hSafe : Program.RunnerSafe program)
    (hLookup :
      EvmCompiler.Structured.ProcList.lookup? name program.procs = some proc) :
    Proc.RunnerSafe proc :=
  ProcList.RunnerSafe_of_lookup? hSafe.1 hLookup

theorem procFrameSafe_of_lookup? {program : Program} {name : Name}
    {proc : Proc}
    (hSafe : EvmCompiler.Structured.Program.FrameSafe program)
    (hLookup :
      EvmCompiler.Structured.ProcList.lookup? name program.procs = some proc) :
    Proc.FrameSafe proc :=
  ProcList.FrameSafe_of_lookup? hSafe.1 hLookup

end Program

namespace Frame

namespace StackFrameFacts

theorem splitArgs?_append {argc : Nat} {stack args callerStack : EvmYul.Stack Word}
    (hSplit : StackFrame.splitArgs? argc stack = some (args, callerStack)) :
    args ++ callerStack = stack := by
  unfold StackFrame.splitArgs? at hSplit
  split at hSplit
  · cases hSplit
    exact List.take_append_drop argc stack
  · cases hSplit

theorem splitArgs?_args_length {argc : Nat}
    {stack args callerStack : EvmYul.Stack Word}
    (hSplit : StackFrame.splitArgs? argc stack = some (args, callerStack)) :
    args.length = argc := by
  unfold StackFrame.splitArgs? at hSplit
  by_cases hLe : argc ≤ stack.length
  · rw [if_pos hLe] at hSplit
    cases hSplit
    simp [List.length_take, Nat.min_eq_left hLe]
  · rw [if_neg hLe] at hSplit
    cases hSplit

theorem attachReturns?_eq {frame : ReturnDest}
    {returnValues stack : EvmYul.Stack Word}
    (hAttach : StackFrame.attachReturns? frame returnValues = some stack) :
    stack = returnValues ++ frame.callerStack := by
  unfold StackFrame.attachReturns? at hAttach
  split at hAttach
  · cases hAttach
    rfl
  · cases hAttach

end StackFrameFacts

namespace RunState

theorem popReturn?_returns_eq {state : RunState} {frame : ReturnDest}
    {returned : RunState}
    (hPop : state.popReturn? = some (frame, returned)) :
    state.returns = frame :: returned.returns := by
  cases hReturns : state.returns with
  | nil =>
      simp [RunState.popReturn?, hReturns] at hPop
  | cons head rest =>
      simp [RunState.popReturn?, hReturns] at hPop
      rcases hPop with ⟨hHead, hReturned⟩
      cases hHead
      cases hReturned
      rfl

end RunState

namespace StackFrameFacts

theorem attachReturns?_length {frame : ReturnDest}
    {returnValues stack : EvmYul.Stack Word}
    (hAttach : StackFrame.attachReturns? frame returnValues = some stack) :
    returnValues.length = frame.retc := by
  unfold StackFrame.attachReturns? at hAttach
  split at hAttach
  · assumption
  · cases hAttach

end StackFrameFacts

namespace Outcome

def ReturnsPreserved (initial : RunState) (outcome : Outcome) : Prop :=
  match outcome.mode with
  | .halt _ => True
  | _ => outcome.state.returns = initial.returns

end Outcome

theorem code_runState_returns_eq {code : Code} {state final : RunState}
    (hRun : EvmCompiler.Structured.Code.runState code state = .ok final) :
    final.returns = state.returns := by
  unfold EvmCompiler.Structured.Code.runState at hRun
  cases hCode : EvmCompiler.Structured.Code.run code state.evm with
  | error err =>
      simp [hCode, Bind.bind, Except.bind] at hRun
  | ok evm =>
      simp [hCode] at hRun
      cases hRun
      rfl

theorem code_runConditionState_returns_eq {code : Code}
    {state final : RunState} {cond : Bool}
    (hRun :
      EvmCompiler.Structured.Code.runConditionState code state =
        .ok (final, cond)) :
    final.returns = state.returns := by
  unfold EvmCompiler.Structured.Code.runConditionState at hRun
  cases hCond : EvmCompiler.Structured.Code.runCondition code state.evm with
  | error err =>
      simp [hCond, Bind.bind, Except.bind] at hRun
  | ok result =>
      rcases result with ⟨evm, cond'⟩
      simp [hCond] at hRun
      cases hRun
      rfl

mutual
  theorem Block.Eval.returns_preserved {program : Program} {fuel : Nat}
      {block : Block} {state : RunState} {outcome : Outcome}
      (hEval : Block.Eval program fuel block state outcome) :
      Outcome.ReturnsPreserved state outcome := by
    cases hEval with
    | nil =>
        simp [Outcome.ReturnsPreserved, Outcome.regular]
    | cons_regular hStmt hRest =>
        have hStmtReturns := Stmt.Eval.returns_preserved hStmt
        have hRestReturns := Block.Eval.returns_preserved hRest
        cases outcome with
        | mk outState outMode =>
            cases outMode <;>
              simp [Outcome.ReturnsPreserved, Outcome.regular] at hStmtReturns hRestReturns ⊢
            · exact hRestReturns.trans hStmtReturns
            · exact hRestReturns.trans hStmtReturns
            · exact hRestReturns.trans hStmtReturns
            · exact hRestReturns.trans hStmtReturns
    | cons_brk hStmt =>
        simpa [Outcome.ReturnsPreserved, Outcome.brk] using
          Stmt.Eval.returns_preserved hStmt
    | cons_cont hStmt =>
        simpa [Outcome.ReturnsPreserved, Outcome.cont] using
          Stmt.Eval.returns_preserved hStmt
    | cons_leave hStmt =>
        simpa [Outcome.ReturnsPreserved, Outcome.leave] using
          Stmt.Eval.returns_preserved hStmt
    | cons_halt hStmt =>
        simp [Outcome.ReturnsPreserved, Outcome.halt]

  theorem Stmt.Eval.returns_preserved {program : Program} {fuel : Nat}
      {stmt : Stmt} {state : RunState} {outcome : Outcome}
      (hEval : Stmt.Eval program fuel stmt state outcome) :
      Outcome.ReturnsPreserved state outcome := by
    cases hEval with
    | code hCode =>
        simpa [Outcome.ReturnsPreserved, Outcome.regular] using
          code_runState_returns_eq hCode
    | if_false hCond =>
        simpa [Outcome.ReturnsPreserved, Outcome.regular] using
          code_runConditionState_returns_eq hCond
    | if_true hCond hBody =>
        have hCondReturns := code_runConditionState_returns_eq hCond
        have hBodyReturns := Block.Eval.returns_preserved hBody
        cases outcome with
        | mk outState outMode =>
            cases outMode <;>
              simp [Outcome.ReturnsPreserved] at hBodyReturns ⊢
            · exact hBodyReturns.trans hCondReturns
            · exact hBodyReturns.trans hCondReturns
            · exact hBodyReturns.trans hCondReturns
            · exact hBodyReturns.trans hCondReturns
    | switch_none hScrutinee hPop hSelect =>
        simpa [Outcome.ReturnsPreserved, Outcome.regular, RunState.withEVM]
          using code_runState_returns_eq hScrutinee
    | switch_some hScrutinee hPop hStateAfterPop hSelect hBody =>
        have hScrutineeReturns := code_runState_returns_eq hScrutinee
        have hBodyReturns := Block.Eval.returns_preserved hBody
        subst hStateAfterPop
        cases outcome with
        | mk outState outMode =>
            cases outMode <;>
              simp [Outcome.ReturnsPreserved, RunState.withEVM] at hBodyReturns ⊢
            · exact hBodyReturns.trans hScrutineeReturns
            · exact hBodyReturns.trans hScrutineeReturns
            · exact hBodyReturns.trans hScrutineeReturns
            · exact hBodyReturns.trans hScrutineeReturns
    | for_init_regular hInit hLoop =>
        have hInitReturns := Block.Eval.returns_preserved hInit
        have hLoopReturns := For.Eval.returns_preserved hLoop
        cases outcome with
        | mk outState outMode =>
            cases outMode <;>
              simp [Outcome.ReturnsPreserved, Outcome.regular] at hInitReturns hLoopReturns ⊢
            · exact hLoopReturns.trans hInitReturns
            · exact hLoopReturns.trans hInitReturns
            · exact hLoopReturns.trans hInitReturns
            · exact hLoopReturns.trans hInitReturns
    | for_init_leave hInit =>
        simpa [Outcome.ReturnsPreserved, Outcome.leave] using
          Block.Eval.returns_preserved hInit
    | for_init_halt hInit =>
        simp [Outcome.ReturnsPreserved, Outcome.halt]
    | brk =>
        simp [Outcome.ReturnsPreserved, Outcome.brk]
    | cont =>
        simp [Outcome.ReturnsPreserved, Outcome.cont]
    | leave hReturns =>
        simp [Outcome.ReturnsPreserved, Outcome.leave]
    | call_regular hLookup hSplit hBody hPop hAttach =>
        rename_i proc args callerStack stack bodyState returned frame
        have hBodyReturns := Block.Eval.returns_preserved hBody
        have hPopReturns := RunState.popReturn?_returns_eq hPop
        have hReturnedReturns : returned.returns = state.returns := by
          simp [Outcome.ReturnsPreserved, Outcome.regular,
            RunState.withEVM, RunState.pushReturn] at hBodyReturns
          rw [hPopReturns] at hBodyReturns
          exact (List.cons.inj hBodyReturns).2
        simpa [Outcome.ReturnsPreserved, Outcome.regular, RunState.withEVM]
          using hReturnedReturns
    | call_leave hLookup hSplit hBody hPop hAttach =>
        rename_i proc args callerStack stack bodyState returned frame
        have hBodyReturns := Block.Eval.returns_preserved hBody
        have hPopReturns := RunState.popReturn?_returns_eq hPop
        have hReturnedReturns : returned.returns = state.returns := by
          simp [Outcome.ReturnsPreserved, Outcome.leave,
            RunState.withEVM, RunState.pushReturn] at hBodyReturns
          rw [hPopReturns] at hBodyReturns
          exact (List.cons.inj hBodyReturns).2
        simpa [Outcome.ReturnsPreserved, Outcome.regular, RunState.withEVM]
          using hReturnedReturns
    | call_halt hLookup hSplit hBody =>
        simp [Outcome.ReturnsPreserved, Outcome.halt]
    | terminal hStep =>
        simp [Outcome.ReturnsPreserved, Outcome.halt]

  theorem For.Eval.returns_preserved {program : Program} {fuel : Nat}
      {cond : Code} {post body : Block} {state : RunState}
      {outcome : Outcome}
      (hEval : For.Eval program fuel cond post body state outcome) :
      Outcome.ReturnsPreserved state outcome := by
    cases hEval with
    | false hCond =>
        simpa [Outcome.ReturnsPreserved, Outcome.regular] using
          code_runConditionState_returns_eq hCond
    | body_brk hCond hBody =>
        have hCondReturns := code_runConditionState_returns_eq hCond
        have hBodyReturns := Block.Eval.returns_preserved hBody
        simp [Outcome.ReturnsPreserved, Outcome.regular, Outcome.brk] at hBodyReturns ⊢
        exact hBodyReturns.trans hCondReturns
    | body_leave hCond hBody =>
        have hCondReturns := code_runConditionState_returns_eq hCond
        have hBodyReturns := Block.Eval.returns_preserved hBody
        simp [Outcome.ReturnsPreserved, Outcome.leave] at hBodyReturns ⊢
        exact hBodyReturns.trans hCondReturns
    | body_halt hCond hBody =>
        simp [Outcome.ReturnsPreserved, Outcome.halt]
    | regular_post_regular hCond hBody hPost hLoop =>
        have hCondReturns := code_runConditionState_returns_eq hCond
        have hBodyReturns := Block.Eval.returns_preserved hBody
        have hPostReturns := Block.Eval.returns_preserved hPost
        have hLoopReturns := For.Eval.returns_preserved hLoop
        cases outcome with
        | mk outState outMode =>
            cases outMode <;>
              simp [Outcome.ReturnsPreserved, Outcome.regular] at hBodyReturns hPostReturns hLoopReturns ⊢
            · exact hLoopReturns.trans (hPostReturns.trans
                (hBodyReturns.trans hCondReturns))
            · exact hLoopReturns.trans (hPostReturns.trans
                (hBodyReturns.trans hCondReturns))
            · exact hLoopReturns.trans (hPostReturns.trans
                (hBodyReturns.trans hCondReturns))
            · exact hLoopReturns.trans (hPostReturns.trans
                (hBodyReturns.trans hCondReturns))
    | cont_post_regular hCond hBody hPost hLoop =>
        have hCondReturns := code_runConditionState_returns_eq hCond
        have hBodyReturns := Block.Eval.returns_preserved hBody
        have hPostReturns := Block.Eval.returns_preserved hPost
        have hLoopReturns := For.Eval.returns_preserved hLoop
        cases outcome with
        | mk outState outMode =>
            cases outMode <;>
              simp [Outcome.ReturnsPreserved, Outcome.cont, Outcome.regular] at hBodyReturns hPostReturns hLoopReturns ⊢
            · exact hLoopReturns.trans (hPostReturns.trans
                (hBodyReturns.trans hCondReturns))
            · exact hLoopReturns.trans (hPostReturns.trans
                (hBodyReturns.trans hCondReturns))
            · exact hLoopReturns.trans (hPostReturns.trans
                (hBodyReturns.trans hCondReturns))
            · exact hLoopReturns.trans (hPostReturns.trans
                (hBodyReturns.trans hCondReturns))
    | regular_post_leave hCond hBody hPost =>
        have hCondReturns := code_runConditionState_returns_eq hCond
        have hBodyReturns := Block.Eval.returns_preserved hBody
        have hPostReturns := Block.Eval.returns_preserved hPost
        simp [Outcome.ReturnsPreserved, Outcome.regular, Outcome.leave] at hBodyReturns hPostReturns ⊢
        exact hPostReturns.trans (hBodyReturns.trans hCondReturns)
    | cont_post_leave hCond hBody hPost =>
        have hCondReturns := code_runConditionState_returns_eq hCond
        have hBodyReturns := Block.Eval.returns_preserved hBody
        have hPostReturns := Block.Eval.returns_preserved hPost
        simp [Outcome.ReturnsPreserved, Outcome.cont, Outcome.leave] at hBodyReturns hPostReturns ⊢
        exact hPostReturns.trans (hBodyReturns.trans hCondReturns)
    | regular_post_halt hCond hBody hPost =>
        simp [Outcome.ReturnsPreserved, Outcome.halt]
    | cont_post_halt hCond hBody hPost =>
        simp [Outcome.ReturnsPreserved, Outcome.halt]
end

namespace CallFacts

theorem popReturn?_eq_pushed_frame {bodyState returned : RunState}
    {frame : ReturnDest} {caller : RunState}
    {callerStack : EvmYul.Stack Word} {retc : Nat}
    (hReturns :
      bodyState.returns =
        { callerStack := callerStack, retc := retc } :: caller.returns)
    (hPop : bodyState.popReturn? = some (frame, returned)) :
    frame = { callerStack := callerStack, retc := retc } ∧
      returned.returns = caller.returns := by
  have hPopReturns := RunState.popReturn?_returns_eq hPop
  rw [hReturns] at hPopReturns
  exact List.cons.inj hPopReturns.symm

theorem regular_body_pop_frame {program : Program} {fuel : Nat}
    {proc : Proc} {state bodyState returned : RunState}
    {args callerStack stack : EvmYul.Stack Word} {frame : ReturnDest}
    (hBody :
      Block.Eval program fuel proc.body
        ((state.withEVM { state.evm with stack := args }).pushReturn
          callerStack proc.retc)
        (Outcome.regular bodyState))
    (hPop : bodyState.popReturn? = some (frame, returned))
    (hAttach : StackFrame.attachReturns? frame bodyState.evm.stack = some stack) :
    frame = { callerStack := callerStack, retc := proc.retc } ∧
      returned.returns = state.returns ∧
      bodyState.evm.stack.length = proc.retc := by
  have hPreserved := Block.Eval.returns_preserved hBody
  simp [Outcome.ReturnsPreserved, Outcome.regular, RunState.withEVM,
    RunState.pushReturn] at hPreserved
  rcases popReturn?_eq_pushed_frame
      (caller := state) (callerStack := callerStack)
      (retc := proc.retc) hPreserved hPop with
    ⟨hFrame, hReturned⟩
  have hLength := StackFrameFacts.attachReturns?_length hAttach
  subst hFrame
  exact ⟨rfl, hReturned, hLength⟩

theorem leave_body_pop_frame {program : Program} {fuel : Nat}
    {proc : Proc} {state bodyState returned : RunState}
    {args callerStack stack : EvmYul.Stack Word} {frame : ReturnDest}
    (hBody :
      Block.Eval program fuel proc.body
        ((state.withEVM { state.evm with stack := args }).pushReturn
          callerStack proc.retc)
        (Outcome.leave bodyState))
    (hPop : bodyState.popReturn? = some (frame, returned))
    (hAttach : StackFrame.attachReturns? frame bodyState.evm.stack = some stack) :
    frame = { callerStack := callerStack, retc := proc.retc } ∧
      returned.returns = state.returns ∧
      bodyState.evm.stack.length = proc.retc := by
  have hPreserved := Block.Eval.returns_preserved hBody
  simp [Outcome.ReturnsPreserved, Outcome.leave, RunState.withEVM,
    RunState.pushReturn] at hPreserved
  rcases popReturn?_eq_pushed_frame
      (caller := state) (callerStack := callerStack)
      (retc := proc.retc) hPreserved hPop with
    ⟨hFrame, hReturned⟩
  have hLength := StackFrameFacts.attachReturns?_length hAttach
  subst hFrame
  exact ⟨rfl, hReturned, hLength⟩

theorem returned_with_attached_eq {bodyState returned : RunState}
    {frame : ReturnDest} {stack : EvmYul.Stack Word}
    (hAttach :
      StackFrame.attachReturns? frame bodyState.evm.stack = some stack) :
    returned.withEVM { bodyState.evm with stack := stack } =
      { bodyState with
        evm :=
          { bodyState.evm with
            stack := bodyState.evm.stack ++ frame.callerStack }
        returns := returned.returns } := by
  have hStack := StackFrameFacts.attachReturns?_eq hAttach
  cases bodyState
  cases returned
  cases frame
  simp [RunState.withEVM] at hStack ⊢
  exact hStack

end CallFacts

/--
Materialize the source machine's ghost return stack as concrete hidden target
stack words.

The first token is hidden below the current visible frame. The frame's saved
caller stack then becomes the visible stack for the next outer frame.
-/
def materializeStack :
    EvmYul.Stack Word → List ReturnDest → List Word →
      Option (EvmYul.Stack Word)
  | visible, [], [] => some visible
  | visible, frame :: rest, token :: tokens => do
      let outer ← materializeStack frame.callerStack rest tokens
      some (visible ++ [token] ++ outer)
  | _, _, _ => none

def returnStackWeight : List ReturnDest → Nat
  | [] => 0
  | frame :: rest => frame.callerStack.length + 1 + returnStackWeight rest

def sourceStackWeight (source : RunState) : Nat :=
  source.evm.stack.length + returnStackWeight source.returns

def SourceStackHeadroom (source : RunState) : Prop :=
  sourceStackWeight source + 17 ≤ 1024

theorem materializeStack_length
    {visible stack : EvmYul.Stack Word}
    {returns : List ReturnDest} {tokens : List Word}
    (hStack : materializeStack visible returns tokens = some stack) :
    stack.length = visible.length + returnStackWeight returns := by
  induction returns generalizing visible tokens stack with
  | nil =>
      cases tokens with
      | nil =>
          simp [materializeStack] at hStack
          cases hStack
          simp [returnStackWeight]
      | cons _token _tokens =>
          simp [materializeStack] at hStack
  | cons frame rest ih =>
      cases tokens with
      | nil =>
          simp [materializeStack] at hStack
      | cons token tokens =>
          cases hOuter :
              materializeStack frame.callerStack rest tokens with
          | none =>
              simp [materializeStack, hOuter] at hStack
          | some outer =>
              simp [materializeStack, hOuter] at hStack
              cases hStack
              have hOuterLen := ih hOuter
              simp [returnStackWeight, List.length_append, hOuterLen]
              omega

structure StateRel (source : RunState) (target : EVMState)
    (tokens : List Word) : Prop where
  stackRel :
    materializeStack source.evm.stack source.returns tokens =
      some target.stack
  dataRel :
    eraseControl target =
      eraseControl { source.evm with stack := target.stack }

structure StaticReturnFrame where
  procName : Name
  token : Word
  returnLabel : Assembly.Label
  retc : Nat

namespace StaticReturnFrame

noncomputable def ValidFor (program : Program)
    (frame : StaticReturnFrame) : Prop :=
  ∃ proc site,
    ProcList.lookup? frame.procName program.procs = some proc ∧
      site ∈ program.compileResult.calls ∧
      site.procName = frame.procName ∧
      site.token = frame.token ∧
      site.returnLabel = frame.returnLabel ∧
      proc.retc = frame.retc

end StaticReturnFrame

inductive ReturnContextRel (program : Program) :
    List StaticReturnFrame → List ReturnDest → List Word → Prop where
  | nil : ReturnContextRel program [] [] []
  | cons {frame : StaticReturnFrame} {frames : List StaticReturnFrame}
      {ret : ReturnDest} {returns : List ReturnDest}
      {token : Word} {tokens : List Word}
      (hValid : frame.ValidFor program)
      (hToken : frame.token = token)
      (hRetc : frame.retc = ret.retc)
      (hRest : ReturnContextRel program frames returns tokens) :
      ReturnContextRel program (frame :: frames) (ret :: returns) (token :: tokens)

namespace ReturnContextRel

theorem frames_length_eq_returns_length {program : Program}
    {frames : List StaticReturnFrame}
    {returns : List ReturnDest} {tokens : List Word}
    (hRel : ReturnContextRel program frames returns tokens) :
    frames.length = returns.length := by
  induction hRel with
  | nil =>
      rfl
  | cons _hValid _hToken _hRetc _hRest ih =>
      simp [ih]

theorem tokens_length_eq_frames_length {program : Program}
    {frames : List StaticReturnFrame}
    {returns : List ReturnDest} {tokens : List Word}
    (hRel : ReturnContextRel program frames returns tokens) :
    tokens.length = frames.length := by
  induction hRel with
  | nil =>
      rfl
  | cons _hValid _hToken _hRetc _hRest ih =>
      simp [ih]

theorem tokens_length_eq_returns_length {program : Program}
    {frames : List StaticReturnFrame}
    {returns : List ReturnDest} {tokens : List Word}
    (hRel : ReturnContextRel program frames returns tokens) :
    tokens.length = returns.length := by
  rw [tokens_length_eq_frames_length hRel,
    frames_length_eq_returns_length hRel]

end ReturnContextRel

def TargetRel (program : Program) (source : RunState)
    (target : EVMState) (frames : List StaticReturnFrame) : Prop :=
  ∃ tokens,
    StateRel source target tokens ∧
      ReturnContextRel program frames source.returns tokens

namespace TargetRel

theorem initial (program : Program) (state : EVMState) :
    TargetRel program (RunState.initial state) state [] := by
  exact ⟨[], ⟨rfl, rfl⟩, ReturnContextRel.nil⟩

end TargetRel

namespace StateRel

theorem dataRel_replace_stack {source : RunState} {target : EVMState}
    {tokens : List Word} (hRel : StateRel source target tokens)
    (stack : EvmYul.Stack Word) :
    eraseControl { target with stack := stack } =
      eraseControl { source.evm with stack := stack } := by
  cases hRel with
  | mk hStack hData =>
      cases target
      cases source
      simp [eraseControl, Assembly.eraseGas] at hData ⊢
      exact hData

theorem target_stack_length_eq {source : RunState} {target : EVMState}
    {tokens : List Word} (hRel : StateRel source target tokens) :
    target.stack.length =
      source.evm.stack.length + returnStackWeight source.returns := by
  exact materializeStack_length hRel.stackRel

theorem target_stack_length_le_of_source_weight_le
    {source : RunState} {target : EVMState} {tokens : List Word}
    (hRel : StateRel source target tokens) {bound : Nat}
    (hBound :
      source.evm.stack.length + returnStackWeight source.returns ≤ bound) :
    target.stack.length ≤ bound := by
  rw [target_stack_length_eq hRel]
  exact hBound

theorem target_stack_headroom_of_source_weight_bound
    {source : RunState} {target : EVMState} {tokens : List Word}
    (hRel : StateRel source target tokens)
    (hBound :
      source.evm.stack.length + returnStackWeight source.returns + 17 ≤ 1024) :
    target.stack.length + 17 ≤ 1024 := by
  rw [target_stack_length_eq hRel]
  exact hBound

theorem target_stack_headroom_of_source_headroom
    {source : RunState} {target : EVMState} {tokens : List Word}
    (hRel : StateRel source target tokens)
    (hBound : SourceStackHeadroom source) :
    target.stack.length + 17 ≤ 1024 := by
  exact target_stack_headroom_of_source_weight_bound hRel hBound

end StateRel

@[simp] theorem materializeStack_nil (visible : EvmYul.Stack Word) :
    materializeStack visible [] [] = some visible := rfl

theorem materializeStack_append_visible
    {visible pref stack : EvmYul.Stack Word}
    {returns : List ReturnDest} {tokens : List Word}
    (hStack : materializeStack visible returns tokens = some stack) :
    materializeStack (pref ++ visible) returns tokens =
      some (pref ++ stack) := by
  cases returns with
  | nil =>
      cases tokens with
      | nil =>
          simp [materializeStack] at hStack
          cases hStack
          simp [materializeStack]
      | cons token tokens =>
          simp [materializeStack] at hStack
  | cons frame rest =>
      cases tokens with
      | nil =>
          simp [materializeStack] at hStack
      | cons token tokens =>
          cases hOuter :
              materializeStack frame.callerStack rest tokens with
          | none =>
              simp [materializeStack, hOuter] at hStack
          | some outer =>
              simp [materializeStack, hOuter] at hStack
              cases hStack
              simp [materializeStack, hOuter, List.append_assoc]

theorem materializeStack_of_append_visible
    {pref visible stack : EvmYul.Stack Word}
    {returns : List ReturnDest} {tokens : List Word}
    (hStack : materializeStack (pref ++ visible) returns tokens = some stack) :
    ∃ inner,
      materializeStack visible returns tokens = some inner ∧
        stack = pref ++ inner := by
  cases returns with
  | nil =>
      cases tokens with
      | nil =>
          simp [materializeStack] at hStack
          cases hStack
          exact ⟨visible, rfl, rfl⟩
      | cons _token _tokens =>
          simp [materializeStack] at hStack
  | cons frame rest =>
      cases tokens with
      | nil =>
          simp [materializeStack] at hStack
      | cons token tokens =>
          cases hOuter : materializeStack frame.callerStack rest tokens with
          | none =>
              simp [materializeStack, hOuter] at hStack
          | some outer =>
              simp [materializeStack, hOuter] at hStack
              cases hStack
              refine ⟨visible ++ [token] ++ outer, ?_, ?_⟩
              · simp [materializeStack, hOuter, List.append_assoc]
              · simp [List.append_assoc]

theorem materializeStack_suffix
    {visible stack : EvmYul.Stack Word}
    {returns : List ReturnDest} {tokens : List Word}
    (hStack : materializeStack visible returns tokens = some stack) :
    ∃ suffix,
      stack = visible ++ suffix ∧
        ∀ newVisible : EvmYul.Stack Word,
          materializeStack newVisible returns tokens =
            some (newVisible ++ suffix) := by
  cases returns with
  | nil =>
      cases tokens with
      | nil =>
          simp [materializeStack] at hStack
          cases hStack
          refine ⟨[], ?_, ?_⟩
          · simp
          · intro newVisible
            simp [materializeStack]
      | cons _token _tokens =>
          simp [materializeStack] at hStack
  | cons frame rest =>
      cases tokens with
      | nil =>
          simp [materializeStack] at hStack
      | cons token tokens =>
          cases hOuter :
              materializeStack frame.callerStack rest tokens with
          | none =>
              simp [materializeStack, hOuter] at hStack
          | some outer =>
              simp [materializeStack, hOuter] at hStack
              cases hStack
              refine ⟨[token] ++ outer, ?_, ?_⟩
              · simp
              · intro newVisible
                simp [materializeStack, hOuter, List.append_assoc]

namespace StateRel

theorem hidden_suffix {source : RunState} {target : EVMState}
    {tokens : List Word} (hRel : StateRel source target tokens) :
    ∃ suffix,
      target.stack = source.evm.stack ++ suffix ∧
        ∀ newVisible : EvmYul.Stack Word,
          materializeStack newVisible source.returns tokens =
            some (newVisible ++ suffix) := by
  exact materializeStack_suffix hRel.stackRel

theorem replace_visible_stack {source : RunState} {target : EVMState}
    {tokens : List Word} (hRel : StateRel source target tokens)
    (newVisible : EvmYul.Stack Word) :
    ∃ suffix,
      target.stack = source.evm.stack ++ suffix ∧
        StateRel
          { source with evm := { source.evm with stack := newVisible } }
          { target with stack := newVisible ++ suffix }
          tokens := by
  rcases hRel.hidden_suffix with ⟨suffix, hTargetStack, hMaterialize⟩
  refine ⟨suffix, hTargetStack, ?_⟩
  refine ⟨?_, ?_⟩
  · simpa using hMaterialize newVisible
  · simpa using hRel.dataRel_replace_stack (newVisible ++ suffix)

theorem with_visible_prefix {source : RunState} {target : EVMState}
    {tokens : List Word} (hRel : StateRel source target tokens)
    (stackPrefix : EvmYul.Stack Word) :
    StateRel
      (source.withEVM
        { source.evm with stack := stackPrefix ++ source.evm.stack })
      { target with stack := stackPrefix ++ target.stack }
      tokens := by
  refine ⟨?_, ?_⟩
  · simpa [RunState.withEVM] using
      materializeStack_append_visible
        (visible := source.evm.stack) (pref := stackPrefix) hRel.stackRel
  · calc
      eraseControl { target with stack := stackPrefix ++ target.stack }
          =
            eraseControl
              { { source.evm with stack := target.stack } with
                stack := stackPrefix ++ target.stack } :=
              eraseControl_with_stack_congr hRel.dataRel
      _ =
            eraseControl
              { (source.withEVM
                    { source.evm with stack := stackPrefix ++ source.evm.stack }).evm with
                stack := stackPrefix ++ target.stack } := by
              simp [RunState.withEVM]

theorem cast_source {oldSource newSource : RunState} {target : EVMState}
    {tokens : List Word}
    (hRel : StateRel oldSource target tokens)
    (hReturns : newSource.returns = oldSource.returns)
    (hStack : newSource.evm.stack = oldSource.evm.stack)
    (hErase : eraseControl newSource.evm = eraseControl oldSource.evm) :
    StateRel newSource target tokens := by
  refine ⟨?_, ?_⟩
  · rw [hReturns, hStack]
    exact hRel.stackRel
  · calc
      eraseControl target
          = eraseControl { oldSource.evm with stack := target.stack } :=
              hRel.dataRel
      _ = eraseControl { newSource.evm with stack := target.stack } := by
          exact
            (eraseControl_with_stack_congr
              (left := newSource.evm) (right := oldSource.evm)
              (stack := target.stack) hErase).symm

theorem pop_visible {source : RunState} {target : EVMState}
    {tokens : List Word} {stack : EvmYul.Stack Word} {value : Word}
    (hRel : StateRel source target tokens)
    (hPop : source.evm.stack.pop = some (stack, value)) :
    ∃ suffix,
      target.stack = source.evm.stack ++ suffix ∧
        target.stack.pop = some (stack ++ suffix, value) ∧
        StateRel
          (source.withEVM { source.evm with stack := stack })
          { target with stack := stack ++ suffix }
          tokens := by
  rcases hRel.replace_visible_stack stack with
    ⟨suffix, hTargetStack, hRelAfter⟩
  refine ⟨suffix, hTargetStack, ?_, hRelAfter⟩
  rw [hTargetStack]
  cases hSourceStack : source.evm.stack with
  | nil =>
      simp [hSourceStack, EvmYul.Stack.pop] at hPop
  | cons top rest =>
      simp [hSourceStack, EvmYul.Stack.pop] at hPop
      rcases hPop with ⟨hStack, hValue⟩
      cases hStack
      cases hValue
      simp [EvmYul.Stack.pop]

theorem runState_frameSafe_hidden_exists {source final : RunState}
    {target : EVMState} {tokens : List Word} {code : Code}
    (hRel : StateRel source target tokens)
    (hFrame : Code.FrameSafe code)
    (hRun : Code.runState code source = .ok final) :
    ∃ hiddenFinal,
      Code.run code { source.evm with stack := target.stack } =
        .ok hiddenFinal ∧
        StateRel final hiddenFinal tokens := by
  unfold Code.runState at hRun
  cases hCode : Code.run code source.evm with
  | error _err =>
      rw [hCode] at hRun
      cases hRun
  | ok evmFinal =>
      rw [hCode] at hRun
      change Except.ok (source.withEVM evmFinal) = Except.ok final at hRun
      cases hRun
      rcases hRel.hidden_suffix with ⟨suffix, hTargetStack, hMaterialize⟩
      let hiddenFinal : EVMState :=
        { evmFinal with stack := evmFinal.stack ++ suffix }
      have hHiddenRun :
          Code.run code
              { source.evm with stack := source.evm.stack ++ suffix } =
            .ok hiddenFinal := by
        simpa [hiddenFinal] using hFrame source.evm evmFinal suffix hCode
      refine ⟨hiddenFinal, ?_, ?_⟩
      · rw [hTargetStack]
        exact hHiddenRun
      · refine ⟨?_, ?_⟩
        · simpa [RunState.withEVM, hiddenFinal] using
            hMaterialize evmFinal.stack
        · simp [RunState.withEVM, hiddenFinal]

theorem source_run_code_ctx {source final : RunState}
    {target : EVMState} {tokens : List Word} {code : Code}
    {pre post : Assembly.Program}
    (hSafe : Code.RunnerSafe code)
    (hFrame : Code.FrameSafe code)
    (hFits : Code.PCFitsFrom pre code)
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : StateRel source target tokens)
    (hRun : Code.runState code source = .ok final) :
    ARun (pre ++ code.toAssembly ++ post) target
      (fun target' =>
        StateRel final target' tokens ∧
          target'.pc = Assembly.Program.pcAfter (pre ++ code.toAssembly)) := by
  rcases hRel.runState_frameSafe_hidden_exists hFrame hRun with
    ⟨hiddenFinal, hHiddenRun, hHiddenRel⟩
  have hRelAt :
      RelAt (Assembly.Program.pcAfter pre) target
        { source.evm with stack := target.stack } := by
    exact ⟨hPc, hRel.dataRel⟩
  have hRunAssembly :=
    Code.source_run_ctx_relAt_of_relAt
      (code := code) (pre := pre) (post := post)
      hSafe hFits hRelAt hHiddenRun
  exact ARun.mono hRunAssembly (by
    intro target' hEnd
    have hStack : target'.stack = hiddenFinal.stack :=
      stack_eq_of_eraseControl_eq hEnd.sameData
    refine ⟨?_, hEnd.pc_eq⟩
    refine ⟨?_, ?_⟩
    · rw [hStack]
      exact hHiddenRel.stackRel
    · calc
        eraseControl target'
            = eraseControl hiddenFinal := hEnd.sameData
        _ = eraseControl { final.evm with stack := hiddenFinal.stack } :=
            hHiddenRel.dataRel
        _ = eraseControl { final.evm with stack := target'.stack } := by
            rw [hStack])

theorem source_run_code_ctx_result {source final : RunState}
    {target : EVMState} {tokens : List Word} {code : Code}
    {pre post : Assembly.Program}
    (hSafe : Code.RunnerSafe code)
    (hFrame : Code.FrameSafe code)
    (hFits : Code.PCFitsFrom pre code)
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : StateRel source target tokens)
    (hRun : Code.runState code source = .ok final) :
    ARunResult (pre ++ code.toAssembly ++ post) target
      (fun result =>
        match result with
        | .running target' =>
            StateRel final target' tokens ∧
              target'.pc =
                Assembly.Program.pcAfter (pre ++ code.toAssembly)
        | .halted _ => False) := by
  rcases hRel.runState_frameSafe_hidden_exists hFrame hRun with
    ⟨hiddenFinal, hHiddenRun, hHiddenRel⟩
  have hRelAt :
      RelAt (Assembly.Program.pcAfter pre) target
        { source.evm with stack := target.stack } := by
    exact ⟨hPc, hRel.dataRel⟩
  have hRunAssembly :=
    Code.source_runResult_ctx_relAt_of_relAt
      (code := code) (pre := pre) (post := post)
      hSafe hFits hRelAt hHiddenRun
  exact ARunResult.mono hRunAssembly (by
    intro result hEnd
    cases result with
    | halted halt =>
        cases hEnd
    | running target' =>
        have hStack : target'.stack = hiddenFinal.stack :=
          stack_eq_of_eraseControl_eq hEnd.sameData
        refine ⟨?_, hEnd.pc_eq⟩
        refine ⟨?_, ?_⟩
        · rw [hStack]
          exact hHiddenRel.stackRel
        · calc
            eraseControl target'
                = eraseControl hiddenFinal := hEnd.sameData
            _ = eraseControl { final.evm with stack := hiddenFinal.stack } :=
                hHiddenRel.dataRel
            _ = eraseControl { final.evm with stack := target'.stack } := by
                rw [hStack])

theorem popCondition_hidden_suffix {state final : EVMState}
    {hidden : EvmYul.Stack Word} {condTrue : Bool}
    (hPop : Code.popCondition state = .ok (final, condTrue)) :
    Code.popCondition { state with stack := state.stack ++ hidden } =
      .ok ({ final with stack := final.stack ++ hidden }, condTrue) := by
  rcases state with ⟨shared, pc, stack, execLength⟩
  cases stack with
  | nil =>
      simp [Code.popCondition, EvmYul.Stack.pop] at hPop
  | cons condWord rest =>
      simp [Code.popCondition, EvmYul.Stack.pop] at hPop ⊢
      rcases hPop with ⟨hFinal, hCond⟩
      cases hFinal
      exact ⟨⟨rfl, rfl, rfl, rfl⟩, hCond⟩

theorem runConditionState_frameSafe_hidden_exists
    {source final : RunState} {target : EVMState}
    {tokens : List Word} {code : Code} {condTrue : Bool}
    (hRel : StateRel source target tokens)
    (hFrame : Code.FrameSafe code)
    (hRun : Code.runConditionState code source = .ok (final, condTrue)) :
    ∃ hiddenFinal,
      Code.runCondition code { source.evm with stack := target.stack } =
        .ok (hiddenFinal, condTrue) ∧
        StateRel final hiddenFinal tokens := by
  unfold Code.runConditionState Code.runCondition at hRun
  cases hCode : Code.run code source.evm with
  | error _err =>
      rw [hCode] at hRun
      cases hRun
  | ok evmAfterCode =>
      rw [hCode] at hRun
      cases hPop : Code.popCondition evmAfterCode with
      | error _err =>
          simp [hPop, Bind.bind, Except.bind] at hRun
      | ok popResult =>
          rcases popResult with ⟨evmAfterPop, condResult⟩
          simp [hPop, Bind.bind, Except.bind] at hRun
          rcases hRun with ⟨hFinal, hCond⟩
          cases hFinal
          cases hCond
          rcases hRel.hidden_suffix with ⟨suffix, hTargetStack, hMaterialize⟩
          let hiddenAfterCode : EVMState :=
            { evmAfterCode with stack := evmAfterCode.stack ++ suffix }
          have hHiddenCode :
              Code.run code
                  { source.evm with stack := source.evm.stack ++ suffix } =
                .ok hiddenAfterCode := by
            simpa [hiddenAfterCode] using
              hFrame source.evm evmAfterCode suffix hCode
          have hHiddenPop :
                  Code.popCondition hiddenAfterCode =
                .ok
                  ({ evmAfterPop with stack := evmAfterPop.stack ++ suffix },
                    condTrue) := by
            simpa [hiddenAfterCode] using
              popCondition_hidden_suffix (hidden := suffix) hPop
          refine
            ⟨{ evmAfterPop with stack := evmAfterPop.stack ++ suffix },
              ?_, ?_⟩
          · rw [hTargetStack]
            unfold Code.runCondition
            rw [hHiddenCode]
            simpa [hHiddenPop, Bind.bind, Except.bind]
          · refine ⟨?_, ?_⟩
            · simpa [RunState.withEVM] using hMaterialize evmAfterPop.stack
            · simp [RunState.withEVM]

theorem runCondition_jumpi_result_ctx
    {code : Code} {label : Assembly.Label} {dest : Nat}
    {pre post : Assembly.Program}
    {source final : RunState} {target : EVMState}
    {tokens : List Word} {condTrue : Bool}
    (hSafe : Code.RunnerSafe code)
    (hFrame : Code.FrameSafe code)
    (hFits : Code.PCFitsFrom pre code)
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : StateRel source target tokens)
    (hLabel :
      Assembly.Program.labelPc
          (pre ++ code.toAssembly ++ [Assembly.Instr.jumpi label] ++ post)
          label = some dest)
    (hRun :
      Code.runConditionState code source = .ok (final, condTrue)) :
    ARunResult
      (pre ++ code.toAssembly ++ [Assembly.Instr.jumpi label] ++ post)
      target
      (fun result =>
        match result with
        | .running target' =>
            StateRel final target' tokens ∧
              target'.pc =
                if condTrue then
                  EvmYul.UInt256.ofNat dest
                else
                  Assembly.Program.pcAfter
                    (pre ++ code.toAssembly ++ [Assembly.Instr.jumpi label])
        | .halted _ => False) := by
  rcases hRel.runConditionState_frameSafe_hidden_exists hFrame hRun with
    ⟨hiddenFinal, hHiddenRun, hHiddenRel⟩
  have hRelAt :
      RelAt (Assembly.Program.pcAfter pre) target
        { source.evm with stack := target.stack } := by
    exact ⟨hPc, hRel.dataRel⟩
  have hRunAssembly :=
    Code.runCondition_jumpi_result_ctx_relAt_of_relAt
      (cond := code) (label := label) (dest := dest)
      (pre := pre) (post := post)
      hSafe hFits hRelAt hLabel hHiddenRun
  exact ARunResult.mono hRunAssembly (by
    intro result hResult
    cases result with
    | halted halt =>
        cases hResult
    | running target' =>
        have hStack : target'.stack = hiddenFinal.stack :=
          stack_eq_of_eraseControl_eq hResult.sameData
        refine ⟨?_, hResult.pc_eq⟩
        refine ⟨?_, ?_⟩
        · rw [hStack]
          exact hHiddenRel.stackRel
        · calc
            eraseControl target'
                = eraseControl hiddenFinal := hResult.sameData
            _ = eraseControl { final.evm with stack := hiddenFinal.stack } :=
                hHiddenRel.dataRel
            _ = eraseControl { final.evm with stack := target'.stack } := by
                rw [hStack])

end StateRel

theorem stateRel_initial (state : EVMState) :
    StateRel (RunState.initial state) state [] := by
  exact ⟨rfl, rfl⟩

theorem materializeStack_cons
    {visible outer stack : EvmYul.Stack Word}
    {returns : List ReturnDest} {tokens : List Word}
    {frame : ReturnDest} {token : Word}
    (hOuter : materializeStack frame.callerStack returns tokens = some outer)
    (hStack : stack = visible ++ [token] ++ outer) :
    materializeStack visible (frame :: returns) (token :: tokens) =
      some stack := by
  subst stack
  simp [materializeStack, hOuter]

theorem materializeStack_callEntry
    {args callerTarget : EvmYul.Stack Word}
    {returns : List ReturnDest} {tokens : List Word}
    {callerStack : EvmYul.Stack Word} {retc : Nat} {token : Word}
    (hCaller :
      materializeStack callerStack returns tokens = some callerTarget) :
    materializeStack args
        ({ callerStack := callerStack, retc := retc } :: returns)
        (token :: tokens) =
      some (args ++ [token] ++ callerTarget) := by
  exact materializeStack_cons (visible := args)
    (frame := { callerStack := callerStack, retc := retc })
    (token := token) hCaller rfl

theorem materializeStack_returnAttach
    {returns : List ReturnDest} {tokens : List Word}
    {callerStack callerTarget returnValues : EvmYul.Stack Word}
    (hCaller :
      materializeStack callerStack returns tokens = some callerTarget) :
    materializeStack (returnValues ++ callerStack) returns tokens =
      some (returnValues ++ callerTarget) := by
  exact materializeStack_append_visible (visible := callerStack)
    (pref := returnValues) hCaller

theorem stateRel_initial_eraseControl {source : RunState} {target : EVMState}
    (hRel : StateRel source target [])
    (hReturns : source.returns = []) :
    eraseControl source.evm = eraseControl target := by
  rcases source with ⟨evm, returns⟩
  simp at hReturns
  subst returns
  cases hRel with
  | mk hStack hData =>
      simp [materializeStack] at hStack
      rw [← hStack] at hData
      exact hData.symm

namespace StateRel

theorem callEntry {source : RunState} {target : EVMState}
    {tokens : List Word} {args callerStack callerTarget : EvmYul.Stack Word}
    {retc : Nat} {token : Word}
    (hRel : StateRel source target tokens)
    (hCaller :
      materializeStack callerStack source.returns tokens = some callerTarget) :
    StateRel
      ((source.withEVM { source.evm with stack := args }).pushReturn
        callerStack retc)
      { target with stack := args ++ [token] ++ callerTarget }
      (token :: tokens) := by
  refine ⟨?_, ?_⟩
  · simp [RunState.pushReturn, RunState.withEVM, materializeStack, hCaller]
  · simpa using hRel.dataRel_replace_stack (args ++ [token] ++ callerTarget)

theorem caller_materialization_of_split {source : RunState} {target : EVMState}
    {tokens : List Word} {argc : Nat} {args callerStack : EvmYul.Stack Word}
    (hRel : StateRel source target tokens)
    (hSplit :
      StackFrame.splitArgs? argc source.evm.stack =
        some (args, callerStack)) :
    ∃ callerTarget,
      materializeStack callerStack source.returns tokens = some callerTarget ∧
        target.stack = args ++ callerTarget := by
  have hSplitEq := StackFrameFacts.splitArgs?_append hSplit
  have hStack :
      materializeStack (args ++ callerStack) source.returns tokens =
        some target.stack := by
    rw [hSplitEq]
    exact hRel.stackRel
  rcases materializeStack_of_append_visible hStack with
    ⟨callerTarget, hCaller, hTarget⟩
  exact ⟨callerTarget, hCaller, hTarget⟩

theorem callEntry_after_prologue {source : RunState} {target : EVMState}
    {tokens : List Word} {argc retc : Nat}
    {args callerStack : EvmYul.Stack Word} {token : Word}
    (hRel : StateRel source target tokens)
    (hSplit :
      StackFrame.splitArgs? argc source.evm.stack =
        some (args, callerStack))
    (hArgBound : args.length ≤ 16) :
    ∃ final,
      Assembly.Target.runList
          (StackShuffle.targetProgram ([Assembly.Instr.push token] ++
            StackShuffle.sinkTopUnder args.length)) target = .ok final ∧
      StateRel
        ((source.withEVM { source.evm with stack := args }).pushReturn
          callerStack retc)
        final (token :: tokens) := by
  rcases caller_materialization_of_split hRel hSplit with
    ⟨callerTarget, hCaller, hTargetStack⟩
  have hTargetRecord : { target with stack := args ++ callerTarget } = target := by
    rw [← hTargetStack]
  rcases StackShuffle.callPrologue_target_exists (state := target) (args := args)
      (suffix := callerTarget) (token := token) hArgBound with
    ⟨final, hRun, hFinalStack, hFinalErase⟩
  refine ⟨final, ?_, ?_⟩
  · rw [← hTargetRecord]
    exact hRun
  · refine ⟨?_, ?_⟩
    · rw [hFinalStack]
      simpa [RunState.withEVM, RunState.pushReturn, List.append_assoc] using
        (materializeStack_callEntry (args := args) (callerStack := callerStack)
          (callerTarget := callerTarget) (returns := source.returns)
          (tokens := tokens) (retc := retc) (token := token) hCaller)
    · calc
        eraseControl final
            = eraseControl { target with stack := args ++ token :: callerTarget } := by
                simpa [List.append_assoc] using hFinalErase
        _ = eraseControl { source.evm with stack := args ++ token :: callerTarget } := by
                exact hRel.dataRel_replace_stack (args ++ token :: callerTarget)
        _ = eraseControl
              { ((source.withEVM { source.evm with stack := args }).pushReturn
                    callerStack retc).evm with stack := final.stack } := by
                simp [RunState.withEVM, RunState.pushReturn, hFinalStack]

theorem source_callEntry_after_prologue {source : RunState} {target : EVMState}
    {tokens : List Word} {argc retc : Nat}
    {args callerStack : EvmYul.Stack Word} {token : Word}
    {pre post : Assembly.Program}
    (hFits :
      AssemblyProgram.PCFitsFrom pre
        ([Assembly.Instr.push token] ++
          StackShuffle.sinkTopUnder args.length))
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : StateRel source target tokens)
    (hSplit :
      StackFrame.splitArgs? argc source.evm.stack =
        some (args, callerStack))
    (hArgBound : args.length ≤ 16) :
    ARunResult
      (pre ++
        ([Assembly.Instr.push token] ++
          StackShuffle.sinkTopUnder args.length) ++
        post)
      target
      (fun result =>
        match result with
        | .running final =>
            StateRel
              ((source.withEVM { source.evm with stack := args }).pushReturn
                callerStack retc)
              final (token :: tokens) ∧
              final.pc =
                Assembly.Program.pcAfter
                  (pre ++
                    ([Assembly.Instr.push token] ++
                      StackShuffle.sinkTopUnder args.length))
        | .halted _ => False) := by
  rcases caller_materialization_of_split hRel hSplit with
    ⟨callerTarget, hCaller, hTargetStack⟩
  have hTargetRecord : { target with stack := args ++ callerTarget } = target := by
    rw [← hTargetStack]
  have hRun :=
    StackShuffle.callPrologue_source_exists
      (state := target) (args := args) (suffix := callerTarget)
      (token := token) (pre := pre) (post := post)
      hFits (by simpa using hPc) hArgBound
  exact ARunResult.mono
    (by simpa [hTargetRecord] using hRun)
    (by
      intro result hResult
      cases result with
      | halted halt =>
          cases hResult
      | running final =>
          rcases hResult with ⟨hFinalStack, hFinalErase, hFinalPc⟩
          refine ⟨?_, hFinalPc⟩
          refine ⟨?_, ?_⟩
          · rw [hFinalStack]
            simpa [RunState.withEVM, RunState.pushReturn, List.append_assoc]
              using
                (materializeStack_callEntry (args := args)
                  (callerStack := callerStack) (callerTarget := callerTarget)
                  (returns := source.returns) (tokens := tokens)
                  (retc := retc) (token := token) hCaller)
          · calc
              eraseControl final
                  =
                eraseControl { target with stack := args ++ token :: callerTarget } :=
                    hFinalErase
              _ =
                eraseControl
                  { source.evm with stack := args ++ token :: callerTarget } :=
                    hRel.dataRel_replace_stack (args ++ token :: callerTarget)
              _ =
                eraseControl
                  { ((source.withEVM { source.evm with stack := args }).pushReturn
                        callerStack retc).evm with
                    stack := final.stack } := by
                    simp [RunState.withEVM, RunState.pushReturn, hFinalStack])

theorem caller_materialization_of_top_return {callee : RunState}
    {target : EVMState} {tokens : List Word} {token : Word}
    {frame : ReturnDest} {returns : List ReturnDest}
    (hRel : StateRel callee target (token :: tokens))
    (hReturns : callee.returns = frame :: returns) :
    ∃ callerTarget,
      materializeStack frame.callerStack returns tokens = some callerTarget ∧
        target.stack = callee.evm.stack ++ token :: callerTarget := by
  have hStack := hRel.stackRel
  rw [hReturns] at hStack
  cases hCaller :
      materializeStack frame.callerStack returns tokens with
  | none =>
      simp [materializeStack, hCaller] at hStack
  | some callerTarget =>
      simp [materializeStack, hCaller] at hStack
      exact ⟨callerTarget, rfl, hStack.symm⟩

theorem returnAttach_after_remove {callee : RunState} {target : EVMState}
    {tokens : List Word} {token : Word} {frame : ReturnDest}
    {returns : List ReturnDest}
    (hRel : StateRel callee target (token :: tokens))
    (hReturns : callee.returns = frame :: returns)
    (hBound : callee.evm.stack.length ≤ 16) :
    ∃ final,
      Assembly.Target.runList
          (StackShuffle.targetProgram
            (StackShuffle.removeBuriedUnder callee.evm.stack.length))
          target = .ok final ∧
      StateRel
        { callee with
          evm :=
            { callee.evm with
              stack := callee.evm.stack ++ frame.callerStack }
          returns := returns }
        final tokens := by
  rcases caller_materialization_of_top_return hRel hReturns with
    ⟨callerTarget, hCaller, hTargetStack⟩
  have hTargetRecord :
      { target with stack := callee.evm.stack ++ token :: callerTarget } =
        target := by
    rw [← hTargetStack]
  rcases StackShuffle.removeBuriedUnder_target_exists (state := target)
      (returnValues := callee.evm.stack) (suffix := callerTarget)
      (token := token) hBound with
    ⟨final, hRun, hFinalStack, hFinalErase⟩
  refine ⟨final, ?_, ?_⟩
  · rw [← hTargetRecord]
    exact hRun
  · refine ⟨?_, ?_⟩
    · rw [hFinalStack]
      exact materializeStack_returnAttach hCaller
    · have hEraseTarget :
          eraseControl final =
            eraseControl
              { target with stack := callee.evm.stack ++ callerTarget } :=
        hFinalErase
      have hEraseSource :
          eraseControl
              { target with stack := callee.evm.stack ++ callerTarget } =
            eraseControl
              { callee.evm with stack := callee.evm.stack ++ callerTarget } :=
        hRel.dataRel_replace_stack
          (callee.evm.stack ++ callerTarget)
      have hEraseFinalSource :
          eraseControl
              { callee.evm with stack := callee.evm.stack ++ callerTarget } =
            eraseControl
              { { callee with
                    evm :=
                      { callee.evm with
                        stack := callee.evm.stack ++ frame.callerStack }
                    returns := returns }.evm with
                  stack := final.stack } := by
                simp [hFinalStack]
      exact hEraseTarget.trans (hEraseSource.trans hEraseFinalSource)

theorem source_returnAttach_after_remove {callee : RunState} {target : EVMState}
    {tokens : List Word} {token : Word} {frame : ReturnDest}
    {returns : List ReturnDest} {pre post : Assembly.Program}
    (hFits :
      AssemblyProgram.PCFitsFrom pre
        (StackShuffle.removeBuriedUnder callee.evm.stack.length))
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : StateRel callee target (token :: tokens))
    (hReturns : callee.returns = frame :: returns)
    (hBound : callee.evm.stack.length ≤ 16) :
    ARunResult
      (pre ++ StackShuffle.removeBuriedUnder callee.evm.stack.length ++ post)
      target
      (fun result =>
        match result with
        | .running final =>
            StateRel
              { callee with
                evm :=
                  { callee.evm with
                    stack := callee.evm.stack ++ frame.callerStack }
                returns := returns }
              final tokens ∧
              final.pc =
                Assembly.Program.pcAfter
                  (pre ++
                    StackShuffle.removeBuriedUnder callee.evm.stack.length)
        | .halted _ => False) := by
  rcases caller_materialization_of_top_return hRel hReturns with
    ⟨callerTarget, hCaller, hTargetStack⟩
  have hTargetRecord :
      { target with stack := callee.evm.stack ++ token :: callerTarget } =
        target := by
    rw [← hTargetStack]
  have hRun :=
    StackShuffle.removeBuriedUnder_source_exists
      (state := target) (returnValues := callee.evm.stack)
      (suffix := callerTarget) (token := token) (pre := pre) (post := post)
      hFits (by simpa using hPc) hBound
  exact ARunResult.mono
    (by simpa [hTargetRecord] using hRun)
    (by
      intro result hResult
      cases result with
      | halted halt =>
          cases hResult
      | running final =>
          rcases hResult with ⟨hFinalStack, hFinalErase, hFinalPc⟩
          refine ⟨?_, hFinalPc⟩
          refine ⟨?_, ?_⟩
          · rw [hFinalStack]
            exact materializeStack_returnAttach hCaller
          · have hEraseTarget :
                eraseControl final =
                  eraseControl
                    { target with stack := callee.evm.stack ++ callerTarget } :=
              hFinalErase
            have hEraseSource :
                eraseControl
                    { target with stack := callee.evm.stack ++ callerTarget } =
                  eraseControl
                    { callee.evm with stack := callee.evm.stack ++ callerTarget } :=
              hRel.dataRel_replace_stack
                (callee.evm.stack ++ callerTarget)
            have hEraseFinalSource :
                eraseControl
                    { callee.evm with stack := callee.evm.stack ++ callerTarget } =
                  eraseControl
                    { { callee with
                          evm :=
                            { callee.evm with
                              stack := callee.evm.stack ++ frame.callerStack }
                          returns := returns }.evm with
                      stack := final.stack } := by
              simp [hFinalStack]
            exact hEraseTarget.trans (hEraseSource.trans hEraseFinalSource))

theorem returnAttach {callee : RunState} {target : EVMState}
    {tokens : List Word} {frame : ReturnDest} {returns : List ReturnDest}
    {callerTarget : EvmYul.Stack Word} {token : Word}
    (hRel : StateRel callee target (token :: tokens))
    (hCaller :
      materializeStack frame.callerStack returns tokens = some callerTarget) :
    StateRel
      { callee with
        evm := { callee.evm with stack := callee.evm.stack ++ frame.callerStack }
        returns := returns }
      { target with stack := callee.evm.stack ++ callerTarget }
      tokens := by
  refine ⟨?_, ?_⟩
  · exact materializeStack_returnAttach hCaller
  · simpa using hRel.dataRel_replace_stack (callee.evm.stack ++ callerTarget)

theorem label_stepResult_at {label : Assembly.Label}
    {pre post : Assembly.Program} {source : RunState} {target : EVMState}
    {tokens : List Word}
    (hFit : PCFits pre)
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : StateRel source target tokens) :
    ∃ target',
      Assembly.Source.stepResult
          (pre ++ [Assembly.Instr.label label] ++ post) target =
        .ok (.running target') ∧
        StateRel source target' tokens ∧
        target'.pc =
          Assembly.Program.pcAfter (pre ++ [Assembly.Instr.label label]) := by
  let target' := target.incrPC
  have hAt :
      Assembly.Program.instrAtPc
          (pre ++ [Assembly.Instr.label label] ++ post) target.pc.toNat =
        some (Assembly.Program.byteLength pre, Assembly.Instr.label label) := by
    unfold Assembly.Program.instrAtPc
    rw [hPc, hFit]
    simpa using
      Assembly.Program.instrAtPcFrom_append_boundary_cons
        pre post (Assembly.Instr.label label) 0
  have hStep :
      Assembly.Source.step
          (pre ++ [Assembly.Instr.label label] ++ post) target =
        .ok target' := by
    unfold Assembly.Source.step
    rw [hAt]
    rfl
  refine ⟨target', ?_, ?_, ?_⟩
  · exact
      AssemblySource.stepResult_running_of_step_no_halt
        hAt hStep rfl
  · refine ⟨?_, ?_⟩
    · simpa [target', EvmYul.EVM.State.incrPC] using hRel.stackRel
    · simpa [target', EvmYul.EVM.State.incrPC, eraseControl,
        Assembly.eraseGas] using hRel.dataRel
  · calc
      target'.pc
          = target.pc + EvmYul.UInt256.ofNat 1 := rfl
      _ = Assembly.Program.pcAfter pre + EvmYul.UInt256.ofNat 1 := by
            rw [hPc]
      _ = EvmYul.UInt256.ofNat (Assembly.Program.byteLength pre) +
            EvmYul.UInt256.ofNat 1 := by
            rfl
      _ = EvmYul.UInt256.ofNat (Assembly.Program.byteLength pre + 1) := by
            rw [Assembly.UInt256_ofNat_add]
      _ = Assembly.Program.pcAfter (pre ++ [Assembly.Instr.label label]) := by
            simp [Assembly.Program.pcAfter, Assembly.Program.byteLength_append,
              Assembly.Program.byteLength, Assembly.Instr.byteSize]

theorem jump_stepResult_at {label : Assembly.Label} {dest : Nat}
    {pre post : Assembly.Program} {source : RunState} {target : EVMState}
    {tokens : List Word}
    (hFit : PCFits pre)
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : StateRel source target tokens)
    (hLabel :
      Assembly.Program.labelPc (pre ++ [Assembly.Instr.jump label] ++ post)
        label = some dest) :
    ∃ target',
      Assembly.Source.stepResult (pre ++ [Assembly.Instr.jump label] ++ post)
          target = .ok (.running target') ∧
        StateRel source target' tokens ∧
        target'.pc = EvmYul.UInt256.ofNat dest := by
  let target' := Assembly.Source.jumpPc dest target
  have hAt :
      Assembly.Program.instrAtPc
          (pre ++ [Assembly.Instr.jump label] ++ post) target.pc.toNat =
        some (Assembly.Program.byteLength pre, Assembly.Instr.jump label) := by
    unfold Assembly.Program.instrAtPc
    rw [hPc, hFit]
    simpa using
      Assembly.Program.instrAtPcFrom_append_boundary_cons
        pre post (Assembly.Instr.jump label) 0
  have hStep :
      Assembly.Source.step
          (pre ++ [Assembly.Instr.jump label] ++ post) target =
        .ok target' := by
    unfold Assembly.Source.step
    rw [hAt]
    unfold Assembly.Source.stepAt
    have hLabel' :
        Assembly.Program.labelPc (pre ++ Assembly.Instr.jump label :: post)
          label = some dest := by
      simpa using hLabel
    simp [hLabel', Assembly.Source.invalid, Bind.bind, Except.bind]
    change Except.ok (Assembly.Source.jumpPc dest target) = Except.ok target'
    rfl
  refine ⟨target', ?_, ?_, rfl⟩
  · exact
      AssemblySource.stepResult_running_of_step_no_halt
        hAt hStep rfl
  · refine ⟨?_, ?_⟩
    · simpa [target', Assembly.Source.jumpPc] using hRel.stackRel
    · simpa [target', Assembly.Source.jumpPc, eraseControl_with_pc] using
        hRel.dataRel

theorem source_callEntry_after_prologue_and_jump
    {source : RunState} {target : EVMState}
    {tokens : List Word} {argc retc : Nat}
    {args callerStack : EvmYul.Stack Word} {token : Word}
    {entryLabel : Assembly.Label} {entryDest : Nat}
    {pre post : Assembly.Program}
    (hFits :
      AssemblyProgram.PCFitsFrom pre
        (([Assembly.Instr.push token] ++
          StackShuffle.sinkTopUnder args.length) ++
          [Assembly.Instr.jump entryLabel]))
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : StateRel source target tokens)
    (hSplit :
      StackFrame.splitArgs? argc source.evm.stack =
        some (args, callerStack))
    (hArgBound : args.length ≤ 16)
    (hEntryLabel :
      Assembly.Program.labelPc
        (pre ++
          (([Assembly.Instr.push token] ++
            StackShuffle.sinkTopUnder args.length) ++
            [Assembly.Instr.jump entryLabel]) ++
          post)
        entryLabel = some entryDest) :
    ARunResult
      (pre ++
        (([Assembly.Instr.push token] ++
          StackShuffle.sinkTopUnder args.length) ++
          [Assembly.Instr.jump entryLabel]) ++
        post)
      target
      (fun result =>
        match result with
        | .running final =>
            StateRel
              ((source.withEVM { source.evm with stack := args }).pushReturn
                callerStack retc)
              final (token :: tokens) ∧
              final.pc = EvmYul.UInt256.ofNat entryDest
        | .halted _ => False) := by
  let prologue : Assembly.Program :=
    [Assembly.Instr.push token] ++ StackShuffle.sinkTopUnder args.length
  let callState : RunState :=
    (source.withEVM { source.evm with stack := args }).pushReturn
      callerStack retc
  have hFitsPrologue :
      AssemblyProgram.PCFitsFrom pre prologue := by
    exact
      AssemblyProgram.PCFitsFrom.left
        (pre := pre) (first := prologue)
        (second := [Assembly.Instr.jump entryLabel])
        (by simpa [prologue, List.append_assoc] using hFits)
  have hFitsJump :
      AssemblyProgram.PCFitsFrom (pre ++ prologue)
        [Assembly.Instr.jump entryLabel] := by
    exact
      AssemblyProgram.PCFitsFrom.right
        (pre := pre) (first := prologue)
        (second := [Assembly.Instr.jump entryLabel])
        (by simpa [prologue, List.append_assoc] using hFits)
  have hPrologueRun :=
    source_callEntry_after_prologue
      (source := source) (target := target) (tokens := tokens)
      (argc := argc) (retc := retc) (args := args)
      (callerStack := callerStack) (token := token)
      (pre := pre) (post := [Assembly.Instr.jump entryLabel] ++ post)
      (by simpa [prologue] using hFitsPrologue)
      hPc hRel hSplit hArgBound
  refine
    ARunResult.bind_running
      (program :=
        pre ++
          (([Assembly.Instr.push token] ++
            StackShuffle.sinkTopUnder args.length) ++
            [Assembly.Instr.jump entryLabel]) ++
          post)
      (middle := fun afterPrologue =>
        StateRel callState afterPrologue (token :: tokens) ∧
          afterPrologue.pc = Assembly.Program.pcAfter (pre ++ prologue))
      ?_ ?_
  · exact
      ARunResult.mono
        (by
          simpa [prologue, callState, List.append_assoc] using hPrologueRun)
        (by
          intro result hResult
          cases result with
          | halted halt =>
              cases hResult
          | running afterPrologue =>
              simpa [prologue, callState] using hResult)
  · intro afterPrologue hAfterPrologue
    have hJumpLabel :
        Assembly.Program.labelPc
          ((pre ++ prologue) ++ [Assembly.Instr.jump entryLabel] ++ post)
          entryLabel = some entryDest := by
      simpa [prologue, List.append_assoc] using hEntryLabel
    rcases jump_stepResult_at
        (label := entryLabel) (dest := entryDest)
        (pre := pre ++ prologue) (post := post)
        (source := callState) (target := afterPrologue)
        (tokens := token :: tokens)
        (AssemblyProgram.PCFitsFrom.start hFitsJump)
        hAfterPrologue.2 hAfterPrologue.1 hJumpLabel with
      ⟨afterJump, hJump, hRelAfterJump, hPcAfterJump⟩
    refine ⟨1, .running afterJump, ?_, ?_⟩
    · change
        Assembly.Source.runNResult
            (pre ++
              (([Assembly.Instr.push token] ++
                StackShuffle.sinkTopUnder args.length) ++
                [Assembly.Instr.jump entryLabel]) ++
              post)
            1 afterPrologue =
          .ok (.running afterJump)
      unfold Assembly.Source.runNResult
      rw [show
          pre ++
              (([Assembly.Instr.push token] ++
                StackShuffle.sinkTopUnder args.length) ++
                [Assembly.Instr.jump entryLabel]) ++
              post =
            (pre ++ prologue) ++ [Assembly.Instr.jump entryLabel] ++ post by
          simp [prologue, List.append_assoc]]
      rw [hJump]
      rfl
    · exact ⟨hRelAfterJump, hPcAfterJump⟩

theorem label_runResult_at {label : Assembly.Label}
    {pre post : Assembly.Program} {source : RunState} {target : EVMState}
    {tokens : List Word}
    (hFit : PCFits pre)
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : StateRel source target tokens) :
    ARunResult (pre ++ [Assembly.Instr.label label] ++ post) target
      (fun result =>
        match result with
        | .running target' =>
            StateRel source target' tokens ∧
              target'.pc =
                Assembly.Program.pcAfter (pre ++ [Assembly.Instr.label label])
        | .halted _ => False) := by
  rcases label_stepResult_at (label := label) (pre := pre) (post := post)
      hFit hPc hRel with
    ⟨target', hStep, hRel', hPc'⟩
  refine ⟨1, .running target', ?_, ?_⟩
  · unfold Assembly.Source.runNResult
    rw [hStep]
    rfl
  · exact ⟨hRel', hPc'⟩

theorem dispatch_case_runResult_at {caseLabel returnLabel : Assembly.Label}
    {dest : Nat} {pre post : Assembly.Program}
    {callee : RunState} {target : EVMState}
    {tokens : List Word} {token : Word} {frame : ReturnDest}
    {returns : List ReturnDest}
    (hFits :
      AssemblyProgram.PCFitsFrom pre
        ([Assembly.Instr.label caseLabel] ++
          StackShuffle.removeBuriedUnder callee.evm.stack.length ++
          [Assembly.Instr.jump returnLabel]))
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : StateRel callee target (token :: tokens))
    (hReturns : callee.returns = frame :: returns)
    (hBound : callee.evm.stack.length ≤ 16)
    (hReturnLabel :
      Assembly.Program.labelPc
        (pre ++ [Assembly.Instr.label caseLabel] ++
          StackShuffle.removeBuriedUnder callee.evm.stack.length ++
          [Assembly.Instr.jump returnLabel] ++ post)
        returnLabel = some dest) :
    ARunResult
      (pre ++ [Assembly.Instr.label caseLabel] ++
        StackShuffle.removeBuriedUnder callee.evm.stack.length ++
        [Assembly.Instr.jump returnLabel] ++ post)
      target
      (fun result =>
        match result with
        | .running final =>
            StateRel
              { callee with
                evm :=
                  { callee.evm with
                    stack := callee.evm.stack ++ frame.callerStack }
                returns := returns }
              final tokens ∧
              final.pc = EvmYul.UInt256.ofNat dest
        | .halted _ => False) := by
  let removeCode := StackShuffle.removeBuriedUnder callee.evm.stack.length
  let returned : RunState :=
    { callee with
      evm :=
        { callee.evm with stack := callee.evm.stack ++ frame.callerStack }
      returns := returns }
  have hFitsAfterLabel :
      AssemblyProgram.PCFitsFrom (pre ++ [Assembly.Instr.label caseLabel])
        (removeCode ++ [Assembly.Instr.jump returnLabel]) := by
    exact
      AssemblyProgram.PCFitsFrom.right
        (pre := pre) (first := [Assembly.Instr.label caseLabel])
        (second := removeCode ++ [Assembly.Instr.jump returnLabel])
        (by simpa [removeCode, List.append_assoc] using hFits)
  have hFitsRemove :
      AssemblyProgram.PCFitsFrom (pre ++ [Assembly.Instr.label caseLabel])
        removeCode := by
    exact
      AssemblyProgram.PCFitsFrom.left
        (pre := pre ++ [Assembly.Instr.label caseLabel])
        (first := removeCode) (second := [Assembly.Instr.jump returnLabel])
        hFitsAfterLabel
  have hFitsAfterRemove :
      AssemblyProgram.PCFitsFrom
        (pre ++ [Assembly.Instr.label caseLabel] ++ removeCode)
        [Assembly.Instr.jump returnLabel] := by
    exact
      AssemblyProgram.PCFitsFrom.right
        (pre := pre ++ [Assembly.Instr.label caseLabel])
        (first := removeCode) (second := [Assembly.Instr.jump returnLabel])
        hFitsAfterLabel
  have hLabelRun :=
    label_runResult_at (label := caseLabel) (pre := pre)
      (post := removeCode ++ [Assembly.Instr.jump returnLabel] ++ post)
      (source := callee) (target := target) (tokens := token :: tokens)
      (AssemblyProgram.PCFitsFrom.start hFits) hPc hRel
  refine
    ARunResult.bind_running
      (program :=
        pre ++ [Assembly.Instr.label caseLabel] ++
          StackShuffle.removeBuriedUnder callee.evm.stack.length ++
          [Assembly.Instr.jump returnLabel] ++ post)
      (middle := fun afterLabel =>
        StateRel callee afterLabel (token :: tokens) ∧
          afterLabel.pc =
            Assembly.Program.pcAfter
              (pre ++ [Assembly.Instr.label caseLabel]))
      ?_ ?_
  · simpa [removeCode, List.append_assoc] using hLabelRun
  · intro afterLabel hAfterLabel
    have hRemoveRun :=
      source_returnAttach_after_remove
        (callee := callee) (target := afterLabel) (tokens := tokens)
        (token := token) (frame := frame) (returns := returns)
        (pre := pre ++ [Assembly.Instr.label caseLabel])
        (post := [Assembly.Instr.jump returnLabel] ++ post)
        (by simpa [removeCode] using hFitsRemove)
        hAfterLabel.2 hAfterLabel.1 hReturns hBound
    refine
      ARunResult.bind_running
        (program :=
          pre ++ [Assembly.Instr.label caseLabel] ++
            StackShuffle.removeBuriedUnder callee.evm.stack.length ++
            [Assembly.Instr.jump returnLabel] ++ post)
        (middle := fun afterRemove =>
          StateRel returned afterRemove tokens ∧
            afterRemove.pc =
              Assembly.Program.pcAfter
                ((pre ++ [Assembly.Instr.label caseLabel]) ++ removeCode))
        ?_ ?_
    · exact
        ARunResult.mono
          (by
            simpa [returned, removeCode, List.append_assoc] using hRemoveRun)
          (by
            intro result hResult
            cases result with
            | halted halt =>
                cases hResult
            | running afterRemove =>
                rcases hResult with ⟨hRelReturned, hPcAfterRemove⟩
                exact ⟨hRelReturned, by simpa [removeCode] using hPcAfterRemove⟩)
    · intro afterRemove hAfterRemove
      have hLabelJump :
          Assembly.Program.labelPc
            ((pre ++ [Assembly.Instr.label caseLabel] ++ removeCode) ++
              [Assembly.Instr.jump returnLabel] ++ post)
            returnLabel = some dest := by
        simpa [removeCode, List.append_assoc] using hReturnLabel
      rcases jump_stepResult_at (label := returnLabel) (dest := dest)
          (pre := pre ++ [Assembly.Instr.label caseLabel] ++ removeCode)
          (post := post) (source := returned) (target := afterRemove)
          (tokens := tokens)
          (AssemblyProgram.PCFitsFrom.start hFitsAfterRemove)
          hAfterRemove.2 hAfterRemove.1 hLabelJump with
        ⟨final, hJump, hRelFinal, hPcFinal⟩
      refine ⟨1, .running final, ?_, ?_⟩
      · unfold Assembly.Source.runNResult
        rw [show
          pre ++ [Assembly.Instr.label caseLabel] ++
              StackShuffle.removeBuriedUnder callee.evm.stack.length ++
              [Assembly.Instr.jump returnLabel] ++ post =
            (pre ++ [Assembly.Instr.label caseLabel] ++ removeCode) ++
              [Assembly.Instr.jump returnLabel] ++ post by
          simp [removeCode, List.append_assoc]]
        rw [hJump]
        rfl
      · exact ⟨hRelFinal, hPcFinal⟩

theorem jump_then_label_runResult_at {label : Assembly.Label}
    {pre between post : Assembly.Program} {source : RunState}
    {target : EVMState} {tokens : List Word}
    (hFitJump : PCFits pre)
    (hFitLabel : PCFits (pre ++ [Assembly.Instr.jump label] ++ between))
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : StateRel source target tokens)
    (hLabel :
      Assembly.Program.labelPc
          (pre ++ [Assembly.Instr.jump label] ++ between ++
            [Assembly.Instr.label label] ++ post) label =
        some
          (Assembly.Program.byteLength
            (pre ++ [Assembly.Instr.jump label] ++ between))) :
    ARunResult
      (pre ++ [Assembly.Instr.jump label] ++ between ++
        [Assembly.Instr.label label] ++ post)
      target
      (fun result =>
        match result with
        | .running target' =>
            StateRel source target' tokens ∧
              target'.pc =
                Assembly.Program.pcAfter
                  (pre ++ [Assembly.Instr.jump label] ++ between ++
                    [Assembly.Instr.label label])
        | .halted _ => False) := by
  let labelPre := pre ++ [Assembly.Instr.jump label] ++ between
  have hJumpLabel :
      Assembly.Program.labelPc
          (pre ++ [Assembly.Instr.jump label] ++
            (between ++ [Assembly.Instr.label label] ++ post)) label =
        some (Assembly.Program.byteLength labelPre) := by
    simpa [labelPre, List.append_assoc] using hLabel
  rcases jump_stepResult_at (label := label)
      (dest := Assembly.Program.byteLength labelPre)
      (pre := pre) (post := between ++ [Assembly.Instr.label label] ++ post)
      hFitJump hPc hRel hJumpLabel with
    ⟨targetAfterJump, hJump, hRelAfterJump, hPcAfterJump⟩
  refine
    ARunResult.bind_running
      (program := pre ++ [Assembly.Instr.jump label] ++ between ++
        [Assembly.Instr.label label] ++ post)
      (middle := fun targetAfterJump =>
        StateRel source targetAfterJump tokens ∧
          targetAfterJump.pc = Assembly.Program.pcAfter labelPre)
      ?_ ?_
  · refine ⟨1, .running targetAfterJump, ?_, ?_⟩
    · change
        Assembly.Source.runNResult
            (pre ++ [Assembly.Instr.jump label] ++ between ++
              [Assembly.Instr.label label] ++ post)
            1 target =
          .ok (.running targetAfterJump)
      rw [show
          pre ++ [Assembly.Instr.jump label] ++ between ++
              [Assembly.Instr.label label] ++ post =
            pre ++ [Assembly.Instr.jump label] ++
              (between ++ [Assembly.Instr.label label] ++ post) by
          simp [List.append_assoc]]
      unfold Assembly.Source.runNResult
      rw [hJump]
      rfl
    · exact ⟨hRelAfterJump, hPcAfterJump⟩
  · intro targetAfterJump hMiddle
    have hLabelRun :=
      label_runResult_at (label := label) (pre := labelPre) (post := post)
        hFitLabel hMiddle.2 hMiddle.1
    simpa [labelPre, List.append_assoc] using hLabelRun

end StateRel

end Frame

namespace Terminal

/--
Terminal-op frame safety, stated as the local obligation needed by structured
preservation.

The source step runs on the visible structured stack. The target step runs on
the materialized EVM stack containing hidden return tokens. This local
predicate is the terminal-op part of the `ProgramLayout` preservation boundary:
terminal opcodes are allowed only when their EVM effect is insensitive to the
hidden return-token material.
-/
def RelSafe (kind : Assembly.HaltKind) : Prop :=
  ∀ {source : RunState} {sourceFinal target : EVMState}
    {tokens : List Word},
    Frame.StateRel source target tokens →
      Terminal.step kind source.evm = .ok sourceFinal →
        ∃ targetFinal,
          Terminal.step kind target = .ok targetFinal ∧
            Frame.StateRel (source.withEVM sourceFinal) targetFinal tokens

end Terminal

namespace Assembly.HaltKind

theorem toPrimOp_haltKind? (kind : Assembly.HaltKind) :
    kind.toPrimOp.haltKind? = some kind := by
  cases kind <;> rfl

end Assembly.HaltKind

namespace Frame
namespace StateRel

theorem pop_stepResult_at {pre post : Assembly.Program}
    {source : RunState} {target : EVMState} {tokens : List Word}
    {stack : EvmYul.Stack Word} {value : Word}
    (hFit : PCFits pre)
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : StateRel source target tokens)
    (hPop : source.evm.stack.pop = some (stack, value)) :
    ∃ targetFinal,
      Assembly.Source.stepResult
          (pre ++ [Assembly.Instr.prim .pop] ++ post) target =
        .ok (.running targetFinal) ∧
        StateRel
          (source.withEVM { source.evm with stack := stack })
          targetFinal tokens ∧
        targetFinal.pc =
          Assembly.Program.pcAfter (pre ++ [Assembly.Instr.prim .pop]) := by
  rcases hRel.pop_visible hPop with
    ⟨suffix, hTargetStack, hTargetPop, hRelAfterPopStack⟩
  let targetFinal : EVMState :=
    target.replaceStackAndIncrPC (stack ++ suffix)
  refine ⟨targetFinal, ?_, ?_, ?_⟩
  · unfold Assembly.Source.stepResult
    have hAt :
        Assembly.Program.instrAtPc
            (pre ++ [Assembly.Instr.prim .pop] ++ post)
            target.pc.toNat =
          some (Assembly.Program.byteLength pre, Assembly.Instr.prim .pop) := by
      unfold Assembly.Program.instrAtPc
      rw [hPc, hFit]
      simpa using
        Assembly.Program.instrAtPcFrom_append_boundary_cons
          pre post (Assembly.Instr.prim .pop) 0
    rw [hAt]
    unfold Assembly.Source.stepAtResult
    unfold Assembly.Source.stepAt
    change
      (do
        let state' ← Assembly.Target.stepInstr (.prim .pop) target
        match (Assembly.Instr.prim .pop).haltKind? with
        | some kind =>
            Except.ok
              (Assembly.StepResult.halted
                { kind := kind
                  state := state'
                  output := kind.output state' })
        | none =>
            Except.ok (Assembly.StepResult.running state')) =
        Except.ok (Assembly.StepResult.running targetFinal)
    have hTargetStep :
        Assembly.Target.stepInstr (.prim .pop) target = .ok targetFinal := by
      unfold Assembly.Target.stepInstr Assembly.PrimOp.step
      simp [Assembly.PrimOp.continuingStep?, Assembly.PrimStep.run,
        hTargetPop, targetFinal]
    rw [hTargetStep]
    rfl
  · refine ⟨?_, ?_⟩
    · simpa [targetFinal, EvmYul.EVM.State.replaceStackAndIncrPC,
        EvmYul.EVM.State.incrPC] using hRelAfterPopStack.stackRel
    · calc
        eraseControl targetFinal
            = eraseControl { target with stack := stack ++ suffix } := by
                simp [targetFinal, eraseControl, Assembly.eraseGas,
                  EvmYul.EVM.State.replaceStackAndIncrPC,
                  EvmYul.EVM.State.incrPC]
        _ =
            eraseControl
              { (source.withEVM { source.evm with stack := stack }).evm with
                stack := (stack ++ suffix) } := hRelAfterPopStack.dataRel
  · simp [targetFinal, EvmYul.EVM.State.replaceStackAndIncrPC,
      EvmYul.EVM.State.incrPC, hPc, Assembly.Program.pcAfter,
      Assembly.Program.byteLength_append, Assembly.Program.byteLength,
      Assembly.Instr.byteSize, Assembly.UInt256_ofNat_add]

theorem terminal_stepResult_at {kind : Assembly.HaltKind}
    {pre post : Assembly.Program} {source : RunState}
    {sourceFinal target : EVMState} {tokens : List Word}
    (hSafe : Terminal.RelSafe kind)
    (hFit : PCFits pre)
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : StateRel source target tokens)
    (hStep : Terminal.step kind source.evm = .ok sourceFinal) :
    ∃ targetFinal,
      Assembly.Source.stepResult
          (pre ++ [Assembly.Instr.prim kind.toPrimOp] ++ post) target =
        .ok (.halted
          { kind := kind
            state := targetFinal
            output := kind.output targetFinal }) ∧
        StateRel (source.withEVM sourceFinal) targetFinal tokens := by
  rcases hSafe hRel hStep with ⟨targetFinal, hTargetStep, hTargetRel⟩
  refine ⟨targetFinal, ?_, hTargetRel⟩
  unfold Assembly.Source.stepResult
  have hAt :
      Assembly.Program.instrAtPc
          (pre ++ [Assembly.Instr.prim kind.toPrimOp] ++ post)
          target.pc.toNat =
        some (Assembly.Program.byteLength pre,
          Assembly.Instr.prim kind.toPrimOp) := by
    unfold Assembly.Program.instrAtPc
    rw [hPc, hFit]
    simpa using
      Assembly.Program.instrAtPcFrom_append_boundary_cons
        pre post (Assembly.Instr.prim kind.toPrimOp) 0
  rw [hAt]
  unfold Assembly.Source.stepAtResult
  unfold Assembly.Source.stepAt
  change
    (do
      let state' ← Terminal.step kind target
      match (kind.toPrimOp).haltKind? with
      | some haltKind =>
          Except.ok
            (Assembly.StepResult.halted
              { kind := haltKind
                state := state'
                output := haltKind.output state' })
      | none =>
          Except.ok (Assembly.StepResult.running state')) =
      Except.ok
        (Assembly.StepResult.halted
          { kind := kind
            state := targetFinal
            output := kind.output targetFinal })
  rw [hTargetStep]
  simp [Assembly.HaltKind.toPrimOp_haltKind?, Bind.bind, Except.bind]

end StateRel
end Frame

/--
Target outcome relation for a compiled structured fragment.

`fallthroughPc` is the byte PC immediately after the compiled fragment. Abrupt
structured outcomes are represented by jumps to the labels in the current
compiler context; terminal EVM outcomes are represented by `runNResult`
halting with the matching `HaltKind`.
-/
def CompiledOutcomeRel (asm : Assembly.Program) (ctx : CompileContext)
    (fallthroughPc : Word) (source : Outcome)
    (target : Assembly.StepResult) (tokens : List Word) : Prop :=
  match source.mode, target with
  | .regular, .running targetState =>
      Frame.StateRel source.state targetState tokens ∧
        targetState.pc = fallthroughPc
  | .brk, .running targetState =>
      ∃ label dest,
        ctx.breakLabel? = some label ∧
          Assembly.Program.labelPc asm label = some dest ∧
          Frame.StateRel source.state targetState tokens ∧
          targetState.pc = EvmYul.UInt256.ofNat dest
  | .cont, .running targetState =>
      ∃ label dest,
        ctx.continueLabel? = some label ∧
          Assembly.Program.labelPc asm label = some dest ∧
          Frame.StateRel source.state targetState tokens ∧
          targetState.pc = EvmYul.UInt256.ofNat dest
  | .leave, .running targetState =>
      ∃ label dest,
        ctx.leaveLabel? = some label ∧
          Assembly.Program.labelPc asm label = some dest ∧
          Frame.StateRel source.state targetState tokens ∧
          targetState.pc = EvmYul.UInt256.ofNat dest
  | .halt sourceKind, .halted targetHalt =>
      sourceKind = targetHalt.kind ∧
        ∃ haltedTokens,
          Frame.StateRel source.state targetHalt.state haltedTokens
  | _, _ =>
      False

namespace CompiledOutcomeRel

theorem regular {asm : Assembly.Program} {ctx : CompileContext}
    {fallthroughPc : Word} {source : RunState} {target : EVMState}
    {tokens : List Word}
    (hRel : Frame.StateRel source target tokens)
    (hPc : target.pc = fallthroughPc) :
    CompiledOutcomeRel asm ctx fallthroughPc (Outcome.regular source)
      (.running target) tokens := by
  exact ⟨hRel, hPc⟩

theorem halt {asm : Assembly.Program} {ctx : CompileContext}
    {fallthroughPc : Word} {source : RunState} {target : EVMState}
    {tokens : List Word} {kind : Assembly.HaltKind}
    (hRel : Frame.StateRel source target tokens) :
    CompiledOutcomeRel asm ctx fallthroughPc (Outcome.halt kind source)
      (.halted { kind := kind, state := target, output := kind.output target })
      tokens := by
  exact ⟨rfl, tokens, hRel⟩

end CompiledOutcomeRel

structure ContextLabelsResolve (asm : Assembly.Program)
    (ctx : CompileContext) : Prop where
  brk :
    ∀ label, ctx.breakLabel? = some label →
      ∃ dest, Assembly.Program.labelPc asm label = some dest
  cont :
    ∀ label, ctx.continueLabel? = some label →
      ∃ dest, Assembly.Program.labelPc asm label = some dest
  leave :
    ∀ label, ctx.leaveLabel? = some label →
      ∃ dest, Assembly.Program.labelPc asm label = some dest

namespace ContextLabelsResolve

theorem cast_asm {oldAsm newAsm : Assembly.Program} {ctx : CompileContext}
    (hEq : oldAsm = newAsm)
    (hResolve : ContextLabelsResolve oldAsm ctx) :
    ContextLabelsResolve newAsm ctx := by
  cases hEq
  exact hResolve

theorem without_break_continue {asm : Assembly.Program}
    {ctx : CompileContext}
    (hResolve : ContextLabelsResolve asm ctx) :
    ContextLabelsResolve asm
      { ctx with breakLabel? := none, continueLabel? := none } := by
  refine ⟨?_, ?_, ?_⟩
  · intro label h
    cases h
  · intro label h
    cases h
  · intro label h
    exact hResolve.leave label h

theorem with_break_continue {asm : Assembly.Program}
    {ctx : CompileContext} {breakLabel continueLabel : Assembly.Label}
    (hResolve : ContextLabelsResolve asm ctx)
    (hBreak :
      ∃ dest, Assembly.Program.labelPc asm breakLabel = some dest)
    (hContinue :
      ∃ dest, Assembly.Program.labelPc asm continueLabel = some dest) :
    ContextLabelsResolve asm
      { ctx with
        breakLabel? := some breakLabel
        continueLabel? := some continueLabel } := by
  refine ⟨?_, ?_, ?_⟩
  · intro label h
    cases h
    exact hBreak
  · intro label h
    cases h
    exact hContinue
  · intro label h
    exact hResolve.leave label h

end ContextLabelsResolve

/--
Label-layout invariant used by structured-control preservation.

The compiler-generated branch labels have to resolve to their own concrete byte
positions in the final assembly program.  Keeping this as a reusable interface
lets each control-form proof use exact label locations without unfolding the
whole program or baking in special freshness cases.  The whole-program layer is
responsible for discharging this from generated-label freshness / label
uniqueness.
-/
structure ExactLabels (asm : Assembly.Program) : Prop where
  labelPc_at :
    ∀ (pre : Assembly.Program) (label : Assembly.Label)
      (post : Assembly.Program),
      asm = pre ++ [Assembly.Instr.label label] ++ post →
        Assembly.Program.labelPc asm label =
          some (Assembly.Program.byteLength pre)

namespace ExactLabels

theorem cast_asm {oldAsm newAsm : Assembly.Program}
    (hEq : oldAsm = newAsm)
    (hExact : ExactLabels oldAsm) :
    ExactLabels newAsm := by
  cases hEq
  exact hExact

theorem of_labels_nodup {asm : Assembly.Program}
    (hNodup : (Assembly.Program.labels asm).Nodup) :
    ExactLabels asm := by
  refine ⟨?_⟩
  intro pre label post hAsm
  have hLabels :
      Assembly.Program.labels asm =
        Assembly.Program.labels pre ++ label :: Assembly.Program.labels post := by
    rw [hAsm]
    simp [Assembly.Program.labels_append, Assembly.Program.labels]
  have hNodupLocal :
      (Assembly.Program.labels pre ++
        label :: Assembly.Program.labels post).Nodup := by
    simpa [hLabels] using hNodup
  have hNotMem : label ∉ Assembly.Program.labels pre := by
    rw [List.nodup_append] at hNodupLocal
    intro hMem
    exact hNodupLocal.2.2 label hMem label (by simp) rfl
  rw [hAsm]
  simpa using Assembly.Program.labelPc_append_label_eq pre post hNotMem

theorem labelPc_here {pre post : Assembly.Program}
    {label : Assembly.Label}
    (hExact :
      ExactLabels (pre ++ [Assembly.Instr.label label] ++ post)) :
    Assembly.Program.labelPc
        (pre ++ [Assembly.Instr.label label] ++ post) label =
      some (Assembly.Program.byteLength pre) := by
  exact hExact.labelPc_at pre label post rfl

end ExactLabels

namespace Frame
namespace StateRel

theorem dispatch_mismatched_test_runResult_at
    {caseLabel : Assembly.Label} {caseDest : Nat}
    {pre post : Assembly.Program}
    {callee : RunState} {target : EVMState}
    {tokens : List Word} {token probe : Word} {frame : ReturnDest}
    {returns : List ReturnDest}
    (hNe : probe ≠ token)
    (hFits :
      AssemblyProgram.PCFitsFrom pre
        [ StackShuffle.dupInstr (callee.evm.stack.length + 1)
        , Assembly.Instr.push probe
        , Assembly.Instr.prim .eq
        , Assembly.Instr.jumpi caseLabel
        ])
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : StateRel callee target (token :: tokens))
    (hReturns : callee.returns = frame :: returns)
    (hBound : callee.evm.stack.length < 16)
    (hCaseLabel :
      Assembly.Program.labelPc
        (pre ++
          [ StackShuffle.dupInstr (callee.evm.stack.length + 1)
          , Assembly.Instr.push probe
          , Assembly.Instr.prim .eq
          , Assembly.Instr.jumpi caseLabel
          ] ++ post)
        caseLabel = some caseDest) :
    ARunResult
      (pre ++
        [ StackShuffle.dupInstr (callee.evm.stack.length + 1)
        , Assembly.Instr.push probe
        , Assembly.Instr.prim .eq
        , Assembly.Instr.jumpi caseLabel
        ] ++ post)
      target
      (fun result =>
        match result with
        | .running final =>
            StateRel callee final (token :: tokens) ∧
              final.pc =
                Assembly.Program.pcAfter
                  (pre ++
                    [ StackShuffle.dupInstr (callee.evm.stack.length + 1)
                    , Assembly.Instr.push probe
                    , Assembly.Instr.prim .eq
                    , Assembly.Instr.jumpi caseLabel
                    ])
        | .halted _ => False) := by
  rcases caller_materialization_of_top_return hRel hReturns with
    ⟨callerTarget, hCaller, hTargetStack⟩
  have hTargetRecord :
      { target with stack := callee.evm.stack ++ token :: callerTarget } =
        target := by
    rw [← hTargetStack]
  have hRun :=
    StackShuffle.dispatchCondition_jumpi_source_exists
      (state := target) (returnValues := callee.evm.stack)
      (suffix := callerTarget) (token := token) (probe := probe)
      (label := caseLabel) (dest := caseDest) (pre := pre) (post := post)
      hFits (by simpa [hTargetRecord] using hPc) hBound hCaseLabel
  exact
    ARunResult.mono
      (by simpa [hTargetRecord] using hRun)
      (by
        intro result hResult
        cases result with
        | halted halt =>
            cases hResult
        | running final =>
            rcases hResult with ⟨hStack, hErase, hPcFinal⟩
            have hRelFinal : StateRel callee final (token :: tokens) := by
              refine ⟨?_, ?_⟩
              · rw [hReturns]
                simp [materializeStack, hCaller, hStack]
              · calc
                  eraseControl final = eraseControl target := by
                    simpa [hTargetRecord] using hErase
                  _ =
                    eraseControl
                      { target with
                        stack := callee.evm.stack ++ token :: callerTarget } := by
                      rw [hTargetRecord]
                  _ =
                    eraseControl
                      { callee.evm with
                        stack := callee.evm.stack ++ token :: callerTarget } :=
                      hRel.dataRel_replace_stack
                        (callee.evm.stack ++ token :: callerTarget)
                  _ = eraseControl { callee.evm with stack := final.stack } := by
                      rw [hStack]
            refine ⟨hRelFinal, ?_⟩
            simpa [hNe] using hPcFinal)

theorem dispatch_selected_site_runResult_at
    {caseLabel returnLabel : Assembly.Label} {returnDest : Nat}
    {pre between post : Assembly.Program}
    {callee : RunState} {target : EVMState}
    {tokens : List Word} {token : Word} {frame : ReturnDest}
    {returns : List ReturnDest}
    (hFits :
      AssemblyProgram.PCFitsFrom pre
        ([ StackShuffle.dupInstr (callee.evm.stack.length + 1)
         , Assembly.Instr.push token
         , Assembly.Instr.prim .eq
         , Assembly.Instr.jumpi caseLabel
         ] ++ between ++
          [Assembly.Instr.label caseLabel] ++
          StackShuffle.removeBuriedUnder callee.evm.stack.length ++
          [Assembly.Instr.jump returnLabel]))
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : StateRel callee target (token :: tokens))
    (hReturns : callee.returns = frame :: returns)
    (hBound : callee.evm.stack.length < 16)
    (hExact :
      ExactLabels
        (pre ++
          [ StackShuffle.dupInstr (callee.evm.stack.length + 1)
          , Assembly.Instr.push token
          , Assembly.Instr.prim .eq
          , Assembly.Instr.jumpi caseLabel
          ] ++ between ++
          [Assembly.Instr.label caseLabel] ++
          StackShuffle.removeBuriedUnder callee.evm.stack.length ++
          [Assembly.Instr.jump returnLabel] ++ post))
    (hReturnLabel :
      Assembly.Program.labelPc
        (pre ++
          [ StackShuffle.dupInstr (callee.evm.stack.length + 1)
          , Assembly.Instr.push token
          , Assembly.Instr.prim .eq
          , Assembly.Instr.jumpi caseLabel
          ] ++ between ++
          [Assembly.Instr.label caseLabel] ++
          StackShuffle.removeBuriedUnder callee.evm.stack.length ++
          [Assembly.Instr.jump returnLabel] ++ post)
        returnLabel = some returnDest) :
    ARunResult
      (pre ++
        [ StackShuffle.dupInstr (callee.evm.stack.length + 1)
        , Assembly.Instr.push token
        , Assembly.Instr.prim .eq
        , Assembly.Instr.jumpi caseLabel
        ] ++ between ++
        [Assembly.Instr.label caseLabel] ++
        StackShuffle.removeBuriedUnder callee.evm.stack.length ++
        [Assembly.Instr.jump returnLabel] ++ post)
      target
      (fun result =>
        match result with
        | .running final =>
            StateRel
              { callee with
                evm :=
                  { callee.evm with
                    stack := callee.evm.stack ++ frame.callerStack }
                returns := returns }
              final tokens ∧
              final.pc = EvmYul.UInt256.ofNat returnDest
        | .halted _ => False) := by
  let testCode : Assembly.Program :=
    [ StackShuffle.dupInstr (callee.evm.stack.length + 1)
    , Assembly.Instr.push token
    , Assembly.Instr.prim .eq
    , Assembly.Instr.jumpi caseLabel
    ]
  let removeCode := StackShuffle.removeBuriedUnder callee.evm.stack.length
  let casePre := pre ++ testCode ++ between
  let fullProgram :=
    pre ++ testCode ++ between ++ [Assembly.Instr.label caseLabel] ++
      removeCode ++ [Assembly.Instr.jump returnLabel] ++ post
  let returned : RunState :=
    { callee with
      evm :=
        { callee.evm with stack := callee.evm.stack ++ frame.callerStack }
      returns := returns }
  rcases caller_materialization_of_top_return hRel hReturns with
    ⟨callerTarget, hCaller, hTargetStack⟩
  have hTargetRecord :
      { target with stack := callee.evm.stack ++ token :: callerTarget } =
        target := by
    rw [← hTargetStack]
  have hExactFull : ExactLabels fullProgram := by
    simpa [fullProgram, testCode, removeCode, List.append_assoc] using hExact
  have hFitsTest :
      AssemblyProgram.PCFitsFrom pre testCode := by
    exact
      AssemblyProgram.PCFitsFrom.left
        (pre := pre) (first := testCode)
        (second := between ++ [Assembly.Instr.label caseLabel] ++
          removeCode ++ [Assembly.Instr.jump returnLabel])
        (by simpa [testCode, removeCode, List.append_assoc] using hFits)
  have hFitsCase :
      AssemblyProgram.PCFitsFrom casePre
        ([Assembly.Instr.label caseLabel] ++ removeCode ++
          [Assembly.Instr.jump returnLabel]) := by
    simpa [casePre, List.append_assoc] using
      (AssemblyProgram.PCFitsFrom.right
        (pre := pre) (first := testCode ++ between)
        (second :=
          [Assembly.Instr.label caseLabel] ++ removeCode ++
            [Assembly.Instr.jump returnLabel])
        (by simpa [testCode, removeCode, List.append_assoc] using hFits))
  have hCaseLabel :
      Assembly.Program.labelPc fullProgram caseLabel =
        some (Assembly.Program.byteLength casePre) := by
    have hHere :=
      hExactFull.labelPc_at casePre caseLabel
        (removeCode ++ [Assembly.Instr.jump returnLabel] ++ post)
        (by simp [fullProgram, casePre, testCode, removeCode, List.append_assoc])
    simpa [fullProgram] using hHere
  have hTestRun :=
    StackShuffle.dispatchCondition_jumpi_source_exists
      (state := target) (returnValues := callee.evm.stack)
      (suffix := callerTarget) (token := token) (probe := token)
      (label := caseLabel) (dest := Assembly.Program.byteLength casePre)
      (pre := pre)
      (post := between ++ [Assembly.Instr.label caseLabel] ++ removeCode ++
        [Assembly.Instr.jump returnLabel] ++ post)
      (by simpa [testCode] using hFitsTest)
      (by simpa [hTargetRecord] using hPc)
      hBound
      (by simpa [fullProgram, testCode, removeCode, List.append_assoc] using
        hCaseLabel)
  refine
    ARunResult.bind_running
      (program :=
        pre ++
          [ StackShuffle.dupInstr (callee.evm.stack.length + 1)
          , Assembly.Instr.push token
          , Assembly.Instr.prim .eq
          , Assembly.Instr.jumpi caseLabel
          ] ++ between ++
          [Assembly.Instr.label caseLabel] ++
          StackShuffle.removeBuriedUnder callee.evm.stack.length ++
          [Assembly.Instr.jump returnLabel] ++ post)
      (middle := fun afterTest =>
        StateRel callee afterTest (token :: tokens) ∧
          afterTest.pc = Assembly.Program.pcAfter casePre)
      ?_ ?_
  · exact
      ARunResult.mono
        (by
          simpa [testCode, removeCode, fullProgram, hTargetRecord,
            List.append_assoc] using hTestRun)
        (by
          intro result hResult
          cases result with
          | halted halt =>
              cases hResult
          | running afterTest =>
              rcases hResult with ⟨hStack, hErase, hPcAfterTest⟩
              have hRelAfterTest : StateRel callee afterTest (token :: tokens) := by
                refine ⟨?_, ?_⟩
                · rw [hReturns]
                  simp [materializeStack, hCaller, hStack]
                · calc
                    eraseControl afterTest = eraseControl target := hErase
                    _ =
                      eraseControl
                        { target with
                          stack := callee.evm.stack ++ token :: callerTarget } := by
                        rw [hTargetRecord]
                    _ =
                      eraseControl
                        { callee.evm with
                          stack := callee.evm.stack ++ token :: callerTarget } :=
                        hRel.dataRel_replace_stack
                          (callee.evm.stack ++ token :: callerTarget)
                    _ =
                      eraseControl { callee.evm with stack := afterTest.stack } := by
                        rw [hStack]
              refine ⟨hRelAfterTest, ?_⟩
              simpa [casePre, testCode] using hPcAfterTest)
  · intro afterTest hAfterTest
    have hCaseRun :=
      dispatch_case_runResult_at
        (caseLabel := caseLabel) (returnLabel := returnLabel)
        (dest := returnDest) (pre := casePre) (post := post)
        (callee := callee) (target := afterTest) (tokens := tokens)
        (token := token) (frame := frame) (returns := returns)
        (by simpa [removeCode] using hFitsCase)
        hAfterTest.2 hAfterTest.1 hReturns (by omega)
        (by
          simpa [fullProgram, casePre, testCode, removeCode, List.append_assoc]
            using hReturnLabel)
    simpa [casePre, testCode, removeCode, List.append_assoc] using hCaseRun

end StateRel
end Frame

namespace DispatchPreservation

def testCode (base : LabelSupply) (retc idx : Nat) (site : CallSite) :
    Assembly.Program :=
  [ StackShuffle.dupInstr (retc + 1)
  , Assembly.Instr.push site.token
  , Assembly.Instr.prim .eq
  , Assembly.Instr.jumpi (LabelSupply.label base idx)
  ]

def caseCode (base : LabelSupply) (retc idx : Nat) (site : CallSite) :
    Assembly.Program :=
  [Assembly.Instr.label (LabelSupply.label base idx)] ++
    StackShuffle.removeBuriedUnder retc ++
    [Assembly.Instr.jump site.returnLabel]

def tableCode (base : LabelSupply) (retc idx : Nat)
    (casePrefix : Assembly.Program) (sites : List CallSite) :
    Assembly.Program :=
  Dispatch.testsForRetc base retc idx sites ++
    [Assembly.Instr.prim .invalid] ++
    casePrefix ++
    Dispatch.casesForRetc base retc idx sites

theorem nodup_tokens_filter {sites : List CallSite} {p : CallSite → Bool}
    (hNoDup : (sites.map CallSite.token).Nodup) :
    (((sites.filter p).map CallSite.token)).Nodup := by
  exact
    List.Nodup.sublist
      (List.Sublist.map CallSite.token (List.filter_sublist (p := p)))
      hNoDup

@[simp] theorem testsForRetc_cons (base : LabelSupply)
    (retc idx : Nat) (site : CallSite) (rest : List CallSite) :
    Dispatch.testsForRetc base retc idx (site :: rest) =
      testCode base retc idx site ++
        Dispatch.testsForRetc base retc (idx + 1) rest := by
  simp [Dispatch.testsForRetc, testCode]

@[simp] theorem casesForRetc_cons (base : LabelSupply)
    (retc idx : Nat) (site : CallSite) (rest : List CallSite) :
    Dispatch.casesForRetc base retc idx (site :: rest) =
      caseCode base retc idx site ++
        Dispatch.casesForRetc base retc (idx + 1) rest := by
  simp [Dispatch.casesForRetc, caseCode, List.append_assoc]

set_option maxHeartbeats 800000 in
theorem selected_table_runResult_at
    {base : LabelSupply} {retc idx : Nat}
    {casePrefix post pre : Assembly.Program}
    {sites : List CallSite} {site : CallSite}
    {returnDest : Nat}
    {callee : RunState} {target : EVMState}
    {tokens : List Word} {token : Word} {frame : ReturnDest}
    {returns : List ReturnDest}
    (hMem : site ∈ sites)
    (hNoDup : (sites.map CallSite.token).Nodup)
    (hToken : site.token = token)
    (hRetc : callee.evm.stack.length = retc)
    (hFits :
      AssemblyProgram.PCFitsFrom pre
        (tableCode base retc idx casePrefix sites))
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : Frame.StateRel callee target (token :: tokens))
    (hReturns : callee.returns = frame :: returns)
    (hBound : retc < 16)
    (hExact :
      ExactLabels (pre ++ tableCode base retc idx casePrefix sites ++ post))
    (hReturnLabel :
      Assembly.Program.labelPc
        (pre ++ tableCode base retc idx casePrefix sites ++ post)
        site.returnLabel = some returnDest) :
    ARunResult
      (pre ++ tableCode base retc idx casePrefix sites ++ post)
      target
      (fun result =>
        match result with
        | .running final =>
            Frame.StateRel
              { callee with
                evm :=
                  { callee.evm with
                    stack := callee.evm.stack ++ frame.callerStack }
                returns := returns }
              final tokens ∧
              final.pc = EvmYul.UInt256.ofNat returnDest
        | .halted _ => False) := by
  induction sites generalizing pre idx casePrefix target with
  | nil =>
      cases hMem
  | cons head rest ih =>
      have hHeadNotIn : head.token ∉ rest.map CallSite.token := by
        exact (List.nodup_cons.mp (by simpa using hNoDup)).1
      have hNoDupRest : (rest.map CallSite.token).Nodup := by
        exact (List.nodup_cons.mp (by simpa using hNoDup)).2
      let headTest := testCode base retc idx head
      let headCase := caseCode base retc idx head
      let testsRest := Dispatch.testsForRetc base retc (idx + 1) rest
      let casesRest := Dispatch.casesForRetc base retc (idx + 1) rest
      have hMemCons : site = head ∨ site ∈ rest := by
        simpa using hMem
      rcases hMemCons with hEq | hMemRest
      · subst head
        have hFitsSelected :
              AssemblyProgram.PCFitsFrom pre
                ([ StackShuffle.dupInstr (callee.evm.stack.length + 1)
                 , Assembly.Instr.push token
                 , Assembly.Instr.prim .eq
                 , Assembly.Instr.jumpi (LabelSupply.label base idx)
                 ] ++
                  (testsRest ++ [Assembly.Instr.prim .invalid] ++ casePrefix) ++
                  [Assembly.Instr.label (LabelSupply.label base idx)] ++
                  StackShuffle.removeBuriedUnder callee.evm.stack.length ++
                  [Assembly.Instr.jump site.returnLabel]) := by
            exact
              AssemblyProgram.PCFitsFrom.left
                (pre := pre)
                (first :=
                  [ StackShuffle.dupInstr (callee.evm.stack.length + 1)
                  , Assembly.Instr.push token
                  , Assembly.Instr.prim .eq
                  , Assembly.Instr.jumpi (LabelSupply.label base idx)
                  ] ++
                  (testsRest ++ [Assembly.Instr.prim .invalid] ++ casePrefix) ++
                  [Assembly.Instr.label (LabelSupply.label base idx)] ++
                  StackShuffle.removeBuriedUnder callee.evm.stack.length ++
                  [Assembly.Instr.jump site.returnLabel])
                (second := casesRest)
                (by
                  simpa [tableCode, headTest, headCase, testsRest, casesRest,
                    testCode, caseCode, hRetc, hToken, List.append_assoc] using hFits)
        have hExactSelected :
              ExactLabels
                (pre ++
                  [ StackShuffle.dupInstr (callee.evm.stack.length + 1)
                  , Assembly.Instr.push token
                  , Assembly.Instr.prim .eq
                  , Assembly.Instr.jumpi (LabelSupply.label base idx)
                  ] ++
                  (testsRest ++ [Assembly.Instr.prim .invalid] ++ casePrefix) ++
                  [Assembly.Instr.label (LabelSupply.label base idx)] ++
                  StackShuffle.removeBuriedUnder callee.evm.stack.length ++
                  [Assembly.Instr.jump site.returnLabel] ++ casesRest ++ post) := by
            simpa [tableCode, headTest, headCase, testsRest, casesRest,
              testCode, caseCode, hRetc, hToken, List.append_assoc] using hExact
        have hReturnSelected :
              Assembly.Program.labelPc
                (pre ++
                  [ StackShuffle.dupInstr (callee.evm.stack.length + 1)
                  , Assembly.Instr.push token
                  , Assembly.Instr.prim .eq
                  , Assembly.Instr.jumpi (LabelSupply.label base idx)
                  ] ++
                  (testsRest ++ [Assembly.Instr.prim .invalid] ++ casePrefix) ++
                  [Assembly.Instr.label (LabelSupply.label base idx)] ++
                  StackShuffle.removeBuriedUnder callee.evm.stack.length ++
                  [Assembly.Instr.jump site.returnLabel] ++ casesRest ++ post)
                site.returnLabel = some returnDest := by
            simpa [tableCode, headTest, headCase, testsRest, casesRest,
              testCode, caseCode, hRetc, hToken, List.append_assoc] using hReturnLabel
        have hRun :=
            Frame.StateRel.dispatch_selected_site_runResult_at
              (caseLabel := LabelSupply.label base idx)
              (returnLabel := site.returnLabel) (returnDest := returnDest)
              (pre := pre)
              (between := testsRest ++ [Assembly.Instr.prim .invalid] ++ casePrefix)
              (post := casesRest ++ post)
              (callee := callee) (target := target) (tokens := tokens)
              (token := token) (frame := frame) (returns := returns)
              hFitsSelected hPc hRel hReturns (by omega)
              (by simpa [List.append_assoc] using hExactSelected)
              (by simpa [List.append_assoc] using hReturnSelected)
        simpa [tableCode, headTest, headCase, testsRest, casesRest,
            testCode, caseCode, hRetc, hToken, List.append_assoc] using hRun
      ·
          have hNe : head.token ≠ token := by
            intro hEq
            have hSiteTokenMem : site.token ∈ rest.map CallSite.token :=
              List.mem_map_of_mem (f := CallSite.token) hMemRest
            apply hHeadNotIn
            simpa [hEq, hToken] using hSiteTokenMem
          let headCasePre :=
            pre ++ headTest ++ testsRest ++ [Assembly.Instr.prim .invalid] ++
              casePrefix
          have hHeadCaseLabel :
              Assembly.Program.labelPc
                (pre ++ tableCode base retc idx casePrefix (head :: rest) ++ post)
                (LabelSupply.label base idx) =
                  some (Assembly.Program.byteLength headCasePre) := by
            have hHere :=
              hExact.labelPc_at headCasePre (LabelSupply.label base idx)
                (StackShuffle.removeBuriedUnder retc ++
                  [Assembly.Instr.jump head.returnLabel] ++ casesRest ++ post)
                (by
                  simp [tableCode, headCasePre, headTest, testsRest,
                    casesRest, testCode, caseCode, List.append_assoc])
            simpa [headCasePre] using hHere
          have hFitsHead :
              AssemblyProgram.PCFitsFrom pre
                [ StackShuffle.dupInstr (callee.evm.stack.length + 1)
                , Assembly.Instr.push head.token
                , Assembly.Instr.prim .eq
                , Assembly.Instr.jumpi (LabelSupply.label base idx)
                ] := by
            have hHead :
                AssemblyProgram.PCFitsFrom pre headTest :=
              AssemblyProgram.PCFitsFrom.left
                (pre := pre) (first := headTest)
                (second :=
                  testsRest ++ [Assembly.Instr.prim .invalid] ++ casePrefix ++
                    headCase ++ casesRest)
                (by
                  simpa [tableCode, headTest, headCase, testsRest, casesRest,
                    testCode, caseCode, List.append_assoc] using hFits)
            simpa [headTest, testCode, hRetc] using hHead
          have hRunHead :=
            Frame.StateRel.dispatch_mismatched_test_runResult_at
              (caseLabel := LabelSupply.label base idx)
              (caseDest := Assembly.Program.byteLength headCasePre)
              (pre := pre)
              (post :=
                testsRest ++ [Assembly.Instr.prim .invalid] ++ casePrefix ++
                  headCase ++ casesRest ++ post)
              (callee := callee) (target := target) (tokens := tokens)
              (token := token) (probe := head.token)
              (frame := frame) (returns := returns)
              hNe hFitsHead hPc hRel hReturns (by omega)
              (by
                simpa [tableCode, headTest, headCase, testsRest, casesRest,
                  testCode, caseCode, hRetc, headCasePre, List.append_assoc]
                  using hHeadCaseLabel)
          refine
            ARunResult.bind_running
              (program :=
                pre ++ tableCode base retc idx casePrefix (head :: rest) ++ post)
              (middle := fun afterHead =>
                Frame.StateRel callee afterHead (token :: tokens) ∧
                  afterHead.pc = Assembly.Program.pcAfter (pre ++ headTest))
              ?_ ?_
          · exact
              ARunResult.mono
                (by
                  simpa [tableCode, headTest, headCase, testsRest, casesRest,
                    testCode, caseCode, hRetc, List.append_assoc] using hRunHead)
                (by
                  intro result hResult
                  cases result with
                  | halted halt =>
                      cases hResult
                  | running afterHead =>
                      rcases hResult with ⟨hRelAfterHead, hPcAfterHead⟩
                      exact ⟨hRelAfterHead, by
                        simpa [headTest, testCode, hRetc] using hPcAfterHead⟩)
          · intro afterHead hAfterHead
            have hFitsRest :
                AssemblyProgram.PCFitsFrom (pre ++ headTest)
                  (tableCode base retc (idx + 1) (casePrefix ++ headCase) rest) := by
              simpa [tableCode, headTest, headCase, testsRest, casesRest,
                testCode, caseCode, List.append_assoc] using
                (AssemblyProgram.PCFitsFrom.right
                  (pre := pre) (first := headTest)
                  (second :=
                    testsRest ++ [Assembly.Instr.prim .invalid] ++
                      casePrefix ++ headCase ++ casesRest)
                  (by
                    simpa [tableCode, headTest, headCase, testsRest, casesRest,
                      testCode, caseCode, List.append_assoc] using hFits))
            have hExactRest :
                ExactLabels
                  ((pre ++ headTest) ++
                    tableCode base retc (idx + 1) (casePrefix ++ headCase) rest ++
                    post) := by
              simpa [tableCode, headTest, headCase, testsRest, casesRest,
                testCode, caseCode, List.append_assoc] using hExact
            have hReturnRest :
                Assembly.Program.labelPc
                  ((pre ++ headTest) ++
                    tableCode base retc (idx + 1) (casePrefix ++ headCase) rest ++
                    post)
                  site.returnLabel = some returnDest := by
              simpa [tableCode, headTest, headCase, testsRest, casesRest,
                testCode, caseCode, List.append_assoc] using hReturnLabel
            simpa [tableCode, headTest, headCase, testsRest, casesRest,
              testCode, caseCode, List.append_assoc] using
              (ih (pre := pre ++ headTest) (idx := idx + 1)
                (casePrefix := casePrefix ++ headCase)
                hMemRest hNoDupRest hFitsRest
                hAfterHead.2 hAfterHead.1 hExactRest hReturnRest)

theorem forProc_selected_runResult_at
    {proc : Proc} {sites : List CallSite} {supply : LabelSupply}
    {site : CallSite} {returnDest : Nat}
    {pre post : Assembly.Program}
    {callee : RunState} {target : EVMState}
    {tokens : List Word} {token : Word} {frame : ReturnDest}
    {returns : List ReturnDest}
    (hMem : site ∈ (sites.filter (CallSite.forProc proc.name)))
    (hNoDup :
      (((sites.filter (CallSite.forProc proc.name)).map CallSite.token)).Nodup)
    (hToken : site.token = token)
    (hRetc : callee.evm.stack.length = proc.retc)
    (hFits :
      AssemblyProgram.PCFitsFrom pre
        (Dispatch.forProc proc sites supply).code)
    (hPc : target.pc = Assembly.Program.pcAfter pre)
    (hRel : Frame.StateRel callee target (token :: tokens))
    (hReturns : callee.returns = frame :: returns)
    (hBound : proc.retc < 16)
    (hExact :
      ExactLabels (pre ++ (Dispatch.forProc proc sites supply).code ++ post))
    (hReturnLabel :
      Assembly.Program.labelPc
        (pre ++ (Dispatch.forProc proc sites supply).code ++ post)
        site.returnLabel = some returnDest) :
    ARunResult
      (pre ++ (Dispatch.forProc proc sites supply).code ++ post)
      target
      (fun result =>
        match result with
        | .running final =>
            Frame.StateRel
              { callee with
                evm :=
                  { callee.evm with
                    stack := callee.evm.stack ++ frame.callerStack }
                returns := returns }
              final tokens ∧
              final.pc = EvmYul.UInt256.ofNat returnDest
        | .halted _ => False) := by
  let procSites := sites.filter (CallSite.forProc proc.name)
  have hFitsTable :
      AssemblyProgram.PCFitsFrom pre
        (tableCode supply proc.retc 0 [] procSites) := by
    simpa [Dispatch.forProc, tableCode, procSites, List.append_assoc] using hFits
  have hExactTable :
      ExactLabels (pre ++ tableCode supply proc.retc 0 [] procSites ++ post) := by
    simpa [Dispatch.forProc, tableCode, procSites, List.append_assoc] using hExact
  have hReturnTable :
      Assembly.Program.labelPc
        (pre ++ tableCode supply proc.retc 0 [] procSites ++ post)
        site.returnLabel = some returnDest := by
    simpa [Dispatch.forProc, tableCode, procSites, List.append_assoc] using
      hReturnLabel
  have hRun :=
    selected_table_runResult_at
      (base := supply) (retc := proc.retc) (idx := 0)
      (casePrefix := []) (post := post) (pre := pre)
      (sites := procSites) (site := site) (returnDest := returnDest)
      (callee := callee) (target := target) (tokens := tokens)
      (token := token) (frame := frame) (returns := returns)
      (by simpa [procSites] using hMem) (by simpa [procSites] using hNoDup)
      hToken hRetc hFitsTable hPc hRel hReturns hBound hExactTable hReturnTable
  simpa [Dispatch.forProc, tableCode, procSites, List.append_assoc] using hRun

end DispatchPreservation

namespace ForLoop

def coreCode (cond : Code) (bodyCode postCode : Assembly.Program)
    (loopLabel bodyLabel postLabel endLabel : Assembly.Label) :
    Assembly.Program :=
  [Assembly.Instr.label loopLabel] ++
    cond.toAssembly ++
    [ Assembly.Instr.jumpi bodyLabel
    , Assembly.Instr.jump endLabel
    , Assembly.Instr.label bodyLabel
    ] ++
    bodyCode ++
    [Assembly.Instr.label postLabel] ++
    postCode ++
    [ Assembly.Instr.jump loopLabel
    , Assembly.Instr.label endLabel
    ]

def afterLoopLabel (pre : Assembly.Program)
    (loopLabel : Assembly.Label) : Assembly.Program :=
  pre ++ [Assembly.Instr.label loopLabel]

def afterCondJumpi (pre : Assembly.Program) (cond : Code)
    (loopLabel bodyLabel : Assembly.Label) : Assembly.Program :=
  afterLoopLabel pre loopLabel ++ cond.toAssembly ++
    [Assembly.Instr.jumpi bodyLabel]

def bodyLabelPre (pre : Assembly.Program) (cond : Code)
    (loopLabel bodyLabel endLabel : Assembly.Label) : Assembly.Program :=
  afterCondJumpi pre cond loopLabel bodyLabel ++
    [Assembly.Instr.jump endLabel]

def bodyPre (pre : Assembly.Program) (cond : Code)
    (loopLabel bodyLabel endLabel : Assembly.Label) : Assembly.Program :=
  bodyLabelPre pre cond loopLabel bodyLabel endLabel ++
    [Assembly.Instr.label bodyLabel]

def postLabelPre (pre : Assembly.Program) (cond : Code)
    (bodyCode : Assembly.Program)
    (loopLabel bodyLabel endLabel : Assembly.Label) : Assembly.Program :=
  bodyPre pre cond loopLabel bodyLabel endLabel ++ bodyCode

def postPre (pre : Assembly.Program) (cond : Code)
    (bodyCode : Assembly.Program)
    (loopLabel bodyLabel postLabel endLabel : Assembly.Label) :
    Assembly.Program :=
  postLabelPre pre cond bodyCode loopLabel bodyLabel endLabel ++
    [Assembly.Instr.label postLabel]

def endLabelPre (pre : Assembly.Program) (cond : Code)
    (bodyCode postCode : Assembly.Program)
    (loopLabel bodyLabel postLabel endLabel : Assembly.Label) :
    Assembly.Program :=
  postPre pre cond bodyCode loopLabel bodyLabel postLabel endLabel ++
    postCode ++ [Assembly.Instr.jump loopLabel]

structure Layout (pre suffix : Assembly.Program) (cond : Code)
    (bodyCode postCode : Assembly.Program)
    (loopLabel bodyLabel postLabel endLabel : Assembly.Label) : Prop where
  fitLoopLabel : PCFits pre
  fitCond : Code.PCFitsFrom (afterLoopLabel pre loopLabel) cond
  fitJumpEnd : PCFits (afterCondJumpi pre cond loopLabel bodyLabel)
  fitBodyLabel : PCFits (bodyLabelPre pre cond loopLabel bodyLabel endLabel)
  fitBody :
    AssemblyProgram.PCFitsFrom
      (bodyPre pre cond loopLabel bodyLabel endLabel) bodyCode
  fitPostLabel :
    PCFits (postLabelPre pre cond bodyCode loopLabel bodyLabel endLabel)
  fitPost :
    AssemblyProgram.PCFitsFrom
      (postPre pre cond bodyCode loopLabel bodyLabel postLabel endLabel)
      postCode
  fitBackJump :
    PCFits
      (postPre pre cond bodyCode loopLabel bodyLabel postLabel endLabel ++
        postCode)
  fitEndLabel :
    PCFits
      (endLabelPre pre cond bodyCode postCode loopLabel bodyLabel postLabel
        endLabel)
  loopLabelPc :
    Assembly.Program.labelPc
        (pre ++ coreCode cond bodyCode postCode loopLabel bodyLabel postLabel
          endLabel ++ suffix) loopLabel =
      some (Assembly.Program.byteLength pre)
  bodyLabelPc :
    Assembly.Program.labelPc
        (pre ++ coreCode cond bodyCode postCode loopLabel bodyLabel postLabel
          endLabel ++ suffix) bodyLabel =
      some
        (Assembly.Program.byteLength
          (bodyLabelPre pre cond loopLabel bodyLabel endLabel))
  postLabelPc :
    Assembly.Program.labelPc
        (pre ++ coreCode cond bodyCode postCode loopLabel bodyLabel postLabel
          endLabel ++ suffix) postLabel =
      some
        (Assembly.Program.byteLength
          (postLabelPre pre cond bodyCode loopLabel bodyLabel endLabel))
  endLabelPc :
    Assembly.Program.labelPc
        (pre ++ coreCode cond bodyCode postCode loopLabel bodyLabel postLabel
          endLabel ++ suffix) endLabel =
      some
        (Assembly.Program.byteLength
          (endLabelPre pre cond bodyCode postCode loopLabel bodyLabel
            postLabel endLabel))

namespace Layout

theorem of_fits_exact {pre suffix : Assembly.Program} {cond : Code}
    {bodyCode postCode : Assembly.Program}
    {loopLabel bodyLabel postLabel endLabel : Assembly.Label}
    (hFits :
      AssemblyProgram.PCFitsFrom pre
        (coreCode cond bodyCode postCode loopLabel bodyLabel postLabel
          endLabel))
    (hExact :
      ExactLabels
        (pre ++ coreCode cond bodyCode postCode loopLabel bodyLabel postLabel
          endLabel ++ suffix)) :
    Layout pre suffix cond bodyCode postCode loopLabel bodyLabel postLabel
      endLabel := by
  have hFitsCore :
      AssemblyProgram.PCFitsFrom pre
        ([Assembly.Instr.label loopLabel] ++ cond.toAssembly ++
          [ Assembly.Instr.jumpi bodyLabel
          , Assembly.Instr.jump endLabel
          , Assembly.Instr.label bodyLabel
          ] ++
          bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
          [ Assembly.Instr.jump loopLabel
          , Assembly.Instr.label endLabel
          ]) := by
    simpa [coreCode] using hFits
  have hAfterLoop :
      AssemblyProgram.PCFitsFrom (afterLoopLabel pre loopLabel)
        (cond.toAssembly ++
          [ Assembly.Instr.jumpi bodyLabel
          , Assembly.Instr.jump endLabel
          , Assembly.Instr.label bodyLabel
          ] ++
          bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
          [ Assembly.Instr.jump loopLabel
          , Assembly.Instr.label endLabel
          ]) := by
    simpa [afterLoopLabel, List.append_assoc] using
      AssemblyProgram.PCFitsFrom.right (pre := pre)
        (first := [Assembly.Instr.label loopLabel])
        (second :=
          cond.toAssembly ++
            [ Assembly.Instr.jumpi bodyLabel
            , Assembly.Instr.jump endLabel
            , Assembly.Instr.label bodyLabel
            ] ++
            bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
            [ Assembly.Instr.jump loopLabel
            , Assembly.Instr.label endLabel
            ])
        hFitsCore
  have hCondAsmFits :
      AssemblyProgram.PCFitsFrom (afterLoopLabel pre loopLabel)
        cond.toAssembly :=
    AssemblyProgram.PCFitsFrom.left (pre := afterLoopLabel pre loopLabel)
      (first := cond.toAssembly)
      (second :=
        [ Assembly.Instr.jumpi bodyLabel
        , Assembly.Instr.jump endLabel
        , Assembly.Instr.label bodyLabel
        ] ++
        bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
        [ Assembly.Instr.jump loopLabel
        , Assembly.Instr.label endLabel
        ])
      (by simpa [List.append_assoc] using hAfterLoop)
  have hPrefixAfterJumpi :
      AssemblyProgram.PCFitsFrom pre
        ([Assembly.Instr.label loopLabel] ++ cond.toAssembly ++
          [Assembly.Instr.jumpi bodyLabel]) :=
    AssemblyProgram.PCFitsFrom.left (pre := pre)
      (first :=
        [Assembly.Instr.label loopLabel] ++ cond.toAssembly ++
          [Assembly.Instr.jumpi bodyLabel])
      (second :=
        [Assembly.Instr.jump endLabel, Assembly.Instr.label bodyLabel] ++
          bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
          [Assembly.Instr.jump loopLabel, Assembly.Instr.label endLabel])
      (by simpa [List.append_assoc] using hFitsCore)
  have hPrefixBodyLabel :
      AssemblyProgram.PCFitsFrom pre
        ([Assembly.Instr.label loopLabel] ++ cond.toAssembly ++
          [Assembly.Instr.jumpi bodyLabel, Assembly.Instr.jump endLabel]) :=
    AssemblyProgram.PCFitsFrom.left (pre := pre)
      (first :=
        [Assembly.Instr.label loopLabel] ++ cond.toAssembly ++
          [Assembly.Instr.jumpi bodyLabel, Assembly.Instr.jump endLabel])
      (second :=
        [Assembly.Instr.label bodyLabel] ++
          bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
          [Assembly.Instr.jump loopLabel, Assembly.Instr.label endLabel])
      (by simpa [List.append_assoc] using hFitsCore)
  have hPrefixEndLabel :
      AssemblyProgram.PCFitsFrom pre
        ([Assembly.Instr.label loopLabel] ++ cond.toAssembly ++
          [ Assembly.Instr.jumpi bodyLabel
          , Assembly.Instr.jump endLabel
          , Assembly.Instr.label bodyLabel
          ] ++
          bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
          [Assembly.Instr.jump loopLabel]) :=
    AssemblyProgram.PCFitsFrom.left (pre := pre)
      (first :=
        [Assembly.Instr.label loopLabel] ++ cond.toAssembly ++
          [ Assembly.Instr.jumpi bodyLabel
          , Assembly.Instr.jump endLabel
          , Assembly.Instr.label bodyLabel
          ] ++
          bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
          [Assembly.Instr.jump loopLabel])
      (second := [Assembly.Instr.label endLabel])
      (by simpa [List.append_assoc] using hFitsCore)
  have hAfterBodyLabel :
      AssemblyProgram.PCFitsFrom
        (bodyPre pre cond loopLabel bodyLabel endLabel)
        (bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
          [Assembly.Instr.jump loopLabel, Assembly.Instr.label endLabel]) := by
    simpa [bodyPre, bodyLabelPre, afterCondJumpi, afterLoopLabel,
      List.append_assoc] using
      AssemblyProgram.PCFitsFrom.right (pre := pre)
        (first :=
          [Assembly.Instr.label loopLabel] ++ cond.toAssembly ++
            [ Assembly.Instr.jumpi bodyLabel
            , Assembly.Instr.jump endLabel
            , Assembly.Instr.label bodyLabel
            ])
        (second :=
          bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
            [Assembly.Instr.jump loopLabel, Assembly.Instr.label endLabel])
        (by simpa [List.append_assoc] using hFitsCore)
  have hPrefixPostLabel :
      AssemblyProgram.PCFitsFrom pre
        ([Assembly.Instr.label loopLabel] ++ cond.toAssembly ++
          [ Assembly.Instr.jumpi bodyLabel
          , Assembly.Instr.jump endLabel
          , Assembly.Instr.label bodyLabel
          ] ++
          bodyCode) :=
    AssemblyProgram.PCFitsFrom.left (pre := pre)
      (first :=
        [Assembly.Instr.label loopLabel] ++ cond.toAssembly ++
          [ Assembly.Instr.jumpi bodyLabel
          , Assembly.Instr.jump endLabel
          , Assembly.Instr.label bodyLabel
          ] ++
          bodyCode)
      (second :=
        [Assembly.Instr.label postLabel] ++ postCode ++
          [Assembly.Instr.jump loopLabel, Assembly.Instr.label endLabel])
      (by simpa [List.append_assoc] using hFitsCore)
  have hAfterPostLabel :
      AssemblyProgram.PCFitsFrom
        (postPre pre cond bodyCode loopLabel bodyLabel postLabel endLabel)
        (postCode ++
          [Assembly.Instr.jump loopLabel, Assembly.Instr.label endLabel]) := by
    simpa [postPre, postLabelPre, bodyPre, bodyLabelPre, afterCondJumpi,
      afterLoopLabel, List.append_assoc] using
      AssemblyProgram.PCFitsFrom.right (pre := pre)
        (first :=
          [Assembly.Instr.label loopLabel] ++ cond.toAssembly ++
            [ Assembly.Instr.jumpi bodyLabel
            , Assembly.Instr.jump endLabel
            , Assembly.Instr.label bodyLabel
            ] ++
            bodyCode ++ [Assembly.Instr.label postLabel])
        (second :=
          postCode ++
            [Assembly.Instr.jump loopLabel, Assembly.Instr.label endLabel])
        (by simpa [List.append_assoc] using hFitsCore)
  have hPrefixBackJump :
      AssemblyProgram.PCFitsFrom pre
        ([Assembly.Instr.label loopLabel] ++ cond.toAssembly ++
          [ Assembly.Instr.jumpi bodyLabel
          , Assembly.Instr.jump endLabel
          , Assembly.Instr.label bodyLabel
          ] ++
          bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode) :=
    AssemblyProgram.PCFitsFrom.left (pre := pre)
      (first :=
        [Assembly.Instr.label loopLabel] ++ cond.toAssembly ++
          [ Assembly.Instr.jumpi bodyLabel
          , Assembly.Instr.jump endLabel
          , Assembly.Instr.label bodyLabel
          ] ++
          bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode)
      (second :=
        [Assembly.Instr.jump loopLabel, Assembly.Instr.label endLabel])
      (by simpa [List.append_assoc] using hFitsCore)
  refine
    ⟨ AssemblyProgram.PCFitsFrom.start hFitsCore
    , Code.PCFitsFrom.of_assembly hCondAsmFits
    , ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_ ⟩
  · simpa [afterCondJumpi, afterLoopLabel, List.append_assoc] using
      AssemblyProgram.PCFitsFrom.end hPrefixAfterJumpi
  · simpa [bodyLabelPre, afterCondJumpi, afterLoopLabel, List.append_assoc] using
      AssemblyProgram.PCFitsFrom.end hPrefixBodyLabel
  · exact
      AssemblyProgram.PCFitsFrom.left
        (pre := bodyPre pre cond loopLabel bodyLabel endLabel)
        (first := bodyCode)
        (second :=
          [Assembly.Instr.label postLabel] ++ postCode ++
            [Assembly.Instr.jump loopLabel, Assembly.Instr.label endLabel])
        (by simpa [List.append_assoc] using hAfterBodyLabel)
  · simpa [postLabelPre, bodyPre, bodyLabelPre, afterCondJumpi,
      afterLoopLabel, List.append_assoc] using
      AssemblyProgram.PCFitsFrom.end hPrefixPostLabel
  · exact
      AssemblyProgram.PCFitsFrom.left
        (pre := postPre pre cond bodyCode loopLabel bodyLabel postLabel
          endLabel)
        (first := postCode)
        (second :=
          [Assembly.Instr.jump loopLabel, Assembly.Instr.label endLabel])
        (by simpa [List.append_assoc] using hAfterPostLabel)
  · simpa [postPre, postLabelPre, bodyPre, bodyLabelPre, afterCondJumpi,
      afterLoopLabel, List.append_assoc] using
      AssemblyProgram.PCFitsFrom.end hPrefixBackJump
  · simpa [endLabelPre, postPre, postLabelPre, bodyPre, bodyLabelPre,
      afterCondJumpi, afterLoopLabel, List.append_assoc] using
      AssemblyProgram.PCFitsFrom.end hPrefixEndLabel
  · have hHere :=
      hExact.labelPc_at pre loopLabel
        (cond.toAssembly ++
          [ Assembly.Instr.jumpi bodyLabel
          , Assembly.Instr.jump endLabel
          , Assembly.Instr.label bodyLabel
          ] ++
          bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
          [ Assembly.Instr.jump loopLabel
          , Assembly.Instr.label endLabel
          ] ++ suffix)
        (by simp [coreCode, List.append_assoc])
    simpa [coreCode, List.append_assoc] using hHere
  · have hHere :=
      hExact.labelPc_at
        (bodyLabelPre pre cond loopLabel bodyLabel endLabel)
        bodyLabel
        (bodyCode ++ [Assembly.Instr.label postLabel] ++ postCode ++
          [ Assembly.Instr.jump loopLabel
          , Assembly.Instr.label endLabel
          ] ++ suffix)
        (by
          simp [coreCode, bodyLabelPre, afterCondJumpi, afterLoopLabel,
            List.append_assoc])
    simpa [coreCode, bodyLabelPre, afterCondJumpi, afterLoopLabel,
      List.append_assoc] using hHere
  · have hHere :=
      hExact.labelPc_at
        (postLabelPre pre cond bodyCode loopLabel bodyLabel endLabel)
        postLabel
        (postCode ++
          [ Assembly.Instr.jump loopLabel
          , Assembly.Instr.label endLabel
          ] ++ suffix)
        (by
          simp [coreCode, postLabelPre, bodyPre, bodyLabelPre,
            afterCondJumpi, afterLoopLabel, List.append_assoc])
    simpa [coreCode, postLabelPre, bodyPre, bodyLabelPre, afterCondJumpi,
      afterLoopLabel, List.append_assoc] using hHere
  · have hHere :=
      hExact.labelPc_at
        (endLabelPre pre cond bodyCode postCode loopLabel bodyLabel postLabel
          endLabel)
        endLabel
        suffix
        (by
          simp [coreCode, endLabelPre, postPre, postLabelPre, bodyPre,
            bodyLabelPre, afterCondJumpi, afterLoopLabel, List.append_assoc])
    simpa [coreCode, endLabelPre, postPre, postLabelPre, bodyPre,
      bodyLabelPre, afterCondJumpi, afterLoopLabel, List.append_assoc] using hHere

end Layout

end ForLoop

def StmtPreserves (program : Program) (ctx : CompileContext)
    (supply : LabelSupply) (stmt : Stmt) : Prop :=
  ∀ {pre post : Assembly.Program} {fuel : Nat}
    {source : RunState} {outcome : Outcome} {target : EVMState}
    {tokens : List Word},
    AssemblyProgram.PCFitsFrom pre (Stmt.compileFromCtxCore stmt ctx supply).code →
      ContextLabelsResolve
        (pre ++ (Stmt.compileFromCtxCore stmt ctx supply).code ++ post) ctx →
      ExactLabels
        (pre ++ (Stmt.compileFromCtxCore stmt ctx supply).code ++ post) →
      target.pc = Assembly.Program.pcAfter pre →
      Frame.StateRel source target tokens →
      Stmt.Eval program fuel stmt source outcome →
      ARunResult
        (pre ++ (Stmt.compileFromCtxCore stmt ctx supply).code ++ post)
        target
        (fun result =>
          CompiledOutcomeRel
            (pre ++ (Stmt.compileFromCtxCore stmt ctx supply).code ++ post)
            ctx
            (Assembly.Program.pcAfter
              (pre ++ (Stmt.compileFromCtxCore stmt ctx supply).code))
            outcome result tokens)

def BlockPreserves (program : Program) (ctx : CompileContext)
    (supply : LabelSupply) (block : Block) : Prop :=
  ∀ {pre post : Assembly.Program} {fuel : Nat}
    {source : RunState} {outcome : Outcome} {target : EVMState}
    {tokens : List Word},
    AssemblyProgram.PCFitsFrom pre (Block.compileFromCtx block ctx supply).code →
      ContextLabelsResolve
        (pre ++ (Block.compileFromCtx block ctx supply).code ++ post) ctx →
      ExactLabels
        (pre ++ (Block.compileFromCtx block ctx supply).code ++ post) →
      target.pc = Assembly.Program.pcAfter pre →
      Frame.StateRel source target tokens →
      Block.Eval program fuel block source outcome →
      ARunResult
        (pre ++ (Block.compileFromCtx block ctx supply).code ++ post)
        target
        (fun result =>
          CompiledOutcomeRel
            (pre ++ (Block.compileFromCtx block ctx supply).code ++ post)
            ctx
            (Assembly.Program.pcAfter
              (pre ++ (Block.compileFromCtx block ctx supply).code))
            outcome result tokens)

def BlockPreservesAtFuel (program : Program) (ctx : CompileContext)
    (supply : LabelSupply) (block : Block) (fuel : Nat) : Prop :=
  ∀ {pre post : Assembly.Program}
    {source : RunState} {outcome : Outcome} {target : EVMState}
    {tokens : List Word},
    AssemblyProgram.PCFitsFrom pre (Block.compileFromCtx block ctx supply).code →
      ContextLabelsResolve
        (pre ++ (Block.compileFromCtx block ctx supply).code ++ post) ctx →
      ExactLabels
        (pre ++ (Block.compileFromCtx block ctx supply).code ++ post) →
      target.pc = Assembly.Program.pcAfter pre →
      Frame.StateRel source target tokens →
      Block.Eval program fuel block source outcome →
      ARunResult
        (pre ++ (Block.compileFromCtx block ctx supply).code ++ post)
        target
        (fun result =>
          CompiledOutcomeRel
            (pre ++ (Block.compileFromCtx block ctx supply).code ++ post)
            ctx
            (Assembly.Program.pcAfter
              (pre ++ (Block.compileFromCtx block ctx supply).code))
            outcome result tokens)

theorem blockPreservesAtFuel_of_preserves {program : Program}
    {ctx : CompileContext} {supply : LabelSupply} {block : Block}
    {fuel : Nat}
    (hPreserves : BlockPreserves program ctx supply block) :
    BlockPreservesAtFuel program ctx supply block fuel := by
  intro pre post source outcome target tokens hFits hResolve hExact hPc hRel
    hEval
  exact hPreserves hFits hResolve hExact hPc hRel hEval

namespace ProcedurePreservation

def CallsIncluded (localSites globalSites : List CallSite) : Prop :=
  ∀ site, site ∈ localSites → site ∈ globalSites

namespace CallsIncluded

theorem refl (sites : List CallSite) : CallsIncluded sites sites := by
  intro site hMem
  exact hMem

theorem trans {first second third : List CallSite}
    (hLeft : CallsIncluded first second)
    (hRight : CallsIncluded second third) :
    CallsIncluded first third := by
  intro site hMem
  exact hRight site (hLeft site hMem)

theorem nil (sites : List CallSite) : CallsIncluded [] sites := by
  intro site hMem
  cases hMem

theorem left {left right global : List CallSite}
    (hIncluded : CallsIncluded (left ++ right) global) :
    CallsIncluded left global := by
  intro site hMem
  exact hIncluded site (List.mem_append_left right hMem)

theorem right {left right global : List CallSite}
    (hIncluded : CallsIncluded (left ++ right) global) :
    CallsIncluded right global := by
  intro site hMem
  exact hIncluded site (List.mem_append_right left hMem)

theorem append {left right global : List CallSite}
    (hLeft : CallsIncluded left global)
    (hRight : CallsIncluded right global) :
    CallsIncluded (left ++ right) global := by
  intro site hMem
  rcases List.mem_append.mp hMem with hMemLeft | hMemRight
  · exact hLeft site hMemLeft
  · exact hRight site hMemRight

theorem compileResult_append_left {leftResult rightResult : CompileResult}
    {global : List CallSite}
    (hIncluded : CallsIncluded (leftResult.append rightResult).calls global) :
    CallsIncluded leftResult.calls global := by
  exact left (by simpa [CompileResult.append] using hIncluded)

theorem compileResult_append_right {leftResult rightResult : CompileResult}
    {global : List CallSite}
    (hIncluded : CallsIncluded (leftResult.append rightResult).calls global) :
    CallsIncluded rightResult.calls global := by
  exact right (by simpa [CompileResult.append] using hIncluded)

end CallsIncluded

theorem main_calls_included_allCalls (program : Program) :
    CallsIncluded (CompiledProgram.main program).calls
      (CompiledProgram.allCalls program) := by
  intro site hMem
  exact List.mem_append_left (CompiledProgram.procCalls program) hMem

theorem proc_calls_included_allCalls (program : Program) :
    CallsIncluded (CompiledProgram.procCalls program)
      (CompiledProgram.allCalls program) := by
  intro site hMem
  exact List.mem_append_right (CompiledProgram.main program).calls hMem

theorem procBodies_head_calls_included (allProcs : List Proc)
    (proc : Proc) (rest : List Proc) (supply : LabelSupply) :
    CallsIncluded (Proc.compileBody allProcs proc supply).calls
      (ProcBodies.compile allProcs (proc :: rest) supply).2.2 := by
  intro site hMem
  simp [ProcBodies.compile, hMem]

theorem procBodies_tail_calls_included (allProcs : List Proc)
    (proc : Proc) (rest : List Proc) (supply : LabelSupply) :
    CallsIncluded
      (ProcBodies.compile allProcs rest
        (Proc.compileBody allProcs proc supply).next).2.2
      (ProcBodies.compile allProcs (proc :: rest) supply).2.2 := by
  intro site hMem
  simp [ProcBodies.compile, hMem]

def bodyCtx (program : Program) (proc : Proc) : CompileContext :=
  { procs := program.procs, leaveLabel? := some (ProcLabel.exit proc.name) }

noncomputable def bodyCode (program : Program) (proc : Proc)
    (supply : LabelSupply) : Assembly.Program :=
  (Block.compileFromCtx proc.body (bodyCtx program proc) supply).code

def dispatchCode (proc : Proc) (sites : List CallSite)
    (supply : LabelSupply) : Assembly.Program :=
  (Dispatch.forProc proc sites supply).code

noncomputable def procSegment (program : Program) (proc : Proc)
    (bodySupply dispatchSupply : LabelSupply) (sites : List CallSite) :
    Assembly.Program :=
  [Assembly.Instr.label (ProcLabel.entry proc.name)] ++
    bodyCode program proc bodySupply ++
    [Assembly.Instr.label (ProcLabel.exit proc.name)] ++
    dispatchCode proc sites dispatchSupply

/--
Exact callee-body preservation at the concrete procedure segment currently
being executed.

This is the proof interface that lets recursive procedure calls use a bounded
whole-program body theorem without pretending they have an arbitrary local
`pre/post` theorem.  The older local theorem still maps into this interface,
while the public call proof can derive it from `ProgramLayout`.
-/
def ProcBodyPreservesAtSegment (program : Program) (proc : Proc)
    (bodySupply dispatchSupply : LabelSupply) (sites : List CallSite)
    (fuel : Nat) (pre post : Assembly.Program) : Prop :=
  ∀ {source : RunState} {outcome : Outcome}
    {target : EVMState} {tokens : List Word},
    target.pc =
        Assembly.Program.pcAfter
          (pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)]) →
      Frame.StateRel source target tokens →
      Block.Eval program fuel proc.body source outcome →
      ARunResult
        (pre ++ procSegment program proc bodySupply dispatchSupply sites ++ post)
        target
        (fun result =>
          CompiledOutcomeRel
            (pre ++
              procSegment program proc bodySupply dispatchSupply sites ++ post)
            (bodyCtx program proc)
            (Assembly.Program.pcAfter
              ((pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++
                bodyCode program proc bodySupply))
            outcome result tokens)

def callJumpCode (proc : Proc) (args : EvmYul.Stack Word)
    (token : Word) : Assembly.Program :=
  ([Assembly.Instr.push token] ++ StackShuffle.sinkTopUnder args.length) ++
    [Assembly.Instr.jump (ProcLabel.entry proc.name)]

def callSiteCode (proc : Proc) (args : EvmYul.Stack Word)
    (token : Word) (returnLabel : Assembly.Label) : Assembly.Program :=
  callJumpCode proc args token ++ [Assembly.Instr.label returnLabel]

def callJumpCodeStatic (proc : Proc) (token : Word) : Assembly.Program :=
  ([Assembly.Instr.push token] ++ StackShuffle.sinkTopUnder proc.argc) ++
    [Assembly.Instr.jump (ProcLabel.entry proc.name)]

def callSiteCodeStatic (proc : Proc) (token : Word)
    (returnLabel : Assembly.Label) : Assembly.Program :=
  callJumpCodeStatic proc token ++ [Assembly.Instr.label returnLabel]

theorem callJumpCode_eq_static {proc : Proc} {args : EvmYul.Stack Word}
    {token : Word}
    (hArgsLen : args.length = proc.argc) :
    callJumpCode proc args token = callJumpCodeStatic proc token := by
  simp [callJumpCode, callJumpCodeStatic, hArgsLen]

theorem callSiteCode_eq_static {proc : Proc} {args : EvmYul.Stack Word}
    {token : Word} {returnLabel : Assembly.Label}
    (hArgsLen : args.length = proc.argc) :
    callSiteCode proc args token returnLabel =
      callSiteCodeStatic proc token returnLabel := by
  simp [callSiteCode, callSiteCodeStatic, callJumpCode_eq_static hArgsLen]

theorem compile_call_code_eq_callSiteCode {ctx : CompileContext}
    {supply : LabelSupply} {name : Name} {proc : Proc}
    {args : EvmYul.Stack Word}
    (hLookup : ProcList.lookup? name ctx.procs = some proc)
    (hArgsLen : args.length = proc.argc) :
    (Stmt.compileFromCtxCore (.call name) ctx supply).code =
      callSiteCode proc args (Stmt.callToken supply)
        (LabelSupply.label supply 0) := by
  have hName := ProcList.name_of_lookup? hLookup
  simp [Stmt.compileFromCtxCore, hLookup, callSiteCode, callJumpCode,
    hArgsLen, hName, List.append_assoc]

theorem compile_call_code_eq_callSiteCodeStatic {ctx : CompileContext}
    {supply : LabelSupply} {name : Name} {proc : Proc}
    (hLookup : ProcList.lookup? name ctx.procs = some proc) :
    (Stmt.compileFromCtxCore (.call name) ctx supply).code =
      callSiteCodeStatic proc (Stmt.callToken supply)
        (LabelSupply.label supply 0) := by
  have hName := ProcList.name_of_lookup? hLookup
  simp [Stmt.compileFromCtxCore, hLookup, callSiteCodeStatic,
    callJumpCodeStatic, hName, List.append_assoc]

theorem compile_call_calls_eq_of_lookup {ctx : CompileContext}
    {supply : LabelSupply} {name : Name} {proc : Proc}
    (hLookup : ProcList.lookup? name ctx.procs = some proc) :
    (Stmt.compileFromCtxCore (.call name) ctx supply).calls =
      [{ procName := name
         token := Stmt.callToken supply
         returnLabel := LabelSupply.label supply 0 }] := by
  simp [Stmt.compileFromCtxCore, hLookup]

theorem generated_callSite_mem_of_lookup {ctx : CompileContext}
    {supply : LabelSupply} {name : Name} {proc : Proc}
    (hLookup : ProcList.lookup? name ctx.procs = some proc) :
    { procName := name
      token := Stmt.callToken supply
      returnLabel := LabelSupply.label supply 0 } ∈
      (Stmt.compileFromCtxCore (.call name) ctx supply).calls := by
  rw [compile_call_calls_eq_of_lookup (ctx := ctx) (supply := supply)
    (name := name) (proc := proc) hLookup]
  simp

theorem generated_callSite_mem_of_included {ctx : CompileContext}
    {supply : LabelSupply} {name : Name} {proc : Proc}
    {sites : List CallSite}
    (hLookup : ProcList.lookup? name ctx.procs = some proc)
    (hIncluded :
      CallsIncluded (Stmt.compileFromCtxCore (.call name) ctx supply).calls
        sites) :
    { procName := name
      token := Stmt.callToken supply
      returnLabel := LabelSupply.label supply 0 } ∈ sites :=
  hIncluded _
    (generated_callSite_mem_of_lookup (ctx := ctx) (supply := supply)
      (name := name) (proc := proc) hLookup)

theorem procSegment_eq_compileBody_dispatch {program : Program} {proc : Proc}
    {bodySupply dispatchSupply : LabelSupply} {sites : List CallSite} :
    procSegment program proc bodySupply dispatchSupply sites =
      (Proc.compileBody program.procs proc bodySupply).code ++
        (Dispatch.forProc proc sites dispatchSupply).code := by
  simp [procSegment, bodyCode, bodyCtx, dispatchCode, Proc.compileBody,
    List.append_assoc]

theorem callSite_mem_filter_for_lookup {procs : List Proc}
    {name : Name} {proc : Proc} {sites : List CallSite} {site : CallSite}
    (hLookup : ProcList.lookup? name procs = some proc)
    (hMem : site ∈ sites)
    (hSiteName : site.procName = name) :
    site ∈ sites.filter (CallSite.forProc proc.name) := by
  have hProcName := ProcList.name_of_lookup? hLookup
  simp [CallSite.forProc, hMem, hSiteName, hProcName]

theorem arg_bound_of_split {proc : Proc}
    {state : RunState} {args callerStack : EvmYul.Stack Word}
    (hSplit :
      StackFrame.splitArgs? proc.argc state.evm.stack =
        some (args, callerStack))
    (hArgc : proc.argc ≤ 16) :
    args.length ≤ 16 := by
  have hArgsLen :=
    Frame.StackFrameFacts.splitArgs?_args_length hSplit
  omega

theorem procBodyPreservesAtSegment_of_local {program : Program} {proc : Proc}
    {bodySupply dispatchSupply : LabelSupply} {sites : List CallSite}
    {fuel : Nat} {pre post : Assembly.Program}
    (hBodyPres :
      BlockPreservesAtFuel program (bodyCtx program proc) bodySupply proc.body
        fuel)
    (hFits :
      AssemblyProgram.PCFitsFrom pre
        (procSegment program proc bodySupply dispatchSupply sites))
    (hExact :
      ExactLabels
        (pre ++ procSegment program proc bodySupply dispatchSupply sites ++
          post)) :
    ProcBodyPreservesAtSegment program proc bodySupply dispatchSupply sites
      fuel pre post := by
  intro source outcome target tokens hPc hRel hEval
  let ctx := bodyCtx program proc
  let bcode := bodyCode program proc bodySupply
  let dcode := dispatchCode proc sites dispatchSupply
  let exitLabel := ProcLabel.exit proc.name
  have hFitsAfterEntry :
      AssemblyProgram.PCFitsFrom
        (pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)])
        (bcode ++ ([Assembly.Instr.label exitLabel] ++ dcode)) := by
    exact
      AssemblyProgram.PCFitsFrom.right
        (pre := pre)
        (first := [Assembly.Instr.label (ProcLabel.entry proc.name)])
        (second := bcode ++ ([Assembly.Instr.label exitLabel] ++ dcode))
        (by
          simpa [procSegment, bcode, dcode, bodyCode, dispatchCode, exitLabel,
            List.append_assoc] using hFits)
  have hFitsBody :
      AssemblyProgram.PCFitsFrom
        (pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)])
        bcode := by
    exact
      AssemblyProgram.PCFitsFrom.left
        (pre := pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)])
        (first := bcode)
        (second := [Assembly.Instr.label exitLabel] ++ dcode)
        hFitsAfterEntry
  have hExitPc :
      Assembly.Program.labelPc
        (pre ++ procSegment program proc bodySupply dispatchSupply sites ++ post)
        exitLabel =
          some
            (Assembly.Program.byteLength
              ((pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++
                bcode)) := by
    have hHere :=
      hExact.labelPc_at
        ((pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++ bcode)
        exitLabel
        (dcode ++ post)
        (by
          simp [procSegment, bcode, dcode, bodyCode, dispatchCode, exitLabel,
            List.append_assoc])
    simpa [bcode, dcode, exitLabel] using hHere
  have hResolveBody :
      ContextLabelsResolve
        ((pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++
          bcode ++ ([Assembly.Instr.label exitLabel] ++ dcode ++ post))
        ctx := by
    refine ⟨?_, ?_, ?_⟩
    · intro label h
      simp [ctx, bodyCtx] at h
    · intro label h
      simp [ctx, bodyCtx] at h
    · intro label h
      simp [ctx, bodyCtx] at h
      cases h
      refine ⟨Assembly.Program.byteLength
        ((pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++
          bcode), ?_⟩
      simpa [procSegment, bcode, dcode, bodyCode, dispatchCode, exitLabel,
        List.append_assoc] using hExitPc
  have hExactBody :
      ExactLabels
        ((pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++
          bcode ++ ([Assembly.Instr.label exitLabel] ++ dcode ++ post)) := by
    simpa [procSegment, bcode, dcode, bodyCode, dispatchCode, exitLabel,
      List.append_assoc] using hExact
  have hRun :=
    hBodyPres
      (pre := pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)])
      (post := [Assembly.Instr.label exitLabel] ++ dcode ++ post)
      (source := source) (outcome := outcome) (target := target)
      (tokens := tokens)
      (by simpa [bodyCode, ctx, bcode] using hFitsBody)
      hResolveBody hExactBody hPc hRel hEval
  simpa [ProcBodyPreservesAtSegment, procSegment, bodyCode, dispatchCode, ctx,
    bcode, dcode, exitLabel, List.append_assoc] using hRun

theorem exit_label_then_dispatch {proc : Proc}
    {dispatchSupply : LabelSupply} {sites : List CallSite}
    {site : CallSite} {returnDest : Nat}
    {bodyState returned : RunState}
    {stack : EvmYul.Stack Word} {frame : ReturnDest}
    {target : EVMState} {tokens : List Word} {token : Word}
    {preExit post : Assembly.Program}
    (hAttach :
      StackFrame.attachReturns? frame bodyState.evm.stack = some stack)
    (hReturns : bodyState.returns = frame :: returned.returns)
    (hRetc : bodyState.evm.stack.length = proc.retc)
    (hMem : site ∈ sites.filter (CallSite.forProc proc.name))
    (hNoDup :
      ((sites.filter (CallSite.forProc proc.name)).map CallSite.token).Nodup)
    (hToken : site.token = token)
    (hBound : proc.retc < 16)
    (hFitsExit :
      AssemblyProgram.PCFitsFrom preExit
        [Assembly.Instr.label (ProcLabel.exit proc.name)])
    (hFitsDispatch :
      AssemblyProgram.PCFitsFrom
        (preExit ++ [Assembly.Instr.label (ProcLabel.exit proc.name)])
        (dispatchCode proc sites dispatchSupply))
    (hPc : target.pc = Assembly.Program.pcAfter preExit)
    (hRel : Frame.StateRel bodyState target (token :: tokens))
    (hExact :
      ExactLabels
        (preExit ++ [Assembly.Instr.label (ProcLabel.exit proc.name)] ++
          dispatchCode proc sites dispatchSupply ++ post))
    (hReturnLabel :
      Assembly.Program.labelPc
        (preExit ++ [Assembly.Instr.label (ProcLabel.exit proc.name)] ++
          dispatchCode proc sites dispatchSupply ++ post)
        site.returnLabel = some returnDest) :
    ARunResult
      (preExit ++ [Assembly.Instr.label (ProcLabel.exit proc.name)] ++
        dispatchCode proc sites dispatchSupply ++ post)
      target
      (fun result =>
        match result with
        | .running final =>
            Frame.StateRel
              (returned.withEVM { bodyState.evm with stack := stack })
              final tokens ∧
              final.pc = EvmYul.UInt256.ofNat returnDest
        | .halted _ => False) := by
  let dcode := dispatchCode proc sites dispatchSupply
  have hSourceEq :
      returned.withEVM { bodyState.evm with stack := stack } =
        { bodyState with
          evm :=
            { bodyState.evm with
              stack := bodyState.evm.stack ++ frame.callerStack }
          returns := returned.returns } :=
    Frame.CallFacts.returned_with_attached_eq hAttach
  have hExitRun :=
    Frame.StateRel.label_runResult_at
      (label := ProcLabel.exit proc.name)
      (pre := preExit) (post := dcode ++ post)
      (source := bodyState) (target := target)
      (tokens := token :: tokens)
      (AssemblyProgram.PCFitsFrom.start hFitsExit) hPc hRel
  refine
    ARunResult.bind_running
      (program :=
        preExit ++ [Assembly.Instr.label (ProcLabel.exit proc.name)] ++
          dispatchCode proc sites dispatchSupply ++ post)
      (middle := fun afterExit =>
        Frame.StateRel bodyState afterExit (token :: tokens) ∧
          afterExit.pc =
            Assembly.Program.pcAfter
              (preExit ++ [Assembly.Instr.label (ProcLabel.exit proc.name)]))
      ?_ ?_
  · simpa [dcode, dispatchCode, List.append_assoc] using hExitRun
  · intro afterExit hAfterExit
    have hDispatch :=
      DispatchPreservation.forProc_selected_runResult_at
        (proc := proc) (sites := sites) (supply := dispatchSupply)
        (site := site) (returnDest := returnDest)
        (pre := preExit ++ [Assembly.Instr.label (ProcLabel.exit proc.name)])
        (post := post) (callee := bodyState) (target := afterExit)
        (tokens := tokens) (token := token) (frame := frame)
        (returns := returned.returns)
        hMem hNoDup hToken hRetc
        (by simpa [dispatchCode, dcode] using hFitsDispatch)
        hAfterExit.2 hAfterExit.1 hReturns hBound
        (by simpa [dispatchCode, dcode, List.append_assoc] using hExact)
        (by simpa [dispatchCode, dcode, List.append_assoc] using hReturnLabel)
    exact
      ARunResult.mono
        (by
          simpa [dispatchCode, dcode, List.append_assoc] using hDispatch)
        (by
          intro result hResult
          cases result with
          | halted halt =>
              cases hResult

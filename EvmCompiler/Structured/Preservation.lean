  have hCallFits :
      AssemblyProgram.PCFitsFrom callSeg.pre (jumpCode ++ returnCode) := by
    simpa [callSiteCode, jumpCode, returnCode, List.append_assoc] using
      callSeg.hFits
  have hFitsJump :
      AssemblyProgram.PCFitsFrom callSeg.pre jumpCode := by
    exact
      AssemblyProgram.PCFitsFrom.left
        (pre := callSeg.pre) (first := jumpCode) (second := returnCode)
        hCallFits
  have hEntryPcAsm :
      Assembly.Program.labelPc asm (ProcLabel.entry proc.name) =
        some (Assembly.Program.byteLength procSeg.pre) := by
    have hHere :=
      hExact.labelPc_at procSeg.pre (ProcLabel.entry proc.name)
        (bodyCode program proc bodySupply ++
          [Assembly.Instr.label (ProcLabel.exit proc.name)] ++
          dispatchCode proc sites dispatchSupply ++ procSeg.post)
        (by
          simpa [procCode, procSegment, bodyCode, dispatchCode,
            List.append_assoc] using procSeg.hAsm)
    simpa using hHere
  have hEntryPcCall :
      Assembly.Program.labelPc
        (callSeg.pre ++ jumpCode ++ returnCode ++ callSeg.post)
        (ProcLabel.entry proc.name) =
          some (Assembly.Program.byteLength procSeg.pre) := by
    rw [← hCallAsm]
    exact hEntryPcAsm
  have hExactProc :
      ExactLabels (procSeg.pre ++ procCode ++ procSeg.post) := by
    exact ExactLabels.cast_asm hProcAsm hExact
  have hCallEntry :=
    Frame.StateRel.source_callEntry_after_prologue_and_jump
      (source := state) (target := target) (tokens := tokens)
      (argc := proc.argc) (retc := proc.retc) (args := args)
      (callerStack := callerStack) (token := token)
      (entryLabel := ProcLabel.entry proc.name)
      (entryDest := Assembly.Program.byteLength procSeg.pre)
      (pre := callSeg.pre) (post := returnCode ++ callSeg.post)
      (by simpa [jumpCode, callJumpCode, List.append_assoc] using hFitsJump)
      (by simpa [CodeSegment.startPc] using hPc) hRel hSplit hArgBound
      (by
        simpa [callSiteCode, callJumpCode, jumpCode, returnCode,
          List.append_assoc]
          using hEntryPcCall)
  refine
    ARunResult.bind_running
      (program := asm)
      (middle := fun afterJump =>
        Frame.StateRel
          ((state.withEVM { state.evm with stack := args }).pushReturn
            callerStack proc.retc)
          afterJump (token :: tokens) ∧
          afterJump.pc = Assembly.Program.pcAfter procSeg.pre)
      ?_ ?_
  · exact
      ARunResult.mono
        (by
          rw [hCallAsm]
          simpa [callJumpCode, jumpCode, returnCode, List.append_assoc]
            using hCallEntry)
        (by
          intro result hResult
          cases result with
          | halted halt =>
              cases hResult
          | running afterJump =>
              rcases hResult with ⟨hRelAfterJump, hPcAfterJump⟩
              exact ⟨hRelAfterJump, by
                simpa [Assembly.Program.pcAfter] using hPcAfterJump⟩)
  · intro afterJump hAfterJump
    have hBodyHalt :=
      halt_body_from_entry
        (program := program) (proc := proc) (bodySupply := bodySupply)
        (dispatchSupply := dispatchSupply) (sites := sites)
        (fuel := fuel) (state := state) (bodyState := bodyState)
        (kind := kind) (args := args) (callerStack := callerStack)
        (target := afterJump) (tokens := tokens) (token := token)
        (pre := procSeg.pre) (post := procSeg.post)
        hBodyPres hBody (by simpa [procCode] using procSeg.hFits)
        hAfterJump.2 hAfterJump.1 hExactProc
    exact
      ARunResult.mono
        (by
          rw [hProcAsm]
          simpa [procCode] using hBodyHalt)
        (by
          intro result hResult
          cases result with
          | running afterBody =>
              cases hResult
          | halted halt =>
              simpa [CompiledOutcomeRel, Outcome.halt] using hResult)

theorem call_stmt_segments {program : Program} {ctx : CompileContext}
    {name : Name} {proc : Proc} {supply : LabelSupply}
    {bodySupply dispatchSupply : LabelSupply}
    {sites : List CallSite} {site : CallSite} {fuel : Nat}
    {state : RunState} {outcome : Outcome}
    {target : EVMState} {tokens : List Word}
    {asm : Assembly.Program}
    (callSeg :
      CodeSegment asm (Stmt.compileFromCtxCore (.call name) ctx supply).code)
    (procSeg :
      CodeSegment asm
        (procSegment program proc bodySupply dispatchSupply sites))
    (hCtxProcs : ctx.procs = program.procs)
    (hLookupCtx : ProcList.lookup? name ctx.procs = some proc)
    (hBodyPres :
      ∀ {bodyFuel : Nat}, bodyFuel < fuel →
        ProcBodyPreservesAtSegment program proc bodySupply dispatchSupply sites
          bodyFuel procSeg.pre procSeg.post)
    (hSite :
      site =
        { procName := name
          token := Stmt.callToken supply
          returnLabel := LabelSupply.label supply 0 })
    (hSiteMem : site ∈ sites)
    (hNoDup : (sites.map CallSite.token).Nodup)
    (hArgc : proc.argc ≤ 16)
    (hRetc : proc.retc < 16)
    (hPc : target.pc = callSeg.startPc)
    (hRel : Frame.StateRel state target tokens)
    (hExact : ExactLabels asm)
    (hEval : Stmt.Eval program fuel (.call name) state outcome) :
    ARunResult asm target
      (fun result =>
        CompiledOutcomeRel asm ctx callSeg.fallthroughPc outcome result
          tokens) := by
  subst site
  have hLookupProgram : ProcList.lookup? name program.procs = some proc := by
    simpa [hCtxProcs] using hLookupCtx
  cases hEval with
  | call_regular hLookupEval hSplit hBody hPop hAttach =>
      rename_i evalFuel evalProc args callerStack stack bodyState returned frame
      have hProcEq : proc = evalProc := by
        have hSome : (some proc : Option Proc) = some evalProc := by
          rw [← hLookupProgram, hLookupEval]
        cases hSome
        rfl
      subst evalProc
      have hArgsLen :
          args.length = proc.argc :=
        Frame.StackFrameFacts.splitArgs?_args_length hSplit
      have hCodeEq :
          (Stmt.compileFromCtxCore (.call name) ctx supply).code =
            callSiteCode proc args (Stmt.callToken supply)
              (LabelSupply.label supply 0) :=
        compile_call_code_eq_callSiteCode
          (ctx := ctx) (supply := supply) (name := name)
          (proc := proc) (args := args) hLookupCtx hArgsLen
      let callSeg' :
          CodeSegment asm
            (callSiteCode proc args (Stmt.callToken supply)
              (LabelSupply.label supply 0)) :=
        CodeSegment.cast_code hCodeEq callSeg
      have hMemFilter :
          { procName := name
            token := Stmt.callToken supply
            returnLabel := LabelSupply.label supply 0 } ∈
            sites.filter (CallSite.forProc proc.name) :=
        callSite_mem_filter_for_lookup
          (procs := ctx.procs) (name := name) (proc := proc)
          (sites := sites)
          (site :=
            { procName := name
              token := Stmt.callToken supply
              returnLabel := LabelSupply.label supply 0 })
          hLookupCtx hSiteMem rfl
      have hNoDupFilter :
          ((sites.filter (CallSite.forProc proc.name)).map
              CallSite.token).Nodup :=
        DispatchPreservation.nodup_tokens_filter
          (sites := sites) (p := CallSite.forProc proc.name) hNoDup
      have hArgBound : args.length ≤ 16 :=
        arg_bound_of_split (proc := proc) hSplit hArgc
      have hRun :=
        call_regular_segments
          (program := program) (ctx := ctx) (proc := proc)
          (bodySupply := bodySupply) (dispatchSupply := dispatchSupply)
          (sites := sites)
          (site :=
            { procName := name
              token := Stmt.callToken supply
              returnLabel := LabelSupply.label supply 0 })
          (fuel := evalFuel) (state := state) (bodyState := bodyState)
          (returned := returned) (args := args)
          (callerStack := callerStack) (stack := stack)
          (frame := frame) (target := target) (tokens := tokens)
          (token := Stmt.callToken supply) (asm := asm)
          callSeg' procSeg (hBodyPres (Nat.lt_succ_self evalFuel)) hSplit
          hBody hPop hAttach
          hMemFilter hNoDupFilter rfl hArgBound hRetc
          (by simpa [callSeg', CodeSegment.startPc] using hPc)
          hRel hExact
      exact
        ARunResult.mono hRun
          (by
            intro result hResult
            simpa [callSeg', CodeSegment.fallthroughPc, hCodeEq]
              using hResult)
  | call_leave hLookupEval hSplit hBody hPop hAttach =>
      rename_i evalFuel evalProc args callerStack stack bodyState returned frame
      have hProcEq : proc = evalProc := by
        have hSome : (some proc : Option Proc) = some evalProc := by
          rw [← hLookupProgram, hLookupEval]
        cases hSome
        rfl
      subst evalProc
      have hArgsLen :
          args.length = proc.argc :=
        Frame.StackFrameFacts.splitArgs?_args_length hSplit
      have hCodeEq :
          (Stmt.compileFromCtxCore (.call name) ctx supply).code =
            callSiteCode proc args (Stmt.callToken supply)
              (LabelSupply.label supply 0) :=
        compile_call_code_eq_callSiteCode
          (ctx := ctx) (supply := supply) (name := name)
          (proc := proc) (args := args) hLookupCtx hArgsLen
      let callSeg' :
          CodeSegment asm
            (callSiteCode proc args (Stmt.callToken supply)
              (LabelSupply.label supply 0)) :=
        CodeSegment.cast_code hCodeEq callSeg
      have hMemFilter :
          { procName := name
            token := Stmt.callToken supply
            returnLabel := LabelSupply.label supply 0 } ∈
            sites.filter (CallSite.forProc proc.name) :=
        callSite_mem_filter_for_lookup
          (procs := ctx.procs) (name := name) (proc := proc)
          (sites := sites)
          (site :=
            { procName := name
              token := Stmt.callToken supply
              returnLabel := LabelSupply.label supply 0 })
          hLookupCtx hSiteMem rfl
      have hNoDupFilter :
          ((sites.filter (CallSite.forProc proc.name)).map
              CallSite.token).Nodup :=
        DispatchPreservation.nodup_tokens_filter
          (sites := sites) (p := CallSite.forProc proc.name) hNoDup
      have hArgBound : args.length ≤ 16 :=
        arg_bound_of_split (proc := proc) hSplit hArgc
      have hRun :=
        call_leave_segments
          (program := program) (ctx := ctx) (proc := proc)
          (bodySupply := bodySupply) (dispatchSupply := dispatchSupply)
          (sites := sites)
          (site :=
            { procName := name
              token := Stmt.callToken supply
              returnLabel := LabelSupply.label supply 0 })
          (fuel := evalFuel) (state := state) (bodyState := bodyState)
          (returned := returned) (args := args)
          (callerStack := callerStack) (stack := stack)
          (frame := frame) (target := target) (tokens := tokens)
          (token := Stmt.callToken supply) (asm := asm)
          callSeg' procSeg (hBodyPres (Nat.lt_succ_self evalFuel)) hSplit
          hBody hPop hAttach
          hMemFilter hNoDupFilter rfl hArgBound hRetc
          (by simpa [callSeg', CodeSegment.startPc] using hPc)
          hRel hExact
      exact
        ARunResult.mono hRun
          (by
            intro result hResult
            simpa [callSeg', CodeSegment.fallthroughPc, hCodeEq]
              using hResult)
  | call_halt hLookupEval hSplit hBody =>
      rename_i evalFuel evalProc args callerStack bodyState kind
      have hProcEq : proc = evalProc := by
        have hSome : (some proc : Option Proc) = some evalProc := by
          rw [← hLookupProgram, hLookupEval]
        cases hSome
        rfl
      subst evalProc
      have hArgsLen :
          args.length = proc.argc :=
        Frame.StackFrameFacts.splitArgs?_args_length hSplit
      have hCodeEq :
          (Stmt.compileFromCtxCore (.call name) ctx supply).code =
            callSiteCode proc args (Stmt.callToken supply)
              (LabelSupply.label supply 0) :=
        compile_call_code_eq_callSiteCode
          (ctx := ctx) (supply := supply) (name := name)
          (proc := proc) (args := args) hLookupCtx hArgsLen
      let callSeg' :
          CodeSegment asm
            (callSiteCode proc args (Stmt.callToken supply)
              (LabelSupply.label supply 0)) :=
        CodeSegment.cast_code hCodeEq callSeg
      have hArgBound : args.length ≤ 16 :=
        arg_bound_of_split (proc := proc) hSplit hArgc
      have hRun :=
        call_halt_segments
          (program := program) (ctx := ctx) (proc := proc)
          (bodySupply := bodySupply) (dispatchSupply := dispatchSupply)
          (sites := sites)
          (site :=
            { procName := name
              token := Stmt.callToken supply
              returnLabel := LabelSupply.label supply 0 })
          (fuel := evalFuel) (state := state) (bodyState := bodyState)
          (kind := kind) (args := args) (callerStack := callerStack)
          (target := target) (tokens := tokens)
          (token := Stmt.callToken supply) (asm := asm)
          callSeg' procSeg (hBodyPres (Nat.lt_succ_self evalFuel)) hSplit
          hBody hArgBound
          (by simpa [callSeg', CodeSegment.startPc] using hPc)
          hRel hExact
      exact
        ARunResult.mono hRun
          (by
            intro result hResult
            simpa [callSeg', CodeSegment.fallthroughPc, hCodeEq]
              using hResult)

structure CallPCFacts {program : Program} {asm : Assembly.Program}
    (proc : Proc) (bodySupply dispatchSupply : LabelSupply)
    (sites : List CallSite) (site : CallSite)
    (callSeg :
      CodeSegment asm
        (callSiteCodeStatic proc site.token site.returnLabel))
    (procSeg :
      CodeSegment asm
        (procSegment program proc bodySupply dispatchSupply sites)) where
  entryPc :
    Assembly.Program.labelPc asm (ProcLabel.entry proc.name) =
      some (Assembly.Program.byteLength procSeg.pre)
  returnPc :
    Assembly.Program.labelPc asm site.returnLabel =
      some
        (Assembly.Program.byteLength
          (callSeg.pre ++ callJumpCodeStatic proc site.token))
  exitPc :
    Assembly.Program.labelPc asm (ProcLabel.exit proc.name) =
      some
        (Assembly.Program.byteLength
          (procSeg.pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)] ++
            bodyCode program proc bodySupply))

theorem callPCFacts_of_segments {program : Program} {asm : Assembly.Program}
    {proc : Proc} {bodySupply dispatchSupply : LabelSupply}
    {sites : List CallSite} {site : CallSite}
    (callSeg :
      CodeSegment asm
        (callSiteCodeStatic proc site.token site.returnLabel))
    (procSeg :
      CodeSegment asm
        (procSegment program proc bodySupply dispatchSupply sites))
    (hExact : ExactLabels asm) :
    CallPCFacts proc bodySupply dispatchSupply sites site callSeg procSeg := by
  let procCode := procSegment program proc bodySupply dispatchSupply sites
  constructor
  · have hHere :=
      hExact.labelPc_at procSeg.pre (ProcLabel.entry proc.name)
        (bodyCode program proc bodySupply ++
          [Assembly.Instr.label (ProcLabel.exit proc.name)] ++
          dispatchCode proc sites dispatchSupply ++ procSeg.post)
        (by
          simpa [procCode, procSegment, bodyCode, dispatchCode,
            List.append_assoc] using procSeg.hAsm)
    simpa using hHere
  · have hHere :=
      hExact.labelPc_at
        (callSeg.pre ++ callJumpCodeStatic proc site.token)
        site.returnLabel callSeg.post
        (by
          simpa [callSiteCodeStatic, List.append_assoc] using callSeg.hAsm)
    simpa using hHere
  · have hHere :=
      hExact.labelPc_at
        (procSeg.pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)] ++
          bodyCode program proc bodySupply)
        (ProcLabel.exit proc.name)
        (dispatchCode proc sites dispatchSupply ++ procSeg.post)
        (by
          simpa [procCode, procSegment, bodyCode, dispatchCode,
            List.append_assoc] using procSeg.hAsm)
    simpa [List.append_assoc] using hHere

/--
Whole-program layout interface needed to verify a compiled call.

This is deliberately about emitted callee placement, not source wellformedness
or caller discovery.  `Program.WF` supplies procedure arity/return-count bounds,
and the recursive compiler proof supplies membership of the current call site in
the global `sites` list from the local `CompileResult.calls`.  `CallLayout`
supplies the remaining concrete facts that a call proof cannot know from the
local call statement alone.
-/
structure CallLayout (program : Program) (asm : Assembly.Program)
    (sites : List CallSite) where
  noDupTokens : (sites.map CallSite.token).Nodup
  procBodySupply :
    ∀ {name : Name} {proc : Proc},
      ProcList.lookup? name program.procs = some proc → LabelSupply
  procDispatchSupply :
    ∀ {name : Name} {proc : Proc},
      ProcList.lookup? name program.procs = some proc → LabelSupply
  procSegment :
    ∀ {name : Name} {proc : Proc}
      (hLookup : ProcList.lookup? name program.procs = some proc),
      CodeSegment asm
        (procSegment program proc (procBodySupply hLookup)
          (procDispatchSupply hLookup) sites)

/--
Whole-program procedure layout for the procedure-aware Structured backend.

`CodeSegment` remains the low-level view into the emitted assembly, while this
record is the intended public layout boundary: it names the global call-site
table, the exact-label proof, per-callee token freshness, and one procedure
layout for every source procedure lookup.
-/
structure ProcLayout (program : Program) (asm : Assembly.Program)
    (sites : List CallSite) (proc : Proc) where
  bodySupply : LabelSupply
  dispatchSupply : LabelSupply
  bodyCalls :
    CallsIncluded
      (Block.compileFromCtx proc.body (bodyCtx program proc) bodySupply).calls
      sites
  segment :
    CodeSegment asm
      (procSegment program proc bodySupply dispatchSupply sites)

structure ProgramLayout (program : Program) where
  asm : Assembly.Program
  sites : List CallSite
  exactLabels : ExactLabels asm
  noDupTokens : (sites.map CallSite.token).Nodup
  tokenNoDupForProc :
    ∀ proc : Proc,
      ((sites.filter (CallSite.forProc proc.name)).map CallSite.token).Nodup
  procLayout :
    ∀ {name : Name} {proc : Proc},
      ProcList.lookup? name program.procs = some proc →
        ProcLayout program asm sites proc

namespace ProgramLayout

def toCallLayout {program : Program} (layout : ProgramLayout program) :
    CallLayout program layout.asm layout.sites where
  noDupTokens := layout.noDupTokens
  procBodySupply := fun hLookup =>
    (layout.procLayout hLookup).bodySupply
  procDispatchSupply := fun hLookup =>
    (layout.procLayout hLookup).dispatchSupply
  procSegment := fun hLookup =>
    (layout.procLayout hLookup).segment

def ofCallLayout {program : Program} {asm : Assembly.Program}
    {sites : List CallSite}
    (layout : CallLayout program asm sites)
    (hExact : ExactLabels asm)
    (hBodyCalls :
      ∀ {name : Name} {proc : Proc}
        (hLookup : ProcList.lookup? name program.procs = some proc),
        CallsIncluded
          (Block.compileFromCtx proc.body (bodyCtx program proc)
            (layout.procBodySupply hLookup)).calls
          sites) :
    ProgramLayout program where
  asm := asm
  sites := sites
  exactLabels := hExact
  noDupTokens := layout.noDupTokens
  tokenNoDupForProc := fun proc =>
    DispatchPreservation.nodup_tokens_filter
      (sites := sites) (p := CallSite.forProc proc.name)
      layout.noDupTokens
  procLayout := fun hLookup =>
    { bodySupply := layout.procBodySupply hLookup
      dispatchSupply := layout.procDispatchSupply hLookup
      bodyCalls := hBodyCalls hLookup
      segment := layout.procSegment hLookup }

end ProgramLayout

noncomputable def procLayout_of_procBodies_emit {program : Program}
    {procs : List Proc} {sites : List CallSite}
    {bodySupply dispatchSupply : LabelSupply}
    {name : Name} {proc : Proc}
    (segment :
      CodeSegment program.compile
        (CompiledProcBodies.emit
          (ProcBodies.compile program.procs procs bodySupply).1 sites
          dispatchSupply).code)
    (hCalls :
      CallsIncluded
        (ProcBodies.compile program.procs procs bodySupply).2.2 sites)
    (hLookup : ProcList.lookup? name procs = some proc) :
    ProcLayout program program.compile sites proc := by
  induction procs generalizing bodySupply dispatchSupply with
  | nil =>
      simp [ProcList.lookup?] at hLookup
  | cons head rest ih =>
      by_cases hName : head.name = name
      · simp [ProcList.lookup?, hName] at hLookup
        cases hLookup
        let compiledHead := Proc.compileBody program.procs proc bodySupply
        let compiledRest :=
          ProcBodies.compile program.procs rest compiledHead.next
        let dispatch := Dispatch.forProc proc sites dispatchSupply
        let emittedRest :=
          CompiledProcBodies.emit compiledRest.1 sites dispatch.next
        have hEmitCode :
            (CompiledProcBodies.emit
              (ProcBodies.compile program.procs (proc :: rest) bodySupply).1
              sites dispatchSupply).code =
              (compiledHead.code ++ dispatch.code) ++ emittedRest.code := by
          simp [ProcBodies.compile, CompiledProcBodies.emit, Proc.compileBody,
            compiledHead, compiledRest, dispatch, emittedRest,
            List.append_assoc]
        let appendSeg :
            CodeSegment program.compile
              ((compiledHead.code ++ dispatch.code) ++ emittedRest.code) :=
          CodeSegment.cast_code hEmitCode segment
        let headSeg :
            CodeSegment program.compile (compiledHead.code ++ dispatch.code) :=
          CodeSegment.left appendSeg
        let procSeg :
            CodeSegment program.compile
              (procSegment program proc bodySupply dispatchSupply sites) :=
          CodeSegment.cast_code
            (by
              simpa [compiledHead, dispatch] using
                (procSegment_eq_compileBody_dispatch
                  (program := program) (proc := proc)
                  (bodySupply := bodySupply)
                  (dispatchSupply := dispatchSupply)
                  (sites := sites)).symm)
            headSeg
        refine
          { bodySupply := bodySupply
            dispatchSupply := dispatchSupply
            bodyCalls := ?_
            segment := procSeg }
        have hHeadCalls :
            CallsIncluded (Proc.compileBody program.procs proc bodySupply).calls
              sites :=
          CallsIncluded.trans
            (procBodies_head_calls_included program.procs proc rest bodySupply)
            hCalls
        simpa [Proc.compileBody, bodyCtx] using hHeadCalls
      · simp [ProcList.lookup?, hName] at hLookup
        let compiledHead := Proc.compileBody program.procs head bodySupply
        let compiledRest :=
          ProcBodies.compile program.procs rest compiledHead.next
        let dispatch := Dispatch.forProc head sites dispatchSupply
        let emittedRest :=
          CompiledProcBodies.emit compiledRest.1 sites dispatch.next
        have hEmitCode :
            (CompiledProcBodies.emit
              (ProcBodies.compile program.procs (head :: rest) bodySupply).1
              sites dispatchSupply).code =
              (compiledHead.code ++ dispatch.code) ++ emittedRest.code := by
          simp [ProcBodies.compile, CompiledProcBodies.emit, Proc.compileBody,
            compiledHead, compiledRest, dispatch, emittedRest,
            List.append_assoc]
        let appendSeg :
            CodeSegment program.compile
              ((compiledHead.code ++ dispatch.code) ++ emittedRest.code) :=
          CodeSegment.cast_code hEmitCode segment
        let restSeg : CodeSegment program.compile emittedRest.code :=
          CodeSegment.right appendSeg
        have hTailCalls :
            CallsIncluded
              (ProcBodies.compile program.procs rest compiledHead.next).2.2
              sites :=
          CallsIncluded.trans
            (procBodies_tail_calls_included program.procs head rest bodySupply)
            hCalls
        exact
          ih (bodySupply := compiledHead.next)
            (dispatchSupply := dispatch.next)
            (segment := by
              simpa [compiledRest, emittedRest] using restSeg)
            hTailCalls hLookup

structure CallSiteLayout {program : Program}
    (layout : ProgramLayout program) (proc : Proc) (site : CallSite) where
  callSeg :
    CodeSegment layout.asm
      (callSiteCodeStatic proc site.token site.returnLabel)
  procLayout : ProcLayout program layout.asm layout.sites proc
  siteMem : site ∈ layout.sites
  siteForProc : site.procName = proc.name
  pcFacts :
    CallPCFacts proc procLayout.bodySupply procLayout.dispatchSupply
      layout.sites site callSeg procLayout.segment

namespace CallSiteLayout

def ofSegments {program : Program} (layout : ProgramLayout program)
    {name : Name} {proc : Proc} {site : CallSite}
    (hLookup : ProcList.lookup? name program.procs = some proc)
    (hSiteMem : site ∈ layout.sites)
    (hSiteForProc : site.procName = proc.name)
    (callSeg :
      CodeSegment layout.asm
        (callSiteCodeStatic proc site.token site.returnLabel)) :
    CallSiteLayout layout proc site :=
  let procLayout := layout.procLayout hLookup
  { callSeg := callSeg
    procLayout := procLayout
    siteMem := hSiteMem
    siteForProc := hSiteForProc
    pcFacts :=
      callPCFacts_of_segments
        (program := program) (asm := layout.asm) (proc := proc)
        (bodySupply := procLayout.bodySupply)
        (dispatchSupply := procLayout.dispatchSupply)
        (sites := layout.sites) (site := site)
        callSeg procLayout.segment layout.exactLabels }

end CallSiteLayout

namespace StaticFrame

def FrameOk {program : Program} (layout : ProgramLayout program)
    (frame : Frame.StaticReturnFrame) : Prop :=
  ∃ (proc : Proc) (site : CallSite),
    ProcList.lookup? frame.procName program.procs = some proc ∧
      site ∈ layout.sites ∧
      site.procName = frame.procName ∧
      site.token = frame.token ∧
      site.returnLabel = frame.returnLabel ∧
      proc.retc = frame.retc

structure StateRel {program : Program} (layout : ProgramLayout program)
    (source : RunState) (target : EVMState)
    (frames : List Frame.StaticReturnFrame) (tokens : List Word) : Prop where
  toFrame : Frame.StateRel source target tokens
  contextRel : Frame.ReturnContextRel program frames source.returns tokens
  framesOk : ∀ frame, frame ∈ frames → FrameOk layout frame

namespace StateRel

theorem to_frame {program : Program} {layout : ProgramLayout program}
    {source : RunState} {target : EVMState}
    {frames : List Frame.StaticReturnFrame} {tokens : List Word}
    (hRel : StateRel layout source target frames tokens) :
    Frame.StateRel source target tokens :=
  hRel.toFrame

theorem initial {program : Program} (layout : ProgramLayout program)
    (state : EVMState) :
    StateRel layout (RunState.initial state) state [] [] := by
  exact
    { toFrame := Frame.stateRel_initial state
      contextRel := Frame.ReturnContextRel.nil
      framesOk := by
        intro frame hMem
        cases hMem }

end StateRel

end StaticFrame

theorem call_stmt_of_layout {program : Program} {ctx : CompileContext}
    {name : Name} {proc : Proc} {supply : LabelSupply}
    {sites : List CallSite} {fuel : Nat}
    {state : RunState} {outcome : Outcome}
    {target : EVMState} {tokens : List Word}
    {asm : Assembly.Program}
    (layout : CallLayout program asm sites)
    (hProgramWF : program.WF)
    (hCalls :
      CallsIncluded (Stmt.compileFromCtxCore (.call name) ctx supply).calls
        sites)
    (callSeg :
      CodeSegment asm (Stmt.compileFromCtxCore (.call name) ctx supply).code)
    (hCtxProcs : ctx.procs = program.procs)
    (hLookupCtx : ProcList.lookup? name ctx.procs = some proc)
    (hBodyPres :
      BlockPreserves program (bodyCtx program proc)
        (layout.procBodySupply (by simpa [hCtxProcs] using hLookupCtx))
        proc.body)
    (hPc : target.pc = callSeg.startPc)
    (hRel : Frame.StateRel state target tokens)
    (hExact : ExactLabels asm)
    (hEval : Stmt.Eval program fuel (.call name) state outcome) :
    ARunResult asm target
      (fun result =>
        CompiledOutcomeRel asm ctx callSeg.fallthroughPc outcome result
          tokens) := by
  have hLookupProgram : ProcList.lookup? name program.procs = some proc := by
    simpa [hCtxProcs] using hLookupCtx
  have hProcWF : Proc.WF proc :=
    Program.procWF_of_lookup? hProgramWF hLookupProgram
  exact
    call_stmt_segments
      (program := program) (ctx := ctx) (name := name) (proc := proc)
      (supply := supply) (bodySupply := layout.procBodySupply hLookupProgram)
      (dispatchSupply := layout.procDispatchSupply hLookupProgram)
      (sites := sites)
      (site :=
        { procName := name
          token := Stmt.callToken supply
          returnLabel := LabelSupply.label supply 0 })
      (fuel := fuel) (state := state) (outcome := outcome)
      (target := target) (tokens := tokens) (asm := asm)
      callSeg (layout.procSegment hLookupProgram)
      hCtxProcs hLookupCtx
      (fun {bodyFuel} _hLt =>
        procBodyPreservesAtSegment_of_local
          (program := program) (proc := proc)
          (bodySupply := layout.procBodySupply hLookupProgram)
          (dispatchSupply := layout.procDispatchSupply hLookupProgram)
          (sites := sites) (fuel := bodyFuel)
          (pre := (layout.procSegment hLookupProgram).pre)
          (post := (layout.procSegment hLookupProgram).post)
          (blockPreservesAtFuel_of_preserves hBodyPres)
          (layout.procSegment hLookupProgram).hFits
          (ExactLabels.cast_asm
            (layout.procSegment hLookupProgram).hAsm hExact))
      rfl
      (generated_callSite_mem_of_included
        (ctx := ctx) (supply := supply) (name := name) (proc := proc)
        (sites := sites) hLookupCtx hCalls)
      layout.noDupTokens hProcWF.1 hProcWF.2.1 hPc hRel hExact hEval

theorem call_stmt_of_programLayout {program : Program} {ctx : CompileContext}
    {name : Name} {proc : Proc} {supply : LabelSupply}
    {fuel : Nat} {state : RunState} {outcome : Outcome}
    {target : EVMState} {tokens : List Word}
    (layout : ProgramLayout program)
    (hProgramWF : program.WF)
    (hCalls :
      CallsIncluded (Stmt.compileFromCtxCore (.call name) ctx supply).calls
        layout.sites)
    (callSeg :
      CodeSegment layout.asm
        (Stmt.compileFromCtxCore (.call name) ctx supply).code)
    (hCtxProcs : ctx.procs = program.procs)
    (hLookupCtx : ProcList.lookup? name ctx.procs = some proc)
    (hBodyPres :
      BlockPreserves program (bodyCtx program proc)
        (layout.procLayout (by simpa [hCtxProcs] using hLookupCtx)).bodySupply
        proc.body)
    (hPc : target.pc = callSeg.startPc)
    (hRel : Frame.StateRel state target tokens)
    (hEval : Stmt.Eval program fuel (.call name) state outcome) :
    ARunResult layout.asm target
      (fun result =>
        CompiledOutcomeRel layout.asm ctx callSeg.fallthroughPc outcome result
          tokens) := by
  exact
    call_stmt_of_layout
      (program := program) (ctx := ctx) (name := name) (proc := proc)
      (supply := supply) (sites := layout.sites) (fuel := fuel)
      (state := state) (outcome := outcome)
      (target := target) (tokens := tokens) (asm := layout.asm)
      layout.toCallLayout hProgramWF hCalls callSeg hCtxProcs hLookupCtx
      hBodyPres hPc hRel layout.exactLabels hEval

theorem call_stmt_of_layout_eval {program : Program} {ctx : CompileContext}
    {name : Name} {supply : LabelSupply}
    {sites : List CallSite} {fuel : Nat}
    {state : RunState} {outcome : Outcome}
    {target : EVMState} {tokens : List Word}
    {asm : Assembly.Program}
    (layout : CallLayout program asm sites)
    (hProgramWF : program.WF)
    (hCtxProcs : ctx.procs = program.procs)
    (hCalls :
      CallsIncluded (Stmt.compileFromCtxCore (.call name) ctx supply).calls
        sites)
    (callSeg :
      CodeSegment asm (Stmt.compileFromCtxCore (.call name) ctx supply).code)
    (hPc : target.pc = callSeg.startPc)
    (hRel : Frame.StateRel state target tokens)
    (hExact : ExactLabels asm)
    (hProcPreserves :
      ∀ {name : Name} {proc : Proc}
        (hLookup : ProcList.lookup? name program.procs = some proc),
        BlockPreserves program (bodyCtx program proc)
          (layout.procBodySupply hLookup) proc.body)
    (hEval : Stmt.Eval program fuel (.call name) state outcome) :
    ARunResult asm target
      (fun result =>
        CompiledOutcomeRel asm ctx callSeg.fallthroughPc outcome result
          tokens) := by
  cases hEval with
  | call_regular hLookup hSplit hBody hPop hAttach =>
      rename_i evalFuel evalProc args callerStack stack bodyState returned frame
      have hLookupCtx : ProcList.lookup? name ctx.procs = some evalProc := by
        simpa [hCtxProcs] using hLookup
      exact
        call_stmt_of_layout
          (program := program) (ctx := ctx) (name := name)
          (proc := evalProc)
          (supply := supply) (sites := sites) (fuel := evalFuel + 1)
          (state := state)
          (outcome :=
            Outcome.regular
              (returned.withEVM { bodyState.evm with stack := stack }))
          (target := target) (tokens := tokens) (asm := asm)
          layout hProgramWF hCalls callSeg hCtxProcs hLookupCtx
          (hProcPreserves hLookup) hPc hRel hExact
          (Stmt.Eval.call_regular hLookup hSplit hBody hPop hAttach)
  | call_leave hLookup hSplit hBody hPop hAttach =>
      rename_i evalFuel evalProc args callerStack stack bodyState returned frame
      have hLookupCtx : ProcList.lookup? name ctx.procs = some evalProc := by
        simpa [hCtxProcs] using hLookup
      exact
        call_stmt_of_layout
          (program := program) (ctx := ctx) (name := name)
          (proc := evalProc)
          (supply := supply) (sites := sites) (fuel := evalFuel + 1)
          (state := state)
          (outcome :=
            Outcome.regular
              (returned.withEVM { bodyState.evm with stack := stack }))
          (target := target) (tokens := tokens) (asm := asm)
          layout hProgramWF hCalls callSeg hCtxProcs hLookupCtx
          (hProcPreserves hLookup) hPc hRel hExact
          (Stmt.Eval.call_leave hLookup hSplit hBody hPop hAttach)
  | call_halt hLookup hSplit hBody =>
      rename_i evalFuel evalProc args callerStack bodyState kind
      have hLookupCtx : ProcList.lookup? name ctx.procs = some evalProc := by
        simpa [hCtxProcs] using hLookup
      exact
        call_stmt_of_layout
          (program := program) (ctx := ctx) (name := name)
          (proc := evalProc)
          (supply := supply) (sites := sites) (fuel := evalFuel + 1)
          (state := state) (outcome := Outcome.halt kind bodyState)
          (target := target) (tokens := tokens) (asm := asm)
          layout hProgramWF hCalls callSeg hCtxProcs hLookupCtx
          (hProcPreserves hLookup) hPc hRel hExact
          (Stmt.Eval.call_halt hLookup hSplit hBody)

def StmtPreservesIn {program : Program} {asm : Assembly.Program}
    {sites : List CallSite} (_layout : CallLayout program asm sites)
    (ctx : CompileContext) (supply : LabelSupply) (stmt : Stmt) : Prop :=
  ∀ {fuel : Nat} {source : RunState} {outcome : Outcome}
    {target : EVMState} {tokens : List Word},
    program.WF →
      ctx.procs = program.procs →
      CallsIncluded (Stmt.compileFromCtxCore stmt ctx supply).calls sites →
      ContextLabelsResolve asm ctx →
      ExactLabels asm →
      (segment :
        CodeSegment asm (Stmt.compileFromCtxCore stmt ctx supply).code) →
      target.pc = segment.startPc →
      Frame.StateRel source target tokens →
      Stmt.Eval program fuel stmt source outcome →
      ARunResult asm target
        (fun result =>
          CompiledOutcomeRel asm ctx segment.fallthroughPc outcome result
            tokens)

def BlockPreservesIn {program : Program} {asm : Assembly.Program}
    {sites : List CallSite} (_layout : CallLayout program asm sites)
    (ctx : CompileContext) (supply : LabelSupply) (block : Block) : Prop :=
  ∀ {fuel : Nat} {source : RunState} {outcome : Outcome}
    {target : EVMState} {tokens : List Word},
    program.WF →
      ctx.procs = program.procs →
      CallsIncluded (Block.compileFromCtx block ctx supply).calls sites →
      ContextLabelsResolve asm ctx →
      ExactLabels asm →
      (segment : CodeSegment asm (Block.compileFromCtx block ctx supply).code) →
      target.pc = segment.startPc →
      Frame.StateRel source target tokens →
      Block.Eval program fuel block source outcome →
      ARunResult asm target
        (fun result =>
          CompiledOutcomeRel asm ctx segment.fallthroughPc outcome result
            tokens)

def StmtPreservesInProgramLayout {program : Program}
    (layout : ProgramLayout program)
    (ctx : CompileContext) (supply : LabelSupply) (stmt : Stmt) : Prop :=
  ∀ {fuel : Nat} {source : RunState} {outcome : Outcome}
    {target : EVMState} {tokens : List Word},
    program.WF →
      ctx.procs = program.procs →
      CallsIncluded (Stmt.compileFromCtxCore stmt ctx supply).calls
        layout.sites →
      ContextLabelsResolve layout.asm ctx →
      (segment :
        CodeSegment layout.asm
          (Stmt.compileFromCtxCore stmt ctx supply).code) →
      target.pc = segment.startPc →
      Frame.StateRel source target tokens →
      Stmt.Eval program fuel stmt source outcome →
      ARunResult layout.asm target
        (fun result =>
          CompiledOutcomeRel layout.asm ctx segment.fallthroughPc outcome result
            tokens)

def BlockPreservesInProgramLayout {program : Program}
    (layout : ProgramLayout program)
    (ctx : CompileContext) (supply : LabelSupply) (block : Block) : Prop :=
  ∀ {fuel : Nat} {source : RunState} {outcome : Outcome}
    {target : EVMState} {tokens : List Word},
    program.WF →
      ctx.procs = program.procs →
      CallsIncluded (Block.compileFromCtx block ctx supply).calls
        layout.sites →
      ContextLabelsResolve layout.asm ctx →
      (segment :
        CodeSegment layout.asm (Block.compileFromCtx block ctx supply).code) →
      target.pc = segment.startPc →
      Frame.StateRel source target tokens →
      Block.Eval program fuel block source outcome →
      ARunResult layout.asm target
        (fun result =>
          CompiledOutcomeRel layout.asm ctx segment.fallthroughPc outcome result
            tokens)

/--
Fixed-source-fuel block preservation.

This is the small interface used by layout helpers that run exactly one selected
body.  Unbounded preservation and fuel-bounded preservation both project to this
shape, which keeps the bytecode/layout proof shared instead of duplicating it
for every bounded theorem.
-/
def BlockPreservesInProgramLayoutAtFuel {program : Program}
    (layout : ProgramLayout program) (fuel : Nat)
    (ctx : CompileContext) (supply : LabelSupply) (block : Block) : Prop :=
  ∀ {source : RunState} {outcome : Outcome}
    {target : EVMState} {tokens : List Word},
    program.WF →
      ctx.procs = program.procs →
      CallsIncluded (Block.compileFromCtx block ctx supply).calls
        layout.sites →
      ContextLabelsResolve layout.asm ctx →
      (segment :
        CodeSegment layout.asm (Block.compileFromCtx block ctx supply).code) →
      target.pc = segment.startPc →
      Frame.StateRel source target tokens →
      Block.Eval program fuel block source outcome →
      ARunResult layout.asm target
        (fun result =>
          CompiledOutcomeRel layout.asm ctx segment.fallthroughPc outcome result
            tokens)

theorem procBodyPreservesAtSegment_of_programLayout {program : Program}
    {layout : ProgramLayout program} {proc : Proc}
    {bodySupply dispatchSupply : LabelSupply} {fuel : Nat}
    (procSeg :
      CodeSegment layout.asm
        (procSegment program proc bodySupply dispatchSupply layout.sites))
    (hBodyPres :
      BlockPreservesInProgramLayoutAtFuel layout fuel
        (bodyCtx program proc) bodySupply proc.body)
    (hProgramWF : program.WF)
    (hBodyCalls :
      CallsIncluded
        (Block.compileFromCtx proc.body (bodyCtx program proc)
          bodySupply).calls
        layout.sites) :
    ProcBodyPreservesAtSegment program proc bodySupply dispatchSupply
      layout.sites fuel procSeg.pre procSeg.post := by
  intro source outcome target tokens hPc hRel hEval
  let ctx := bodyCtx program proc
  let bcode := bodyCode program proc bodySupply
  let dcode := dispatchCode proc layout.sites dispatchSupply
  let exitLabel := ProcLabel.exit proc.name
  have hFitsAfterEntry :
      AssemblyProgram.PCFitsFrom
        (procSeg.pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)])
        (bcode ++ ([Assembly.Instr.label exitLabel] ++ dcode)) := by
    exact
      AssemblyProgram.PCFitsFrom.right
        (pre := procSeg.pre)
        (first := [Assembly.Instr.label (ProcLabel.entry proc.name)])
        (second := bcode ++ ([Assembly.Instr.label exitLabel] ++ dcode))
        (by
          simpa [procSegment, bcode, dcode, bodyCode, dispatchCode, exitLabel,
            List.append_assoc] using procSeg.hFits)
  have hFitsBody :
      AssemblyProgram.PCFitsFrom
        (procSeg.pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)])
        bcode := by
    exact
      AssemblyProgram.PCFitsFrom.left
        (pre := procSeg.pre ++
          [Assembly.Instr.label (ProcLabel.entry proc.name)])
        (first := bcode)
        (second := [Assembly.Instr.label exitLabel] ++ dcode)
        hFitsAfterEntry
  have hExitPc :
      Assembly.Program.labelPc layout.asm exitLabel =
        some
          (Assembly.Program.byteLength
            ((procSeg.pre ++
              [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++
                bcode)) := by
    have hHere :=
      layout.exactLabels.labelPc_at
        ((procSeg.pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++
          bcode)
        exitLabel
        (dcode ++ procSeg.post)
        (by
          simpa [procSegment, bcode, dcode, bodyCode, dispatchCode, exitLabel,
            List.append_assoc] using procSeg.hAsm)
    simpa [bcode, dcode, exitLabel] using hHere
  have hResolveBody : ContextLabelsResolve layout.asm ctx := by
    refine ⟨?_, ?_, ?_⟩
    · intro label h
      simp [ctx, bodyCtx] at h
    · intro label h
      simp [ctx, bodyCtx] at h
    · intro label h
      simp [ctx, bodyCtx] at h
      cases h
      refine ⟨Assembly.Program.byteLength
        ((procSeg.pre ++
          [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++ bcode), ?_⟩
      simpa [exitLabel] using hExitPc
  let bodySeg : CodeSegment layout.asm bcode :=
    { pre := procSeg.pre ++ [Assembly.Instr.label (ProcLabel.entry proc.name)]
      post := [Assembly.Instr.label exitLabel] ++ dcode ++ procSeg.post
      hAsm := by
        simpa [procSegment, bcode, dcode, bodyCode, dispatchCode, exitLabel,
          List.append_assoc] using procSeg.hAsm
      hFits := by
        simpa [bodyCode, ctx, bcode] using hFitsBody }
  have hRun :=
    hBodyPres (source := source) (outcome := outcome)
      (target := target) (tokens := tokens)
      hProgramWF (by simp [ctx, bodyCtx])
      (by simpa [ctx, bcode, bodyCode] using hBodyCalls)
      hResolveBody bodySeg
      (by simpa [bodySeg, CodeSegment.startPc] using hPc)
      hRel hEval
  exact
    ARunResult.cast_program_mono procSeg.hAsm hRun
      (by
        intro result hResult
        have hExitPcSegment :
            Assembly.Program.labelPc
              (procSeg.pre ++
                procSegment program proc bodySupply dispatchSupply
                  layout.sites ++ procSeg.post)
              exitLabel =
                some
                  (Assembly.Program.byteLength
                    ((procSeg.pre ++
                      [Assembly.Instr.label (ProcLabel.entry proc.name)]) ++
                        bcode)) := by
          rw [← procSeg.hAsm]
          exact hExitPc
        cases outcome with
        | mk outState mode =>
            cases mode with
            | regular =>
                cases result with
                | running targetState =>
                    simpa [CompiledOutcomeRel, bodySeg,
                      CodeSegment.fallthroughPc, bodyCode, bcode,
                      List.append_assoc] using hResult
                | halted halt =>
                    simpa [CompiledOutcomeRel] using hResult
            | brk =>
                cases result with
                | running targetState =>
                    simpa [CompiledOutcomeRel, ctx, bodyCtx] using hResult
                | halted halt =>
                    simpa [CompiledOutcomeRel] using hResult
            | cont =>
                cases result with
                | running targetState =>
                    simpa [CompiledOutcomeRel, ctx, bodyCtx] using hResult
                | halted halt =>
                    simpa [CompiledOutcomeRel] using hResult
            | leave =>
                cases result with
                | halted halt =>
                    simpa [CompiledOutcomeRel] using hResult
                | running targetState =>
                    rcases hResult with
                      ⟨label, dest, hCtxLeave, hLabelPc, hRelResult,
                        hPcResult⟩
                    simp [ctx, bodyCtx] at hCtxLeave
                    subst label
                    have hDest :
                        dest =
                          Assembly.Program.byteLength
                            ((procSeg.pre ++
                              [Assembly.Instr.label
                                (ProcLabel.entry proc.name)]) ++ bcode) := by
                      rw [hExitPc] at hLabelPc
                      cases hLabelPc
                      rfl
                    subst dest
                    exact
                      ⟨exitLabel,
                        Assembly.Program.byteLength
                          ((procSeg.pre ++
                            [Assembly.Instr.label
                              (ProcLabel.entry proc.name)]) ++ bcode),
                        by simp [ctx, bodyCtx, exitLabel],
                        hExitPcSegment, hRelResult, hPcResult⟩
            | halt kind =>
                cases result with
                | running targetState =>
                    simpa [CompiledOutcomeRel] using hResult
                | halted halt =>
                    simpa [CompiledOutcomeRel] using hResult)

namespace ProgramLayout

def MainPreserves {program : Program}
    (layout : ProgramLayout program) : Prop :=
  BlockPreservesInProgramLayout layout
    (CompiledProgram.mainCtx program) 0 program.body

def ProcPreserves {program : Program}
    (layout : ProgramLayout program) : Prop :=
  ∀ {name : Name} {proc : Proc}
    (hLookup : ProcList.lookup? name program.procs = some proc),
    BlockPreservesInProgramLayout layout (bodyCtx program proc)
      (layout.procLayout hLookup).bodySupply proc.body

def ProcPreservesLocal {program : Program}
    (layout : ProgramLayout program) : Prop :=
  ∀ {name : Name} {proc : Proc}
    (hLookup : ProcList.lookup? name program.procs = some proc),
    BlockPreserves program (bodyCtx program proc)
      (layout.procLayout hLookup).bodySupply proc.body

end ProgramLayout

theorem stmt_preserves_in_of_local {program : Program}
    {asm : Assembly.Program} {sites : List CallSite}
    {layout : CallLayout program asm sites}
    {ctx : CompileContext} {supply : LabelSupply} {stmt : Stmt}
    (hLocal : StmtPreserves program ctx supply stmt) :
    StmtPreservesIn layout ctx supply stmt := by
  intro fuel source outcome target tokens _hProgramWF _hCtxProcs _hCalls
    hResolve hExact segment hPc hRel hEval
  have hResolveSeg :
      ContextLabelsResolve
        (segment.pre ++ (Stmt.compileFromCtxCore stmt ctx supply).code ++
          segment.post) ctx :=
    ContextLabelsResolve.cast_asm segment.hAsm hResolve
  have hExactSeg :
      ExactLabels
        (segment.pre ++ (Stmt.compileFromCtxCore stmt ctx supply).code ++
          segment.post) :=
    ExactLabels.cast_asm segment.hAsm hExact
  have hRun :=
    hLocal (pre := segment.pre) (post := segment.post) (fuel := fuel)
      (source := source) (outcome := outcome) (target := target)
      (tokens := tokens) segment.hFits hResolveSeg hExactSeg
      (by simpa [CodeSegment.startPc] using hPc) hRel hEval
  rcases hRun with ⟨runFuel, result, hRunEq, hPost⟩
  refine ⟨runFuel, result, ?_, ?_⟩
  · rw [segment.hAsm]
    exact hRunEq
  · simpa [segment.hAsm, CodeSegment.fallthroughPc] using hPost

theorem block_preserves_in_of_local {program : Program}
    {asm : Assembly.Program} {sites : List CallSite}
    {layout : CallLayout program asm sites}
    {ctx : CompileContext} {supply : LabelSupply} {block : Block}
    (hLocal : BlockPreserves program ctx supply block) :
    BlockPreservesIn layout ctx supply block := by
  intro fuel source outcome target tokens _hProgramWF _hCtxProcs _hCalls
    hResolve hExact segment hPc hRel hEval
  have hResolveSeg :
      ContextLabelsResolve
        (segment.pre ++ (Block.compileFromCtx block ctx supply).code ++
          segment.post) ctx :=
    ContextLabelsResolve.cast_asm segment.hAsm hResolve
  have hExactSeg :
      ExactLabels
        (segment.pre ++ (Block.compileFromCtx block ctx supply).code ++
          segment.post) :=
    ExactLabels.cast_asm segment.hAsm hExact
  have hRun :=
    hLocal (pre := segment.pre) (post := segment.post) (fuel := fuel)
      (source := source) (outcome := outcome) (target := target)
      (tokens := tokens) segment.hFits hResolveSeg hExactSeg
      (by simpa [CodeSegment.startPc] using hPc) hRel hEval
  rcases hRun with ⟨runFuel, result, hRunEq, hPost⟩
  refine ⟨runFuel, result, ?_, ?_⟩
  · rw [segment.hAsm]
    exact hRunEq
  · simpa [segment.hAsm, CodeSegment.fallthroughPc] using hPost

theorem stmt_preserves_in_programLayout_of_local {program : Program}
    {layout : ProgramLayout program}
    {ctx : CompileContext} {supply : LabelSupply} {stmt : Stmt}
    (hLocal : StmtPreserves program ctx supply stmt) :
    StmtPreservesInProgramLayout layout ctx supply stmt := by
  intro fuel source outcome target tokens hProgramWF hCtxProcs hCalls
    hResolve segment hPc hRel hEval
  exact
    stmt_preserves_in_of_local
      (program := program) (asm := layout.asm) (sites := layout.sites)
      (layout := layout.toCallLayout)
      (ctx := ctx) (supply := supply) (stmt := stmt) hLocal
      hProgramWF hCtxProcs hCalls hResolve layout.exactLabels segment hPc
      hRel hEval

theorem block_preserves_in_programLayout_of_local {program : Program}
    {layout : ProgramLayout program}
    {ctx : CompileContext} {supply : LabelSupply} {block : Block}
    (hLocal : BlockPreserves program ctx supply block) :
    BlockPreservesInProgramLayout layout ctx supply block := by
  intro fuel source outcome target tokens hProgramWF hCtxProcs hCalls
    hResolve segment hPc hRel hEval
  exact
    block_preserves_in_of_local
      (program := program) (asm := layout.asm) (sites := layout.sites)
      (layout := layout.toCallLayout)
      (ctx := ctx) (supply := supply) (block := block) hLocal
      hProgramWF hCtxProcs hCalls hResolve layout.exactLabels segment hPc
      hRel hEval

theorem blockPreservesInProgramLayoutAtFuel_of_preserves {program : Program}
    {layout : ProgramLayout program} {fuel : Nat}
    {ctx : CompileContext} {supply : LabelSupply} {block : Block}
    (hPreserves :
      BlockPreservesInProgramLayout layout ctx supply block) :
    BlockPreservesInProgramLayoutAtFuel layout fuel ctx supply block := by
  intro source outcome target tokens hProgramWF hCtxProcs hCalls hResolve
    segment hPc hRel hEval
  exact
    hPreserves (fuel := fuel) (source := source) (outcome := outcome)
      (target := target) (tokens := tokens)
      hProgramWF hCtxProcs hCalls hResolve segment hPc hRel hEval

namespace ProgramLayout


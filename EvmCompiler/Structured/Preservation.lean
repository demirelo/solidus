                          (LabelSupply.label supply 0) supply
                          (LabelSupply.next supply) 0).next)
                      (hDefaultWF defaultBody hDefault)
                      (hDefaultRunner defaultBody hDefault)
                      (hDefaultFrame defaultBody hDefault)
                      (hDefaultTerminal defaultBody hDefault)
                      hCtx
            exact
              (ProcedurePreservation.preserves_switch_in_programLayout
                hScrutineeRunner hScrutineeFrame hCasesPreserves
                hDefaultPreserves :
                ProcedurePreservation.StmtPreservesInProgramLayout layout ctx
                  supply (.switch scrutinee cases defaultBody))
    | for_ hInitWF hPostWF hBodyWF =>
        rename_i init post body cond
        cases hRunner with
        | for_ hInitRunner hCondRunner hPostRunner hBodyRunner =>
        cases hFrame with
        | for_ hInitFrame hCondFrame hPostFrame hBodyFrame =>
        cases hTerminal with
        | for_ hInitTerminal hPostTerminal hBodyTerminal =>
            let loopOuterCtx : CompileContext :=
              { ctx with breakLabel? := none, continueLabel? := none }
            let bodyCtx : CompileContext :=
              { ctx with
                breakLabel? := some (LabelSupply.label supply 3)
                continueLabel? := some (LabelSupply.label supply 2) }
            exact
              (ProcedurePreservation.preserves_for_in_programLayout
                (layout := layout) (ctx := ctx) (supply := supply)
                (init := init) (cond := cond) (post := post) (body := body)
                hCondRunner hCondFrame
                (block (program := program) (layout := layout) hCall
                  (ctx := loopOuterCtx) (supply := LabelSupply.next supply)
                  hInitWF hInitRunner hInitFrame hInitTerminal
                  (ControlContextSupports.loopOuter hCtx))
                (block (program := program) (layout := layout) hCall
                  (ctx := bodyCtx)
                  (supply :=
                    (Block.compileFromCtx init loopOuterCtx
                      (LabelSupply.next supply)).next)
                  hBodyWF hBodyRunner hBodyFrame hBodyTerminal
                  (ControlContextSupports.loopBody hCtx))
                (block (program := program) (layout := layout) hCall
                  (ctx := loopOuterCtx)
                  (supply :=
                    (Block.compileFromCtx body bodyCtx
                      (Block.compileFromCtx init loopOuterCtx
                        (LabelSupply.next supply)).next).next)
                  hPostWF hPostRunner hPostFrame hPostTerminal
                  (ControlContextSupports.loopOuter hCtx)) :
                ProcedurePreservation.StmtPreservesInProgramLayout layout ctx
                  supply (.for_ init cond post body))
    | brk hAllowed =>
        rcases hCtx.brk hAllowed with ⟨label, hLabel⟩
        exact ProcedurePreservation.preserves_brk_in_programLayout hLabel
    | cont hAllowed =>
        rcases hCtx.cont hAllowed with ⟨label, hLabel⟩
        exact ProcedurePreservation.preserves_cont_in_programLayout hLabel
    | leave hAllowed =>
        rcases hCtx.leave hAllowed with ⟨label, hLabel⟩
        exact ProcedurePreservation.preserves_leave_in_programLayout hLabel
    | call =>
        exact CompilerPreservationProgramLayoutWithCall.call hCall
    | terminal =>
        cases hTerminal with
        | terminal hSafe =>
            exact ProcedurePreservation.preserves_terminal_in_programLayout hSafe
  termination_by sizeOf stmt
  decreasing_by
    all_goals
      simp_wf
      subst_vars
      first
      | simp
        all_goals omega
      | exact
          lt_trans (by simp)
            (lt_trans (list_sizeOf_lt_sizeOf_of_mem hMem) (by simp; omega))
end

theorem main_block {program : Program}
    (layout : ProcedurePreservation.ProgramLayout program)
    (hCall : ProcedurePreservation.CallObligationForAllFuel layout)
    (hWF : program.WF)
    (hRunner : Program.RunnerSafe program)
    (hFrame : program.FrameSafe)
    (hTerminal : Program.TerminalSafe program) :
    ProcedurePreservation.ProgramLayout.MainPreserves layout := by
  exact
    block (program := program) (layout := layout) hCall
      (ctx := { procs := program.procs }) (supply := 0)
      (canBreak := false) (canContinue := false) (canLeave := false)
      hWF.2.2.2.2 hRunner.2 hFrame.2 hTerminal.2
      (by
        refine ⟨?_, ?_, ?_⟩
        · intro hFalse
          cases hFalse
        · intro hFalse
          cases hFalse
        · intro hFalse
          cases hFalse)

end CompilerPreservationProgramLayout

namespace CompilerPreservationProgramLayoutUpTo

set_option maxHeartbeats 800000 in
set_option maxRecDepth 2000 in
mutual
  theorem block {program : Program}
      {layout : ProcedurePreservation.ProgramLayout program}
      {maxFuel : Nat}
      (hCall : ProcedurePreservation.CallObligationUpTo layout maxFuel)
      {ctx : CompileContext} {supply : LabelSupply} {block : Block}
      {canBreak canContinue canLeave : Bool}
      (hWF : Block.WF canBreak canContinue canLeave block)
      (hRunner : Block.RunnerSafe block)
      (hFrame : Block.FrameSafe block)
      (hTerminal : Block.TerminalSafe block)
      (hCtx : ControlContextSupports canBreak canContinue canLeave ctx) :
      ProcedurePreservation.BlockPreservesInProgramLayoutUpTo layout maxFuel
        ctx supply block := by
    cases hWF with
    | nil =>
        exact
          ProcedurePreservation.block_preserves_upTo_of_preserves
            (ProcedurePreservation.preserves_nil_in_programLayout layout)
    | cons hStmtWF hRestWF =>
        rename_i headStmt rest
        cases hRunner with
        | cons hStmtRunner hRestRunner =>
        cases hFrame with
        | cons hStmtFrame hRestFrame =>
        cases hTerminal with
        | cons hStmtTerminal hRestTerminal =>
            exact
              ProcedurePreservation.preserves_cons_in_programLayout_upTo
                (layout := layout)
                (stmt (program := program) (layout := layout)
                  (maxFuel := maxFuel) hCall (ctx := ctx) (supply := supply)
                  hStmtWF hStmtRunner hStmtFrame hStmtTerminal hCtx)
                (block (program := program) (layout := layout)
                  (maxFuel := maxFuel) hCall (ctx := ctx)
                  (supply := (Stmt.compileFromCtxCore headStmt ctx supply).next)
                  hRestWF hRestRunner hRestFrame hRestTerminal hCtx)
  termination_by sizeOf block
  decreasing_by
    all_goals
      simp_wf
      subst_vars
      simp
      all_goals omega

  theorem stmt {program : Program}
      {layout : ProcedurePreservation.ProgramLayout program}
      {maxFuel : Nat}
      (hCall : ProcedurePreservation.CallObligationUpTo layout maxFuel)
      {ctx : CompileContext} {supply : LabelSupply} {stmt : Stmt}
      {canBreak canContinue canLeave : Bool}
      (hWF : Stmt.WF canBreak canContinue canLeave stmt)
      (hRunner : Stmt.RunnerSafe stmt)
      (hFrame : Stmt.FrameSafe stmt)
      (hTerminal : Stmt.TerminalSafe stmt)
      (hCtx : ControlContextSupports canBreak canContinue canLeave ctx) :
      ProcedurePreservation.StmtPreservesInProgramLayoutUpTo layout maxFuel
        ctx supply stmt := by
    cases hWF with
    | code =>
        cases hRunner with
        | code hCodeRunner =>
        cases hFrame with
        | code hCodeFrame =>
            exact
              ProcedurePreservation.stmt_preserves_upTo_of_preserves
                (ProcedurePreservation.preserves_code_in_programLayout
                  hCodeRunner hCodeFrame)
    | if_ hBodyWF =>
        cases hRunner with
        | if_ hCondRunner hBodyRunner =>
        cases hFrame with
        | if_ hCondFrame hBodyFrame =>
        cases hTerminal with
        | if_ hBodyTerminal =>
            exact
              ProcedurePreservation.preserves_if_in_programLayout_upTo
                hCondRunner hCondFrame
                (block (program := program) (layout := layout)
                  (maxFuel := maxFuel) hCall (ctx := ctx)
                  (supply := LabelSupply.next supply)
                  hBodyWF hBodyRunner hBodyFrame hBodyTerminal hCtx)
    | switch hCasesWF hDefaultWF =>
        rename_i scrutinee cases defaultBody
        cases hRunner with
        | switch hScrutineeRunner hCasesRunner hDefaultRunner =>
        cases hFrame with
        | switch hScrutineeFrame hCasesFrame hDefaultFrame =>
        cases hTerminal with
        | switch hCasesTerminal hDefaultTerminal =>
            have hCasesPreserves :
                ProcedurePreservation.SwitchCasesPreservesInProgramLayoutUpTo
                  layout maxFuel ctx (LabelSupply.label supply 0) supply
                  (LabelSupply.next supply) 0 cases :=
              ProcedurePreservation.switchCasesPreservesInProgramLayoutUpTo_of_all
                (layout := layout) (maxFuel := maxFuel) (ctx := ctx)
                (endLabel := LabelSupply.label supply 0)
                (base := supply) (supply := LabelSupply.next supply)
                (cases := cases) (idx := 0)
                (hAll := by
                  intro bodySupply value body hMem
                  exact
                    block (program := program) (layout := layout)
                      (maxFuel := maxFuel) hCall
                      (ctx := ctx) (supply := bodySupply)
                      (hCasesWF value body hMem)
                      (hCasesRunner value body hMem)
                      (hCasesFrame value body hMem)
                      (hCasesTerminal value body hMem)
                      hCtx)
            have hDefaultPreserves :
                ProcedurePreservation.SwitchDefaultPreservesInProgramLayoutUpTo
                  layout maxFuel ctx
                  (SwitchCases.compileFromCtx cases ctx
                    (LabelSupply.label supply 0) supply
                    (LabelSupply.next supply) 0).next defaultBody := by
              cases hDefault : defaultBody with
              | none =>
                  trivial
              | some defaultBody =>
                  exact
                    block (program := program) (layout := layout)
                      (maxFuel := maxFuel) hCall
                      (ctx := ctx)
                      (supply :=
                        (SwitchCases.compileFromCtx cases ctx
                          (LabelSupply.label supply 0) supply
                          (LabelSupply.next supply) 0).next)
                      (hDefaultWF defaultBody hDefault)
                      (hDefaultRunner defaultBody hDefault)
                      (hDefaultFrame defaultBody hDefault)
                      (hDefaultTerminal defaultBody hDefault)
                      hCtx
            exact
              (ProcedurePreservation.preserves_switch_in_programLayout_upTo
                hScrutineeRunner hScrutineeFrame hCasesPreserves
                hDefaultPreserves :
                ProcedurePreservation.StmtPreservesInProgramLayoutUpTo layout
                  maxFuel ctx supply (.switch scrutinee cases defaultBody))
    | for_ hInitWF hPostWF hBodyWF =>
        rename_i init post body cond
        cases hRunner with
        | for_ hInitRunner hCondRunner hPostRunner hBodyRunner =>
        cases hFrame with
        | for_ hInitFrame hCondFrame hPostFrame hBodyFrame =>
        cases hTerminal with
        | for_ hInitTerminal hPostTerminal hBodyTerminal =>
            let loopOuterCtx : CompileContext :=
              { ctx with breakLabel? := none, continueLabel? := none }
            let bodyCtx : CompileContext :=
              { ctx with
                breakLabel? := some (LabelSupply.label supply 3)
                continueLabel? := some (LabelSupply.label supply 2) }
            exact
              (ProcedurePreservation.preserves_for_in_programLayout_upTo
                (layout := layout) (maxFuel := maxFuel) (ctx := ctx)
                (supply := supply)
                (init := init) (cond := cond) (post := post) (body := body)
                hCondRunner hCondFrame
                (block (program := program) (layout := layout)
                  (maxFuel := maxFuel) hCall
                  (ctx := loopOuterCtx) (supply := LabelSupply.next supply)
                  hInitWF hInitRunner hInitFrame hInitTerminal
                  (ControlContextSupports.loopOuter hCtx))
                (block (program := program) (layout := layout)
                  (maxFuel := maxFuel) hCall
                  (ctx := bodyCtx)
                  (supply :=
                    (Block.compileFromCtx init loopOuterCtx
                      (LabelSupply.next supply)).next)
                  hBodyWF hBodyRunner hBodyFrame hBodyTerminal
                  (ControlContextSupports.loopBody hCtx))
                (block (program := program) (layout := layout)
                  (maxFuel := maxFuel) hCall
                  (ctx := loopOuterCtx)
                  (supply :=
                    (Block.compileFromCtx body bodyCtx
                      (Block.compileFromCtx init loopOuterCtx
                        (LabelSupply.next supply)).next).next)
                  hPostWF hPostRunner hPostFrame hPostTerminal
                  (ControlContextSupports.loopOuter hCtx)) :
                ProcedurePreservation.StmtPreservesInProgramLayoutUpTo layout
                  maxFuel ctx supply (.for_ init cond post body))
    | brk hAllowed =>
        rcases hCtx.brk hAllowed with ⟨label, hLabel⟩
        exact
          ProcedurePreservation.stmt_preserves_upTo_of_preserves
            (ProcedurePreservation.preserves_brk_in_programLayout hLabel)
    | cont hAllowed =>
        rcases hCtx.cont hAllowed with ⟨label, hLabel⟩
        exact
          ProcedurePreservation.stmt_preserves_upTo_of_preserves
            (ProcedurePreservation.preserves_cont_in_programLayout hLabel)
    | leave hAllowed =>
        rcases hCtx.leave hAllowed with ⟨label, hLabel⟩
        exact
          ProcedurePreservation.stmt_preserves_upTo_of_preserves
            (ProcedurePreservation.preserves_leave_in_programLayout hLabel)
    | call =>
        exact hCall.preserves
    | terminal =>
        cases hTerminal with
        | terminal hSafe =>
            exact
              ProcedurePreservation.stmt_preserves_upTo_of_preserves
                (ProcedurePreservation.preserves_terminal_in_programLayout hSafe)
  termination_by sizeOf stmt
  decreasing_by
    all_goals
      simp_wf
      subst_vars
      first
      | simp
        all_goals omega
      | exact
          lt_trans (by simp)
            (lt_trans (list_sizeOf_lt_sizeOf_of_mem hMem) (by simp; omega))
end

end CompilerPreservationProgramLayoutUpTo

theorem callObligationForAllFuel_of_accepted {program : Program}
    (layout : ProcedurePreservation.ProgramLayout program)
    (hAccepted : Program.Accepted program) :
    ProcedurePreservation.CallObligationForAllFuel layout := by
  intro maxFuel
  induction maxFuel with
  | zero =>
      exact ProcedurePreservation.callObligationUpTo_zero layout
  | succ smaller ih =>
      exact
        ProcedurePreservation.callObligationUpTo_succ_of_procBodies
          (layout := layout)
          (maxFuel := smaller)
          (by
            intro name proc hLookup
            have hProcWF : Proc.WF proc :=
              Program.procWF_of_lookup? hAccepted.wf hLookup
            have hProcRunner : Proc.RunnerSafe proc :=
              Program.procRunnerSafe_of_lookup? hAccepted.runner hLookup
            have hProcFrame : Proc.FrameSafe proc :=
              Program.procFrameSafe_of_lookup? hAccepted.frame hLookup
            have hProcTerminal : Proc.TerminalSafe proc :=
              Program.procTerminalSafe_of_lookup? hAccepted.terminal hLookup
            exact
              (CompilerPreservationProgramLayoutUpTo.block
                (program := program) (layout := layout)
                (maxFuel := smaller) (hCall := ih)
                (ctx := ProcedurePreservation.bodyCtx program proc)
                (supply := (layout.procLayout hLookup).bodySupply)
                (block := proc.body)
                (canBreak := false) (canContinue := false)
                (canLeave := true)
                hProcWF.2.2 hProcRunner hProcFrame hProcTerminal
                (by
                  refine ⟨?_, ?_, ?_⟩
                  · intro hFalse
                    cases hFalse
                  · intro hFalse
                    cases hFalse
                  · intro _hTrue
                    exact ⟨ProcLabel.exit proc.name, by
                      simp [ProcedurePreservation.bodyCtx]⟩) :
                ProcedurePreservation.BlockPreservesInProgramLayoutUpTo
                  layout smaller (ProcedurePreservation.bodyCtx program proc)
                  (layout.procLayout hLookup).bodySupply proc.body))

/--
Whole-program observations erase the procedure machine's ghost return stack.

An accepted top-level program should end either regularly or through an EVM
terminal opcode. `break`, `continue`, and uncaught `leave` are deliberately not
related to whole-program assembly behavior.
-/
def WholeProgramOutcomeRel (source : Outcome)
    (target : Assembly.StepResult) : Prop :=
  match source.mode, target with
  | .regular, .running targetState =>
      eraseControl source.state.evm = eraseControl targetState
  | .halt sourceKind, .halted targetHalt =>
      sourceKind = targetHalt.kind ∧
        ∃ tokens,
          Frame.StateRel source.state targetHalt.state tokens
  | _, _ =>
      False

def TargetOutcomeEndPc (asm : Assembly.Program)
    (target : Assembly.StepResult) : Prop :=
  match target with
  | .running targetState => targetState.pc = Assembly.Program.pcAfter asm
  | .halted _ => True

def WholeProgramSourceOutcome (source : Outcome) : Prop :=
  match source.mode with
  | .regular | .halt _ => True
  | .brk | .cont | .leave => False

namespace Outcome

def ModeAllowed (canBreak canContinue canLeave : Bool)
    (outcome : Outcome) : Prop :=
  match outcome.mode with
  | .regular | .halt _ => True
  | .brk => canBreak = true
  | .cont => canContinue = true
  | .leave => canLeave = true

theorem whole_of_modeAllowed_false {outcome : Outcome}
    (hAllowed : ModeAllowed false false false outcome) :
    WholeProgramSourceOutcome outcome := by
  cases outcome with
  | mk state mode =>
      cases mode <;> simp [ModeAllowed, WholeProgramSourceOutcome] at hAllowed ⊢

end Outcome

set_option maxHeartbeats 400000 in
mutual
  theorem Block.Eval.modeAllowed {program : Program} {fuel : Nat}
      {block : Block} {source : RunState} {outcome : Outcome}
      {canBreak canContinue canLeave : Bool}
      (hWF : Block.WF canBreak canContinue canLeave block)
      (hEval : Block.Eval program fuel block source outcome) :
      Outcome.ModeAllowed canBreak canContinue canLeave outcome := by
    cases hEval with
    | nil =>
        simp [Outcome.ModeAllowed, Outcome.regular]
    | cons_regular hStmt hRest =>
        cases hWF with
        | cons hStmtWF hRestWF =>
            exact Block.Eval.modeAllowed hRestWF hRest
    | cons_brk hStmt =>
        cases hWF with
        | cons hStmtWF _hRestWF =>
            exact Stmt.Eval.modeAllowed hStmtWF hStmt
    | cons_cont hStmt =>
        cases hWF with
        | cons hStmtWF _hRestWF =>
            exact Stmt.Eval.modeAllowed hStmtWF hStmt
    | cons_leave hStmt =>
        cases hWF with
        | cons hStmtWF _hRestWF =>
            exact Stmt.Eval.modeAllowed hStmtWF hStmt
    | cons_halt hStmt =>
        cases hWF with
        | cons hStmtWF _hRestWF =>
            exact Stmt.Eval.modeAllowed hStmtWF hStmt

  theorem Stmt.Eval.modeAllowed {program : Program} {fuel : Nat}
      {stmt : Stmt} {source : RunState} {outcome : Outcome}
      {canBreak canContinue canLeave : Bool}
      (hWF : Stmt.WF canBreak canContinue canLeave stmt)
      (hEval : Stmt.Eval program fuel stmt source outcome) :
      Outcome.ModeAllowed canBreak canContinue canLeave outcome := by
    cases hEval with
    | code hCode =>
        simp [Outcome.ModeAllowed, Outcome.regular]
    | if_false hCond =>
        simp [Outcome.ModeAllowed, Outcome.regular]
    | if_true hCond hBody =>
        cases hWF with
        | if_ hBodyWF =>
            exact Block.Eval.modeAllowed hBodyWF hBody
    | switch_none hScrutinee hPop hSelect =>
        simp [Outcome.ModeAllowed, Outcome.regular]
    | switch_some hScrutinee hPop hStateAfterPop hSelect hBody =>
        cases hWF with
        | switch hCasesWF hDefaultWF =>
            exact
              Block.Eval.modeAllowed
                (Switch.wf_of_select hCasesWF hDefaultWF hSelect) hBody
    | for_init_regular hInit hLoop =>
        cases hWF with
        | for_ hInitWF hPostWF hBodyWF =>
            exact
              For.Eval.modeAllowed
                (canBreak := canBreak) (canContinue := canContinue)
                hPostWF hBodyWF hLoop
    | for_init_leave hInit =>
        cases hWF with
        | for_ hInitWF _hPostWF _hBodyWF =>
            have hAllowed := Block.Eval.modeAllowed hInitWF hInit
            simpa [Outcome.ModeAllowed, Outcome.leave] using hAllowed
    | for_init_halt hInit =>
        cases hWF with
        | for_ hInitWF _hPostWF _hBodyWF =>
            simp [Outcome.ModeAllowed, Outcome.halt]
    | brk =>
        cases hWF with
        | brk hAllowed =>
            simpa [Outcome.ModeAllowed, Outcome.brk] using hAllowed
    | cont =>
        cases hWF with
        | cont hAllowed =>
            simpa [Outcome.ModeAllowed, Outcome.cont] using hAllowed
    | leave hReturns =>
        cases hWF with
        | leave hAllowed =>
            simpa [Outcome.ModeAllowed, Outcome.leave] using hAllowed
    | call_regular hLookup hSplit hBody hPop hAttach =>
        simp [Outcome.ModeAllowed, Outcome.regular]
    | call_leave hLookup hSplit hBody hPop hAttach =>
        simp [Outcome.ModeAllowed, Outcome.regular]
    | call_halt hLookup hSplit hBody =>
        simp [Outcome.ModeAllowed, Outcome.halt]
    | terminal hStep =>
        simp [Outcome.ModeAllowed, Outcome.halt]

  theorem For.Eval.modeAllowed {program : Program} {fuel : Nat}
      {cond : Code} {post body : Block} {source : RunState}
      {outcome : Outcome} {canBreak canContinue canLeave : Bool}
      (hPostWF : Block.WF false false canLeave post)
      (hBodyWF : Block.WF true true canLeave body)
      (hEval : For.Eval program fuel cond post body source outcome) :
      Outcome.ModeAllowed canBreak canContinue canLeave outcome := by
    cases hEval with
    | false hCond =>
        simp [Outcome.ModeAllowed, Outcome.regular]
    | body_brk hCond hBody =>
        simp [Outcome.ModeAllowed, Outcome.regular]
    | body_leave hCond hBody =>
        have hAllowed := Block.Eval.modeAllowed hBodyWF hBody
        simpa [Outcome.ModeAllowed, Outcome.leave] using hAllowed
    | body_halt hCond hBody =>
        simp [Outcome.ModeAllowed, Outcome.halt]
    | regular_post_regular hCond hBody hPost hLoop =>
        exact For.Eval.modeAllowed hPostWF hBodyWF hLoop
    | cont_post_regular hCond hBody hPost hLoop =>
        exact For.Eval.modeAllowed hPostWF hBodyWF hLoop
    | regular_post_leave hCond hBody hPost =>
        have hAllowed := Block.Eval.modeAllowed hPostWF hPost
        simpa [Outcome.ModeAllowed, Outcome.leave] using hAllowed
    | cont_post_leave hCond hBody hPost =>
        have hAllowed := Block.Eval.modeAllowed hPostWF hPost
        simpa [Outcome.ModeAllowed, Outcome.leave] using hAllowed
    | regular_post_halt hCond hBody hPost =>
        simp [Outcome.ModeAllowed, Outcome.halt]
    | cont_post_halt hCond hBody hPost =>
        simp [Outcome.ModeAllowed, Outcome.halt]
end

theorem Program.wholeProgramSourceOutcome_of_eval {program : Program}
    {fuel : Nat} {initial : EVMState} {outcome : Outcome}
    (hWF : program.WF)
    (hEval :
      Block.Eval program fuel program.body (Program.initialState initial)
        outcome) :
    WholeProgramSourceOutcome outcome := by
  exact
    Outcome.whole_of_modeAllowed_false
      (Block.Eval.modeAllowed hWF.2.2.2.2 hEval)

namespace WholeProgramOutcomeRel

theorem returns_nil_of_stateRel_tokens_nil {source : RunState}
    {target : EVMState}
    (hRel : Frame.StateRel source target []) :
    source.returns = [] := by
  cases source with
  | mk evm returns =>
      cases returns with
      | nil =>
          rfl
      | cons frame rest =>
          cases hRel with
          | mk hStack _hData =>
              simp [Frame.materializeStack] at hStack

theorem running_of_stateRel {source : RunState} {target : EVMState}
    (hRel : Frame.StateRel source target []) :
    WholeProgramOutcomeRel (Outcome.regular source) (.running target) := by
  exact
    Frame.stateRel_initial_eraseControl hRel
      (returns_nil_of_stateRel_tokens_nil hRel)

theorem halted_of_stateRel {source : RunState} {target : EVMState}
    {kind : Assembly.HaltKind} {tokens : List Word}
    (hRel : Frame.StateRel source target tokens) :
    WholeProgramOutcomeRel (Outcome.halt kind source)
      (.halted { kind := kind, state := target, output := kind.output target }) := by
  exact ⟨rfl, tokens, hRel⟩

theorem of_compiled_main {program : Program} {asm : Assembly.Program}
    {fallthroughPc : Word} {source : Outcome}
    {target : Assembly.StepResult}
    (hWhole : WholeProgramSourceOutcome source)
    (hRel :
      CompiledOutcomeRel asm (CompiledProgram.mainCtx program)
        fallthroughPc source target []) :
    WholeProgramOutcomeRel source target := by
  cases source with
  | mk state mode =>
      cases mode with
      | regular =>
          cases target with
          | running targetState =>
              rcases hRel with ⟨hFrame, _hPc⟩
              exact running_of_stateRel hFrame
          | halted halt =>
              cases hRel
      | brk =>
          cases hWhole
      | cont =>
          cases hWhole
      | leave =>
          cases hWhole
      | halt kind =>
          cases target with
          | running targetState =>
              cases hRel
          | halted halt =>
              exact hRel

end WholeProgramOutcomeRel

namespace ProcedurePreservation
namespace ProgramLayout

structure MainEvidence {program : Program}
    (layout : ProgramLayout program) where
  asm_eq : layout.asm = program.compile
  mainSegment :
    CodeSegment layout.asm (CompiledProgram.main program).code
  mainCalls :
    ProcedurePreservation.CallsIncluded
      (CompiledProgram.main program).calls layout.sites

end ProgramLayout

/--
Low-level compiler-resource/freshness facts needed to turn the emitted
Structured program into a `ProgramLayout`.

`pcFits` is the concrete no-overflow/code-size boundary.  The label and return
token facts are compiler freshness obligations; they are kept as a small,
named boundary while the full generated-label/token uniqueness proof is being
shrunk toward the public theorem.
-/
structure CompilationBounds (program : Program) : Prop where
  pcFits : AssemblyProgram.PCFitsFrom [] program.compile
  labelsNodup : (Assembly.Program.labels program.compile).Nodup
  callTokensNodup :
    ((CompiledProgram.allCalls program).map CallSite.token).Nodup

noncomputable instance instDecidableCompilationBounds (program : Program) :
    Decidable (CompilationBounds program) := by
  by_cases hPc : AssemblyProgram.PCFitsFrom [] program.compile
  · by_cases hLabels : (Assembly.Program.labels program.compile).Nodup
    · by_cases hTokens :
          ((CompiledProgram.allCalls program).map CallSite.token).Nodup
      · exact isTrue ⟨hPc, hLabels, hTokens⟩
      · exact isFalse (fun hBounds => hTokens hBounds.callTokensNodup)
    · exact isFalse (fun hBounds => hLabels hBounds.labelsNodup)
  · exact isFalse (fun hBounds => hPc hBounds.pcFits)

def compilationBoundsChecked (program : Program) : Bool :=
  decide (AssemblyProgram.PCFitsFrom [] program.compile) &&
    decide ((Assembly.Program.labels program.compile).Nodup) &&
      decide ((program.compileResult.calls.map CallSite.token).Nodup)

theorem bounds_of_checked {program : Program}
    (hChecked : compilationBoundsChecked program = true) :
    CompilationBounds program := by
  simp [compilationBoundsChecked] at hChecked
  exact
    { pcFits := hChecked.1.1
      labelsNodup := hChecked.1.2
      callTokensNodup := by
        simpa [CompiledProgram.allCalls_eq_compileResult_calls] using
          hChecked.2 }

theorem compilationBoundsChecked_of_bounds {program : Program}
    (hBounds : CompilationBounds program) :
    compilationBoundsChecked program = true := by
  have hTokens :
      (program.compileResult.calls.map CallSite.token).Nodup := by
    simpa [← CompiledProgram.allCalls_eq_compileResult_calls] using
      hBounds.callTokensNodup
  simp [compilationBoundsChecked, hBounds.pcFits, hBounds.labelsNodup,
    hTokens]

noncomputable def compilerChecked (program : Program) : Bool :=
  Program.accepted program && compilationBoundsChecked program

noncomputable def compileChecked? (program : Program) : Option Assembly.Program :=
  if compilerChecked program then
    some program.compile
  else
    none

theorem compileChecked?_eq_some {program : Program} {asm : Assembly.Program}
    (hCompile : compileChecked? program = some asm) :
    asm = program.compile ∧ Program.Accepted program ∧
      CompilationBounds program := by
  unfold compileChecked? at hCompile
  cases hChecked : compilerChecked program <;> simp [hChecked] at hCompile
  cases hCompile
  cases hAcceptedChecked : Program.accepted program <;>
    cases hBoundsChecked : compilationBoundsChecked program <;>
    simp [compilerChecked, hAcceptedChecked, hBoundsChecked] at hChecked
  exact
    ⟨rfl, Program.accepted_of_check hAcceptedChecked,
      bounds_of_checked hBoundsChecked⟩

theorem compileChecked?_of_accepted_bounds {program : Program}
    (hAccepted : Program.Accepted program)
    (hBounds : CompilationBounds program) :
    compileChecked? program = some program.compile := by
  unfold compileChecked? compilerChecked
  rw [Program.accepted_check_of hAccepted,
    compilationBoundsChecked_of_bounds hBounds]
  simp

theorem compileChecked?_noCallCreate {program : Program}
    {asm : Assembly.Program}
    (hProgram : program.usesCallCreate = false)
    (hCompile : compileChecked? program = some asm) :
    Assembly.Program.usesCallCreate asm = false := by
  rcases compileChecked?_eq_some hCompile with ⟨hAsm, _hAccepted, _hBounds⟩
  subst asm
  exact CompilerFacts.program_compile_noCallCreate program hProgram

theorem accepted_of_compileChecked? {program : Program} {asm : Assembly.Program}
    (hCompile : compileChecked? program = some asm) :
    Program.Accepted program := by
  exact (compileChecked?_eq_some hCompile).2.1

theorem wf_of_compileChecked? {program : Program} {asm : Assembly.Program}
    (hCompile : compileChecked? program = some asm) :
    program.WF := by
  exact (accepted_of_compileChecked? hCompile).wf

theorem backendSafe_of_compileChecked? {program : Program}
    {asm : Assembly.Program}
    (hCompile : compileChecked? program = some asm) :
    Program.BackendSafe program := by
  exact Program.BackendSafe.ofAccepted (accepted_of_compileChecked? hCompile)

theorem bounds_of_compileChecked? {program : Program} {asm : Assembly.Program}
    (hCompile : compileChecked? program = some asm) :
    CompilationBounds program := by
  exact (compileChecked?_eq_some hCompile).2.2

theorem labelsNodup_of_compileChecked? {program : Program}
    {asm : Assembly.Program}
    (hCompile : compileChecked? program = some asm) :
    (Assembly.Program.labels asm).Nodup := by
  rcases compileChecked?_eq_some hCompile with ⟨hAsm, _hAccepted, hBounds⟩
  subst asm
  exact hBounds.labelsNodup

theorem callTokensNodup_of_compileChecked? {program : Program}
    {asm : Assembly.Program}
    (hCompile : compileChecked? program = some asm) :
    ((CompiledProgram.allCalls program).map CallSite.token).Nodup := by
  exact (bounds_of_compileChecked? hCompile).callTokensNodup

namespace ProgramLayout

noncomputable def ofCompilationBounds {program : Program}
    (bounds : CompilationBounds program) :
    ProgramLayout program where
  asm := program.compile
  sites := CompiledProgram.allCalls program
  exactLabels := ExactLabels.of_labels_nodup bounds.labelsNodup
  noDupTokens := bounds.callTokensNodup
  tokenNoDupForProc := fun proc =>
    DispatchPreservation.nodup_tokens_filter
      (sites := CompiledProgram.allCalls program)
      (p := CallSite.forProc proc.name)
      bounds.callTokensNodup
  procLayout := by
    intro name proc hLookup
    let emittedSeg :=
      CompiledProgram.emittedProcsSegmentFromWholeFits program bounds.pcFits
    have hSegment :
        CodeSegment program.compile
          (CompiledProcBodies.emit
            (ProcBodies.compile program.procs program.procs
              (CompiledProgram.main program).next).1
            (CompiledProgram.allCalls program)
            (ProcBodies.compile program.procs program.procs
              (CompiledProgram.main program).next).2.1).code := by
      simpa [CompiledProgram.emittedProcs, CompiledProgram.procBodies,
        CompiledProgram.procBodiesResult, CompiledProgram.procBodyNext]
        using emittedSeg
    have hCalls :
        CallsIncluded
          (ProcBodies.compile program.procs program.procs
            (CompiledProgram.main program).next).2.2
          (CompiledProgram.allCalls program) := by
      simpa [CompiledProgram.procCalls, CompiledProgram.procBodiesResult]
        using (proc_calls_included_allCalls program)
    exact
      procLayout_of_procBodies_emit
        (program := program) (procs := program.procs)
        (sites := CompiledProgram.allCalls program)
        (bodySupply := (CompiledProgram.main program).next)
        (dispatchSupply :=
          (ProcBodies.compile program.procs program.procs
            (CompiledProgram.main program).next).2.1)
        (segment := hSegment) hCalls hLookup

noncomputable def mainEvidenceOfCompilationBounds {program : Program}
    (bounds : CompilationBounds program) :
    MainEvidence (ofCompilationBounds bounds) where
  asm_eq := rfl
  mainSegment := by
    simpa [ofCompilationBounds] using
      CompiledProgram.mainSegmentFromWholeFits program bounds.pcFits
  mainCalls := by
    intro site hMem
    exact main_calls_included_allCalls program site hMem

end ProgramLayout
end ProcedurePreservation

namespace ContextLabelsResolve

theorem mainCtx (program : Program) (asm : Assembly.Program) :
    ContextLabelsResolve asm (CompiledProgram.mainCtx program) := by
  refine ⟨?_, ?_, ?_⟩
  · intro label h
    cases h
  · intro label h
    cases h
  · intro label h
    cases h

end ContextLabelsResolve

theorem compile_preserves_with_programLayout
    {program : Program} {sourceFuel : Nat} {initial : EVMState}
    {sourceOutcome : Outcome}
    (layout : ProcedurePreservation.ProgramLayout program)
    (evidence : ProcedurePreservation.ProgramLayout.MainEvidence layout)
    (hAccepted : Program.Accepted program)
    (hInitialPc : initial.pc = evidence.mainSegment.startPc)
    (hSource : program.run sourceFuel initial = .ok sourceOutcome) :
    ∃ targetFuel targetOutcome,
      Assembly.Source.runNResult program.compile targetFuel initial =
        .ok targetOutcome ∧
      WholeProgramOutcomeRel sourceOutcome targetOutcome := by
  have hEval := Program.eval_of_run hSource
  have hCall : ProcedurePreservation.CallObligationForAllFuel layout :=
    callObligationForAllFuel_of_accepted layout hAccepted
  have hMainPreserves :
      ProcedurePreservation.ProgramLayout.MainPreserves layout :=
    CompilerPreservationProgramLayout.main_block layout hCall hAccepted.wf
      hAccepted.runner hAccepted.frame hAccepted.terminal
  have hRun :=
    hMainPreserves
      (fuel := sourceFuel) (source := Program.initialState initial)
      (outcome := sourceOutcome) (target := initial) (tokens := [])
      hAccepted.wf rfl evidence.mainCalls
      (ContextLabelsResolve.mainCtx program layout.asm)
      evidence.mainSegment hInitialPc (Frame.stateRel_initial initial)
      (by simpa [Program.initialState] using hEval)
  rcases hRun with ⟨targetFuel, targetOutcome, hRunEq, hOutcome⟩
  have hWhole :=
    Program.wholeProgramSourceOutcome_of_eval hAccepted.wf hEval
  refine ⟨targetFuel, targetOutcome, ?_, ?_⟩
  · rw [← evidence.asm_eq]
    exact hRunEq
  · exact WholeProgramOutcomeRel.of_compiled_main hWhole hOutcome

theorem compile_preserves_with_programLayout_and_call
    {program : Program} {sourceFuel : Nat} {initial : EVMState}
    {sourceOutcome : Outcome}
    (layout : ProcedurePreservation.ProgramLayout program)
    (evidence : ProcedurePreservation.ProgramLayout.MainEvidence layout)
    (hAccepted : Program.Accepted program)
    (hInitialPc : initial.pc = evidence.mainSegment.startPc)
    (hSource : program.run sourceFuel initial = .ok sourceOutcome) :
    ∃ targetFuel targetOutcome,
      Assembly.Source.runNResult program.compile targetFuel initial =
        .ok targetOutcome ∧
      WholeProgramOutcomeRel sourceOutcome targetOutcome := by
  have hEval := Program.eval_of_run hSource
  have hCall : ProcedurePreservation.CallObligationForAllFuel layout :=
    callObligationForAllFuel_of_accepted layout hAccepted
  have hMainPreserves :
      ProcedurePreservation.ProgramLayout.MainPreserves layout :=
    CompilerPreservationProgramLayoutWithCall.main_block layout hCall
      hAccepted.wf hAccepted.runner hAccepted.frame hAccepted.terminal
  have hRun :=
    hMainPreserves
      (fuel := sourceFuel) (source := Program.initialState initial)
      (outcome := sourceOutcome) (target := initial) (tokens := [])
      hAccepted.wf rfl evidence.mainCalls
      (ContextLabelsResolve.mainCtx program layout.asm)
      evidence.mainSegment hInitialPc (Frame.stateRel_initial initial)
      (by simpa [Program.initialState] using hEval)
  rcases hRun with ⟨targetFuel, targetOutcome, hRunEq, hOutcome⟩
  have hWhole :=
    Program.wholeProgramSourceOutcome_of_eval hAccepted.wf hEval
  refine ⟨targetFuel, targetOutcome, ?_, ?_⟩
  · rw [← evidence.asm_eq]
    exact hRunEq
  · exact WholeProgramOutcomeRel.of_compiled_main hWhole hOutcome

theorem compile_preserves_with_bounds
    {program : Program} {sourceFuel : Nat} {initial : EVMState}
    {sourceOutcome : Outcome}
    (bounds : ProcedurePreservation.CompilationBounds program)
    (hAccepted : Program.Accepted program)
    (hInitialPc : initial.pc = Assembly.Program.pcAfter [])
    (hSource : program.run sourceFuel initial = .ok sourceOutcome) :
    ∃ targetFuel targetOutcome,
      Assembly.Source.runNResult program.compile targetFuel initial =
        .ok targetOutcome ∧
      WholeProgramOutcomeRel sourceOutcome targetOutcome := by
  exact
    compile_preserves_with_programLayout
      (layout :=
        ProcedurePreservation.ProgramLayout.ofCompilationBounds bounds)
      (evidence :=
        ProcedurePreservation.ProgramLayout.mainEvidenceOfCompilationBounds
          bounds)
      hAccepted
      (by simpa using hInitialPc)
      hSource

theorem compile_preserves_of_checked_bounds
    {program : Program} {sourceFuel : Nat} {initial : EVMState}
    {sourceOutcome : Outcome}
    (hChecked :
      ProcedurePreservation.compilationBoundsChecked program = true)
    (hAccepted : Program.Accepted program)
    (hInitialPc : initial.pc = Assembly.Program.pcAfter [])
    (hSource : program.run sourceFuel initial = .ok sourceOutcome) :
    ∃ targetFuel targetOutcome,
      Assembly.Source.runNResult program.compile targetFuel initial =
        .ok targetOutcome ∧
      WholeProgramOutcomeRel sourceOutcome targetOutcome :=
  compile_preserves_with_bounds
    (ProcedurePreservation.bounds_of_checked hChecked)
    hAccepted hInitialPc hSource

theorem run_program_end_postamble_of_main_fallthrough
    {program : Program}
    (bounds : ProcedurePreservation.CompilationBounds program)
    {state : EVMState}
    (hPc :
      state.pc =
        Assembly.Program.pcAfter (CompiledProgram.main program).code) :
    ∃ final,
      Assembly.Source.runNResult program.compile 2 state =
        .ok (.running final) ∧
      eraseControl final = eraseControl state ∧
      final.pc = Assembly.Program.pcAfter program.compile := by
  let mainCode := (CompiledProgram.main program).code
  let procCode := (CompiledProgram.emittedProcs program).code
  let preLabel :=
    mainCode ++ [Assembly.Instr.jump ProcLabel.programEnd] ++ procCode
  have hFullFitsMain :
      AssemblyProgram.PCFitsFrom []
        (mainCode ++
          ([Assembly.Instr.jump ProcLabel.programEnd] ++
            procCode ++ [Assembly.Instr.label ProcLabel.programEnd])) := by
    simpa [mainCode, procCode, CompiledProgram.compile_eq,
      List.append_assoc] using bounds.pcFits
  have hMainFitsFrom :
      AssemblyProgram.PCFitsFrom [] mainCode :=
    AssemblyProgram.PCFitsFrom.left (pre := []) (first := mainCode)
      (second :=
        [Assembly.Instr.jump ProcLabel.programEnd] ++
          procCode ++ [Assembly.Instr.label ProcLabel.programEnd])
      hFullFitsMain
  have hMainFits : PCFits mainCode := by
    simpa using AssemblyProgram.PCFitsFrom.end hMainFitsFrom
  have hFullFitsLabel :
      AssemblyProgram.PCFitsFrom []
        (preLabel ++ [Assembly.Instr.label ProcLabel.programEnd]) := by
    simpa [preLabel, mainCode, procCode, CompiledProgram.compile_eq,
      List.append_assoc] using bounds.pcFits
  have hPreLabelFitsFrom :
      AssemblyProgram.PCFitsFrom [] preLabel :=
    AssemblyProgram.PCFitsFrom.left (pre := []) (first := preLabel)
      (second := [Assembly.Instr.label ProcLabel.programEnd])
      hFullFitsLabel
  have hPreLabelFits : PCFits preLabel := by
    simpa using AssemblyProgram.PCFitsFrom.end hPreLabelFitsFrom
  have hExact : ExactLabels program.compile :=
    ExactLabels.of_labels_nodup bounds.labelsNodup
  have hProgramEnd :
      Assembly.Program.labelPc program.compile ProcLabel.programEnd =
        some (Assembly.Program.byteLength preLabel) := by
    apply hExact.labelPc_at preLabel ProcLabel.programEnd []
    simp [preLabel, mainCode, procCode, CompiledProgram.compile_eq,
      List.append_assoc]
  have hProgramEndJump :
      Assembly.Program.labelPc
          (mainCode ++ [Assembly.Instr.jump ProcLabel.programEnd] ++
            (procCode ++ [Assembly.Instr.label ProcLabel.programEnd]))
          ProcLabel.programEnd =
        some (Assembly.Program.byteLength preLabel) := by
    simpa [preLabel, mainCode, procCode, CompiledProgram.compile_eq,
      List.append_assoc] using hProgramEnd
  have hRelStart :
      RelAt (Assembly.Program.pcAfter mainCode) state state := by
    exact ⟨by simpa [mainCode] using hPc, rfl⟩
  obtain ⟨afterJump, hJumpStep, hRelJump⟩ :=
    AssemblyControl.jump_stepResult_ctx_relAt_of_relAt
      (label := ProcLabel.programEnd)
      (dest := Assembly.Program.byteLength preLabel)
      (pre := mainCode)
      (post := procCode ++ [Assembly.Instr.label ProcLabel.programEnd])
      hMainFits hRelStart hProgramEndJump
  have hRelAtLabel :
      RelAt (Assembly.Program.pcAfter preLabel) afterJump state := by
    simpa [preLabel, Assembly.Program.pcAfter] using hRelJump
  obtain ⟨final, hLabelStep, hRelFinal⟩ :=
    AssemblyControl.label_stepResult_ctx_relAt_of_relAt
      (label := ProcLabel.programEnd)
      (pre := preLabel) (post := [])
      hPreLabelFits hRelAtLabel
  have hJumpStepProgram :
      Assembly.Source.stepResult program.compile state =
        .ok (.running afterJump) := by
    simpa [mainCode, procCode, CompiledProgram.compile_eq,
      List.append_assoc] using hJumpStep
  have hLabelStepProgram :
      Assembly.Source.stepResult program.compile afterJump =
        .ok (.running final) := by
    simpa [preLabel, mainCode, procCode, CompiledProgram.compile_eq,
      List.append_assoc] using hLabelStep
  refine ⟨final, ?_, hRelFinal.sameData, ?_⟩
  · unfold Assembly.Source.runNResult
    rw [hJumpStepProgram]
    change Assembly.Source.runNResult program.compile 1 afterJump =
      .ok (.running final)
    unfold Assembly.Source.runNResult
    rw [hLabelStepProgram]
    rfl
  · simpa [preLabel, mainCode, procCode, CompiledProgram.compile_eq,
      List.append_assoc] using hRelFinal.pc_eq

theorem compile_preserves_with_bounds_endPc
    {program : Program} {sourceFuel : Nat} {initial : EVMState}
    {sourceOutcome : Outcome}
    (bounds : ProcedurePreservation.CompilationBounds program)
    (hAccepted : Program.Accepted program)
    (hInitialPc : initial.pc = Assembly.Program.pcAfter [])
    (hSource : program.run sourceFuel initial = .ok sourceOutcome) :
    ∃ targetFuel targetOutcome,
      Assembly.Source.runNResult program.compile targetFuel initial =
        .ok targetOutcome ∧
      WholeProgramOutcomeRel sourceOutcome targetOutcome ∧
      TargetOutcomeEndPc program.compile targetOutcome := by
  let layout := ProcedurePreservation.ProgramLayout.ofCompilationBounds bounds
  let evidence :=
    ProcedurePreservation.ProgramLayout.mainEvidenceOfCompilationBounds bounds
  have hEval := Program.eval_of_run hSource
  have hCall : ProcedurePreservation.CallObligationForAllFuel layout :=
    callObligationForAllFuel_of_accepted layout hAccepted
  have hMainPreserves :
      ProcedurePreservation.ProgramLayout.MainPreserves layout :=
    CompilerPreservationProgramLayout.main_block layout hCall hAccepted.wf
      hAccepted.runner hAccepted.frame hAccepted.terminal
  have hRun :=
    hMainPreserves
      (fuel := sourceFuel) (source := Program.initialState initial)
      (outcome := sourceOutcome) (target := initial) (tokens := [])
      hAccepted.wf rfl evidence.mainCalls
      (ContextLabelsResolve.mainCtx program layout.asm)
      evidence.mainSegment
      (by simpa [evidence,
        ProcedurePreservation.ProgramLayout.mainEvidenceOfCompilationBounds,
        ProcedurePreservation.ProgramLayout.ofCompilationBounds] using
        hInitialPc)
      (Frame.stateRel_initial initial)
      (by simpa [Program.initialState] using hEval)
  rcases hRun with ⟨targetFuel, targetOutcome, hRunEq, hOutcome⟩
  have hWhole :=
    Program.wholeProgramSourceOutcome_of_eval hAccepted.wf hEval
  have hRunProgram :
      Assembly.Source.runNResult program.compile targetFuel initial =
        .ok targetOutcome := by
    rw [← evidence.asm_eq]
    exact hRunEq
  cases sourceOutcome with
  | mk sourceState mode =>
      cases mode with
      | regular =>
          cases targetOutcome with
          | running targetState =>
              rcases hOutcome with ⟨hFrame, hPc⟩
              have hMainFallthrough :
                  evidence.mainSegment.fallthroughPc =
                    Assembly.Program.pcAfter
                      (CompiledProgram.main program).code := by
                simp [evidence,
                  ProcedurePreservation.ProgramLayout.mainEvidenceOfCompilationBounds,
                  ProcedurePreservation.ProgramLayout.ofCompilationBounds,
                  CompiledProgram.mainSegmentFromWholeFits,
                  CodeSegment.fallthroughPc]
              obtain ⟨final, hExitRun, hExitData, hExitPc⟩ :=
                run_program_end_postamble_of_main_fallthrough
                  (program := program) bounds
                  (state := targetState)
                  (hPc.trans hMainFallthrough)
              have hFullRun :
                  Assembly.Source.runNResult program.compile
                      (targetFuel + 2) initial =
                    .ok (.running final) :=
                AssemblySource.runNResult_append_running hRunProgram
                  hExitRun
              refine ⟨targetFuel + 2, .running final, hFullRun, ?_, hExitPc⟩
              have hWholeMain :
                  WholeProgramOutcomeRel
                    (Outcome.regular sourceState) (.running targetState) :=
                WholeProgramOutcomeRel.running_of_stateRel hFrame
              change eraseControl sourceState.evm = eraseControl final
              change eraseControl sourceState.evm = eraseControl targetState
                at hWholeMain
              exact hWholeMain.trans hExitData.symm
          | halted halt =>
              cases hOutcome
      | brk =>
          cases hWhole
      | cont =>
          cases hWhole
      | leave =>
          cases hWhole
      | halt kind =>
          cases targetOutcome with
          | running targetState =>
              cases hOutcome
          | halted halt =>
              refine ⟨targetFuel, .halted halt, hRunProgram, ?_, trivial⟩
              exact WholeProgramOutcomeRel.of_compiled_main hWhole hOutcome

theorem compile_preserves
    {program : Program} {asm : Assembly.Program}
    {sourceFuel : Nat} {initial : EVMState}
    {sourceOutcome : Outcome}
    (hCompile :
      ProcedurePreservation.compileChecked? program = some asm)
    (hInitialPc : initial.pc = Assembly.Program.pcAfter [])
    (hSource : program.run sourceFuel initial = .ok sourceOutcome) :
    ∃ targetFuel targetOutcome,
      Assembly.Source.runNResult asm targetFuel initial =
        .ok targetOutcome ∧
      WholeProgramOutcomeRel sourceOutcome targetOutcome := by
  rcases ProcedurePreservation.compileChecked?_eq_some hCompile with
    ⟨hAsm, hAccepted, hBounds⟩
  subst asm
  exact
    compile_preserves_with_bounds hBounds hAccepted hInitialPc hSource

theorem compile_preserves_endPc
    {program : Program} {asm : Assembly.Program}
    {sourceFuel : Nat} {initial : EVMState}
    {sourceOutcome : Outcome}
    (hCompile :
      ProcedurePreservation.compileChecked? program = some asm)
    (hInitialPc : initial.pc = Assembly.Program.pcAfter [])
    (hSource : program.run sourceFuel initial = .ok sourceOutcome) :
    ∃ targetFuel targetOutcome,
      Assembly.Source.runNResult asm targetFuel initial =
        .ok targetOutcome ∧
      WholeProgramOutcomeRel sourceOutcome targetOutcome ∧
      TargetOutcomeEndPc asm targetOutcome := by
  rcases ProcedurePreservation.compileChecked?_eq_some hCompile with
    ⟨hAsm, hAccepted, hBounds⟩
  subst asm
  exact
    compile_preserves_with_bounds_endPc hBounds hAccepted hInitialPc hSource

